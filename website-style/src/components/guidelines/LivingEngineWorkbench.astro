    const raw: Point[] = [p1, w1];

    if (dir1 === 'right' && dir2 === 'left') {
      if (w1.x <= w2.x) {
        const midX = (w1.x + w2.x) / 2;
        raw.push({ x: midX, y: w1.y });
        raw.push({ x: midX, y: w2.y });
      } else {
        const detourY = (w1.y + w2.y) / 2 + (w1.y < w2.y ? -40 : 40);
        raw.push({ x: w1.x, y: detourY });
        raw.push({ x: w2.x, y: detourY });
      }
    } else if (dir1 === 'top' && dir2 === 'left') {
      raw.push({ x: w1.x, y: w2.y });
    } else if (dir1 === 'bottom' && dir2 === 'left') {
      raw.push({ x: w1.x, y: w2.y });
    } else if (dir1 === 'right' && dir2 === 'top') {
      raw.push({ x: w2.x, y: w1.y });
    } else if (dir1 === 'right' && dir2 === 'bottom') {
      raw.push({ x: w2.x, y: w1.y });
    } else if (dir1 === 'bottom' && dir2 === 'top') {
      const midY = (w1.y + w2.y) / 2;
      raw.push({ x: w1.x, y: midY });
      raw.push({ x: w2.x, y: midY });
    } else if (dir1 === 'top' && dir2 === 'bottom') {
      const midY = (w1.y + w2.y) / 2;
      raw.push({ x: w1.x, y: midY });
      raw.push({ x: w2.x, y: midY });
    } else {
      raw.push({ x: w2.x, y: w1.y });
    }

    raw.push(w2);
    raw.push(p2);

    // Simplify collinear points
    const pts: Point[] = [raw[0]];
    for (let i = 1; i < raw.length - 1; i++) {
      const prev = pts[pts.length - 1];
      const curr = raw[i];
      const next = raw[i + 1];

      const dx1 = curr.x - prev.x;
      const dy1 = curr.y - prev.y;
      const dx2 = next.x - curr.x;
      const dy2 = next.y - curr.y;

      const isCollinearX = Math.abs(dy1) < 0.2 && Math.abs(dy2) < 0.2;
      const isCollinearY = Math.abs(dx1) < 0.2 && Math.abs(dx2) < 0.2;

      if (Math.hypot(dx1, dy1) < 1) continue;
      if (!isCollinearX && !isCollinearY) {
        pts.push(curr);
      }
    }
    pts.push(raw[raw.length - 1]);

    // Build Cubic Bezier Fillet path
    const KAPPA = 0.552284749831;
    let d = `M ${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;

    if (pts.length <= 2) {
      d += ` L ${pts[pts.length - 1].x.toFixed(1)} ${pts[pts.length - 1].y.toFixed(1)}`;
    } else {
      for (let i = 1; i < pts.length - 1; i++) {
        const prev = pts[i - 1];
        const curr = pts[i];
        const next = pts[i + 1];

        const v1 = { x: prev.x - curr.x, y: prev.y - curr.y };
        const v2 = { x: next.x - curr.x, y: next.y - curr.y };

        const len1 = Math.hypot(v1.x, v1.y);
        const len2 = Math.hypot(v2.x, v2.y);

        const r = Math.min(filletRadius, len1 / 2, len2 / 2);

        if (r < 2) {
          d += ` L ${curr.x.toFixed(1)} ${curr.y.toFixed(1)}`;
          continue;
        }

        const u1 = { x: v1.x / len1, y: v1.y / len1 };
        const u2 = { x: v2.x / len2, y: v2.y / len2 };

        const t1 = { x: curr.x + u1.x * r, y: curr.y + u1.y * r };
        const t2 = { x: curr.x + u2.x * r, y: curr.y + u2.y * r };

        const cp1 = { x: t1.x + (curr.x - t1.x) * KAPPA, y: t1.y + (curr.y - t1.y) * KAPPA };
        const cp2 = { x: t2.x + (curr.x - t2.x) * KAPPA, y: t2.y + (curr.y - t2.y) * KAPPA };

        d += ` L ${t1.x.toFixed(1)} ${t1.y.toFixed(1)}`;
        d += ` C ${cp1.x.toFixed(1)} ${cp1.y.toFixed(1)}, ${cp2.x.toFixed(1)} ${cp2.y.toFixed(1)}, ${t2.x.toFixed(1)} ${t2.y.toFixed(1)}`;
      }
      const last = pts[pts.length - 1];
      d += ` L ${last.x.toFixed(1)} ${last.y.toFixed(1)}`;
    }

    const midIdx = Math.floor(pts.length / 2);
    const midPoint = pts[midIdx] || { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };

    return { d, waypoints: pts, midPoint };
  }

  // State Management
  let isDraggingNode = false;
  let activeNodeId: string | null = null;
  let dragOffset: Point = { x: 0, y: 0 };
  let isBuilding = false;

  const dragHud = document.getElementById('workbench-drag-hud');
  const hudCoordsText = document.getElementById('hud-coords-text');
  const tickerMsg = document.getElementById('workbench-ticker-msg');
  const collisionBadge = document.getElementById('workbench-collision-badge');
  const collisionText = document.getElementById('collision-text');

  /**
   * Recalculate and update all conduit paths and badges in real-time
   */
  function rerouteAll() {
    EDGES.forEach(edge => {
      const srcNode = NODES[edge.sourceId];
      const tgtNode = NODES[edge.targetId];
      if (!srcNode || !tgtNode) return;

      const srcPort = srcNode.ports[edge.sourcePort];
      const tgtPort = tgtNode.ports[edge.targetPort];
      if (!srcPort || !tgtPort) return;

      const p1: Point = { x: srcNode.x + srcPort.x, y: srcNode.y + srcPort.y };
      const p2: Point = { x: tgtNode.x + tgtPort.x, y: tgtNode.y + tgtPort.y };

      const route = routeOrthogonal(p1, srcPort.dir, p2, tgtPort.dir, 24);

      const pathEl = document.getElementById(`path-${edge.id}`) as SVGPathElement | null;
      if (pathEl) {
        pathEl.setAttribute('d', route.d);
      }

      // Update attached badge position
      if (edge.badgeId) {
        const badgeEl = document.getElementById(edge.badgeId);
        if (badgeEl) {
          badgeEl.style.left = `${route.midPoint.x - 17}px`;
          badgeEl.style.top = `${route.midPoint.y - 17}px`;
        }
      }
    });

    checkCollisions();
    updateInspectorCoords();
  }

  /**
   * Collision Detection Validator
   */
  function checkCollisions() {
    const ids = Object.keys(NODES);
    let collisionCount = 0;

    for (let i = 0; i < ids.length; i++) {
      for (let j = i + 1; j < ids.length; j++) {
        const a = NODES[ids[i]];
        const b = NODES[ids[j]];

        const overlapX = a.x < b.x + b.width - 6 && a.x + a.width - 6 > b.x;
        const overlapY = a.y < b.y + b.height - 6 && a.y + a.height - 6 > b.y;

        if (overlapX && overlapY) {
          collisionCount++;
        }
      }
    }

    if (collisionBadge && collisionText) {
      if (collisionCount === 0) {
        collisionBadge.className = 'collision-pill';
        collisionBadge.innerHTML = '<i class="pi pi-check-circle"></i> 0 Colisiones';
      } else {
        collisionBadge.className = 'collision-pill has-collision';
        collisionBadge.innerHTML = `<i class="pi pi-exclamation-triangle"></i> ${collisionCount} Colisión(es)`;
      }
    }
  }

  /**
   * Update Inspector Coordinates Table
   */
  function updateInspectorCoords() {
    const tbody = document.getElementById('coords-table-body');
    if (!tbody) return;

    tbody.innerHTML = Object.values(NODES).map(node => `
      <tr>
        <td><strong>${node.name}</strong></td>
        <td>${Math.round(node.x)}</td>
        <td>${Math.round(node.y)}</td>
        <td>${node.width}</td>
        <td>${node.height}</td>
      </tr>
    `).join('');
  }

  /**
   * Continuous 60 FPS Particle Flow Loop
   */
  function animateParticles() {
    EDGES.forEach(edge => {
      edge.pulseProgress = ((edge.pulseProgress || 0) + 0.006) % 1;

      const pathEl = document.getElementById(`path-${edge.id}`) as SVGPathElement | null;
      const particleEl = document.getElementById(`particle-${edge.id}`) as SVGCircleElement | null;

      if (pathEl && particleEl) {
        const len = pathEl.getTotalLength();
        if (len > 0) {
          const pt = pathEl.getPointAtLength(edge.pulseProgress * len);
          particleEl.setAttribute('cx', pt.x.toFixed(1));
          particleEl.setAttribute('cy', pt.y.toFixed(1));
        }
      }
    });

    requestAnimationFrame(animateParticles);
  }

  /**
   * Interactive Drag & Drop System
   */
  function setupDragAndDrop() {
    const stage = document.getElementById('workbench-center-stage');
    if (!stage) return;

    Object.keys(NODES).forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;

      // Set initial absolute positions
      el.style.left = `${NODES[id].x}px`;
      el.style.top = `${NODES[id].y}px`;

      el.addEventListener('pointerdown', (e: PointerEvent) => {
        if (isBuilding) return;
        isDraggingNode = true;
        activeNodeId = id;
        el.setPointerCapture(e.pointerId);

        const rect = el.getBoundingClientRect();
        dragOffset = {
          x: e.clientX - rect.left,
          y: e.clientY - rect.top
        };

        el.classList.add('is-dragging');
        if (dragHud) dragHud.style.display = 'flex';
        if (hudCoordsText) {
          hudCoordsText.textContent = `${NODES[id].name} · X: ${Math.round(NODES[id].x)}px · Y: ${Math.round(NODES[id].y)}px`;
        }

        e.preventDefault();
      });

      el.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDraggingNode || activeNodeId !== id) return;

        const stageRect = stage.getBoundingClientRect();
        let newX = e.clientX - stageRect.left - dragOffset.x;
        let newY = e.clientY - stageRect.top - dragOffset.y;

        // Stage Boundary Clamping (1130 × 580)
        newX = Math.max(5, Math.min(stageRect.width - NODES[id].width - 5, newX));
        newY = Math.max(5, Math.min(stageRect.height - NODES[id].height - 5, newY));

        NODES[id].x = newX;
        NODES[id].y = newY;

        el.style.left = `${newX}px`;
        el.style.top = `${newY}px`;

        if (hudCoordsText) {
          hudCoordsText.textContent = `${NODES[id].name} · X: ${Math.round(newX)}px · Y: ${Math.round(newY)}px`;
        }

        rerouteAll();
      });

      const onPointerEnd = () => {
        if (activeNodeId === id) {
          isDraggingNode = false;
          activeNodeId = null;
          el.classList.remove('is-dragging');
          if (dragHud) dragHud.style.display = 'none';

          if (tickerMsg) {
            tickerMsg.textContent = `✦ Bloque [${NODES[id].name}] posicionado en (${Math.round(NODES[id].x)}, ${Math.round(NODES[id].y)}) · Red recalculada`;
          }
        }
      };

      el.addEventListener('pointerup', onPointerEnd);
      el.addEventListener('pointercancel', onPointerEnd);
    });
  }

  /**
   * Dynamic Assembly "Construir Motor (Build)"
   */
  function buildEngineAssembly() {
    if (isBuilding) return;
    isBuilding = true;

    if (tickerMsg) {
      tickerMsg.textContent = '✦ Ensamblando motor gráfico Nexafy paso a paso...';
    }

    // Step 0: Disperse
    Object.keys(NODES).forEach((id, idx) => {
      const el = document.getElementById(id);
      if (el) {
        el.style.transition = 'all 0.35s cubic-bezier(0.16, 1, 0.3, 1)';
        el.style.opacity = '0.3';
        el.style.transform = `scale(0.88) translate(${(idx % 2 === 0 ? -12 : 12)}px, ${(idx % 3 === 0 ? -12 : 12)}px)`;
      }
    });

    const sequence = [
      { ids: ['origin-hub'], delay: 100, msg: '✦ 1/5: Origen [YOUR COMPANY] acoplado' },
      { ids: ['hub-core'], delay: 350, msg: '✦ 2/5: Núcleo Bus [NEXA HUB] conectado' },
      { ids: ['logic-a', 'logic-b'], delay: 650, msg: '✦ 3/5: Bloques Lógicos A (Despacho) y B (Escrow) interconectados' },
      { ids: ['logic-c'], delay: 950, msg: '✦ 4/5: Bloque Lógico C (Malla Cadena de Frío) integrado' },
      { ids: ['store-card', 'inquiry-card', 'online-card', 'escrow-card'], delay: 1250, msg: '✦ 5/5: Canales POS, Consulta, Online y Escrow 100% Custodia sincronizados' },
    ];

    sequence.forEach(step => {
      setTimeout(() => {
        step.ids.forEach(id => {
          const el = document.getElementById(id);
          const target = PRESET_CHANNELS[id];
          if (el && target) {
            NODES[id].x = target.x;
            NODES[id].y = target.y;
            el.style.transition = 'left 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), top 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.4s ease, opacity 0.3s ease';
            el.style.left = `${target.x}px`;
            el.style.top = `${target.y}px`;
            el.style.transform = 'scale(1) translate(0, 0)';
            el.style.opacity = '1';
          }
        });
        rerouteAll();
        if (tickerMsg) tickerMsg.textContent = step.msg;
      }, step.delay);
    });

    setTimeout(() => {
      isBuilding = false;
      if (tickerMsg) {
        tickerMsg.textContent = '✦ Motor Gráfico Nexafy Construido y 100% Operativo · Arrastra cualquier bloque libremente';
      }
      // Remove inline transitions so dragging remains 0ms lag
      Object.keys(NODES).forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.transition = 'none';
      });
    }, 1800);
  }

  /**
   * Apply Preset Positions Smoothly
   */
  function applyPreset(presetKey: string) {
    let preset = PRESET_CHANNELS;
    if (presetKey === 'matrix') preset = PRESET_MATRIX;
    else if (presetKey === 'escrow') preset = PRESET_ESCROW;

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.preset === presetKey);
    });

    Object.keys(preset).forEach(id => {
      const target = preset[id];
      const el = document.getElementById(id);
      if (el && target) {
        NODES[id].x = target.x;
        NODES[id].y = target.y;
        el.style.transition = 'left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), top 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)';
        el.style.left = `${target.x}px`;
        el.style.top = `${target.y}px`;
      }
    });

    rerouteAll();

    setTimeout(() => {
      Object.keys(NODES).forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.transition = 'none';
      });
    }, 500);

    if (tickerMsg) {
      tickerMsg.textContent = `✦ Preset [${presetKey.toUpperCase()}] aplicado con 0 colisiones`;
    }
  }

  /**
   * Human Tones Switcher
   */
  const TONES: Record<string, { plate: string; accent: string; conduit: string }> = {
    nexa:     { plate: '#082846', accent: '#38c8ff', conduit: '#bae6fd' },
    ceramic:  { plate: '#1d3d63', accent: '#38bdf8', conduit: '#a5f3fc' },
    cashmere: { plate: '#283a48', accent: '#7dd3fc', conduit: '#bae6fd' },
    oceanic:  { plate: '#0c2038', accent: '#38bdf8', conduit: '#93c5fd' }
  };

  function applyTone(toneKey: string) {
    const tone = TONES[toneKey];
    if (!tone) return;

    const path = document.querySelector<SVGPathElement>('.hero-silhouette-path');
    if (path) path.setAttribute('fill', tone.plate);

    const stop1 = document.querySelector('#workbench-radial-glow stop:nth-child(1)');
    const stop2 = document.querySelector('#workbench-radial-glow stop:nth-child(2)');
    if (stop1) stop1.setAttribute('stop-color', tone.accent);
    if (stop2) stop2.setAttribute('stop-color', tone.plate);

    document.querySelectorAll('.tone-pill').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.tone === toneKey);
    });

    applyConduitColor(tone.conduit);
  }

  function applyConduitColor(colorHex: string) {
    document.querySelectorAll<SVGPathElement>('.circuit-conduit-path').forEach(p => {
      p.setAttribute('stroke', colorHex);
    });

    document.querySelectorAll<HTMLElement>('.circuit-badge').forEach(b => {
      b.style.backgroundColor = colorHex;
    });

    document.querySelectorAll('.conduit-pill').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.pastel === colorHex);
    });
  }

  // Event Listeners Setup
  document.addEventListener('DOMContentLoaded', () => {
    setupDragAndDrop();
    rerouteAll();
    animateParticles();

    // Build Engine Button
    const btnBuild = document.getElementById('btn-build-engine');
    btnBuild?.addEventListener('click', buildEngineAssembly);

    // Preset Buttons
    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.dataset.preset || 'channels';
        applyPreset(preset);
      });
    });

    // Tone Buttons
    document.querySelectorAll<HTMLButtonElement>('.tone-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const tone = btn.dataset.tone || 'nexa';
        applyTone(tone);
      });
    });

    // Conduit Pastel Buttons
    document.querySelectorAll<HTMLButtonElement>('.conduit-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const pastel = btn.dataset.pastel || '#bae6fd';
        applyConduitColor(pastel);
      });
    });

    // Inspector Toggle
    const inspectorDrawer = document.getElementById('workbench-inspector-drawer');
    const btnToggleInspector = document.getElementById('btn-toggle-inspector');
    const btnCloseInspector = document.getElementById('btn-close-inspector');

    btnToggleInspector?.addEventListener('click', () => {
      if (inspectorDrawer) {
        const isVisible = inspectorDrawer.style.display !== 'none';
        inspectorDrawer.style.display = isVisible ? 'none' : 'block';
        if (!isVisible) {
          inspectorDrawer.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });

    btnCloseInspector?.addEventListener('click', () => {
      if (inspectorDrawer) inspectorDrawer.style.display = 'none';
    });

    // Copy SVG Path
    const btnCopySvg = document.getElementById('btn-copy-svg-path');
    btnCopySvg?.addEventListener('click', () => {
      const path = document.querySelector<SVGPathElement>('.hero-silhouette-path');
      if (path) {
        const d = path.getAttribute('d') || '';
        navigator.clipboard.writeText(d).then(() => {
          btnCopySvg.textContent = '✓ ¡Copiado!';
          setTimeout(() => { btnCopySvg.textContent = 'Copiar SVG Path Canvas'; }, 2000);
        });
      }
    });
  });
</script>
