    flex-wrap: nowrap;
    gap: 6px;
  }

  .screen-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid var(--nexa-color-border-default, #e2e8f0);
    background: var(--nexa-color-neutral-50, #f8fafc);
    color: var(--nexa-color-text-secondary, #475569);
    font-size: 11.5px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .screen-tab-btn:hover {
    background: #ffffff;
    color: #2563eb;
    border-color: #bfdbfe;
  }

  .screen-tab-btn.active {
    background: #2563eb;
    color: #ffffff;
    border-color: transparent;
    font-weight: 700;
  }

  .screen-tab-btn.active .screen-idx {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .screen-idx {
    font-size: 10px;
    font-weight: 800;
    padding: 1px 4px;
    border-radius: 4px;
    background: #e2e8f0;
    color: #475569;
    font-family: monospace;
  }

  /* Mock Screen Cards */
  .mocks-stage-layout {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
  }

  .mock-screen-card {
    display: none;
    flex-direction: column;
    gap: 20px;
    background: #ffffff;
    border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
  }

  .mock-screen-card.active {
    display: flex;
  }

  /* Card Meta Header */
  .device-meta-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
  }

  .device-eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--nexa-color-primary-700, #1d4ed8);
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .device-name {
    font-family: var(--nexa-font-family-display, sans-serif);
    font-size: 18px;
    font-weight: 800;
    color: var(--nexa-color-text-primary, #0f172a);
    margin: 0;
  }

  .device-sub {
    font-size: 13px;
    color: var(--nexa-color-text-secondary, #64748b);
    margin: 2px 0 0;
  }

  .meta-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid transparent;
  }

  .meta-pill.role { background: #f1f5f9; color: #334155; }
  .meta-pill.touch { background: #e0f2fe; color: #0284c7; border-color: #bae6fd; }
  .meta-pill.gold { background: #fef3c7; color: #92400e; border-color: #fde68a; }
  .meta-pill.feature { background: #eff6ff; color: #1e40af; border-color: #bfdbfe; }
  .meta-pill.industrial { background: #fff7ed; color: #9a3412; border-color: #ffedd5; }
  .meta-pill.zebra { background: #0f172a; color: #f8fafc; }

  /* Split Viewer */
  .mock-split-viewer {
    display: grid;
    grid-template-columns: minmax(360px, 412px) 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 1080px) {
    .mock-split-viewer {
      grid-template-columns: 1fr;
    }
  }

  /* ==========================================================================
     PHYSICAL ANDROID CHASSIS FRAMES
     ========================================================================== */
  .android-chassis {
    background: #0f172a;
    border-radius: 36px;
    padding: 10px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.18), inset 0 0 0 2px #334155;
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    width: 100%;
  }

  .android-chassis.phone-s24 {
    max-width: 390px;
    min-height: 740px;
    border-radius: 40px;
  }

  .android-chassis.phone-s24-ultra {
    max-width: 412px;
    min-height: 780px;
    border-radius: 28px;
  }

  .android-chassis.phone-zebra {
    max-width: 412px;
    min-height: 780px;
    border-radius: 26px;
    border: 4px solid #334155;
    box-shadow: 0 16px 44px rgba(15, 23, 42, 0.25), inset 0 0 0 3px #0f172a;
  }

  .zebra-top-scanner-bumper {
    height: 24px;
    background: #1e293b;
    border-radius: 14px 14px 4px 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    margin-bottom: 6px;
  }

  .scanner-amber-stripe {
    width: 28px;
    height: 6px;
    background: #eab308;
    border-radius: 3px;
  }

  .zebra-brand-label {
    font-size: 8.5px;
    font-weight: 800;
    color: #94a3b8;
    letter-spacing: 0.1em;
    font-family: var(--nexa-font-family-mono, monospace);
  }

  .chassis-speaker-slit {
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 44px;
    height: 4px;
    background: #334155;
    border-radius: 2px;
    z-index: 20;
  }

  .chassis-punch-hole {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    background: #000000;
    border-radius: 50%;
    border: 1px solid #1e293b;
    z-index: 20;
  }

  /* Android Screen Surface */
  .android-screen-surface {
    background: #f8fafc;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 680px;
    position: relative;
    color: var(--nexa-color-text-primary, #0f172a);
    font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
    font-size: 13px;
  }

  /* M3 System Bar */
  .m3-system-bar {
    height: 28px;
    background: #ffffff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px;
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    border-bottom: 1px solid #f1f5f9;
    flex-shrink: 0;
  }

  .m3-system-bar.zebra-bar { border-bottom: 1px solid #e2e8f0; }
  .sys-time { font-family: monospace; font-weight: 700; color: #0f172a; }
  .sys-icons { display: flex; align-items: center; gap: 8px; }
  .sys-tech { font-size: 9.5px; font-weight: 700; color: #2563eb; }
  .sys-battery { font-family: monospace; font-size: 10.5px; }

  /* ==========================================================================
     M3 TOP APP BAR (CANONICAL - ALWAYS ACTIVE!)
     ========================================================================== */
  .m3-top-bar {
    height: 52px;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    flex-shrink: 0;
  }

  .top-bar-btn {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: none;
    background: transparent;
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    cursor: pointer;
    position: relative;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .top-bar-btn:hover {
    background: #f1f5f9;
    color: #1e293b;
  }

  .top-bar-btn.notif .notif-red-dot {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 8px;
    height: 8px;
    background: #ef4444;
    border-radius: 50%;
    border: 1.5px solid #ffffff;
  }

  .notif-badge-number {
    position: absolute;
    top: 8px;
    right: 8px;
    background: #2563eb;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .top-bar-title {
    font-family: var(--nexa-font-family-display, sans-serif);
    font-size: 15.5px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }

  .top-bar-dual-title {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .unit-code-badge {
    font-size: 10px;
    color: #2563eb;
    font-weight: 700;
  }

  /* Screen Scroll Body */
  .screen-scroll-body {
    flex: 1;
    overflow-y: auto;
    padding: 14px 14px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .screen-section-label {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #64748b;
    text-transform: uppercase;
    margin: 4px 2px;
  }

  .section-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* ==========================================================================
     CARDS & ATOMIC COMPONENTS (ZERO GREEN Semantics)
     ========================================================================== */
  .driver-card-white {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .driver-avatar-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #e0f2fe;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .driver-info-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .driver-name-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .driver-name {
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
  }

  .driver-detail-text, .driver-detail-sub {
    font-size: 11.5px;
    color: #64748b;
  }

  /* Semantic Status Pills (ZERO GREEN) */
  .status-pill-cyan {
    font-size: 9.5px;
    font-weight: 800;
    background: #e0f2fe;
    color: #0284c7;
    border: 1px solid #bae6fd;
    padding: 2px 7px;
    border-radius: 999px;
  }

  .status-pill-amber {
    font-size: 9.5px;
    font-weight: 800;
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
    padding: 2px 7px;
    border-radius: 999px;
  }

  .cold-chip-pill {
    background: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .cold-chip-pill.live {
    background: #e0f2fe;
    color: #0284c7;
    border-color: #bae6fd;
  }

  .order-code-mono {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 12.5px;
    font-weight: 800;
    color: #2563eb;
  }

  .dispatch-card-white {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .dispatch-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dispatch-buyer-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .buyer-company-name {
    font-size: 14.5px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }

  .buyer-cargo-desc {
    font-size: 11.5px;
    color: #475569;
    margin: 0;
  }

  /* Route Timeline */
  .route-timeline-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .timeline-stop {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 4px;
    flex-shrink: 0;
  }

  .timeline-dot.blue { background: #2563eb; }
  .timeline-dot.cyan { background: #0284c7; }

  .timeline-vertical-line {
    width: 2px;
    height: 16px;
    background: #cbd5e1;
    margin-left: 4px;
  }

  .timeline-stop-text {
    display: flex;
    flex-direction: column;
  }

  .stop-name { font-size: 12px; font-weight: 700; color: #0f172a; }
  .stop-time { font-size: 10.5px; color: #64748b; }

  /* Solid CTA Button (Navy Brand #082846) */
  .btn-solid-blue-cta {
    min-height: 52px;
    background: #082846;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: 13.5px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(8, 40, 70, 0.25);
    transition: all 0.15s ease;
    width: 100%;
  }

  .btn-solid-blue-cta:hover {
    background: #172554;
    transform: translateY(-1px);
  }

  .btn-solid-blue-cta.industrial-56dp {
    min-height: 56px;
    font-size: 14px;
    background: #1d4ed8;
  }

  .btn-action-outline-pill {
    min-height: 44px;
    padding: 0 14px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #1e293b;
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-action-outline-pill.arrived {
    background: #e0f2fe;
    border-color: #bae6fd;
    color: #0284c7;
    font-weight: 700;
  }

  .quick-telemetry-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px 14px;
    display: flex;
    justify-content: space-around;
    align-items: center;
  }

  .telemetry-item { display: flex; flex-direction: column; gap: 2px; align-items: center; }
  .tel-label { font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: 700; }
  .tel-val { font-size: 13px; font-weight: 800; color: #0f172a; font-family: monospace; }
  .tel-val.success { color: #0284c7; }
  .telemetry-separator { width: 1px; height: 28px; background: #e2e8f0; }

  /* Steppers & Quantity Controls */
  .box-stepper-control {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 6px;
  }

  .btn-stepper {
    min-width: 48px;
    min-height: 48px;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    font-size: 16px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .stepper-center-data { display: flex; flex-direction: column; align-items: center; }
  .stepper-amount-big { font-size: 20px; font-weight: 900; color: #0f172a; font-family: monospace; }
  .stepper-total-hint { font-size: 10.5px; color: #64748b; }
  .btn-stepper-micro { padding: 2px 6px; font-size: 10px; font-weight: 700; background: #e2e8f0; border: none; border-radius: 4px; cursor: pointer; }

  /* FEFO Flag Box */
  .fefoflag-box {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fefo-label { font-size: 9.5px; font-weight: 800; color: #1e40af; }
  .fefo-lot { font-size: 12px; color: #0f172a; font-family: monospace; }

  /* Security / Seals / Toggles */
  .security-seal-row, .pod-signature-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
  }
  .seal-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #e0f2fe;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }
  .seal-info-col, .toggle-text-block { flex: 1; display: flex; flex-direction: column; }
  .seal-title, .toggle-title { font-size: 12px; font-weight: 700; color: #0f172a; }
  .seal-sub, .toggle-sub { font-size: 10.5px; color: #64748b; }
  .toggle-control-label { display: flex; align-items: center; gap: 10px; cursor: pointer; flex: 1; }
  .nexa-checkbox { width: 20px; height: 20px; border-radius: 4px; accent-color: #2563eb; cursor: pointer; }
  .btn-badge-action {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: 8px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e40af;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
  }

  /* ISO 3691 Safety Switches */
  .ignition-warning-banner {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 12px;
    padding: 12px;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .ignition-warning-banner.passed { background: #e0f2fe; border-color: #bae6fd; }
  .warning-icon-box {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #fee2e2;
    color: #dc2626;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .warning-icon-box.passed { background: #e0f2fe; color: #0284c7; }
  .warning-text-col { display: flex; flex-direction: column; gap: 2px; }
  .warning-text-col strong { font-size: 12px; color: #991b1b; }
  .warning-text-col.passed strong { color: #0284c7; }
  .warning-text-col span { font-size: 11px; color: #64748b; }
  .safety-switches-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 6px 12px;
    display: flex;
    flex-direction: column;
  }
  .safety-switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #f1f5f9;
    min-height: 56px;
  }
  .safety-switch-row:last-child { border-bottom: none; }
  .switch-info { display: flex; flex-direction: column; gap: 2px; }
  .switch-title { font-size: 12.5px; font-weight: 700; color: #0f172a; }
  .switch-desc { font-size: 10.5px; color: #64748b; }

  /* Signature Canvas Preview */
  .signature-canvas-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sig-svg { width: 100%; height: 60px; }
  .sig-watermark-row {
    display: flex;
    justify-content: space-between;
    font-size: 9.5px;
    font-family: monospace;
    color: #64748b;
  }

  /* Wholesale Tier Table */
  .tier-table-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .tier-col {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .tier-col.active { background: #e0f2fe; border-color: #bae6fd; }
  .tier-label { font-size: 10px; color: #64748b; }
  .tier-price { font-size: 14px; font-weight: 800; color: #0f172a; font-family: monospace; }
  .tier-save { font-size: 9.5px; font-weight: 700; color: #94a3b8; }
  .tier-save.highlight { color: #0284c7; }
  .subtotal-calc-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .subtotal-row { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 600; }
  .subtotal-amount { font-size: 16px; font-weight: 800; color: #2563eb; font-family: monospace; }
  .tier-applied-note { font-size: 10.5px; font-weight: 700; color: #0284c7; }

  /* OTP Display Box */
  .otp-display-container {
    background: #f8fafc;
