  .workbench-action-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  /* --------------------------------------------------------------------------
     2. HERO SCULPTED STAGE & BUROCRATIK SILHOUETTE
     -------------------------------------------------------------------------- */
  .workbench-hero-stage {
    position: relative;
    width: 100%;
    background-color: #ffffff;
    padding: 2.25rem 2.5rem 3.5rem 2.5rem;
    overflow-x: clip;
    display: flex;
    justify-content: center;
  }

  .hero-sculpted-canvas {
    position: relative;
    width: 100%;
    max-width: 1560px;
    min-height: 820px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-silhouette-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
    filter: drop-shadow(0 24px 48px rgba(8, 40, 70, 0.08));
  }

  .hero-silhouette-path {
    transition: fill 0.3s ease;
  }

  /* 2.1 Top Layer (Exact Match to Hero.astro Sandbox Geometry) */
  .hero-top-layer {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: flex-start;
    width: 100%;
    min-height: 135px;
  }

  /* Top-Left White Notch: Pure Transparent Background (Zero Spikes!) */
  .hero-top-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem 1.5rem 0.75rem;
    background: transparent;
    flex-shrink: 0;
  }

  .hero-home-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    color: #082846;
    font-size: 15px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(8, 40, 70, 0.08);
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .hero-home-btn:hover {
    background: #f0f9ff;
    border-color: #38bdf8;
    color: #0284c7;
    transform: scale(1.05);
  }

  .nexa-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .nexa-brand-logo {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .nexa-brand-word {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #2563eb;
  }

  .hero-nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hero-nav-link:hover,
  .hero-nav-link.active {
    color: #0284c7;
  }

  /* Top-Center Elevated Crown (Exact Spacious Padding from Sandbox) */
  .hero-top-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: 0.95rem;
    flex: 1;
    min-width: 340px;
    max-width: 680px;
    margin: 0 auto;
    z-index: 10;
  }

  .hero-crown-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .hero-main-title {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(1.85rem, 2.7vw, 2.45rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .hero-main-sub {
    font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
    font-size: clamp(0.8125rem, 1vw, 0.9375rem);
    color: rgba(224, 242, 254, 0.88);
    margin: 0;
    max-width: 42ch;
    line-height: 1.35;
  }

  /* Top-Right White Notch: Pure Transparent Background (Zero Spikes!) */
  .hero-top-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    padding: 1.25rem 0.75rem 1.5rem 1.5rem;
    background: transparent;
  }

  .hero-lang-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.95rem;
    border-radius: 9999px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    color: #082846;
