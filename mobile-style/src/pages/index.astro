---
/**
 * MOBILE STYLE — MASTER VISUAL REPORT & MULTI-DEVICE ANDROID STUDIO
 * Nexa Design Lab · Canonical Android Jetpack Compose M3 Specifications
 *
 * FULL VISUAL FIRST ARCHITECTURE:
 * Designed for direct visual reporting, PDF export, and executive reviews without interactive gates.
 *
 * Structure:
 * 1. Grand Multi-Device Android Showcase (Galaxy S24, S24 Ultra, Zebra TC58, Tab Active 8", Tab S9 11")
 * 2. Visual Design Foundations M3 (Swatches, Type Matrix, 8dp Grid, Elevations, Caliper, Thumb Reach)
 * 3. Technical Specifications, Architecture C4, SQLite Room & Production Kotlin Code (At the bottom)
 */
import 'primeicons/primeicons.css';
import '../styles/mobile-tokens.css';
import UnifiedLabShell from '../components/layout/UnifiedLabShell.astro';

// 1. Master Multi-Device Android Showcase & Interactive Simulator
import GaleriaVisualAndroid from '../components/simulator/GaleriaVisualAndroid.astro';
import DeviceFrame from '../components/simulator/DeviceFrame.astro';

// 2. Visual Design Foundations M3
import TokensColorSection from '../components/guidelines/TokensColorSection.astro';
import TipografiaSpSection from '../components/guidelines/TipografiaSpSection.astro';
import Cuadricula8dpSection from '../components/guidelines/Cuadricula8dpSection.astro';
import ElevacionesM3Section from '../components/guidelines/ElevacionesM3Section.astro';
import Ergonomia48dpSection from '../components/guidelines/Ergonomia48dpSection.astro';
import ZonasAlcanceSection from '../components/guidelines/ZonasAlcanceSection.astro';

// 3. Technical Specifications & Kotlin Code (At the bottom)
import MobileArchitectureHero from '../components/guidelines/MobileArchitectureHero.astro';
import MobileEvidenceModel from '../components/guidelines/MobileEvidenceModel.astro';
import MobileHardwareSection from '../components/guidelines/MobileHardwareSection.astro';
import MobileResilienceSection from '../components/guidelines/MobileResilienceSection.astro';
import MobileComponentsSection from '../components/guidelines/MobileComponentsSection.astro';
import CodeSnippetsTabs from '../components/spec/CodeSnippetsTabs.astro';

// Blueprint User Stories
import DriverRouteStory from '../components/stories/DriverRouteStory.astro';
import WarehousePickingStory from '../components/stories/WarehousePickingStory.astro';
import DispatchBoardStory from '../components/stories/DispatchBoardStory.astro';
import MachineryInspectionStory from '../components/stories/MachineryInspectionStory.astro';

// Live Simulator Modules
import InteractiveDispatchMovement from '../components/simulator/InteractiveDispatchMovement.astro';
import InteractiveWholesaleCatalog from '../components/simulator/InteractiveWholesaleCatalog.astro';
import InteractiveMobileForms from '../components/simulator/InteractiveMobileForms.astro';
import InteractiveMobileNavbar from '../components/simulator/InteractiveMobileNavbar.astro';
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mobile Visual Report · Multi-Device Studio · Nexa Design Lab (Android Compose M3)</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link 
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" 
    rel="stylesheet"
  >

  <style>
    /* Global Reset & Box-Sizing Hygiene */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--nexa-surface-page, #f6faff);
      color: var(--nexa-color-text-primary, #0f172a);
      font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* Master Report Container (Full visual flow, zero display:none) */
    .visual-report-page {
      width: min(calc(100% - 48px), var(--nexa-layout-content-max, 1400px));
      margin: 0 auto;
      padding: clamp(24px, 4vw, 48px) 0 96px;
      color: var(--nexa-color-text-primary, #0f172a);
      display: flex;
      flex-direction: column;
      gap: 40px;
    }

    /* Documentation Header */
    .report-header {
      display: grid;
      gap: 18px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    .breadcrumb-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      color: var(--nexa-color-text-muted, #94a3b8);
      font: 500 11px/1.4 var(--nexa-font-family-mono, monospace);
    }

    .breadcrumb-row a {
      color: var(--nexa-color-primary-700, #1d4ed8);
      text-decoration: none;
      font-weight: 600;
    }

    .header-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 32px;
      align-items: start;
    }

    @media (max-width: 960px) {
      .header-grid {
        grid-template-columns: 1fr;
      }
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .12em;
      line-height: 1.3;
      text-transform: uppercase;
    }

    .report-header h1 {
      max-width: 860px;
      margin: 0;
      font: 800 clamp(24px, 3.2vw, 38px)/1.15 var(--nexa-font-family-display, sans-serif);
      letter-spacing: -.035em;
      color: var(--nexa-color-text-primary, #0f172a);
    }

    .intro {
      max-width: 800px;
      margin: 12px 0 0;
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 14.5px;
      line-height: 1.6;
    }

    .status-panel {
      display: grid;
      gap: 8px;
      padding: 16px;
      border: 1px solid var(--nexa-color-border-default, #e2e8f0);
      border-radius: var(--nexa-radius-card, 16px);
      background: var(--nexa-surface-card, #ffffff);
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 11.5px;
      line-height: 1.4;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .status-label {
      margin: 0;
      color: var(--nexa-color-text-muted, #94a3b8);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .design-status {
      display: inline-flex;
      width: fit-content;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .04em;
      color: var(--nexa-color-primary-800, #1e40af);
      background: var(--nexa-color-primary-100, #dbeafe);
    }

    .adoption-status {
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-weight: 700;
    }

    .header-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
      color: var(--nexa-color-text-muted, #94a3b8);
      font-size: 11.5px;
    }

    .header-meta span {
      display: inline-flex;
      gap: 6px;
      align-items: center;
    }

    .header-meta i {
      color: var(--nexa-color-primary-600, #2a67d9);
      font-size: 13px;
    }

    /* Print / Export Report Bar */
    .report-action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding: 12px 18px;
      background: #ffffff;
      border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
      border-radius: 12px;
      font-size: 12px;
    }

    .report-notice {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--nexa-color-text-secondary, #475569);
      font-weight: 600;
    }

    .btn-print-report {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: var(--nexa-color-primary-600, #2563eb);
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.15s ease;
    }

    .btn-print-report:hover { opacity: 0.9; }

    /* Showcase View Switcher Bar */
    .showcase-view-switch-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 4px;
    }

    .mobile-view-toggle-group {
      display: inline-flex;
      background: #ffffff;
      border: 1px solid var(--nexa-color-border-default, #cbd5e1);
      border-radius: 10px;
      padding: 4px;
      gap: 4px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .btn-view-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 7px;
      border: none;
      background: transparent;
      color: #475569;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn-view-toggle:hover {
      background: #f1f5f9;
      color: #0f172a;
    }

    .btn-view-toggle.active {
      background: #0f172a;
      color: #ffffff;
      box-shadow: 0 1px 4px rgba(15, 23, 42, 0.2);
    }

    .btn-view-toggle.active strong {
      color: #38c8ff;
    }

    .mobile-main-stage-view {
      width: 100%;
    }

    /* Part Dividers */
    .part-separator-block {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 32px 0 16px;
      border-top: 2px dashed var(--nexa-color-border-structural, #e2e8f0);
      margin-top: 16px;
    }

    .part-tag {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.14em;
      color: var(--nexa-color-primary-700, #1d4ed8);
      text-transform: uppercase;
    }

    .part-title {
      font-family: var(--nexa-font-family-display, sans-serif);
      font-size: 22px;
      font-weight: 800;
      color: var(--nexa-color-text-primary, #0f172a);
      margin: 0;
      letter-spacing: -0.02em;
    }

    .part-desc {
      font-size: 13.5px;
      color: var(--nexa-color-text-secondary, #64748b);
      max-width: 860px;
      margin: 0;
      line-height: 1.5;
    }

    /* Technical Collapsible Wrapper */
    .technical-specs-container {
      display: flex;
      flex-direction: column;
      gap: 28px;
      background: #ffffff;
      border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
      border-radius: var(--nexa-radius-card, 16px);
      padding: 24px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .tech-accordion-item {
      border: 1px solid var(--nexa-color-border-default, #e2e8f0);
      border-radius: 12px;
      overflow: hidden;
      background: #ffffff;
    }

    .tech-accordion-summary {
      padding: 16px 20px;
      background: var(--nexa-color-neutral-50, #f8fafc);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--nexa-font-family-display, sans-serif);
      font-size: 15px;
      font-weight: 700;
      color: var(--nexa-color-text-primary, #0f172a);
      user-select: none;
      list-style: none;
      transition: background 0.15s ease;
    }

    .tech-accordion-summary::-webkit-details-marker {
      display: none;
    }

    .tech-accordion-summary:hover {
      background: #f1f5f9;
    }

    .tech-summary-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .tech-badge-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: #eff6ff;
      color: #2563eb;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
    }

    .tech-chevron-icon {
      font-size: 12px;
      color: #64748b;
      transition: transform 0.2s ease;
    }

    details[open] .tech-chevron-icon {
      transform: rotate(180deg);
    }

    .tech-accordion-body {
      padding: 20px;
      border-top: 1px solid #e2e8f0;
      background: #ffffff;
    }

    /* Provenance Section */
    .provenance-section {
      padding: 32px 0 0;
      border-top: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    .provenance-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    @media (max-width: 900px) {
      .provenance-grid {
        grid-template-columns: 1fr;
      }
    }

    .provenance-grid > div {
      padding: 16px;
      border-top: 3px solid var(--nexa-color-primary-300, #93c5fd);
      background: var(--nexa-surface-card, #ffffff);
      border-radius: 0 0 10px 10px;
      border-left: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      border-right: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      border-bottom: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
    }

    .provenance-grid b {
      font-size: 13px;
      color: var(--nexa-color-text-primary, #0f172a);
    }

    .provenance-grid p {
      margin: 8px 0 0;
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 12px;
      line-height: 1.5;
    }

    /* Print Media Query */
    @media print {
      body {
        background: #ffffff !important;
      }
      .visual-report-page {
        width: 100% !important;
        padding: 0 !important;
      }
      .report-action-bar, .device-switcher-bar {
        display: none !important;
      }
      .android-chassis {
        box-shadow: none !important;
        border: 2px solid #334155 !important;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>

  <!-- Unified Design Lab Shell with anchor navigation -->
  <UnifiedLabShell currentSection="mobile">
    <main class="visual-report-page" id="documentation-content">
      
      <!-- Top Documentation Header -->
      <header class="report-header">
        <div class="breadcrumb-row">
          <a href="/">Design Lab</a>
          <span aria-hidden="true">/</span>
          <span>Mobile Style</span>
          <span aria-hidden="true">/</span>
          <span id="breadcrumb-current-screen">Informe Visual Multi-Dispositivo Android</span>
        </div>

        <div class="header-grid">
          <div>
            <p class="eyebrow">INFORME VISUAL CANÓNICO · FULL VISUAL FIRST</p>
            <h1>Directrices de Diseño Móvil (Android Kotlin Compose M3)</h1>
            <p class="intro">
              Muestrario canónico y reporte visual para <strong>Nexa Suite</strong>. Presenta los 5 factores de forma Android estándar (Samsung S24, S24 Ultra, Zebra TC58, Galaxy Tab Active 8" y Tab S9 11"), interfaces minimalistas con fondo blanco, TopAppBar y Navbar activa en todas las pantallas, fundamentos M3 con contraste accesible WCAG AAA y contratos de ingeniería en Kotlin Compose.
            </p>
          </div>

          <aside class="status-panel">
            <span class="status-label">MATURIDAD</span>
            <strong class="design-status">FROZEN CANDIDATE</strong>
            <span class="status-label">ADOPCIÓN</span>
            <strong class="adoption-status">Operations Android (:core:designsystem)</strong>
            <span>Android SDK 37 (minSdk 29) · Kotlin 2.4 · WCAG 2.2 AAA</span>
          </aside>
        </div>

        <div class="header-meta">
          <span><i class="pi pi-android" aria-hidden="true"></i>Kotlin 2.4 · Jetpack Compose M3</span>
          <span><i class="pi pi-shield" aria-hidden="true"></i>ADR-0018 Candidate</span>
          <span><i class="pi pi-eye" aria-hidden="true"></i>100% Fondo Blanco Minimalista</span>
          <span><i class="pi pi-bars" aria-hidden="true"></i>Navbar M3 Siempre Activa</span>
          <span><i class="pi pi-camera" aria-hidden="true"></i>CameraX + ML Kit Vision</span>
        </div>
      </header>

      <!-- Visual Report Export / Action Notice Bar -->
      <div class="report-action-bar">
        <div class="report-notice">
          <i class="pi pi-info-circle text-primary"></i>
          <span>Documento preparado para captura visual y exportación PDF: Toda la galería y fundamentos son visibles de inmediato sin clics previos.</span>
        </div>
        <button type="button" class="btn-print-report" onclick="window.print()">
          <i class="pi pi-print"></i>
          <span>Imprimir / Exportar PDF</span>
        </button>
      </div>

      <!-- =====================================================================
           PARTE 1: SIMULADOR INTERACTIVO ANDROID & ESCAPARATE MULTI-DISPOSITIVO
           ===================================================================== -->
      <div class="part-separator-block" id="seccion-simulador">
        <span class="part-tag">PARTE 1 · SIMULADOR ANDROID & ESTUDIO MULTI-DISPOSITIVO</span>
        <div class="showcase-view-switch-bar">
          <div>
            <h2 class="part-title">Simulador Móvil Interactivo & Estudio Multi-Dispositivo Android</h2>
            <p class="part-desc">
              Alterna entre el <strong>Simulador Interactivo en Vivo</strong> (con cambio de factor de forma, navegación activa y Kanban adaptativo) y la <strong>Galería de los 5 Dispositivos Lado a Lado</strong> para captura e informe visual.
            </p>
          </div>
          <div class="mobile-view-toggle-group">
            <button type="button" class="btn-view-toggle active" id="btn-toggle-simulator">
              <i class="pi pi-sliders-h"></i>
              <strong>✦ Simulador Interactivo (Medidas & Tabs)</strong>
            </button>
            <button type="button" class="btn-view-toggle" id="btn-toggle-gallery">
              <i class="pi pi-th-large"></i>
              <span>Galería 5 Dispositivos (Reporte Visual)</span>
            </button>
          </div>
        </div>
      </div>

      <!-- View 1: Live Interactive Simulator (DEFAULT & ACTIVE) -->
      <div id="view-interactive-simulator-stage" class="mobile-main-stage-view active">
        <DeviceFrame />
      </div>

      <!-- View 2: Multi-Device Side-by-Side Gallery (Ready for PDF/Screenshot report) -->
      <div id="view-multi-device-gallery-stage" class="mobile-main-stage-view" style="display: none;">
        <GaleriaVisualAndroid />
      </div>


      <!-- =====================================================================
           PARTE 2: FUNDAMENTOS DE DISEÑO VISUAL M3 (VISUAL FOUNDATIONS)
           ===================================================================== -->
      <div class="part-separator-block">
        <span class="part-tag">PARTE 2 · FUNDAMENTOS VISUALES M3</span>
        <h2 class="part-title">Fundamentos Visuales de Color, Tipografía, Grids, Elevación & Ergonomía</h2>
        <p class="part-desc">
          Tokens visuales certificados para Android Jetpack Compose. Muestrarios de roles tonales M3 con contraste verificado bajo WCAG 2.2 AAA, tipografía escalar en <code>sp</code>, cuadrícula espacial de 8dp, elevaciones con sombra real, calibrador táctil de 48dp vs 56dp para guantes y zonas biomecánicas del pulgar.
        </p>
      </div>

      <!-- 2.1 Paleta Tonal M3 & Swatches de Color -->
      <section id="fundamentos-color">
        <TokensColorSection />
      </section>

      <!-- 2.2 Tipografía Escalar en sp -->
      <section id="fundamentos-tipografia">
        <TipografiaSpSection />
      </section>

      <!-- 2.3 Cuadrícula Espacial 8dp -->
      <section id="fundamentos-cuadricula">
        <Cuadricula8dpSection />
      </section>

      <!-- 2.4 Elevaciones Tonal M3 (Level 0 a Level 5) -->
      <section id="fundamentos-elevacion">
        <ElevacionesM3Section />
      </section>

      <!-- 2.5 Ergonomía Táctil: Calibrador 48dp vs 56dp -->
      <section id="fundamentos-ergonomia">
        <Ergonomia48dpSection />
      </section>

      <!-- 2.6 Zonas Biomecánicas de Alcance del Pulgar -->
      <section id="fundamentos-alcance">
        <ZonasAlcanceSection />
      </section>


      <!-- =====================================================================
           PARTE 3: ESPECIFICACIONES TÉCNICAS & CÓDIGO KOTLIN :core:designsystem
           (Organized at the bottom as requested!)
           ===================================================================== -->
      <div class="part-separator-block" id="especificaciones-tecnicas">
        <span class="part-tag">PARTE 3 · ESPECIFICACIONES TÉCNICAS & CONTRATOS</span>
        <h2 class="part-title">Especificaciones Técnicas, Contratos C4 & Código Kotlin (:core:designsystem)</h2>
        <p class="part-desc">
          Documentación técnica profunda, modelos de arquitectura C4, colas offline con SQLite Room y WorkManager, contratos de hardware CameraX y código nativo Kotlin 2.4 para el equipo de ingeniería Android.
        </p>
      </div>

      <div class="technical-specs-container">
        <!-- 3.1 Arquitectura C4 & Stack Android -->
        <details class="tech-accordion-item" open id="tech-arquitectura">
          <summary class="tech-accordion-summary">
            <div class="tech-summary-left">
              <span class="tech-badge-icon"><i class="pi pi-compass"></i></span>
              <span>1. Arquitectura C4 & Stack Tecnológico Android (Kotlin 2.4 · Compose M3)</span>
            </div>
            <i class="pi pi-chevron-down tech-chevron-icon"></i>
          </summary>
          <div class="tech-accordion-body">
            <MobileArchitectureHero />
          </div>
        </details>

        <!-- 3.2 Modelo de Evidencia & C4 de Calidad -->
        <details class="tech-accordion-item" open id="tech-evidencia">
          <summary class="tech-accordion-summary">
            <div class="tech-summary-left">
              <span class="tech-badge-icon"><i class="pi pi-shield"></i></span>
              <span>2. Modelo de Evidencia ADR-0018 & Puertas de Calidad</span>
            </div>
            <i class="pi pi-chevron-down tech-chevron-icon"></i>
          </summary>
          <div class="tech-accordion-body">
            <MobileEvidenceModel />
          </div>
        </details>

        <!-- 3.3 Hardware CameraX & Resiliencia Offline WorkManager -->
        <details class="tech-accordion-item" id="tech-hardware">
          <summary class="tech-accordion-summary">
            <div class="tech-summary-left">
              <span class="tech-badge-icon"><i class="pi pi-qrcode"></i></span>
              <span>3. Hardware CameraX, Escáner Óptico & Zebra SE55 Imager</span>
            </div>
            <i class="pi pi-chevron-down tech-chevron-icon"></i>
          </summary>
          <div class="tech-accordion-body">
            <MobileHardwareSection />
          </div>
        </details>

        <details class="tech-accordion-item" id="tech-resiliencia">
          <summary class="tech-accordion-summary">
            <div class="tech-summary-left">
              <span class="tech-badge-icon"><i class="pi pi-sync"></i></span>
              <span>4. Resiliencia de Red, Cola SQLite Room & Sincronización WorkManager</span>
            </div>
            <i class="pi pi-chevron-down tech-chevron-icon"></i>
          </summary>
          <div class="tech-accordion-body">
            <MobileResilienceSection />
          </div>
        </details>

        <!-- 3.4 Catálogo Canónico Compose & Código Nativo -->
        <details class="tech-accordion-item" id="tech-componentes">
          <summary class="tech-accordion-summary">
            <div class="tech-summary-left">
              <span class="tech-badge-icon"><i class="pi pi-id-card"></i></span>
              <span>5. Catálogo Canónico de Componentes Jetpack Compose M3</span>
            </div>
