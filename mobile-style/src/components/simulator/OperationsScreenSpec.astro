---
/**
 * OperationsScreenSpec — Specimen for Nexa Operations Mobile (Android / Jetpack Compose)
 * Represents the canonical wholesale cold-chain driver identification & active dispatch slice.
 */
---

<div class="screen-content">
  <!-- Driver Identification Card -->
  <div class="driver-card">
    <div class="driver-avatar">
      <i class="pi pi-user" aria-hidden="true"></i>
    </div>
    <div class="driver-info">
      <div class="driver-name-row">
        <span class="driver-name">Diego Morales</span>
        <span class="status-chip active">EN RUTA</span>
      </div>
      <span class="driver-role">Conductor Flota C-250 · ID #4829</span>
      <span class="driver-unit">Furgón Refrigerado · Placa WKN-892</span>
    </div>
  </div>

  <!-- Active Dispatch Route (Wholesale Cold-Chain B2B) -->
  <div class="section-label">DESPACHO EN CURSO · CADENA DE FRÍO</div>
  <div class="dispatch-card">
    <div class="dispatch-header">
      <span class="order-id">SO-2026-0018</span>
      <span class="cold-chip"><i class="pi pi-snowflake" aria-hidden="true"></i> 2°C – 6°C</span>
    </div>

    <div class="buyer-brief">
      <h4 class="buyer-name">ICISA Distribuciones</h4>
      <span class="buyer-cargo">24x Salmón Salar (ALM-LMO-982) + 12x Merluza Austral</span>
    </div>

    <div class="route-timeline">
      <div class="timeline-step">
        <div class="step-dot origin"></div>
        <div class="step-details">
          <span class="step-title">Almacén Frigorífico Central</span>
          <span class="step-sub">Salida Muelle 3 Frío · 13:45</span>
        </div>
      </div>
      <div class="timeline-line"></div>
      <div class="timeline-step">
        <div class="step-dot destination"></div>
        <div class="step-details">
          <span class="step-title">ICISA Distribuciones (Av. Argentina 1240)</span>
          <span class="step-sub">ETA 14:20 · Sensor Calibrado 3.8°C</span>
        </div>
      </div>
    </div>

    <!-- Action Button (Min 56dp touch target) -->
    <button type="button" class="btn-primary-mobile">
      <i class="pi pi-check-circle" aria-hidden="true"></i>
      <span>Confirmar Entrega en Sitio (POD)</span>
    </button>
  </div>
</div>

<style>
  .screen-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--nexa-mobile-surface-bg, #f8fafc);
    color: var(--nexa-mobile-text-primary, #0f172a);
    font-family: var(--nexa-mobile-font-family, sans-serif);
    font-size: 14px;
    position: relative;
    padding-bottom: 64px;
  }

  .m3-top-app-bar {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    background: var(--nexa-mobile-surface-card, #ffffff);
    border-bottom: 1px solid var(--nexa-mobile-border, #e2e8f0);
  }

  .app-bar-title {
    font-family: var(--nexa-mobile-font-family-display, sans-serif);
    font-weight: 700;
    font-size: 16px;
  }

  .nav-icon, .action-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 18px;
    color: var(--nexa-mobile-text-secondary, #64748b);
  }

  .driver-card {
    margin: 14px 16px;
    padding: 12px 14px;
    background: var(--nexa-mobile-surface-card, #ffffff);
    border: 1px solid var(--nexa-mobile-border, #e2e8f0);
    border-radius: var(--nexa-mobile-radius-card, 16px);
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .driver-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #e0f2fe;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .driver-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .driver-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .driver-name {
    font-weight: 700;
    font-size: 14px;
  }

  .status-chip {
    font-size: 9.5px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
  }

  .status-chip.active {
    background: #dcfce7;
    color: #15803d;
  }

  .driver-role, .driver-unit {
    font-size: 11.5px;
    color: var(--nexa-mobile-text-secondary, #64748b);
  }

  .section-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--nexa-mobile-text-secondary, #64748b);
    margin: 6px 16px 4px;
  }

  .dispatch-card {
    margin: 0 16px 16px;
    padding: 14px;
    background: var(--nexa-mobile-surface-card, #ffffff);
    border: 1px solid var(--nexa-mobile-border, #e2e8f0);
    border-radius: var(--nexa-mobile-radius-card, 16px);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dispatch-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .order-id {
    font-family: var(--nexa-mobile-font-family-mono, monospace);
    font-weight: 800;
    color: var(--nexa-mobile-primary, #2a67d9);
    font-size: 12.5px;
  }

  .cold-chip {
    background: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    font-size: 9.5px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .buyer-brief {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .buyer-name {
    margin: 0;
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
  }

  .buyer-cargo {
    font-size: 11px;
    color: #475569;
  }

  .route-timeline {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 10px;
  }

  .timeline-step {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .step-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 4px;
    flex-shrink: 0;
  }

  .step-dot.origin { background: #2563eb; }
  .step-dot.destination { background: #16a34a; }

  .timeline-line {
    width: 2px;
    height: 16px;
    background: #cbd5e1;
    margin-left: 4px;
  }

  .step-details {
    display: flex;
    flex-direction: column;
  }

  .step-title {
    font-size: 12px;
    font-weight: 700;
    color: #0f172a;
  }

  .step-sub {
    font-size: 10.5px;
    color: var(--nexa-mobile-text-secondary, #64748b);
  }

  .btn-primary-mobile {
    min-height: 52px;
    background: var(--nexa-mobile-primary, #2a67d9);
    color: #ffffff;
    border: none;
    border-radius: var(--nexa-mobile-radius-button, 12px);
    font-weight: 700;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 2px 4px rgba(42, 103, 217, 0.2);
    transition: opacity 0.15s ease;
  }

  .btn-primary-mobile:active { opacity: 0.85; }

  .m3-bottom-nav {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: var(--nexa-mobile-surface-card, #ffffff);
    border-top: 1px solid var(--nexa-mobile-border, #e2e8f0);
    display: flex;
    align-items: center;
    justify-content: space-around;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    min-width: 48px;
    min-height: 48px;
    justify-content: center;
    font-size: 10px;
    color: var(--nexa-mobile-text-secondary, #64748b);
    cursor: pointer;
  }

  .nav-item.active {
    color: var(--nexa-mobile-primary, #2a67d9);
    font-weight: 700;
  }

  .nav-item i { font-size: 17px; }
</style>
