---
/**
 * Cuadricula8dpSection.astro
 * Canonical 8dp Spatial Grid System & Responsive Breakpoints for Android Jetpack Compose
 * Covers Margins, Gutters, Columns (4, 8, 12), WindowSizeClass & Production Kotlin Contracts
 */

interface SpacingSpec {
  token: string;
  dp: number;
  barPx: number;
  role: string;
  usage: string;
}

const spacingSpecs: SpacingSpec[] = [
  { token: 'space.micro', dp: 4, barPx: 32, role: 'Micro-alineación', usage: 'Separación entre icono y texto en chip; padding interior de badges' },
  { token: 'space.small', dp: 8, barPx: 64, role: 'Espaciado base', usage: 'Separación mínima entre botones contiguos; gap vertical en subgrupos' },
  { token: 'space.medium', dp: 12, barPx: 96, role: 'Gutter de lista', usage: 'Gutter vertical estándar entre tarjetas de despacho en LazyColumn' },
  { token: 'space.normal', dp: 16, barPx: 128, role: 'Margen de pantalla', usage: 'Márgenes laterales del Scaffold; padding interior de tarjetas de parada' },
  { token: 'space.large', dp: 24, barPx: 192, role: 'Intervalo de sección', usage: 'Separación entre bloques temáticos (ej. entre cliente y lista SKU)' },
  { token: 'space.xlarge', dp: 32, barPx: 256, role: 'Respiro inferior', usage: 'Espaciado previo a la barra fija inferior (BottomBar sticky)' },
  { token: 'space.touch-std', dp: 48, barPx: 320, role: 'Touch Target Estándar', usage: 'Piso de accesibilidad táctil para iconos y botones estándar (WCAG 2.2 AA)' },
  { token: 'space.touch-ind', dp: 56, barPx: 360, role: 'Touch Target Industrial', usage: 'Altura de botones industriales para operarios con guantes en cámara fría' }
];

const spacingCode = `// Canonical 8dp Spatial System & Adaptive Window Size Helper
package com.nexa.core.designsystem.theme

import androidx.compose.runtime.Immutable
import androidx.compose.runtime.staticCompositionLocalOf
import androidx.compose.ui.unit.Dp
import androidx.compose.ui.unit.dp
import androidx.compose.material3.windowsizeclass.WindowWidthSizeClass

@Immutable
data class NexaSpacing(
    val micro: Dp = 4.dp,
    val small: Dp = 8.dp,
    val medium: Dp = 12.dp,
    val normal: Dp = 16.dp,
    val large: Dp = 24.dp,
    val extraLarge: Dp = 32.dp,
    val touchStandard: Dp = 48.dp,
    val touchIndustrial: Dp = 56.dp
)

val LocalNexaSpacing = staticCompositionLocalOf { NexaSpacing() }

@Immutable
data class NexaAdaptiveLayoutConfig(
    val columns: Int,
    val horizontalMargin: Dp,
    val cardGutter: Dp
)

fun resolveAdaptiveConfig(widthClass: WindowWidthSizeClass): NexaAdaptiveLayoutConfig =
    when (widthClass) {
        WindowWidthSizeClass.Compact -> NexaAdaptiveLayoutConfig(
            columns = 4,
            horizontalMargin = 16.dp,
            cardGutter = 12.dp
        )
        WindowWidthSizeClass.Medium -> NexaAdaptiveLayoutConfig(
            columns = 8,
            horizontalMargin = 24.dp,
            cardGutter = 16.dp
        )
        WindowWidthSizeClass.Expanded -> NexaAdaptiveLayoutConfig(
            columns = 12,
            horizontalMargin = 32.dp,
            cardGutter = 24.dp
        )
        else -> NexaAdaptiveLayoutConfig(columns = 4, horizontalMargin = 16.dp, cardGutter = 12.dp)
    }`;
---

