---
/**
 * MonorepoNavHeader — Cross-Suite Navigation Header for Website Style (Nexafy)
 * Provides 1-click intercommunication across Web (:4200), Mobile (:4201), and Website (:4321).
 */
import NexaLogo from '../guidelines/NexaLogo.astro';

interface Props {
  currentSection?: 'workbench' | 'artifacts' | 'landing-spec';
}

const { currentSection = 'workbench' } = Astro.props;
---

<header class="nexafy-top-header">
  <div class="top-row">
    <!-- Brand Identity & Release Tag -->
    <div class="brand-group">
      <NexaLogo variant="primary" height={26} />
      <div class="brand-text">
        <span class="system-tag">WEBSITE STYLE</span>
        <span class="system-title">Nexafy Living Geometry System</span>
      </div>
    </div>

    <!-- Monorepo Triad Switcher -->
    <div class="monorepo-triad" aria-label="Style Monorepo Switcher">
      <span class="triad-label">MONOREPO:</span>
      <a href="http://localhost:4200" class="triad-pill" target="_blank" rel="noopener" title="Nexa Web Style Guidelines (Angular)">
        <i class="pi pi-desktop" aria-hidden="true"></i> Web :4200 ↗
      </a>
      <a href="http://localhost:4201" class="triad-pill" target="_blank" rel="noopener" title="Nexa Mobile Style Guidelines (Android / Flutter)">
        <i class="pi pi-mobile" aria-hidden="true"></i> Mobile :4201 ↗
      </a>
      <span class="triad-pill active" title="Currently viewing Website Style / Nexafy">
        <i class="pi pi-globe" aria-hidden="true"></i> Website :4321
      </span>
    </div>

    <!-- Utility Actions -->
    <div class="actions-group">
      <!-- Contrast Toggle -->
      <button type="button" class="btn-utility" id="btn-toggle-contrast" title="Toggle Increased Contrast Mode">
        <i class="pi pi-circle" aria-hidden="true"></i>
        <span id="contrast-label">Contraste Estándar</span>
      </button>
    </div>
  </div>

  <!-- Internal Page Navigation Bar -->
  <nav class="sub-nav-bar" aria-label="Website Style Subsections">
    <a href="/" class={`sub-nav-item ${currentSection === 'workbench' ? 'active' : ''}`}>
      <i class="pi pi-bolt" aria-hidden="true"></i>
      <span>✦ Motor Gráfico & Guidelines</span>
    </a>
    <a href="/artifacts" class={`sub-nav-item ${currentSection === 'artifacts' ? 'active' : ''}`}>
      <i class="pi pi-box" aria-hidden="true"></i>
      <span>Catálogo de Artefactos Vivos</span>
    </a>
    <a href="/landing-spec" class={`sub-nav-item ${currentSection === 'landing-spec' ? 'active' : ''}`}>
      <i class="pi pi-th-large" aria-hidden="true"></i>
      <span>Especificaciones de Landing & Bento</span>
    </a>
  </nav>
</header>

<style>
  .nexafy-top-header {
    background: #ffffff;
    border-bottom: 1px solid var(--nexa-color-border-default, #e2e8f0);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .system-tag {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10px;
    font-weight: 800;
    color: var(--nexa-color-primary-700, #1b4fb8);
    background: var(--nexa-color-primary-50, #f0f5ff);
    border: 1px solid var(--nexa-color-primary-200, #b8d4fe);
    padding: 1px 6px;
    border-radius: 999px;
    align-self: flex-start;
    letter-spacing: 0.05em;
  }

  .system-title {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 13px;
    font-weight: 700;
    color: var(--nexa-color-text-primary, #0f172a);
  }

  /* Monorepo Triad Pills */
  .monorepo-triad {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 3px 8px;
    border-radius: 8px;
  }

  .triad-label {
    font-size: 9px;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.06em;
  }

  .triad-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 5px;
    text-decoration: none;
    color: #475569;
    border: 1px solid transparent;
    transition: all 0.15s ease;

    &:hover {
      background: #ffffff;
      color: #2563eb;
      border-color: #cbd5e1;
    }

    &.active {
      background: #2a67d9;
      color: #ffffff;
      font-weight: 700;
    }
  }

  /* Utility Actions */
  .actions-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-utility {
    background: #ffffff;
    border: 1px solid var(--nexa-color-border-strong, #cbd5e1);
    color: var(--nexa-color-text-secondary, #64748b);
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.15s ease;

    &:hover {
      background: #f1f5f9;
      color: #0f172a;
    }

    &.active {
      background: #0f172a;
      color: #ffffff;
      border-color: #0f172a;
    }
  }

  /* Sub Nav Bar */
  .sub-nav-bar {
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    gap: 0.5rem;
    overflow-x: auto;
    background: #ffffff;
    border-top: 1px solid var(--nexa-color-border-default, #e2e8f0);
  }

  .sub-nav-item {
    padding: 0.65rem 1rem;
    font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--nexa-color-text-secondary, #64748b);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: all 0.15s ease;
    white-space: nowrap;

    &:hover {
      color: #0f172a;
    }

    &.active {
      color: #2a67d9;
      border-bottom-color: #2a67d9;
      font-weight: 700;
    }
  }
</style>
