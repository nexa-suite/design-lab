---
// AccessChannels: Nexa B2B Distribution Channels Bento Grid
// Dark technical slate canvas (#082846 / #05192d) with blueprint grid mesh and contrast slate cards (#0c2038 / #122b49)
---

<section class="channels-section" id="channels" data-section="market" aria-labelledby="channels-heading">
  <!-- Subtle Blueprint Grid Pattern Mesh -->
  <div class="channels-blueprint-grid" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="channels-grid-pattern" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M 48 0 L 0 0 0 48" fill="none" stroke="rgba(56, 189, 248, 0.08)" stroke-width="1"/>
          <circle cx="48" cy="0" r="1.5" fill="rgba(56, 189, 248, 0.22)"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#channels-grid-pattern)" />
    </svg>
  </div>

  <!-- Anchor for Market links -->
  <span id="market" class="market-anchor" aria-hidden="true"></span>
  
  <div class="channels-container">
    
    <!-- Centered Header on Dark Slate Canvas -->
    <div class="channels-header">
      <div class="channels-pill-eyebrow">
        <span>Canales de Distribución B2B</span>
      </div>

      <h2 id="channels-heading" class="channels-title">
        Múltiples canales para<br />
        <span class="title-light">acelerar tus despachos mayoristas</span>
      </h2>
    </div>

    <!-- Authentic Asymmetric Bento Grid (4 Columns x 3 Rows) -->
    <div class="channels-bento-grid">
      
      <!-- ====================================================================
           ROW 1: TWO MONUMENTAL CARDS (NEXA MARKETPLACE + PORTAL MAYORISTA)
           ==================================================================== -->

      <!-- 1. Top-Left: Large Dark Tech Nexa Marketplace Card (Col 1-2, Row 1) -->
      <article class="bento-tile tile-market-wide" aria-label="Nexa B2B Marketplace Channel">
        <div class="market-tile-header">
          <div class="market-brand-badge">
            <img src="/assets/nexa-nx-white.svg" alt="NX" width="34" height="34" class="market-nexa-logo" />
            <span class="market-title-text">Nexa Marketplace & Despachos</span>
          </div>
          <p class="market-lead-desc">
            Gestiona la asignación de muelle y despacha lotes perecibles en un tablero interconectado en vivo con transportistas de frío, trazabilidad FEFO y custodia escrow.
          </p>
          <div class="market-cta-wrap">
            <a href="#book-demo" class="bento-pill-btn">Explorar Tablero de Despachos</a>
          </div>
        </div>

        <!-- Nexa Real Dispatch Board UI Preview (Authentic Pattern from Nexa Web Style) -->
        <div class="market-ui-preview" aria-hidden="true">
          <!-- Browser Mockup Top Bar -->
          <div class="market-top-searchbar">
            <div class="market-browser-left">
              <span class="market-browser-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" fill="#2563eb"/>
                  <circle cx="12" cy="12" r="3" fill="#38bdf8"/>
                </svg>
              </span>
              <div class="search-input-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5">
                  <circle cx="11" cy="11" r="8"/>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <span>DSP-204 · Terminal Pesquero Callao</span>
              </div>
            </div>
            
            <div class="market-browser-tags">
              <span class="browser-tag tag-active">Tablero Despachos</span>
              <span class="browser-tag tag-cyan">4 En Tránsito</span>
              <span class="browser-tag tag-muted">Sensirion -18.2°C</span>
              <span class="browser-tag tag-muted">Escrow 100%</span>
              <span class="browser-avatar-circle"></span>
            </div>
          </div>

          <!-- Nexa Dispatch Board Kanban Columns -->
          <div class="dispatch-board-preview-grid">
            <!-- Column 1: Orders -->
            <div class="dispatch-col">
              <div class="dispatch-col-header">
                <span class="col-title">Órdenes</span>
                <span class="col-count">1</span>
              </div>
              <div class="dispatch-card-item card-selected">
                <div class="card-top-row">
                  <span class="card-id-badge">DSP-204</span>
                  <span class="status-chip chip-info">Listo revisión</span>
                </div>
                <strong class="card-buyer">La Cava Fría SAC</strong>
                <span class="card-dest">Callao ➔ Lima Norte</span>
                <div class="card-meta-row">
                  <span class="meta-item">Lote FEFO L-8841</span>
                  <span class="meta-item text-cyan">500 kg</span>
                </div>
                <div class="card-action-hint">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                  <span>Revisar documentos</span>
                </div>
              </div>
            </div>

            <!-- Column 2: Preparation -->
            <div class="dispatch-col">
              <div class="dispatch-col-header">
                <span class="col-title">En Preparación</span>
                <span class="col-count">1</span>
              </div>
              <div class="dispatch-card-item">
                <div class="card-top-row">
                  <span class="card-id-badge">DSP-198</span>
                  <span class="status-chip chip-warning">Checklist</span>
                </div>
                <strong class="card-buyer">Andino Food Service</strong>
                <span class="card-dest">Muelle Rampa 02</span>
                <div class="card-meta-row">
                  <span class="meta-item">Pallet P-102</span>
                  <span class="meta-item text-cyan">-19.0°C</span>
                </div>
                <div class="card-action-hint">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                  <span>Validar precintos</span>
                </div>
              </div>
            </div>

            <!-- Column 3: Distribution -->
            <div class="dispatch-col">
              <div class="dispatch-col-header">
                <span class="col-title">En Distribución</span>
                <span class="col-count">1</span>
              </div>
              <div class="dispatch-card-item card-active-glow">
                <div class="card-top-row">
                  <span class="card-id-badge">DSP-191</span>
                  <span class="status-chip chip-active">GPS Tránsito</span>
                </div>
                <strong class="card-buyer">Frío Norte SAC</strong>
                <span class="card-dest">Lima ➔ Chiclayo 1N</span>
                <div class="card-meta-row">
                  <span class="meta-item">Sensirion IoT OK</span>
                  <span class="meta-item text-cyan">-18.4°C</span>
                </div>
                <div class="card-action-hint">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                  <span>Telemetría en vivo</span>
                </div>
              </div>
            </div>

            <!-- Column 4: Delivered -->
            <div class="dispatch-col">
              <div class="dispatch-col-header">
                <span class="col-title">Entregado</span>
                <span class="col-count">1</span>
              </div>
              <div class="dispatch-card-item">
                <div class="card-top-row">
                  <span class="card-id-badge">DSP-183</span>
                  <span class="status-chip chip-success-blue">Conforme</span>
                </div>
                <strong class="card-buyer">Mercado Central B2B</strong>
                <span class="card-dest">Lima Sur · Rampa 01</span>
                <div class="card-meta-row">
                  <span class="meta-item">Escrow liberado</span>
                  <span class="meta-item text-cyan">GS1-128</span>
                </div>
                <div class="card-action-hint">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                  <span>Ver acta digital</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Accessible Movement Proof Strip -->
          <div class="dispatch-proof-strip">
            <div class="proof-step">
              <span class="proof-label">Origen</span>
              <span class="proof-val">Terminal Callao · Muelle 04</span>
            </div>
            <div class="proof-divider">➔</div>
            <div class="proof-step">
              <span class="proof-label">Destino</span>
              <span class="proof-val">Lima Norte · Rampa Fría</span>
            </div>
            <div class="proof-divider">➔</div>
            <div class="proof-step">
              <span class="proof-label">Telemetría Sensirion</span>
              <span class="proof-val text-cyan">-18.2°C Continuo</span>
            </div>
            <div class="proof-divider">➔</div>
            <div class="proof-step">
              <span class="proof-label">Smart Escrow</span>
              <span class="proof-val text-blue">$3,450.00 Pre-autorizado</span>
            </div>
          </div>
        </div>
      </article>

      <!-- 2. Top-Right: Dedicated Portal Card (Col 3-4, Row 1) -->
      <article class="bento-tile tile-online-store" aria-label="Dedicated B2B Portal">
        <!-- Floating Isometric Store Screens Mockup -->
        <div class="store-preview-visual" aria-hidden="true">
          <div class="store-screens-wrapper">
            <!-- Screen 1: Store Catalog View -->
            <div class="mock-screen screen-catalog">
              <div class="mock-screen-header">
                <span class="mock-store-name">Portal Mayorista</span>
                <div class="mock-screen-nav">
                  <span>Muelle</span>
                  <span>Frío</span>
                </div>
              </div>
              <div class="mock-hero-banner">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
                  <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
              </div>
              <div class="mock-screen-grid">
                <div class="mock-thumb-box"></div>
                <div class="mock-thumb-box"></div>
                <div class="mock-thumb-box"></div>
              </div>
            </div>

            <!-- Screen 2: Checkout Modal View -->
            <div class="mock-screen screen-checkout">
              <div class="checkout-header-row">
                <span class="checkout-back">&lt; Despacho</span>
                <span class="checkout-badge">Escrow 100%</span>
              </div>
              <div class="checkout-item-preview">
                <div class="checkout-item-thumb">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
                    <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                </div>
                <div class="checkout-item-meta">
                  <strong class="checkout-item-title">Lote Salmón Salar</strong>
                  <span class="checkout-item-price text-mono">$3,450.00 USD</span>
                </div>
              </div>
              <div class="checkout-action-line">
                <span class="checkout-pill-btn">Verificar Muelle</span>
              </div>
            </div>
          </div>
        </div>

        <div class="store-tile-content">
          <h3 class="store-tile-title">Portal Propio de Pedidos & Muelle</h3>
          <p class="store-tile-desc">
            Ofrece a tus clientes corporativos una interfaz dedicada para programar ventanas de carga, monitorear pallets y liberar pagos contra recepción conforme.
          </p>
          <div class="store-cta-row">
            <a href="#book-demo" class="bento-pill-btn">Comenzar Ahora</a>
          </div>
        </div>
      </article>

      <!-- ====================================================================
           ROW 2 & 3: ASYMMETRIC BENTO SATELLITES (SALES, SAFE, BOOKING, EASY, SEO)
           ==================================================================== -->

      <!-- 3A. Sales $210k Chart Card (Col 1, Row 2) -->
      <article class="bento-tile tile-mini tile-chart" aria-label="Despachos Mensuales">
        <div class="chart-content-box">
          <span class="chart-label">Despachos B2B</span>
          <strong class="chart-value text-mono">$210k</strong>
        </div>
        <svg viewBox="0 0 160 90" class="wave-chart-svg" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="blueWaveGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.45"/>
              <stop offset="100%" stop-color="#2563eb" stop-opacity="0.05"/>
            </linearGradient>
          </defs>
          <path d="M 0,75 C 25,72 45,55 70,60 C 95,65 110,35 130,42 C 145,48 150,15 160,10 L 160,90 L 0,90 Z" fill="url(#blueWaveGrad)"/>
          <path d="M 0,75 C 25,72 45,55 70,60 C 95,65 110,35 130,42 C 145,48 150,15 160,10" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round"/>
        </svg>
      </article>

      <!-- 4. Blue "Safe" Escrow Shield Card (Col 2, Row 2) -->
      <article class="bento-tile tile-mini tile-safe" aria-label="Custodia Escrow Garantizada">
        <div class="safe-badge-container">
          <svg width="68" height="68" viewBox="0 0 24 24" fill="none" class="shield-bg-svg" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="#2563eb"/>
          </svg>
          <span class="safe-text-overlay">Escrow</span>
        </div>
      </article>

      <!-- 5. Center-Tall: Deep Tech Booking Flow Card (Col 3, Row 2-3) -->
      <article class="bento-tile tile-tall-booking" aria-label="Gestión Integral de Muelle y Despachos">
        <div class="booking-tile-inner">
          <h3 class="booking-tile-title">
            Control integral de muelle, precintos y liquidación
          </h3>
          <p class="booking-tile-body">
            Todas las órdenes del Marketplace se gestionan en Nexa OS: asignación de bahías frigoríficas, telemetría Sensirion en tránsito y liberación escrow automática al validar en destino.
          </p>
        </div>
      </article>

      <!-- 6A. Emerald/Cyan "Easy" Snapping Fingers Card (Col 4, Row 2) -->
      <article class="bento-tile tile-mini tile-sparkle" aria-label="Operación Fluida">
        <div class="easy-content-row">
          <strong class="easy-text-label">Ágil</strong>
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.8" class="sparkle-hand-svg" aria-hidden="true">
            <path d="M12 6V3M12 3L10 5M12 3l2 2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18 10l2-1M18 14l2 1" stroke-linecap="round"/>
            <path d="M6 10l-2-1M6 14l-2 1" stroke-linecap="round"/>
            <path d="M14 9a2 2 0 0 1 2 2v4a3 3 0 0 1-3 3h-2a4 4 0 0 1-4-4v-3a2 2 0 1 1 4 0v1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </article>

      <!-- 3B. Tech Slate Boost Leads Card (Col 1-2, Row 3) -->
      <article class="bento-tile tile-boost-leads" aria-label="Mayor Rotación FEFO">
        <h3 class="sand-tile-title">Mayor Rotación FEFO</h3>
        <p class="sand-tile-desc">
          Reduce mermas y acelera la rotación de lotes con fechas de vencimiento críticas conectando de forma directa con cadenas de supermercados e industrias.
        </p>
      </article>

      <!-- 6B. Tech Slate GS1 Pages Card (Col 4, Row 3) -->
      <article class="bento-tile tile-seo-pages" aria-label="Trazabilidad GS1 Homologada">
        <h3 class="sand-tile-title">Trazabilidad GS1</h3>
        <p class="sand-tile-desc">
          Catálogos homologados bajo estándares GS1-128 con fichas técnicas y certificados sanitarios descargables para auditorías inmediatas.
        </p>
      </article>

    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     DARK TECHNICAL SLATE CANVAS (#082846 / #05192d)
     ========================================================================== */
  .channels-section {
    background: radial-gradient(circle at 50% 20%, #0c2038 0%, #082846 45%, #05192d 100%);
    color: #ffffff;
    padding: 6.5rem 2rem 7.5rem;
    position: relative;
    overflow: hidden;
    scroll-margin-top: 70px;
  }

  .channels-blueprint-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.6;
    z-index: 1;
  }

  .market-anchor {
    position: absolute;
    top: -80px;
    left: 0;
    visibility: hidden;
  }

  .channels-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    position: relative;
    z-index: 2;
  }

  /* Header */
  .channels-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .channels-pill-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 1.35rem;
    border: 1.5px solid rgba(56, 189, 248, 0.4);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .channels-title {
    font-family: var(--primitive-font-display);
    font-size: clamp(2.35rem, 4.5vw, 4rem);
    font-weight: 800;
    line-height: 1.08;
    color: #ffffff;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .title-light {
    font-weight: 400;
    color: #93c5fd;
  }

  /* Shared Bento Pill Button (Tech Electric Blue Pill) */
  .bento-pill-btn {
    background-color: #2563eb;
    color: #ffffff;
    font-family: var(--primitive-font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 0.65rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .bento-pill-btn:hover {
    background-color: #1d4ed8;
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.6);
    transform: translateY(-1px);
  }

  /* ==========================================================================
     AUTHENTIC 4-COLUMN BENTO GRID COMPOSITION
     ========================================================================== */
  .channels-bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto auto;
    gap: 1.5rem;
  }

  .bento-tile {
    border-radius: 32px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    border: 1px solid rgba(56, 189, 248, 0.16);
  }

  .bento-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
  }

  /* --------------------------------------------------------------------------
     1. Large Slate Nexa Market Card (Col 1-2, Row 1)
     -------------------------------------------------------------------------- */
  .tile-market-wide {
    grid-column: 1 / 3;
    grid-row: 1;
    background: #0c2038;
    padding: 2.5rem 2.5rem 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .market-tile-header {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .market-brand-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .market-nexa-logo {
    flex-shrink: 0;
  }

  .market-title-text {
    font-family: var(--primitive-font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.025em;
  }

  .market-lead-desc {
    font-size: 1.0625rem;
    line-height: 1.45;
    color: #cbd5e1;
    margin: 0;
    max-width: 48ch;
    font-weight: 400;
  }

  .market-cta-wrap {
    margin-top: 0.5rem;
  }

  /* Market Catalog Web Window Preview */
  .market-ui-preview {
    background: #ffffff;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    padding: 1.15rem 1.35rem 1.35rem;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .market-top-searchbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.75rem;
  }

  .market-browser-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .search-input-pill {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #0f172a;
  }

  .market-browser-tags {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .browser-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
  }

  .tag-muted {
    color: #64748b;
    font-size: 0.6875rem;
  }

  .browser-avatar-circle {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #2563eb;
  }

  /* Dispatch Board Preview (Real Pattern from Nexa Web Style) */
  .dispatch-board-preview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.65rem;
  }

  @media (max-width: 900px) {
    .dispatch-board-preview-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .dispatch-col {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dispatch-col-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #0f172a;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .col-count {
    background: #eff6ff;
    color: #1d4ed8;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 700;
  }

  .dispatch-card-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 9px;
    padding: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .dispatch-card-item.card-selected {
    border-color: #2563eb;
