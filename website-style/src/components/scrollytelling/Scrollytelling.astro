---
// Scrollytelling Component — Reconstructed to 100% forensic fidelity
// Bases: Image 3 (media_1790488366954.png) & Awwwards SOTD Forensic Sequence
// Features: Dual [Bookings]/[Inventory] switcher, 26px thick vascular conduits,
// 4-step interactive smartphone checkout flow (Date Selection -> Face ID & Escrow -> Summary & Pay -> Payment Done with Confetti),
// and smooth, glitch-free scroll choreography.
---

<section class="scrolly-section" id="scrollytelling" aria-label="Flecto Link and Customer Scrollytelling Experience">
  <!-- Outer Sticky Pin Frame -->
  <div class="scrolly-sticky-frame">
    
    <!-- Top Category Tabs (State 1: Bookings / Inventory) -->
    <div class="scrolly-nav-tabs" role="tablist" aria-label="Configuration Categories">
      <div class="tabs-buttons-row">
        <button type="button" role="tab" class="scrolly-tab-btn active" id="tab-bookings" aria-selected="true">
          <span>Bookings</span>
        </button>
        <button type="button" role="tab" class="scrolly-tab-btn" id="tab-inventory" aria-selected="false">
          <span>Inventory</span>
        </button>
      </div>
      <div class="tabs-underline-track" aria-hidden="true">
        <div class="track-active-bar"></div>
      </div>
    </div>

    <!-- The Scrolly Stage Area -->
    <div class="scrolly-stage-area">

      <!-- ====================================================================
           BACKDROP PLATE (Pastel Mint Container matching Image 3)
           ==================================================================== -->
      <div class="stage-backdrop-state1" aria-hidden="true"></div>

      <!-- ====================================================================
           SATELLITE TOGGLE CARDS (STATE 1: Merchant View)
           Connected via THICK 26px PASTEL CONDUITS
           ==================================================================== -->
      <!-- 1. Top-Left Satellite: Online Payments -->
      <div class="satellite-card card-top-left bookings-satellite" id="satellite-online-payments">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="24" height="18" viewBox="0 0 28 20" fill="none" stroke="#004737" stroke-width="2">
              <rect x="2" y="3" width="24" height="15" rx="3"/>
              <line x1="2" y1="7" x2="26" y2="7" stroke-width="1.8"/>
              <text x="14" y="15" font-size="7" font-family="sans-serif" font-weight="800" fill="#004737" stroke="none" text-anchor="middle">€</text>
            </svg>
          </div>
          <h3 class="satellite-title">Online Payments</h3>
          <p class="satellite-desc">Toggle this to allow paying online</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Online Payments toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 2. Bottom-Left Satellite: Pay in Store -->
      <div class="satellite-card card-bottom-left bookings-satellite" id="satellite-pay-store">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3 class="satellite-title">Pay in Store</h3>
          <p class="satellite-desc">You can allow in-person payment at your store</p>
          <div class="satellite-switch-pill active" role="switch" aria-checked="true" aria-label="Pay in Store toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 3. Right Satellite: ID Verification -->
      <div class="satellite-card card-right bookings-satellite" id="satellite-id-verify">
        <div class="satellite-stem stem-right" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <path d="M4 8V5a2 2 0 0 1 2-2h3M18 3h3a2 2 0 0 1 2 2v3M4 16v3a2 2 0 0 0 2 2h3M18 21h3a2 2 0 0 0 2-2v-3"/>
              <circle cx="12" cy="11" r="3"/>
              <path d="M8.5 17a4.5 4.5 0 0 1 7 0"/>
            </svg>
          </div>
          <h3 class="satellite-title">ID Verification</h3>
          <p class="satellite-desc">To add extra safety to the payment flow</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="ID Verification toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- INVENTORY SATELLITE CARDS (Active when Inventory Tab is clicked) -->
      <!-- 1. Top-Left: Add Services -->
      <div class="satellite-card card-top-left inventory-satellite" id="satellite-add-services" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="satellite-title">Add Services</h3>
          <p class="satellite-desc">Add services like Delivery, Insurance, and more</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Add Services toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 2. Bottom-Left: Add Deposits -->
      <div class="satellite-card card-bottom-left inventory-satellite" id="satellite-add-deposits" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <rect x="2" y="5" width="20" height="14" rx="2"/>
              <line x1="2" y1="10" x2="22" y2="10"/>
            </svg>
          </div>
          <h3 class="satellite-title">Add Deposits</h3>
          <p class="satellite-desc">Protect your products by asking for a deposit</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Add Deposits toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 3. Top-Right: Add Items -->
      <div class="satellite-card card-right inventory-satellite" id="satellite-add-items" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-right" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <h3 class="satellite-title">Add Items</h3>
          <p class="satellite-desc">Add multiple items and quantities per booking</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Add Items toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 4. Bottom-Right: Discounts -->
      <div class="satellite-card card-bottom-right inventory-satellite" id="satellite-discounts" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-right" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <circle cx="7.5" cy="7.5" r="2.5"/>
              <circle cx="16.5" cy="16.5" r="2.5"/>
              <line x1="19" y1="5" x2="5" y2="19"/>
            </svg>
          </div>
          <h3 class="satellite-title">Discounts</h3>
          <p class="satellite-desc">Include a little incentive by adding discounts</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Discounts toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- ====================================================================
           CUSTOMER JOURNEY ELEMENTS (STATE 2: Customer Flow)
           ==================================================================== -->
      <!-- Top Vertical Connector Line & John Cooper Avatar -->
      <div class="customer-avatar-stem-block" aria-hidden="true">
        <div class="top-vertical-stem"></div>
        <div class="customer-avatar-circle">
          <img src="/assets/synthetic/avatar-customer.svg" alt="John Cooper" class="avatar-svg-portrait" />
        </div>
        <div class="customer-badge-pill">John Cooper</div>
      </div>

      <!-- Left Wing: Monumental Headline & Badge -->
      <div class="customer-left-wing">
        <div class="customer-eyebrow-pill">For your Customer</div>
        <h2 class="customer-monumental-heading">
          And it's just<br />
          as simple for<br />
          your<br />
          customers
        </h2>
      </div>

      <!-- Right Wing: Vertical Dashed Timeline (Clickable steps) -->
      <div class="customer-right-wing" aria-label="Customer Journey Progress">
        <div class="timeline-vertical-dashed" aria-hidden="true"></div>
        <ul class="timeline-steps-list">
          <li class="timeline-item active" data-step="1" role="button" tabindex="0" aria-label="Go to step 1: Date selection & order">
            <span class="item-dot"></span>
            <span class="item-text">Date selection & order</span>
          </li>
          <li class="timeline-item" data-step="2" role="button" tabindex="0" aria-label="Go to step 2: Run face verification">
            <span class="item-dot"></span>
            <span class="item-text">Run face verification</span>
          </li>
          <li class="timeline-item" data-step="3" role="button" tabindex="0" aria-label="Go to step 3: Summary & pay">
            <span class="item-dot"></span>
            <span class="item-text">Summary & pay</span>
          </li>
          <li class="timeline-item" data-step="4" role="button" tabindex="0" aria-label="Go to step 4: Success">
            <span class="item-dot"></span>
            <span class="item-text">Success! 🍾</span>
          </li>
        </ul>
      </div>

      <!-- ====================================================================
           THE DOMINANT CENTERPIECE: ELONGATED SMARTPHONE MOCKUP
           ==================================================================== -->
      <div class="scrolly-phone-container" id="interactive-phone">
        <div class="phone-chassis">
          
          <!-- Top Speaker / Camera Slot -->
          <div class="phone-speaker-slot" aria-hidden="true">
            <div class="chassis-camera"></div>
            <div class="chassis-speaker"></div>
          </div>

          <!-- Phone Screen Frame with Absolute Stacking Context -->
          <div class="phone-screen" role="region" aria-live="polite" aria-label="Customer Rental Mobile Flow">
            
            <!-- Global Status Bar -->
            <div class="screen-status-bar" aria-hidden="true">
              <span class="status-time">9:41</span>
              <div class="status-indicators">
                <svg width="13" height="9" viewBox="0 0 14 10" fill="currentColor">
                  <path d="M1 7h2v3H1zM4 5h2v5H4zM7 3h2v7H7zM10 1h2v9h-2z"/>
                </svg>
                <svg width="12" height="9" viewBox="0 0 16 12" fill="currentColor">
                  <path d="M8 2.5a9.8 9.8 0 0 1 6.5 2.5l-6.5 7-6.5-7A9.8 9.8 0 0 1 8 2.5z"/>
                </svg>
                <div class="status-battery">
                  <div class="battery-fill"></div>
                </div>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 1: Date Selection & Order Summary (Step 1)
                 ------------------------------------------------------------- -->
            <div class="phone-state-view active" id="phone-state-1" data-state="1">
              <div class="summary-top-nav">
                <button type="button" class="phone-circle-btn" aria-label="Back">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="summary-top-title">Select Dates & Order</span>
                <button type="button" class="phone-circle-btn" aria-label="Help">?</button>
              </div>

              <!-- Nexafy Emblem Badge -->
              <div class="flecto-emblem-badge" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 48 48" fill="none">
                  <rect width="48" height="48" rx="14" fill="#57f09e"/>
                  <rect x="14" y="15" width="9" height="7" rx="3.5" fill="#004737"/>
                  <rect x="25" y="15" width="13" height="7" rx="3.5" fill="#004737"/>
                  <rect x="10" y="26" width="13" height="7" rx="3.5" fill="#004737"/>
                  <rect x="25" y="26" width="9" height="7" rx="3.5" fill="#004737"/>
                </svg>
              </div>

              <div class="summary-meta-block">
                <h4 class="summary-booking-name">Nexafy Booking</h4>
                <span class="summary-booking-date">On Mar 19, 2022</span>
              </div>

              <!-- Monumental Price (Dynamic) -->
              <div class="summary-amount-display" id="step1-display-amount">€690.00</div>

              <!-- Interactive Date Picker Simulator Chip -->
              <div class="step1-date-selector">
                <div class="date-chips-label">Rental Duration</div>
                <div class="date-chips-row">
                  <button type="button" class="duration-chip" data-days="3">3 Days</button>
                  <button type="button" class="duration-chip active" data-days="5">5 Days</button>
                  <button type="button" class="duration-chip" data-days="7">7 Days</button>
                </div>
                <div class="dates-range-text">2022/03/20 &rarr; <span id="step1-end-date">2022/03/24</span></div>
              </div>

              <!-- Bottom Sheet Card: Proceed to Face ID -->
              <div class="summary-bottom-card" id="trigger-step-2" tabindex="0" role="button" aria-label="Proceed to Face ID">
                <div class="bottom-card-header">
                  <span class="bottom-card-title">Verified Gear</span>
                  <span class="bottom-card-tag">Escrow Ready</span>
                </div>
                
                <div class="store-row">
                  <div class="store-schematic-thumb" aria-hidden="true">
                    <img src="/assets/synthetic/camera-vector.svg" alt="GoPro HERO10" />
                  </div>
                  <div class="store-details">
                    <strong class="store-name">GoPro HERO10 Black</strong>
                    <p class="store-address">Colorfoto Porto · In stock</p>
                  </div>
                </div>

                <div class="bottom-card-button" id="btn-to-step-2">
                  <span>Continue to Face ID</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                </div>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN INVENTORY: Inventory Items Table
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-inventory" data-state="inventory">
              <div class="summary-top-nav">
                <button type="button" class="phone-circle-btn" id="inv-back-btn" aria-label="Back to Bookings">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="summary-top-title">Your Booking</span>
                <button type="button" class="phone-circle-btn" aria-label="Help">?</button>
              </div>

              <!-- Date Range Display -->
              <div class="inv-date-range-wrap">
                <div class="inv-date-chips">
                  <span>2022/03/20</span>
                  <div class="inv-arrow-circle">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                  </div>
                  <span>2022/03/24</span>
                </div>
                <div class="inv-rental-sub">5-day rental</div>
              </div>

              <!-- Cream Bottom Sheet -->
              <div class="inv-cream-bottom-sheet">
                <!-- Table Header -->
                <div class="inv-table-header">
                  <span class="inv-th-items">Items</span>
                  <div class="inv-th-right">
                    <span>Price</span>
                    <span>Deposit</span>
                  </div>
                </div>

                <!-- Main Rental Item -->
                <div class="inv-table-row">
                  <div class="inv-item-info">
                    <div class="inv-item-thumb">
                      <img src="/assets/synthetic/camera-vector.svg" width="24" height="24" alt="GoPro HERO10" />
                    </div>
                    <div>
                      <strong class="inv-item-name">GoPro HERO10</strong>
                      <span class="inv-item-qty">x1</span>
                    </div>
                  </div>
                  <div class="inv-item-prices">
                    <div>
                      <strong class="inv-item-rate">€100.00</strong>
                      <span class="inv-item-unit">/day</span>
                    </div>
                    <div>
                      <strong class="inv-item-rate">€200</strong>
                      <span class="inv-item-unit">/booking</span>
                    </div>
                  </div>
                </div>

                <!-- Additional Services (Dynamically toggled) -->
                <div id="inv-additional-services-row" style="display: none;">
                  <span class="inv-services-subhead">Additional Services</span>
                  <div class="inv-service-line">
                    <div class="inv-service-icon-wrap">
                      <div class="inv-service-circle">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                          <rect x="1" y="3" width="15" height="13"/>
                          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                          <circle cx="5.5" cy="18.5" r="2.5"/>
                          <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                      </div>
                      <span class="inv-service-title">Delivery (Pick-up & Return)</span>
                    </div>
                    <strong class="inv-service-fee">€20.00</strong>
                  </div>
                </div>

                <!-- Totals -->
                <div class="inv-totals-box">
                  <div class="inv-total-line">
                    <span>Rental</span>
                    <span id="inv-rental-subtotal" class="text-mono">€500.00</span>
                  </div>
                  <div class="inv-total-line grand-total">
                    <span>Total</span>
                    <span id="inv-total-amount" class="text-mono">€500.00</span>
                  </div>

                  <button type="button" class="phone-submit-btn" id="inv-proceed-btn">
                    Proceed To Face ID &rarr;
                  </button>
                </div>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 2: Biometric & Escrow Verification (Step 2)
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-2" data-state="2">
              <div class="state-subnav">
                <button type="button" class="phone-back-btn" data-target="1" aria-label="Back to date selection">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="subnav-title">ID & Escrow Verification</span>
                <span class="secure-tag">Secure</span>
              </div>

              <div class="face-scan-wrapper">
                <div class="scan-laser-box" aria-hidden="true">
                  <div class="corner-bracket top-l"></div>
                  <div class="corner-bracket top-r"></div>
                  <div class="corner-bracket bot-l"></div>
                  <div class="corner-bracket bot-r"></div>
                  <div class="scan-line"></div>
                  <svg class="face-vector" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="rgba(87, 240, 158, 0.5)" stroke-width="1.6">
                    <circle cx="12" cy="8" r="5"/>
                    <path d="M20 21a8 8 0 1 0-16 0"/>
                  </svg>
                </div>

                <div class="scan-copy">
                  <h4>Biometric Verification</h4>
                  <p>Quick 3D scan matching John Cooper's driver license.</p>
                </div>

                <!-- Escrow Guarantee Badge -->
                <div class="escrow-screen-badge">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#57f09e" stroke-width="2.2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                  <span>100% Escrow Guarantee Active (€200 hold)</span>
                </div>

                <button type="button" class="phone-submit-btn" id="confirm-face-scan">
                  <span>Confirm & Continue</span>
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polyline points="2 7 5.5 10.5 12 3"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 3: Payment Breakdown & Checkout (Step 3)
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-3" data-state="3">
              <div class="state-subnav">
                <button type="button" class="phone-back-btn" data-target="2" aria-label="Back to face ID">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="subnav-title">Checkout Summary</span>
                <span class="booking-hash text-mono">#FL-88219</span>
              </div>

              <div class="checkout-scroll-body">
                <div class="checkout-item-card">
                  <div class="item-schematic-icon" aria-hidden="true">
                    <img src="/assets/synthetic/camera-vector.svg" alt="GoPro HERO10" />
                  </div>
                  <div class="item-info">
                    <strong>GoPro HERO10 Black</strong>
                    <span>€100.00 / day × 5 days</span>
                  </div>
                  <span class="item-val">€500.00</span>
                </div>

                <div class="checkout-lines">
                  <div class="c-line">
                    <span>Security Deposit (escrow)</span>
                    <span class="text-mono">€200.00</span>
                  </div>
                  <div class="c-line">
                    <span>All-Risk Insurance</span>
                    <span class="text-mono">€20.00</span>
                  </div>
                  <div class="c-line discount">
                    <span>Duration Discount</span>
                    <span class="text-mono">-€30.00</span>
                  </div>
                  <div class="c-line total">
                    <strong>Total Due</strong>
                    <strong class="total-price text-mono">€690.00</strong>
                  </div>
                </div>

                <div class="checkout-pickup-card">
                  <div class="store-row" style="margin-bottom: 0;">
                    <div class="store-schematic-thumb" style="width: 28px; height: 28px;" aria-hidden="true">
                      <img src="/assets/synthetic/store-schematic.svg" alt="Colorfoto Porto" style="width: 20px; height: 20px;" />
                    </div>
                    <div class="store-details">
                      <strong class="store-name" style="font-size: 0.75rem;">Colorfoto Porto</strong>
                      <p class="store-address" style="font-size: 0.625rem;">R. de Sá da Bandeira 526</p>
                    </div>
                  </div>
                </div>

                <button type="button" class="phone-submit-btn primary" id="execute-payment-btn">
                  <span>Pay €690.00 & Escrow</span>
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M2.5 7H11.5M11.5 7L7 2.5M11.5 7L7 11.5"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 4: Payment Done with Confetti Celebration (Step 4)
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-4" data-state="4">
              <div class="phone-confetti-container" aria-hidden="true"></div>
              <div class="done-content-wrap">
                <!-- Crisp Mint Checkmark Badge -->
                <div class="done-badge-box" aria-hidden="true">
                  <svg width="48" height="48" viewBox="0 0 44 44" fill="none">
