    display: grid;
    grid-template-columns: 170px minmax(140px, 380px) 1fr;
    gap: 16px;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px solid #f8fafc;

    &:last-child {
      border-bottom: none;
    }
  }

  @media (max-width: 900px) {
    .spacing-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  .spacing-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;

    code {
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 11px;
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-weight: 700;
    }

    .dp-tag {
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 10px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      background: #f1f5f9;
      color: #475569;
    }
  }

  .spacing-bar-container {
    display: flex;
    align-items: center;
  }

  .spacing-bar {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 8px;
    height: 26px;
    border-left: 4px solid var(--nexa-color-primary-600, #2a67d9);
    border-radius: 0 6px 6px 0;
    background: var(--nexa-color-primary-50, #eff6ff);
    color: var(--nexa-color-primary-800, #1e40af);
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10.5px;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgba(42, 103, 217, 0.08);
  }

  .spacing-desc {
    display: flex;
    flex-direction: column;
    gap: 1px;

    strong {
      font-size: 11.5px;
      color: #0f172a;
    }

    small {
      font-size: 11px;
      color: #64748b;
      line-height: 1.35;
    }
