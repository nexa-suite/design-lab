---
/**
 * QuickCheckoutModal Component
 * Interactive quick checkout modal from the online store and customer scrollytelling flow.
 * Features product preview, itemized quotation, payment selector, and escrow authorization.
 * 
 * Strict WCAG AAA Contrast on clean surface.
 */
interface Props {
  isIsolated?: boolean;
}

const { isIsolated = false } = Astro.props;
---

<div class={`quick-checkout-card ${isIsolated ? 'is-isolated' : ''}`} role="dialog" aria-label="Modal de Check-out Rápido">
  <div class="checkout-header-row">
    <div class="checkout-title-wrap">
      <span class="back-chevron" aria-hidden="true">&lt;</span>
      <strong class="checkout-header-title">Resumen de Reserva</strong>
    </div>
    <span class="checkout-active-badge">EN LÍNEA · SEGURO</span>
  </div>

  <div class="checkout-body">
    <!-- Product Row -->
    <div class="checkout-product-row">
      <div class="product-thumb-box">
        <img src="/assets/synthetic/camera-vector.svg" alt="GoPro HERO10 Black" width="36" height="30" />
      </div>
      <div class="product-meta-col">
        <strong class="product-name">GoPro HERO10 Black</strong>
        <span class="product-rate text-mono">€100.00 / día · 5 días</span>
      </div>
      <span class="product-total-val text-mono">€500.00</span>
    </div>

    <!-- Itemized Ledger -->
    <div class="checkout-breakdown">
      <div class="breakdown-row">
        <span>Subtotal Período (5d)</span>
        <span class="text-mono">€500.00</span>
      </div>
      <div class="breakdown-row">
        <span>Depósito Escrow (Pre-auth)</span>
        <span class="text-mono">€200.00</span>
      </div>
      <div class="breakdown-row">
        <span>Entrega & Devolución</span>
        <span class="text-mono">€20.00</span>
      </div>
      <div class="breakdown-row discount">
        <span>Descuento Multidía (10%)</span>
        <span class="text-mono">-€50.00</span>
      </div>
      <div class="breakdown-total-row">
        <strong>Total a Pagar / Retener</strong>
        <strong class="total-highlight text-mono" id="modal-total-display">€670.00</strong>
      </div>
    </div>

    <!-- Payment Method Pills -->
    <div class="checkout-payment-methods">
      <span class="method-label">Método de Pago:</span>
      <div class="methods-pills-row" role="radiogroup" aria-label="Seleccionar método de pago">
        <button type="button" class="pay-method-pill active" data-method="applepay" aria-checked="true" role="radio">
          <span> Pay</span>
        </button>
        <button type="button" class="pay-method-pill" data-method="card" aria-checked="false" role="radio">
          <span>Tarjeta</span>
        </button>
        <button type="button" class="pay-method-pill" data-method="mbway" aria-checked="false" role="radio">
          <span>MB WAY</span>
        </button>
      </div>
    </div>

    <!-- CTA Button -->
    <button type="button" class="btn-checkout-submit" id="btn-submit-quick-checkout">
      <i class="pi pi-lock"></i>
      <span id="checkout-btn-text">Confirmar y Autorizar Escrow</span>
    </button>
  </div>
</div>

<script>
  const payPills = document.querySelectorAll('.pay-method-pill');
  payPills.forEach(pill => {
    pill.addEventListener('click', () => {
      payPills.forEach(p => {
        p.classList.remove('active');
        p.setAttribute('aria-checked', 'false');
      });
      pill.classList.add('active');
      pill.setAttribute('aria-checked', 'true');
    });
  });

  const submitBtn = document.getElementById('btn-submit-quick-checkout');
  const submitText = document.getElementById('checkout-btn-text');

  if (submitBtn && submitText) {
    submitBtn.addEventListener('click', () => {
      submitBtn.style.background = '#2563eb';
      submitBtn.style.color = '#ffffff';
      submitText.textContent = '¡Pago y Escrow Autorizados! 🍾';
      setTimeout(() => {
        submitBtn.style.background = '#082846';
        submitBtn.style.color = '#38c8ff';
        submitText.textContent = 'Confirmar y Autorizar Escrow';
      }, 2500);
    });
  }
</script>

<style>
  .quick-checkout-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 8px 24px rgba(8, 40, 70, 0.08);
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    box-sizing: border-box;
    color: #0f172a;
  }

  .quick-checkout-card.is-isolated {
    width: 100%;
    max-width: 100%;
  }

  .checkout-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 0.85rem;
    margin-bottom: 1rem;
  }

  .checkout-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .back-chevron {
    font-size: 14px;
    font-weight: 700;
    color: #64748b;
  }

  .checkout-header-title {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 13.5px;
    font-weight: 800;
    color: #0f172a;
  }

  .checkout-active-badge {
    background: #e0f2fe;
    color: #0369a1;
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 9.5px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .checkout-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .checkout-product-row {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 8px 10px;
  }

  .product-thumb-box {
    width: 42px;
    height: 36px;
    border-radius: 6px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e2e8f0;
    flex-shrink: 0;
  }

  .product-meta-col {
    flex: 1;
    min-width: 0;
  }

  .product-name {
    font-size: 12.5px;
    font-weight: 700;
    color: #0f172a;
    display: block;
    line-height: 1.2;
  }

  .product-rate {
    font-size: 10.5px;
    color: #64748b;
  }

  .product-total-val {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
  }

  .checkout-breakdown {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
    padding: 0.65rem 0;
    font-size: 11.5px;
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    color: #475569;
  }

  .breakdown-row.discount {
    color: #2563eb;
    font-weight: 600;
  }

  .breakdown-total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12.5px;
    margin-top: 4px;
    padding-top: 6px;
    border-top: 1px dashed #e2e8f0;
    color: #0f172a;
  }

  .total-highlight {
    font-size: 15px;
    font-weight: 800;
    color: #0369a1;
  }

  .checkout-payment-methods {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .method-label {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
  }

  .methods-pills-row {
    display: flex;
    gap: 6px;
  }

  .pay-method-pill {
    flex: 1;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 6px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pay-method-pill:hover {
    background: #e2e8f0;
  }

  .pay-method-pill.active {
    background: #082846;
    color: #38c8ff;
    border-color: #082846;
  }

  .btn-checkout-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #082846;
    color: #38c8ff;
    border: none;
    border-radius: 10px;
    padding: 10px 16px;
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s ease;
    margin-top: 4px;
    box-shadow: 0 4px 12px rgba(8, 40, 70, 0.15);
  }

  .btn-checkout-submit:hover {
    background: #0e3a63;
    color: #ffffff;
    transform: translateY(-1px);
  }
</style>
