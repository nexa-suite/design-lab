  <footer class="mobile-footer">
    <div>
      <strong>Nexa Mobile Style Guidelines</strong> · Android Jetpack Compose (Operations) & Flutter (Buyer) specifications.
    </div>
    <div>
      Puerto Docker: <code>:4201</code> · Gateway Hub: <code>:8090/mobile/</code>
    </div>
  </footer>

  <script>
    // Theme Switcher for mobile-style
    const btnTheme = document.getElementById('btn-theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    const themeLabel = document.getElementById('theme-label');
    let isDark = false;

    btnTheme?.addEventListener('click', () => {
      isDark = !isDark;
      document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
      if (themeLabel) themeLabel.textContent = isDark ? 'Modo Claro' : 'Modo Oscuro';
      if (themeIcon) {
        themeIcon.classList.toggle('pi-moon', !isDark);
        themeIcon.classList.toggle('pi-sun', isDark);
      }
    });

    // Smooth navigation tab link active sync on scroll
    const navTabLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-tab]');
    navTabLinks.forEach(link => {
      link.addEventListener('click', () => {
        const tab = link.getAttribute('data-nav-tab');
        if (tab) {
          navTabLinks.forEach(l => l.classList.remove('active'));
          link.classList.add('active');
        }
      });
    });
  </script>
</body>
