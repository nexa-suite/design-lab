---
/**
 * TipografiaSpSection.astro
 * Canonical Typography in Scale-Independent Pixels (sp) for Android Jetpack Compose
 * Full Material Design 3 15-Role Scale, Non-linear Font Scaling & Production Kotlin 2.4 Contracts
 */
---

<div class="tipografia-sp-container" data-platform-target="universal">
  <!-- Section 1: Fundamentos de Tipografía en sp y Escala Completa -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">01</span>
        <div>
          <p class="cuadro-kicker">MATERIAL DESIGN 3 · ESCALA TIPOGRÁFICA CANÓNICA</p>
          <h3 class="cuadro-title">Escala Tipográfica Completa de 15 Roles en Unidades sp</h3>
          <p class="cuadro-subtitle">
            Toda la tipografía de <strong>Nexa Mobile</strong> se define estrictamente en <code>sp</code> (Scale-independent Pixels). Cumple con el estándar de escalado dinámico no lineal de Android 14+ (hasta <strong>200% de ampliación</strong> para usuarios con baja visión) sin provocar overflow ni truncamientos accidentales de órdenes de despacho.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag primary"><i class="pi pi-align-left"></i> 15 Roles M3</span>
        <span class="cuadro-tag kotlin"><i class="pi pi-android"></i> Android 14+ 200% Font Scale</span>
        <span class="cuadro-tag success"><i class="pi pi-check"></i> Zero Truncation Gate</span>
      </div>
    </div>

    <!-- CUADRO ARQUITECTÓNICO: Matriz Completa de 15 Roles Tipográficos -->
    <div class="contract-table-wrapper">
      <table class="contract-table">
        <thead>
          <tr>
            <th>Rol M3</th>
            <th>Tamaño (sp)</th>
            <th>Line Height (sp)</th>
            <th>Tracking</th>
            <th>Peso / Familia</th>
            <th>Caso de Uso Canónico en Nexa</th>
          </tr>
        </thead>
        <tbody>
          <!-- Display -->
          <tr>
            <td><code>displayLarge</code></td>
            <td><span class="mono-chip">57sp</span></td>
            <td>64sp</td>
            <td>-0.25sp</td>
            <td>800 (Extrabold) · Jakarta Sans</td>
            <td>Métricas gigantes de peso total de carga en muelle (ej. 24.5 TN)</td>
          </tr>
          <tr>
            <td><code>displayMedium</code></td>
            <td><span class="mono-chip">45sp</span></td>
            <td>52sp</td>
            <td>0sp</td>
            <td>700 (Bold) · Jakarta Sans</td>
            <td>Contador numérico de paradas restantes en ruta de chofer</td>
          </tr>
          <tr>
            <td><code>displaySmall</code></td>
            <td><span class="mono-chip">36sp</span></td>
            <td>44sp</td>
            <td>0sp</td>
            <td>700 (Bold) · Jakarta Sans</td>
            <td>Monto valorizado total en ruta activa (ej. $14,850.00 USD)</td>
          </tr>

          <!-- Headline -->
          <tr>
            <td><code>headlineLarge</code></td>
            <td><span class="mono-chip">32sp</span></td>
            <td>40sp</td>
            <td>0sp</td>
            <td>800 (Extrabold) · Jakarta Sans</td>
            <td>Títulos principales de resumen de orden y cierre de jornada</td>
          </tr>
          <tr>
            <td><code>headlineMedium</code></td>
            <td><span class="mono-chip">28sp</span></td>
            <td>36sp</td>
            <td>0sp</td>
            <td>700 (Bold) · Jakarta Sans</td>
            <td>Cabeceras de pantalla en TopAppBar colapsable y modal sheets</td>
          </tr>
          <tr>
            <td><code>headlineSmall</code></td>
            <td><span class="mono-chip">24sp</span></td>
            <td>32sp</td>
            <td>0sp</td>
            <td>700 (Bold) · Jakarta Sans</td>
            <td>Nombre de cliente receptor en obra (ej. ICISA Distribuciones)</td>
          </tr>

          <!-- Title -->
          <tr>
            <td><code>titleLarge</code></td>
            <td><span class="mono-chip">22sp</span></td>
            <td>28sp</td>
            <td>0sp</td>
            <td>600 (SemiBold) · Jakarta Sans</td>
            <td>Subsecciones en detalle de guía de remisión y comprobantes</td>
          </tr>
          <tr>
            <td><code>titleMedium</code></td>
            <td><span class="mono-chip">16sp</span></td>
            <td>24sp</td>
            <td>+0.15sp</td>
            <td>600 (SemiBold) · Inter</td>
            <td>Cabeceras de tarjetas de parada SO-2026-0018 y nombres de ítems SKU</td>
          </tr>
          <tr>
            <td><code>titleSmall</code></td>
            <td><span class="mono-chip">14sp</span></td>
            <td>20sp</td>
            <td>+0.1sp</td>
            <td>600 (SemiBold) · Inter</td>
            <td>Encabezados de tablas de picking FEFO y checklists de maquinaria</td>
          </tr>

          <!-- Body -->
          <tr>
            <td><code>bodyLarge</code></td>
            <td><span class="mono-chip">16sp</span></td>
            <td>24sp</td>
            <td>+0.5sp</td>
            <td>400 (Regular) · Inter</td>
            <td>Texto de lectura principal, instrucciones de entrega y direcciones</td>
          </tr>
          <tr>
            <td><code>bodyMedium</code></td>
            <td><span class="mono-chip">14sp</span></td>
            <td>20sp</td>
            <td>+0.25sp</td>
            <td>400 (Regular) · Inter</td>
            <td>Descripciones de contingencia, motivos de parada no programada</td>
          </tr>
          <tr>
            <td><code>bodySmall</code></td>
            <td><span class="mono-chip">12sp</span></td>
            <td>16sp</td>
            <td>+0.4sp</td>
            <td>400 (Regular) · Inter</td>
            <td>Marcas de tiempo GPS, coordenadas geocerca, UUIDs de transacción</td>
          </tr>

          <!-- Label -->
          <tr>
            <td><code>labelLarge</code></td>
            <td><span class="mono-chip">14sp</span></td>
            <td>20sp</td>
            <td>+0.1sp</td>
            <td>700 (Bold) · Inter</td>
            <td>Etiquetas de botones primarios 48dp y botones industriales 56dp</td>
          </tr>
          <tr>
            <td><code>labelMedium</code></td>
            <td><span class="mono-chip">12sp</span></td>
            <td>16sp</td>
            <td>+0.5sp</td>
            <td>600 (SemiBold) · Inter</td>
            <td>Pestañas de navegación BottomNav, chips de filtro y badges de estado</td>
          </tr>
          <tr>
            <td><code>labelSmall</code></td>
            <td><span class="mono-chip">11sp</span></td>
            <td>16sp</td>
            <td>+0.5sp</td>
            <td>700 (Bold) · Inter</td>
            <td>Microchips (EN RUTA, FEFO OK, 3.8°C), captions de telemetría</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 2: Resiliencia ante Escalado de Fuentes (100% → 200%) -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">02</span>
        <div>
          <p class="cuadro-kicker">ACCESIBILIDAD MÓVIL · NON-LINEAR FONT SCALING</p>
          <h3 class="cuadro-title">Comportamiento con Escalado de Accesibilidad (Android 14+)</h3>
          <p class="cuadro-subtitle">
            Android 14 introduce el escalado no lineal, donde las fuentes pequeñas crecen hasta 200% mientras que los títulos grandes crecen de forma moderada para evitar romper la UI.
          </p>
        </div>
      </div>
    </div>

    <div class="scaling-preview-grid">
      <div class="scaling-card scale-100">
        <div class="scale-badge">Escala Estándar (100%)</div>
        <h4 class="scale-title">SO-2026-0018 · ICISA</h4>
        <p class="scale-body">Entrega en Muelle 3 · Av. Argentina 1240. Sensor calibrado a 3.8°C (Rango OK).</p>
        <span class="scale-footer">Altura de tarjeta: 96dp</span>
      </div>

      <div class="scaling-card scale-150">
        <div class="scale-badge">Escala Accesible (150%)</div>
        <h4 class="scale-title">SO-2026-0018 · ICISA</h4>
        <p class="scale-body">Entrega en Muelle 3 · Av. Argentina 1240. Sensor calibrado a 3.8°C (Rango OK).</p>
        <span class="scale-footer">Altura adaptativa: 128dp (Sin truncamiento)</span>
      </div>

      <div class="scaling-card scale-200">
        <div class="scale-badge">Escala Máxima (200%)</div>
        <h4 class="scale-title">SO-2026-0018 · ICISA</h4>
        <p class="scale-body">Entrega en Muelle 3 · Av. Argentina 1240. Sensor calibrado a 3.8°C (Rango OK).</p>
        <span class="scale-footer">Layout vertical fluido: 164dp (WCAG 2.2 AA)</span>
      </div>
    </div>
  </section>

  <!-- Section 3: Contrato de Código Kotlin Compose Type.kt -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">03</span>
        <div>
          <p class="cuadro-kicker">IMPLEMENTACIÓN NATIVA · JETPACK COMPOSE</p>
          <h3 class="cuadro-title">Type.kt Canónico (:core:designsystem)</h3>
          <p class="cuadro-subtitle">
            Definición en Kotlin 2.4 con <code>androidx.compose.material3.Typography</code> para los 15 roles canónicos.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag kotlin"><i class="pi pi-code"></i> Type.kt</span>
        <span class="cuadro-tag primary"><i class="pi pi-font"></i> Plus Jakarta Sans & Inter</span>
      </div>
    </div>

    <div class="code-container-block">
      <div class="code-header-bar">
        <div class="code-header-title">
          <i class="pi pi-file"></i>
          <span>core/designsystem/src/main/kotlin/com/nexa/core/designsystem/theme/Type.kt</span>
        </div>
        <span class="code-lang-pill">Kotlin 2.4</span>
      </div>
      <pre class="code-pre-box" is:raw><code><span class="comm">// Canonical Material 3 Typography Scale for Nexa Suite Operations Android</span>
<span class="kw">package</span> com.nexa.core.designsystem.theme

<span class="kw">import</span> androidx.compose.material3.Typography
<span class="kw">import</span> androidx.compose.ui.text.TextStyle
<span class="kw">import</span> androidx.compose.ui.text.font.FontFamily
<span class="kw">import</span> androidx.compose.ui.text.font.FontWeight
<span class="kw">import</span> androidx.compose.ui.unit.sp

<span class="kw">val</span> NexaTypography = <span class="type">Typography</span>(
    <span class="comm">// 1. Display (Jakarta Sans 700/800)</span>
    displayLarge = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.ExtraBold,
        fontSize = <span class="num">57.sp</span>,
        lineHeight = <span class="num">64.sp</span>,
        letterSpacing = (-<span class="num">0.25</span>).sp
    ),
    displayMedium = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Bold,
        fontSize = <span class="num">45.sp</span>,
        lineHeight = <span class="num">52.sp</span>,
        letterSpacing = <span class="num">0.sp</span>
    ),
    displaySmall = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Bold,
        fontSize = <span class="num">36.sp</span>,
        lineHeight = <span class="num">44.sp</span>,
        letterSpacing = <span class="num">0.sp</span>
    ),

    <span class="comm">// 2. Headline (Jakarta Sans 700/800)</span>
    headlineLarge = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.ExtraBold,
        fontSize = <span class="num">32.sp</span>,
        lineHeight = <span class="num">40.sp</span>,
        letterSpacing = <span class="num">0.sp</span>
    ),
    headlineMedium = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Bold,
        fontSize = <span class="num">28.sp</span>,
        lineHeight = <span class="num">36.sp</span>,
        letterSpacing = <span class="num">0.sp</span>
    ),
    headlineSmall = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Bold,
        fontSize = <span class="num">24.sp</span>,
        lineHeight = <span class="num">32.sp</span>,
        letterSpacing = <span class="num">0.sp</span>
    ),

    <span class="comm">// 3. Title (Jakarta Sans & Inter 600)</span>
    titleLarge = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.SemiBold,
        fontSize = <span class="num">22.sp</span>,
        lineHeight = <span class="num">28.sp</span>,
        letterSpacing = <span class="num">0.sp</span>
    ),
    titleMedium = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.SemiBold,
        fontSize = <span class="num">16.sp</span>,
        lineHeight = <span class="num">24.sp</span>,
        letterSpacing = <span class="num">0.15.sp</span>
    ),
    titleSmall = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.SemiBold,
        fontSize = <span class="num">14.sp</span>,
        lineHeight = <span class="num">20.sp</span>,
        letterSpacing = <span class="num">0.1.sp</span>
    ),

    <span class="comm">// 4. Body (Inter 400)</span>
    bodyLarge = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Normal,
        fontSize = <span class="num">16.sp</span>,
        lineHeight = <span class="num">24.sp</span>,
        letterSpacing = <span class="num">0.5.sp</span>
    ),
    bodyMedium = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Normal,
        fontSize = <span class="num">14.sp</span>,
        lineHeight = <span class="num">20.sp</span>,
        letterSpacing = <span class="num">0.25.sp</span>
    ),
    bodySmall = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Normal,
        fontSize = <span class="num">12.sp</span>,
        lineHeight = <span class="num">16.sp</span>,
        letterSpacing = <span class="num">0.4.sp</span>
    ),

    <span class="comm">// 5. Label (Inter 600/700)</span>
    labelLarge = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Bold,
        fontSize = <span class="num">14.sp</span>,
        lineHeight = <span class="num">20.sp</span>,
        letterSpacing = <span class="num">0.1.sp</span>
    ),
    labelMedium = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.SemiBold,
        fontSize = <span class="num">12.sp</span>,
        lineHeight = <span class="num">16.sp</span>,
        letterSpacing = <span class="num">0.5.sp</span>
    ),
    labelSmall = <span class="type">TextStyle</span>(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Bold,
        fontSize = <span class="num">11.sp</span>,
        lineHeight = <span class="num">16.sp</span>,
        letterSpacing = <span class="num">0.5.sp</span>
    )
)</code></pre>
    </div>
  </section>
</div>

<style>
  .tipografia-sp-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
  }

  .scaling-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 860px) {
    .scaling-preview-grid {
      grid-template-columns: 1fr;
    }
  }

  .scaling-card {
    padding: 16px;
    background: #f8fafc;
    border: 1px solid var(--nexa-color-border-default, #e2e8f0);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;

    .scale-badge {
      font-size: 9.5px;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: var(--nexa-color-primary-700, #1d4ed8);
      text-transform: uppercase;
    }

    .scale-title {
      font-family: var(--nexa-font-family-display, sans-serif);
      font-weight: 700;
      color: #0f172a;
      margin: 0;
    }

    .scale-body {
      color: #334155;
      line-height: 1.5;
      margin: 0;
    }

    .scale-footer {
      font-size: 10.5px;
      font-family: var(--nexa-font-family-mono, monospace);
      color: #15803d;
      font-weight: 600;
      margin-top: auto;
      padding-top: 6px;
      border-top: 1px dashed #cbd5e1;
    }

    &.scale-100 {
      .scale-title { font-size: 16px; }
      .scale-body { font-size: 14px; }
    }

    &.scale-150 {
      .scale-title { font-size: 20px; }
      .scale-body { font-size: 17px; }
    }

    &.scale-200 {
      .scale-title { font-size: 24px; }
      .scale-body { font-size: 20px; }
    }
  }
</style>
