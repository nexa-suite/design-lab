---
/**
 * WEBSITE STYLE — LIVING ARTIFACTS CATALOG (NEXAFY)
 * Detailed component catalog showcasing every isolated living artifact, its spatial role, and code structure.
 */
import 'primeicons/primeicons.css';
import '../styles/tokens.css';
import UnifiedLabShell from '../components/layout/UnifiedLabShell.astro';
import YourCompanyHub from '../components/nexafy/YourCompanyHub.astro';
import PhysicalStoreCard from '../components/nexafy/PhysicalStoreCard.astro';
import CustomerInquiryCard from '../components/nexafy/CustomerInquiryCard.astro';
import OnlineStoreCard from '../components/nexafy/OnlineStoreCard.astro';
import ChannelBadges from '../components/nexafy/ChannelBadges.astro';
import ConduitBadges from '../components/nexafy/ConduitBadges.astro';
import SaasCustomerProfileCard from '../components/nexafy/SaasCustomerProfileCard.astro';
import SaasItemsTableCard from '../components/nexafy/SaasItemsTableCard.astro';
import SaasFloatingDateCard from '../components/nexafy/SaasFloatingDateCard.astro';
import LiveTelemetryCard from '../components/nexafy/LiveTelemetryCard.astro';
import PhoneCheckoutSimulator from '../components/nexafy/PhoneCheckoutSimulator.astro';
import EscrowGuaranteeCard from '../components/nexafy/EscrowGuaranteeCard.astro';
import RealtimeEscrowWidget from '../components/nexafy/RealtimeEscrowWidget.astro';
import PaymentCircuitMethods from '../components/nexafy/PaymentCircuitMethods.astro';
import QuickCheckoutModal from '../components/nexafy/QuickCheckoutModal.astro';
import FloatingBookingChip from '../components/nexafy/FloatingBookingChip.astro';
import InsuranceNotchPlate from '../components/nexafy/InsuranceNotchPlate.astro';
import RentalRoiSimulator from '../components/nexafy/RentalRoiSimulator.astro';
import SustainabilityMetricsCard from '../components/nexafy/SustainabilityMetricsCard.astro';
import FooterSculptedPlate from '../components/nexafy/FooterSculptedPlate.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo de Artefactos Vivos · Nexafy (Website Style)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link 
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" 
    rel="stylesheet"
  >

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--nexa-surface-page, #f6faff);
      color: var(--nexa-color-text-primary, #0f172a);
      font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .catalog-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem;
      flex: 1;
      width: 100%;
    }

    .catalog-header {
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--nexa-color-border-default, #e2e8f0);
      padding-bottom: 1.5rem;
    }

    .catalog-title {
      font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
      font-size: 26px;
      font-weight: 800;
      color: var(--nexa-color-text-primary, #0f172a);
      margin-bottom: 0.5rem;
    }

    .catalog-desc {
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 15px;
      max-width: 800px;
      line-height: 1.6;
    }

    .section-title {
      font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
      font-size: 18px;
      font-weight: 700;
      color: var(--nexa-color-primary-700, #1b4fb8);
      margin: 2.5rem 0 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .artifacts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 1.5rem;
      align-items: start;
    }

    .artifact-card {
      background: #ffffff;
      border: 1px solid var(--nexa-color-border-default, #e2e8f0);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 4px rgba(15, 23, 42, 0.04);
      display: flex;
      flex-direction: column;
    }

    .artifact-preview-stage {
      --stage-card: #0a3359;
      --stage-text: #ffffff;
      --stage-subtext: #cbd5e1;
      --stage-capsule-bg: rgba(255, 255, 255, 0.14);
      --stage-capsule-text: #ffffff;
      background: #082846; /* Nexa Dark Blue Canvas */
      padding: 1.75rem 1.5rem;
      min-height: 240px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      box-sizing: border-box;
    }

    .artifact-preview-stage.stage-light {
      background: #f1f5f9;
      --stage-card: #ffffff;
      --stage-text: #082846;
      --stage-capsule-bg: #082846;
      --stage-capsule-text: #ffffff;
    }

    .artifact-preview-stage.stage-beige {
      background: #FDFAE7;
      --stage-card: #082846;
      --stage-text: #ffffff;
    }

    .artifact-card.span-2 {
      grid-column: span 2;
    }

    @media (max-width: 900px) {
      .artifact-card.span-2 {
        grid-column: span 1;
      }
    }

    .artifact-info {
      padding: 1.25rem 1.5rem;
      background: #ffffff;
      border-top: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
    }

    .artifact-name {
      font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
      font-size: 15px;
      font-weight: 700;
      color: var(--nexa-color-text-primary, #0f172a);
      margin-bottom: 0.35rem;
    }

    .artifact-meta {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
    }

    .tag-role {
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 10px;
      font-weight: 700;
      background: #e0f2fe;
      color: #0369a1;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .artifact-details {
      font-size: 13px;
      color: var(--nexa-color-text-secondary, #64748b);
      line-height: 1.5;
    }

    /* Interactive Suite Spotlight Card */
    .suite-spotlight-card {
      background: #082846;
      border: 1px solid #1a4971;
      border-radius: 16px;
      padding: 1.75rem 2rem;
      margin-bottom: 2.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      box-shadow: 0 8px 24px rgba(8, 40, 70, 0.18);
      position: relative;
      overflow: hidden;
    }

    .spotlight-content {
      flex: 1;
      min-width: 0;
    }

    .spotlight-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(56, 200, 255, 0.15);
      border: 1px solid rgba(56, 200, 255, 0.4);
      color: #38c8ff;
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 10.5px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 9999px;
      margin-bottom: 0.75rem;
      letter-spacing: 0.04em;
    }

    .spotlight-title {
      font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
      font-size: 20px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 0.4rem;
    }

    .spotlight-desc {
      font-size: 13.5px;
      color: #cbd5e1;
      line-height: 1.55;
      max-width: 820px;
      margin-bottom: 1rem;
    }

    .spotlight-desc code {
      font-family: var(--nexa-font-family-mono, monospace);
      background: rgba(255, 255, 255, 0.12);
      color: #38c8ff;
      padding: 1px 5px;
      border-radius: 4px;
      font-size: 12px;
    }

    .spotlight-features {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .feature-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.08);
      color: #94a3b8;
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 3px 8px;
      border-radius: 6px;
    }

    .feature-tag i {
      color: #38c8ff;
      font-size: 10px;
    }

    .btn-spotlight-launch {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #38c8ff;
      color: #082846;
      font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
      font-size: 13.5px;
      font-weight: 700;
      padding: 12px 22px;
      border-radius: 10px;
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.18s ease;
      box-shadow: 0 4px 12px rgba(56, 200, 255, 0.3);
    }

    .btn-spotlight-launch:hover {
      background: #ffffff;
      color: #082846;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(56, 200, 255, 0.45);
    }

    @media (max-width: 900px) {
      .suite-spotlight-card {
        flex-direction: column;
        align-items: flex-start;
      }
      .btn-spotlight-launch {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <UnifiedLabShell currentSection="artifacts">
    <main class="catalog-container">
    <div class="catalog-header">
      <h1 class="catalog-title">Catálogo Modular de Artefactos Vivos (Nexafy)</h1>
      <p class="catalog-desc">
        Inventario exhaustivo de componentes geométricos vivos de Nexafy. Cada artefacto está diseñado bajo la regla de <strong>cero degradados</strong>, utilizando colorimetría sólida pura (Fondo Azul Oscuro <code>#082846</code> y relleno de tarjeta Celeste Nexa <code>#38c8ff</code>) y conductos vasculares gruesos de 28px con redondeos arquitectónicos.
      </p>
    </div>

    <!-- Interactive Suite Spotlight Banner -->
    <div class="suite-spotlight-card">
      <div class="spotlight-content">
        <div class="spotlight-badge">
          <i class="pi pi-sparkles"></i>
          <span>ORQUESTACIÓN COMPLETA DE CONVERSIÓN</span>
        </div>
        <h2 class="spotlight-title">Suite Interactiva Flecto & Nexafy</h2>
        <p class="spotlight-desc">
          Visualiza los cinco macro-artefactos ensamblados en su flujo interactivo completo: Scrollytelling con simulador de checkout en 4 pasos (selector de fechas, cálculo de días, depósito escrow, resumen y pago), Bento Grid de Canales en warm beige <code>#FDFAE7</code>, SaaS Operational OS con búsqueda reactiva, Seguro Escrow con toggle de protección 100% y Canvas de Sostenibilidad.
        </p>
        <div class="spotlight-features">
          <span class="feature-tag"><i class="pi pi-mobile"></i> Scrollytelling Checkout 4-Etapas</span>
          <span class="feature-tag"><i class="pi pi-th-large"></i> Bento 8-Tiles Warm Beige #FDFAE7</span>
          <span class="feature-tag"><i class="pi pi-table"></i> SaaS Operational OS + Search</span>
          <span class="feature-tag"><i class="pi pi-shield"></i> Seguro 100% Protection Toggle</span>
          <span class="feature-tag"><i class="pi pi-globe"></i> Circular Economy Canvas</span>
        </div>
      </div>
      <div class="spotlight-action">
        <a href="/interactive-suite" class="btn-spotlight-launch">
          <span>Abrir Suite Interactiva</span>
          <i class="pi pi-arrow-right"></i>
        </a>
      </div>
    </div>

    <!-- Capítulo 1: Canales & Origen -->
    <h2 class="section-title">
      <i class="pi pi-compass"></i> Capítulo 01: Origen & Red de Canales Comerciales
    </h2>

    <div class="artifacts-grid">
      <!-- Your Company Hub -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <div style="position: relative; width: 170px; height: 140px; display: flex; align-items: center; justify-content: center;">
            <YourCompanyHub isIsolated={true} />
          </div>
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">YourCompanyHub</h3>
          <div class="artifact-meta">
            <span class="tag-role">Origen Central</span>
            <span class="tag-role">SVG + CSS</span>
          </div>
          <p class="artifact-details">
            Nodo raíz del grafo de escena donde se originan todos los conductos vasculares. Cuenta con identificador corporativo y puertos de conexión norte, sur, este y oeste.
          </p>
        </div>
      </div>

      <!-- Physical Store Card -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <PhysicalStoreCard isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">PhysicalStoreCard</h3>
          <div class="artifact-meta">
            <span class="tag-role">Canal POS</span>
            <span class="tag-role">Canal 01</span>
          </div>
          <p class="artifact-details">
            Representación de la tienda física y punto de venta presencial. Incluye contador de unidades disponibles y estado de sincronización de terminal.
          </p>
        </div>
      </div>

      <!-- Customer Inquiry Card -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <CustomerInquiryCard isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">CustomerInquiryCard</h3>
          <div class="artifact-meta">
            <span class="tag-role">Inbound Leads</span>
            <span class="tag-role">Canal 02</span>
          </div>
          <p class="artifact-details">
            Tarjeta interactiva que simula la recepción y respuesta de cotizaciones en tiempo real por correo o mensajería corporativa.
          </p>
        </div>
      </div>

      <!-- Online Store Card -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <OnlineStoreCard isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">OnlineStoreCard</h3>
          <div class="artifact-meta">
            <span class="tag-role">E-commerce Sync</span>
            <span class="tag-role">Canal 03</span>
          </div>
          <p class="artifact-details">
            Visualización de canal digital e-commerce con selector de cantidad, precio de reserva por período y estado activo.
          </p>
        </div>
      </div>

      <!-- Channel Badges (4 Satellite Nodes) -->
      <div class="artifact-card span-2">
        <div class="artifact-preview-stage">
          <ChannelBadges isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">ChannelBadges</h3>
          <div class="artifact-meta">
            <span class="tag-role">Nodos Satélites</span>
            <span class="tag-role">4 Canales</span>
          </div>
          <p class="artifact-details">
            Insignias satélites que representan la Tienda Física POS, Cotización Directa (Inquiry), Tienda Online (acme.store) y Escudo de Custodia Escrow con telemetría en tiempo real.
          </p>
        </div>
      </div>

      <!-- Conduit Badges & Satellites -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <ConduitBadges isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">ConduitBadges</h3>
          <div class="artifact-meta">
            <span class="tag-role">Satélites Vasculares</span>
            <span class="tag-role">4 Insignias</span>
          </div>
          <p class="artifact-details">
            Insignias satélites que marcan los puertos clave del circuito vascular (Norte, Sur, Este y Oeste) con iconos de estado y telemetría.
          </p>
        </div>
      </div>
    </div>

    <!-- Capítulo 2: Dashboard SaaS Modular -->
    <h2 class="section-title">
      <i class="pi pi-table"></i> Capítulo 02: Plataforma SaaS & Dashboard Morph
    </h2>

    <div class="artifacts-grid">
      <!-- Customer Profile -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <SaasCustomerProfileCard isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">SaasCustomerProfileCard</h3>
          <div class="artifact-meta">
            <span class="tag-role">Identidad & KYC</span>
            <span class="tag-role">SaaS Core</span>
          </div>
          <p class="artifact-details">
            Tarjeta de validación biométrica y perfil de cliente con badge de verificación y cálculo de nivel de riesgo.
          </p>
        </div>
      </div>

      <!-- Items Table -->
      <div class="artifact-card span-2">
        <div class="artifact-preview-stage stage-light">
          <SaasItemsTableCard isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">SaasItemsTableCard</h3>
          <div class="artifact-meta">
            <span class="tag-role">Libro de Órdenes</span>
            <span class="tag-role">Live Ledger</span>
          </div>
          <p class="artifact-details">
            Tabla condensada de reservas activas con ID de activos, estatus dinámico de entrega y fechas contractuales.
          </p>
        </div>
      </div>

      <!-- Floating Dates -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <SaasFloatingDateCard isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">SaasFloatingDateCard</h3>
          <div class="artifact-meta">
            <span class="tag-role">Control Temporal</span>
            <span class="tag-role">Despacho</span>
          </div>
          <p class="artifact-details">
            Insignia flotante de calendario que sincroniza las fechas estimadas de entrega y devolución de activos alquilados.
          </p>
        </div>
      </div>

      <!-- Live Telemetry Card -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <LiveTelemetryCard isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">LiveTelemetryCard</h3>
          <div class="artifact-meta">
            <span class="tag-role">Telemetría Operativa</span>
            <span class="tag-role">Bento Metric</span>
          </div>
          <p class="artifact-details">
            Monitor de flota en tiempo real con 0.0% de conflictos de sobre-reserva, 100% de aseguramiento en tránsito y barras de utilización por categoría de equipo.
          </p>
        </div>
      </div>
    </div>

    <!-- Capítulo 3: Checkout Seguro & Custodia Escrow -->
    <h2 class="section-title">
      <i class="pi pi-shield"></i> Capítulo 03: Checkout Seguro & Custodia Escrow
    </h2>

    <div class="artifacts-grid">
      <!-- Phone Checkout Simulator -->
      <div class="artifact-card">
        <div class="artifact-preview-stage stage-light">
          <PhoneCheckoutSimulator isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">PhoneCheckoutSimulator</h3>
          <div class="artifact-meta">
            <span class="tag-role">Checkout Móvil</span>
            <span class="tag-role">100% SVG/CSS</span>
          </div>
          <p class="artifact-details">
            Chasis simulado de smartphone con verificación de pago en 1 toque y confirmación de custodia de fondos.
          </p>
        </div>
      </div>

      <!-- Realtime Escrow Widget -->
      <div class="artifact-card">
        <div class="artifact-preview-stage stage-light">
          <RealtimeEscrowWidget isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">RealtimeEscrowWidget</h3>
          <div class="artifact-meta">
            <span class="tag-role">Custodia Escrow</span>
            <span class="tag-role">Preautorización</span>
          </div>
          <p class="artifact-details">
            Widget interactivo para simular retenciones en garantía preautorizadas (€50 - €1,500) con liberación post-checkin instantánea.
          </p>
        </div>
      </div>

      <!-- Quick Checkout Modal -->
      <div class="artifact-card">
        <div class="artifact-preview-stage stage-light">
          <QuickCheckoutModal isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">QuickCheckoutModal</h3>
          <div class="artifact-meta">
            <span class="tag-role">Modal de Checkout</span>
            <span class="tag-role">Multi-pasarela</span>
          </div>
          <p class="artifact-details">
            Modal interactivo de confirmación con desglose de período, depósito pre-autorizado, entrega y selección de métodos de pago.
          </p>
        </div>
      </div>

      <!-- Escrow Guarantee Card -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <EscrowGuaranteeCard isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">EscrowGuaranteeCard</h3>
          <div class="artifact-meta">
            <span class="tag-role">Protección Escrow</span>
            <span class="tag-role">Escudo de Seguridad</span>
          </div>
          <p class="artifact-details">
            Escudo y certificación de fondos en custodia, protegiendo tanto al propietario del activo como al arrendador.
          </p>
        </div>
      </div>

      <!-- Payment Circuit Methods -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <PaymentCircuitMethods isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">PaymentCircuitMethods</h3>
          <div class="artifact-meta">
            <span class="tag-role">Nodos de Pago</span>
            <span class="tag-role">Dispersión</span>
          </div>
          <p class="artifact-details">
            Chips de procesamiento multicanal que representan tarjetas de crédito, transferencias directas y débitos programados.
          </p>
        </div>
      </div>

      <!-- Floating Booking Chip -->
      <div class="artifact-card">
        <div class="artifact-preview-stage">
          <FloatingBookingChip isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">FloatingBookingChip</h3>
          <div class="artifact-meta">
            <span class="tag-role">Nexa Link</span>
            <span class="tag-role">Despachador 1-Click</span>
          </div>
          <p class="artifact-details">
            Insignia flotante de enlace directo para compartir cotizaciones vinculadas a inventario real, parámetros de entrega y fianza bancaria.
          </p>
        </div>
      </div>
    </div>

    <!-- Capítulo 4: Macro-Artefactos & Arquitectura de Póliza, ROI y Pie de Página -->
    <h2 class="section-title">
      <i class="pi pi-th-large"></i> Capítulo 04: Macro-Artefactos de Arquitectura, Póliza & Pie de Página
    </h2>

    <div class="artifacts-grid">
      <!-- Insurance Notch Plate -->
      <div class="artifact-card span-2">
        <div class="artifact-preview-stage" style="padding: 1rem;">
          <InsuranceNotchPlate isIsolated={true} />
        </div>
        <div class="artifact-info">
          <h3 class="artifact-name">InsuranceNotchPlate</h3>
          <div class="artifact-meta">
            <span class="tag-role">Geometría de Muesca</span>
            <span class="tag-role">Bürocratik Concave</span>
          </div>
          <p class="artifact-details">
            Placa arquitectónica completa con corte perimetral asimétrico y redondeos cóncavos, conmutador de cobertura All-Risk interactivo, insignias multi-país y cotizador de póliza.
          </p>
