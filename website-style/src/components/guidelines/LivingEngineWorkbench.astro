  }

  .lang-toggle-btn {
    background: none;
    border: none;
    font-weight: 700;
    color: #082846;
    cursor: pointer;
    font-size: 0.875rem;
  }

  .hero-book-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.55rem 1.15rem;
    border: 1px solid #cbd5e1;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #082846;
    background: #ffffff;
