        <div class="footer-left-col">
          <!-- Canonical White Nexa Logo -->
          <div class="footer-brand-mark" aria-label="Nexa">
            <img src="/assets/logo-nexa-white.svg" alt="Nexa" height="34" style="display: block;" />
          </div>

          <h2 id="footer-newsletter-heading" class="footer-newsletter-title">
            Suscríbete a Nexafy Pulse<br />
            para recibir actualizaciones de<br />
            la cadena de frío 4.0
          </h2>

          <!-- Interactive Underline Newsletter Input -->
          <form class="footer-newsletter-form" id="footer-newsletter-form" aria-label="Subscribe to newsletter">
            <div class="footer-input-row">
              <input 
                type="email" 
                id="footer-email-input" 
                name="email" 
                placeholder="Ingresa tu correo corporativo" 
                required 
                autocomplete="email"
                aria-label="Email address for newsletter"
              />
              <button type="submit" class="footer-arrow-submit" aria-label="Submit newsletter subscription">
                <svg width="24" height="16" viewBox="0 0 24 16" fill="none" stroke="#38bdf8" stroke-width="2.2">
                  <path d="M1 8h21M15 1l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
            <p class="footer-form-feedback" id="footer-newsletter-feedback" aria-live="polite"></p>
          </form>

          <!-- Proudly Backed By Row -->
          <div class="footer-backed-by">
            <span class="backed-label">Infraestructura y Respaldo B2B</span>
            <div class="backed-logos-row" role="list">
              <!-- techstars_ -->
              <span class="backed-brand text-techstars" role="listitem">
                <strong>techstars</strong><span class="brand-underscore">_</span>
              </span>

              <!-- ÜBERMORGEN -->
              <span class="backed-brand text-ubermorgen" role="listitem">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true">
                  <circle cx="12" cy="7" r="3.2"/>
                  <path d="M5.5 18c0-3.6 2.9-6.5 6.5-6.5s6.5 2.9 6.5 6.5"/>
                  <circle cx="6.5" cy="11.5" r="2.2"/>
                  <circle cx="17.5" cy="11.5" r="2.2"/>
                </svg>
                <span>ÜBERMORGEN</span>
              </span>

              <!-- maze -->
