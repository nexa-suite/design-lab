<script>
  // Newsletter Form Handler with accessible inline feedback
  const form = document.getElementById('footer-newsletter-form') as HTMLFormElement | null;
  const feedback = document.getElementById('footer-newsletter-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('footer-email-input') as HTMLInputElement | null;
      if (input && input.value) {
        feedback.textContent = '¡Gracias por suscribirte a Nexafy Pulse! ✨';
        feedback.style.color = '#38bdf8';
        input.value = '';
        setTimeout(() => {
          feedback.textContent = '';
        }, 5000);
      }
    });
  }
</script>

