---
/**
 * MOBILE STYLE — MASTER VISUAL REPORT & MULTI-DEVICE ANDROID STUDIO
 * Nexa Design Lab · Canonical Android Jetpack Compose M3 Specifications
 *
 * MODULAR SCREEN-BY-SCREEN ARCHITECTURE:
 * Each sidebar option is an isolated, dedicated screen view.
 * No more chaotic 10,000px downward stacking!
 */
import 'primeicons/primeicons.css';
import '../styles/mobile-tokens.css';
import UnifiedLabShell from '../components/layout/UnifiedLabShell.astro';

// 1. Master Simulator (Interactive Calibrator & Model Sizer)
import DeviceFrame from '../components/simulator/DeviceFrame.astro';

// 2. Visual Design Foundations M3
import TokensColorSection from '../components/guidelines/TokensColorSection.astro';
import TipografiaSpSection from '../components/guidelines/TipografiaSpSection.astro';
import Cuadricula8dpSection from '../components/guidelines/Cuadricula8dpSection.astro';
import ElevacionesM3Section from '../components/guidelines/ElevacionesM3Section.astro';
import Ergonomia48dpSection from '../components/guidelines/Ergonomia48dpSection.astro';
import ZonasAlcanceSection from '../components/guidelines/ZonasAlcanceSection.astro';

// 3. Technical Specifications & Kotlin Code
import MobileArchitectureHero from '../components/guidelines/MobileArchitectureHero.astro';
import MobileEvidenceModel from '../components/guidelines/MobileEvidenceModel.astro';
import MobileHardwareSection from '../components/guidelines/MobileHardwareSection.astro';
import MobileResilienceSection from '../components/guidelines/MobileResilienceSection.astro';
import MobileComponentsSection from '../components/guidelines/MobileComponentsSection.astro';
import CodeSnippetsTabs from '../components/spec/CodeSnippetsTabs.astro';

// 4. Blueprint User Stories
import DriverRouteStory from '../components/stories/DriverRouteStory.astro';
import WarehousePickingStory from '../components/stories/WarehousePickingStory.astro';
import DispatchBoardStory from '../components/stories/DispatchBoardStory.astro';
import MachineryInspectionStory from '../components/stories/MachineryInspectionStory.astro';

// 5. Live Simulator Modules
import InteractiveDispatchMovement from '../components/simulator/InteractiveDispatchMovement.astro';
import InteractiveWholesaleCatalog from '../components/simulator/InteractiveWholesaleCatalog.astro';
import InteractiveMobileForms from '../components/simulator/InteractiveMobileForms.astro';
import InteractiveMobileNavbar from '../components/simulator/InteractiveMobileNavbar.astro';

// 6. Master Multi-Device Android Showcase (Reporte al fondo)
import GaleriaVisualAndroid from '../components/simulator/GaleriaVisualAndroid.astro';
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mobile Design Guidelines · Android Jetpack Compose M3 · Nexa Suite</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link 
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" 
    rel="stylesheet"
  >

  <style>
    /* Global Reset & Box-Sizing Hygiene */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--nexa-surface-page, #f6faff);
      color: var(--nexa-color-text-primary, #0f172a);
      font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
      font-size: 14px;
      line-height: 1.5;
      height: 100vh;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Master Screen Viewport Host */
    .modular-screen-stage {
      width: min(calc(100% - 48px), var(--nexa-layout-content-max, 1400px));
      margin: 0 auto;
      padding: clamp(20px, 3vw, 36px) 0 64px;
      color: var(--nexa-color-text-primary, #0f172a);
    }

    /* Distinct Screen Views */
    .lab-screen-view {
      display: none;
      width: 100%;
      animation: screenFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .lab-screen-view.active {
      display: block;
    }

    @keyframes screenFadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Screen Title Bar */
    .screen-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      padding-bottom: 20px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    .screen-badge-tag {
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--nexa-color-primary-600, #2563eb);
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      padding: 3px 8px;
      border-radius: 6px;
      display: inline-block;
      margin-bottom: 6px;
    }

    .screen-main-title {
      font-family: var(--nexa-font-family-display, sans-serif);
      font-size: 24px;
      font-weight: 700;
      color: #0f172a;
      letter-spacing: -0.01em;
    }

    .screen-main-desc {
      font-size: 13.5px;
      color: #64748b;
      margin-top: 4px;
      max-width: 800px;
      line-height: 1.5;
    }

    .screen-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .btn-quick-nav {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      color: #334155;
      cursor: pointer;
      transition: all 0.15s ease;
      text-decoration: none;
    }

    .btn-quick-nav:hover {
      background: #f1f5f9;
      color: #0f172a;
    }

    /* Screen Module Stack (for screens with multiple cards) */
    .screen-cards-stack {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .stories-grid-stage {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .modules-interactive-grid {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
  </style>
</head>
<body>
  <UnifiedLabShell currentSection="simulator">
    <main class="modular-screen-stage">
      
      <!-- =====================================================================
           PANTALLA 1 (DEFAULT): SIMULADOR & CALIBRADOR DINÁMICO ANDROID
           ===================================================================== -->
      <section class="lab-screen-view active" id="screen-simulator" data-title="Simulador & Calibrador Android">
        <DeviceFrame />
      </section>

      <!-- =====================================================================
           PANTALLA 2.1: PALETA M3 & SWATCHES WCAG
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-foundations-color" data-title="Paleta M3 & Contraste WCAG">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">FUNDAMENTOS VISUALES M3 · 01</span>
            <h2 class="screen-main-title">Paleta Tonal Material 3 & Contraste Accesible</h2>
            <p class="screen-main-desc">
              Tokens tonales certificados bajo WCAG 2.2 AAA para Android Jetpack Compose con paleta de alto contraste para logística de campo.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <TokensColorSection />
      </section>

      <!-- =====================================================================
           PANTALLA 2.2: TIPOGRAFÍA ESCALAR EN SP
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-foundations-typography" data-title="Tipografía Escalar en sp">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">FUNDAMENTOS VISUALES M3 · 02</span>
            <h2 class="screen-main-title">Escala Tipográfica Dinámica en sp (Scale-Independent Pixels)</h2>
            <p class="screen-main-desc">
              Especificaciones de texto en <code>sp</code> con soporte nativo para escalado de accesibilidad del sistema operativo Android (85% a 200%).
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <TipografiaSpSection />
      </section>

      <!-- =====================================================================
           PANTALLA 2.3: CUADRÍCULA ESPACIAL 8DP
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-foundations-grid" data-title="Cuadrícula Espacial 8dp">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">FUNDAMENTOS VISUALES M3 · 03</span>
            <h2 class="screen-main-title">Cuadrícula Espacial 8dp & Densidad Multiplataforma</h2>
            <p class="screen-main-desc">
              Ritmo vertical y horizontal de 8dp (y half-step de 4dp) alineado con los píxeles independientes de densidad (dp) de Android.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <Cuadricula8dpSection />
      </section>

      <!-- =====================================================================
           PANTALLA 2.4: ELEVACIÓN TONAL M3 (0 A 5)
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-foundations-elevation" data-title="Elevación & Surface Tint">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">FUNDAMENTOS VISUALES M3 · 04</span>
            <h2 class="screen-main-title">Elevación Tonal Material 3 & Surface Tint (Nivel 0 al 5)</h2>
            <p class="screen-main-desc">
              Capas de elevación sin sombras artificiales pesadas; profundidad jerárquica lograda mediante tinte de superficie tonal M3.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <ElevacionesM3Section />
      </section>

      <!-- =====================================================================
           PANTALLA 2.5: ERGONOMÍA 48DP VS 56DP
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-foundations-ergonomics" data-title="Ergonomía 48dp vs 56dp">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">FUNDAMENTOS VISUALES M3 · 05</span>
            <h2 class="screen-main-title">Calibrador Táctil 48dp Estándar vs 56dp con Guantes</h2>
            <p class="screen-main-desc">
              Diana mínima táctil de 48dp para conductores en movimiento y 56dp para operarios de almacén con guantes de cámara de frío.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <Ergonomia48dpSection />
      </section>

      <!-- =====================================================================
           PANTALLA 2.6: ZONAS DE ALCANCE DEL PULGAR
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-foundations-reach" data-title="Zonas de Alcance del Pulgar">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">FUNDAMENTOS VISUALES M3 · 06</span>
            <h2 class="screen-main-title">Zonas Biomecánicas de Alcance del Pulgar en Pantalla Móvil</h2>
            <p class="screen-main-desc">
              Mapeo ergonómico de zonas: Cómoda (inferior), Estiramiento (centro) y Difícil (superior) para ubicar acciones primarias.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <ZonasAlcanceSection />
      </section>

      <!-- =====================================================================
           PANTALLA 3.1: CATÁLOGO DE COMPONENTES M3
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-components" data-title="Componentes Canónicos M3">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">CATÁLOGO DE COMPONENTES · M3</span>
            <h2 class="screen-main-title">Catálogo Oficial de Componentes Android Compose</h2>
            <p class="screen-main-desc">
              Botones, tarjetas operativas, chips de estado, diálogos y controles táctiles de <code>:core:designsystem</code>.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <MobileComponentsSection />
      </section>

      <!-- =====================================================================
           PANTALLA 3.2: MÓDULOS INTERACTIVOS DE OPERACIONES
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-modules" data-title="Módulos Interactivos en Vivo">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">MÓDULOS OPERATIVOS · LIVE</span>
            <h2 class="screen-main-title">Módulos Interactivos de Operaciones en Campo</h2>
            <p class="screen-main-desc">
              Tablero Kanban adaptativo, catálogo mayorista B2B, formularios de inspección de maquinaria y navegación M3.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <div class="modules-interactive-grid">
          <InteractiveDispatchMovement />
          <InteractiveWholesaleCatalog />
          <InteractiveMobileForms />
          <InteractiveMobileNavbar />
        </div>
      </section>

      <!-- =====================================================================
           PANTALLA 3.3: GENERADOR DE CÓDIGO KOTLIN
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-code" data-title="Generador de Código Kotlin 2.4">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">CÓDIGO NATIVO · KOTLIN 2.4</span>
            <h2 class="screen-main-title">Código Fuente Nativo Compose & Contratos de Implementación</h2>
            <p class="screen-main-desc">
              Archivos Kotlin de referencia listos para copiar al módulo <code>:core:designsystem</code> de la aplicación Android.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <CodeSnippetsTabs />
      </section>

      <!-- =====================================================================
           PANTALLA 3.4: HISTORIAS BLUEPRINT EN CAMPO
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-stories" data-title="Historias Blueprint en Campo">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">BLUEPRINT STORIES · CRITERIOS DE ACEPTACIÓN</span>
            <h2 class="screen-main-title">Propuestas de Diseño Basadas en User Stories de Blueprint</h2>
            <p class="screen-main-desc">
              Slices arquitectónicos de Rutas con POD, Picking FEFO en frío, Despacho en muelle e Inspección de apiladores.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <div class="stories-grid-stage">
          <DriverRouteStory />
          <WarehousePickingStory />
          <DispatchBoardStory />
          <MachineryInspectionStory />
        </div>
      </section>

      <!-- =====================================================================
           PANTALLA 3.5: ARQUITECTURA C4 & RESILIENCIA
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-architecture" data-title="Arquitectura C4 & Resiliencia">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">ARQUITECTURA & RESILIENCIA · C4</span>
            <h2 class="screen-main-title">Arquitectura C4, Cola SQLite Room & Resiliencia Offline</h2>
            <p class="screen-main-desc">
              Estructura modular Gradle, sincronización en segundo plano con WorkManager y contratos de integración con hardware industrial.
            </p>
          </div>
          <div class="screen-actions">
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <div class="screen-cards-stack">
          <MobileArchitectureHero />
          <MobileEvidenceModel />
          <MobileHardwareSection />
          <MobileResilienceSection />
        </div>
      </section>

      <!-- =====================================================================
           PANTALLA 4: REPORTE MULTI-DISPOSITIVO (COLOCADA AL FONDO COMO SE PIDIÓ)
           ===================================================================== -->
      <section class="lab-screen-view" id="screen-gallery" data-title="Galería Multi-Dispositivo (5 Equipos)">
        <div class="screen-header-bar">
          <div>
            <span class="screen-badge-tag">REPORTE VISUAL COMPLETO · 5 EQUIPOS</span>
            <h2 class="screen-main-title">Grand Multi-Device Android Showcase (Mural Comparativo)</h2>
            <p class="screen-main-desc">
              Mural comparativo lado a lado con los 5 formatos de pantalla (390dp, 412dp teléfono, 412dp rugerizado, 600dp tablet 8" y 800dp tablet 11").
            </p>
          </div>
          <div class="screen-actions">
            <button type="button" class="btn-quick-nav" onclick="window.print()"><i class="pi pi-print"></i> Imprimir Reporte</button>
            <a href="#screen-simulator" class="btn-quick-nav"><i class="pi pi-arrow-left"></i> Volver al Simulador</a>
          </div>
        </div>
        <GaleriaVisualAndroid />
      </section>

    </main>
  </UnifiedLabShell>
</body>
</html>
