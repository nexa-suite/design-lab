<script>
  // Phase tabs interaction
  const phaseButtons = document.querySelectorAll('#story-conductor .phase-btn');
  const phasePanels = document.querySelectorAll('#story-conductor .phase-panel');

  phaseButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      phaseButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const phase = btn.getAttribute('data-phase');
      phasePanels.forEach(panel => {
        panel.classList.toggle('active', panel.id === `panel-phase-${phase}`);
      });
    });
  });

  // Outcome buttons toggle in phone mockup
  const outcomeBtns = document.querySelectorAll('#story-conductor .tri-outcome-btn');
  outcomeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      outcomeBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });
</script>
