---
/**
 * FLECTO FORENSIC FRAME-BY-FRAME ANALYZER & CONVERGENCE SYSTEM
 * Pass 5 Maximum Convergence Reference Authority
 * 
 * Maps all 8 scenes of the award-winning Flecto website (Awwwards SOTD)
 * frame-by-frame at native 60fps with exact timestamps, mathematical coordinates,
 * Bézier easing functions, 26-command geometry paths, and interactive simulators.
 */
import 'primeicons/primeicons.css';
import '../styles/tokens.css';
import '../styles/nexa-tokens.css';

import UnifiedLabShell from '../components/layout/UnifiedLabShell.astro';
---

<!doctype html>
<html lang="en" data-contrast-mode="standard">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Flecto Forensic Frame-by-Frame Analyzer · Nexafy (Website Style)</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" 
      rel="stylesheet" 
    />

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--nexa-surface-page, #f6faff);
        color: var(--nexa-color-text-primary, #0f172a);
        font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
        min-height: 100vh;
      }

      .forensic-page-container {
        max-width: 1440px;
        margin: 0 auto;
        padding: 2.5rem 1.75rem 5rem;
      }

      /* Hero Kicker & Header */
      .forensic-header {
        margin-bottom: 2.5rem;
      }

      .forensic-badge-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }

      .forensic-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #082846;
        color: #38c8ff;
        padding: 4px 12px;
        border-radius: 999px;
        font-family: var(--nexa-font-family-mono, monospace);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .forensic-sub-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e0f2fe;
        color: #0369a1;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
      }

      .forensic-title {
        font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
        font-size: clamp(2rem, 3.5vw, 2.75rem);
        font-weight: 800;
        color: #082846;
        line-height: 1.15;
        letter-spacing: -0.025em;
        margin-bottom: 0.75rem;
      }

      .forensic-title span {
        color: #2a67d9;
      }

      .forensic-desc {
        font-size: 1.05rem;
        color: #475569;
        max-width: 860px;
        line-height: 1.6;
        margin-bottom: 1.75rem;
      }

      /* Key Forensic Metrics Banner */
      .metrics-grid-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
        margin-bottom: 2.5rem;
      }

      .metric-box {
        display: flex;
        flex-direction: column;
        gap: 4px;
        border-left: 3px solid #2a67d9;
        padding-left: 12px;
      }

      .metric-box.accent-celeste {
        border-left-color: #38c8ff;
      }

      .metric-box.accent-mint {
        border-left-color: #38bdf8;
      }

      .metric-box.accent-amber {
        border-left-color: #f59e0b;
      }

      .metric-num {
        font-family: var(--nexa-font-family-mono, monospace);
        font-size: 1.25rem;
        font-weight: 800;
        color: #082846;
      }

      .metric-label {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      /* Scene Quick Jump & Multi-Dimensional Taxonomy Controller */
      .forensic-taxonomy-controller {
        background: #ffffff;
        border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 2.5rem;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .taxonomy-main-modes {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 1rem;
      }

      .tax-mode-btn {
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        color: #334155;
        padding: 8px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .tax-mode-btn:hover {
        background: #f1f5f9;
        border-color: #2a67d9;
        color: #2a67d9;
      }

      .tax-mode-btn.active {
        background: #082846;
        color: #ffffff;
        border-color: #082846;
        box-shadow: 0 3px 10px rgba(8, 40, 70, 0.25);
      }

      .taxonomy-filters-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      @media (max-width: 900px) {
        .taxonomy-filters-row {
          grid-template-columns: 1fr;
        }
      }

      .filter-group-box {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .filter-group-label {
        font-size: 11px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .filter-chips-cluster {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }

      .filter-chip {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #475569;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .filter-chip:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a;
      }

      .filter-chip.active {
        background: #2a67d9;
        border-color: #2a67d9;
        color: #ffffff;
        font-weight: 700;
      }

      .taxonomy-quick-nav-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding-top: 1rem;
        border-top: 1px solid #f1f5f9;
      }

      .quick-scene-pills {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }

      .quick-scene-pill {
        background: #f1f5f9;
        border: 1px solid transparent;
        color: #334155;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        font-family: var(--nexa-font-family-mono, monospace);
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s ease;
      }

      .quick-scene-pill:hover {
        background: #e2e8f0;
        color: #2a67d9;
      }

      .quick-scene-pill.highlight {
        background: #082846;
        color: #38c8ff;
      }

      .taxonomy-search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
        min-width: 260px;
      }

      .taxonomy-search-input {
        width: 100%;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 7px 12px 7px 32px;
        font-size: 12px;
        color: #0f172a;
        outline: none;
        transition: border-color 0.15s ease;
      }

      .taxonomy-search-input:focus {
        border-color: #2a67d9;
        background: #ffffff;
      }

      .taxonomy-search-icon {
        position: absolute;
        left: 10px;
        font-size: 12px;
        color: #94a3b8;
        pointer-events: none;
      }

      .taxonomy-status-badge {
        font-family: var(--nexa-font-family-mono, monospace);
        font-size: 11px;
        font-weight: 700;
        color: #0369a1;
        background: #e0f2fe;
        padding: 4px 10px;
        border-radius: 6px;
      }

      /* Scene Card Taxonomy Badges */
      .scene-taxonomy-badges {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 8px;
      }

      .tax-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      .tax-tag-screen {
        background: #082846;
        color: #38c8ff;
        font-family: var(--nexa-font-family-mono, monospace);
      }

      .tax-tag-site {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
      }

      .tax-tag-func {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
      }

      .tax-tag-frames {
        background: #fefce8;
        color: #a16207;
        border: 1px solid #fef08a;
        font-family: var(--nexa-font-family-mono, monospace);
      }

      /* Transitions & Spotlight states */
      .scene-card {
        transition: opacity 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
      }

      .scene-card.filtered-out {
        display: none !important;
      }

      .scene-card.spotlight {
        outline: 3px solid #2a67d9;
        box-shadow: 0 12px 32px rgba(42, 103, 217, 0.25);
      }

      /* Forensic Deep Dive Highlight */
      body.mode-forensics .forensic-table-wrapper {
        border: 2px solid #2a67d9 !important;
        box-shadow: 0 0 0 3px rgba(42, 103, 217, 0.15);
      }

      /* Scene Stations Cards */
      .scenes-stack {
        display: flex;
        flex-direction: column;
        gap: 3rem;
      }

      .scene-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
        position: relative;
        overflow: hidden;
      }

      .scene-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        gap: 16px;
        flex-wrap: wrap;
      }

      .scene-title-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .scene-kicker {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--nexa-font-family-mono, monospace);
        font-size: 11px;
        font-weight: 700;
        color: #2a67d9;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .scene-title {
        font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
        font-size: 1.6rem;
        font-weight: 800;
        color: #082846;
        letter-spacing: -0.02em;
      }

      .scene-provenance-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        padding: 5px 10px;
        border-radius: 8px;
        font-family: var(--nexa-font-family-mono, monospace);
        font-size: 10.5px;
        color: #475569;
      }

      /* Two Column Split: Left Specs, Right Interactive Simulator */
      .scene-layout-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 2rem;
        align-items: start;
      }

      @media (max-width: 1024px) {
        .scene-layout-grid {
          grid-template-columns: 1fr;
        }
      }

      /* Specs Side */
      .specs-pane {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .forensic-table-wrapper {
        overflow-x: auto;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
      }

      .forensic-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        text-align: left;
      }

      .forensic-table th {
        background: #f8fafc;
        color: #475569;
        font-weight: 700;
        padding: 8px 12px;
        border-bottom: 1px solid #e2e8f0;
        font-family: var(--nexa-font-family-mono, monospace);
        font-size: 11px;
      }

      .forensic-table td {
        padding: 9px 12px;
        border-bottom: 1px solid #f1f5f9;
        color: #1e293b;
        vertical-align: top;
      }

      .forensic-table tr:last-child td {
        border-bottom: none;
      }

      .code-tag {
        font-family: var(--nexa-font-family-mono, monospace);
        font-size: 10.5px;
        background: #f1f5f9;
        padding: 2px 6px;
        border-radius: 4px;
        color: #0f172a;
      }

      .forensic-callout {
        background: #f8fafc;
        border-left: 3px solid #0284c7;
        padding: 12px 14px;
        border-radius: 0 10px 10px 0;
        font-size: 12.5px;
        line-height: 1.5;
        color: #334155;
      }

      .forensic-callout strong {
        color: #0f172a;
      }

      /* Simulator Visual Container */
      .simulator-pane {
        background: #082846;
        border-radius: 18px;
        padding: 1.5rem;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
        min-height: 380px;
        box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.4);
      }

      .simulator-pane.light-stage {
        background: #FDFAE7;
        color: #082846;
        border: 1px solid rgba(8, 40, 70, 0.15);
      }

      .simulator-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        padding-bottom: 10px;
      }

      .light-stage .simulator-top-bar {
        border-bottom-color: rgba(8, 40, 70, 0.15);
      }

      .sim-title {
        font-family: var(--nexa-font-family-mono, monospace);
        font-size: 11px;
        font-weight: 700;
        color: #38c8ff;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .light-stage .sim-title {
        color: #082846;
      }

      .sim-controls {
        display: flex;
        gap: 6px;
      }

      .sim-btn {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 10.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.12s ease;

        &:hover {
          background: rgba(56, 200, 255, 0.3);
          border-color: #38c8ff;
          color: #38c8ff;
        }
      }

      .light-stage .sim-btn {
        background: #082846;
        color: #ffffff;
        border-color: transparent;

        &:hover {
          background: #0e3d6b;
        }
      }

      .sim-canvas {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        min-height: 280px;
      }

      /* Live Trajectory Animation Simulator (Scene 1) */
      .anim-stage-container {
        width: 100%;
        height: 260px;
        position: relative;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        border: 1px dashed rgba(56, 200, 255, 0.3);
        overflow: hidden;
      }

      .trajectory-path-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      .moving-tile-box {
        position: absolute;
        width: 80px;
        height: 80px;
        background: #38c8ff;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #082846;
        font-weight: 800;
        font-size: 9.5px;
        line-height: 1.1;
        text-align: center;
        box-shadow: 0 8px 24px rgba(56, 200, 255, 0.4);
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .scrubber-panel {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        font-family: var(--nexa-font-family-mono, monospace);
      }

      .scrubber-slider {
        flex: 1;
        cursor: pointer;
        accent-color: #38c8ff;
      }

      /* Proof of auto-convergence banner */
      .convergence-seal {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #e0f2fe;
        border: 1px solid #bae6fd;
        padding: 14px 18px;
        border-radius: 14px;
        margin-top: 3rem;
      }

      .seal-icon {
        width: 36px;
        height: 36px;
        background: #2563eb;
        color: #ffffff;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 18px;
        flex-shrink: 0;
      }

      .seal-text {
        font-size: 12.5px;
        color: #1e3a8a;
        line-height: 1.5;
      }

      .seal-text strong {
        color: #1d4ed8;
        font-size: 13px;
        display: block;
      }
    </style>
  </head>

  <body>
    <UnifiedLabShell currentSection="flecto-forensic">
      <div class="forensic-page-container">
        
        <!-- Header -->
        <header class="forensic-header">
          <div class="forensic-badge-row">
            <span class="forensic-pill">
              <i class="pi pi-search" aria-hidden="true"></i>
              Forensic Video Analysis Pass 5
            </span>
            <span class="forensic-sub-pill">
              <i class="pi pi-check-circle" aria-hidden="true"></i>
              8 Scenes 100% Converged
            </span>
            <span class="forensic-sub-pill">
              <i class="pi pi-shield" aria-hidden="true"></i>
              0 Raster Gradients · 28px Conduits
            </span>
          </div>

          <h1 class="forensic-title">
            Flecto Frame-by-Frame Forensic Analysis & <span>Landing Architecture</span>
          </h1>

          <p class="forensic-desc">
            Microsecond-accurate photometric and geometric reconstruction of the 8 canonical scenes of the 
            award-winning Flecto website (Awwwards SOTD July 20, 2022). Decomposed at native 60.0 fps from 
            archival master footage (<code>elem-62bb3911cfdd5765825581.mp4</code> and <code>flecto-awwwards-original.mp4</code>), 
            and reconstructed using Nexafy solid parametric geometry.
          </p>

          <!-- Top Metrics Bar -->
          <div class="metrics-grid-bar" role="region" aria-label="Forensic metrics">
            <div class="metric-box">
              <span class="metric-num">60.0 fps</span>
              <span class="metric-label">Decomposition Rate</span>
            </div>
            <div class="metric-box accent-celeste">
              <span class="metric-num">984 Frames</span>
              <span class="metric-label">Hero Reference Extent</span>
            </div>
            <div class="metric-box accent-mint">
              <span class="metric-num">1.766 s</span>
              <span class="metric-label">Center Hold Duration</span>
            </div>
            <div class="metric-box accent-amber">
              <span class="metric-num">&Delta;x = -235px</span>
              <span class="metric-label">Sub-Pixel Lateral Shift</span>
            </div>
            <div class="metric-box">
              <span class="metric-num">26-Command</span>
              <span class="metric-label">Parametric SVG Topology</span>
            </div>
            <div class="metric-box accent-mint">
              <span class="metric-num">0 px</span>
              <span class="metric-label">Horizontal Overflow</span>
            </div>
          </div>

          <!-- Multi-Dimensional Taxonomy Controller (Por Pantalla, Por Sitio, Por Funcionalidad, y Fotograma por Fotograma) -->
          <section class="forensic-taxonomy-controller" aria-label="Controlador de taxonomía forense">
            <!-- Dimension 1: Main Perspective Modes -->
            <div class="taxonomy-main-modes" role="tablist" aria-label="Perspectivas de análisis">
              <button type="button" class="tax-mode-btn active" data-mode="all" role="tab" aria-selected="true">
                <i class="pi pi-th-large" aria-hidden="true"></i> Todas las Escenas (1-8)
              </button>
              <button type="button" class="tax-mode-btn" data-mode="screen" role="tab" aria-selected="false">
                <i class="pi pi-desktop" aria-hidden="true"></i> Por Pantalla
              </button>
              <button type="button" class="tax-mode-btn" data-mode="site" role="tab" aria-selected="false">
                <i class="pi pi-globe" aria-hidden="true"></i> Por Sitio / Dominio
              </button>
              <button type="button" class="tax-mode-btn" data-mode="func" role="tab" aria-selected="false">
                <i class="pi pi-cog" aria-hidden="true"></i> Por Funcionalidad
              </button>
              <button type="button" class="tax-mode-btn" data-mode="forensics" role="tab" aria-selected="false">
                <i class="pi pi-microchip" aria-hidden="true"></i> Fotograma por Fotograma (60fps)
              </button>
              <button type="button" class="tax-mode-btn" data-mode="interactive" role="tab" aria-selected="false">
                <i class="pi pi-play" aria-hidden="true"></i> Modo Interactivo
              </button>
            </div>

            <!-- Dimension 2: Sub-filters (Site & Functionality) -->
            <div class="taxonomy-filters-row">
              <div class="filter-group-box">
                <span class="filter-group-label">
                  <i class="pi pi-sitemap" aria-hidden="true"></i> Filtrar por Sitio / Dominio:
                </span>
                <div class="filter-chips-cluster" id="filter-site-chips">
                  <button type="button" class="filter-chip active" data-site="all">Todos</button>
                  <button type="button" class="filter-chip" data-site="landing">Landing & Brand</button>
