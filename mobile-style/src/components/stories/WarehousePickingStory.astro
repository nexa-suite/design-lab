    color: var(--nexa-color-text-secondary, #64748b);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    max-width: 900px;
  }

  .story-workbench-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
