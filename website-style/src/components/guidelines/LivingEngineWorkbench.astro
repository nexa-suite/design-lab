  /**
   * Smooth S-curve / Filleted Orthogonal Conduit Router
   */
  function routeConduit(p1: { x: number; y: number }, p2: { x: number; y: number }, radius: number = 20): string {
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;

    if (Math.abs(dy) < 2) {
      return `M ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} L ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
    }

    if (dx >= 24) {
      const midX = p1.x + dx / 2;
      const r = Math.min(radius, Math.abs(dx) / 2 - 2, Math.abs(dy) / 2 - 2);
      const signY = dy > 0 ? 1 : -1;

      return `M ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} ` +
             `L ${(midX - r).toFixed(1)} ${p1.y.toFixed(1)} ` +
             `Q ${midX.toFixed(1)} ${p1.y.toFixed(1)}, ${midX.toFixed(1)} ${(p1.y + signY * r).toFixed(1)} ` +
             `L ${midX.toFixed(1)} ${(p2.y - signY * r).toFixed(1)} ` +
             `Q ${midX.toFixed(1)} ${p2.y.toFixed(1)}, ${(midX + r).toFixed(1)} ${p2.y.toFixed(1)} ` +
             `L ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
    }

    const safeOffsetY = dy >= 0 ? 60 : -60;
    return `M ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} ` +
           `C ${(p1.x + 35).toFixed(1)} ${p1.y.toFixed(1)}, ${(p1.x + 35).toFixed(1)} ${(p1.y + safeOffsetY).toFixed(1)}, ${(p1.x + p2.x) / 2} ${(p1.y + safeOffsetY).toFixed(1)} ` +
           `C ${(p2.x - 35).toFixed(1)} ${(p1.y + safeOffsetY).toFixed(1)}, ${(p2.x - 35).toFixed(1)} ${p2.y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
  }

  /**
   * Recalculate all 7 vascular conduits dynamically in real time
   */
  function rerouteAll() {
    EDGES.forEach(edge => {
      const p1 = edge.getSourcePoint();
      const p2 = edge.getTargetPoint();
      const pathD = routeConduit(p1, p2, 20);
      const pathEl = document.getElementById(edge.pathId) as SVGPathElement | null;
      if (pathEl) {
        pathEl.setAttribute('d', pathD);
        pathEl.style.strokeDasharray = 'none';
        pathEl.style.strokeDashoffset = '0';
        pathEl.style.opacity = '1';
      }
    });

    checkCollisions();
  }

  /**
   * Collision detection check between blocks
   */
  function checkCollisions() {
    const ids = Object.keys(NODES);
    let collisionCount = 0;

    for (let i = 0; i < ids.length; i++) {
      for (let j = i + 1; j < ids.length; j++) {
        const a = NODES[ids[i]];
        const b = NODES[ids[j]];

        const overlapX = a.x < b.x + b.width - 6 && a.x + a.width - 6 > b.x;
        const overlapY = a.y < b.y + b.height - 6 && a.y + a.height - 6 > b.y;

        if (overlapX && overlapY) {
          collisionCount++;
        }
      }
    }

    const collisionPill = document.querySelector('.collision-pill');
    if (collisionPill) {
      if (collisionCount === 0) {
        collisionPill.innerHTML = '<i class="pi pi-check-circle" style="color: #0284c7;"></i> 0 Colisiones';
        collisionPill.classList.remove('has-collision');
      } else {
        collisionPill.innerHTML = `<i class="pi pi-exclamation-triangle" style="color: #ef4444;"></i> ${collisionCount} Solapamiento${collisionCount > 1 ? 's' : ''}`;
        collisionPill.classList.add('has-collision');
      }
    }
  }

  /**
   * Interactive Drag & Drop System
   */
  function setupDragAndDrop() {
    const stage = document.getElementById('circuit-stage');
    if (!stage) return;

    const dragHud = document.getElementById('workbench-drag-hud');
    const hudCoordsText = document.getElementById('hud-coords-text');
    const tickerMsg = document.getElementById('workbench-ticker-msg');

    Object.keys(NODES).forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;

      el.style.left = `${NODES[id].x}px`;
      el.style.top = `${NODES[id].y}px`;
      el.style.opacity = '1';
      el.style.transform = 'scale(1) translate(0, 0)';
      el.style.display = 'flex';
      el.style.visibility = 'visible';

      let isDragging = false;
      let dragOffset = { x: 0, y: 0 };

      el.addEventListener('pointerdown', (e: PointerEvent) => {
        if (isBuilding) return;
        isDragging = true;
        el.setPointerCapture(e.pointerId);

        const rect = el.getBoundingClientRect();
        dragOffset = {
          x: e.clientX - rect.left,
          y: e.clientY - rect.top
        };

        el.classList.add('is-dragging');
        if (dragHud) dragHud.style.display = 'flex';
        if (hudCoordsText) {
          hudCoordsText.textContent = `${NODES[id].name} · X: ${Math.round(NODES[id].x)}px · Y: ${Math.round(NODES[id].y)}px`;
        }
        e.preventDefault();
      });

      el.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDragging) return;

        const stageRect = stage.getBoundingClientRect();
        let newX = e.clientX - stageRect.left - dragOffset.x;
        let newY = e.clientY - stageRect.top - dragOffset.y;

        newX = Math.max(10, Math.min(stageRect.width - NODES[id].width - 10, newX));
        newY = Math.max(10, Math.min(stageRect.height - NODES[id].height - 10, newY));

        NODES[id].x = newX;
        NODES[id].y = newY;

        el.style.left = `${newX}px`;
        el.style.top = `${newY}px`;

        if (hudCoordsText) {
          hudCoordsText.textContent = `${NODES[id].name} · X: ${Math.round(newX)}px · Y: ${Math.round(newY)}px`;
        }

        rerouteAll();
      });

      const onPointerEnd = () => {
        if (!isDragging) return;
        isDragging = false;
        el.classList.remove('is-dragging');
        if (dragHud) dragHud.style.display = 'none';

        if (tickerMsg) {
          tickerMsg.textContent = `✦ Bloque [${NODES[id].name}] posicionado en (${Math.round(NODES[id].x)}, ${Math.round(NODES[id].y)}) · Conduits recalculados`;
        }
      };

      el.addEventListener('pointerup', onPointerEnd);
      el.addEventListener('pointercancel', onPointerEnd);
    });
  }

  /**
   * Animate Signal Pulses Flowing through Conduits (60 FPS)
   */
  function animateParticles() {
    EDGES.forEach(edge => {
      edge.pulseProgress += edge.pulseSpeed;
      if (edge.pulseProgress > 1) edge.pulseProgress = 0;

      const pathEl = document.getElementById(edge.pathId) as SVGPathElement | null;
      const particleEl = document.getElementById(edge.pulseId) as SVGCircleElement | null;

      if (pathEl && particleEl) {
        const len = pathEl.getTotalLength();
        if (len > 0) {
          const pt = pathEl.getPointAtLength(edge.pulseProgress * len);
          particleEl.setAttribute('cx', pt.x.toFixed(1));
          particleEl.setAttribute('cy', pt.y.toFixed(1));
        }
      }
    });

    requestAnimationFrame(animateParticles);
  }

  /**
   * Dynamic Assembly "Construir Motor (Build)"
   */
  function buildEngineAssembly() {
    if (isBuilding) return;
    isBuilding = true;

    // Switch to channels view if on another tab
    switchStageView('channels');

    const btnBuild = document.getElementById('btn-build-engine') as HTMLButtonElement | null;
    const tickerMsg = document.getElementById('workbench-ticker-msg');
    if (btnBuild) btnBuild.disabled = true;

    if (tickerMsg) {
      tickerMsg.textContent = '✦ Ensamblando motor gráfico Nexafy: Conectando terminales y estaciones...';
    }

    Object.keys(NODES).forEach((id, idx) => {
      const el = document.getElementById(id);
      if (el) {
        el.style.transition = 'all 0.35s cubic-bezier(0.16, 1, 0.3, 1)';
        el.style.opacity = '0.35';
        el.style.transform = `scale(0.9) translate(${(idx % 2 === 0 ? -16 : 16)}px, ${(idx % 3 === 0 ? -12 : 12)}px)`;
      }
    });

    const sequence = [
      { ids: ['circuit-hub'], delay: 100, msg: '✦ 1/5: Origen [Terminal Pesquero Callao] conectado' },
      { ids: ['circuit-center-hub'], delay: 400, msg: '✦ 2/5: Núcleo Bus [NEXA HUB Core] acoplado' },
      { ids: ['station-01-card'], delay: 750, msg: '✦ 3/5: Estación 01 [Despacho en Bahía · FEFO] acoplada' },
      { ids: ['station-02-card'], delay: 1100, msg: '✦ 4/5: Estación 02 [Telemetría Sensirion IoT · -18.2°C] sincronizada' },
      { ids: ['station-03-card', 'circuit-dest-hub'], delay: 1450, msg: '✦ 5/5: Estación 03 [Custodia Escrow 100%] y Red Mayorista enlazadas' },
    ];

    sequence.forEach(step => {
      setTimeout(() => {
        step.ids.forEach(id => {
          const el = document.getElementById(id);
          const target = INITIAL_POSITIONS[id];
          if (el && target) {
            NODES[id].x = target.x;
            NODES[id].y = target.y;
            el.style.transition = 'left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), top 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.4s ease, opacity 0.3s ease';
            el.style.left = `${target.x}px`;
            el.style.top = `${target.y}px`;
            el.style.transform = 'scale(1) translate(0, 0)';
            el.style.opacity = '1';
          }
        });
        rerouteAll();
        if (tickerMsg) tickerMsg.textContent = step.msg;
      }, step.delay);
    });

    setTimeout(() => {
      isBuilding = false;
      if (btnBuild) btnBuild.disabled = false;
      if (tickerMsg) {
        tickerMsg.textContent = '✦ Motor Gráfico Nexafy Construido y 100% Operativo · Arrastra cualquier bloque libremente';
      }
      Object.keys(NODES).forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.transition = 'none';
      });
    }, 1900);
  }

  /**
   * Apply Preset Positions Smoothly
   */
  function applyPreset(presetKey: string) {
    let preset = INITIAL_POSITIONS;
    if (presetKey === 'matrix') preset = PRESET_MATRIX;
    else if (presetKey === 'escrow') preset = PRESET_ESCROW;

    // Switch back to channels view if needed
    switchStageView('channels');

    Object.keys(preset).forEach(id => {
      const target = preset[id];
      const el = document.getElementById(id);
      if (el && target) {
        NODES[id].x = target.x;
        NODES[id].y = target.y;
        el.style.transition = 'left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), top 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)';
        el.style.left = `${target.x}px`;
        el.style.top = `${target.y}px`;
      }
    });

    rerouteAll();

    setTimeout(() => {
      Object.keys(NODES).forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.transition = 'none';
      });
    }, 500);

    const tickerMsg = document.getElementById('workbench-ticker-msg');
    if (tickerMsg) {
      tickerMsg.textContent = `✦ Preset [${presetKey.toUpperCase()}] aplicado con 0 colisiones`;
    }
  }

  /**
   * Switch between multi-segment views (Channels, Dock, Telemetry, Escrow)
   */
  function switchStageView(viewKey: string) {
    document.querySelectorAll('[data-view]').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.view === viewKey);
    });

    const views: Record<string, string> = {
      'channels': 'view-channels-stage',
      'dock': 'view-dock-stage',
      'telemetry': 'view-telemetry-stage',
      'escrow': 'view-escrow-stage'
    };

    Object.entries(views).forEach(([key, elementId]) => {
      const el = document.getElementById(elementId);
      if (el) {
        if (key === viewKey) {
          el.style.display = key === 'channels' ? 'block' : 'flex';
          el.classList.add('active');
        } else {
          el.style.display = 'none';
          el.classList.remove('active');
        }
      }
    });

    // Synchronize bottom-right logistics tracker steps
    const stepMap: Record<string, number> = {
      'channels': 1,
      'dock': 1,
      'telemetry': 2,
      'escrow': 3
    };
    if (stepMap[viewKey]) {
      updateTrackerActive(stepMap[viewKey]);
    }

    const tickerMsg = document.getElementById('workbench-ticker-msg');
    if (tickerMsg) {
      if (viewKey === 'channels') {
        tickerMsg.textContent = '✦ Vista [CANALES & BLOQUES] activa: Conductos vasculares en vivo · Arrastra cualquier bloque libremente';
        rerouteAll();
      } else if (viewKey === 'dock') {
        tickerMsg.textContent = '✦ Paso 01 · [MUELLE & ALMACÉN]: Báscula Toledo digital 500kg · Protocolo SANIPES 4.0 Conforme';
      } else if (viewKey === 'telemetry') {
        tickerMsg.textContent = '✦ Paso 02 · [TRÁNSITO & CONDUCTOR]: Sensirion SHT40 -18.2°C en ruta · Carrier 1550 OK · 0 quiebres térmicos';
      } else if (viewKey === 'escrow') {
        tickerMsg.textContent = '✦ Paso 03 · [ESCROW & COMPRADOR]: Bóveda multi-sig $3,450.00 USD pre-bloqueada · Oráculo IoT activo';
      }
    }
  }

  function updateTrackerActive(chapterNum: number) {
    const trackerSteps = document.querySelectorAll<HTMLButtonElement>('.tracker-step');
    const progressBar = document.querySelector<HTMLElement>('.tracker-progress-segment');
    trackerSteps.forEach(s => {
      const isCur = parseInt(s.dataset.chapter || '1', 10) === chapterNum;
      s.classList.toggle('active', isCur);
      s.setAttribute('aria-pressed', isCur ? 'true' : 'false');
    });
    if (progressBar) {
      const widthMap: Record<number, string> = { 1: '33.33%', 2: '66.66%', 3: '100%' };
      progressBar.style.width = widthMap[chapterNum] || '33.33%';
    }
  }

