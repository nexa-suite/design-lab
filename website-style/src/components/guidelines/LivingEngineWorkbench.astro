  .station-meta {
    color: #64748b;
    font-weight: 500;
  }

  .station-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2563eb;
    box-shadow: 0 0 6px #2563eb;
  }

  /* --------------------------------------------------------------------------
     2.4 BOTTOM LAYER (NOTCHES & TICKER)
     -------------------------------------------------------------------------- */
  .hero-bottom-layer {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 80px 1fr 410px;
    align-items: flex-end;
    width: 100%;
    min-height: 85px;
    padding-bottom: 0.5rem;
  }

  /* Bottom-Left White Notch: Pure Transparent (Zero Spikes!) */
  .hero-bottom-left {
    display: flex;
    align-items: center;
    padding-left: 0.5rem;
    padding-bottom: 0.5rem;
    background: transparent;
  }

  .hero-down-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #f1f5f9;
    color: #082846;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hero-down-circle:hover {
    background: #38bdf8;
    transform: translateY(2px);
  }

  .hero-bottom-center {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-bottom: 0.85rem;
  }

  .hero-guarantee-text {
    font-size: 0.8125rem;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ticker-prefix {
    color: #38bdf8;
    font-weight: 800;
    font-size: 10px;
    background: rgba(56, 189, 248, 0.15);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Bottom-Right White Notch: Pure Transparent (Zero Spikes!) */
  .hero-bottom-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    padding-right: 0.75rem;
    padding-bottom: 0.5rem;
    background: transparent;
  }

  .hero-chapter-tracker {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .tracker-track-line {
    width: 100%;
    height: 3px;
    background: #e2e8f0;
    border-radius: 2px;
    overflow: hidden;
  }

  .tracker-progress-segment {
    display: block;
    height: 100%;
    width: 33.33%;
    background: #2563eb;
    box-shadow: 0 0 8px rgba(37, 99, 235, 0.5);
    transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tracker-steps-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tracker-step {
    background: none;
