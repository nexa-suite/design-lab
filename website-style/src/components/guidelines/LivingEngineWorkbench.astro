    if (!modal) return;

    openBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      modal.style.display = 'flex';
    });

    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      modal.style.display = 'none';
