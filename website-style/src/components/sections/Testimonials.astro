---
// Rental Businesses Vertical Phone Cascade
// Evidence: Bürocratik Awwwards SOTD (Scene 8, t=45-50s)
// Obsidian green #052018 backdrop with vertical smartphone cascades highlighting core verticals
---

<section class="rental-verticals-section" id="verticals" aria-labelledby="verticals-heading">
  <div class="verticals-container">
    
    <div class="verticals-header">
      <div class="verticals-tag text-eyebrow">
        <span>A New Generation</span>
        <span class="tag-sep" aria-hidden="true">—</span>
        <span>Rental Businesses</span>
      </div>

      <h2 id="verticals-heading" class="verticals-title">
        This is the new generation of <br />
        <span class="text-mint">rental businesses</span>. Get to know them.
      </h2>
      
      <p class="verticals-lead">
        From local photography stores to nationwide mobility fleets, forward-thinking operators power their entire rental lifecycle with Flecto.
      </p>
    </div>

    <!-- 4-Column Vertical Smartphone Cascade Grid -->
    <div class="verticals-grid">
      
      <!-- Vertical 1: Cameras & Cinematography -->
      <article class="vertical-column">
        <div class="vertical-phone-mockup">
          <div class="vphone-chassis">
            <div class="vphone-speaker" aria-hidden="true"></div>
            <div class="vphone-screen">
              <div class="vphone-header">
                <span class="vphone-time">9:41</span>
                <span class="vphone-battery" aria-hidden="true"></span>
              </div>
              <div class="vphone-hero-img">
                <img src="/assets/synthetic/camera-vector.svg" alt="Canon EOS R5" width="80" height="70" />
              </div>
              <div class="vphone-body">
                <span class="vphone-tag">Photography</span>
                <h3 class="vphone-item-name">Canon EOS R5</h3>
                <p class="vphone-operator">Colorfoto Porto</p>
                <div class="vphone-price-row">
                  <span class="vphone-price">€65<small>/day</small></span>
                  <span class="vphone-status-pill available">Available</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="vertical-meta">
          <strong class="vmeta-category">Audiovisual & Cameras</strong>
          <p class="vmeta-desc">High-end cinematography packages with pre-authorized escrow deposits.</p>
        </div>
      </article>

      <!-- Vertical 2: Micro-Mobility & Urban Travel -->
      <article class="vertical-column column-offset-1">
        <div class="vertical-phone-mockup">
          <div class="vphone-chassis">
            <div class="vphone-speaker" aria-hidden="true"></div>
            <div class="vphone-screen">
              <div class="vphone-header">
                <span class="vphone-time">9:41</span>
                <span class="vphone-battery" aria-hidden="true"></span>
              </div>
              <div class="vphone-hero-img">
                <svg width="76" height="64" viewBox="0 0 24 24" fill="none" stroke="#57f09e" stroke-width="1.8">
                  <circle cx="5.5" cy="17.5" r="3.5"/>
                  <circle cx="18.5" cy="17.5" r="3.5"/>
                  <path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5L8.5 9 12 7l3.5 2.5L12 17.5z"/>
                </svg>
              </div>
              <div class="vphone-body">
                <span class="vphone-tag">Mobility</span>
                <h3 class="vphone-item-name">VanMoof S3 E-Bike</h3>
                <p class="vphone-operator">Volt Fleet Lisbon</p>
                <div class="vphone-price-row">
                  <span class="vphone-price">€25<small>/day</small></span>
                  <span class="vphone-status-pill available">Available</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="vertical-meta">
          <strong class="vmeta-category">Micro-Mobility</strong>
          <p class="vmeta-desc">Automated counter checkouts and fleet damage protection in minutes.</p>
        </div>
      </article>

      <!-- Vertical 3: Tech & Creator Gear -->
      <article class="vertical-column">
        <div class="vertical-phone-mockup">
          <div class="vphone-chassis">
            <div class="vphone-speaker" aria-hidden="true"></div>
            <div class="vphone-screen">
              <div class="vphone-header">
                <span class="vphone-time">9:41</span>
                <span class="vphone-battery" aria-hidden="true"></span>
              </div>
              <div class="vphone-hero-img">
                <svg width="76" height="64" viewBox="0 0 24 24" fill="none" stroke="#57f09e" stroke-width="1.8">
                  <rect x="2" y="3" width="20" height="14" rx="2"/>
                  <line x1="1" y1="20" x2="23" y2="20"/>
                </svg>
              </div>
              <div class="vphone-body">
                <span class="vphone-tag">Computing</span>
                <h3 class="vphone-item-name">MacBook Pro 16"</h3>
                <p class="vphone-operator">CineGear Labs</p>
                <div class="vphone-price-row">
                  <span class="vphone-price">€45<small>/day</small></span>
                  <span class="vphone-status-pill rented">Rented</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="vertical-meta">
          <strong class="vmeta-category">Computing & IT</strong>
          <p class="vmeta-desc">Hardware-as-a-service with automated periodic billing schedules.</p>
        </div>
      </article>

      <!-- Vertical 4: Outdoor & Expeditions -->
      <article class="vertical-column column-offset-1">
        <div class="vertical-phone-mockup">
          <div class="vphone-chassis">
            <div class="vphone-speaker" aria-hidden="true"></div>
            <div class="vphone-screen">
              <div class="vphone-header">
                <span class="vphone-time">9:41</span>
                <span class="vphone-battery" aria-hidden="true"></span>
              </div>
              <div class="vphone-hero-img">
                <svg width="76" height="64" viewBox="0 0 24 24" fill="none" stroke="#57f09e" stroke-width="1.8">
                  <polygon points="12 2 2 22 22 22"/>
                  <line x1="12" y1="12" x2="12" y2="22"/>
                </svg>
              </div>
              <div class="vphone-body">
                <span class="vphone-tag">Adventure</span>
                <h3 class="vphone-item-name">Nordic Expedition Tent</h3>
                <p class="vphone-operator">Oslo Trail Rentals</p>
                <div class="vphone-price-row">
                  <span class="vphone-price">€30<small>/day</small></span>
                  <span class="vphone-status-pill available">Available</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="vertical-meta">
          <strong class="vmeta-category">Outdoor Expeditions</strong>
          <p class="vmeta-desc">Seasonal equipment utilization with built-in comprehensive insurance.</p>
        </div>
      </article>

    </div>

  </div>
</section>

<style>
  .rental-verticals-section {
    padding: 7rem 0 8rem 0;
    background-color: #052018; /* Forensic obsidian green backdrop */
    color: #e6edea;
    border-top: 1px solid rgba(87, 240, 158, 0.08);
    position: relative;
    overflow: hidden;
  }

  .verticals-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .verticals-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 820px;
  }

  .verticals-tag {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #57f09e;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .verticals-title {
    color: #ffffff;
    font-size: 2.75rem;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .text-mint {
    color: #57f09e;
  }

  .verticals-lead {
    font-size: 1.125rem;
    line-height: 1.5;
    color: #8fa89e;
    margin: 0;
  }

  /* Grid of 4 Vertical Phone Columns */
  .verticals-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .vertical-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .column-offset-1 {
    transform: translateY(2rem);
  }

  .vertical-phone-mockup {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 36px;
    padding: 1rem;
    border: 1px solid rgba(87, 240, 158, 0.12);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .vertical-phone-mockup:hover {
    transform: translateY(-6px);
    border-color: rgba(87, 240, 158, 0.35);
  }

  .vphone-chassis {
    background-color: #01150f;
    border-radius: 28px;
    padding: 0.75rem;
    position: relative;
    border: 1.5px solid rgba(255, 255, 255, 0.06);
  }

  .vphone-speaker {
    width: 32px;
    height: 3px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    margin: 0 auto 0.6rem auto;
  }

  .vphone-screen {
    background-color: #002b21;
    border-radius: 20px;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .vphone-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.6875rem;
    color: #8fa89e;
  }

  .vphone-battery {
    width: 14px;
    height: 7px;
    border: 1px solid #8fa89e;
    border-radius: 2px;
  }

  .vphone-hero-img {
    height: 100px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vphone-hero-img img {
    max-height: 70px;
    object-fit: contain;
  }

  .vphone-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .vphone-tag {
    font-size: 0.625rem;
    font-weight: 700;
    color: #57f09e;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .vphone-item-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .vphone-operator {
    font-size: 0.75rem;
    color: #8fa89e;
    margin: 0;
  }

  .vphone-price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .vphone-price {
    font-family: var(--primitive-font-mono, monospace);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #57f09e;
  }

  .vphone-price small {
    font-size: 0.6875rem;
    color: #8fa89e;
    font-weight: 400;
  }

  .vphone-status-pill {
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .vphone-status-pill.available {
    background: rgba(87, 240, 158, 0.2);
    color: #57f09e;
  }

  .vphone-status-pill.rented {
    background: rgba(247, 185, 40, 0.2);
    color: #f7b928;
  }

  .vertical-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0 0.5rem;
  }

  .vmeta-category {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
  }

  .vmeta-desc {
    font-size: 0.8125rem;
    color: #8fa89e;
    line-height: 1.4;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .verticals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .column-offset-1 {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .verticals-grid {
      grid-template-columns: 1fr;
    }
    .verticals-title {
      font-size: 2rem;
    }
  }
</style>
