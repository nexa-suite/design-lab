---
/**
 * TipografiaSpSection.astro
 * Canonical Typography in Scale-Independent Pixels (sp) for Android
 */
---

<div class="tipografia-sp-container" data-platform-target="universal">
  <section class="spec-card">
    <div class="card-header-row">
      <div class="card-badge-icon"><i class="pi pi-align-left"></i></div>
      <div>
        <span class="card-eyebrow">FUNDAMENTOS M3 · TIPOGRAFÍA ESCALAR</span>
        <h3 class="card-title">Escala Tipográfica en Unidades Escalares (sp)</h3>
      </div>
    </div>
    <p class="card-text">
      Todo texto móvil en Nexa se define estrictamente en <strong>Scale-independent Pixels (sp)</strong> para Jetpack Compose. Esto garantiza accesibilidad y resiliencia ante usuarios que configuran fuentes ampliadas (hasta un 200%) en los ajustes de accesibilidad de Android.
    </p>

    <!-- Typography Metrics Table -->
    <div class="table-responsive-wrapper">
      <table class="metrics-table">
        <thead>
          <tr>
            <th>Rol Tipográfico</th>
            <th>Tamaño (sp)</th>
            <th>Interlineado</th>
            <th>Peso</th>
            <th>Fuente</th>
            <th>Uso Canónico en Móvil</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>displayLarge</code></td>
            <td><span class="code-pill">32sp</span></td>
            <td>40sp</td>
            <td>800 (Extrabold)</td>
            <td>Plus Jakarta Sans</td>
            <td>KPIs numéricos de bodega y totales de despacho</td>
          </tr>
          <tr>
            <td><code>headlineMedium</code></td>
            <td><span class="code-pill">24sp</span></td>
            <td>32sp</td>
            <td>700 (Bold)</td>
            <td>Plus Jakarta Sans</td>
            <td>Títulos principales de pantalla y TopAppBar</td>
          </tr>
          <tr>
            <td><code>titleMedium</code></td>
            <td><span class="code-pill">16sp</span></td>
            <td>24sp</td>
            <td>600 (SemiBold)</td>
            <td>Inter</td>
            <td>Cabeceras de tarjetas de despacho, clientes y paradas</td>
          </tr>
          <tr>
            <td><code>bodyLarge</code></td>
            <td><span class="code-pill">15sp</span></td>
            <td>22sp</td>
            <td>400 (Regular)</td>
            <td>Inter</td>
            <td>Textos de lectura principal, descripciones de ruta</td>
          </tr>
          <tr>
            <td><code>bodyMedium</code></td>
            <td><span class="code-pill">13.5sp</span></td>
            <td>20sp</td>
            <td>400 (Regular)</td>
            <td>Inter</td>
            <td>Subtextos de guía, direcciones y notas de campo</td>
          </tr>
          <tr>
            <td><code>labelSmall</code></td>
            <td><span class="code-pill">11sp</span></td>
            <td>16sp</td>
            <td>700 (Bold)</td>
            <td>Inter</td>
            <td>Chips de estado (EN TURNO, ENTREGADO), badges M3</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 2: Live Type Specimens Preview -->
  <section class="spec-card">
    <div class="card-header-row">
      <div class="card-badge-icon preview-badge"><i class="pi pi-eye"></i></div>
      <div>
        <span class="card-eyebrow">EVIDENCIA VISUAL EN VIVO</span>
        <h3 class="card-title">Muestrario de Jerarquía Visual en Dispositivo</h3>
      </div>
    </div>

    <div class="type-specimen-grid">
      <div class="specimen-card">
        <span class="specimen-role">DISPLAY LARGE · 32sp</span>
        <h1 class="sample-display">$4,820,000 COP</h1>
        <small>Total valorizado en ruta activa</small>
      </div>

      <div class="specimen-card">
        <span class="specimen-role">HEADLINE MEDIUM · 24sp</span>
        <h2 class="sample-headline">Constructora Bolívar S.A.</h2>
        <small>Destinatario de orden de despacho</small>
      </div>

      <div class="specimen-card">
        <span class="specimen-role">TITLE MEDIUM · 16sp</span>
        <h3 class="sample-title">Generador Diésel Cummins 250 kVA</h3>
        <small>Ítem individual en lista de picking</small>
      </div>

      <div class="specimen-card">
        <span class="specimen-role">BODY LARGE · 15sp</span>
        <p class="sample-body">
          Entrega programada en muelle principal norte. Requiere montacargas de 5 toneladas y operador certificado.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 3: Kotlin Compose Type.kt Contract -->
  <section class="spec-card">
    <div class="card-header-row">
      <div class="card-badge-icon code-badge"><i class="pi pi-code"></i></div>
      <div>
        <span class="card-eyebrow">IMPLEMENTACIÓN NATIVA · JETPACK COMPOSE</span>
        <h3 class="card-title">Contrato de Tipografía Kotlin (:core:designsystem)</h3>
      </div>
    </div>

    <div class="code-preview-block">
      <pre is:raw><code>// core/designsystem/src/main/kotlin/com/nexa/core/designsystem/theme/Type.kt
package com.nexa.core.designsystem.theme

import androidx.compose.material3.Typography
import androidx.compose.ui.text.TextStyle
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.sp

val NexaTypography = Typography(
    displayLarge = TextStyle(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.ExtraBold,
        fontSize = 32.sp,
        lineHeight = 40.sp
    ),
    headlineMedium = TextStyle(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Bold,
        fontSize = 24.sp,
        lineHeight = 32.sp
    ),
    titleMedium = TextStyle(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.SemiBold,
        fontSize = 16.sp,
        lineHeight = 24.sp
    ),
    bodyLarge = TextStyle(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Normal,
        fontSize = 15.sp,
        lineHeight = 22.sp
    ),
    labelSmall = TextStyle(
        fontFamily = FontFamily.SansSerif,
        fontWeight = FontWeight.Bold,
        fontSize = 11.sp,
        lineHeight = 16.sp
    )
)</code></pre>
    </div>
  </section>
</div>

<style>
  .tipografia-sp-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .spec-card {
    background: var(--nexa-surface-card, #ffffff);
    border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    border-radius: var(--nexa-radius-card, 16px);
    padding: 24px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-header-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-badge-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--nexa-color-primary-50, #eff6ff);
    color: var(--nexa-color-primary-600, #2a67d9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    flex-shrink: 0;

    &.preview-badge {
      background: #f0fdf4;
      color: #16a34a;
    }
    &.code-badge {
      background: #f1f5f9;
      color: #0f172a;
    }
  }

  .card-eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--nexa-color-primary-700, #1d4ed8);
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .card-title {
    font-family: var(--nexa-font-family-display, sans-serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--nexa-color-text-primary, #0f172a);
    margin: 0;
  }

  .card-text {
    font-size: 13.5px;
    color: var(--nexa-color-text-secondary, #64748b);
    line-height: 1.6;
    margin: 0;
  }

  .table-responsive-wrapper {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--nexa-color-border-subtle, #e2e8f0);
    border-radius: 12px;
  }

  .metrics-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    text-align: left;

    th {
      background: var(--nexa-color-neutral-50, #f8fafc);
      padding: 10px 14px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--nexa-color-neutral-600, #475569);
      border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      color: var(--nexa-color-text-secondary, #64748b);
    }

    tr:last-child td {
      border-bottom: 0;
    }
  }

  .code-pill {
    display: inline-block;
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 11px;
    font-weight: 700;
    color: var(--nexa-color-primary-700, #1d4ed8);
    background: var(--nexa-color-primary-50, #eff6ff);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .type-specimen-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .type-specimen-grid {
      grid-template-columns: 1fr;
    }
  }

  .specimen-card {
    padding: 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;

    small {
      color: #64748b;
      font-size: 11px;
    }
  }

  .specimen-role {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--nexa-color-primary-700, #1d4ed8);
    text-transform: uppercase;
  }

  .sample-display {
    font-size: 32px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin: 0;
  }

  .sample-headline {
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
    margin: 0;
  }

  .sample-title {
    font-size: 16px;
    font-weight: 600;
    color: #0f172a;
    margin: 0;
  }

  .sample-body {
    font-size: 15px;
    color: #334155;
    line-height: 1.5;
    margin: 0;
  }

  .code-preview-block {
    background: #0f172a;
    border-radius: 12px;
    padding: 18px;
    overflow-x: auto;

    pre { margin: 0; }
    code {
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 12px;
      color: #e2e8f0;
      line-height: 1.6;
    }
  }
</style>
