---

<div class="tokens-color-container" data-platform-target="universal">
  <!-- Section 1: Escala Visual de Swatches Material 3 -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">01</span>
        <div>
          <p class="cuadro-kicker">MATERIAL DESIGN 3 · ESCALA VISUAL DE SWATCHES</p>
          <h3 class="cuadro-title">Paleta Tonal Dinámica M3 & Verificación de Contraste</h3>
          <p class="cuadro-subtitle">
            Cada tarjeta muestra la previsualización visual del rol, su contraste verificado bajo <strong>WCAG 2.2 AA/AAA</strong>, valores Hex para modo Claro/Oscuro y su función canónica en la suite móvil <strong>Android Jetpack Compose</strong>.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag primary"><i class="pi pi-shield"></i> WCAG 2.2 AA/AAA</span>
        <span class="cuadro-tag kotlin"><i class="pi pi-android"></i> M3 ColorScheme</span>
        <span class="cuadro-tag success"><i class="pi pi-check"></i> 100% Contraste Verificado</span>
      </div>
    </div>

    <!-- Grid de Swatches Visuales Ricos (Igual que web-style blue-scale) -->
    <div class="m3-visual-scale-grid">
      {m3PrimaryTokens.map((token) => (
        <article class="m3-token-card">
          <div class="m3-swatch-box" style={`background: ${token.bgHex}; color: ${token.fgHex};`}>
            <div class="swatch-top-meta">
              <span class="swatch-role-tag">{token.name}</span>
              <span class="swatch-pass-tag">{token.passLevel}</span>
            </div>
            <div class="swatch-bottom-hex">
              <strong>{token.lightHex}</strong>
              <small>{token.ratio}</small>
            </div>
          </div>
          <div class="m3-token-body">
            <div class="token-title-row">
              <strong>{token.name}</strong>
              <code class="token-code">{token.token}</code>
            </div>
            <div class="hex-chips-row">
              <span class="hex-chip light"><i class="pi pi-sun"></i> {token.lightHex}</span>
              <span class="hex-chip dark"><i class="pi pi-moon"></i> {token.darkHex}</span>
            </div>
            <p class="token-usage-desc">{token.usage}</p>
            <div class="foreground-pair-badge">
              <span class="pair-label">Pareja:</span>
              <span class="pair-value">{token.foreground}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Section 2: Neutral Ramp (Rampa Neutral Slate 50 → 950) -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">02</span>
        <div>
          <p class="cuadro-kicker">JERARQUÍA DE LECTURA · RAMPA NEUTRAL</p>
          <h3 class="cuadro-title">Escala Tonal de Slate (50 a 950) para Superficies y Textos</h3>
          <p class="cuadro-subtitle">
            Los valores neutrales se proyectan visualmente como superficies, bordes de separación y niveles de opacidad de texto, garantizando contraste continuo bajo cualquier condición de iluminación.
          </p>
        </div>
      </div>
    </div>

    <div class="neutral-ramp-grid">
      {neutralScale.map((t) => (
        <article class="neutral-tile">
          <div 
            class="neutral-tile-swatch" 
            style={`background: ${t.hex}; border: ${t.hex === '#F8FAFC' || t.hex === '#F1F5F9' ? '1px solid #CBD5E1' : 'none'};`}
          >
            <span class={`tile-hex ${t.textLight ? 'light-text' : 'dark-text'}`}>{t.hex}</span>
          </div>
          <strong>{t.name}</strong>
          <code>{t.hex}</code>
          <p>{t.role}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Section 3: Semantic Families (Familias Semánticas Operativas) -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">03</span>
        <div>
          <p class="cuadro-kicker">SEMÁNTICA OPERATIVA · CADENA DE FRÍO & TELEMETRÍA</p>
          <h3 class="cuadro-title">Familias Semánticas (Icono + Superficie + Borde + Tipografía)</h3>
          <p class="cuadro-subtitle">
            El color nunca viaja solo: cada estado operativo combina un icono canónico, superficie tintada, borde delimitador y etiqueta explícita para evitar errores de interpretación por daltonismo.
          </p>
        </div>
      </div>
    </div>

    <div class="semantic-families-grid">
      {semanticFamilies.map((fam) => (
        <article 
          class="semantic-family-card" 
          style={`--fam-surface: ${fam.surface}; --fam-border: ${fam.border}; --fam-foreground: ${fam.foreground};`}
        >
          <div class="fam-preview-box">
            <div class="fam-icon-circle">
              <i class={`pi ${fam.icon}`}></i>
            </div>
            <div class="fam-text-block">
              <span class="fam-chip">{fam.example}</span>
              <small class="fam-note">{fam.note}</small>
            </div>
          </div>
          <h4 class="fam-title">{fam.name}</h4>
          <div class="fam-contract-breakdown">
            <div class="fam-contract-item">
              <span>Superficie</span>
              <code>{fam.surface}</code>
            </div>
            <div class="fam-contract-item">
              <span>Borde</span>
              <code>{fam.border}</code>
            </div>
            <div class="fam-contract-item">
              <span>Texto / Glifo</span>
              <code>{fam.foreground}</code>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Section 4: Semantic Map (Un Significado, Múltiples Pistas Visuales) -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">04</span>
        <div>
          <p class="cuadro-kicker">CÓDIGO DE SEÑALÉTICA · MAPA SEMÁNTICO</p>
          <h3 class="cuadro-title">Señalética de Estados Operativos en Tiempo Real</h3>
          <p class="cuadro-subtitle">
            Patrón multisensorial: superficie cromática + glifo universal + etiqueta textual inconfundible.
          </p>
        </div>
      </div>
    </div>

    <div class="semantic-cue-grid">
      <div class="semantic-cue-card success">
        <div class="cue-icon success"><i class="pi pi-check"></i></div>
        <div class="cue-meta">
          <strong>Entrega Conforme (POD Firmado)</strong>
          <small>Verificación fotográfica CameraX aprobada sin anomalías</small>
        </div>
      </div>
      <div class="semantic-cue-card warning">
        <div class="cue-icon warning"><i class="pi pi-clock"></i></div>
        <div class="cue-meta">
          <strong>En Tránsito / Cola Offline</strong>
          <small>Sincronización en segundo plano con WorkManager pendiente</small>
        </div>
      </div>
      <div class="semantic-cue-card danger">
        <div class="cue-icon danger"><i class="pi pi-ban"></i></div>
        <div class="cue-meta">
          <strong>Cadena Rota / Rechazo Crítico</strong>
          <small>Temperatura mayor a 6.0°C o daño de sellos de seguridad</small>
        </div>
      </div>
      <div class="semantic-cue-card info">
        <div class="cue-icon info"><i class="pi pi-compass"></i></div>
        <div class="cue-meta">
          <strong>Geocerca Activada (50m Muelle)</strong>
          <small>Detección GPS pasiva y habilitación de botón de arribo</small>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Jerarquía de Superficies M3 (Surface Containers) -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">05</span>
        <div>
          <p class="cuadro-kicker">SUPERFICIES DINÁMICAS · ESCALA TONAL M3</p>
          <h3 class="cuadro-title">Escala de Contenedores de Superficie (SurfaceContainer Lowest → Highest)</h3>
          <p class="cuadro-subtitle">
            Material 3 elimina las sombras difusas estáticas en favor de la familia <code>surfaceContainer*</code>, garantizando legibilidad en pantallas AMOLED bajo iluminación exterior (&gt;50,000 lux) y terminales rugerizadas Zebra/Honeywell.
          </p>
        </div>
      </div>
    </div>

    <!-- Visual Container Spectrum -->
    <div class="surface-scale-grid">
      <div class="surface-box surface-lowest">
        <span class="box-label">Lowest</span>
        <strong>#FFFFFF</strong>
        <p>Tarjetas elevadas sobre página, menús contextuales</p>
      </div>
      <div class="surface-box surface-low">
        <span class="box-label">Low</span>
        <strong>#F8FAFC</strong>
        <p>Agrupadores de formularios de despacho, checklist</p>
      </div>
      <div class="surface-box surface-default">
        <span class="box-label">Container</span>
        <strong>#F1F5F9</strong>
        <p>Contenedor estándar de tarjetas en LazyColumn</p>
      </div>
      <div class="surface-box surface-high">
        <span class="box-label">High</span>
        <strong>#E2E8F0</strong>
        <p>Diálogos modales, date pickers, selector de muelles</p>
      </div>
      <div class="surface-box surface-highest">
        <span class="box-label">Highest</span>
        <strong>#CBD5E1</strong>
        <p>Arrastre de BottomSheet, estados activos de fondo</p>
      </div>
    </div>

    <!-- CUADRO ARQUITECTÓNICO: Contratos de Superficie -->
    <div class="contract-table-wrapper">
      <table class="contract-table">
        <thead>
          <tr>
            <th>Rol de Superficie</th>
            <th>Nivel Tonal</th>
            <th>Hex Claro</th>
            <th>Hex Oscuro</th>
            <th>Elevación Recomendada</th>
            <th>Función en Pantallas Móviles</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>surface</code></td>
            <td>Base 98</td>
            <td><code>#F6FAFF</code></td>
            <td><code>#090E17</code></td>
            <td>0dp</td>
            <td>Fondo estructural del Scaffold general en Android</td>
          </tr>
          <tr>
            <td><code>surfaceContainerLowest</code></td>
            <td>Base 100</td>
            <td><code>#FFFFFF</code></td>
            <td><code>#0F172A</code></td>
            <td>0dp – 1dp</td>
            <td>Tarjetas de paradas de despacho SO-2026-0018 con fondo blanco puro</td>
          </tr>
          <tr>
            <td><code>surfaceContainerLow</code></td>
            <td>Base 96</td>
            <td><code>#F8FAFC</code></td>
            <td><code>#111A29</code></td>
            <td>1dp</td>
            <td>Bloques de verificación de items de picking DSP-204</td>
          </tr>
          <tr>
            <td><code>surfaceContainer</code></td>
            <td>Base 94</td>
            <td><code>#F1F5F9</code></td>
            <td><code>#162235</code></td>
            <td>1dp – 2dp</td>
            <td>Contenedor base para listas verticales de maquinaria MT-042</td>
          </tr>
          <tr>
            <td><code>surfaceContainerHigh</code></td>
            <td>Base 92</td>
            <td><code>#E2E8F0</code></td>
            <td><code>#1E293B</code></td>
            <td>3dp</td>
            <td>Barra de herramientas fija TopAppBar y BottomNavigation</td>
          </tr>
          <tr>
            <td><code>surfaceContainerHighest</code></td>
            <td>Base 90</td>
            <td><code>#CBD5E1</code></td>
            <td><code>#334155</code></td>
            <td>4dp – 6dp</td>
            <td>Modal Bottom Sheet de firma de recepción POD y campos deshabilitados</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 6: Cuadro de Contratos Técnicos de Colorimetría -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">06</span>
        <div>
          <p class="cuadro-kicker">ESPECIFICACIÓN COMPLETA · CONTRATOS DE COLOR</p>
          <h3 class="cuadro-title">Matriz Arquitectónica de Tokens M3 para Android</h3>
          <p class="cuadro-subtitle">
            Tabla de referencia exhaustiva para desarrolladores Kotlin Compose con asignación directa de tokens y validación de contraste accesible.
          </p>
        </div>
      </div>
    </div>

    <div class="contract-table-wrapper">
      <table class="contract-table">
        <thead>
          <tr>
            <th>Rol Material 3</th>
            <th>Token CSS / Compose</th>
            <th>Hex Claro</th>
            <th>Hex Oscuro</th>
            <th>Ratio Contraste</th>
            <th>Uso Canónico en Móvil</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Primary</strong></td>
            <td><code class="mono-chip">NexaPrimary</code></td>
            <td><span class="color-dot" style="background:#2a67d9"></span> <code>#2A67D9</code></td>
            <td><code>#AEC6FF</code></td>
            <td><strong class="ratio-pass">5.2:1 (PASS)</strong></td>
            <td>Botones CTA primarios, TopAppBar tint, FAB flotante</td>
          </tr>
          <tr>
            <td><strong>OnPrimary</strong></td>
            <td><code class="mono-chip">NexaOnPrimary</code></td>
            <td><span class="color-dot" style="background:#ffffff"></span> <code>#FFFFFF</code></td>
            <td><code>#002E6C</code></td>
            <td><strong class="ratio-pass">16.2:1 (PASS)</strong></td>
            <td>Texto e iconos sobre superficie Primary</td>
          </tr>
          <tr>
            <td><strong>PrimaryContainer</strong></td>
            <td><code class="mono-chip">NexaPrimaryContainer</code></td>
            <td><span class="color-dot" style="background:#dbeafe"></span> <code>#DBEAFE</code></td>
            <td><code>#1D4ED8</code></td>
            <td><strong class="ratio-pass">6.8:1 (PASS)</strong></td>
            <td>Chips activos, paradas seleccionadas en ruta, filtros aplicados</td>
          </tr>
          <tr>
            <td><strong>OnPrimaryContainer</strong></td>
            <td><code class="mono-chip">NexaOnPrimaryContainer</code></td>
            <td><span class="color-dot" style="background:#1e40af"></span> <code>#1E40AF</code></td>
            <td><code>#DBEAFE</code></td>
            <td><strong class="ratio-pass">8.4:1 (PASS)</strong></td>
            <td>Tipografía y glifos sobre PrimaryContainer</td>
          </tr>
          <tr>
            <td><strong>Secondary</strong></td>
            <td><code class="mono-chip">NexaSecondary</code></td>
            <td><span class="color-dot" style="background:#082846"></span> <code>#082846</code></td>
            <td><code>#7BA4D5</code></td>
            <td><strong class="ratio-pass">14.8:1 (PASS)</strong></td>
            <td>Brand Navy, botones industriales 56dp, cabeceras de carga</td>
          </tr>
          <tr>
            <td><strong>OnSecondary</strong></td>
            <td><code class="mono-chip">NexaOnSecondary</code></td>
            <td><span class="color-dot" style="background:#ffffff"></span> <code>#FFFFFF</code></td>
