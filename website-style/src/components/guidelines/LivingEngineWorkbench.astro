  .station-pill-state.active {
    background: rgba(56, 189, 248, 0.18);
    color: #0284c7;
  }

  .station-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #f1f5f9;
    padding-top: 0.45rem;
