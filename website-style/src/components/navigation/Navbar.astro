---
// Navbar Component: Nexa Minimal Sticky Header with Blur & Responsive Drawer
---

<header class="site-header" id="site-header">
  <div class="nav-container">
    <a href="/" class="brand-logo" aria-label="Nexa Platform">
      <span class="logo-mark" aria-hidden="true">
        <img src="/assets/nexa-nx-blue.svg" alt="NX" width="28" height="28" />
      </span>
      <span class="logo-text">Nexa</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <li><a href="/about" class="nav-link">About</a></li>
        <li><a href="/nexafy" class="nav-link nav-link-nexafy">Nexafy</a></li>
        <li><a href="#channels" class="nav-link">Despacho B2B</a></li>
        <li><a href="#features" class="nav-link">Telemetría IoT</a></li>
        <li><a href="#insurance" class="nav-link">Custodia Escrow</a></li>
      </ul>
    </nav>

    <!-- Desktop Actions -->
    <div class="nav-actions">
      <div class="lang-selector" aria-label="Language selection">
        <button type="button" class="lang-btn active" aria-label="Switch language to Spanish" aria-pressed="true">ES</button>
        <span class="lang-divider" aria-hidden="true">/</span>
        <button type="button" class="lang-btn" aria-label="Switch language to English" aria-pressed="false">EN</button>
      </div>

      <a href="#login" class="login-link">Login</a>
      <a href="#book-demo" class="cta-pill-button">
        <span>Agendar Demo</span>
        <svg class="cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7H11.5M11.5 7L7 2.5M11.5 7L7 11.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Trigger -->
    <button 
      type="button" 
      class="mobile-toggle" 
      id="mobile-menu-trigger" 
      aria-label="Open mobile navigation menu" 
      aria-expanded="false" 
      aria-controls="mobile-drawer"
    >
      <span class="hamburger-line line-1"></span>
      <span class="hamburger-line line-2"></span>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <div class="drawer-header">
      <div class="drawer-logo-wrap">
        <img src="/assets/nexa-nx-white.svg" alt="NX" width="28" height="28" />
        <span class="drawer-logo">Nexa</span>
      </div>
      <button type="button" class="drawer-close" id="mobile-menu-close" aria-label="Close navigation menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="drawer-nav">
      <ul class="drawer-links">
        <li><a href="/about" class="drawer-link monumental-drawer-link">About</a></li>
        <li><a href="/nexafy" class="drawer-link monumental-drawer-link">Nexafy</a></li>
        <li><a href="#channels" class="drawer-link monumental-drawer-link">Despacho</a></li>
        <li><a href="#features" class="drawer-sublink">Telemetría IoT</a></li>
        <li><a href="#insurance" class="drawer-sublink">Custodia Escrow</a></li>
        <li><a href="#contact" class="drawer-sublink">Contacto Comercial</a></li>
        <li><a href="#support" class="drawer-sublink">Soporte Técnico</a></li>
      </ul>
    </nav>

    <div class="drawer-footer">
      <div class="drawer-follow-section">
        <span class="drawer-follow-label">Conecta con Nexa</span>
        <div class="drawer-socials-row">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="drawer-social-circle" aria-label="LinkedIn">in</a>
          <a href="https://github.com/nexa-suite" target="_blank" rel="noopener noreferrer" class="drawer-social-circle" aria-label="GitHub">gh</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height-desktop, 72px);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    z-index: 1000;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.25s ease;
  }

  .site-header:not(.is-scrolled) {
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .site-header.is-scrolled {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .nav-container {
    max-width: 1440px;
    margin: 0 auto;
    height: 100%;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Brand Logo */
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-text {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
    padding: 0.5rem 0;
  }

  .nav-link:hover, .nav-link-nexafy {
    color: #2563eb;
  }

  /* Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .lang-selector {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 0.75rem;
    color: #64748b;
  }

  .lang-btn {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    padding: 2px 4px;
    border-radius: 4px;
    transition: color 0.15s ease;
  }

  .lang-btn.active, .lang-btn:hover {
    color: #2563eb;
    font-weight: 700;
  }

  .login-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .login-link:hover {
    color: #2563eb;
  }

  /* CTA Pill Button */
  .cta-pill-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #2563eb;
    color: #ffffff;
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.625rem 1.35rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .cta-pill-button:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.45);
  }

  .cta-arrow {
    transition: transform 0.15s ease;
  }

  .cta-pill-button:hover .cta-arrow {
    transform: translateX(3px);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    position: relative;
    z-index: 1010;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: #0f172a;
    border-radius: 1px;
    transition: all 0.2s ease;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    background: #082846;
    z-index: 2000;
    padding: 2rem 1.5rem;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(56, 189, 248, 0.2);
  }

  .drawer-logo-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .drawer-logo {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
  }

  .drawer-close {
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .drawer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .drawer-link {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .drawer-link:hover {
    color: #38bdf8;
  }

  .drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(56, 189, 248, 0.2);
  }

  .monumental-drawer-link {
    font-size: 2.25rem !important;
    font-weight: 800 !important;
    line-height: 1.1;
  }

  .drawer-sublink {
    font-size: 1.15rem;
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .drawer-sublink:hover {
    color: #38bdf8;
  }

  .drawer-follow-section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .drawer-follow-label {
    font-size: 0.8125rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .drawer-socials-row {
    display: flex;
    gap: 0.75rem;
  }

  .drawer-social-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #2563eb;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .drawer-social-circle:hover {
    transform: scale(1.08);
    background-color: #1d4ed8;
  }

  /* Responsive Rules */
  @media (max-width: 900px) {
    .desktop-nav, .nav-actions {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-drawer {
      display: flex;
    }
  }
</style>
