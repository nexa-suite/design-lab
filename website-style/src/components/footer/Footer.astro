                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              <span>Agendar Demo B2B</span>
            </a>
          </div>

          <!-- Primary Sitemap Links to Nexafy & Design Lab -->
          <nav class="footer-sitemap-nav" aria-label="Footer Navigation">
            <ul class="sitemap-links-list">
