---
/**
 * InteractiveMobileNavbar.astro
 * Canonical Interactive TopAppBar & Navigation Specification (Material 3)
 * Includes:
 *  - Dynamic TopAppBar with module-aware title
 *  - Sucursal/Almacén selector dropdown (Hub Frigorífico Lima Norte, Callao Muelle 2, Chiclayo Distribución)
 *  - Live connectivity indicator: Online vs Offline (Room Queue: 2 pendientes)
 *  - Notification bell with unread badge & interactive panel
 *  - Operator profile chip (Carlos Mendoza · Jefe de Patio)
 *  - Production-ready Kotlin 2.4 Jetpack Compose code cuadro
 */
---

<div class="interactive-navbar-container">
  
  <!-- Interactive Navigation Bar Stage (Live Mock) -->
  <div class="navbar-mock-stage">
    
    <!-- Top System Bar Mock -->
    <div class="mock-system-bar">
      <span class="system-time">14:35</span>
      <div class="system-icons">
        <span class="system-metric">5G LTE</span>
        <i class="pi pi-wifi"></i>
        <i class="pi pi-bolt"></i>
        <span class="system-battery">92%</span>
      </div>
    </div>

    <!-- M3 Top App Bar (56dp canonical touch height) -->
    <header class="m3-navbar-surface" id="m3-navbar-root">
      
      <!-- Top Row: Drawer Toggle + Title + Action Badges -->
      <div class="navbar-top-row">
        <button type="button" class="nav-icon-btn" id="btn-navbar-menu" aria-label="Abrir menú de navegación">
          <i class="pi pi-bars" aria-hidden="true"></i>
        </button>

        <div class="navbar-title-block">
          <span class="app-brand-subtitle">NEXA OPERATIONS M3</span>
          <h1 class="navbar-module-title" id="navbar-active-title">Tablero de Despacho</h1>
        </div>

        <div class="navbar-actions-cluster">
          <!-- Notification Bell with Unread Badge -->
          <button type="button" class="nav-icon-btn notification-btn" id="btn-navbar-notifications" aria-label="Notificaciones operacionales">
            <i class="pi pi-bell" aria-hidden="true"></i>
            <span class="notification-badge" id="navbar-notif-count">3</span>
          </button>

          <!-- Operator Profile Avatar Chip -->
          <button type="button" class="operator-avatar-btn" id="btn-operator-profile" title="Carlos Mendoza · Jefe de Patio">
            <span class="avatar-initials">CM</span>
            <span class="online-indicator-dot"></span>
          </button>
        </div>
      </div>

      <!-- Second Row: Warehouse Selector + Live Connectivity Mode Indicator -->
      <div class="navbar-sub-row">
        <!-- Sucursal / Almacén Dropdown Selector -->
        <div class="warehouse-selector-wrapper">
          <button type="button" class="warehouse-dropdown-btn" id="btn-warehouse-toggle" aria-haspopup="listbox" aria-expanded="false">
            <i class="pi pi-building text-primary" aria-hidden="true"></i>
            <span class="warehouse-selected-name" id="selected-warehouse-label">Hub Frigorífico Lima Norte</span>
            <i class="pi pi-chevron-down caret-icon" aria-hidden="true"></i>
          </button>

          <!-- Dropdown Menu List -->
          <ul class="warehouse-dropdown-menu" id="warehouse-menu-list" role="listbox" tabindex="-1">
            <li class="warehouse-option active" role="option" aria-selected="true" data-warehouse="Hub Frigorífico Lima Norte" data-temp="-18°C a 4°C">
              <div class="option-content">
                <strong>Hub Frigorífico Lima Norte</strong>
                <small>Principal · 8 Muelles · Temp: -18°C a 4°C</small>
              </div>
              <i class="pi pi-check checkmark"></i>
            </li>
            <li class="warehouse-option" role="option" aria-selected="false" data-warehouse="Callao Muelle 2" data-temp="-20°C Pescados">
              <div class="option-content">
                <strong>Callao Muelle 2</strong>
                <small>Terminal Portuario · 4 Rampas Frío</small>
              </div>
              <i class="pi pi-check checkmark"></i>
            </li>
            <li class="warehouse-option" role="option" aria-selected="false" data-warehouse="Chiclayo Distribución" data-temp="2°C a 8°C">
              <div class="option-content">
                <strong>Chiclayo Distribución</strong>
                <small>Cross-docking Norte · 3 Rampas</small>
              </div>
              <i class="pi pi-check checkmark"></i>
            </li>
          </ul>
        </div>

        <!-- Live Connectivity Pill Toggle (Online vs Offline Room Queue) -->
        <div class="connectivity-control-wrapper">
          <button type="button" class="connectivity-pill is-online" id="btn-connectivity-toggle" title="Click para simular pérdida/recuperación de señal">
            <span class="connectivity-dot"></span>
            <span class="connectivity-text" id="connectivity-status-label">● En Línea</span>
            <span class="connectivity-pill-badge" id="connectivity-queue-badge" style="display: none;">2</span>
          </button>
        </div>
      </div>

      <!-- Third Row: Module Fast Switcher (Interactive Tabs) -->
      <nav class="navbar-module-tabs" aria-label="Módulos de simulación activa">
        <button type="button" class="module-tab-btn active" data-module="dispatch" data-title="Tablero de Despacho">
          <i class="pi pi-send"></i> Despacho
        </button>
        <button type="button" class="module-tab-btn" data-module="catalog" data-title="Catálogo Mayorista">
          <i class="pi pi-shopping-bag"></i> Catálogo
        </button>
        <button type="button" class="module-tab-btn" data-module="pod" data-title="Registro POD & Firma">
          <i class="pi pi-check-circle"></i> Entrega POD
        </button>
        <button type="button" class="module-tab-btn" data-module="inspection" data-title="Inspección Montacargas">
          <i class="pi pi-wrench"></i> Inspección
        </button>
      </nav>

    </header>

    <!-- Dropdown Notification Drawer / Popover -->
    <div class="navbar-notification-popover" id="navbar-notification-panel" style="display: none;">
      <div class="notif-header">
        <div class="notif-header-title">
          <i class="pi pi-bell text-primary"></i>
          <span>Notificaciones Operacionales</span>
        </div>
        <button type="button" class="btn-text-action" id="btn-clear-notifications">Marcar leídas</button>
      </div>
      <ul class="notif-list" id="notif-items-list">
        <li class="notif-item unread">
          <span class="notif-badge-dot cold"></span>
          <div class="notif-item-body">
            <strong>Sensor Frío Muelle 3 (Lima Norte)</strong>
            <p>Temperatura estable a -18.4°C en cámara de congelados.</p>
            <time>Hace 2 minutos</time>
          </div>
        </li>
        <li class="notif-item unread">
          <span class="notif-badge-dot dispatch"></span>
          <div class="notif-item-body">
            <strong>Nueva Orden Asignada (DSP-204)</strong>
            <p>Cliente La Cava Fría · 24x Salmón Salar listo para estiba.</p>
            <time>Hace 5 minutos</time>
          </div>
        </li>
        <li class="notif-item unread">
          <span class="notif-badge-dot alert"></span>
          <div class="notif-item-body">
            <strong>Checklist Pre-operacional Pendiente</strong>
            <p>Montacargas Linde H30 #04 requiere inspección de turno.</p>
            <time>Hace 18 minutos</time>
          </div>
        </li>
      </ul>
    </div>

    <!-- Operator Profile Quick Card (Popover) -->
    <div class="navbar-profile-popover" id="navbar-profile-panel" style="display: none;">
      <div class="profile-header-card">
        <div class="profile-avatar-lg">CM</div>
        <div class="profile-meta">
          <strong>Carlos Mendoza</strong>
          <span class="profile-role">Jefe de Patio & Coordinador de Muelle</span>
          <span class="profile-id">ID Operador: #OP-8842 · Turno Mañana</span>
        </div>
      </div>
      <div class="profile-device-info">
        <div class="device-kv">
          <i class="pi pi-android"></i>
          <span>Terminal Zebra TC58 (Android 14 Industrial)</span>
        </div>
        <div class="device-kv">
          <i class="pi pi-shield"></i>
          <span>Rol: Supervisor de Despacho & Cadena de Frío</span>
        </div>
      </div>
    </div>

    <!-- Live Toast / Snackbar Alert Feedback -->
    <div class="live-toast-bar" id="navbar-live-toast" style="display: none;">
      <i class="pi pi-info-circle toast-icon" id="toast-icon"></i>
      <span class="toast-message" id="toast-message">Almacén cambiado a Callao Muelle 2</span>
    </div>

  </div>

  <!-- Documentation Cuadro: Production-Ready Kotlin 2.4 & Jetpack Compose Material 3 Code -->
  <section class="cuadro-card">
    <header class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">NAV</span>
        <div>
          <p class="cuadro-kicker">JETPACK COMPOSE MATERIAL 3 · TOP APP BAR CON ALMACÉN & OFFLINE QUEUE</p>
          <h3 class="cuadro-title">Especificación de Navbar Dinámica y Sincronización de Red</h3>
          <p class="cuadro-subtitle">
            Implementación nativa en Kotlin 2.4 con <code>TopAppBar</code>, <code>DropdownMenu</code>, control reactivo de conectividad con WorkManager y perfiles de operador con touch target mínimo de 48dp/56dp.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag primary"><i class="pi pi-android"></i> Android 14 M3</span>
        <span class="cuadro-tag kotlin"><i class="pi pi-code"></i> Kotlin 2.4</span>
        <span class="cuadro-tag success"><i class="pi pi-sync"></i> StateFlow UDF</span>
      </div>
    </header>

    <!-- Kotlin 2.4 Production Snippet -->
    <div class="code-box-wrapper">
      <div class="code-box-header">
        <div class="file-name">
          <i class="pi pi-file"></i>
          <span>NexaInteractiveTopAppBar.kt — Jetpack Compose Material 3</span>
        </div>
        <span class="code-badge">Production Kotlin 2.4</span>
      </div>
      <pre class="code-content" is:raw><code><span class="kw">package</span> com.nexa.operations.presentation.components

<span class="kw">import</span> androidx.compose.animation.*
<span class="kw">import</span> androidx.compose.foundation.background
<span class="kw">import</span> androidx.compose.foundation.clickable
<span class="kw">import</span> androidx.compose.foundation.layout.*
<span class="kw">import</span> androidx.compose.foundation.shape.CircleShape
<span class="kw">import</span> androidx.compose.foundation.shape.RoundedCornerShape
<span class="kw">import</span> androidx.compose.material.icons.Icons
<span class="kw">import</span> androidx.compose.material.icons.filled.*
<span class="kw">import</span> androidx.compose.material3.*
<span class="kw">import</span> androidx.compose.runtime.*
<span class="kw">import</span> androidx.compose.ui.Alignment
<span class="kw">import</span> androidx.compose.ui.Modifier
<span class="kw">import</span> androidx.compose.ui.draw.clip
<span class="kw">import</span> androidx.compose.ui.graphics.Color
<span class="kw">import</span> androidx.compose.ui.unit.dp
<span class="kw">import</span> androidx.compose.ui.unit.sp
<span class="kw">import</span> kotlinx.coroutines.flow.StateFlow

<span class="cmt">/**
 * Estado inmutable de la barra superior interactiva de Nexa Operations.
 */</span>
<span class="kw">data class</span> <span class="type">TopBarUiState</span>(
    <span class="kw">val</span> activeModuleName: <span class="type">String</span> = <span class="str">"Tablero de Despacho"</span>,
    <span class="kw">val</span> currentWarehouse: <span class="type">String</span> = <span class="str">"Hub Frigorífico Lima Norte"</span>,
    <span class="kw">val</span> isOnline: <span class="type">Boolean</span> = <span class="kw">true</span>,
    <span class="kw">val</span> pendingRoomQueueCount: <span class="type">Int</span> = <span class="num">0</span>,
    <span class="kw">val</span> unreadNotificationsCount: <span class="type">Int</span> = <span class="num">3</span>,
    <span class="kw">val</span> operatorName: <span class="type">String</span> = <span class="str">"Carlos Mendoza"</span>,
    <span class="kw">val</span> operatorRole: <span class="type">String</span> = <span class="str">"Jefe de Patio"</span>
)

<span class="kw">@OptIn</span>(ExperimentalMaterial3Api::<span class="kw">class</span>)
<span class="kw">@Composable</span>
<span class="kw">fun</span> <span class="fn">NexaInteractiveTopAppBar</span>(
    uiState: <span class="type">TopBarUiState</span>,
    onWarehouseSelected: (<span class="type">String</span>) -&gt; <span class="type">Unit</span>,
    onToggleConnectivityMode: () -&gt; <span class="type">Unit</span>,
    onNotificationClick: () -&gt; <span class="type">Unit</span>,
    onProfileClick: () -&gt; <span class="type">Unit</span>,
    onMenuClick: () -&gt; <span class="type">Unit</span>,
    modifier: <span class="type">Modifier</span> = <span class="type">Modifier</span>
) {
    <span class="kw">var</span> warehouseExpanded <span class="kw">by</span> remember { mutableStateOf(<span class="kw">false</span>) }
    <span class="kw">val</span> warehouses = listOf(
        <span class="str">"Hub Frigorífico Lima Norte"</span>,
        <span class="str">"Callao Muelle 2"</span>,
        <span class="str">"Chiclayo Distribución"</span>
    )

    <span class="fn">Surface</span>(
        modifier = modifier.fillMaxWidth(),
        color = MaterialTheme.colorScheme.surface,
        tonalElevation = <span class="num">2.dp</span>,
        shadowElevation = <span class="num">1.dp</span>
    ) {
        <span class="fn">Column</span>(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = <span class="num">16.dp</span>, vertical = <span class="num">8.dp</span>)
        ) {
            <span class="cmt">// Fila Principal: Menú + Título Dinámico + Acciones (56dp target)</span>
            <span class="fn">Row</span>(
                modifier = Modifier.fillMaxWidth().height(<span class="num">56.dp</span>),
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.SpaceBetween
            ) {
                <span class="fn">IconButton</span>(
                    onClick = onMenuClick,
                    modifier = Modifier.size(<span class="num">48.dp</span>) <span class="cmt">// Touch Target Mínimo WCAG</span>
                ) {
                    <span class="fn">Icon</span>(Icons.Default.Menu, contentDescription = <span class="str">"Menú Lateral"</span>)
                }

                <span class="fn">Column</span>(modifier = Modifier.weight(<span class="num">1f</span>).padding(horizontal = <span class="num">8.dp</span>)) {
                    <span class="fn">Text</span>(
                        text = <span class="str">"NEXA OPERATIONS M3"</span>,
                        style = MaterialTheme.typography.labelSmall,
                        color = MaterialTheme.colorScheme.primary,
                        letterSpacing = <span class="num">0.8.sp</span>
                    )
                    <span class="fn">Text</span>(
                        text = uiState.activeModuleName,
                        style = MaterialTheme.typography.titleMedium,
                        color = MaterialTheme.colorScheme.onSurface
                    )
                }

                <span class="cmt">// Campana con Badge de Notificaciones</span>
                <span class="fn">BadgedBox</span>(
                    badge = {
                        <span class="kw">if</span> (uiState.unreadNotificationsCount &gt; <span class="num">0</span>) {
                            <span class="fn">Badge</span>(
                                containerColor = MaterialTheme.colorScheme.error,
                                contentColor = Color.White
                            ) {
                                <span class="fn">Text</span>(<span class="str">"${uiState.unreadNotificationsCount}"</span>)
                            }
                        }
                    }
                ) {
                    <span class="fn">IconButton</span>(
                        onClick = onNotificationClick,
                        modifier = Modifier.size(<span class="num">48.dp</span>)
                    ) {
                        <span class="fn">Icon</span>(Icons.Default.Notifications, contentDescription = <span class="str">"Notificaciones"</span>)
                    }
                }

                <span class="fn">Spacer</span>(modifier = Modifier.width(<span class="num">4.dp</span>))

                <span class="cmt">// Avatar del Operador (Carlos Mendoza)</span>
                <span class="fn">Box</span>(
                    modifier = Modifier
                        .size(<span class="num">40.dp</span>)
                        .clip(CircleShape)
                        .background(MaterialTheme.colorScheme.primaryContainer)
                        .clickable(onClick = onProfileClick),
                    contentAlignment = Alignment.Center
                ) {
                    <span class="fn">Text</span>(
                        text = <span class="str">"CM"</span>,
                        style = MaterialTheme.typography.labelMedium,
                        color = MaterialTheme.colorScheme.onPrimaryContainer
                    )
                }
            }

            <span class="cmt">// Segunda Fila: Selector de Almacén + Indicador de Conectividad</span>
            <span class="fn">Row</span>(
                modifier = Modifier.fillMaxWidth().padding(top = <span class="num">4.dp</span>),
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.SpaceBetween
            ) {
                <span class="cmt">// Dropdown de Sucursal</span>
                <span class="fn">Box</span> {
                    <span class="fn">OutlinedButton</span>(
                        onClick = { warehouseExpanded = !warehouseExpanded },
                        shape = RoundedCornerShape(<span class="num">8.dp</span>),
                        contentPadding = PaddingValues(horizontal = <span class="num">10.dp</span>, vertical = <span class="num">4.dp</span>),
                        modifier = Modifier.heightIn(min = <span class="num">40.dp</span>)
                    ) {
                        <span class="fn">Icon</span>(Icons.Default.LocationOn, contentDescription = <span class="kw">null</span>, modifier = Modifier.size(<span class="num">16.dp</span>))
                        <span class="fn">Spacer</span>(modifier = Modifier.width(<span class="num">6.dp</span>))
                        <span class="fn">Text</span>(text = uiState.currentWarehouse, style = MaterialTheme.typography.labelMedium)
                        <span class="fn">Icon</span>(Icons.Default.ArrowDropDown, contentDescription = <span class="kw">null</span>)
                    }

                    <span class="fn">DropdownMenu</span>(
                        expanded = warehouseExpanded,
                        onDismissRequest = { warehouseExpanded = <span class="kw">false</span> }
                    ) {
                        warehouses.forEach { warehouse -&gt;
                            <span class="fn">DropdownMenuItem</span>(
                                text = { <span class="fn">Text</span>(warehouse) },
                                onClick = {
                                    onWarehouseSelected(warehouse)
                                    warehouseExpanded = <span class="kw">false</span>
                                },
                                leadingIcon = {
                                    <span class="kw">if</span> (warehouse == uiState.currentWarehouse) {
                                        <span class="fn">Icon</span>(Icons.Default.Check, contentDescription = <span class="kw">null</span>, tint = MaterialTheme.colorScheme.primary)
                                    }
                                }
                            )
                        }
                    }
                }

                <span class="cmt">// Indicador Interactivo de Conectividad / Room Offline Queue</span>
                <span class="fn">SuggestionChip</span>(
                    onClick = onToggleConnectivityMode,
                    label = {
                        <span class="fn">Text</span>(
                            text = <span class="kw">if</span> (uiState.isOnline) <span class="str">"● En Línea"</span> <span class="kw">else</span> <span class="str">"⚡ Offline (${uiState.pendingRoomQueueCount})"</span>,
                            style = MaterialTheme.typography.labelSmall
                        )
                    },
                    colors = SuggestionChipDefaults.suggestionChipColors(
                        containerColor = <span class="kw">if</span> (uiState.isOnline) Color(<span class="num">0xFFDCFCE7</span>) <span class="kw">else</span> Color(<span class="num">0xFFFEF3C7</span>),
                        labelColor = <span class="kw">if</span> (uiState.isOnline) Color(<span class="num">0xFF15803D</span>) <span class="kw">else</span> Color(<span class="num">0xFFB45309</span>)
                    ),
                    border = <span class="kw">null</span>,
                    shape = RoundedCornerShape(<span class="num">16.dp</span>)
                )
            }
        }
    }
}</code></pre>
    </div>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Warehouse Dropdown logic
    const btnWarehouse = document.getElementById('btn-warehouse-toggle');
    const warehouseMenu = document.getElementById('warehouse-menu-list');
    const warehouseLabel = document.getElementById('selected-warehouse-label');
    const warehouseOptions = document.querySelectorAll('.warehouse-option');
    const toastBar = document.getElementById('navbar-live-toast');
    const toastMsg = document.getElementById('toast-message');

    function showToast(message: string) {
      if (!toastBar || !toastMsg) return;
      toastMsg.textContent = message;
      toastBar.style.display = 'flex';
      setTimeout(() => {
        toastBar.style.display = 'none';
      }, 3000);
    }

    btnWarehouse?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = btnWarehouse.getAttribute('aria-expanded') === 'true';
      btnWarehouse.setAttribute('aria-expanded', String(!isExpanded));
      if (warehouseMenu) {
        warehouseMenu.style.display = isExpanded ? 'none' : 'block';
      }
    });

    warehouseOptions.forEach(opt => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        warehouseOptions.forEach(o => o.classList.remove('active'));
        opt.classList.add('active');
        const name = opt.getAttribute('data-warehouse') || '';
        if (warehouseLabel) warehouseLabel.textContent = name;
        if (warehouseMenu) warehouseMenu.style.display = 'none';
        btnWarehouse?.setAttribute('aria-expanded', 'false');
        showToast(`Almacén activo actualizado a: ${name}`);
      });
    });

    // Connectivity Toggle Logic (Online vs Offline Room Queue)
    const btnConnectivity = document.getElementById('btn-connectivity-toggle');
    const statusLabel = document.getElementById('connectivity-status-label');
    const queueBadge = document.getElementById('connectivity-queue-badge');
    let isOnline = true;

    btnConnectivity?.addEventListener('click', () => {
      isOnline = !isOnline;
      if (isOnline) {
        btnConnectivity.className = 'connectivity-pill is-online';
        if (statusLabel) statusLabel.textContent = '● En Línea';
        if (queueBadge) queueBadge.style.display = 'none';
        showToast('Conectividad restablecida: Cola Room sincronizada con servidor central');
      } else {
        btnConnectivity.className = 'connectivity-pill is-offline';
        if (statusLabel) statusLabel.textContent = '⚡ Modo Offline';
        if (queueBadge) {
          queueBadge.textContent = '2';
          queueBadge.style.display = 'inline-flex';
        }
        showToast('Modo Offline activado: 2 mutaciones en cola SQLite Room');
      }
    });

    // Notification Panel Toggle
    const btnNotif = document.getElementById('btn-navbar-notifications');
    const panelNotif = document.getElementById('navbar-notification-panel');
    const notifCount = document.getElementById('navbar-notif-count');
    const btnClearNotif = document.getElementById('btn-clear-notifications');

    btnNotif?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!panelNotif) return;
      const isOpen = panelNotif.style.display === 'block';
      panelNotif.style.display = isOpen ? 'none' : 'block';
    });

    btnClearNotif?.addEventListener('click', () => {
      if (notifCount) notifCount.style.display = 'none';
      document.querySelectorAll('.notif-item').forEach(item => item.classList.remove('unread'));
      showToast('Todas las alertas operacionales han sido marcadas como leídas');
    });

    // Profile Panel Toggle
    const btnProfile = document.getElementById('btn-operator-profile');
    const panelProfile = document.getElementById('navbar-profile-panel');

    btnProfile?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!panelProfile) return;
      const isOpen = panelProfile.style.display === 'block';
      panelProfile.style.display = isOpen ? 'none' : 'block';
    });

    // Module Switcher Tabs
    const moduleTabs = document.querySelectorAll('.module-tab-btn');
    const titleHeader = document.getElementById('navbar-active-title');

    moduleTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        moduleTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const title = tab.getAttribute('data-title') || '';
        if (titleHeader) titleHeader.textContent = title;
        showToast(`Módulo cambiado a: ${title}`);
      });
    });

    // Close popovers on click outside
    document.addEventListener('click', () => {
      if (warehouseMenu) warehouseMenu.style.display = 'none';
      btnWarehouse?.setAttribute('aria-expanded', 'false');
      if (panelNotif) panelNotif.style.display = 'none';
      if (panelProfile) panelProfile.style.display = 'none';
    });
  });
</script>

<style>
  .interactive-navbar-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
