---
/**
 * LoginScreenSpec.astro — Canonical Nexa Mobile Login & Workspace Access
 * Modern, thumb-friendly mobile authentication with fluid gradient transition,
 * in-block labels, Knox biometric access, and home navigation.
 */
---

<div class="mobile-login-specimen">
  <!-- Blueprint Grid Brand Hero Header with Fluid Gradient Transition -->
  <div class="login-brand-plane">
    <!-- Subtle Blueprint Grid Pattern Overlay -->
    <div class="blueprint-grid-mesh" aria-hidden="true"></div>

    <div class="brand-plane-content">
      <!-- Top Brand Row: Home Return Pill (Left) & Transparent NX White Logo (Right) -->
      <div class="brand-header-row">
        <!-- Central / Top Return to Home Action on the Left -->
        <a href="/" class="login-home-pill" title="Volver al Portal Central Nexa">
          <i class="pi pi-home" aria-hidden="true"></i>
          <span>Inicio</span>
        </a>

        <div class="nx-logo-mark" title="Nexa Suite">
          <img src="/assets/nexa-nx-white.svg" alt="NX" class="nx-logo-img" />
        </div>
      </div>

      <div class="brand-hero-text">
        <h2 class="brand-title">Iniciar Sesión</h2>
        <p class="brand-subtitle">Plataforma logística y cadena de frío</p>
      </div>
    </div>
  </div>

  <!-- Form Content Area with Overlapping Curved Shell -->
  <div class="login-form-plane">
    <!-- Role Quick-Login Chips -->
    <div class="quick-roles-cluster">
      <div class="quick-role-pills" role="radiogroup" aria-label="Seleccionar rol de acceso">
        <button type="button" class="btn-quick-role active" data-email="diego.morales@nexa.pe" data-role="Conductor">
          <i class="pi pi-map-marker"></i>
          <span>Conductor</span>
        </button>
        <button type="button" class="btn-quick-role" data-email="alejandro.vargas@nexa.pe" data-role="Almacén">
          <i class="pi pi-box"></i>
          <span>Almacén</span>
        </button>
        <button type="button" class="btn-quick-role" data-email="carlos.mendoza@supermercados.pe" data-role="Comprador">
          <i class="pi pi-shopping-bag"></i>
          <span>Comprador</span>
        </button>
      </div>
    </div>

    <!-- Mobile Login Form with In-Block Modern Inputs -->
    <form class="workspace-login-form" id="mobile-login-form" onsubmit="return false;">
      
      <!-- Email Field (Label Inside Block) -->
      <div class="inblock-input-card">
        <div class="inblock-icon-wrap">
          <i class="pi pi-envelope" aria-hidden="true"></i>
        </div>
        <div class="inblock-text-wrap">
          <label for="login-email-input" class="inblock-floating-label">Correo corporativo</label>
          <input 
            type="email" 
            id="login-email-input" 
            class="inblock-raw-input" 
            value="diego.morales@nexa.pe" 
            placeholder="tu@nexa.pe" 
            autocomplete="email"
            required
          />
        </div>
      </div>

      <!-- Password Field (Label Inside Block + Toggle Eye) -->
      <div class="inblock-input-card">
        <div class="inblock-icon-wrap">
          <i class="pi pi-lock" aria-hidden="true"></i>
        </div>
        <div class="inblock-text-wrap">
          <label for="login-password-input" class="inblock-floating-label">Contraseña</label>
          <input 
            type="password" 
            id="login-password-input" 
            class="inblock-raw-input" 
            value="NexaSecure2026!" 
            placeholder="••••••••••••" 
            autocomplete="current-password"
            required
          />
        </div>
        <button type="button" class="btn-toggle-eye" id="btn-toggle-pwd" aria-label="Mostrar u ocultar contraseña">
          <i class="pi pi-eye" id="eye-icon"></i>
        </button>
      </div>

      <!-- Remember & Forgot Row -->
      <div class="form-options-row">
        <label class="custom-checkbox-wrap">
          <input type="checkbox" id="chk-remember" checked />
          <span class="chk-box-custom"></span>
          <span class="chk-label">Recordar usuario</span>
        </label>
        <a href="#forgot" class="forgot-link">¿Olvidaste tu clave?</a>
      </div>

      <!-- Primary Sign In Action (54dp Touch Target) -->
      <button type="submit" class="btn-login-submit" id="btn-login-submit">
        <span>Ingresar al espacio</span>
        <i class="pi pi-arrow-right"></i>
      </button>

      <!-- Biometric Hardware Login for Rugged Devices (Knox / Fingerprint) -->
      <button type="button" class="btn-biometric-auth" id="btn-biometric-login">
        <i class="pi pi-shield"></i>
        <span>Acceso Biométrico / Huella Knox</span>
      </button>
    </form>

    <!-- Feedback Banner / Demo Status -->
    <div class="login-feedback-banner" id="login-feedback-banner" style="display: none;">
      <i class="pi pi-check-circle"></i>
      <span id="login-feedback-text">Sesión iniciada correctamente. Cargando hoja de ruta...</span>
    </div>
  </div>
</div>

<style>
  .mobile-login-specimen {
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 36px -8px rgba(15, 23, 42, 0.12), 0 0 0 1px #e2e8f0;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }

  /* Blueprint Grid Brand Plane with Solid Colorimetry (0 Gradients) */
  .login-brand-plane {
    position: relative;
    background: #082846;
    color: #ffffff;
    padding: 24px 22px 32px;
    overflow: hidden;
  }

  /* The Blueprint Grid Lines ("cuadraditos") */
  .blueprint-grid-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.18;
    background-image: 
      linear-gradient(rgba(56, 189, 248, 0.25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(56, 189, 248, 0.25) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .brand-plane-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .brand-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Transparent NX Logo Mark */
  .nx-logo-mark {
    width: 46px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    background: transparent;
  }

  .nx-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Central / Top Home Navigation Pill (Now on the Left) */
  .login-home-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .login-home-pill:hover {
    background: rgba(255, 255, 255, 0.22);
    transform: translateY(-1px);
  }

  .login-home-pill i {
    font-size: 13px;
  }

  .brand-hero-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .brand-title {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 24px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .brand-subtitle {
    font-size: 13px;
    color: #bae6fd;
    line-height: 1.4;
    font-weight: 500;
  }

  /* Form Content Area Overlapping Solid Header */
  .login-form-plane {
    position: relative;
    z-index: 3;
    margin-top: -12px;
    background: #ffffff;
    border-radius: 24px 24px 0 0;
    padding: 24px 22px 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.04);
  }

  /* Quick Role Chips */
  .quick-roles-cluster {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .quick-role-pills {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .btn-quick-role {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 38px;
    padding: 0 8px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .btn-quick-role:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }

  .btn-quick-role.active {
    background: #eff6ff;
    border-color: #2563eb;
    color: #1d4ed8;
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.15);
  }

  .btn-quick-role i {
    font-size: 13px;
  }

  /* Mobile Login Form */
  .workspace-login-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Modern In-Block Input Cards (Label + Field Inside One Enclosure) */
  .inblock-input-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
    min-height: 56px;
    transition: all 0.15s ease;
  }

  .inblock-input-card:focus-within {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  .inblock-icon-wrap {
    color: #64748b;
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .inblock-input-card:focus-within .inblock-icon-wrap {
    color: #2563eb;
  }

  .inblock-text-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .inblock-floating-label {
    font-size: 10.5px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin-bottom: 2px;
  }

  .inblock-input-card:focus-within .inblock-floating-label {
    color: #2563eb;
  }

  .inblock-raw-input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    color: #0f172a;
    font-size: 14.5px;
    font-weight: 600;
    font-family: inherit;
    padding: 0;
  }

  .inblock-raw-input::placeholder {
    color: #94a3b8;
    font-weight: 400;
  }

  .btn-toggle-eye {
    background: transparent;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    border-radius: 8px;
    transition: color 0.15s ease;
  }

  .btn-toggle-eye:hover {
    color: #0f172a;
  }

  /* Form Options Row */
  .form-options-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    padding: 2px 2px;
  }

  .custom-checkbox-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
    color: #475569;
    font-weight: 500;
  }

  .custom-checkbox-wrap input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  .chk-box-custom {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1.5px solid #cbd5e1;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .custom-checkbox-wrap input:checked ~ .chk-box-custom {
    background: #2563eb;
    border-color: #2563eb;
  }

  .custom-checkbox-wrap input:checked ~ .chk-box-custom::after {
    content: '';
    width: 5px;
    height: 9px;
    border: solid #ffffff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-bottom: 2px;
  }

  .forgot-link {
    color: #2563eb;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .forgot-link:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }

  /* Action Buttons */
  .btn-login-submit {
    height: 52px;
    border-radius: 14px;
    background: #2563eb;
    color: #ffffff;
    border: none;
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    transition: all 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .btn-login-submit:hover {
    background: #1d4ed8;
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.4);
    transform: translateY(-1px);
  }

  .btn-login-submit:active {
    transform: scale(0.98);
  }

  .btn-biometric-auth {
    height: 48px;
    border-radius: 14px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .btn-biometric-auth:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
  }

  .btn-biometric-auth:active {
    transform: scale(0.98);
  }

  .btn-biometric-auth i {
    color: #2563eb;
    font-size: 15px;
  }

  /* Feedback Banner */
  .login-feedback-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-radius: 10px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e40af;
    font-size: 12.5px;
    font-weight: 600;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // Quick Role Fill Logic
  const roleButtons = document.querySelectorAll<HTMLButtonElement>('.btn-quick-role');
  const emailInput = document.getElementById('login-email-input') as HTMLInputElement | null;
  const loginForm = document.getElementById('mobile-login-form');
  const feedbackBanner = document.getElementById('login-feedback-banner');
  const feedbackText = document.getElementById('login-feedback-text');
  const btnTogglePwd = document.getElementById('btn-toggle-pwd');
  const pwdInput = document.getElementById('login-password-input') as HTMLInputElement | null;
  const eyeIcon = document.getElementById('eye-icon');
  const btnBiometric = document.getElementById('btn-biometric-login');

  roleButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      roleButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const email = btn.getAttribute('data-email');
      if (emailInput && email) {
        emailInput.value = email;
      }
    });
  });

  // Toggle Password Visibility
  btnTogglePwd?.addEventListener('click', () => {
    if (!pwdInput) return;
    const isPwd = pwdInput.type === 'password';
    pwdInput.type = isPwd ? 'text' : 'password';
    eyeIcon?.classList.toggle('pi-eye', !isPwd);
    eyeIcon?.classList.toggle('pi-eye-slash', isPwd);
  });

  // Form Submit Simulation
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (feedbackBanner && feedbackText) {
      feedbackBanner.style.display = 'flex';
      feedbackBanner.style.background = '#ecfdf5';
      feedbackBanner.style.borderColor = '#a7f3d0';
      feedbackBanner.style.color = '#065f46';
      feedbackText.textContent = `Autenticado como ${emailInput?.value || 'operador'}. Iniciando sesión segura...`;
      setTimeout(() => {
        feedbackBanner.style.display = 'none';
      }, 3500);
    }
  });

  // Biometric Auth Simulation
  btnBiometric?.addEventListener('click', () => {
    if (feedbackBanner && feedbackText) {
      feedbackBanner.style.display = 'flex';
      feedbackBanner.style.background = '#eff6ff';
      feedbackBanner.style.borderColor = '#bfdbfe';
      feedbackBanner.style.color = '#1e40af';
      feedbackText.textContent = 'Huella dactilar Samsung Knox / Zebra verificada. Espacio de trabajo desbloqueado.';
      setTimeout(() => {
        feedbackBanner.style.display = 'none';
      }, 3500);
    }
  });
</script>
