<script>
  const phaseButtons = document.querySelectorAll('#story-inspeccion .phase-btn');
  const phasePanels = document.querySelectorAll('#story-inspeccion .phase-panel');

  phaseButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      phaseButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const phase = btn.getAttribute('data-phase');
      phasePanels.forEach(panel => {
        panel.classList.toggle('active', panel.id === `panel-phase-${phase}`);
      });
    });
  });
</script>
