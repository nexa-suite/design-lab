---
/**
 * TelemetryColdChainSpec.astro
 * Canonical Cold Chain Telemetry & Sensirion SHT40 BLE Monitor (Jetpack Compose M3)
 * Nexa Suite · Cadena de Frío en Ruta (MOB-US-026..028, 031)
 */
---

<div class="telemetry-mock-stage" id="mock-telemetry-container">
  
  <!-- Header Card: Sensor Connection & Mode Switcher -->
  <div class="sensor-status-card">
    <div class="sensor-info-row">
      <div class="sensor-badge">
        <i class="pi pi-bolt"></i>
        <span>BLE ACTIVO · SENSIRION SHT40</span>
      </div>
      <div class="sensor-battery">
        <i class="pi pi-battery"></i> 98% · RSSI -58 dBm
      </div>
    </div>
    <div class="sensor-meta-row">
      <span class="unit-id">Furgón Refrigerado: <strong>NX-REEFER #C-250</strong></span>
      <span class="sensor-id">MAC: <code>F4:12:FA:88:B2:10</code></span>
    </div>

    <!-- Quick Temperature Test Simulator Switch -->
    <div class="temp-simulator-bar">
      <span class="sim-label">SIMULADOR DE RUTA:</span>
      <button type="button" class="btn-temp-sim active" id="btn-temp-normal" data-temp="3.4">
        <i class="pi pi-check-circle"></i> Conforme (3.4°C)
      </button>
      <button type="button" class="btn-temp-sim warning" id="btn-temp-warning" data-temp="6.5">
        <i class="pi pi-exclamation-triangle"></i> Advertencia (6.5°C)
      </button>
      <button type="button" class="btn-temp-sim critical" id="btn-temp-critical" data-temp="8.2">
        <i class="pi pi-times-circle"></i> Quiebre Crítico (8.2°C)
      </button>
    </div>
  </div>

  <!-- Primary Gauge & Real-time Value Card -->
  <div class="gauge-display-card" id="gauge-card">
    <div class="gauge-top-meta">
      <span class="status-label" id="lbl-telemetry-status">TEMPERATURA ESTABLE EN RANGO</span>
      <span class="compliance-tag" id="lbl-haccp-tag">HACCP CONFORME</span>
    </div>

    <div class="temperature-number-row">
      <span class="temp-big-value" id="val-temp-display">3.4</span>
      <div class="temp-units-col">
        <span class="temp-unit">°C</span>
        <span class="temp-sub-metric">Humedad: <strong id="val-humidity-display">84% RH</strong></span>
      </div>
    </div>

    <div class="tolerance-band-bar">
      <div class="band-indicator min">0°C</div>
      <div class="band-safe-zone">
        <span class="safe-zone-label">Rango Óptimo Perecederos (2.0°C – 6.0°C)</span>
      </div>
      <div class="band-indicator max">10°C</div>
      <!-- Needle indicator positioned by script -->
      <div class="current-temp-needle" id="temp-needle" style="left: 34%;">
        <span class="needle-pip"></span>
      </div>
    </div>
  </div>

  <!-- Real-time Thermal Curve Chart (SVG) -->
  <div class="chart-container-card">
    <div class="chart-header">
      <div class="chart-title-wrap">
        <i class="pi pi-chart-line"></i>
        <h4>Curva Térmica · Últimas 4 Horas (Muestreo cada 2 min)</h4>
      </div>
      <span class="chart-legend">Límite Crítico: 6.0°C</span>
    </div>

    <div class="chart-svg-wrap">
      <svg viewBox="0 0 400 120" class="thermal-curve-svg" preserveAspectRatio="none">
        <!-- Safe Zone Shading -->
        <rect x="0" y="36" width="400" height="48" fill="rgba(219, 234, 254, 0.4)" />
        
        <!-- Threshold Line at 6°C -->
        <line x1="0" y1="36" x2="400" y2="36" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4,4" />
        <text x="5" y="30" fill="#ef4444" font-size="9" font-family="monospace">6.0°C MAX</text>

        <!-- Lower Threshold Line at 2°C -->
        <line x1="0" y1="84" x2="400" y2="84" stroke="#0284c7" stroke-width="1.5" stroke-dasharray="4,4" />
        <text x="5" y="98" fill="#0284c7" font-size="9" font-family="monospace">2.0°C MIN</text>

        <!-- Dynamic Thermal Curve -->
        <path
          id="svg-thermal-path"
          d="M 0,60 Q 50,55 100,58 T 200,62 T 300,56 T 400,58"
          fill="none"
          stroke="#2563eb"
          stroke-width="3"
        />

        <!-- Current Sampling Point -->
        <circle id="svg-current-point" cx="395" cy="58" r="5" fill="#2563eb" stroke="#ffffff" stroke-width="2" />
      </svg>
    </div>

    <div class="chart-footer-meta">
      <span>10:30 (Carga)</span>
      <span>11:30 (Tránsito)</span>
      <span>12:30 (Parada 1)</span>
      <span>14:35 (Actual)</span>
    </div>
  </div>

  <!-- HACCP Audit Trail & Corrective Actions -->
  <div class="audit-actions-card">
    <div class="audit-header">
      <i class="pi pi-file-check"></i>
      <h4>Registro de Calidad & Trazabilidad HACCP</h4>
    </div>
    
    <div class="audit-log-list">
      <div class="log-item">
        <span class="log-time">14:33:10</span>
        <span class="log-badge ok">BLE OK</span>
        <span class="log-text">Sensirion SHT40: 3.4°C / 84% RH · Trazabilidad sincronizada</span>
      </div>
      <div class="log-item">
        <span class="log-time">14:31:08</span>
        <span class="log-badge ok">GPS FIX</span>
        <span class="log-text">Coordenadas: -12.0464, -77.0428 · Velocidad 42 km/h</span>
      </div>
      <div class="log-item" id="log-alert-item" style="display: none;">
        <span class="log-time" id="log-alert-time">14:35:00</span>
        <span class="log-badge danger">ALERTA</span>
        <span class="log-text" id="log-alert-text">Ruptura térmica registrada. Alerta enviada a Torre de Control.</span>
      </div>
    </div>

    <div class="corrective-actions-cluster" id="corrective-cluster" style="display: none;">
      <button type="button" class="btn-corrective primary" id="btn-compresor">
        <i class="pi pi-sync"></i> Forzar Compresor Auxiliar
      </button>
      <button type="button" class="btn-corrective secondary" id="btn-dispatch">
        <i class="pi pi-phone"></i> Llamar a Despacho Central
      </button>
    </div>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnNormal = document.getElementById('btn-temp-normal');
    const btnWarning = document.getElementById('btn-temp-warning');
    const btnCritical = document.getElementById('btn-temp-critical');

    const valDisplay = document.getElementById('val-temp-display');
    const lblStatus = document.getElementById('lbl-telemetry-status');
    const lblHaccp = document.getElementById('lbl-haccp-tag');
    const gaugeCard = document.getElementById('gauge-card');
    const needle = document.getElementById('temp-needle');
    const path = document.getElementById('svg-thermal-path');
    const point = document.getElementById('svg-current-point');
    const alertItem = document.getElementById('log-alert-item');
    const alertText = document.getElementById('log-alert-text');
    const correctiveCluster = document.getElementById('corrective-cluster');

    function setTemperature(temp: number, mode: 'normal' | 'warning' | 'critical') {
      [btnNormal, btnWarning, btnCritical].forEach(b => b?.classList.remove('active'));

      if (valDisplay) valDisplay.textContent = temp.toFixed(1);

      // Percentage between 0°C (0%) and 10°C (100%)
      const pct = Math.min(100, Math.max(0, (temp / 10) * 100));
      if (needle) needle.style.left = `${pct}%`;

      if (mode === 'normal') {
        btnNormal?.classList.add('active');
        if (lblStatus) lblStatus.textContent = 'TEMPERATURA ESTABLE EN RANGO';
        if (lblHaccp) {
          lblHaccp.textContent = 'HACCP CONFORME';
          lblHaccp.className = 'compliance-tag';
        }
        if (gaugeCard) gaugeCard.className = 'gauge-display-card';
        if (path) {
          path.setAttribute('d', 'M 0,60 Q 50,55 100,58 T 200,62 T 300,56 T 400,58');
          path.setAttribute('stroke', '#2563eb');
        }
        if (point) {
          point.setAttribute('cy', '58');
          point.setAttribute('fill', '#2563eb');
        }
        if (alertItem) alertItem.style.display = 'none';
        if (correctiveCluster) correctiveCluster.style.display = 'none';
      } else if (mode === 'warning') {
        btnWarning?.classList.add('active');
        if (lblStatus) lblStatus.textContent = 'LÍMITE SUPERIOR ALCANZADO (6.5°C)';
        if (lblHaccp) {
          lblHaccp.textContent = 'ADVERTENCIA';
          lblHaccp.className = 'compliance-tag warning';
        }
        if (gaugeCard) gaugeCard.className = 'gauge-display-card warning';
        if (path) {
          path.setAttribute('d', 'M 0,60 Q 50,55 100,58 T 200,50 T 300,40 T 400,32');
          path.setAttribute('stroke', '#d97706');
        }
        if (point) {
          point.setAttribute('cy', '32');
          point.setAttribute('fill', '#d97706');
        }
        if (alertItem) {
          alertItem.style.display = 'flex';
          if (alertText) alertText.textContent = 'Temperatura en 6.5°C. Tiempo máximo en umbral: 15 min.';
        }
        if (correctiveCluster) correctiveCluster.style.display = 'flex';
      } else if (mode === 'critical') {
        btnCritical?.classList.add('active');
        if (lblStatus) lblStatus.textContent = '¡QUIEBRE TÉRMICO CRÍTICO (+8.2°C)!';
        if (lblHaccp) {
          lblHaccp.textContent = 'NO CONFORME';
          lblHaccp.className = 'compliance-tag danger';
        }
        if (gaugeCard) gaugeCard.className = 'gauge-display-card danger';
        if (path) {
          path.setAttribute('d', 'M 0,60 Q 50,55 100,58 T 200,45 T 300,25 T 400,12');
          path.setAttribute('stroke', '#ef4444');
        }
        if (point) {
          point.setAttribute('cy', '12');
          point.setAttribute('fill', '#ef4444');
        }
        if (alertItem) {
          alertItem.style.display = 'flex';
          if (alertText) alertText.textContent = '¡Ruptura crítica! Registro de no-conformidad activado para recepción.';
        }
        if (correctiveCluster) correctiveCluster.style.display = 'flex';
      }
    }

    btnNormal?.addEventListener('click', () => setTemperature(3.4, 'normal'));
    btnWarning?.addEventListener('click', () => setTemperature(6.5, 'warning'));
    btnCritical?.addEventListener('click', () => setTemperature(8.2, 'critical'));
  });
</script>

<style>
  .telemetry-mock-stage {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  /* Sensor Status Card */
  .sensor-status-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sensor-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sensor-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10.5px;
    font-weight: 700;
    color: #0284c7;
    background: #e0f2fe;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .sensor-battery {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    color: #475569;
  }

  .sensor-meta-row {
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    color: #334155;
  }

  .sensor-id code {
    font-family: var(--nexa-font-family-mono, monospace);
    color: #64748b;
  }

  .temp-simulator-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    padding-top: 6px;
    border-top: 1px dashed #e2e8f0;
  }

  .sim-label {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 9.5px;
    font-weight: 700;
    color: #64748b;
  }

  .btn-temp-sim {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    font-size: 11px;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: all 0.15s ease;

    &.active {
      background: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
    }

    &.warning.active {
      background: #d97706;
      border-color: #d97706;
      color: #ffffff;
    }

    &.critical.active {
      background: #ef4444;
      border-color: #ef4444;
      color: #ffffff;
    }
  }

  /* Gauge Display Card */
  .gauge-display-card {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: all 0.2s ease;

    &.warning {
      border-color: #f59e0b;
      background: #fffbeb;
    }

    &.danger {
      border-color: #ef4444;
      background: #fef2f2;
    }
  }

  .gauge-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .status-label {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10.5px;
    font-weight: 700;
    color: #0284c7;
    letter-spacing: 0.05em;
  }

  .compliance-tag {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    background: #dcfce7;
    color: #15803d;

    &.warning {
      background: #fef3c7;
      color: #b45309;
    }

    &.danger {
      background: #fee2e2;
      color: #b91c1c;
    }
  }

  .temperature-number-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .temp-big-value {
    font-family: var(--nexa-font-family-display, sans-serif);
    font-size: 48px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1;
  }

  .temp-units-col {
    display: flex;
    flex-direction: column;
  }

  .temp-unit {
    font-size: 20px;
    font-weight: 700;
    color: #64748b;
  }

  .temp-sub-metric {
    font-size: 12px;
    color: #475569;
  }

  /* Tolerance Band Bar */
  .tolerance-band-bar {
    position: relative;
    height: 14px;
    background: #e2e8f0;
    border-radius: 7px;
    display: flex;
    align-items: center;
    margin-top: 4px;
  }

  .band-safe-zone {
    position: absolute;
    left: 20%;
    right: 40%;
    height: 100%;
    background: #bae6fd;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .safe-zone-label {
    font-size: 8px;
    font-weight: 700;
    color: #0369a1;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .band-indicator {
    position: absolute;
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 9px;
    color: #64748b;
    top: 16px;

    &.min { left: 0; }
    &.max { right: 0; }
  }

  .current-temp-needle {
    position: absolute;
    top: -5px;
    transform: translateX(-50%);
    transition: left 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .needle-pip {
    display: block;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #0f172a;
    border: 3px solid #ffffff;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
  }

  /* Chart Card */
  .chart-container-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chart-title-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #1d4ed8;

    h4 {
      font-size: 12px;
      font-weight: 700;
      color: #0f172a;
    }
  }

  .chart-legend {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10px;
    color: #ef4444;
    font-weight: 700;
  }

  .chart-svg-wrap {
    height: 100px;
    width: 100%;
    background: #f8fafc;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
  }

  .thermal-curve-svg {
    width: 100%;
    height: 100%;
  }

  .chart-footer-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 9.5px;
    color: #94a3b8;
  }

  /* Audit Card */
  .audit-actions-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .audit-header {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #0284c7;

    h4 {
      font-size: 12px;
      font-weight: 700;
      color: #0f172a;
    }
  }

  .audit-log-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .log-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    padding: 4px 6px;
    background: #f8fafc;
    border-radius: 6px;
  }

  .log-time {
    font-family: var(--nexa-font-family-mono, monospace);
    color: #64748b;
    font-size: 10px;
  }

  .log-badge {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 9px;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 3px;

    &.ok {
      background: #e0f2fe;
      color: #0284c7;
    }

    &.danger {
      background: #fee2e2;
      color: #b91c1c;
    }
  }

  .log-text {
    color: #334155;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .corrective-actions-cluster {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  .btn-corrective {
    flex: 1;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 0;

    &.primary {
      background: #ef4444;
      color: #ffffff;
    }

    &.secondary {
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #cbd5e1;
    }
  }
</style>
