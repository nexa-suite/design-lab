---
// Hero Section: Bürocratik Awwwards SOTD Forensic Architectural Silhouette with Interactive Circuit
import { generateContainerCommands, commandsToSvgPath } from '../../lib/nexafy/geometry';
import { NEXAFY_PRESETS } from '../../lib/nexafy/presets';

const heroDormantPath = commandsToSvgPath(generateContainerCommands(NEXAFY_PRESETS.DORMANT));
const heroChannelsPath = commandsToSvgPath(generateContainerCommands(NEXAFY_PRESETS.CHANNELS));
---

<section class="hero-section" id="hero" aria-labelledby="hero-heading">
  <!-- Sculpted Continuous Frame Container with Parametric Path Data -->
  <div 
    class="hero-sculpted-canvas" 
    id="hero-sculpted-canvas"
    data-path-dormant={heroDormantPath}
    data-path-channels={heroChannelsPath}
  >
    
    <!-- 1. Unified Architectural SVG Silhouette Background -->
    <svg 
      class="hero-silhouette-svg" 
      viewBox="0 0 1440 820" 
      preserveAspectRatio="none" 
      aria-hidden="true"
    >
      <defs>
        <radialGradient id="canvas-radial-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#0e3d6b" stop-opacity="0.6" />
          <stop offset="100%" stop-color="#082846" stop-opacity="0" />
        </radialGradient>
        <pattern id="hero-blueprint-grid" width="36" height="36" patternUnits="userSpaceOnUse">
          <path d="M 36 0 L 0 0 0 36" fill="none" stroke="rgba(56, 189, 248, 0.22)" stroke-width="1" />
          <circle cx="0" cy="0" r="1.5" fill="rgba(56, 189, 248, 0.35)" />
          <circle cx="36" cy="36" r="1.5" fill="rgba(56, 189, 248, 0.35)" />
        </pattern>
        <clipPath id="hero-silhouette-clip">
          <path d={heroDormantPath} />
        </clipPath>
      </defs>
      <!-- The continuous sculpted contour path matching Bürocratik SOTD geometry generated by Nexafy -->
      <path 
        class="hero-silhouette-path" 
        d={heroDormantPath}
        fill="#082846"
      />
      <!-- Ambient Radial Backlight Glow within the frame -->
      <rect x="0" y="0" width="1440" height="820" fill="url(#canvas-radial-glow)" clip-path="url(#hero-silhouette-clip)" />
      <!-- Architectural Blueprint Grid Pattern ("fondo con cuadraditos") -->
      <rect x="0" y="0" width="1440" height="820" fill="url(#hero-blueprint-grid)" clip-path="url(#hero-silhouette-clip)" opacity="0.65" />
    </svg>

    <!-- 2. TOP LAYER (Notches & Elevated Crown Content) -->
    <header class="hero-top-layer">
      <!-- Top-Left White Notch: Brand & Primary Links -->
      <div class="hero-top-left">
        <a href="/" class="nexa-brand" aria-label="Nexa Platform">
          <img src="/assets/nexa-nx-blue.svg" alt="Nexa" width="28" height="28" class="nexa-brand-logo" />
          <span class="nexa-brand-word">Nexa</span>
        </a>

        <nav class="hero-nav-links" aria-label="Primary navigation">
          <a href="/about" class="hero-nav-link">About</a>
          <a href="/nexafy" class="hero-nav-link">Nexafy</a>
          <a href="#market" class="hero-nav-link">Market</a>
        </nav>
      </div>

      <!-- Top-Center Crown: Monumental Editorial Headline -->
      <div class="hero-top-center">
        <div class="hero-crown-content">
          <h1 id="hero-heading" class="hero-main-title">
            Unlock your B2B<br />
            supply network
          </h1>
          <p class="hero-main-sub">
            The easiest way to access wholesale cold-chain and direct deliveries
          </p>
        </div>
      </div>

      <!-- Top-Right White Notch: Language, CTA & Login -->
      <div class="hero-top-right">
        <div class="hero-lang-pill" aria-label="Language selector">
          <button type="button" class="lang-toggle-btn active" aria-label="Selected language English">EN</button>
          <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="2 4 6 8 10 4"></polyline>
          </svg>
        </div>

        <a href="#book-demo" class="hero-book-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Book a Demo</span>
        </a>

        <a href="#login" class="hero-login-btn">
          <span>Login</span>
        </a>

        <!-- Mobile Drawer Trigger -->
        <button 
          type="button" 
          class="hero-mobile-trigger" 
          id="hero-menu-trigger" 
          aria-label="Open navigation menu"
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <!-- 3. CENTER STAGE (Authentic Symmetric Autolayout Cold-Chain Circuit) -->
    <div class="hero-center-stage" id="circuit-stage">
      
      <!-- CHAPTER 1 VIEW: CHANNELS & SECURITY -->
      <div class="hero-chapter-view active" id="hero-chapter-1-view">
        
        <!-- 1. The Origin Node: TERMINAL PESQUERO CALLAO -->
        <div class="circuit-hub origin-hub" id="circuit-hub" role="region" aria-label="Terminal Pesquero Callao">
          <div class="hub-label">
            <span class="hub-kicker">TERMINAL</span>
            <span class="hub-title">PESQUERO</span>
            <span class="hub-badge">CALLAO · B2B</span>
          </div>
        </div>

        <!-- 2. Continuous Vascular Conduit Circuit (Organically Bending SVG Conduits) -->
        <svg 
          class="circuit-svg" 
          viewBox="0 0 1140 420" 
          fill="none" 
          xmlns="http://www.w3.org/2000/svg" 
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        >
          <!-- Main Trunk: Origin Node (x:150) -> Nexa Core Bus (x:340) -->
          <path 
            class="circuit-pipe-line line-trunk" 
            d="M 150 210 L 340 210" 
            stroke="#bae6fd" 
            stroke-width="26" 
            stroke-linecap="round"
          />

          <!-- Branch 1 (Top Conduit to Station 01: Despacho en Bahía) -->
          <path 
            class="circuit-pipe-line line-branch-top line-store" 
            d="M 460 210 L 515 210 A 18 18 0 0 0 533 192 L 533 88 A 18 18 0 0 1 551 70 L 590 70" 
            stroke="#bae6fd" 
            stroke-width="24" 
            stroke-linejoin="round"
          />

          <!-- Branch 2 (Center Conduit to Station 02: Telemetría Sensirion IoT) -->
          <path 
            class="circuit-pipe-line line-branch-mid line-email" 
            d="M 460 210 L 590 210" 
            stroke="#bae6fd" 
            stroke-width="24" 
            stroke-linecap="round"
          />

          <!-- Branch 3 (Bottom Conduit to Station 03: Custodia Escrow 100%) -->
          <path 
            class="circuit-pipe-line line-branch-bot line-online" 
            d="M 460 210 L 515 210 A 18 18 0 0 1 533 228 L 533 332 A 18 18 0 0 0 551 350 L 590 350" 
            stroke="#bae6fd" 
            stroke-width="24" 
            stroke-linejoin="round"
          />

          <!-- Exit Conduit from Station 01 (x:870, y:70) merging to Destination Hub (x:975, y:210) -->
          <path 
            class="circuit-pipe-line line-exit-top" 
            d="M 870 70 L 910 70 A 18 18 0 0 1 928 88 L 928 192 A 18 18 0 0 0 946 210 L 975 210" 
            stroke="#bae6fd" 
            stroke-width="24" 
            stroke-linejoin="round"
          />

          <!-- Exit Conduit from Station 02 (x:870, y:210) into Destination Hub -->
          <path 
            class="circuit-pipe-line line-exit-mid" 
            d="M 870 210 L 975 210" 
            stroke="#bae6fd" 
            stroke-width="24" 
            stroke-linecap="round"
          />

          <!-- Exit Conduit from Station 03 (x:870, y:350) merging to Destination Hub (x:975, y:210) -->
          <path 
            class="circuit-pipe-line line-exit-bot line-shield" 
            d="M 870 350 L 910 350 A 18 18 0 0 0 928 332 L 928 228 A 18 18 0 0 1 946 210 L 975 210" 
            stroke="#bae6fd" 
            stroke-width="24" 
            stroke-linejoin="round"
          />

          <!-- Pulse Indicators moving through conduits -->
          <circle cx="245" cy="210" r="5" fill="#2563eb" class="pipe-pulse pulse-1" />
          <circle cx="533" cy="140" r="4.5" fill="#38bdf8" class="pipe-pulse pulse-2" />
          <circle cx="533" cy="280" r="4.5" fill="#2563eb" class="pipe-pulse pulse-3" />
        </svg>

        <!-- 3. Central Router Node: NEXA CORE BUS -->
        <div class="circuit-center-hub" id="circuit-center-hub" aria-label="Nexa Core Bus">
          <div class="center-hub-content">
            <img src="/assets/nexa-nx-white.svg" alt="NX" width="26" height="26" class="center-hub-icon" />
            <span class="center-hub-title">NEXA HUB</span>
            <span class="center-hub-sub">Core Dispatch Bus</span>
          </div>
        </div>

        <!-- 4. Three Symmetrically Aligned White Station Blocks (Zero Overlap, Pure Autolayout) -->
        <div class="circuit-stations-column" aria-label="Estaciones Operativas de Cadena de Frío">
          
          <!-- Station 01: Despacho en Bahía -->
          <article class="station-card station-top channel-card card-store" aria-label="Estación 01: Despacho en Bahía">
            <div class="station-header">
              <span class="station-icon-wrap blue">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              </span>
              <div class="station-titles">
                <span class="station-step-tag">01 · DESPACHO EN BAHÍA</span>
                <strong class="station-name">Muelle Callao · Rampa 04</strong>
              </div>
              <span class="station-pill-state">FEFO ACTIVO</span>
            </div>
            <div class="station-footer">
              <span class="station-meta text-mono">Lote L-8841 · 500 kg Salmón</span>
              <span class="station-status-dot active" title="Rampa conectada"></span>
            </div>
          </article>

          <!-- Station 02: Telemetría Sensirion IoT -->
          <article class="station-card station-mid channel-card card-email" aria-label="Estación 02: Telemetría Sensirion IoT">
            <div class="station-header">
              <span class="station-icon-wrap cyan">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path>
                </svg>
              </span>
              <div class="station-titles">
                <span class="station-step-tag">02 · TELEMETRÍA IOT</span>
                <strong class="station-name">Sensirion Frío Continuo</strong>
              </div>
              <span class="station-temp-badge text-mono">-18.2°C</span>
            </div>
            <div class="station-footer">
              <span class="station-meta text-mono">GPS Muelle Callao -> ICISA</span>
              <span class="station-pill-ok">Cadena 100% OK</span>
            </div>
          </article>

          <!-- Station 03: Custodia Escrow 100% -->
          <article class="station-card station-bot channel-card card-online" aria-label="Estación 03: Custodia Escrow 100%">
            <div class="station-header">
              <span class="station-icon-wrap navy">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </span>
              <div class="station-titles">
                <span class="station-step-tag">03 · CUSTODIA ESCROW</span>
                <strong class="station-name">Smart Contract GS1-128</strong>
              </div>
              <span class="station-amount-badge text-mono">$3,450.00</span>
            </div>
            <div class="station-footer">
              <span class="station-meta text-mono">Pre-autorizado · Cero Riesgo</span>
              <span class="station-lock-pill">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>Bloqueado</span>
              </span>
            </div>
          </article>

        </div>

        <!-- 5. The Destination Node: SUPERMERCADOS & RETAIL B2B -->
        <div class="circuit-dest-node" aria-label="Destino Supermercados & Retail B2B">
          <div class="dest-node-content">
            <span class="dest-node-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l1-5h16l1 5"></path>
                <path d="M3 9a2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 3 0"></path>
                <path d="M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"></path>
                <path d="M9 20v-6h6v6"></path>
              </svg>
            </span>
            <span class="dest-node-title">RETAIL B2B</span>
            <span class="dest-node-sub">Supermercados Lima</span>
            <span class="dest-node-badge">RECEPTOR</span>
          </div>
        </div>

      </div>

      <!-- CHAPTER 2 VIEW: SAAS DASHBOARD PLATFORM MORPH (Matching elem-62d69ee3 video & frame 1400) -->
      <div class="hero-chapter-view" id="hero-chapter-2-view" style="display: none; opacity: 0;">
        <div class="saas-morph-backdrop-plate" aria-hidden="true">
          <button type="button" class="saas-send-link-btn" aria-label="Send Flecto Link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <span>Send Flecto Link</span>
          </button>
        </div>

        <!-- Left Customer Profile Card (John Cooper) -->
        <div class="saas-customer-profile-card">
          <div class="profile-avatar-wrap">
            <img src="/assets/synthetic/avatar-customer.svg" alt="John Cooper" width="44" height="44" class="profile-avatar-img" />
          </div>
          <strong class="profile-name">John Cooper</strong>
          <span class="profile-role">Photography Store</span>
          <div class="profile-actions-row">
            <button type="button" class="profile-btn" aria-label="Email John Cooper">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <span>email</span>
            </button>
            <button type="button" class="profile-btn" aria-label="Call John Cooper">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="3"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
              <span>mobile</span>
            </button>
          </div>
        </div>
        
        <!-- Center SaaS Items Card -->
        <div class="hero-saas-card-frame">
          <div class="saas-modal-top-tags">
            <span class="saas-pill-tag ongoing">On Going</span>
            <span class="saas-pill-tag notpaid">• Not Paid</span>
          </div>

          <div class="saas-items-table-section">
            <div class="saas-table-header-row">
              <strong class="section-title">Items</strong>
              <div class="table-col-labels text-mono">
                <span>Unit Price</span>
                <span>Deposit Price</span>
                <span>Total (5d)</span>
              </div>
            </div>
            <div class="saas-item-row">
              <div class="item-name-group">
                <img src="/assets/synthetic/camera-vector.svg" width="28" height="24" alt="Action Camera" style="border-radius: 4px; object-fit: contain;" />
                <span class="item-title">GoPro HERO10</span>
              </div>
              <div class="item-prices-group text-mono">
                <span>€100 <small>/day</small></span>
                <span>€200 <small>/booking</small></span>
                <span class="item-total-bold">€700.00</span>
              </div>
            </div>
          </div>

          <div class="saas-services-table-section">
            <strong class="section-title">Additional Services</strong>
            <div class="saas-service-row">
              <div class="service-name-group">
                <span class="service-icon delivery" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                </span>
                <div>
                  <strong>Delivery</strong>
                  <small>Pick-up & Return</small>
                </div>
              </div>
              <div class="service-prices text-mono">
                <span>€20 <small>/booking</small></span>
                <span class="service-total">€20.00</span>
              </div>
            </div>

            <div class="saas-service-row">
              <div class="service-name-group">
                <span class="service-icon insurance" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                </span>
                <div>
                  <strong>Insurance</strong>
                </div>
              </div>
              <div class="service-prices text-mono">
                <span>€20 <small>/booking</small></span>
                <span class="service-total">€20.00</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Date Card on the right (Matching full_f0160.png) -->
        <div class="saas-floating-date-card">
          <span class="date-card-label">Dates</span>
          <span class="date-card-duration">5-day rental</span>
          <div class="date-card-range text-mono">
            <span>20/03/2022 - 24/03/2022</span>
            <span class="date-arrow">∨</span>
          </div>
          <div class="date-toggle-row">
            <span class="toggle-pill-switch" aria-hidden="true"></span>
            <span class="toggle-label-text">Schedule Delivery & Pick up on my Calendar</span>
          </div>
        </div>
      </div>

      <!-- CHAPTER 3 VIEW: SAFE RENTING & PAYMENT MORPH (Matching elem-62d69ee3 and elem-62d6a034 videos) -->
      <div class="hero-chapter-view" id="hero-chapter-3-view" style="display: none; opacity: 0;">
        
        <!-- Left Side: Multiple Payment Methods Circuit -->
        <div class="ch3-left-circuit">
          <div class="ch3-stem-horizontal">
            <span class="ch3-stem-label">Multiple Payment Methods</span>
          </div>
          <div class="ch3-toggle-capsule">
            <div class="ch3-switch-pill active" role="switch" aria-checked="true" aria-label="Digital Payments toggle">
              <span class="ch3-switch-ball"></span>
            </div>
            <span class="ch3-toggle-text">Digital Payments</span>
          </div>
          
          <!-- Stepped circuit lines and provider chips -->
          <div class="ch3-chips-grid">
            <div class="ch3-chip chip-mbway" title="MB WAY">
              <span class="chip-mb-text">MB</span>
            </div>
            <div class="ch3-chip chip-paypal" title="PayPal">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#003087">
                <path d="M20.067 8.478c.492.88.556 2.014.3 3.327-.74 3.799-3.324 5.727-7.464 5.727H9.282c-.41 0-.76.307-.828.712l-1.096 6.947c-.035.215.132.409.35.409h3.874c.36 0 .666-.269.726-.624l.732-4.636c.06-.355.366-.624.726-.624h1.168c3.633 0 6.474-1.476 7.301-5.719.349-1.787.126-3.235-.668-4.22z"/>
                <path d="M18.73 3.655C17.653 2.5 15.65 2 13.06 2H6.96c-.496 0-.918.37-1 .862L3.02 21.36c-.042.261.16.49.424.49h4.378l1.1-6.973c.068-.405.418-.712.828-.712h2.518c4.14 0 6.724-1.928 7.464-5.727.42-2.155.105-3.69-.998-4.783z" fill="#0079C1"/>
              </svg>
            </div>
            <div class="ch3-chip chip-mastercard" title="Mastercard">
              <svg width="24" height="16" viewBox="0 0 32 20">
                <circle cx="10" cy="10" r="9" fill="#EB001B"/>
                <circle cx="22" cy="10" r="9" fill="#F79E1B" fill-opacity="0.85"/>
              </svg>
            </div>
            <div class="ch3-chip chip-applepay" title="Apple Pay">
              <svg width="24" height="14" viewBox="0 0 32 20" fill="#000000">
                <path d="M5.4 6.2c.4-.5.7-1.2.6-1.9-.6 0-1.3.4-1.7.9-.4.4-.7 1.1-.6 1.8.7.1 1.3-.3 1.7-.8zm.6 1c-.9 0-1.7.5-2.2.5-.5 0-1.2-.5-2-.5-1 0-2 .6-2.5 1.5-1.1 1.9-.3 4.7.8 6.2.5.8 1.1 1.6 1.9 1.6.8 0 1.1-.5 2.1-.5 1 0 1.2.5 2.1.5.8 0 1.4-.8 1.9-1.6.6-.9.8-1.7.8-1.8-.1 0-1.6-.6-1.6-2.4 0-1.5 1.2-2.2 1.3-2.3-.7-1-1.8-1.1-2.2-1.2-.5-.1-1.8-.5-2.5-.5z"/>
                <text x="11" y="14" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="600" fill="#000">Pay</text>
              </svg>
            </div>
          </div>
        </div>

        <!-- Center: Glowing Phone Mockup & Confetti -->
        <div class="ch3-phone-wrapper">
          <canvas id="ch3-confetti-canvas" class="ch3-confetti-canvas" width="400" height="300" aria-hidden="true"></canvas>
          <div class="ch3-phone-chassis">
            <!-- Screen state: Payment Done -->
            <div class="ch3-phone-content">
              <div class="ch3-check-box">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <h3 class="ch3-payment-done-title">
                Payment<br />Done
              </h3>
              <button type="button" class="ch3-phone-done-btn" id="ch3-done-action-btn">
                <span>Done</span>
              </button>
            </div>
          </div>

          <!-- Restart button under phone -->
          <button type="button" class="ch3-restart-pill" id="ch3-restart-btn" aria-label="Restart Payment Simulation">
