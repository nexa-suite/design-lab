---
/**
 * PhoneCheckoutSimulator Component
 * Chapter 3 (Safe Renting & Payments): Mobile customer flow with milestones (Reserve, Verify, Collect, Pay).
 */
interface Props {
  productName?: string;
  price?: string;
}

const {
  productName = 'GoPro HERO10 Black',
  price = '€100 / day'
} = Astro.props;
---

<div class="ch3-phone-wrapper">
  <div class="ch3-phone-shell">
    <div class="phone-dynamic-island"></div>
    
    <div class="phone-app-content">
      <div class="phone-top-bar">
        <span class="phone-time text-mono">09:41</span>
        <span class="phone-network">5G</span>
      </div>

      <div class="phone-product-card">
        <img src="/assets/synthetic/camera-vector.svg" alt={productName} class="phone-product-img" />
        <div class="phone-product-meta">
          <strong class="phone-product-title">{productName}</strong>
          <span class="phone-product-price text-mono">{price}</span>
        </div>
      </div>

      <!-- Milestones Timeline Indicator -->
      <div class="ch3-milestones-track">
        <div class="milestone-step done">
          <span class="step-dot"></span>
          <span class="step-label">Reserve</span>
        </div>
        <div class="milestone-line done"></div>
        <div class="milestone-step done">
          <span class="step-dot"></span>
          <span class="step-label">Verify</span>
        </div>
        <div class="milestone-line done"></div>
        <div class="milestone-step done">
          <span class="step-dot"></span>
          <span class="step-label">Collect</span>
        </div>
        <div class="milestone-line active"></div>
        <div class="milestone-step active">
          <span class="step-dot"></span>
          <span class="step-label">Pay</span>
        </div>
      </div>

      <!-- Payment Done State Banner -->
      <div class="ch3-payment-done-banner">
        <span class="done-check-icon">✓</span>
        <div class="done-text-col">
          <strong>Payment Done</strong>
          <small>Automated escrow deposit secured</small>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ch3-phone-wrapper {
    width: 280px;
    height: 380px;
    background: #ffffff;
    border-radius: 28px;
    border: 4px solid var(--stage-card);
    overflow: hidden;
    position: relative;
    padding: 0.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transition: border-color 0.3s ease;
  }

  .phone-dynamic-island {
    width: 60px;
    height: 14px;
    background: var(--stage-capsule-bg);
    border-radius: 999px;
    margin: 0 auto 0.5rem auto;
    transition: background-color 0.3s ease;
  }

  .phone-top-bar {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--stage-text);
    margin-bottom: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .phone-product-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #f1f5f9;
    padding: 0.5rem;
    border-radius: 10px;
    margin-bottom: 0.75rem;
  }

  .phone-product-img {
    width: 40px;
    height: 35px;
    object-fit: contain;
  }

  .phone-product-title {
    font-size: 0.75rem;
    display: block;
    color: #0f172a;
  }

  .phone-product-price {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #0284c7;
    font-family: 'JetBrains Mono', monospace;
  }

  .ch3-milestones-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 1rem 0;
  }

  .milestone-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.5625rem;
    color: #94a3b8;
  }

  .milestone-step.done, .milestone-step.active {
    color: var(--stage-text);
    font-weight: 700;
  }

  .step-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .milestone-step.done .step-dot {
    background: var(--stage-card);
  }

  .milestone-step.active .step-dot {
    background: var(--stage-capsule-bg);
  }

  .milestone-line {
    flex: 1;
    height: 2px;
    background: #e2e8f0;
  }

  .milestone-line.done {
    background: var(--stage-card);
  }

  .ch3-payment-done-banner {
    background: var(--stage-card);
    border-radius: 10px;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--stage-text);
    margin-top: 1rem;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .done-check-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--stage-capsule-bg);
    color: var(--stage-card);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 11px;
    flex-shrink: 0;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .done-text-col strong {
    font-size: 0.75rem;
    display: block;
  }

  .done-text-col small {
    font-size: 0.625rem;
  }
</style>
