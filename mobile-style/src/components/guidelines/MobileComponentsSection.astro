<span class="ann">@OptIn</span>(ExperimentalMaterial3Api::<span class="kw">class</span>)
<span class="ann">@Composable</span>
<span class="kw">fun</span> <span class="fn">NexaTopAppBar</span>(
    title: <span class="type">String</span>,
    modifier: <span class="type">Modifier</span> = Modifier,
    navigationIcon: <span class="ann">@Composable</span> () -> <span class="type">Unit</span> = {},
    actions: <span class="ann">@Composable</span> <span class="type">RowScope</span>.() -> <span class="type">Unit</span> = {}
) {
    <span class="fn">TopAppBar</span>(
        title = { <span class="fn">Text</span>(text = title, style = NexaTypography.titleMedium) },
        navigationIcon = navigationIcon,
        actions = actions,
        colors = TopAppBarDefaults.topAppBarColors(
            containerColor = NexaSurfaceContainerHigh
        ),
        modifier = modifier.<span class="fn">height</span>(<span class="num">56.dp</span>)
    )
}

<span class="ann">@Composable</span>
<span class="kw">fun</span> <span class="fn">NexaBottomNavigationBar</span>(
    selectedRoute: <span class="type">String</span>,
    onNavigateToRoute: (<span class="type">String</span>) -> <span class="type">Unit</span>,
    modifier: <span class="type">Modifier</span> = Modifier,
    destinations: <span class="type">List</span>&lt;<span class="type">NexaNavDestination</span>&gt;
) {
    <span class="fn">NavigationBar</span>(
        modifier = modifier.<span class="fn">height</span>(<span class="num">64.dp</span>), <span class="comm">// Altura canónica 64dp</span>
        containerColor = NexaSurfaceContainerHigh
    ) {
        destinations.<span class="fn">forEach</span> { dest ->
            <span class="kw">val</span> isSelected = selectedRoute == dest.route
            <span class="fn">NavigationBarItem</span>(
                selected = isSelected,
                onClick = { onNavigateToRoute(dest.route) },
                icon = {
                    <span class="kw">if</span> (dest.badgeCount > <span class="num">0</span>) {
                        <span class="fn">BadgedBox</span>(badge = { <span class="fn">Badge</span> { <span class="fn">Text</span>(dest.badgeCount.toString()) } }) {
                            <span class="fn">Icon</span>(imageVector = dest.icon, contentDescription = dest.label)
                        }
                    } <span class="kw">else</span> {
                        <span class="fn">Icon</span>(imageVector = dest.icon, contentDescription = dest.label)
                    }
                },
                label = { <span class="fn">Text</span>(text = dest.label, style = NexaTypography.labelMedium) }
            )
        }
    }
}

