    background: #2563eb;
    border-radius: 2px;
  }

  .station-sparkline-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .mini-sparkline {
    width: 130px;
    height: 15px;
  }

  .sparkline-val {
    font-size: 10px;
    font-weight: 700;
    color: #0284c7;
  }

  .station-trigger-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10px;
  }

  .trigger-label {
    color: #64748b;
  }

  .trigger-condition {
    color: #2563eb;
    font-weight: 700;
  }

  .drag-handle-grip {
    cursor: grab;
    color: #94a3b8;
    font-size: 14px;
    line-height: 1;
    user-select: none;
    padding: 2px 4px;
    transition: color 0.15s ease;
  }

  .drag-handle-grip:hover {
    color: #38bdf8;
  }

  .hub-grip {
    position: absolute;
    top: 10px;
    right: 12px;
  }

  .drag-coords-hud {
    position: absolute;
    top: 14px;
    left: 20px;
    z-index: 60;
    display: none;
    align-items: center;
    gap: 8px;
    background: rgba(8, 40, 70, 0.94);
    border: 1px solid #38bdf8;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 999px;
    padding: 6px 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }

  .hud-pill-tag {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ffffff;
    background: #0284c7;
    padding: 2px 7px;
    border-radius: 6px;
  }

  .hud-coords-text {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 11.5px;
    font-weight: 700;
    color: #bae6fd;
  }

  .station-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .station-icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .station-icon-wrap.blue {
    background: rgba(37, 99, 235, 0.12);
    color: #2563eb;
  }

  .station-icon-wrap.cyan {
    background: rgba(56, 189, 248, 0.15);
    color: #0284c7;
  }

  .station-titles {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  .station-step-tag {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 8.5px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.04em;
  }

  .station-name {
    font-size: 11.5px;
    font-weight: 800;
    color: #082846;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .station-pill-state {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 8.5px;
    font-weight: 700;
    background: #f1f5f9;
    color: #475569;
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
