---
/**
 * LIVING ENGINE WORKBENCH & INTERACTIVE MODULAR GRAPHICS ENGINE
 * Authority: Nexafy living geometry system, pure solid colorimetry, and interactive modular puzzle blocks.
 * 
 * Features:
 *  - 100% Nexa Colorimetry: Nexa Dark Blue (#082846) sculpted plate, Nexa Celeste (#38c8ff) accents,
 *    28px thick vascular conduits in Celeste Pastel (#bae6fd) / Soft Cyan (#a5f3fc), pure white (#ffffff) frame.
 *  - True Interactive Living Graphics Engine: Drag & drop blocks with real-time Manhattan orthogonal
 *    28px conduit recalculation and rounded fillets (r=20-28px) at 60 FPS.
 *  - Signal pulse particles (r=6) continuously flowing through the center lumen of conduits.
 *  - Minimalist Modular Blocks inspired by Image 2:
 *    * Hub Core Block (Nexa Modular Hub)
 *    * Interlocking Logic Blocks (A, B, C)
 *    * Origin Hub: YOUR COMPANY (#38c8ff, #082846 text)
 *    * Physical Store POS Card ($100/caja or 100€/Day)
 *    * Customer Inquiry Card (John Cooper avatar)
 *    * Online Store Card (acme.store, $100/Caja | DESPACHAR)
 *    * Escrow Terminal Card (100% Custody · Zero Risk)
 *  - NO overlapping blocks ("no esten sobrepuestos"): Generous spacing and dedicated clearances.
 *  - Dynamic Assembly "✦ Construir Motor (Build)" sequential spring docking animation.
 *  - Presets: [✦ Distribución Canales], [⚡ Matriz Operativa], [🛡 Custodia Escrow], [↺ Resetear].
 *  - Sculpted Bürocratik container with carved canopy notch and monumental headline.
 */
import { generateContainerCommands, commandsToSvgPath } from '../../lib/nexafy/geometry';
import { NEXAFY_PRESETS } from '../../lib/nexafy/presets';

const heroSilhouettePath = commandsToSvgPath(generateContainerCommands(NEXAFY_PRESETS.CHANNELS));
---

<div class="workbench-master-container" id="workbench-master">
  <!-- 1. Interactive Master Engine Toolbar -->
  <header class="workbench-toolbar-bar" aria-label="Living Engine Master Controls">
    <div class="toolbar-left-group">
      <div class="toolbar-title-wrap">
        <span class="toolbar-live-badge"><i class="live-dot"></i> EN VIVO</span>
        <strong class="toolbar-main-title">Motor Gráfico Nexafy</strong>
      </div>

      <!-- Action Button: Construir Motor (Build Animation) -->
      <button type="button" class="btn-engine-build" id="btn-build-engine" title="Construir y ensamblar el motor gráfico paso a paso con acople elástico">
        <i class="pi pi-sparkles"></i>
        <span>✦ Construir Motor (Build)</span>
      </button>

      <!-- Presets Group -->
      <div class="preset-pill-group" role="group" aria-label="Presets de distribución">
        <button type="button" class="preset-btn active" data-preset="channels" title="Distribución de Canales Canónica">
          <span>✦ Canales</span>
        </button>
        <button type="button" class="preset-btn" data-preset="matrix" title="Matriz Operativa Pipeline">
          <span>⚡ Matriz Operativa</span>
        </button>
        <button type="button" class="preset-btn" data-preset="escrow" title="Arquitectura Custodia Escrow">
          <span>🛡 Custodia Escrow</span>
        </button>
        <button type="button" class="preset-btn reset-btn" data-preset="reset" title="Restablecer posiciones canónicas">
          <span>↺ Resetear</span>
        </button>
      </div>
    </div>

    <div class="toolbar-center-group">
      <!-- Human Ergonomic Tones Switcher -->
      <div class="human-tones-toggle" role="group" aria-label="Tono del Canvas">
        <span class="tones-label">Tono:</span>
        <button 
          type="button" 
          class="tone-pill active" 
          data-tone="nexa" 
          data-plate="#082846" 
          data-accent="#38c8ff" 
          data-conduit="#bae6fd" 
          title="Nexa Dark Blue (#082846 & #38c8ff)"
        >
          <span class="color-swatch" style="background: #082846; border: 1.5px solid #38c8ff;"></span>
          <span>Nexa Blue</span>
        </button>
        <button 
          type="button" 
          class="tone-pill" 
          data-tone="ceramic" 
          data-plate="#1d3d63" 
          data-accent="#38bdf8" 
          data-conduit="#a5f3fc" 
          title="Ceramic Azure (#1d3d63 & #38bdf8)"
        >
          <span class="color-swatch" style="background: #1d3d63; border: 1.5px solid #38bdf8;"></span>
          <span>Ceramic Azure</span>
        </button>
        <button 
          type="button" 
          class="tone-pill" 
          data-tone="cashmere" 
          data-plate="#283a48" 
          data-accent="#7dd3fc" 
          data-conduit="#bae6fd" 
          title="Cashmere Arctic Mist (#283a48 & #7dd3fc)"
        >
          <span class="color-swatch" style="background: #283a48; border: 1.5px solid #7dd3fc;"></span>
          <span>Cashmere Mist</span>
        </button>
        <button 
          type="button" 
          class="tone-pill" 
          data-tone="oceanic" 
          data-plate="#0c2038" 
          data-accent="#38bdf8" 
          data-conduit="#93c5fd" 
          title="Deep Cold Chain (#0c2038 & #38bdf8)"
        >
          <span class="color-swatch" style="background: #0c2038; border: 1.5px solid #38bdf8;"></span>
          <span>Deep Navy</span>
        </button>
      </div>

      <!-- Conduit Pastel Tone Selector -->
      <div class="conduit-palette-toggle" role="group" aria-label="Conductos 28px">
        <span class="conduit-toggle-label">Conductos 28px:</span>
        <button type="button" class="conduit-pill active" data-pastel="#bae6fd" title="Celeste Pastel (#bae6fd)">
          <span class="color-swatch" style="background: #bae6fd;"></span> Celeste
        </button>
        <button type="button" class="conduit-pill" data-pastel="#a5f3fc" title="Soft Cyan (#a5f3fc)">
          <span class="color-swatch" style="background: #a5f3fc;"></span> Cyan
        </button>
        <button type="button" class="conduit-pill" data-pastel="#93c5fd" title="Ice Blue (#93c5fd)">
          <span class="color-swatch" style="background: #93c5fd;"></span> Ice Blue
        </button>
      </div>
    </div>

    <div class="toolbar-right-group">
      <!-- Collision Status Badge -->
      <div class="collision-pill" id="workbench-collision-badge" title="Validación topológica sin solapamientos">
        <i class="pi pi-check-circle"></i>
        <span id="collision-text">0 Colisiones</span>
      </div>

      <!-- Toggle Developer Inspector -->
      <button type="button" class="workbench-action-btn secondary" id="btn-toggle-inspector" title="Abrir Inspector de Coordenadas y Topología">
        <i class="pi pi-code"></i>
        <span>📐 Inspector</span>
      </button>
    </div>
  </header>

  <!-- 2. Sculpted Bürocratik Canvas Stage Frame -->
  <section class="workbench-hero-stage" id="workbench-hero-stage" aria-label="Escenario Motor Gráfico Nexafy">
    <div class="hero-sculpted-canvas" id="hero-sculpted-canvas">

      <!-- 2.1 Unified Architectural SVG Silhouette Background -->
      <svg 
        class="hero-silhouette-svg" 
        viewBox="0 0 1440 820" 
        preserveAspectRatio="none" 
        aria-hidden="true"
      >
        <defs>
          <radialGradient id="workbench-radial-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#0e3d6b" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#082846" stop-opacity="0" />
          </radialGradient>
          <pattern id="workbench-blueprint-grid" width="36" height="36" patternUnits="userSpaceOnUse">
            <path d="M 36 0 L 0 0 0 36" fill="none" stroke="rgba(56, 189, 248, 0.22)" stroke-width="1" />
            <circle cx="0" cy="0" r="1.5" fill="rgba(56, 189, 248, 0.35)" />
            <circle cx="36" cy="36" r="1.5" fill="rgba(56, 189, 248, 0.35)" />
          </pattern>
        </defs>
        <!-- The continuous sculpted contour path matching Bürocratik SOTD geometry -->
        <path 
          class="hero-silhouette-path" 
          d={heroSilhouettePath}
          fill="#082846"
        />
        <!-- Ambient Radial Backlight Glow within the frame -->
        <rect x="0" y="0" width="1440" height="820" fill="url(#workbench-radial-glow)" />
        <!-- Architectural Blueprint Grid Pattern ("fondo con cuadraditos") -->
        <rect x="0" y="0" width="1440" height="820" fill="url(#workbench-blueprint-grid)" opacity="0.65" />
      </svg>

      <!-- 2.2 TOP LAYER (Notches & Monumental Headline Canopy) -->
      <header class="hero-top-layer">
        <!-- Top-Left White Notch: Nexa Brand & Primary Links -->
        <div class="hero-top-left">
          <a href="#" class="nexa-brand" aria-label="Nexafy Homepage">
            <img src="/assets/nexa-nx-blue.svg" alt="Nexa" width="28" height="28" style="display: block;" />
            <span class="nexa-logo-word">Nexafy</span>
          </a>

          <nav class="hero-nav-links" aria-label="Primary navigation">
            <a href="/about" class="hero-nav-link">About</a>
            <a href="/nexafy" class="hero-nav-link active">Motor Gráfico</a>
            <a href="/interactive-suite" class="hero-nav-link">Canales</a>
            <a href="/artifacts" class="hero-nav-link">Custodia</a>
          </nav>
        </div>

        <!-- Top-Center Crown: Monumental Editorial Headline -->
        <div class="hero-top-center">
          <div class="hero-crown-content">
            <h1 id="hero-heading" class="hero-main-title">
              Unlock your B2B supply <br />
              network
            </h1>
            <p class="hero-main-sub">
              The easiest way to access wholesale cold-chain and direct deliveries
            </p>
          </div>
        </div>

        <!-- Top-Right White Notch: CTA & Login -->
        <div class="hero-top-right">
          <a href="#book-demo" class="hero-book-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Book a Demo</span>
          </a>

          <a href="#login" class="hero-login-btn">
            <span>Login</span>
          </a>
        </div>
      </header>

      <!-- 2.3 CENTER STAGE (Interactive Living Graphics Engine Canvas) -->
      <div class="hero-center-stage" id="workbench-center-stage">
        
        <!-- Live Dragging HUD / Coordinates Tooltip -->
        <div class="drag-coords-hud" id="workbench-drag-hud" style="display: none;">
          <span class="hud-pill-tag">MOTOR VIVO</span>
          <span class="hud-coords-text" id="hud-coords-text">X: 0px · Y: 0px</span>
        </div>

        <!-- Dynamic Vascular Conduit SVG Layer (Recalculated in Real-Time 60 FPS) -->
        <svg 
          class="circuit-svg-dynamic" 
          id="workbench-circuit-svg"
          viewBox="0 0 1130 580" 
          fill="none" 
          xmlns="http://www.w3.org/2000/svg" 
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <defs>
            <filter id="glow-conduit" x="-10%" y="-10%" width="120%" height="120%">
              <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#38c8ff" flood-opacity="0.3" />
            </filter>
          </defs>

          <!-- Dynamic 28px Thick Vascular Conduits Group -->
          <g class="circuit-conduits-group" id="conduits-group">
            <path id="path-trunk" class="circuit-conduit-path" d="" stroke="#bae6fd" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
            <path id="path-core-logicA" class="circuit-conduit-path" d="" stroke="#bae6fd" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
            <path id="path-core-logicB" class="circuit-conduit-path" d="" stroke="#bae6fd" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
            <path id="path-logicA-logicC" class="circuit-conduit-path" d="" stroke="#bae6fd" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
            <path id="path-logicB-logicC" class="circuit-conduit-path" d="" stroke="#bae6fd" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
            <path id="path-branch-store" class="circuit-conduit-path" d="" stroke="#bae6fd" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
            <path id="path-branch-inquiry" class="circuit-conduit-path" d="" stroke="#bae6fd" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
            <path id="path-branch-online" class="circuit-conduit-path" d="" stroke="#bae6fd" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
            <path id="path-branch-escrow" class="circuit-conduit-path" d="" stroke="#bae6fd" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" />
          </g>

          <!-- Signal Pulse Particles Flowing through the Conduits (r=6px) -->
          <g class="circuit-particles-group" id="particles-group">
            <circle id="particle-trunk" class="pulse-particle" r="6" fill="#38c8ff" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
            <circle id="particle-core-logicA" class="pulse-particle" r="6" fill="#38c8ff" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
            <circle id="particle-core-logicB" class="pulse-particle" r="6" fill="#38c8ff" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
            <circle id="particle-logicA-logicC" class="pulse-particle" r="6" fill="#38c8ff" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
            <circle id="particle-logicB-logicC" class="pulse-particle" r="6" fill="#38c8ff" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
            <circle id="particle-branch-store" class="pulse-particle" r="6" fill="#38c8ff" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
            <circle id="particle-branch-inquiry" class="pulse-particle" r="6" fill="#38c8ff" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
            <circle id="particle-branch-online" class="pulse-particle" r="6" fill="#38c8ff" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
            <circle id="particle-branch-escrow" class="pulse-particle" r="6" fill="#38c8ff" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
          </g>
        </svg>

        <!-- Inline Badges Anchored on Conduits -->
        <div class="circuit-badge badge-store" id="badge-store" aria-hidden="true" title="Canal POS Físico">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#082846" stroke-width="2.2">
            <path d="M3 9l1-5h16l1 5"></path>
            <path d="M3 9a2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 3 0"></path>
            <path d="M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"></path>
            <path d="M9 20v-6h6v6"></path>
          </svg>
        </div>

        <div class="circuit-badge badge-email" id="badge-email" aria-hidden="true" title="Consulta Directa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#082846" stroke-width="2.2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>

        <div class="circuit-badge badge-online" id="badge-online" aria-hidden="true" title="Catálogo Online">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#082846" stroke-width="2.2">
            <rect x="5" y="2" width="14" height="20" rx="3"></rect>
            <circle cx="12" cy="11" r="5"></circle>
            <line x1="7" y1="11" x2="17" y2="11"></line>
            <path d="M12 6a7 7 0 0 1 0 10"></path>
          </svg>
        </div>

        <div class="circuit-badge badge-shield" id="badge-shield" aria-hidden="true" title="Custodia Escrow 100%">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#082846" stroke-width="2.2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>

        <!-- ======================================================================
             THE 9 INTERACTIVE MODULAR PUZZLE BLOCKS (DRAGGABLE & NON-OVERLAPPING)
             ====================================================================== -->

        <!-- BLOCK 1: Origin Hub (YOUR COMPANY) -->
        <div class="modular-block node-origin-hub" id="origin-hub" role="region" aria-label="Origen: Your Company">
          <div class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</div>
          <div class="hub-label">
            <span class="hub-word">CALLAO</span>
            <span class="hub-word">MUELLE 04</span>
          </div>
          <span class="block-tag-sub">ORIGIN HUB · B2B</span>
        </div>

        <!-- BLOCK 2: Nexa Modular Hub Core -->
        <div class="modular-block node-hub-core" id="hub-core" role="region" aria-label="Nexa Hub Core">
          <div class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</div>
          <div class="core-icon-wrap">
            <img src="/assets/nexa-nx-white.svg" alt="NX" width="24" height="24" style="display: block;" />
          </div>
          <strong class="core-title">NEXA HUB</strong>
          <span class="core-sub">Core Dispatch</span>
          <span class="core-dot-indicator"></span>
        </div>

        <!-- BLOCK 3: Interlocking Logic Block A (Dispatch Router) -->
        <div class="modular-block node-logic-puzzle node-logic-a" id="logic-a" role="region" aria-label="Bloque Lógico A: Despacho FEFO">
          <div class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</div>
          <div class="puzzle-header">
            <span class="puzzle-badge">01</span>
            <strong class="puzzle-title">ROUTER</strong>
          </div>
          <span class="puzzle-role">DSP-204 FEFO</span>
          <div class="puzzle-indicator-bar"><span class="bar-fill"></span></div>
        </div>

        <!-- BLOCK 4: Interlocking Logic Block B (IoT Cold Chain) -->
        <div class="modular-block node-logic-puzzle node-logic-b" id="logic-b" role="region" aria-label="Bloque Lógico B: Telemetría Sensirion">
          <div class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</div>
          <div class="puzzle-header">
            <span class="puzzle-badge">02</span>
            <strong class="puzzle-title">SENSIRION</strong>
          </div>
          <span class="puzzle-role">-18.2°C IoT</span>
          <div class="puzzle-indicator-bar"><span class="bar-fill"></span></div>
        </div>

        <!-- BLOCK 5: Interlocking Logic Block C (Escrow Smart) -->
        <div class="modular-block node-logic-puzzle node-logic-c" id="logic-c" role="region" aria-label="Bloque Lógico C: Custodia Escrow">
          <div class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</div>
          <div class="puzzle-header">
            <span class="puzzle-badge">03</span>
            <strong class="puzzle-title">ESCROW</strong>
          </div>
          <span class="puzzle-role">$3,450 B2B</span>
          <div class="puzzle-indicator-bar"><span class="bar-fill"></span></div>
        </div>

        <!-- BLOCK 6: Despacho en Bahía Card -->
        <article class="modular-block channel-card card-store" id="store-card" aria-label="Canal: Despacho en Bahía">
          <div class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</div>
          <div class="card-thumb-wrap">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div class="card-details-col">
            <p class="card-sub-label">Despacho en Bahía</p>
            <p class="card-sub-label"><strong class="channel-bold">Muelle Callao R04</strong></p>
            <span class="card-price-value text-mono">500 kg · IQF</span>
          </div>
        </article>

        <!-- BLOCK 7: Monitoreo Reefer GPS Card -->
        <article class="modular-block channel-card card-email" id="inquiry-card" aria-label="Canal: Monitoreo Reefer">
          <div class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</div>
          <div class="email-card-header">
            <div class="email-avatar-wrap" style="background: rgba(56, 189, 248, 0.15); display: flex; align-items: center; justify-content: center; border-radius: 50%;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="email-meta-info">
              <strong class="email-author-name">Reefer Van B-402</strong>
              <span class="email-timestamp text-mono">-18.2°C</span>
            </div>
          </div>
          <p class="email-body-text">
            ⚡ En Ruta: Muelle Callao &rarr; ICISA Lima Norte. Conforme HACCP.
          </p>
        </article>

        <!-- BLOCK 8: Catálogo B2B Mayorista -->
        <article class="modular-block channel-card card-online" id="online-card" aria-label="Canal: Catálogo Mayorista">
          <div class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</div>
          <div class="online-card-topbar">
            <svg class="browser-lock-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span class="browser-domain-text text-mono">nexa.wholesale/b2b</span>
          </div>

          <div class="online-card-body">
            <div class="card-thumb-wrap wholesale-thumb-wrap">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
            </div>
            <div class="card-details-col">
              <p class="card-sub-label">
                Catálogo Mayorista <br />
                <strong class="channel-bold">Salmón del Pacífico IQF</strong>
              </p>
            </div>
          </div>

          <div class="online-action-capsule">
            <span class="capsule-price text-mono">$24.50/kg</span>
            <span class="capsule-divider" aria-hidden="true">|</span>
            <span class="capsule-rent-btn">
              <span>DESPACHAR</span>
            </span>
          </div>
        </article>

        <!-- BLOCK 9: Escrow Terminal Card (100% Custodia) -->
        <article class="modular-block card-escrow" id="escrow-card" aria-label="Terminal de Custodia Escrow">
          <div class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</div>
          <div class="escrow-header">
