{
  "name": "nexa-design-lab-monorepo",
  "version": "1.3.0",
  "description": "Nexa Suite Design Lab Monorepo: Web Style (Angular), Mobile Style (Android/Flutter), and Website Style (Nexafy Living Geometry).",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "web-style",
    "mobile-style",
    "website-style"
  ],
  "scripts": {
    "dev:web": "npm --prefix web-style start",
    "dev:mobile": "npm --prefix mobile-style dev",
    "dev:website": "npm --prefix website-style dev",
    "build:web": "npm --prefix web-style run build:all",
    "build:mobile": "npm --prefix mobile-style run build",
    "build:website": "npm --prefix website-style run build",
    "build:all": "npm run build:web && npm run build:mobile && npm run build:website",
    "build": "npm run build:all",
    "start": "npm run dev:web",
    "build:library": "npm --prefix web-style run build:library",
    "test": "npm --prefix web-style test",
    "test:library": "npm --prefix web-style run test:library",
    "validate:tokens": "npm --prefix web-style run validate:tokens",
    "validate:architecture": "npm --prefix web-style run validate:architecture",
    "validate:colors": "npm --prefix web-style run validate:colors",
    "validate:icons": "npm --prefix web-style run validate:icons",
    "validate:documentation": "npm --prefix web-style run validate:documentation",
    "validate:public-api": "npm --prefix web-style run validate:public-api",
    "validate:visual": "npm --prefix web-style run validate:visual",
    "audit:visual": "npm --prefix web-style run audit:visual",
    "validate:contrast": "npm --prefix web-style run validate:contrast",
    "validate:package": "npm --prefix web-style run validate:package",
    "validate:browser": "npm --prefix web-style run validate:browser",
    "validate:all": "npm run build:all && npm run validate:tokens && npm run validate:architecture",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:mobile:up": "docker compose -f mobile-style/docker-compose.yml up -d --build",
    "docker:mobile:down": "docker compose -f mobile-style/docker-compose.yml down",
    "docker:mobile:logs": "docker compose -f mobile-style/docker-compose.yml logs -f"
  }
}
