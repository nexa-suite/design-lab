---
/**
 * LiveTelemetryCard Component
 * Real-time operational telemetry monitor from SaaS Platform Bento.
 * Displays conflict rate gauges, fleet utilization bars, and active in-transit insurance metrics.
 * 
 * Strict WCAG AAA Contrast on dark background or standalone card.
 */
interface Props {
  isIsolated?: boolean;
}

const { isIsolated = false } = Astro.props;
---

<div class={`telemetry-card ${isIsolated ? 'is-isolated' : ''}`} role="region" aria-label="Telemetría Operativa en Tiempo Real">
  <div class="telem-header">
    <div class="telem-title-wrap">
      <span class="telem-live-dot" aria-hidden="true"></span>
      <div>
        <strong class="telem-title">Monitor de Flota & Telemetría</strong>
        <span class="telem-subtitle">Disponibilidad en Tiempo Real</span>
      </div>
    </div>
    <span class="fleet-badge text-mono" id="telem-overall-badge">94% UTILIZADO</span>
  </div>

  <!-- Fleet Utilization Meters -->
  <div class="telem-meters-list">
    <div class="meter-item">
      <div class="meter-labels">
        <span class="meter-name">GoPro HERO10 Fleet (12 u)</span>
        <span class="meter-val text-mono">10 Alquiladas (83%)</span>
      </div>
      <div class="meter-track" role="progressbar" aria-valuenow="83" aria-valuemin="0" aria-valuemax="100">
        <div class="meter-bar" style="width: 83%;"></div>
      </div>
    </div>

    <div class="meter-item">
      <div class="meter-labels">
        <span class="meter-name">Sony Cinema Bodies (6 u)</span>
        <span class="meter-val text-mono">5 Alquiladas (83%)</span>
      </div>
      <div class="meter-track" role="progressbar" aria-valuenow="83" aria-valuemin="0" aria-valuemax="100">
        <div class="meter-bar" style="width: 83%;"></div>
      </div>
    </div>

    <div class="meter-item">
      <div class="meter-labels">
        <span class="meter-name">Packs de Iluminación & Grip (20 u)</span>
        <span class="meter-val text-mono">18 Alquiladas (90%)</span>
      </div>
      <div class="meter-track" role="progressbar" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100">
        <div class="meter-bar" style="width: 90%;"></div>
      </div>
    </div>
  </div>

  <!-- Operational Guardrail KPIs -->
  <div class="telem-kpis-row">
    <div class="kpi-cell">
      <span class="kpi-val text-mono">0.0%</span>
      <span class="kpi-label">Conflictos de Sobre-reserva</span>
    </div>
    <div class="kpi-divider" aria-hidden="true"></div>
    <div class="kpi-cell">
      <span class="kpi-val text-mono">100%</span>
      <span class="kpi-label">Asegurado en Tránsito</span>
    </div>
    <div class="kpi-divider" aria-hidden="true"></div>
    <div class="kpi-cell">
      <span class="kpi-val text-mono">0 ms</span>
      <span class="kpi-label">Latencia de Sync de Canal</span>
    </div>
  </div>
</div>

<style>
  .telemetry-card {
    background: #082846;
    border: 1px solid rgba(56, 200, 255, 0.25);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 8px 24px rgba(8, 40, 70, 0.2);
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
    box-sizing: border-box;
    color: #ffffff;
  }

  .telemetry-card.is-isolated {
    width: 100%;
    max-width: 100%;
  }

  .telem-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.85rem;
    margin-bottom: 1rem;
  }

  .telem-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .telem-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #38c8ff;
    box-shadow: 0 0 8px #38c8ff;
    flex-shrink: 0;
    animation: telemPulse 2s infinite ease-in-out;
  }

  @keyframes telemPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  .telem-title {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 13.5px;
    font-weight: 800;
    color: #ffffff;
    display: block;
    line-height: 1.2;
  }

  .telem-subtitle {
    font-size: 11px;
    color: #94a3b8;
  }

  .fleet-badge {
    background: rgba(56, 200, 255, 0.15);
    border: 1px solid rgba(56, 200, 255, 0.4);
    color: #38c8ff;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }

  .telem-meters-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .meter-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meter-labels {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
  }

  .meter-name {
    color: #cbd5e1;
    font-weight: 500;
  }

  .meter-val {
    color: #38c8ff;
    font-weight: 700;
  }

  .meter-track {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    overflow: hidden;
  }

  .meter-bar {
    height: 100%;
    background: #38c8ff;
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  .telem-kpis-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 12px;
  }

  .kpi-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
  }

  .kpi-val {
    font-size: 13.5px;
    font-weight: 800;
    color: #38c8ff;
  }

  .kpi-label {
    font-size: 9px;
    color: #94a3b8;
    margin-top: 2px;
    line-height: 1.2;
  }

  .kpi-divider {
    width: 1px;
    height: 24px;
    background: rgba(255, 255, 255, 0.12);
  }
</style>
