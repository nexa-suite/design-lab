---
/**
 * LIVING GEOMETRY GRAPHICS ENGINE & ARTIFACT WORKBENCH
 * Interactive sandbox environment with zero-overlap collision physics,
 * 60fps dynamic orthogonal routing, signal pulses, and multi-preset artifact scenes.
 * Restyled with Nexa Design System visual foundations (cool canvas, crisp card surfaces, slate borders, blue accents).
 */
---

<div class="nexafy-studio-container">
  <!-- Studio Layout -->
  <div class="nexafy-studio">

    <!-- Left Controls Panel -->
    <aside class="nexafy-panel">
      
      <!-- Preset Selector -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Stage Preset (Artifact Environment)</span>
        </div>
        <select id="preset-selector" class="nexa-select">
          <option value="CHANNELS" selected>Hero Chapter 01 (Channels & Security)</option>
          <option value="DORMANT">Hero Dormant Canvas</option>
          <option value="SAAS">Hero Chapter 02 (SaaS Morph)</option>
          <option value="PAYMENT">Safe Renting (Payment Flow / iOS Phone)</option>
          <option value="INSURANCE">Insurance Protection Stage</option>
          <option value="SUSTAINABILITY">Sustainability Aerial Canvas</option>
          <option value="ACCESS_CHANNELS">Access Channels (Beige Bento Grid)</option>
          <option value="FOOTER_BEIGE">Global Footer (Sculpted Beige)</option>
        </select>
      </div>

      <!-- Semantic Scene Graph Artifact Tree -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Scene Graph Artifact Tree</span>
          <span class="item-tag" id="node-count-badge">6 Nodes</span>
        </div>
        <div class="scene-tree-list" id="scene-node-list">
          <!-- Injected via JavaScript -->
        </div>
      </div>

      <!-- Multi-Tier Edge Geometry Primitives -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Nexafy 2.0 Edge Primitives</span>
        </div>
        <div class="primitives-grid">
          <button type="button" class="primitive-btn active" data-prim="PROTRUDE">PROTRUDE</button>
          <button type="button" class="primitive-btn" data-prim="RECESS">RECESS</button>
          <button type="button" class="primitive-btn" data-prim="STEP">STEP</button>
          <button type="button" class="primitive-btn" data-prim="SHELF">SHELF</button>
          <button type="button" class="primitive-btn" data-prim="TAB">TAB</button>
          <button type="button" class="primitive-btn" data-prim="CHANNEL">CHANNEL</button>
          <button type="button" class="primitive-btn" data-prim="CUTOUT">CUTOUT</button>
          <button type="button" class="primitive-btn" data-prim="ALL">CANONICAL</button>
        </div>
        <p style="font-size: 0.6875rem; color: var(--nexafy-muted); line-height: 1.3;" id="primitive-desc">
          PROTRUDE: Extrudes outward from shoulder. Used for Hero top canopy headline crown.
        </p>
      </div>

      <!-- Canvas Dimensions -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Canvas Metrics</span>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Width (px)</span>
            <span class="control-value" id="val-width">1440</span>
          </div>
          <input type="range" id="input-width" min="320" max="1600" step="10" value="1440">
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Height (px)</span>
            <span class="control-value" id="val-height">820</span>
          </div>
          <input type="range" id="input-height" min="400" max="1200" step="10" value="820">
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Base Corner Radius (px)</span>
            <span class="control-value" id="val-base-radius">36</span>
          </div>
          <input type="range" id="input-base-radius" min="0" max="80" step="2" value="36">
        </div>
      </div>

      <!-- Top Crown Controls -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Top Canopy Crown</span>
          <label class="toggle-checkbox">
            <input type="checkbox" id="check-crown-enabled" checked>
            <span>Enabled</span>
          </label>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Crown Width (px)</span>
            <span class="control-value" id="val-crown-w">568</span>
          </div>
          <input type="range" id="input-crown-w" min="200" max="1200" step="4" value="568">
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Crown Drop (px)</span>
            <span class="control-value" id="val-crown-h">105</span>
          </div>
          <input type="range" id="input-crown-h" min="0" max="250" step="5" value="105">
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Fillet Radius</span>
            <span class="control-value" id="val-crown-fillet">36</span>
          </div>
          <input type="range" id="input-crown-fillet" min="0" max="60" step="2" value="36">
        </div>
      </div>

      <!-- Bottom Shelf Controls -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Bottom Shelf Notch</span>
          <label class="toggle-checkbox">
            <input type="checkbox" id="check-shelf-enabled" checked>
            <span>Enabled</span>
          </label>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Shelf Width (px)</span>
            <span class="control-value" id="val-shelf-w">888</span>
          </div>
          <input type="range" id="input-shelf-w" min="200" max="1400" step="4" value="888">
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Shelf Extend (px)</span>
            <span class="control-value" id="val-shelf-h">85</span>
          </div>
          <input type="range" id="input-shelf-h" min="0" max="250" step="5" value="85">
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Fillet Radius</span>
            <span class="control-value" id="val-shelf-fillet">36</span>
          </div>
          <input type="range" id="input-shelf-fillet" min="0" max="60" step="2" value="36">
        </div>
      </div>

    </aside>

    <!-- Center Stage Canvas -->
    <main class="nexafy-viewport">
      
      <!-- Responsive Resolution Presets Toolbar -->
      <div class="viewport-toolbar">
        <div class="viewport-presets">
          <button type="button" class="viewport-chip active" data-w="1440" data-h="820">1440×820 (Desktop)</button>
          <button type="button" class="viewport-chip" data-w="1600" data-h="1200">1600×1200 (Historical)</button>
          <button type="button" class="viewport-chip" data-w="1280" data-h="800">1280×800</button>
          <button type="button" class="viewport-chip" data-w="1024" data-h="768">1024×768</button>
          <button type="button" class="viewport-chip" data-w="768" data-h="1024">768×1024</button>
          <button type="button" class="viewport-chip" data-w="390" data-h="844">390×844</button>
          <button type="button" class="viewport-chip" data-w="320" data-h="700">320×700</button>
        </div>

        <div class="view-toggles">
          <!-- Human Ergonomic Tones Switcher -->
          <div class="human-tones-toggle" role="group" aria-label="Human Ergonomic Tones">
            <button type="button" class="tone-pill active" data-tone="nexa" data-plate="#082846" data-accent="#38c8ff" data-conduit="#bae6fd" data-oklch="oklch(28% 0.07 240)" title="Nexa Calibrated Dark Blue (#082846 & #38c8ff)">
              <span class="color-swatch" style="background: #082846; border: 1.5px solid #38c8ff;"></span>
              <span>Nexa Blue</span>
            </button>
            <button type="button" class="tone-pill" data-tone="cashmere" data-plate="#283a48" data-accent="#7dd3fc" data-conduit="#bae6fd" data-oklch="oklch(33% 0.06 258)" title="Cashmere Arctic Mist (oklch(33% 0.06 258) / #283a48)">
              <span class="color-swatch" style="background: #283a48; border: 1.5px solid #7dd3fc;"></span>
              <span>Cashmere Mist</span>
            </button>
            <button type="button" class="tone-pill" data-tone="ceramic" data-plate="#1d3d63" data-accent="#38bdf8" data-conduit="#a5f3fc" data-oklch="oklch(35% 0.08 245)" title="Ceramic Azure Harmony (oklch(35% 0.08 245) / #1d3d63)">
              <span class="color-swatch" style="background: #1d3d63; border: 1.5px solid #38bdf8;"></span>
              <span>Ceramic Azure</span>
            </button>
            <button type="button" class="tone-pill" data-tone="oceanic" data-plate="#163b45" data-accent="#4ade80" data-conduit="#bbf7d0" data-oklch="oklch(32% 0.07 215)" title="Oceanic Sage Blue (oklch(32% 0.07 215) / #163b45)">
              <span class="color-swatch" style="background: #163b45; border: 1.5px solid #4ade80;"></span>
              <span>Oceanic Sage</span>
            </button>
          </div>

          <!-- Conduit Pastel Tone Selector -->
          <div class="conduit-palette-toggle" role="group" aria-label="Conduit Pastel Tone">
            <span class="conduit-toggle-label">Conduit:</span>
            <button type="button" class="conduit-pill active" data-pastel="#bae6fd" title="Celeste Pastel (#bae6fd)">
              <span class="color-swatch" style="background: #bae6fd;"></span> Celeste
            </button>
            <button type="button" class="conduit-pill" data-pastel="#bbf7d0" title="Mint Pastel (#bbf7d0)">
              <span class="color-swatch" style="background: #bbf7d0;"></span> Mint
            </button>
            <button type="button" class="conduit-pill" data-pastel="#a5f3fc" title="Soft Cyan (#a5f3fc)">
              <span class="color-swatch" style="background: #a5f3fc;"></span> Cyan
            </button>
          </div>

          <!-- Auto-Tour Button -->
          <button type="button" class="nexafy-btn primary auto-tour-btn" id="btn-auto-tour" title="Play choreographed Cinematic Auto-Tour">
            <span class="tour-icon" id="tour-btn-icon">▶</span>
            <span id="auto-tour-btn-text">Auto-Tour</span>
          </button>

          <label class="toggle-checkbox">
            <input type="checkbox" id="toggle-living-motion" checked>
            <span>Living Movement</span>
          </label>
          <label class="toggle-checkbox">
            <input type="checkbox" id="toggle-pulses" checked>
            <span>Signal Pulses</span>
          </label>
          <label class="toggle-checkbox">
            <input type="checkbox" id="toggle-circuit" checked>
            <span>28px Conduits</span>
          </label>
          <label class="toggle-checkbox">
            <input type="checkbox" id="toggle-debug-mode" checked>
            <span>Clearance Halos</span>
          </label>
          <label class="toggle-checkbox">
            <input type="checkbox" id="toggle-ref-overlay">
            <span>Reference Frame</span>
          </label>
          <div class="viewport-controls-group">
            <button type="button" class="viewport-btn-sm" id="btn-zoom-out" title="Zoom Out">−</button>
            <button type="button" class="viewport-btn-sm" id="btn-zoom-reset" title="Reset View">100%</button>
            <button type="button" class="viewport-btn-sm" id="btn-zoom-in" title="Zoom In">+</button>
            <button type="button" class="viewport-btn-sm" id="btn-zoom-fit" title="Fit to Viewport">Fit</button>
          </div>
          <span style="font-size: 0.75rem; color: var(--nexafy-muted); margin-left: 0.25rem;">
            Scale: <span id="scale-indicator" style="color: var(--nexafy-text); font-family: monospace; font-weight: 700;">100%</span>
          </span>
        </div>
      </div>

      <!-- SVG Drawing Surface with pure clean white background and ultra-subtle dot grid -->
      <div class="canvas-stage-wrapper" id="stage-wrapper">
        <!-- Floating Cinematic Auto-Tour HUD Banner -->
        <div class="tour-status-banner" id="tour-status-banner" style="display: none;">
          <span class="tour-live-dot"></span>
          <span class="tour-step-badge" id="tour-step-badge">TOUR 1/5</span>
          <span class="tour-step-desc" id="tour-step-desc">DORMANT SCULPTED PLATE</span>
          <button type="button" class="tour-stop-btn" id="tour-stop-btn" title="Stop Cinematic Tour">✕ Stop</button>
        </div>

        <div class="canvas-frame" id="canvas-frame" style="width: 720px; height: 410px;">
          
          <!-- Reference Frame Image -->
          <img 
            id="ref-overlay-img" 
            src="/artifacts/pass6/reference/pass5_hero_baseline.png" 
            alt="Historical Video Reference"
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; pointer-events: none; z-index: 25; mix-blend-mode: normal; display: none;"
          />

          <svg 
            id="nexafy-svg" 
            class="canvas-svg" 
            viewBox="0 0 1440 820"
            preserveAspectRatio="none"
          >
            <defs>
              <radialGradient id="lab-radial-glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#38c8ff" stop-opacity="0.12" />
                <stop offset="100%" stop-color="#082846" stop-opacity="0" />
              </radialGradient>
              <filter id="conduit-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="6" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
              <filter id="node-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#2a67d9" flood-opacity="0.25" />
              </filter>
              <filter id="card-shadow" x="-15%" y="-15%" width="130%" height="130%">
                <feDropShadow dx="0" dy="5" stdDeviation="10" flood-color="#000000" flood-opacity="0.15" />
              </filter>
              <filter id="pulse-glow" x="-40%" y="-40%" width="180%" height="180%">
                <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#38c8ff" flood-opacity="0.95" />
              </filter>
            </defs>
            
            <!-- Layer 1: Sculpted Stage Contour with smooth 28px/36px fillets -->
            <path id="sculpted-path" d="" fill="none" stroke="rgba(56, 200, 255, 0.3)" stroke-width="1.5" stroke-linejoin="round" />
            <rect id="sculpted-glow" x="0" y="0" width="1440" height="820" fill="url(#lab-radial-glow)" pointer-events="none" />

            <!-- Layer 2: Living Thick Pastel Vascular Circuit Routes (SVG Edges - 28px) -->
            <g id="circuit-edges-layer" style="display: block;">
              <!-- Injected dynamically via Scene Graph -->
            </g>

            <!-- Layer 2.5: Animated Signal Pulses flowing along 28px conduits -->
            <g id="circuit-pulses-layer" style="display: block; pointer-events: none;">
              <!-- Injected dynamically via requestAnimationFrame -->
            </g>

            <!-- Layer 3: Semantic Nodes & Mockups (Interactive Draggable, High-Contrast White Cards) -->
            <g id="circuit-nodes-layer" style="display: block;">
              <!-- Injected dynamically via Scene Graph with drag/hover handlers -->
            </g>

            <!-- Layer 3.5: Auto-Tour FX (Flying entry spin & Escrow confetti burst) -->
            <g id="tour-fx-layer" style="display: block; pointer-events: none;">
              <!-- Injected dynamically during Auto-Tour -->
            </g>

            <!-- Layer 4: Debug Clearance Halos, Bounds & Ports -->
            <g id="debug-overlay-layer" style="display: block; pointer-events: none;">
              <!-- Injected dynamically via Scene Graph -->
            </g>
          </svg>
        </div>
      </div>
    </main>

    <!-- Right Morph & Node Inspector Panel -->
    <aside class="nexafy-panel right">
      
      <!-- Scene Validation HUD -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Scene Validation Status</span>
        </div>
        <div class="validation-hud" id="validation-hud-box">
          <div class="validation-badge" id="validation-badge-text">
            <span>●</span>
            <span>0 Collisions (PASS)</span>
          </div>
          <div style="display: flex; gap: 0.35rem;">
            <button type="button" class="nexafy-btn sm" id="btn-run-validation">Run Audit</button>
            <button type="button" class="nexafy-btn sm primary" id="btn-resolve-collisions" title="Enforce zero overlap across all nodes">Zero Overlap</button>
          </div>
        </div>
        <p style="font-size: 0.6875rem; color: var(--nexafy-muted);" id="collision-detail-text">
          Semantic clearance verified across all active nodes and routed orthogonal edges.
        </p>
      </div>

      <!-- Node / Entity Inspector -->
      <div class="panel-section" id="node-inspector-section">
        <div class="panel-section-title">
          <span>Entity Inspector</span>
          <span class="item-tag" id="inspector-entity-type">NODE</span>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Entity ID</span>
            <span class="control-value" id="inspect-id">node-company</span>
          </div>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Semantic Role</span>
            <span class="control-value" id="inspect-role">origin</span>
          </div>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Bounds [X, Y, W, H]</span>
            <span class="control-value" id="inspect-bounds">180, 250, 220, 104</span>
          </div>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Ports Count</span>
            <span class="control-value" id="inspect-ports">1 (source: right)</span>
          </div>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Permitted Overlaps</span>
            <span class="control-value" id="inspect-overlap">node-trunk-edge</span>
          </div>
        </div>
      </div>

      <!-- Reference Overlay Controls -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Reference Frame Compare</span>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Overlay Opacity</span>
            <span class="control-value" id="val-ref-opacity">50%</span>
          </div>
          <input type="range" id="input-ref-opacity" min="0" max="100" step="5" value="50">
        </div>
        <div class="control-row">
          <label style="font-size: 0.75rem; color: var(--nexafy-muted);">Blend Mode</label>
          <select id="select-ref-blend" class="nexa-select">
            <option value="normal">Normal</option>
            <option value="difference" selected>Difference (Residual Highlight)</option>
            <option value="screen">Screen</option>
            <option value="multiply">Multiply</option>
          </select>
        </div>
      </div>

      <!-- Morph Compatibility Lab -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Morph Compatibility Lab</span>
        </div>
        <div class="control-row">
          <label style="font-size: 0.75rem; color: var(--nexafy-muted);">State A (Origin)</label>
          <select id="morph-state-a" class="nexa-select">
            <option value="DORMANT">DORMANT (Empty Stage)</option>
            <option value="CHANNELS" selected>CHANNELS (Hero Chapter 01)</option>
            <option value="SAAS">SAAS (Chapter 02 Morph)</option>
            <option value="PAYMENT">PAYMENT (Safe Renting)</option>
            <option value="INSURANCE">INSURANCE</option>
            <option value="SUSTAINABILITY">SUSTAINABILITY</option>
            <option value="ACCESS_CHANNELS">ACCESS_CHANNELS (Beige)</option>
            <option value="FOOTER_BEIGE">FOOTER_BEIGE (Sculpted Beige)</option>
          </select>
        </div>
        <div class="control-row">
          <label style="font-size: 0.75rem; color: var(--nexafy-muted);">State B (Target)</label>
          <select id="morph-state-b" class="nexa-select">
            <option value="SAAS" selected>SAAS (Chapter 02 Morph)</option>
            <option value="CHANNELS">CHANNELS (Hero Chapter 01)</option>
            <option value="DORMANT">DORMANT (Empty Stage)</option>
            <option value="PAYMENT">PAYMENT (Safe Renting)</option>
            <option value="INSURANCE">INSURANCE</option>
            <option value="SUSTAINABILITY">SUSTAINABILITY</option>
            <option value="ACCESS_CHANNELS">ACCESS_CHANNELS (Beige)</option>
            <option value="FOOTER_BEIGE">FOOTER_BEIGE (Sculpted Beige)</option>
          </select>
        </div>
        <div class="control-row">
          <div class="control-label-group">
            <span>Interpolation (t)</span>
            <span class="control-value" id="val-morph-t">0.00</span>
          </div>
          <input type="range" id="input-morph-t" min="0" max="1" step="0.01" value="0">
        </div>
        <div class="btn-group">
          <button type="button" class="nexafy-btn primary" id="btn-play-morph">Play Morph Loop</button>
        </div>
      </div>

      <!-- Generated SVG Path & Export -->
      <div class="panel-section">
        <div class="panel-section-title">
          <span>Generated SVG Path</span>
        </div>
        <div class="code-preview-area" id="output-svg-code">
          M 426 0 ...
        </div>
        <div class="btn-group" style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
          <button type="button" class="nexafy-btn sm" id="btn-copy-path">Copy Path</button>
          <button type="button" class="nexafy-btn sm" id="btn-copy-json">Copy JSON</button>
          <button type="button" class="nexafy-btn sm" id="btn-download-svg">Download SVG</button>
        </div>
      </div>

    </aside>

  </div>

  <!-- Bottom Master Timeline Scrubber -->
  <footer class="nexafy-timeline-bar">
    <div class="timeline-controls-row">
      <div class="timeline-playback-group">
        <button type="button" class="nexafy-btn sm primary" id="btn-play-timeline">Play</button>
        <button type="button" class="nexafy-btn sm" id="btn-prev-marker">◀ Prev</button>
        <button type="button" class="nexafy-btn sm" id="btn-next-marker">Next ▶</button>
        <button type="button" class="nexafy-btn sm" id="btn-reset-timeline">Reset</button>
        <div class="timeline-time-display" id="timeline-time-display">00.00s / 48.15s</div>
      </div>

      <!-- Marker Pills -->
      <div class="markers-pill-bar" id="timeline-markers-container">
        <!-- Injected via JavaScript -->
      </div>
    </div>

    <!-- Scrubber Slider -->
    <div class="timeline-slider-wrapper">
      <input type="range" id="input-master-timeline" class="timeline-slider" min="0" max="48.15" step="0.05" value="0">
    </div>
  </footer>
</div>

<style>
  :root {
    --nexafy-bg: #f6faff;
    --nexafy-sidebar: #ffffff;
    --nexafy-panel-bg: #f8fafc;
    --nexafy-border: #e2e8f0;
    --nexafy-border-highlight: #cbd5e1;
    --nexafy-text: #0f172a;
    --nexafy-muted: #64748b;
    --nexafy-accent: #2a67d9;
    --nexafy-accent-dark: #1b4fb8;
    --nexafy-mint: #56f09f;
    --nexafy-danger: #dc2626;
    --nexafy-warning: #d97706;
    --nexafy-info: #0284c7;
  }

  .nexafy-studio-container {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 120px);
    min-height: 700px;
    background: var(--nexafy-bg);
    border-radius: var(--nexa-radius-card);
    border: 1px solid var(--nexafy-border);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .nexafy-studio {
    display: grid;
    grid-template-columns: 320px 1fr 320px;
    flex: 1;
    height: calc(100% - 58px);
