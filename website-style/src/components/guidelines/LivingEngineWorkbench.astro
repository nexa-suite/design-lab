  }

  .hero-book-btn:hover {
    background: #f8fafc;
    border-color: #94a3b8;
  }

  .hero-login-btn {
    padding: 0.55rem 1.25rem;
    background-color: #2563eb;
    color: #ffffff;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .hero-login-btn:hover {
    background-color: #1d4ed8;
  }

  /* --------------------------------------------------------------------------
     2.2 CENTER STAGE (CLOSED VASCULAR CIRCUIT CANVAS)
     -------------------------------------------------------------------------- */
  .hero-center-stage {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1140px;
    height: 480px;
    margin: 0 auto;
    overflow: visible;
  }

  /* Continuous Vascular Circuit SVG */
  .circuit-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }

  .circuit-pipe-line {
    transition: stroke 0.3s ease;
  }

  /* Animated Signal Particles */
  .pulse-particle {
    filter: drop-shadow(0 0 5px #38bdf8);
    pointer-events: none;
  }

  /* Hub Nodes */
  /* Hub Nodes: High-Tech Terminals (0 Circles!) */
  .circuit-hub {
    position: absolute;
    z-index: 10;
    width: 165px;
    height: 110px;
    border-radius: 16px;
    background-color: #38bdf8;
    color: #082846;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 10px 12px;
    box-shadow: 0 12px 32px rgba(56, 189, 248, 0.35);
    cursor: grab;
    user-select: none;
    touch-action: none;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    transition: box-shadow 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .circuit-hub:hover {
    transform: scale(1.03);
    box-shadow: 0 16px 36px rgba(56, 189, 248, 0.45);
  }

  .circuit-hub.is-dragging {
    cursor: grabbing;
    z-index: 50;
    transform: scale(1.05);
    box-shadow: 0 20px 44px rgba(56, 189, 248, 0.6);
  }

  .destination-hub {
    background-color: #2563eb;
    color: #ffffff;
    width: 175px;
    height: 110px;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(37, 99, 235, 0.35);
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    touch-action: none;
    cursor: grab;
  }

  .destination-hub:hover {
    box-shadow: 0 16px 36px rgba(37, 99, 235, 0.45);
  }

  .destination-hub.is-dragging {
    cursor: grabbing;
    z-index: 50;
    transform: scale(1.05);
    box-shadow: 0 20px 44px rgba(37, 99, 235, 0.6);
  }

  .hub-terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    border-bottom: 1px solid rgba(8, 40, 70, 0.15);
    padding-bottom: 4px;
  }

  .destination-hub .hub-terminal-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .terminal-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #0284c7;
    box-shadow: 0 0 6px #0284c7;
  }

  .destination-hub .terminal-status-dot {
    background: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
  }

  .terminal-kicker {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .hub-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hub-title {
    font-family: var(--nexa-font-family-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .hub-location {
    font-size: 10.5px;
    opacity: 0.9;
  }

  .hub-port-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(8, 40, 70, 0.12);
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 9px;
    font-weight: 700;
  }

  .dest-badge {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  /* Central Router Node (Nexa Core Bus) */
  .circuit-center-hub {
    position: absolute;
    z-index: 10;
    width: 120px;
    height: 120px;
    border-radius: 24px;
    background: #082846;
    border: 2px solid #38bdf8;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 0 28px rgba(56, 189, 248, 0.25);
    cursor: grab;
    user-select: none;
    touch-action: none;
    transition: box-shadow 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .circuit-center-hub:hover {
    transform: scale(1.04);
  }

  .circuit-center-hub.is-dragging {
    cursor: grabbing;
    z-index: 50;
    transform: scale(1.07);
    box-shadow: 0 0 36px rgba(56, 189, 248, 0.5);
  }

  .center-hub-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .center-hub-title {
    font-family: var(--nexa-font-family-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
  }

  .center-hub-sub {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 8.5px;
    color: #38bdf8;
    font-weight: 600;
  }

  /* Symmetrically Aligned Three White Station Cards (Pure Autolayout & Draggable) */
  .station-card {
    position: absolute;
    z-index: 10;
    width: 335px;
    background: #ffffff;
    opacity: 1 !important;
    border-radius: 16px;
    padding: 0.75rem 1rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: #082846;
    cursor: grab;
    user-select: none;
    touch-action: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .station-card:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.25);
  }

  .station-card.is-dragging {
    cursor: grabbing;
    z-index: 50;
    transform: scale(1.04);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .station-body-items {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 3px 0;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
  }

  .station-micro-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    font-size: 11px;
  }

  .micro-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 5px;
    border-radius: 4px;
    background: #eff6ff;
