---
/**
 * ElevacionesM3Section.astro
 * Canonical Material 3 Tonal Elevation & Primary Tinting for Android Jetpack Compose
 * Covers Levels 0 to 5, Primary Tint Overlays, Ambient Sunlight Behavior & Kotlin Contracts
 */
---

<div class="elevaciones-m3-container" data-platform-target="universal">
  <!-- Section 1: Elevación Tonal Material 3 -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">01</span>
        <div>
          <p class="cuadro-kicker">MATERIAL DESIGN 3 · PROFUNDIDAD & SUPERFICIES</p>
          <h3 class="cuadro-title">Sistema de Elevación Tonal M3 (Level 0 a Level 5) con Tinte Primario</h3>
          <p class="cuadro-subtitle">
            En lugar de depender exclusivamente de sombras difusas (que se vuelven invisibles en pantallas exteriores bajo luz solar directa o en paneles AMOLED con alto brillo), Nexa Mobile utiliza <strong>elevación tonal combinada con overlay de tinte azul primario (NexaPrimary <code>#2A67D9</code>)</strong> sobre la superficie base.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag primary"><i class="pi pi-clone"></i> Tonal Elevation 0-12dp</span>
        <span class="cuadro-tag kotlin"><i class="pi pi-android"></i> surfaceTint</span>
        <span class="cuadro-tag success"><i class="pi pi-sun"></i> Legible &gt;50k Lux</span>
      </div>
    </div>

    <!-- Visual Elevation Spectrum -->
    <div class="elevation-spectrum-row">
      <div class="elev-item elev-0">
        <span class="elev-level">Level 0</span>
        <span class="elev-dp">0dp</span>
        <span class="elev-tint">0% Tinte</span>
        <span class="elev-usage">Fondo Scaffold</span>
      </div>
      <div class="elev-item elev-1">
        <span class="elev-level">Level 1</span>
        <span class="elev-dp">1dp – 2dp</span>
        <span class="elev-tint">5% Tinte</span>
        <span class="elev-usage">Tarjetas & Listas</span>
      </div>
      <div class="elev-item elev-2">
        <span class="elev-level">Level 2</span>
        <span class="elev-dp">3dp</span>
        <span class="elev-tint">8% Tinte</span>
        <span class="elev-usage">TopAppBar & BottomNav</span>
      </div>
      <div class="elev-item elev-3">
        <span class="elev-level">Level 3</span>
        <span class="elev-dp">6dp</span>
        <span class="elev-tint">11% Tinte</span>
        <span class="elev-usage">FAB Flotante & Toasts</span>
      </div>
      <div class="elev-item elev-4">
        <span class="elev-level">Level 4</span>
        <span class="elev-dp">8dp</span>
        <span class="elev-tint">12% Tinte</span>
        <span class="elev-usage">Bottom Sheets Modales</span>
      </div>
      <div class="elev-item elev-5">
        <span class="elev-level">Level 5</span>
        <span class="elev-dp">12dp</span>
        <span class="elev-tint">14% Tinte</span>
        <span class="elev-usage">Diálogos de Confirmación</span>
      </div>
    </div>

    <!-- CUADRO ARQUITECTÓNICO: Matriz de Elevaciones M3 -->
    <div class="contract-table-wrapper">
      <table class="contract-table">
        <thead>
          <tr>
            <th>Nivel M3</th>
            <th>Elevación (dp)</th>
            <th>Tinte Tonal Primario (% NexaPrimary)</th>
            <th>Sombra Ambiental</th>
            <th>Componentes Asignados en Nexa Mobile</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Level 0</strong></td>
            <td><code>0.dp</code></td>
            <td>0% (Sin tinte)</td>
            <td>Ninguna</td>
            <td>Fondo estructural del Scaffold (<code>#F6FAFF</code>)</td>
          </tr>
          <tr>
            <td><strong>Level 1</strong></td>
            <td><code>1.dp – 2.dp</code></td>
            <td>5% (Alpha 0.05 sobre fondo)</td>
            <td><code>0 1px 3px rgba(15,23,42,0.06)</code></td>
            <td>Tarjetas de paradas de despacho, tarjetas de picking FEFO, checklist de maquinaria</td>
          </tr>
          <tr>
            <td><strong>Level 2</strong></td>
            <td><code>3.dp</code></td>
            <td>8% (Alpha 0.08 sobre fondo)</td>
            <td><code>0 2px 6px rgba(15,23,42,0.08)</code></td>
            <td>NexaTopAppBar fija en scroll y barra de navegación inferior NexaBottomNav (64dp)</td>
          </tr>
          <tr>
            <td><strong>Level 3</strong></td>
            <td><code>6.dp</code></td>
            <td>11% (Alpha 0.11 sobre fondo)</td>
            <td><code>0 4px 12px rgba(15,23,42,0.10)</code></td>
            <td>Floating Action Button (FAB) de escáner CameraX, Extended FAB y Snackbars con acción</td>
          </tr>
          <tr>
            <td><strong>Level 4</strong></td>
            <td><code>8.dp</code></td>
            <td>12% (Alpha 0.12 sobre fondo)</td>
            <td><code>0 8px 20px rgba(15,23,42,0.12)</code></td>
            <td>NexaModalBottomSheet para firma de entrega (POD), selectores densos y search bar activo</td>
          </tr>
          <tr>
            <td><strong>Level 5</strong></td>
            <td><code>12.dp</code></td>
            <td>14% (Alpha 0.14 sobre fondo)</td>
            <td><code>0 12px 28px rgba(15,23,42,0.16)</code></td>
            <td>Diálogos críticos de confirmación (rechazar entrega, cancelar ruta), time pickers</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 2: Contrato de Código Kotlin Compose Elevation -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">02</span>
        <div>
          <p class="cuadro-kicker">CÓDIGO DE PRODUCCIÓN · KOTLIN JETPACK COMPOSE</p>
          <h3 class="cuadro-title">Implementación de Elevación y Surface Tint en Compose</h3>
          <p class="cuadro-subtitle">
            Uso canónico de <code>Surface</code>, <code>CardDefaults.cardElevation</code> y tinte automático de MaterialTheme.
          </p>
        </div>
      </div>
    </div>

    <div class="code-container-block">
      <div class="code-header-bar">
        <div class="code-header-title">
          <i class="pi pi-file"></i>
          <span>core/designsystem/src/main/kotlin/com/nexa/core/designsystem/component/Elevation.kt</span>
        </div>
        <span class="code-lang-pill">Kotlin 2.4</span>
      </div>
      <pre class="code-pre-box" is:raw><code><span class="comm">// Canonical Material 3 Elevation & Tonal Tint Pattern in Jetpack Compose</span>
<span class="kw">package</span> com.nexa.core.designsystem.component

<span class="kw">import</span> androidx.compose.foundation.layout.fillMaxWidth
<span class="kw">import</span> androidx.compose.foundation.layout.padding
<span class="kw">import</span> androidx.compose.foundation.shape.RoundedCornerShape
<span class="kw">import</span> androidx.compose.material3.Card
<span class="kw">import</span> androidx.compose.material3.CardDefaults
<span class="kw">import</span> androidx.compose.material3.MaterialTheme
<span class="kw">import</span> androidx.compose.material3.Surface
<span class="kw">import</span> androidx.compose.runtime.Composable
<span class="kw">import</span> androidx.compose.ui.Modifier
<span class="kw">import</span> androidx.compose.ui.unit.dp

<span class="ann">@Composable</span>
<span class="kw">fun</span> <span class="fn">NexaElevatedCard</span>(
    modifier: <span class="type">Modifier</span> = Modifier,
    content: <span class="ann">@Composable</span> () -> <span class="type">Unit</span>
) {
    <span class="fn">Card</span>(
        modifier = modifier.fillMaxWidth(),
        shape = <span class="fn">RoundedCornerShape</span>(<span class="num">16.dp</span>),
        colors = CardDefaults.cardColors(
            containerColor = MaterialTheme.colorScheme.surface,
            contentColor = MaterialTheme.colorScheme.onSurface
        ),
        elevation = CardDefaults.cardElevation(
            defaultElevation = <span class="num">1.dp</span>,    <span class="comm">// Level 1 tonal tint (5%)</span>
            pressedElevation = <span class="num">4.dp</span>,    <span class="comm">// Level 2/3 feedback</span>
            focusedElevation = <span class="num">2.dp</span>,
            hoveredElevation = <span class="num">2.dp</span>
        )
    ) {
        content()
    }
}

<span class="ann">@Composable</span>
<span class="kw">fun</span> <span class="fn">NexaStickyBottomBar</span>(
    modifier: <span class="type">Modifier</span> = Modifier,
    content: <span class="ann">@Composable</span> () -> <span class="type">Unit</span>
) {
    <span class="fn">Surface</span>(
        modifier = modifier.fillMaxWidth(),
        tonalElevation = <span class="num">3.dp</span>,          <span class="comm">// Level 2: 8% primary tint for sticky bars</span>
        shadowElevation = <span class="num">6.dp</span>,
        color = MaterialTheme.colorScheme.surfaceContainerHigh
    ) {
        content()
    }
}</code></pre>
    </div>
  </section>
</div>

<style>
  .elevaciones-m3-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
  }

  .elevation-spectrum-row {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
  }

  @media (max-width: 900px) {
    .elevation-spectrum-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .elev-item {
    padding: 14px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: #ffffff;
    border: 1px solid var(--nexa-color-border-default, #e2e8f0);

    .elev-level {
      font-size: 12px;
      font-weight: 700;
      color: #0f172a;
    }

    .elev-dp {
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 11px;
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-weight: 700;
    }

    .elev-tint {
      font-size: 10px;
      color: #7c3aed;
      font-weight: 600;
      font-family: var(--nexa-font-family-mono, monospace);
    }

    .elev-usage {
      font-size: 11px;
      color: #64748b;
      margin-top: 4px;
      line-height: 1.3;
    }

    &.elev-0 { background: #f8fafc; box-shadow: none; }
    &.elev-1 { box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06); }
    &.elev-2 { box-shadow: 0 3px 6px rgba(15, 23, 42, 0.08); }
    &.elev-3 { box-shadow: 0 6px 12px rgba(15, 23, 42, 0.10); }
    &.elev-4 { box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12); }
    &.elev-5 { box-shadow: 0 12px 26px rgba(15, 23, 42, 0.16); }
  }
</style>
