<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Device Filter Buttons
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.dev-filter-btn');
    const deviceCards = document.querySelectorAll<HTMLElement>('.device-card-wrapper');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const target = btn.getAttribute('data-filter');
        deviceCards.forEach(card => {
          const dev = card.getAttribute('data-device');
          if (target === 'all' || dev === target) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

