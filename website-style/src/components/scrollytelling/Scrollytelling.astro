---
// Scrollytelling Component — Reconstructed to 100% forensic fidelity
// Bases: webspo-flecto-2.png (Merchant Configurator) and webspo-flecto-3.png (Customer Flow)
---

<section class="scrolly-section" id="scrollytelling" aria-label="Flecto Link and Customer Scrollytelling Experience">
  <!-- Outer Sticky Pin Frame -->
  <div class="scrolly-sticky-frame">
    
    <!-- Top Category Tabs (State 1: Bookings / Inventory) -->
    <div class="scrolly-nav-tabs" role="tablist" aria-label="Configuration Categories">
      <div class="tabs-buttons-row">
        <button type="button" role="tab" class="scrolly-tab-btn active" id="tab-bookings" aria-selected="true">
          <span>Bookings</span>
        </button>
        <button type="button" role="tab" class="scrolly-tab-btn" id="tab-inventory" aria-selected="false">
          <span>Inventory</span>
        </button>
      </div>
      <div class="tabs-underline-track" aria-hidden="true">
        <div class="track-active-bar"></div>
      </div>
    </div>

    <!-- The Scrolly Stage Area -->
    <div class="scrolly-stage-area">

      <!-- ====================================================================
           BACKDROP PLATES (Morphing between State 1 and State 2)
           ==================================================================== -->
      <!-- State 1 Backdrop: Rounded vertical plate (webspo-flecto-2.png) -->
      <div class="stage-backdrop-state1" aria-hidden="true"></div>

      <!-- State 2 Backdrop: Monumental sculpted cross silhouette (webspo-flecto-3.png) -->
      <svg 
        class="stage-backdrop-state2" 
        viewBox="0 0 1600 900" 
        preserveAspectRatio="none" 
        aria-hidden="true"
      >
        <path 
          d="M 526 125 
             L 1069 125 
             A 36 36 0 0 1 1105 161 
             L 1105 224 
             A 36 36 0 0 0 1141 260 
             L 1479 260 
             A 36 36 0 0 1 1515 296 
             L 1515 684 
             A 36 36 0 0 1 1479 720 
             L 1191 720 
             A 36 36 0 0 0 1155 756 
             L 1155 864 
             A 36 36 0 0 1 1119 900 
             L 475 900 
             A 36 36 0 0 1 439 864 
             L 439 820 
             A 36 36 0 0 0 403 784 
             L 344 784 
             A 36 36 0 0 1 308 748 
             L 308 720 
             A 36 36 0 0 0 272 684 
             L 84 684 
             A 36 36 0 0 1 48 648 
             L 48 296 
             A 36 36 0 0 1 84 260 
             L 454 260 
             A 36 36 0 0 0 490 224 
             L 490 161 
             A 36 36 0 0 1 526 125 Z" 
          fill="#57f09e" 
        />
      </svg>

      <!-- ====================================================================
           SATELLITE TOGGLE CARDS (STATE 1: Merchant View)
           ==================================================================== -->
      <!-- 1. Top-Left Satellite: Online Payments -->
      <div class="satellite-card card-top-left" id="satellite-online-payments">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="24" height="18" viewBox="0 0 28 20" fill="none" stroke="#004737" stroke-width="1.8">
              <rect x="2" y="3" width="24" height="15" rx="3"/>
              <line x1="2" y1="7" x2="26" y2="7" stroke-width="1.5"/>
              <text x="14" y="15" font-size="7" font-family="sans-serif" font-weight="800" fill="#004737" stroke="none" text-anchor="middle">€</text>
            </svg>
          </div>
          <h3 class="satellite-title">Online Payments</h3>
          <p class="satellite-desc">Toggle this to allow paying online</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Online Payments toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 2. Bottom-Left Satellite: Pay in Store -->
      <div class="satellite-card card-bottom-left" id="satellite-pay-store">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="1.8">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3 class="satellite-title">Pay in Store</h3>
          <p class="satellite-desc">You can allow in-person payment at your store</p>
          <div class="satellite-switch-pill active" role="switch" aria-checked="true" aria-label="Pay in Store toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 3. Right Satellite: ID Verification -->
      <div class="satellite-card card-right bookings-satellite" id="satellite-id-verify">
        <div class="satellite-stem stem-right" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="1.8">
              <path d="M4 8V5a2 2 0 0 1 2-2h3M18 3h3a2 2 0 0 1 2 2v3M4 16v3a2 2 0 0 0 2 2h3M18 21h3a2 2 0 0 0 2-2v-3"/>
              <circle cx="12" cy="11" r="3"/>
              <path d="M8.5 17a4.5 4.5 0 0 1 7 0"/>
            </svg>
          </div>
          <h3 class="satellite-title">ID Verification</h3>
          <p class="satellite-desc">To add extra safety to the payment flow</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="ID Verification toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- INVENTORY SATELLITE CARDS (Active when Inventory Tab is clicked, matching elem-62bb3a259519f446072569.mp4) -->
      <!-- 1. Top-Left: Add Services -->
      <div class="satellite-card card-top-left inventory-satellite" id="satellite-add-services" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="satellite-title">Add Services</h3>
          <p class="satellite-desc">Add services like Delivery, Insurance, and more</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Add Services toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 2. Bottom-Left: Add Deposits -->
      <div class="satellite-card card-bottom-left inventory-satellite" id="satellite-add-deposits" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <rect x="2" y="5" width="20" height="14" rx="2"/>
              <line x1="2" y1="10" x2="22" y2="10"/>
            </svg>
          </div>
          <h3 class="satellite-title">Add Deposits</h3>
          <p class="satellite-desc">Protect your products by asking for a deposit</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Add Deposits toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 3. Top-Right: Add Items -->
      <div class="satellite-card card-right inventory-satellite" id="satellite-add-items" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-right" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <h3 class="satellite-title">Add Items</h3>
          <p class="satellite-desc">Add multiple items and quantities per booking</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Add Items toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 4. Bottom-Right: Discounts -->
      <div class="satellite-card card-bottom-right inventory-satellite" id="satellite-discounts" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-right" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2">
              <circle cx="7.5" cy="7.5" r="2.5"/>
              <circle cx="16.5" cy="16.5" r="2.5"/>
              <line x1="19" y1="5" x2="5" y2="19"/>
            </svg>
          </div>
          <h3 class="satellite-title">Discounts</h3>
          <p class="satellite-desc">Include a little incentive by adding discounts</p>
          <div class="satellite-switch-pill" role="switch" aria-checked="false" aria-label="Discounts toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- ====================================================================
           CUSTOMER JOURNEY ELEMENTS (STATE 2: Customer Flow)
           ==================================================================== -->
      <!-- Top Vertical Connector Line & John Cooper Avatar -->
      <div class="customer-avatar-stem-block" aria-hidden="true">
        <div class="top-vertical-stem"></div>
        <div class="customer-avatar-circle">
          <img src="/assets/synthetic/avatar-customer.svg" alt="John Cooper" class="avatar-svg-portrait" />
        </div>
        <div class="customer-badge-pill">John Cooper</div>
      </div>

      <!-- Left Wing: Monumental Headline & Badge -->
      <div class="customer-left-wing">
        <div class="customer-eyebrow-pill">For your Customer</div>
        <h2 class="customer-monumental-heading">
          And it's just<br />
          as simple for<br />
          your<br />
          customers
        </h2>
      </div>

      <!-- Right Wing: Vertical Dashed Timeline -->
      <div class="customer-right-wing" aria-label="Customer Journey Progress">
        <div class="timeline-vertical-dashed" aria-hidden="true"></div>
        <ul class="timeline-steps-list">
          <li class="timeline-item active" data-step="1">
            <span class="item-dot"></span>
            <span class="item-text">Customer gets notification</span>
          </li>
          <li class="timeline-item" data-step="2">
            <span class="item-dot"></span>
            <span class="item-text">Run face verification</span>
          </li>
          <li class="timeline-item" data-step="3">
            <span class="item-dot"></span>
            <span class="item-text">Customer pays</span>
          </li>
          <li class="timeline-item" data-step="4">
            <span class="item-dot"></span>
            <span class="item-text">Success! 🍾</span>
          </li>
        </ul>
      </div>

      <!-- ====================================================================
           THE DOMINANT CENTERPIECE: ELONGATED SMARTPHONE MOCKUP
           ==================================================================== -->
      <div class="scrolly-phone-container" id="interactive-phone">
        <div class="phone-chassis">
          
          <!-- Top Speaker / Camera Slot -->
          <div class="phone-speaker-slot" aria-hidden="true">
            <div class="chassis-camera"></div>
            <div class="chassis-speaker"></div>
          </div>

          <!-- Phone Screen -->
          <div class="phone-screen" role="region" aria-live="polite" aria-label="Customer Rental Mobile Flow">
            
            <!-- Status Bar -->
            <div class="screen-status-bar" aria-hidden="true">
              <span class="status-time">9:41</span>
              <div class="status-indicators">
                <svg width="13" height="9" viewBox="0 0 14 10" fill="currentColor">
                  <path d="M1 7h2v3H1zM4 5h2v5H4zM7 3h2v7H7zM10 1h2v9h-2z"/>
                </svg>
                <svg width="12" height="9" viewBox="0 0 16 12" fill="currentColor">
                  <path d="M8 2.5a9.8 9.8 0 0 1 6.5 2.5l-6.5 7-6.5-7A9.8 9.8 0 0 1 8 2.5z"/>
                </svg>
                <div class="status-battery">
                  <div class="battery-fill"></div>
                </div>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 1: Summary Transaction (webspo-flecto-2.png)
                 ------------------------------------------------------------- -->
            <div class="phone-state-view active" id="phone-state-1" data-state="1">
              <div class="summary-top-nav">
                <button type="button" class="phone-circle-btn" aria-label="Back">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="summary-top-title">Summary Transaction</span>
                <button type="button" class="phone-circle-btn" aria-label="Help">?</button>
              </div>

              <!-- Flecto Emblem Badge -->
              <div class="flecto-emblem-badge" aria-hidden="true">
                <svg width="44" height="44" viewBox="0 0 48 48" fill="none">
                  <rect width="48" height="48" rx="14" fill="#57f09e"/>
                  <rect x="14" y="15" width="9" height="7" rx="3.5" fill="#004737"/>
                  <rect x="25" y="15" width="13" height="7" rx="3.5" fill="#004737"/>
                  <rect x="10" y="26" width="13" height="7" rx="3.5" fill="#004737"/>
                  <rect x="25" y="26" width="9" height="7" rx="3.5" fill="#004737"/>
                </svg>
              </div>

              <div class="summary-meta-block">
                <h4 class="summary-booking-name">Flecto Booking</h4>
                <span class="summary-booking-date">On Mar 19, 2022</span>
              </div>

              <!-- Monumental Price -->
              <div class="summary-amount-display">€690.00</div>

              <!-- Bottom Sheet Card: Pay in Store -->
              <div class="summary-bottom-card" id="trigger-step-2" tabindex="0" role="button" aria-label="Open booking details">
                <div class="bottom-card-header">
                  <span class="bottom-card-title">Pay in Store</span>
                </div>
                
                <div class="store-row">
                  <div class="store-schematic-thumb" aria-hidden="true">
                    <img src="/assets/synthetic/store-schematic.svg" alt="Colorfoto Porto" />
                  </div>
                  <div class="store-details">
                    <strong class="store-name">Colorfoto Porto</strong>
                    <p class="store-address">R. de Sá da Bandeira 526, 4000-430 Porto 22 016 3090</p>
                  </div>
                </div>

                <div class="bottom-card-button">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                  </svg>
                  <span>Pay Later</span>
                </div>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN INVENTORY: Inventory Items List (Evidence elem-62bb3a259519f446072569)
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-inventory" data-state="inventory" style="display: none; opacity: 0; background: #063124; color: #ffffff; flex-direction: column; justify-content: space-between; padding-top: 1.25rem;">
              <!-- Top Nav -->
              <div class="summary-top-nav" style="padding: 0 1.25rem; display: flex; align-items: center; justify-content: space-between;">
                <button type="button" class="phone-circle-btn" aria-label="Back" style="background: rgba(255,255,255,0.1); border: none; color: #ffffff; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="summary-top-title" style="font-size: 0.9375rem; font-weight: 600; color: #ffffff;">Your Booking</span>
                <button type="button" class="phone-circle-btn" aria-label="Help" style="background: rgba(255,255,255,0.1); border: none; color: #ffffff; width: 28px; height: 28px; border-radius: 50%; font-size: 0.75rem; font-weight: 700; cursor: pointer;">?</button>
              </div>

              <!-- Date Range Display -->
              <div style="text-align: center; margin: 1.5rem 0 1rem;">
                <div style="display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--primitive-font-mono); font-size: 1rem; font-weight: 700; color: #57f09e;">
                  <span>2022/03/20</span>
                  <div style="width: 20px; height: 20px; border-radius: 50%; background: #57f09e; color: #063124; display: flex; align-items: center; justify-content: center;">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                  </div>
                  <span>2022/03/24</span>
                </div>
                <div style="font-size: 0.75rem; color: rgba(255,255,255,0.6); margin-top: 0.25rem;">5-day rental</div>
              </div>

              <!-- Cream Bottom Sheet -->
              <div style="background: #fcf9f2; color: #063124; border-radius: 28px 28px 0 0; padding: 1.25rem 1.25rem 1.5rem; margin-top: auto; box-shadow: 0 -4px 20px rgba(0,0,0,0.15);">
                <!-- Table Header -->
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 600; color: #5a7369; margin-bottom: 0.75rem;">
                  <span style="font-weight: 700; color: #063124; font-size: 0.875rem;">Items</span>
                  <div style="display: flex; gap: 1.5rem;">
                    <span>Price</span>
                    <span>Deposit</span>
                  </div>
                </div>

                <!-- Main Rental Item -->
                <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid #e5eae6;">
                  <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <div style="width: 32px; height: 32px; background: #000000; border-radius: 8px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                      <img src="/assets/synthetic/camera-vector.svg" width="24" height="24" alt="GoPro HERO10" />
                    </div>
                    <div>
                      <strong style="display: block; font-size: 0.8125rem; font-weight: 700; color: #063124;">GoPro HERO10</strong>
                      <span style="font-size: 0.6875rem; color: #5a7369;">x1</span>
                    </div>
                  </div>
                  <div style="display: flex; gap: 1.25rem; text-align: right;">
                    <div>
                      <strong style="display: block; font-size: 0.75rem; font-weight: 700; color: #063124;">€100.00</strong>
                      <span style="font-size: 0.625rem; color: #5a7369;">/day</span>
                    </div>
                    <div>
                      <strong style="display: block; font-size: 0.75rem; font-weight: 700; color: #063124;">€200</strong>
                      <span style="font-size: 0.625rem; color: #5a7369;">/booking</span>
                    </div>
                  </div>
                </div>

                <!-- Additional Services (Dynamically toggled) -->
                <div id="inv-additional-services-row" style="display: none; padding: 0.75rem 0; border-bottom: 1px solid #e5eae6;">
                  <span style="display: block; font-size: 0.6875rem; font-weight: 700; color: #5a7369; margin-bottom: 0.4rem;">Additional Services</span>
                  <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                      <div style="width: 18px; height: 18px; border-radius: 50%; background: #4361ee; display: flex; align-items: center; justify-content: center;">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                          <rect x="1" y="3" width="15" height="13"/>
                          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                          <circle cx="5.5" cy="18.5" r="2.5"/>
                          <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                      </div>
                      <span style="font-size: 0.75rem; font-weight: 600; color: #063124;">Delivery (Pick-up & Return)</span>
                    </div>
                    <strong style="font-size: 0.75rem; font-weight: 700; color: #063124;">€20.00</strong>
                  </div>
                </div>

                <!-- Totals -->
                <div style="padding-top: 0.75rem;">
                  <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #5a7369; margin-bottom: 0.25rem;">
                    <span>Rental</span>
                    <span id="inv-rental-subtotal" style="font-family: var(--primitive-font-mono);">€500.00</span>
                  </div>
                  <div style="display: flex; justify-content: space-between; font-size: 0.9375rem; font-weight: 700; color: #063124; margin-bottom: 1rem;">
                    <span>Total</span>
                    <span id="inv-total-amount" style="font-family: var(--primitive-font-mono);">€500.00</span>
                  </div>

                  <button type="button" class="phone-submit-btn" style="width: 100%; background: #063124; color: #ffffff; border: none; border-radius: 100px; padding: 0.85rem; font-size: 0.875rem; font-weight: 700; cursor: pointer; transition: background 0.2s ease;">
                    Proceed To Pay
                  </button>
                </div>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 2: Biometric & ID Verification
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-2" data-state="2">
              <div class="state-subnav">
                <button type="button" class="phone-back-btn" data-target="1" aria-label="Back to summary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="subnav-title">ID Verification</span>
                <span class="secure-tag">Secure</span>
              </div>

              <div class="face-scan-wrapper">
                <div class="scan-laser-box" aria-hidden="true">
                  <div class="corner-bracket top-l"></div>
                  <div class="corner-bracket top-r"></div>
                  <div class="corner-bracket bot-l"></div>
                  <div class="corner-bracket bot-r"></div>
                  <div class="scan-line"></div>
                  <svg class="face-vector" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="rgba(87, 240, 158, 0.45)" stroke-width="1.5">
                    <circle cx="12" cy="8" r="5"/>
                    <path d="M20 21a8 8 0 1 0-16 0"/>
                  </svg>
                </div>

                <div class="scan-copy">
                  <h4>Biometric Verification</h4>
                  <p>Quick 3D scan matching John Cooper's driver license.</p>
                </div>

                <button type="button" class="phone-submit-btn" id="confirm-face-scan">
                  <span>Confirm & Continue</span>
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="2 7 5.5 10.5 12 3"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 3: Payment Breakdown & Checkout
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-3" data-state="3">
              <div class="state-subnav">
                <button type="button" class="phone-back-btn" data-target="2" aria-label="Back to face ID">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="subnav-title">Checkout</span>
                <span class="booking-hash text-mono">#FL-88219</span>
              </div>

              <div class="checkout-scroll-body">
                <div class="checkout-item-card">
                  <div class="item-schematic-icon" aria-hidden="true">
