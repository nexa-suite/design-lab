---
/**
 * OnlineStoreCard Component
 * Channel Card 3: Online Store (acme.store) preview card with photo and rent action capsule.
 */
interface Props {
  domain?: string;
  item?: string;
  price?: string;
  isIsolated?: boolean;
}

const {
  domain = 'acme.store',
  item = 'Gopro',
  price = '100€/Day',
  isIsolated = false
} = Astro.props;
---

<article class={`channel-card card-online ${isIsolated ? 'is-isolated' : ''}`} aria-label="Online Store Channel">
  <div class="online-card-topbar">
    <svg class="browser-lock-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    <span class="browser-domain-text text-mono">{domain}</span>
  </div>

  <div class="online-card-body">
    <div class="card-thumb-wrap gopro-wrap">
      <img 
        src="/assets/synthetic/camera-vector.svg" 
        alt="Action Camera" 
        class="card-thumb-img" 
        loading="eager"
        width="58"
        height="48"
      />
    </div>
    <div class="card-details-col">
      <p class="card-sub-label">
        {item} available <br />
        for renting <strong class="channel-bold">Online</strong>
      </p>
    </div>
  </div>

  <div class="online-action-capsule">
    <span class="capsule-price text-mono">{price}</span>
    <span class="capsule-divider" aria-hidden="true">|</span>
    <span class="capsule-rent-btn">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <span>RENT</span>
    </span>
  </div>
</article>

<style>
  .channel-card {
    position: absolute;
    background-color: var(--stage-card, #38c8ff);
    border-radius: 16px;
    box-shadow: none !important;
    border: none !important;
    z-index: 7;
    cursor: default;
    color: var(--stage-text, #082846);
    transition: transform 0.25s ease, background-color 0.3s ease, color 0.3s ease;
  }

  .channel-card.is-isolated {
    position: relative;
    left: auto !important;
    top: auto !important;
    margin: 0 auto;
    max-width: 100%;
  }

  .channel-card:hover {
    transform: translateY(-2px);
  }

  .card-online {
    left: 850px;
    top: 35px;
    width: 260px;
    height: 200px;
    padding: 0.75rem 0.95rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .online-card-topbar {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--stage-capsule-bg);
    color: var(--stage-capsule-text);
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.6875rem;
    font-weight: 600;
    align-self: flex-start;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .browser-domain-text {
    font-family: 'JetBrains Mono', monospace;
  }

  .online-card-body {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .gopro-wrap {
    width: 60px;
    height: 52px;
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-details-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-sub-label {
    font-size: 0.8125rem;
    line-height: 1.25;
    color: var(--stage-text);
  }

  .channel-bold {
    font-weight: 800;
    color: var(--stage-text);
  }

  .online-action-capsule {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--stage-capsule-bg);
    color: var(--stage-capsule-text);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-weight: 700;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .capsule-price {
    color: var(--stage-card);
    font-family: 'JetBrains Mono', monospace;
  }

  .capsule-divider {
    color: rgba(255, 255, 255, 0.3);
  }

  .capsule-rent-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--stage-capsule-text);
  }
</style>
