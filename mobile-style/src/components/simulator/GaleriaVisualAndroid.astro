---
/**
 * GaleriaVisualAndroid.astro
 * Master Multi-Device Android Showcase & Visual Report Gallery
 *
 * Fully visual-first presentation for executive reports, PDF exports, and multi-device studio validation.
 * Features 5 Android Form Factors with clean white backgrounds, zero dark blue cards,
 * persistent M3 TopAppBar, and ALWAYS ACTIVE BottomNav / NavigationRail:
 *
 * 1. Samsung Galaxy S24 / Pixel 8 (390×844dp Compact Phone): Operaciones Nexa · Despacho en Ruta (Exact Image 4 gold standard!)
 * 2. Samsung Galaxy S24 Ultra (412×915dp Phablet): Catálogo Mayorista B2B Frigorífico
 * 3. Zebra TC58 Rugged Enterprise Terminal (412×820dp Industrial Phone): Inspección ISO 3691 & Prueba POD
 * 4. Samsung Galaxy Tab Active 8" (600×960dp Compact Tablet): Tablero Kanban de Despacho (Spacious 4 columns, FIXED from Image 3!)
 * 5. Samsung Galaxy Tab S9 11" (800×1280dp Expanded Tablet): Consola de Patio & Telemetría TwoPane con GPS y Curva de Frío 2°C-6°C
 */
---

<section class="android-showcase-section" id="device-showcase">
  <!-- Section Header -->
  <header class="showcase-header">
    <div class="header-content">
      <span class="section-kicker-badge">
        <i class="pi pi-android" aria-hidden="true"></i> ANDROID MULTI-DEVICE STUDIO · JETPACK COMPOSE M3
      </span>
      <h2 class="showcase-title">Galería Visual Multi-Dispositivo Android (100% Visual Report)</h2>
      <p class="showcase-intro">
        Demostración 1:1 de interfaces nativas sobre los 5 factores de forma Android estándar de la suite <strong>Nexa Mobile</strong>.
        Diseño minimalista puro con <strong>fondo blanco, tarjetas limpias, TopAppBar persistente y Navbar activa en todas las pantallas</strong>.
      </p>
    </div>

    <!-- Quick Filter / Device Jump Bar -->
    <div class="device-switcher-bar" role="tablist" aria-label="Filtro de factor de forma Android">
      <button type="button" class="dev-filter-btn active" data-filter="all">
        <i class="pi pi-th-large"></i> Todos los Dispositivos (5)
      </button>
      <button type="button" class="dev-filter-btn" data-filter="s24">
        <i class="pi pi-mobile"></i> Galaxy S24 (390dp)
      </button>
      <button type="button" class="dev-filter-btn" data-filter="s24ultra">
        <i class="pi pi-mobile"></i> S24 Ultra (412dp)
      </button>
      <button type="button" class="dev-filter-btn" data-filter="zebra">
        <i class="pi pi-shield"></i> Zebra TC58 (412dp)
      </button>
      <button type="button" class="dev-filter-btn" data-filter="tab-active">
        <i class="pi pi-tablet"></i> Tab Active 8" (600dp)
      </button>
      <button type="button" class="dev-filter-btn" data-filter="tab-s9">
        <i class="pi pi-desktop"></i> Tab S9 11" (TwoPane)
      </button>
    </div>
  </header>

  <!-- Showcase Gallery Grid -->
  <div class="showcase-devices-grid">

    <!-- =========================================================================
         DEVICE 1: Samsung Galaxy S24 / Pixel 8 (390×844dp Compact Phone)
         EXACT GOLD STANDARD FROM USER'S IMAGE 4!
         ========================================================================= -->
    <div class="device-card-wrapper" data-device="s24" id="device-samsung-s24">
      <div class="device-meta-header">
        <div class="meta-title-col">
          <span class="device-eyebrow">DISPOSITIVO 1 · SMARTPHONE COMPACTO (390×844dp)</span>
          <h3 class="device-name">Samsung Galaxy S24 / Google Pixel 8</h3>
          <p class="device-sub">Pantalla: Operaciones Nexa · Despacho en Ruta (Cadena de Frío)</p>
        </div>
        <div class="meta-pills">
          <span class="meta-pill role"><i class="pi pi-truck"></i> Chofer en Ruta</span>
          <span class="meta-pill touch"><i class="pi pi-check"></i> 48dp / 56dp OK</span>
          <span class="meta-pill gold"><i class="pi pi-star-fill"></i> Gold Standard</span>
        </div>
      </div>

      <!-- Physical Device Chassis -->
      <div class="android-chassis phone-s24">
        <div class="chassis-speaker-slit"></div>
        <div class="chassis-punch-hole"></div>

        <!-- Screen Surface -->
        <div class="android-screen-surface">
          <!-- Android 14 System Bar -->
          <div class="m3-system-bar">
            <span class="sys-time">14:35</span>
            <div class="sys-icons">
              <span class="sys-tech">5G LTE</span>
              <i class="pi pi-wifi"></i>
              <i class="pi pi-bolt"></i>
              <span class="sys-battery">94%</span>
            </div>
          </div>

          <!-- M3 TopAppBar (Image 4 exact) -->
          <header class="m3-top-bar">
            <button type="button" class="top-bar-btn" aria-label="Menú">
              <i class="pi pi-bars"></i>
            </button>
            <h4 class="top-bar-title">Operaciones Nexa</h4>
            <button type="button" class="top-bar-btn notif" aria-label="Notificaciones">
              <i class="pi pi-bell"></i>
              <span class="notif-red-dot"></span>
            </button>
          </header>

          <!-- Screen Body: Operaciones Despacho (Image 4 exact) -->
          <div class="screen-scroll-body">
            <!-- Driver Card -->
            <div class="driver-card-white">
              <div class="driver-avatar-circle">
                <i class="pi pi-user"></i>
              </div>
              <div class="driver-info-block">
                <div class="driver-name-row">
                  <strong class="driver-name">Diego Morales</strong>
                  <span class="status-pill-cyan">● EN RUTA</span>
                </div>
                <span class="driver-detail-text">Conductor Flota C-250 · ID #4829</span>
                <span class="driver-detail-sub">Furgón Refrigerado · Placa WKN-892</span>
              </div>
            </div>

            <!-- Section Label -->
            <div class="screen-section-label">DESPACHO EN CURSO · CADENA DE FRÍO</div>

            <!-- Dispatch Card (Image 4 exact) -->
            <div class="dispatch-card-white">
              <div class="dispatch-card-top">
                <span class="order-code-mono">SO-2026-0018</span>
                <span class="cold-chip-pill">
                  <i class="pi pi-snowflake"></i> 2°C – 6°C
                </span>
              </div>

              <div class="dispatch-buyer-info">
                <h5 class="buyer-company-name">ICISA Distribuciones</h5>
                <p class="buyer-cargo-desc">24x Salmón Salar (ALM-LMO-982) + 12x Merluza Austral</p>
              </div>

              <!-- Route Timeline with blue and green dots -->
              <div class="route-timeline-box">
                <div class="timeline-stop">
                  <span class="timeline-dot blue"></span>
                  <div class="timeline-stop-text">
                    <strong class="stop-name">Almacén Frigorífico Central</strong>
                    <span class="stop-time">Salida Muelle 3 Frío · 13:45</span>
                  </div>
                </div>
                <div class="timeline-vertical-line"></div>
                <div class="timeline-stop">
                  <span class="timeline-dot cyan"></span>
                  <div class="timeline-stop-text">
                    <strong class="stop-name">ICISA Distribuciones (Av. Argentina 1240)</strong>
                    <span class="stop-time">ETA 14:20 · Sensor Calibrado 3.8°C</span>
                  </div>
                </div>
              </div>

              <!-- Full-width solid blue CTA button (Image 4 exact) -->
              <button type="button" class="btn-solid-blue-cta">
                <i class="pi pi-check-circle"></i>
                <span>Confirmar Entrega en Sitio (POD)</span>
              </button>
            </div>

            <!-- Extra Order Summary Card -->
            <div class="quick-telemetry-card">
              <div class="telemetry-item">
                <span class="tel-label">Temperatura Caja</span>
                <strong class="tel-val success"><i class="pi pi-check-circle"></i> 3.8°C</strong>
              </div>
              <div class="telemetry-separator"></div>
              <div class="telemetry-item">
                <span class="tel-label">Batería Termógrafo</span>
                <strong class="tel-val">88% (Sensirion)</strong>
              </div>
            </div>
          </div>

          <!-- Bottom Navigation Bar (Image 5 exact - ALWAYS ACTIVE!) -->
          <nav class="m3-bottom-nav" aria-label="Navegación Móvil Principal">
            <div class="bnav-item active">
              <div class="bnav-pill-indicator">
                <i class="pi pi-map-marker"></i>
              </div>
              <span class="bnav-label">Rutas</span>
            </div>
            <div class="bnav-item">
              <div class="bnav-pill-indicator">
                <i class="pi pi-send"></i>
              </div>
              <span class="bnav-label">Despacho</span>
            </div>
            <div class="bnav-item">
              <div class="bnav-pill-indicator">
                <i class="pi pi-box"></i>
              </div>
              <span class="bnav-label">Picking</span>
            </div>
            <div class="bnav-item">
              <div class="bnav-pill-indicator">
                <i class="pi pi-check-square"></i>
              </div>
              <span class="bnav-label">Checklist</span>
            </div>
          </nav>
        </div>
      </div>
    </div>


    <!-- =========================================================================
         DEVICE 2: Samsung Galaxy S24 Ultra (412×915dp Flagship Phablet)
         B2B WHOLESALE REFRIGERATED CATALOG WITH BOX STEPPERS & TIER PRICING
         ========================================================================= -->
    <div class="device-card-wrapper" data-device="s24ultra" id="device-s24-ultra">
      <div class="device-meta-header">
        <div class="meta-title-col">
          <span class="device-eyebrow">DISPOSITIVO 2 · PHABLET MAYORISTA (412×915dp)</span>
          <h3 class="device-name">Samsung Galaxy S24 Ultra</h3>
          <p class="device-sub">Pantalla: Catálogo Mayorista B2B Frigorífico & Tier Pricing</p>
        </div>
        <div class="meta-pills">
          <span class="meta-pill role"><i class="pi pi-shopping-bag"></i> Comprador B2B</span>
          <span class="meta-pill touch"><i class="pi pi-check"></i> Steppers 48dp</span>
          <span class="meta-pill feature"><i class="pi pi-percentage"></i> Tier Volume -8%</span>
        </div>
      </div>

      <!-- Physical Device Chassis -->
      <div class="android-chassis phone-s24-ultra">
        <div class="chassis-speaker-slit"></div>
        <div class="chassis-punch-hole"></div>

        <!-- Screen Surface -->
        <div class="android-screen-surface">
          <!-- Android 14 System Bar -->
          <div class="m3-system-bar">
            <span class="sys-time">14:35</span>
            <div class="sys-icons">
              <span class="sys-tech">5G Ultra</span>
              <i class="pi pi-wifi"></i>
              <span class="sys-battery">89%</span>
            </div>
          </div>

          <!-- M3 TopAppBar -->
          <header class="m3-top-bar">
            <button type="button" class="top-bar-btn" aria-label="Volver">
              <i class="pi pi-arrow-left"></i>
            </button>
            <h4 class="top-bar-title">Catálogo Mayorista B2B</h4>
            <div class="top-bar-actions">
              <button type="button" class="top-bar-btn notif" aria-label="Carrito de Compras">
                <i class="pi pi-shopping-cart"></i>
                <span class="notif-badge-number">3</span>
              </button>
            </div>
          </header>

          <!-- Screen Body: Wholesale Catalog -->
          <div class="screen-scroll-body">
            <!-- Search & Quick Filter Chips -->
            <div class="catalog-search-row">
              <div class="catalog-search-field">
                <i class="pi pi-search"></i>
                <input type="text" placeholder="Buscar salmón, merluza, cortes..." readonly value="Salmón Salar" />
              </div>
            </div>

            <!-- Horizontal Filter Chips -->
            <div class="catalog-chips-scroll">
              <span class="cat-chip active">Todos (48)</span>
              <span class="cat-chip">❄️ Congelados (-18°C)</span>
              <span class="cat-chip">🧊 Frescos (2°-6°C)</span>
              <span class="cat-chip">🔥 Oferta Volumen</span>
            </div>

            <!-- Volume Discount Banner -->
            <div class="volume-discount-banner">
              <i class="pi pi-bolt"></i>
              <div>
                <strong>Descuento por Volumen Escalonado (-8%)</strong>
                <span>Aplicado automáticamente al superar 20 cajas en categoría Frigorífico</span>
              </div>
            </div>

            <!-- Product Card 1: Salmón Salar -->
            <div class="b2b-product-card">
              <div class="prod-badge-row">
                <span class="prod-sku">SKU: SAL-LMO-982</span>
                <span class="cold-chip-pill"><i class="pi pi-snowflake"></i> -18.0°C</span>
              </div>
              <h5 class="prod-title">Salmón Salar Premium IQF (4-5 kg)</h5>
              <p class="prod-desc">Cajas de 20kg selladas al vacío · Origen Calbuco</p>

              <div class="prod-pricing-row">
                <div class="prod-price-block">
                  <span class="prod-unit-price">$14.20 / kg</span>
                  <span class="prod-box-price">$284.00 por caja</span>
                </div>

                <!-- Box Stepper (min 48dp touch targets) -->
                <div class="box-stepper-control">
                  <button type="button" class="btn-stepper minus" aria-label="Restar caja">−</button>
                  <span class="stepper-val">12 cjs</span>
                  <button type="button" class="btn-stepper plus" aria-label="Sumar caja">+</button>
                </div>
              </div>

              <div class="prod-subtotal-bar">
                <span>Subtotal (240 kg):</span>
                <strong>$3,408.00</strong>
              </div>
            </div>

            <!-- Product Card 2: Merluza Austral -->
            <div class="b2b-product-card">
              <div class="prod-badge-row">
                <span class="prod-sku">SKU: MER-AUS-104</span>
                <span class="cold-chip-pill"><i class="pi pi-snowflake"></i> -18.0°C</span>
              </div>
              <h5 class="prod-title">Merluza Austral Filete Interfoliado</h5>
              <p class="prod-desc">Cajas de 10kg · Grado Exportación A</p>

              <div class="prod-pricing-row">
                <div class="prod-price-block">
                  <span class="prod-unit-price">$9.80 / kg</span>
                  <span class="prod-box-price">$98.00 por caja</span>
                </div>

                <div class="box-stepper-control">
                  <button type="button" class="btn-stepper minus" aria-label="Restar caja">−</button>
                  <span class="stepper-val">6 cjs</span>
                  <button type="button" class="btn-stepper plus" aria-label="Sumar caja">+</button>
                </div>
              </div>

              <div class="prod-subtotal-bar">
                <span>Subtotal (60 kg):</span>
                <strong>$588.00</strong>
              </div>
            </div>

            <!-- Product Card 3: Trucha Arcoíris -->
            <div class="b2b-product-card">
              <div class="prod-badge-row">
                <span class="prod-sku">SKU: TRU-AND-302</span>
                <span class="cold-chip-pill"><i class="pi pi-snowflake"></i> 3.2°C Fresco</span>
              </div>
              <h5 class="prod-title">Trucha Arcoíris Deshuesada Fresca</h5>
              <p class="prod-desc">Cajas de 15kg con hielo gel · Cadena 2°C a 4°C</p>

              <div class="prod-pricing-row">
                <div class="prod-price-block">
                  <span class="prod-unit-price">$11.50 / kg</span>
                  <span class="prod-box-price">$172.50 por caja</span>
                </div>

                <div class="box-stepper-control">
                  <button type="button" class="btn-stepper minus" aria-label="Restar caja">−</button>
                  <span class="stepper-val">2 cjs</span>
                  <button type="button" class="btn-stepper plus" aria-label="Sumar caja">+</button>
                </div>
              </div>

              <div class="prod-subtotal-bar">
                <span>Subtotal (30 kg):</span>
                <strong>$345.00</strong>
              </div>
            </div>

            <!-- Floating Order Summary Floating Bar (above BottomNav) -->
            <div class="b2b-order-summary-dock">
              <div class="summary-left">
                <span class="summary-qty">20 Cajas · 330 kg (Tier -8% activo)</span>
                <strong class="summary-total">$4,341.00 USD</strong>
              </div>
              <button type="button" class="btn-solid-blue-cta sm">
                <span>Emitir Orden B2B</span>
                <i class="pi pi-arrow-right"></i>
              </button>
            </div>
          </div>

          <!-- Bottom Navigation Bar (B2B Commercial - ALWAYS ACTIVE!) -->
          <nav class="m3-bottom-nav" aria-label="Navegación Móvil Principal B2B">
            <div class="bnav-item active">
              <div class="bnav-pill-indicator">
                <i class="pi pi-shopping-bag"></i>
              </div>
              <span class="bnav-label">Catálogo</span>
            </div>
            <div class="bnav-item">
              <div class="bnav-pill-indicator">
                <i class="pi pi-list"></i>
              </div>
              <span class="bnav-label">Pedidos</span>
            </div>
            <div class="bnav-item">
              <div class="bnav-pill-indicator">
                <i class="pi pi-compass"></i>
              </div>
              <span class="bnav-label">Tracking</span>
            </div>
            <div class="bnav-item">
              <div class="bnav-pill-indicator">
                <i class="pi pi-user"></i>
              </div>
              <span class="bnav-label">Mi Cuenta</span>
            </div>
          </nav>
        </div>
      </div>
    </div>


    <!-- =========================================================================
         DEVICE 3: Zebra TC58 Rugged Enterprise Terminal (412×820dp Industrial)
         ISO 3691 FORKLIFT SAFETY INSPECTION & POD SIGNATURE
         ========================================================================= -->
    <div class="device-card-wrapper" data-device="zebra" id="device-zebra-tc58">
      <div class="device-meta-header">
        <div class="meta-title-col">
          <span class="device-eyebrow">DISPOSITIVO 3 · TERMINAL INDUSTRIAL RUGGED (412×820dp)</span>
          <h3 class="device-name">Zebra TC58 Rugged Enterprise</h3>
          <p class="device-sub">Pantalla: Inspección Pre-operacional ISO 3691 & Firma Digital POD</p>
        </div>
        <div class="meta-pills">
          <span class="meta-pill industrial"><i class="pi pi-shield"></i> IP68 · Mil-STD-810H</span>
          <span class="meta-pill touch"><i class="pi pi-hand"></i> 56dp Guantes Frío</span>
          <span class="meta-pill zebra"><i class="pi pi-qrcode"></i> Lector SE55</span>
        </div>
      </div>

      <!-- Physical Device Chassis (Rugged Industrial Bumper) -->
      <div class="android-chassis phone-zebra">
        <!-- Rugged Scanner Window Accent -->
        <div class="zebra-top-scanner-bumper">
          <div class="scanner-amber-stripe"></div>
          <span class="zebra-brand-label">ZEBRA TC58 · ENTERPRISE SE55</span>
          <div class="scanner-amber-stripe"></div>
        </div>

        <!-- Screen Surface -->
        <div class="android-screen-surface">
          <!-- Industrial System Bar -->
          <div class="m3-system-bar zebra-bar">
            <span class="sys-time">14:35</span>
            <div class="sys-icons">
              <span class="sys-tech">Zebra Wi-Fi 6E</span>
              <i class="pi pi-qrcode text-warning"></i>
              <span class="sys-battery">96%</span>
            </div>
          </div>

          <!-- M3 TopAppBar -->
          <header class="m3-top-bar">
            <button type="button" class="top-bar-btn" aria-label="Menú">
              <i class="pi pi-bars"></i>
            </button>
            <div class="top-bar-dual-title">
              <h4 class="top-bar-title">Inspección ISO 3691</h4>
              <span class="unit-code-badge">Montacargas Linde H30 #04</span>
            </div>
            <button type="button" class="top-bar-btn notif" aria-label="Alertas">
              <i class="pi pi-bell"></i>
            </button>
          </header>

          <!-- Screen Body: Forklift Inspection & POD -->
          <div class="screen-scroll-body">
            <!-- Ignition Interlock Warning Banner -->
            <div class="ignition-warning-banner">
              <div class="warning-icon-box">
                <i class="pi pi-exclamation-triangle"></i>
              </div>
              <div class="warning-text-col">
                <strong>BLOQUEO DE IGNICIÓN ACTIVO</strong>
                <span>Completar los 4 puntos de seguridad para habilitar el arranque del equipo</span>
              </div>
            </div>

            <!-- ISO 3691 Safety Switches (56dp touch targets with high-contrast tactile toggles) -->
            <div class="screen-section-label">LISTA DE COMPROBACIÓN PREVIA AL TURNO (56DP)</div>

            <div class="safety-switches-card">
              <!-- Switch 1 -->
              <div class="safety-switch-row">
                <div class="switch-info">
                  <strong class="switch-title">Freno de Mano & Presión Hidráulica</strong>
                  <span class="switch-desc">Presión &gt;160 bar sin fugas en vástagos</span>
                </div>
                <div class="tactile-toggle-cyan" role="switch" aria-checked="true">
                  <span class="toggle-track active">
                    <span class="toggle-thumb"></span>
                  </span>
                  <span class="toggle-status">CONFORME</span>
                </div>
              </div>

              <!-- Switch 2 -->
              <div class="safety-switch-row">
                <div class="switch-info">
                  <strong class="switch-title">Horquillas & Cadena de Elevación</strong>
                  <span class="switch-desc">Sin fisuras, desgaste &lt;10%, pasadores fijos</span>
                </div>
                <div class="tactile-toggle-cyan" role="switch" aria-checked="true">
                  <span class="toggle-track active">
                    <span class="toggle-thumb"></span>
                  </span>
                  <span class="toggle-status">CONFORME</span>
                </div>
              </div>

              <!-- Switch 3 -->
              <div class="safety-switch-row">
                <div class="switch-info">
                  <strong class="switch-title">Extintor PQS & Alarma Reversa Sonora</strong>
                  <span class="switch-desc">Manómetro en verde · Alarma audible &gt;95dB</span>
                </div>
                <div class="tactile-toggle-cyan" role="switch" aria-checked="true">
                  <span class="toggle-track active">
                    <span class="toggle-thumb"></span>
                  </span>
                  <span class="toggle-status">CONFORME</span>
                </div>
              </div>

              <!-- Switch 4 -->
              <div class="safety-switch-row">
                <div class="switch-info">
                  <strong class="switch-title">Sensor Presencia Operador (Deadman)</strong>
                  <span class="switch-desc">Interruptor de asiento calibrado en frío</span>
                </div>
                <div class="tactile-toggle-cyan" role="switch" aria-checked="true">
                  <span class="toggle-track active">
                    <span class="toggle-thumb"></span>
                  </span>
                  <span class="toggle-status">CONFORME</span>
                </div>
              </div>
            </div>

            <!-- Proof of Delivery (POD) Digital Signature Pad -->
            <div class="screen-section-label">PRUEBA DE RECEPCIÓN (POD) & FIRMA DIGITAL</div>

            <div class="pod-signature-card">
              <div class="pod-signer-meta">
                <div>
                  <strong class="signer-name">Carlos Santillana</strong>
                  <span class="signer-doc">DNI: 44.921.804 · Jefe de Muelle 3</span>
                </div>
                <span class="signer-badge-ok"><i class="pi pi-check"></i> Verificado</span>
              </div>

              <!-- HTML5 / SVG Digital Signature Pad -->
              <div class="signature-canvas-box">
                <!-- Vector stylized signature -->
                <svg class="sig-svg" viewBox="0 0 320 80" xmlns="http://www.w3.org/2000/svg">
                  <path d="M 20 50 Q 50 15, 75 40 T 130 35 Q 160 10, 180 55 T 230 45 Q 260 20, 290 40" fill="none" stroke="#1d4ed8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M 60 48 Q 110 58, 220 50" fill="none" stroke="#1d4ed8" stroke-width="1.8" stroke-linecap="round" />
                  <circle cx="280" cy="38" r="2.5" fill="#1d4ed8" />
                </svg>
                <div class="sig-watermark-row">
                  <span>Timestamp: 2026-09-27 14:22:18 COT</span>
                  <span class="sig-hash">SHA-256: d8f3a9e4...</span>
                </div>
              </div>

              <!-- Industrial 56dp Action Button -->
              <button type="button" class="btn-solid-blue-cta industrial-56dp">
                <i class="pi pi-shield"></i>
                <span>Validar Inspección & Liberar Ignición</span>
              </button>
