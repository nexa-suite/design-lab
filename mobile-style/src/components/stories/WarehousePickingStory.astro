---
/**
 * WarehousePickingStory.astro
 * Canonical Mobile Specification for Warehouse & FEFO Picking Operations
 * Blueprint Traceability: MOB-US-010..025 (MOBILE-EPIC-02 & 08)
 * Canonical Persona: Alejandro · Operador de Almacén Frigorífico Central
 * Canonical Client: La Cava Fría
 * Canonical Order: DSP-204
 * Canonical Location: Pasillo B · Rack 04 · Nivel 2 · Posición 12 (B-04-N2-P12)
 * Canonical Product: Salmón Salar Congelado 4-5kg (SKU ALM-LMO-982) · Lote FEFO L-20260914-A
 * Architecture: Web-Style Canonical Cuadros for Android Jetpack Compose & Kotlin
 */
---

<div class="story-screen-container" id="story-bodega">
  
  <!-- Web-Style Documentation Heading (Section Index + Kicker + Display H2 + Intro) -->
  <header class="section-heading-block">
    <div class="section-heading">
      <span class="section-index">02</span>
      <div>
        <p class="section-kicker">WAREHOUSE / FEFO PICKING · BLUEPRINT MOB-US-010..025</p>
        <h2>Alejandro — Operaciones de Picking en Frío y Validación de Lotes FEFO</h2>
        <p class="section-intro">
          Especificación canónica para terminales industriales Android (Zebra TC58 / Honeywell) en almacén frigorífico central. Diseñada para operar a -20°C con navegación guiada por estantería (<code>B-04-N2-P12</code>), recomendación algorítmica <em>First-Expired, First-Out</em> (FEFO), telemetría térmica continua en sensor calibrado a <code>3.8°C</code>, escáner CameraX en ráfaga y protocolo de cuarentena física y lógica.
        </p>
      </div>
    </div>

    <!-- Quick Meta Chips -->
    <div class="heading-meta-chips">
      <span class="cuadro-tag primary"><i class="pi pi-box" aria-hidden="true"></i> Orden DSP-204 · La Cava Fría</span>
      <span class="cuadro-tag"><i class="pi pi-map" aria-hidden="true"></i> Pasillo B · Rack 04 · N2 · P12</span>
      <span class="cuadro-tag primary"><i class="pi pi-clock" aria-hidden="true"></i> Lote FEFO L-20260914-A (19d vcto.)</span>
      <span class="cuadro-tag success"><i class="pi pi-sun" aria-hidden="true"></i> Sensor Calibrado 3.8°C</span>
    </div>
  </header>

  <!-- Master Documentation Cuadros Container -->
  <div class="cuadro-container">

    <!-- ====================================================================
         CUADRO 1: DOMAIN ENTITY & ARCHITECTURAL CONTRACTS
         ==================================================================== -->
    <section class="cuadro-card">
      <header class="cuadro-header">
        <div class="cuadro-header-left">
          <span class="cuadro-num-badge">C1</span>
          <div>
            <p class="cuadro-kicker">CONTRATOS DE DOMINIO & REGLAS FEFO</p>
            <h3 class="cuadro-title">Entidades de Picking, Esquema Room DB y Máquina de Estados de Preparación</h3>
            <p class="cuadro-subtitle">
              Estructura relacional de almacén que asegura rotación de inventario perecedero y bloqueo de lotes no válidos.
            </p>
          </div>
        </div>
        <div class="cuadro-tags">
          <span class="cuadro-tag primary"><i class="pi pi-database"></i> Room 2.6.1</span>
          <span class="cuadro-tag success"><i class="pi pi-shield"></i> Regla FEFO Estricta</span>
          <span class="cuadro-tag kotlin"><i class="pi pi-code"></i> SQLite Indexing</span>
        </div>
      </header>

      <!-- Table: Domain Properties & Schema -->
      <div class="contract-table-wrapper">
        <table class="contract-table">
          <thead>
            <tr>
              <th>Campo Dominio</th>
              <th>Tipo Kotlin</th>
              <th>Columna SQLite / Room</th>
              <th>Reglas de Validación & Restricciones</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>pickingTaskId</strong></td>
              <td><span class="mono-type">UUID</span></td>
              <td><span class="mono-chip">task_id TEXT PRIMARY KEY</span></td>
              <td><span class="rule-chip">Identificador único de la tarea de preparación en frío</span></td>
            </tr>
            <tr>
              <td><strong>dispatchId</strong></td>
              <td><span class="mono-type">String</span></td>
              <td><span class="mono-chip">dispatch_id TEXT NOT NULL</span></td>
              <td><span class="rule-chip">Referencia de despacho DSP-204 (La Cava Fría)</span></td>
            </tr>
            <tr>
              <td><strong>skuCode</strong></td>
              <td><span class="mono-type">String</span></td>
              <td><span class="mono-chip">sku_code TEXT NOT NULL</span></td>
              <td><span class="rule-chip">Código de producto canónico (ej: <code>ALM-LMO-982</code>)</span></td>
            </tr>
            <tr>
              <td><strong>locationCode</strong></td>
              <td><span class="mono-type">WarehouseLocation</span></td>
              <td><span class="mono-chip">location_str TEXT NOT NULL</span></td>
              <td><span class="rule-chip">Patrón <code>^[A-Z]-[0-9]&#123;2&#125;-[A-Z][0-9]-[A-Z][0-9]&#123;2&#125;$</code> (B-04-N2-P12)</span></td>
            </tr>
            <tr>
              <td><strong>allocatedLotNumber</strong></td>
              <td><span class="mono-type">String</span></td>
              <td><span class="mono-chip">lot_number TEXT NOT NULL</span></td>
              <td><span class="rule-chip">Lote asignado por algoritmo FEFO (L-20260914-A)</span></td>
            </tr>
            <tr>
              <td><strong>expirationDate</strong></td>
              <td><span class="mono-type">LocalDate</span></td>
              <td><span class="mono-chip">exp_date TEXT NOT NULL</span></td>
              <td><span class="rule-chip">Validación estricta: debe coincidir con el lote con menor fecha en estantería</span></td>
            </tr>
            <tr>
              <td><strong>targetQuantity</strong></td>
              <td><span class="mono-type">Int</span></td>
              <td><span class="mono-chip">target_qty INTEGER NOT NULL</span></td>
              <td><span class="rule-chip">Cantidad demandada por el despacho (ej: 24 cajas master)</span></td>
            </tr>
            <tr>
              <td><strong>pickedQuantity</strong></td>
              <td><span class="mono-type">Int</span></td>
              <td><span class="mono-chip">picked_qty INTEGER DEFAULT 0</span></td>
              <td><span class="rule-chip">Cantidad confirmada mediante escaneo óptico</span></td>
            </tr>
            <tr>
              <td><strong>quarantineState</strong></td>
              <td><span class="mono-type">QuarantineStatus</span></td>
              <td><span class="mono-chip">quarantine_state TEXT DEFAULT 'NONE'</span></td>
              <td><span class="rule-chip"><code>NONE</code> | <code>DAMAGE_FLAGGED</code> | <code>LOT_MISMATCH_QUARANTINE</code></span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- State Machine Flow -->
      <div>
        <p class="cuadro-kicker">MÁQUINA DE ESTADOS FORMAL (PICKING & CUARENTENA)</p>
        <div class="state-machine-container">
          <div class="state-step-node">
            <strong>TASK_ALLOCATED</strong>
            <small>DSP-204 asignado</small>
          </div>
          <i class="pi pi-arrow-right state-arrow"></i>
          <div class="state-step-node active">
            <strong>ROUTED_TO_RACK</strong>
            <small>Ubicación B-04-N2-P12</small>
          </div>
          <i class="pi pi-arrow-right state-arrow"></i>
          <div class="state-step-node">
            <strong>BARCODE_SCANNED</strong>
            <small>Lote L-20260914-A</small>
          </div>
          <i class="pi pi-arrow-right state-arrow"></i>
          <div class="state-step-node">
            <strong>FEFO_VERIFIED</strong>
            <small>Vencimiento validado</small>
          </div>
          <i class="pi pi-arrow-right state-arrow"></i>
          <div class="state-step-node">
            <strong>QTY_CONFIRMED</strong>
            <small>24/24 unidades</small>
          </div>
          <i class="pi pi-arrow-right state-arrow"></i>
          <div class="state-step-node">
            <strong>STAGED_DOCK_3</strong>
            <small>Entregado a muelle</small>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         CUADRO 2: COMPOSE UI COMPONENT & ERGONOMICS SPECIFICATION
         ==================================================================== -->
    <section class="cuadro-card">
      <header class="cuadro-header">
        <div class="cuadro-header-left">
          <span class="cuadro-num-badge">C2</span>
          <div>
            <p class="cuadro-kicker">ESPECIFICACIÓN DE COMPONENTES COMPOSE & ERGONOMÍA SUB-ZERO</p>
            <h3 class="cuadro-title">Jerarquía de Composables, Stepper Industrial 56dp y Contraste Térmico</h3>
            <p class="cuadro-subtitle">
              Componentes dimensionados para operar a -20°C con guantes criogénicos y lectura clara a distancia en transpaleta.
            </p>
          </div>
        </div>
        <div class="cuadro-tags">
          <span class="cuadro-tag primary"><i class="pi pi-sliders-h"></i> 56dp Industrial Stepper</span>
          <span class="cuadro-tag success"><i class="pi pi-eye"></i> High-Contrast Racks</span>
          <span class="cuadro-tag"><i class="pi pi-mobile"></i> Zebra TC58 Physical Scan</span>
        </div>
      </header>

      <div class="spec-grid-2">
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-map-marker"></i> Banner de Estantería de Alta Visibilidad</div>
          <p class="spec-kv-body">
            <code>RackLocationBanner()</code> renderiza la ubicación <code>B-04-N2-P12</code> en tipografía monoespaciada de <strong>24sp bold</strong> sobre fondo oscuro de contraste ultra-alto, visible a más de 2 metros desde el montacargas.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-plus-circle"></i> Stepper Numérico Industrial 56dp</div>
          <p class="spec-kv-body">
            <code>IndustrialStepper56dp()</code> con botones dedicados de incremento (<code>+</code>) y decremento (<code>-</code>) de exactamente <strong>56dp &times; 56dp</strong> con separación de 12dp para evitar toques accidentales con manoplas térmicas.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-clock"></i> Badge de Validación FEFO Obligatoria</div>
          <p class="spec-kv-body">
            Contenedor semántico verde esmeralda que destaca los días restantes de vida útil (<code>19 días</code>) y exige escaneo de código GS1-128 del lote antes de habilitar el botón de confirmación.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-exclamation-triangle"></i> Modal de Discrepancia & Cuarentena</div>
          <p class="spec-kv-body">
            Flujo de excepción accesible mediante botón secundario que permite registrar daño en empaque o vencimiento menor, bloqueando el palet en Room DB y notificando al supervisor de patio.
          </p>
        </div>
      </div>

      <!-- Mapping Table of Material 3 Tokens -->
      <div class="contract-table-wrapper">
        <table class="contract-table">
          <thead>
            <tr>
              <th>Rol Semántico M3</th>
              <th>Token Nexa Design Lab</th>
              <th>Valor Hex</th>
              <th>Aplicación en Picking Almacén</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>primary</code></td>
              <td><code>--nexa-color-primary-600</code></td>
              <td><span class="mono-chip">#2a67d9</span></td>
              <td>Botón "Completar Picking y Enviar a Staging" (56dp)</td>
            </tr>
            <tr>
              <td><code>surfaceVariant</code></td>
              <td><code>--nexa-surface-tint</code></td>
              <td><span class="mono-chip">#f1f5f9</span></td>
              <td>Fondo de tarjetas de producto y contenedor de telemetría de sensor</td>
            </tr>
            <tr>
              <td><code>errorContainer</code></td>
              <td><code>--nexa-surface-danger</code></td>
              <td><span class="mono-chip">#fef2f2</span></td>
              <td>Fondo de advertencia para discrepancia de lote o bloqueo en cuarentena</td>
            </tr>
            <tr>
              <td><code>onErrorContainer</code></td>
              <td><code>--nexa-color-danger-text</code></td>
              <td><span class="mono-chip">#991b1b</span></td>
              <td>Texto de alerta para vencimiento FEFO expirado o producto dañado</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ====================================================================
         CUADRO 3: HARDWARE & OFFLINE RESILIENCE CONTRACT
         ==================================================================== -->
    <section class="cuadro-card">
      <header class="cuadro-header">
        <div class="cuadro-header-left">
          <span class="cuadro-num-badge">C3</span>
          <div>
            <p class="cuadro-kicker">CONTRATO DE HARDWARE INDUSTRIAL & TELEMETRÍA IOT</p>
            <h3 class="cuadro-title">Escaneo en Ráfaga CameraX, Sensor BLE 3.8°C y Segregación de Cuarentena</h3>
            <p class="cuadro-subtitle">
              Integración nativa con lectores láser Zebra y sensores Bluetooth Low Energy para trazabilidad térmica ininterrumpida.
            </p>
          </div>
        </div>
        <div class="cuadro-tags">
          <span class="cuadro-tag primary"><i class="pi pi-qrcode"></i> CameraX + Zebra DW</span>
          <span class="cuadro-tag success"><i class="pi pi-sun"></i> BLE Sensor 3.8°C</span>
          <span class="cuadro-tag warning"><i class="pi pi-lock"></i> Cuarentena Lógica</span>
        </div>
      </header>

      <div class="spec-grid-3">
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-barcode"></i> CameraX Burst + Zebra Broadcast</div>
          <p class="spec-kv-body">
            Doble canal de escaneo: integración con hardware OEM mediante <code>BroadcastReceiver</code> para <code>com.symbol.datawedge.api.ACTION</code> y visor CameraX óptico como fallback continuo con tasa de análisis a 30 FPS.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-sun"></i> Telemetría BLE en Cámara Fría</div>
          <p class="spec-kv-body">
            Conexión en segundo plano con sonda térmica BLE calibrada a <code>3.8°C</code>. Si la lectura excede los rangos permitidos (2°C – 6°C), el sistema emite alerta háptica y restringe la confirmación de picking.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-shield"></i> Protocolo de Cuarentena Local</div>
          <p class="spec-kv-body">
            En caso de lote con fecha anterior a la mínima permitida, la app marca el registro en SQLite con <code>quarantine_state = 'LOCKED'</code> e imprime de inmediato la etiqueta física de cuarentena vía Bluetooth ESC/POS.
          </p>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         CUADRO 4: FULL PRODUCTION KOTLIN & JETPACK COMPOSE CODE
         ==================================================================== -->
    <section class="cuadro-card">
      <header class="cuadro-header">
        <div class="cuadro-header-left">
          <span class="cuadro-num-badge">C4</span>
          <div>
            <p class="cuadro-kicker">CÓDIGO DE PRODUCCIÓN KOTLIN 2.4 · JETPACK COMPOSE</p>
            <h3 class="cuadro-title">Implementación Completa: ViewModel, Stepper 56dp, Scanner y Screen</h3>
            <p class="cuadro-subtitle">
              Código fuente completo listo para producción en el módulo <code>:feature:warehouse</code> de Nexa Android.
            </p>
          </div>
        </div>
        <div class="cuadro-tags">
          <span class="cuadro-tag kotlin"><i class="pi pi-code"></i> Production Ready</span>
          <span class="cuadro-tag primary"><i class="pi pi-check"></i> UDF Pattern</span>
        </div>
      </header>

      <div class="code-container-block">
        <div class="code-header-bar">
          <div class="code-header-title">
            <i class="pi pi-file" aria-hidden="true"></i>
            <span>WarehousePickingScreen.kt — Nexa Operations Android</span>
          </div>
          <span class="code-lang-pill">Kotlin 2.4 / Compose M3</span>
        </div>
        <pre class="code-pre-box"><code><span class="kw">package</span> com.nexa.operations.warehouse.presentation

<span class="kw">import</span> androidx.compose.animation.*
<span class="kw">import</span> androidx.compose.foundation.background
<span class="kw">import</span> androidx.compose.foundation.layout.*
<span class="kw">import</span> androidx.compose.foundation.lazy.LazyColumn
<span class="kw">import</span> androidx.compose.foundation.shape.CircleShape
<span class="kw">import</span> androidx.compose.foundation.shape.RoundedCornerShape
<span class="kw">import</span> androidx.compose.material.icons.Icons
<span class="kw">import</span> androidx.compose.material.icons.filled.Add
<span class="kw">import</span> androidx.compose.material.icons.filled.ArrowBack
<span class="kw">import</span> androidx.compose.material.icons.filled.Remove
<span class="kw">import</span> androidx.compose.material3.*
<span class="kw">import</span> androidx.compose.runtime.*
<span class="kw">import</span> androidx.compose.ui.Alignment
<span class="kw">import</span> androidx.compose.ui.Modifier
<span class="kw">import</span> androidx.compose.ui.graphics.Color
<span class="kw">import</span> androidx.compose.ui.text.font.FontFamily
<span class="kw">import</span> androidx.compose.ui.text.font.FontWeight
<span class="kw">import</span> androidx.compose.ui.unit.dp
<span class="kw">import</span> androidx.compose.ui.unit.sp
<span class="kw">import</span> androidx.lifecycle.ViewModel
<span class="kw">import</span> androidx.lifecycle.viewModelScope
<span class="kw">import</span> kotlinx.coroutines.flow.MutableStateFlow
<span class="kw">import</span> kotlinx.coroutines.flow.StateFlow
<span class="kw">import</span> kotlinx.coroutines.flow.asStateFlow
<span class="kw">import</span> kotlinx.coroutines.launch

<span class="comm">// 1. Sealed State for Warehouse Picking UDF</span>
<span class="kw">sealed interface</span> <span class="type">WarehousePickingUiState</span> &#123;
    <span class="kw">data object</span> <span class="type">Loading</span> : <span class="type">WarehousePickingUiState</span>
    <span class="kw">data class</span> <span class="type">PickingActive</span>(
        <span class="kw">val</span> dispatchId: <span class="type">String</span> = <span class="str">"DSP-204"</span>,
        <span class="kw">val</span> clientName: <span class="type">String</span> = <span class="str">"La Cava Fría"</span>,
        <span class="kw">val</span> rackLocation: <span class="type">String</span> = <span class="str">"B-04-N2-P12"</span>,
        <span class="kw">val</span> skuName: <span class="type">String</span> = <span class="str">"Salmón Salar Congelado 4-5kg"</span>,
        <span class="kw">val</span> skuCode: <span class="type">String</span> = <span class="str">"ALM-LMO-982"</span>,
        <span class="kw">val</span> fefoLotNumber: <span class="type">String</span> = <span class="str">"L-20260914-A"</span>,
        <span class="kw">val</span> expirationDaysLeft: <span class="type">Int</span> = <span class="num">19</span>,
        <span class="kw">val</span> currentTemperature: <span class="type">Float</span> = <span class="num">3.8f</span>,
        <span class="kw">val</span> targetQuantity: <span class="type">Int</span> = <span class="num">24</span>,
        <span class="kw">val</span> pickedQuantity: <span class="type">Int</span> = <span class="num">24</span>,
        <span class="kw">val</span> isDiscrepancyModalVisible: <span class="type">Boolean</span> = <span class="kw">false</span>,
        <span class="kw">val</span> isCompleted: <span class="type">Boolean</span> = <span class="kw">false</span>
    ) : <span class="type">WarehousePickingUiState</span>
&#125;

<span class="comm">// 2. Production ViewModel</span>
<span class="kw">class</span> <span class="type">WarehousePickingViewModel</span> : <span class="type">ViewModel</span>() &#123;
    <span class="kw">private val</span> _uiState = <span class="type">MutableStateFlow</span>&lt;<span class="type">WarehousePickingUiState</span>&gt;(<span class="type">WarehousePickingUiState</span>.<span class="type">PickingActive</span>())
    <span class="kw">val</span> uiState: <span class="type">StateFlow</span>&lt;<span class="type">WarehousePickingUiState</span>&gt; = _uiState.asStateFlow()

    <span class="kw">fun</span> <span class="fn">adjustQuantity</span>(delta: <span class="type">Int</span>) &#123;
        <span class="kw">val</span> current = _uiState.value <span class="kw">as?</span> <span class="type">WarehousePickingUiState</span>.<span class="type">PickingActive</span> ?: <span class="kw">return</span>
        <span class="kw">val</span> updated = (current.pickedQuantity + delta).coerceIn(<span class="num">0</span>, current.targetQuantity)
        _uiState.value = current.copy(pickedQuantity = updated)
    &#125;

    <span class="kw">fun</span> <span class="fn">openDiscrepancy</span>() &#123;
        <span class="kw">val</span> current = _uiState.value <span class="kw">as?</span> <span class="type">WarehousePickingUiState</span>.<span class="type">PickingActive</span> ?: <span class="kw">return</span>
        _uiState.value = current.copy(isDiscrepancyModalVisible = <span class="kw">true</span>)
    &#125;

    <span class="kw">fun</span> <span class="fn">closeDiscrepancy</span>() &#123;
        <span class="kw">val</span> current = _uiState.value <span class="kw">as?</span> <span class="type">WarehousePickingUiState</span>.<span class="type">PickingActive</span> ?: <span class="kw">return</span>
        _uiState.value = current.copy(isDiscrepancyModalVisible = <span class="kw">false</span>)
    &#125;

    <span class="kw">fun</span> <span class="fn">confirmAndStage</span>() &#123;
        viewModelScope.launch &#123;
            <span class="kw">val</span> current = _uiState.value <span class="kw">as?</span> <span class="type">WarehousePickingUiState</span>.<span class="type">PickingActive</span> ?: <span class="kw">return@launch</span>
            _uiState.value = current.copy(isCompleted = <span class="kw">true</span>)
        &#125;
    &#125;
&#125;

<span class="comm">// 3. Master Screen Composable</span>
<span class="ann">@OptIn</span>(<span class="type">ExperimentalMaterial3Api</span>::<span class="kw">class</span>)
<span class="ann">@Composable</span>
<span class="kw">fun</span> <span class="fn">WarehousePickingScreen</span>(
    viewModel: <span class="type">WarehousePickingViewModel</span> = androidx.lifecycle.viewmodel.compose.viewModel(),
    modifier: <span class="type">Modifier</span> = <span class="type">Modifier</span>
) &#123;
    <span class="kw">val</span> state <span class="kw">by</span> viewModel.uiState.collectAsState()

    <span class="kw">when</span> (<span class="kw">val</span> s = state) &#123;
        <span class="kw">is</span> <span class="type">WarehousePickingUiState</span>.<span class="type">Loading</span> -&gt; &#123;
            <span class="type">Box</span>(modifier.fillMaxSize(), contentAlignment = <span class="type">Alignment</span>.Center) &#123;
                <span class="type">CircularProgressIndicator</span>()
            &#125;
        &#125;
        <span class="kw">is</span> <span class="type">WarehousePickingUiState</span>.<span class="type">PickingActive</span> -&gt; &#123;
            <span class="type">Scaffold</span>(
                topBar = &#123;
