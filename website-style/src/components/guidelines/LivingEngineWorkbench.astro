---
/**
 * LIVING ENGINE WORKBENCH & INTERACTIVE MODULAR GRAPHICS ENGINE
 * Authority: Nexafy living geometry system, pure solid colorimetry, closed vascular conduit pipelines,
 * and authentic Nexa cold-chain dispatch and wholesale data.
 * 
 * Rules:
 *  - 100% Nexa Colorimetry: Nexa Dark Blue (#082846) sculpted plate, Nexa Celeste (#38c8ff) accents,
 *    26px thick closed vascular conduits in Celeste Pastel (#bae6fd), pure white (#ffffff) frame.
 *  - NO loose ends or disconnected conduits: Every single conduit begins at a valid node and terminates at a valid hub.
 *  - NO geometric spike artifacts: Corner notches are transparent so the continuous SVG silhouette defines the boundary.
 *  - Title padding and canopy clearance match Hero.astro sandbox perfectly (clamp font-size, padding-top: 0.65rem).
 *  - Pure Autolayout Station Cards: Zero overlap, authentic Nexa cold-chain telemetry and escrow data.
 */
import { generateContainerCommands, commandsToSvgPath } from '../../lib/nexafy/geometry';
import { NEXAFY_PRESETS } from '../../lib/nexafy/presets';

const workbenchChannelsPath = commandsToSvgPath(generateContainerCommands(NEXAFY_PRESETS.CHANNELS));
---

<div class="workbench-master-container" id="workbench-master">
  <!-- 1. Interactive Master Engine Toolbar -->
  <header class="workbench-toolbar-bar" aria-label="Living Engine Master Controls">
    <div class="toolbar-left-group">
      <div class="toolbar-title-wrap">
        <span class="toolbar-live-badge"><i class="live-dot"></i> EN VIVO</span>
        <strong class="toolbar-main-title">Motor Gráfico Nexafy</strong>
      </div>

      <!-- Action Button: Construir Motor (Build Animation) -->
      <button type="button" class="btn-engine-build" id="btn-build-engine" title="Construir y ensamblar el motor gráfico paso a paso con acople elástico">
        <i class="pi pi-sparkles"></i>
        <span>✦ Construir Motor (Build)</span>
      </button>

      <!-- Views & Presets Group -->
      <div class="preset-pill-group" role="group" aria-label="Vistas operativas y segmentos">
        <button type="button" class="preset-btn active" data-view="channels" title="Canales y estaciones vasculares en vivo (Arrastrar bloques)">
          <span>✦ Canales & Bloques</span>
        </button>
        <button type="button" class="preset-btn" data-view="dock" title="Muelle & Recepción (Rol Almacén / Bahía)">
          <i class="pi pi-box"></i>
          <span>Muelle & Bahía</span>
        </button>
        <button type="button" class="preset-btn" data-view="telemetry" title="Telemetría IoT & Cadena de Frío (Rol Conductor)">
          <i class="pi pi-compass"></i>
          <span>Telemetría Frío</span>
        </button>
        <button type="button" class="preset-btn" data-view="escrow" title="Custodia & Liquidación Escrow (Rol Comprador)">
          <i class="pi pi-lock"></i>
          <span>Custodia Escrow</span>
        </button>
        <button type="button" class="preset-btn reset-btn" data-preset="reset" title="Restablecer posiciones canónicas">
          <span>↺ Reset</span>
        </button>
      </div>
    </div>

    <div class="toolbar-center-group">
      <!-- Human Ergonomic Tones Switcher -->
      <div class="human-tones-toggle" role="group" aria-label="Tono del Canvas">
        <span class="tones-label">Tono:</span>
        <button 
          type="button" 
          class="tone-pill active" 
          data-tone="nexa" 
          data-plate="#082846" 
          data-accent="#38c8ff" 
          data-conduit="#bae6fd" 
          title="Nexa Dark Blue (#082846 & #38c8ff)"
        >
          <span class="color-swatch" style="background: #082846; border: 1.5px solid #38c8ff;"></span>
          <span>Nexa Blue</span>
        </button>
        <button 
          type="button" 
          class="tone-pill" 
          data-tone="ceramic" 
          data-plate="#1d3d63" 
          data-accent="#38bdf8" 
          data-conduit="#a5f3fc" 
          title="Ceramic Azure (#1d3d63 & #38bdf8)"
        >
          <span class="color-swatch" style="background: #1d3d63; border: 1.5px solid #38bdf8;"></span>
          <span>Ceramic Azure</span>
        </button>
        <button 
          type="button" 
          class="tone-pill" 
          data-tone="cashmere" 
          data-plate="#283a48" 
          data-accent="#7dd3fc" 
          data-conduit="#bae6fd" 
          title="Cashmere Arctic Mist (#283a48 & #7dd3fc)"
        >
          <span class="color-swatch" style="background: #283a48; border: 1.5px solid #7dd3fc;"></span>
          <span>Cashmere Mist</span>
        </button>
        <button 
          type="button" 
          class="tone-pill" 
          data-tone="oceanic" 
          data-plate="#0c2038" 
          data-accent="#38bdf8" 
          data-conduit="#93c5fd" 
          title="Deep Cold Chain (#0c2038 & #38bdf8)"
        >
          <span class="color-swatch" style="background: #0c2038; border: 1.5px solid #38bdf8;"></span>
          <span>Deep Navy</span>
        </button>
      </div>

      <!-- Conduit Pastel Tone Selector -->
      <div class="conduit-palette-toggle" role="group" aria-label="Conductos 26px">
        <span class="conduit-toggle-label">Conductos 26px:</span>
        <button type="button" class="conduit-pill active" data-pastel="#bae6fd" title="Celeste Pastel (#bae6fd)">
          <span class="color-swatch" style="background: #bae6fd;"></span> Celeste
        </button>
        <button type="button" class="conduit-pill" data-pastel="#a5f3fc" title="Soft Cyan (#a5f3fc)">
          <span class="color-swatch" style="background: #a5f3fc;"></span> Cyan
        </button>
        <button type="button" class="conduit-pill" data-pastel="#93c5fd" title="Ice Blue (#93c5fd)">
          <span class="color-swatch" style="background: #93c5fd;"></span> Ice Blue
        </button>
      </div>
    </div>

    <div class="toolbar-right-group">
      <!-- Collision Status Badge -->
      <div class="collision-pill" id="workbench-collision-badge" title="Validación topológica sin solapamientos">
        <i class="pi pi-check-circle"></i>
        <span id="collision-text">0 Colisiones</span>
      </div>

      <!-- Toggle Developer Inspector -->
      <button type="button" class="workbench-action-btn secondary" id="btn-toggle-inspector" title="Abrir Inspector de Coordenadas y Topología">
        <i class="pi pi-code"></i>
        <span>📐 Inspector</span>
      </button>
    </div>
  </header>

  <!-- 2. Sculpted Bürocratik Canvas Stage Frame -->
  <section class="workbench-hero-stage" id="workbench-hero-stage" aria-label="Escenario Motor Gráfico Nexafy">
    <div class="hero-sculpted-canvas" id="workbench-sculpted-canvas">

      <!-- 2.1 Unified Architectural SVG Silhouette Background -->
      <svg 
        class="hero-silhouette-svg" 
        viewBox="0 0 1440 820" 
        preserveAspectRatio="none" 
        aria-hidden="true"
      >
        <defs>
          <radialGradient id="workbench-radial-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#0e3d6b" stop-opacity="0.6" />
            <stop offset="100%" stop-color="#082846" stop-opacity="0" />
          </radialGradient>
          <pattern id="workbench-blueprint-grid" width="36" height="36" patternUnits="userSpaceOnUse">
            <path d="M 36 0 L 0 0 0 36" fill="none" stroke="rgba(56, 189, 248, 0.22)" stroke-width="1" />
            <circle cx="0" cy="0" r="1.5" fill="rgba(56, 189, 248, 0.35)" />
            <circle cx="36" cy="36" r="1.5" fill="rgba(56, 189, 248, 0.35)" />
          </pattern>
          <clipPath id="workbench-silhouette-clip">
            <path d={workbenchChannelsPath} />
          </clipPath>
        </defs>
        <!-- The continuous sculpted contour path matching Bürocratik SOTD geometry -->
        <path 
          class="hero-silhouette-path" 
          d={workbenchChannelsPath}
          fill="#082846"
        />
        <!-- Ambient Radial Backlight Glow within the frame -->
        <rect x="0" y="0" width="1440" height="820" fill="url(#workbench-radial-glow)" clip-path="url(#workbench-silhouette-clip)" />
        <!-- Architectural Blueprint Grid Pattern ("fondo con cuadraditos") -->
        <rect x="0" y="0" width="1440" height="820" fill="url(#workbench-blueprint-grid)" clip-path="url(#workbench-silhouette-clip)" opacity="0.65" />
      </svg>

      <!-- 2.2 TOP LAYER (Notches & Monumental Headline Canopy with Generous Padding) -->
      <header class="hero-top-layer">
        <!-- Top-Left White Notch: Home Return + Nexa Brand & Primary Links -->
        <div class="hero-top-left">
          <a href="/" class="hero-home-btn" title="Volver al Inicio" aria-label="Inicio">
            <i class="pi pi-home" aria-hidden="true"></i>
          </a>
          <a href="/" class="nexa-brand" id="hero-nexa-brand" aria-label="Nexa Platform" title="Nexa Platform (Haz clic para alternar color)">
            <img src="/assets/logo-nexa-blue.svg" alt="Nexa Platform" height="28" class="nexa-brand-logo-img" id="hero-nexa-logo" />
          </a>

          <nav class="hero-nav-links" aria-label="Primary navigation">
            <a href="/about" class="hero-nav-link">About</a>
            <a href="/nexafy" class="hero-nav-link active">Nexafy</a>
            <a href="/interactive-suite" class="hero-nav-link">Canales</a>
            <a href="/artifacts" class="hero-nav-link">Custodia</a>
          </nav>
        </div>

        <!-- Top-Center Crown: Monumental Editorial Headline (Spacious & Clean) -->
        <div class="hero-top-center">
          <div class="hero-crown-content">
            <h1 id="hero-heading" class="hero-main-title">
              Unlock your B2B<br />
              supply network
            </h1>
            <p class="hero-main-sub">
              The easiest way to access wholesale cold-chain and direct deliveries
            </p>
          </div>
        </div>

        <!-- Top-Right White Notch: CTA & Login (0 Language Dropdown) -->
        <div class="hero-top-right">
          <a href="#book-demo" class="hero-book-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Book a Demo</span>
          </a>

          <a href="#login" class="hero-login-btn" id="btn-open-landing-login">
            <span>Login</span>
          </a>
        </div>
      </header>

      <!-- 2.3 CENTER STAGE (Multiple Operational Views & Rich Micro-Components) -->
      <div class="hero-center-stage" id="circuit-stage">
        
        <!-- Live Dragging HUD / Coordinates Tooltip -->
        <div class="drag-coords-hud" id="workbench-drag-hud" style="display: none;">
          <span class="hud-pill-tag">MOTOR VIVO</span>
          <span class="hud-coords-text" id="hud-coords-text">X: 0px · Y: 0px</span>
        </div>

        <!-- ===================================================================
             VIEW 1 (DEFAULT): CANALES & ESTACIONES (Draggable 60fps Pipeline)
             =================================================================== -->
        <div class="workbench-stage-view active" id="view-channels-stage">
          <!-- 1. The Origin Node: TERMINAL PESQUERO CALLAO (High-tech Terminal Card, 0 Circles) -->
          <div class="circuit-hub origin-hub" id="circuit-hub" role="region" aria-label="Terminal Pesquero Callao">
            <div class="hub-terminal-header">
              <span class="terminal-status-dot active"></span>
              <span class="terminal-kicker">ORIGEN B2B</span>
              <span class="drag-handle-grip hub-grip" title="Arrastrar origen">⋮⋮</span>
            </div>
            <div class="hub-label">
              <strong class="hub-title">Terminal Pesquero</strong>
              <span class="hub-location">Callao · Muelle Bahía 02</span>
              <div class="hub-port-badge">
                <i class="pi pi-box"></i>
                <span>Lotes SANIPES OK</span>
              </div>
            </div>
          </div>

          <!-- 2. Continuous Vascular Conduit Circuit (Organically Bending Closed Pipeline) -->
          <svg 
            class="circuit-svg" 
            id="workbench-circuit-svg"
            viewBox="0 0 1140 480" 
            fill="none" 
            xmlns="http://www.w3.org/2000/svg" 
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <!-- Main Trunk: Origin Node -> Nexa Core Bus -->
            <path 
              class="circuit-pipe-line line-trunk" 
              id="pipe-trunk"
              d="" 
              stroke="#bae6fd" 
              stroke-width="26" 
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- Branch 1 (Top Conduit to Station 01: Despacho en Bahía) -->
            <path 
              class="circuit-pipe-line line-branch-top" 
              id="pipe-branch-top"
              d="" 
              stroke="#bae6fd" 
              stroke-width="24" 
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- Branch 2 (Center Conduit to Station 02: Telemetría Sensirion IoT) -->
            <path 
              class="circuit-pipe-line line-branch-mid" 
              id="pipe-branch-mid"
              d="" 
              stroke="#bae6fd" 
              stroke-width="24" 
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- Branch 3 (Bottom Conduit to Station 03: Custodia Escrow 100%) -->
            <path 
              class="circuit-pipe-line line-branch-bot" 
              id="pipe-branch-bot"
              d="" 
              stroke="#bae6fd" 
              stroke-width="24" 
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- Exit Conduit from Station 01 merging to Destination Hub -->
            <path 
              class="circuit-pipe-line line-exit-top" 
              id="pipe-exit-top"
              d="" 
              stroke="#bae6fd" 
              stroke-width="24" 
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- Exit Conduit from Station 02 into Destination Hub -->
            <path 
              class="circuit-pipe-line line-exit-mid" 
              id="pipe-exit-mid"
              d="" 
              stroke="#bae6fd" 
              stroke-width="24" 
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- Exit Conduit from Station 03 merging to Destination Hub -->
            <path 
              class="circuit-pipe-line line-exit-bot" 
              id="pipe-exit-bot"
              d="" 
              stroke="#bae6fd" 
              stroke-width="24" 
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- Signal Pulse Particles Flowing through the Conduits -->
            <circle id="pulse-trunk" class="pulse-particle" r="6" fill="#38bdf8" stroke="#ffffff" stroke-width="2" cx="-50" cy="-50" />
            <circle id="pulse-branch-top" class="pulse-particle" r="5" fill="#38bdf8" stroke="#ffffff" stroke-width="1.5" cx="-50" cy="-50" />
            <circle id="pulse-branch-mid" class="pulse-particle" r="5" fill="#2563eb" stroke="#ffffff" stroke-width="1.5" cx="-50" cy="-50" />
            <circle id="pulse-branch-bot" class="pulse-particle" r="5" fill="#38bdf8" stroke="#ffffff" stroke-width="1.5" cx="-50" cy="-50" />
            <circle id="pulse-exit-top" class="pulse-particle" r="5" fill="#2563eb" stroke="#ffffff" stroke-width="1.5" cx="-50" cy="-50" />
            <circle id="pulse-exit-mid" class="pulse-particle" r="5" fill="#38bdf8" stroke="#ffffff" stroke-width="1.5" cx="-50" cy="-50" />
            <circle id="pulse-exit-bot" class="pulse-particle" r="5" fill="#2563eb" stroke="#ffffff" stroke-width="1.5" cx="-50" cy="-50" />
          </svg>

          <!-- 3. Central Router Node: NEXA CORE BUS -->
          <div class="circuit-center-hub" id="circuit-center-hub" aria-label="Nexa Core Bus">
            <div class="center-hub-content">
              <img src="/assets/logo-nexa-white.svg" alt="Nexa Hub" class="center-hub-logo" />
              <span class="center-hub-title">NEXA DISPATCH BUS</span>
              <span class="center-hub-sub">Ruteo Criptográfico & FEFO</span>
            </div>
            <span class="drag-handle-grip hub-grip" title="Arrastrar núcleo">⋮⋮</span>
          </div>

          <!-- 4. Three Symmetrically Aligned White Station Blocks (Draggable & Non-Overlapping) -->
          <!-- Station 01: Despacho en Bahía (DSP-204) -->
          <article class="station-card station-top workbench-card card-01-fefo" id="station-01-card" aria-label="Estación 01: Despacho en Bahía">
            <div class="station-header">
              <span class="station-icon-wrap blue">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              </span>
              <div class="station-titles">
                <span class="station-step-tag">01 · DESPACHO EN BAHÍA</span>
                <strong class="station-name">Muelle Callao · Rampa 04</strong>
              </div>
              <span class="station-pill-state">FEFO ACTIVO</span>
              <span class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</span>
            </div>
            <div class="station-body-items">
              <div class="station-micro-row">
                <span class="micro-badge"><i class="pi pi-box"></i> L-8841</span>
                <span class="micro-text">500 kg Salmón Coho Fresco</span>
                <span class="micro-status-tag">Báscula OK</span>
              </div>
              <div class="station-progress-wrap">
                <div class="station-progress-bar" style="width: 86%;"></div>
              </div>
            </div>
            <div class="station-footer">
              <span class="station-meta text-mono">SANIPES Cert. #4410 · Temp -18.4°C</span>
              <span class="station-status-dot active" title="Rampa conectada"></span>
            </div>
          </article>

          <!-- Station 02: Telemetría Sensirion IoT (Sensirion SHT40) -->
          <article class="station-card station-mid workbench-card card-02-iot" id="station-02-card" aria-label="Estación 02: Telemetría Sensirion IoT">
            <div class="station-header">
              <span class="station-icon-wrap cyan">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path>
                </svg>
              </span>
              <div class="station-titles">
                <span class="station-step-tag">02 · TELEMETRÍA IOT</span>
                <strong class="station-name">Sensirion SHT40 · -18.2°C</strong>
              </div>
              <span class="station-pill-state active">EN RUTA</span>
              <span class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</span>
            </div>
            <div class="station-body-items">
              <div class="station-micro-row">
                <span class="micro-badge cyan"><i class="pi pi-compass"></i> GPS</span>
                <span class="micro-text">Van B-402 · Av. Elmer Faucett km 4</span>
                <span class="micro-status-tag cyan">Estable</span>
              </div>
              <div class="station-sparkline-row">
                <svg class="mini-sparkline" viewBox="0 0 140 16" fill="none">
                  <path d="M 0,9 L 20,7 L 40,10 L 60,8 L 80,9 L 100,7 L 120,8 L 140,7" stroke="#0284c7" stroke-width="2" stroke-linecap="round" />
                </svg>
                <span class="sparkline-val text-mono">-18.2°C</span>
              </div>
            </div>
            <div class="station-footer">
              <span class="station-meta text-mono">Compresor Carrier 1450 RPM · Puerta Sellada</span>
              <span class="station-status-dot active" title="Transmisión continua"></span>
            </div>
          </article>

          <!-- Station 03: Custodia Escrow 100% ($3,450.00) -->
          <article class="station-card station-bot workbench-card card-03-escrow" id="station-03-card" aria-label="Estación 03: Custodia Escrow 100%">
            <div class="station-header">
              <span class="station-icon-wrap blue">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </span>
              <div class="station-titles">
                <span class="station-step-tag">03 · CUSTODIA ESCROW 100%</span>
                <strong class="station-name">Smart Contract B2B · $3,450.00</strong>
              </div>
              <span class="station-pill-state">PRE-AUTORIZADO</span>
              <span class="drag-handle-grip" title="Arrastrar bloque">⋮⋮</span>
            </div>
            <div class="station-body-items">
              <div class="station-micro-row">
                <span class="micro-badge"><i class="pi pi-lock"></i> VAULT</span>
                <span class="micro-text">Pre-bloqueo $3,450.00 USD</span>
                <span class="micro-status-tag">Multi-Sig</span>
              </div>
              <div class="station-trigger-row">
                <span class="trigger-label">Desbloqueo automático:</span>
                <span class="trigger-condition text-mono">POD + Geotag Verificado</span>
              </div>
            </div>
            <div class="station-footer">
              <span class="station-meta text-mono">Hash: 0x8f4c...3e1a · Liquidación instantánea</span>
              <span class="station-status-dot active" title="Garantía activa"></span>
            </div>
          </article>

          <!-- 5. Destination Hub: Red Mayorista B2B (High-tech Terminal Card, 0 Circles) -->
          <div class="circuit-hub destination-hub" id="circuit-dest-hub" role="region" aria-label="Red Mayorista B2B">
            <div class="hub-terminal-header">
              <span class="terminal-status-dot active"></span>
              <span class="terminal-kicker">DESTINO MAYORISTA</span>
              <span class="drag-handle-grip hub-grip" title="Arrastrar destino">⋮⋮</span>
            </div>
            <div class="hub-label">
              <strong class="hub-title">Red Mayorista</strong>
              <span class="hub-location">Lima Central · Santa Anita</span>
              <div class="hub-port-badge dest-badge">
                <i class="pi pi-check-circle"></i>
                <span>Escrow Liberado</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ===================================================================
             VIEW 2: SEGMENTO MUELLE & RECEPCIÓN (Rol Almacén / Bahía)
             =================================================================== -->
        <div class="workbench-stage-view" id="view-dock-stage" style="display: none;">
          <div class="segment-cards-trio">
            <!-- Dock Card 1: Industrial Weighing Scale -->
            <div class="segment-panel-card">
              <div class="segment-card-head">
                <div class="segment-head-icon blue"><i class="pi pi-inbox"></i></div>
                <div>
                  <span class="segment-kicker">MUELLE CALLAO · RAMPA 02</span>
                  <h4 class="segment-title">Báscula Toledo Digital</h4>
                </div>
                <span class="segment-chip active">EN LÍNEA</span>
              </div>
              <div class="segment-scale-display">
                <span class="scale-metric-label">PESO NETO CARGA</span>
                <strong class="scale-metric-value text-mono">500.00 <span class="unit">kg</span></strong>
                <div class="scale-sub-metrics">
                  <span>Bruto: 542.50 kg</span>
                  <span>Tara: 42.50 kg</span>
                  <span class="text-cyan">Sonda: -18.4°C</span>
                </div>
              </div>
              <div class="segment-card-foot">
                <button type="button" class="btn-panel-action" id="btn-tare-scale">
                  <i class="pi pi-refresh"></i> Tarar Báscula (0.00 kg)
                </button>
              </div>
            </div>

            <!-- Dock Card 2: SANIPES Sanitary Inspection -->
            <div class="segment-panel-card">
              <div class="segment-card-head">
