<script>
  // Interactive TopBar Search Toggle
  const btnSearch = document.getElementById('topbar-btn-search');
  const searchTray = document.getElementById('topbar-search-tray');
  const btnCloseTray = document.getElementById('btn-close-search-tray');
  const searchInput = document.getElementById('topbar-search-input') as HTMLInputElement | null;

  btnSearch?.addEventListener('click', () => {
    if (searchTray) {
      searchTray.style.display = 'flex';
      searchInput?.focus();
    }
  });

  btnCloseTray?.addEventListener('click', () => {
    if (searchTray) searchTray.style.display = 'none';
  });

  // Interactive BottomNav Tab Switching Demo
  const bottomTabs = document.querySelectorAll<HTMLElement>('.bottom-nav-tab');
  const readout = document.getElementById('nav-tab-status-readout');

  bottomTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      bottomTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const tabId = tab.getAttribute('data-tab-id')?.toUpperCase() || '';
      const label = tab.querySelector('.tab-label')?.textContent || '';
      if (readout) {
        readout.innerHTML = `<span>Pestaña Activa: <strong>${tabId} (${label}) · Navegación reactiva M3</strong></span>`;
      }
    });
  });
</script>

