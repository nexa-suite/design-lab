                <span class="maze-word">maze</span>
                <svg width="24" height="6" viewBox="0 0 24 6" fill="none" class="maze-wave">
                  <path d="M1 3 Q4 0.5 7 3 T13 3 T19 3 T23 3" stroke="#38bdf8" stroke-width="2.2" fill="none" stroke-linecap="round"/>
                </svg>
              </span>
            </div>
          </div>

          <!-- Social Icons Row (Deep Navy Circles with Cyan Hover) -->
          <div class="footer-socials-row" aria-label="Social media channels">
            <!-- LinkedIn -->
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="LinkedIn">
