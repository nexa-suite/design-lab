---
// AccessChannels: The Authentic Historical BEIGE Bento Section
// Evidence: Bürocratik Awwwards SOTD (Scene 7, t=40-45s & unsection-features.jpg 2880x3354 reference)
// Warm beige background #FDFAE7 with asymmetric multi-channel distribution bento grid
---

<section class="channels-section" id="channels" data-section="market" aria-labelledby="channels-heading">
  <!-- Anchor for Market links -->
  <span id="market" class="market-anchor" aria-hidden="true"></span>
  
  <div class="channels-container">
    
    <!-- Centered Header on Warm Beige Canvas -->
    <div class="channels-header">
      <div class="channels-pill-eyebrow">
        <span>Access Channels</span>
      </div>

      <h2 id="channels-heading" class="channels-title">
        Multiple channels to<br />
        <span class="title-light">multiply your online sales</span>
      </h2>
    </div>

    <!-- Authentic Asymmetric Bento Grid (4 Columns x 3 Rows) -->
    <div class="channels-bento-grid">
      
      <!-- ====================================================================
           ROW 1: TWO MONUMENTAL CARDS (FLECTO MARKET + ONLINE STORE)
           ==================================================================== -->

      <!-- 1. Top-Left: Large Mint Flecto Market Card (Col 1-2, Row 1) -->
      <article class="bento-tile tile-market-wide" aria-label="Flecto Market Channel">
        <div class="market-tile-header">
          <div class="market-brand-badge">
            <svg width="34" height="28" viewBox="0 0 52 42" fill="none" class="market-flecto-logo" aria-hidden="true">
              <rect x="0" y="0" width="22" height="12" rx="3" fill="#004737"/>
              <rect x="28" y="0" width="12" height="12" rx="3" fill="#004737"/>
              <rect x="0" y="18" width="12" height="12" rx="3" fill="#004737"/>
              <rect x="18" y="18" width="22" height="12" rx="3" fill="#004737"/>
            </svg>
            <span class="market-title-text">Flecto Market</span>
          </div>
          <p class="market-lead-desc">
            List all of your items in a single marketplace for a community of thousands.
          </p>
          <div class="market-cta-wrap">
            <a href="#book-demo" class="bento-pill-btn">Get Started</a>
          </div>
        </div>

        <!-- Authentic Flecto Market Catalog UI Preview -->
        <div class="market-ui-preview" aria-hidden="true">
          <!-- Browser Mockup Top Bar -->
          <div class="market-top-searchbar">
            <div class="market-browser-left">
              <span class="market-browser-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="20" height="20" rx="5" fill="#004737"/>
                  <circle cx="12" cy="12" r="3" fill="#45f396"/>
                </svg>
              </span>
              <div class="search-input-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2.5">
                  <circle cx="11" cy="11" r="8"/>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <span>nikon</span>
              </div>
            </div>
            
            <div class="market-browser-tags">
              <span class="browser-tag">Localização</span>
              <span class="browser-tag">Datas</span>
              <span class="browser-tag tag-muted">PARA PROFISSIONAIS</span>
              <span class="browser-tag tag-muted">SABER MAIS</span>
              <span class="browser-avatar-circle"></span>
            </div>
          </div>

          <!-- Split Catalog View: Items Grid (Left) + Europe Map (Right) -->
          <div class="market-catalog-split">
            <!-- Left: Catalog Items Grid (2 Columns x 4 Rows) -->
            <div class="catalog-items-subgrid">
              
              <div class="cat-item-card">
                <div class="cat-img-box">
                  <img src="/assets/synthetic/camera-vector.svg" alt="" width="32" height="26" />
                </div>
                <div class="cat-item-info">
                  <span class="cat-name">Nikon D7000 + 17-55</span>
                  <strong class="cat-price">€25,00<small>/dia</small></strong>
                  <span class="cat-loc">Rua 25 de Abril</span>
                </div>
              </div>

              <div class="cat-item-card">
                <div class="cat-img-box">
                  <img src="/assets/synthetic/camera-vector.svg" alt="" width="32" height="26" />
                </div>
                <div class="cat-item-info">
                  <span class="cat-name">Nikon D3100</span>
                  <strong class="cat-price">€10,00<small>/dia</small></strong>
                  <span class="cat-loc">Telheiras</span>
                </div>
              </div>

              <div class="cat-item-card">
                <div class="cat-img-box">
                  <img src="/assets/synthetic/camera-vector.svg" alt="" width="32" height="26" />
                </div>
                <div class="cat-item-info">
                  <span class="cat-name">Objetiva 70-200mm</span>
                  <strong class="cat-price">€100,00<small>/dia</small></strong>
                  <span class="cat-loc">Fradesso da Silveira</span>
                </div>
              </div>

              <div class="cat-item-card">
                <div class="cat-img-box">
                  <img src="/assets/synthetic/camera-vector.svg" alt="" width="32" height="26" />
                </div>
                <div class="cat-item-info">
                  <span class="cat-name">Nikon D3200 + Lente</span>
                  <strong class="cat-price">€8,00<small>/dia</small></strong>
                  <span class="cat-loc">Telheiras</span>
                </div>
              </div>

              <div class="cat-item-card">
                <div class="cat-img-box">
                  <img src="/assets/synthetic/camera-vector.svg" alt="" width="32" height="26" />
                </div>
                <div class="cat-item-info">
                  <span class="cat-name">NIKON D3500 24MP</span>
                  <strong class="cat-price">€40,00<small>/dia</small></strong>
                  <span class="cat-loc">London</span>
                </div>
              </div>

              <div class="cat-item-card">
                <div class="cat-img-box">
                  <img src="/assets/synthetic/camera-vector.svg" alt="" width="32" height="26" />
                </div>
                <div class="cat-item-info">
                  <span class="cat-name">Nikon D5000</span>
                  <strong class="cat-price">€15,00<small>/dia</small></strong>
                  <span class="cat-loc">Venda do Pinheiro</span>
                </div>
              </div>

              <div class="cat-item-card">
                <div class="cat-img-box">
                  <img src="/assets/synthetic/camera-vector.svg" alt="" width="32" height="26" />
                </div>
                <div class="cat-item-info">
                  <span class="cat-name">Nikon D7100</span>
                  <strong class="cat-price">€30,00<small>/dia</small></strong>
                  <span class="cat-loc">Quirino da Fonseca</span>
                </div>
              </div>

              <div class="cat-item-card">
                <div class="cat-img-box">
                  <img src="/assets/synthetic/camera-vector.svg" alt="" width="32" height="26" />
                </div>
                <div class="cat-item-info">
                  <span class="cat-name">Nikon D3200 AF-S</span>
                  <strong class="cat-price">€15,00<small>/dia</small></strong>
                  <span class="cat-loc">Coimbra</span>
                </div>
              </div>

            </div>

            <!-- Right: Stylized European Hub Map with Verified Price Pins -->
            <div class="catalog-map-panel">
              <svg viewBox="0 0 200 200" class="europe-map-svg">
                <!-- Europe landmass silhouette -->
                <path d="M 25 70 Q 40 45 60 50 T 95 35 T 135 45 T 160 80 T 135 145 T 85 170 T 45 135 Z" fill="#b9eed4" stroke="#87dbb2" stroke-width="1.5"/>
                
                <!-- Regional Labels -->
                <text x="35" y="150" font-size="9" font-family="sans-serif" fill="#004737" font-weight="700">Portugal</text>
                <text x="95" y="135" font-size="9" font-family="sans-serif" fill="#004737" font-weight="700">Espanha</text>
                <text x="105" y="75" font-size="9" font-family="sans-serif" fill="#004737" font-weight="700">França</text>
                
                <!-- Price Pins matching unsection-features.jpg -->
                <g class="map-pin" transform="translate(48, 125)">
                  <rect x="-16" y="-14" width="32" height="16" rx="8" fill="#004737"/>
                  <text x="0" y="-3" font-size="8" font-family="monospace" fill="#ffffff" font-weight="700" text-anchor="middle">€10.00</text>
                  <circle cx="0" cy="5" r="2.5" fill="#004737"/>
                </g>

                <g class="map-pin" transform="translate(68, 105)">
                  <rect x="-16" y="-14" width="32" height="16" rx="8" fill="#004737"/>
                  <text x="0" y="-3" font-size="8" font-family="monospace" fill="#ffffff" font-weight="700" text-anchor="middle">€75.00</text>
                  <circle cx="0" cy="5" r="2.5" fill="#004737"/>
                </g>

                <g class="map-pin" transform="translate(115, 60)">
                  <rect x="-16" y="-14" width="32" height="16" rx="8" fill="#004737"/>
                  <text x="0" y="-3" font-size="8" font-family="monospace" fill="#ffffff" font-weight="700" text-anchor="middle">€40.00</text>
                  <circle cx="0" cy="5" r="2.5" fill="#004737"/>
                </g>

                <g class="map-pin" transform="translate(80, 160)">
                  <rect x="-14" y="-14" width="28" height="16" rx="8" fill="#004737"/>
                  <text x="0" y="-3" font-size="8" font-family="monospace" fill="#ffffff" font-weight="700" text-anchor="middle">€4.00</text>
                  <circle cx="0" cy="5" r="2.5" fill="#004737"/>
                </g>
              </svg>
            </div>
          </div>
        </div>
      </article>

      <!-- 2. Top-Right: Online Store Card (Col 3-4, Row 1) -->
      <article class="bento-tile tile-online-store" aria-label="Dedicated Online Store">
        <!-- Floating Isometric Store Screens Mockup -->
        <div class="store-preview-visual" aria-hidden="true">
          <div class="store-screens-wrapper">
            <!-- Screen 1: Store Catalog View -->
            <div class="mock-screen screen-catalog">
              <div class="mock-screen-header">
                <span class="mock-store-name">My store</span>
                <div class="mock-screen-nav">
                  <span>About us</span>
                  <span>Location</span>
                </div>
              </div>
              <div class="mock-hero-banner">
                <img src="/assets/synthetic/store-schematic.svg" alt="" class="mock-hero-img" />
              </div>
              <div class="mock-screen-grid">
                <div class="mock-thumb-box"></div>
                <div class="mock-thumb-box"></div>
                <div class="mock-thumb-box"></div>
              </div>
            </div>

            <!-- Screen 2: Checkout Modal View -->
            <div class="mock-screen screen-checkout">
              <div class="checkout-header-row">
                <span class="checkout-back">&lt; Check-out</span>
                <span class="checkout-badge">Active</span>
              </div>
              <div class="checkout-item-preview">
                <div class="checkout-item-thumb"></div>
                <div class="checkout-item-meta">
                  <strong class="checkout-item-title">LG 43 4k smart screen</strong>
                  <span class="checkout-item-price text-mono">€15,00 / day</span>
                </div>
              </div>
              <div class="checkout-action-line">
                <span class="checkout-pill-btn">Check availability</span>
              </div>
            </div>
          </div>
        </div>

        <div class="store-tile-content">
          <h3 class="store-tile-title">Set up your own online store</h3>
          <p class="store-tile-desc">
            You now have the power to have a dedicated store for your business and maximize your contacts and leads.
          </p>
          <div class="store-cta-row">
            <a href="#book-demo" class="bento-pill-btn">Get Started</a>
          </div>
        </div>
      </article>

      <!-- ====================================================================
           ROW 2 & 3: ASYMMETRIC BENTO SATELLITES (SALES, SAFE, BOOKING, EASY, SEO)
           ==================================================================== -->

      <!-- 3A. Sales €21k Chart Card (Col 1, Row 2) -->
      <article class="bento-tile tile-mini tile-chart" aria-label="Monthly Sales Growth">
        <div class="chart-content-box">
          <span class="chart-label">Sales</span>
          <strong class="chart-value text-mono">€21k</strong>
        </div>
        <svg viewBox="0 0 160 90" class="wave-chart-svg" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="purpleWaveGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#8a3ffc" stop-opacity="0.45"/>
              <stop offset="100%" stop-color="#8a3ffc" stop-opacity="0.05"/>
            </linearGradient>
          </defs>
          <path d="M 0,75 C 25,72 45,55 70,60 C 95,65 110,35 130,42 C 145,48 150,15 160,10 L 160,90 L 0,90 Z" fill="url(#purpleWaveGrad)"/>
          <path d="M 0,75 C 25,72 45,55 70,60 C 95,65 110,35 130,42 C 145,48 150,15 160,10" fill="none" stroke="#7026ed" stroke-width="3" stroke-linecap="round"/>
        </svg>
      </article>

      <!-- 4. Amber "Safe" Shield Card (Col 2, Row 2) -->
      <article class="bento-tile tile-mini tile-safe" aria-label="Safe and Guaranteed Rentals">
        <div class="safe-badge-container">
          <svg width="68" height="68" viewBox="0 0 24 24" fill="none" class="shield-bg-svg" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="#004737"/>
          </svg>
          <span class="safe-text-overlay">Safe</span>
        </div>
      </article>

      <!-- 5. Center-Tall: Deep Forest Green Booking Flow Card (Col 3, Row 2-3) -->
      <article class="bento-tile tile-tall-booking" aria-label="Manage Entire Booking Flow">
        <div class="booking-tile-inner">
          <h3 class="booking-tile-title">
            Manage your entire booking flow in one place
          </h3>
          <p class="booking-tile-body">
            All leads from the Flecto Market are managed on Flecto so you can send quotes, receive payments and assure that the equipment is insured.
          </p>
        </div>
      </article>

      <!-- 6A. Emerald Mint "Easy" Snapping Fingers Card (Col 4, Row 2) -->
      <article class="bento-tile tile-mini tile-sparkle" aria-label="Easy and Effortless Operations">
        <div class="easy-content-row">
          <strong class="easy-text-label">Easy</strong>
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="1.8" class="sparkle-hand-svg" aria-hidden="true">
            <!-- Snapping fingers with magic sparkles -->
            <path d="M12 6V3M12 3L10 5M12 3l2 2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18 10l2-1M18 14l2 1" stroke-linecap="round"/>
            <path d="M6 10l-2-1M6 14l-2 1" stroke-linecap="round"/>
            <path d="M14 9a2 2 0 0 1 2 2v4a3 3 0 0 1-3 3h-2a4 4 0 0 1-4-4v-3a2 2 0 1 1 4 0v1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </article>

      <!-- 3B. Sand Boost Leads Card (Col 1-2, Row 3) -->
      <article class="bento-tile tile-boost-leads" aria-label="Boost Business Leads">
        <h3 class="sand-tile-title">Boost leads</h3>
        <p class="sand-tile-desc">
          Get more leads and more revenue by reaching out to a new generation of consumers that prioritizes sustainable, smart access to items.
        </p>
      </article>

      <!-- 6B. Sand Programmatic SEO Card (Col 4, Row 3) -->
      <article class="bento-tile tile-seo-pages" aria-label="Advanced Programmatic SEO">
        <h3 class="sand-tile-title">Advanced SEO</h3>
        <p class="sand-tile-desc">
          Item and industry pages per location are highly SEO optimized to drive new traffic to your products and get you some quality leads.
        </p>
      </article>

    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     THE ICONIC HISTORICAL BEIGE CANVAS (#FDFAE7)
     ========================================================================== */
  .channels-section {
    background-color: #FDFAE7;
    color: #004737;
    padding: 6.5rem 2rem 7.5rem;
    position: relative;
    overflow: hidden;
    scroll-margin-top: 70px;
  }

  .market-anchor {
    position: absolute;
    top: -80px;
    left: 0;
    visibility: hidden;
  }

  .channels-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Header */
  .channels-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .channels-pill-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 1.25rem;
    border: 1.5px solid #004737;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #004737;
    background: transparent;
    letter-spacing: -0.01em;
  }

  .channels-title {
    font-family: var(--primitive-font-display);
    font-size: clamp(2.35rem, 4.5vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    color: #004737;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .title-light {
    font-weight: 400;
    color: #004737;
  }

  /* Shared Bento Pill Button (Forest Green Pill) */
  .bento-pill-btn {
    background-color: #004737;
    color: #ffffff;
    font-family: var(--primitive-font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 0.65rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .bento-pill-btn:hover {
    background-color: #0f3c2d;
    transform: scale(1.03);
  }

  /* ==========================================================================
     AUTHENTIC 4-COLUMN BENTO GRID COMPOSITION
     ========================================================================== */
  .channels-bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto auto;
    gap: 1.5rem;
  }

  .bento-tile {
    border-radius: 32px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .bento-tile:hover {
    transform: translateY(-2px);
  }

  /* --------------------------------------------------------------------------
     1. Large Mint Flecto Market Card (Col 1-2, Row 1)
     -------------------------------------------------------------------------- */
  .tile-market-wide {
    grid-column: 1 / 3;
    grid-row: 1;
    background: #c2f4d6;
    padding: 2.5rem 2.5rem 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .market-tile-header {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .market-brand-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .market-flecto-logo {
    flex-shrink: 0;
  }

  .market-title-text {
    font-family: var(--primitive-font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: #004737;
    letter-spacing: -0.025em;
  }

  .market-lead-desc {
    font-size: 1.0625rem;
    line-height: 1.45;
    color: #004737;
    margin: 0;
    max-width: 48ch;
    font-weight: 500;
  }

  .market-cta-wrap {
    margin-top: 0.5rem;
  }

  /* Market Catalog Web Window Preview */
  .market-ui-preview {
    background: #ffffff;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    padding: 1.15rem 1.35rem 1.35rem;
    box-shadow: 0 16px 36px rgba(0, 71, 55, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .market-top-searchbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #ebf1ee;
    padding-bottom: 0.75rem;
  }

  .market-browser-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .search-input-pill {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: #f2f6f4;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #004737;
  }

  .market-browser-tags {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .browser-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: #004737;
  }

  .tag-muted {
    color: #889e94;
    font-size: 0.6875rem;
  }

  .browser-avatar-circle {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #d4e8de;
  }

  .market-catalog-split {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 1rem;
  }

  .catalog-items-subgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .cat-item-card {
    background: #fbfdfc;
    border: 1px solid #e5eee9;
    border-radius: 10px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .cat-img-box {
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #edf7f2;
    border-radius: 6px;
  }

  .cat-item-info {
    display: flex;
    flex-direction: column;
  }

  .cat-name {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #004737;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-price {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #004737;
  }

  .cat-price small {
    font-size: 0.625rem;
    font-weight: 400;
    color: #4a6358;
  }

  .cat-loc {
    font-size: 0.5875rem;
    color: #889e94;
  }

  .catalog-map-panel {
    background: #edf8f3;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  .europe-map-svg {
    width: 100%;
    height: 100%;
    max-height: 160px;
  }

  /* --------------------------------------------------------------------------
     2. Top-Right: Online Store Card (Col 3-4, Row 1)
     -------------------------------------------------------------------------- */
  .tile-online-store {
    grid-column: 3 / 5;
    grid-row: 1;
    background: #ffffff;
    padding: 2.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(0, 71, 55, 0.04);
  }

  .store-preview-visual {
    background: #f7faf8;
    border: 1px solid #e5eee9;
    border-radius: 20px;
    padding: 1.5rem;
    position: relative;
    min-height: 190px;
    overflow: hidden;
  }

  .store-screens-wrapper {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1rem;
  }

  .mock-screen {
    background: #ffffff;
    border: 1px solid #e1ebe5;
    border-radius: 12px;
    padding: 0.75rem;
    box-shadow: 0 8px 20px rgba(0, 71, 55, 0.06);
