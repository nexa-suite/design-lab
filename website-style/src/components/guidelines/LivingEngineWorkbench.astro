    roleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        roleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (emailInput && btn.dataset.email) {
          emailInput.value = btn.dataset.email;
        }
