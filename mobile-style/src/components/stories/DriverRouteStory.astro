<span class="comm">// 4. Helper Function: Explicit GPS Intent for Industrial Route Guidance</span>
<span class="kw">private fun</span> <span class="fn">launchGpsIntent</span>(context: <span class="type">Context</span>, lat: <span class="type">Double</span>, lng: <span class="type">Double</span>, label: <span class="type">String</span>) &#123;
    val uri = Uri.parse("geo:0,0?q=&#36;lat,&#36;lng(&#36;&#123;Uri.encode(label)&#125;)")
    <span class="kw">val</span> mapIntent = <span class="type">Intent</span>(<span class="type">Intent</span>.ACTION_VIEW, uri)
    context.startActivity(mapIntent)
&#125;

<span class="comm">// 5. Dedicated Signature Canvas Composable with Bézier Smoothing</span>
<span class="ann">@Composable</span>
<span class="kw">fun</span> <span class="fn">SignatureCanvas</span>(
    onPointsChanged: (<span class="type">Int</span>) -&gt; <span class="type">Unit</span>,
    modifier: <span class="type">Modifier</span> = <span class="type">Modifier</span>
) &#123;
    <span class="kw">val</span> path = remember &#123; <span class="type">Path</span>() &#125;
    <span class="kw">var</span> pointCount <span class="kw">by</span> remember &#123; mutableIntStateOf(<span class="num">0</span>) &#125;

    <span class="type">Canvas</span>(
        modifier = modifier
            .fillMaxWidth()
            .height(<span class="num">180</span>.dp)
            .pointerInput(<span class="type">Unit</span>) &#123;
                detectDragGestures(
                    onDragStart = &#123; offset -&gt;
                        path.moveTo(offset.x, offset.y)
                        pointCount++
                        onPointsChanged(pointCount)
                    &#125;,
                    onDrag = &#123; change, _ -&gt;
                        path.lineTo(change.position.x, change.position.y)
                        pointCount++
                        onPointsChanged(pointCount)
                    &#125;
                )
            &#125;
    ) &#123;
        drawPath(
            path = path,
            color = <span class="type">Color</span>(<span class="num">0xFF0F172A</span>),
            style = <span class="type">Stroke</span>(width = <span class="num">4f</span>, cap = <span class="type">StrokeCap</span>.Round, join = <span class="type">StrokeJoin</span>.Round)
        )
    &#125;
&#125;</code></pre>
