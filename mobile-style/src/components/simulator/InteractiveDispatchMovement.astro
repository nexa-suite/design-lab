---
/**
 * InteractiveDispatchMovement.astro
 * Canonical Mobile Dispatch Board & Live Custody Movement Specification
 * Includes:
 *  - 4 Kanban columns: Órdenes (4), Preparación (3), En Distribución (5), Entregado (18)
 *  - Live interactive card movement across columns with real-time counters & toast updates
 *  - Dynamic Cryptographic HMAC-SHA256 QR Generator for Carrier Handoff
 *  - Production-ready Kotlin 2.4 & Jetpack Compose Material 3 code cuadro
 */
---

<div class="interactive-dispatch-container">

  <!-- Interactive Dispatch Board Stage -->
  <div class="dispatch-board-stage">
    
    <!-- Top Board Control Bar -->
    <header class="dispatch-stage-header">
      <div class="header-left-meta">
        <span class="board-eyebrow">MONITOREO DE PATIO & MUELLE 3 FRIGORÍFICO</span>
        <h2 class="board-title">Tablero de Despacho & Flujo de Movimiento</h2>
      </div>

      <div class="header-actions">
        <button type="button" class="btn-board-ctrl" id="btn-reset-board" title="Restaurar estado inicial">
          <i class="pi pi-refresh"></i> Resetear
        </button>
        <button type="button" class="btn-board-ctrl primary" id="btn-quick-qr" title="Abrir generador QR rápido">
          <i class="pi pi-qrcode"></i> Token QR Rápido
        </button>
      </div>
    </header>

    <!-- Column Switcher for Small Screens (360dp / 390dp) -->
    <div class="mobile-column-tabs-bar" role="tablist">
      <button type="button" class="col-tab-btn active" data-col="col-orders">
        <span>Órdenes</span> <b class="badge-count" id="tab-count-orders">4</b>
      </button>
      <button type="button" class="col-tab-btn" data-col="col-prep">
        <span>Preparación</span> <b class="badge-count" id="tab-count-prep">3</b>
      </button>
      <button type="button" class="col-tab-btn" data-col="col-distrib">
        <span>Distribución</span> <b class="badge-count" id="tab-count-distrib">5</b>
      </button>
      <button type="button" class="col-tab-btn" data-col="col-delivered">
        <span>Entregado</span> <b class="badge-count" id="tab-count-delivered">18</b>
      </button>
    </div>

    <!-- 4 Kanban Columns Stage (Scrollable horizontal or tab-switched on mobile) -->
    <div class="dispatch-kanban-canvas" id="kanban-canvas">
      
      <!-- COLUMN 1: ÓRDENES -->
      <div class="kanban-column active" id="col-orders" data-status="orders">
        <div class="kanban-column-header">
          <div class="col-title-wrap">
            <span class="col-indicator orders"></span>
            <h3 class="col-name">Órdenes</h3>
          </div>
          <span class="col-counter" id="badge-orders">4</span>
        </div>

        <div class="cards-column-dropzone" id="zone-orders">
          
          <!-- Card DSP-204 -->
          <article class="dispatch-order-card" id="card-dsp-204" data-id="DSP-204" data-client="La Cava Fría" data-carrier="Diego Morales (WKN-892)" data-cargo="24x Salmón Salar" data-temp="-18.4°C" data-status="orders">
            <div class="card-top-row">
              <span class="order-id-chip">DSP-204</span>
              <span class="cold-tag cold"><i class="pi pi-snowflake"></i> -18.4°C</span>
            </div>
            <h4 class="card-client-name">La Cava Fría</h4>
            <p class="card-cargo-info">24x Salmón Salar 4-5kg IQF · Muelle 3</p>
            <div class="card-carrier-row">
              <i class="pi pi-truck"></i>
              <span>Por Asignar (Sugerido Flota C-250)</span>
            </div>
            <div class="card-action-bar">
              <button type="button" class="btn-card-move" data-card="card-dsp-204" data-next="prep">
                <span>Avanzar a Prep</span> <i class="pi pi-arrow-right"></i>
              </button>
              <button type="button" class="btn-card-qr" data-card="card-dsp-204" title="Generar token QR">
                <i class="pi pi-qrcode"></i>
              </button>
            </div>
          </article>

          <!-- Card DSP-207 -->
          <article class="dispatch-order-card" id="card-dsp-207" data-id="DSP-207" data-client="Pescadería del Mar" data-carrier="Pendiente" data-cargo="15x Merluza Austral" data-temp="-18.0°C" data-status="orders">
            <div class="card-top-row">
              <span class="order-id-chip">DSP-207</span>
              <span class="cold-tag cold"><i class="pi pi-snowflake"></i> -18.0°C</span>
            </div>
            <h4 class="card-client-name">Pescadería del Mar</h4>
            <p class="card-cargo-info">15x Merluza Austral Filete 10kg · Rampa 2</p>
            <div class="card-carrier-row">
              <i class="pi pi-truck"></i>
              <span>Sin conductor asignado</span>
            </div>
            <div class="card-action-bar">
              <button type="button" class="btn-card-move" data-card="card-dsp-207" data-next="prep">
                <span>Avanzar a Prep</span> <i class="pi pi-arrow-right"></i>
              </button>
              <button type="button" class="btn-card-qr" data-card="card-dsp-207">
                <i class="pi pi-qrcode"></i>
              </button>
            </div>
          </article>

          <!-- Card DSP-210 -->
          <article class="dispatch-order-card" id="card-dsp-210" data-id="DSP-210" data-client="Supermercados Andinos" data-carrier="Pendiente" data-cargo="40x Trucha Titicaca" data-temp="3.2°C" data-status="orders">
            <div class="card-top-row">
              <span class="order-id-chip">DSP-210</span>
              <span class="cold-tag fresh"><i class="pi pi-sun"></i> 3.2°C</span>
            </div>
            <h4 class="card-client-name">Supermercados Andinos</h4>
            <p class="card-cargo-info">40x Trucha Arcoíris Evicerada</p>
            <div class="card-carrier-row">
              <i class="pi pi-truck"></i>
              <span>Por Asignar</span>
            </div>
            <div class="card-action-bar">
              <button type="button" class="btn-card-move" data-card="card-dsp-210" data-next="prep">
                <span>Avanzar a Prep</span> <i class="pi pi-arrow-right"></i>
              </button>
              <button type="button" class="btn-card-qr" data-card="card-dsp-210">
                <i class="pi pi-qrcode"></i>
              </button>
            </div>
          </article>

          <!-- Card DSP-212 -->
          <article class="dispatch-order-card" id="card-dsp-212" data-id="DSP-212" data-client="Gourmet Express" data-carrier="Pendiente" data-cargo="10x Langostino 20/30" data-temp="-18.1°C" data-status="orders">
            <div class="card-top-row">
              <span class="order-id-chip">DSP-212</span>
              <span class="cold-tag cold"><i class="pi pi-snowflake"></i> -18.1°C</span>
            </div>
            <h4 class="card-client-name">Gourmet Express</h4>
            <p class="card-cargo-info">10x Langostino Entero 12kg</p>
            <div class="card-carrier-row">
              <i class="pi pi-truck"></i>
              <span>Por Asignar</span>
            </div>
            <div class="card-action-bar">
              <button type="button" class="btn-card-move" data-card="card-dsp-212" data-next="prep">
                <span>Avanzar a Prep</span> <i class="pi pi-arrow-right"></i>
              </button>
              <button type="button" class="btn-card-qr" data-card="card-dsp-212">
                <i class="pi pi-qrcode"></i>
              </button>
            </div>
          </article>

        </div>
      </div>

      <!-- COLUMN 2: PREPARACIÓN -->
      <div class="kanban-column" id="col-prep" data-status="prep">
        <div class="kanban-column-header">
          <div class="col-title-wrap">
            <span class="col-indicator prep"></span>
            <h3 class="col-name">Preparación</h3>
          </div>
          <span class="col-counter" id="badge-prep">3</span>
        </div>

        <div class="cards-column-dropzone" id="zone-prep">
          
          <!-- Card DSP-198 -->
          <article class="dispatch-order-card" id="card-dsp-198" data-id="DSP-198" data-client="Andino Food Service" data-carrier="Diego Morales (WKN-892)" data-cargo="18x Merluza + 10x Trucha" data-temp="-17.9°C" data-status="prep">
            <div class="card-top-row">
              <span class="order-id-chip">DSP-198</span>
              <span class="cold-tag cold"><i class="pi pi-snowflake"></i> -17.9°C</span>
            </div>
            <h4 class="card-client-name">Andino Food Service</h4>
            <p class="card-cargo-info">18x Merluza + 10x Trucha · En Estiba Muelle 3</p>
            <div class="card-carrier-row">
              <i class="pi pi-user-check text-primary"></i>
              <span>Diego Morales · WKN-892</span>
            </div>
            <div class="card-action-bar">
              <button type="button" class="btn-card-move" data-card="card-dsp-198" data-next="distrib">
                <span>Despachar a Ruta</span> <i class="pi pi-arrow-right"></i>
              </button>
              <button type="button" class="btn-card-qr active" data-card="card-dsp-198" title="Generar token QR">
                <i class="pi pi-qrcode"></i>
              </button>
            </div>
          </article>

          <!-- Card DSP-201 -->
          <article class="dispatch-order-card" id="card-dsp-201" data-id="DSP-201" data-client="Cevichera La Mar" data-carrier="Flota Local #12" data-cargo="12x Langostino" data-temp="-18.2°C" data-status="prep">
            <div class="card-top-row">
              <span class="order-id-chip">DSP-201</span>
              <span class="cold-tag cold"><i class="pi pi-snowflake"></i> -18.2°C</span>
            </div>
            <h4 class="card-client-name">Cevichera La Mar</h4>
            <p class="card-cargo-info">12x Langostino Entero Congelado</p>
            <div class="card-carrier-row">
              <i class="pi pi-truck"></i>
              <span>Flota Local #12</span>
            </div>
            <div class="card-action-bar">
              <button type="button" class="btn-card-move" data-card="card-dsp-201" data-next="distrib">
                <span>Despachar</span> <i class="pi pi-arrow-right"></i>
              </button>
              <button type="button" class="btn-card-qr" data-card="card-dsp-201">
                <i class="pi pi-qrcode"></i>
              </button>
            </div>
          </article>

          <!-- Card DSP-202 -->
          <article class="dispatch-order-card" id="card-dsp-202" data-id="DSP-202" data-client="Hotel Costa Azul" data-carrier="Flota C-180" data-cargo="8x Salmón Salar" data-temp="-18.5°C" data-status="prep">
            <div class="card-top-row">
              <span class="order-id-chip">DSP-202</span>
              <span class="cold-tag cold"><i class="pi pi-snowflake"></i> -18.5°C</span>
            </div>
            <h4 class="card-client-name">Hotel Costa Azul</h4>
            <p class="card-cargo-info">8x Salmón Salar 4-5kg IQF</p>
            <div class="card-carrier-row">
              <i class="pi pi-truck"></i>
              <span>Flota C-180</span>
            </div>
            <div class="card-action-bar">
              <button type="button" class="btn-card-move" data-card="card-dsp-202" data-next="distrib">
                <span>Despachar</span> <i class="pi pi-arrow-right"></i>
              </button>
              <button type="button" class="btn-card-qr" data-card="card-dsp-202">
                <i class="pi pi-qrcode"></i>
              </button>
            </div>
          </article>

        </div>
      </div>

      <!-- COLUMN 3: EN DISTRIBUCIÓN -->
      <div class="kanban-column" id="col-distrib" data-status="distrib">
        <div class="kanban-column-header">
          <div class="col-title-wrap">
            <span class="col-indicator distrib"></span>
            <h3 class="col-name">En Distribución</h3>
          </div>
          <span class="col-counter" id="badge-distrib">5</span>
        </div>

        <div class="cards-column-dropzone" id="zone-distrib">
          
          <!-- Card DSP-195 -->
          <article class="dispatch-order-card" id="card-dsp-195" data-id="DSP-195" data-client="Distribuidora Central" data-carrier="Diego Morales (WKN-892)" data-cargo="30x Salmón Salar" data-temp="-18.1°C" data-status="distrib">
            <div class="card-top-row">
              <span class="order-id-chip">DSP-195</span>
              <span class="cold-tag cold"><i class="pi pi-snowflake"></i> -18.1°C</span>
            </div>
            <h4 class="card-client-name">Distribuidora Central</h4>
            <p class="card-cargo-info">30x Salmón Salar · GPS: Av. Argentina km 3.5</p>
            <div class="card-carrier-row">
              <i class="pi pi-compass text-primary"></i>
              <span>En tránsito · ETA 15:10</span>
            </div>
            <div class="card-action-bar">
              <button type="button" class="btn-card-move" data-card="card-dsp-195" data-next="delivered">
                <span>Confirmar Entrega</span> <i class="pi pi-check"></i>
              </button>
              <button type="button" class="btn-card-qr" data-card="card-dsp-195">
                <i class="pi pi-qrcode"></i>
              </button>
            </div>
          </article>

          <!-- Card DSP-196 -->
          <article class="dispatch-order-card" id="card-dsp-196" data-id="DSP-196" data-client="Mar & Fuego Restaurante" data-carrier="Flota C-210" data-cargo="8x Salmón + 4x Langostino" data-temp="-18.0°C" data-status="distrib">
            <div class="card-top-row">
              <span class="order-id-chip">DSP-196</span>
              <span class="cold-tag cold"><i class="pi pi-snowflake"></i> -18.0°C</span>
            </div>
            <h4 class="card-client-name">Mar & Fuego Restaurante</h4>
            <p class="card-cargo-info">8x Salmón + 4x Langostino · Miraflores</p>
            <div class="card-carrier-row">
              <i class="pi pi-compass"></i>
              <span>ETA 15:25</span>
            </div>
            <div class="card-action-bar">
              <button type="button" class="btn-card-move" data-card="card-dsp-196" data-next="delivered">
                <span>Confirmar</span> <i class="pi pi-check"></i>
              </button>
              <button type="button" class="btn-card-qr" data-card="card-dsp-196">
                <i class="pi pi-qrcode"></i>
              </button>
            </div>
          </article>

        </div>
      </div>

      <!-- COLUMN 4: ENTREGADO -->
      <div class="kanban-column" id="col-delivered" data-status="delivered">
        <div class="kanban-column-header">
          <div class="col-title-wrap">
            <span class="col-indicator delivered"></span>
            <h3 class="col-name">Entregado (POD OK)</h3>
          </div>
          <span class="col-counter" id="badge-delivered">18</span>
        </div>

        <div class="cards-column-dropzone" id="zone-delivered">
          
          <!-- Card DSP-189 -->
          <article class="dispatch-order-card delivered" id="card-dsp-189" data-id="DSP-189" data-client="Corporación El Sol" data-carrier="Diego Morales" data-cargo="45x Cajas Variadas" data-temp="-18.3°C" data-status="delivered">
            <div class="card-top-row">
              <span class="order-id-chip delivered">DSP-189</span>
              <span class="cold-tag success"><i class="pi pi-check-circle"></i> POD Firmado</span>
            </div>
            <h4 class="card-client-name">Corporación El Sol</h4>
            <p class="card-cargo-info">Entregado a las 13:40 · Hash POD verificado</p>
            <div class="card-carrier-row">
              <i class="pi pi-shield text-success"></i>
              <span>Custodia legal completada 100%</span>
            </div>
          </article>

        </div>
      </div>

    </div>

    <!-- Live Movement Notification Bar -->
    <div class="dispatch-toast" id="dispatch-live-toast" style="display: none;">
      <i class="pi pi-arrow-right-arrow-left text-primary"></i>
      <span id="dispatch-toast-text">Orden DSP-204 movida a Preparación</span>
    </div>

  </div>

  <!-- Dynamic Cryptographic QR Generator Modal / Dialog -->
  <div class="qr-modal-backdrop" id="qr-modal-backdrop" style="display: none;">
    <div class="qr-dialog-card">
      <div class="qr-dialog-header">
        <div class="qr-title-block">
          <span class="qr-eyebrow">TRASPASO DE CUSTODIA LEGAL · CRYPTO TOKEN</span>
          <h3 class="qr-dialog-title" id="qr-dialog-order-title">Token QR: DSP-204</h3>
        </div>
        <button type="button" class="btn-close-modal" id="btn-close-qr-modal" aria-label="Cerrar modal">
          <i class="pi pi-times"></i>
        </button>
      </div>

      <div class="qr-dialog-body">
        <!-- Visual QR Matrix Simulation with Scanner Aiming Brackets -->
        <div class="qr-matrix-frame">
          <div class="qr-aim-bracket top-left"></div>
          <div class="qr-aim-bracket top-right"></div>
          <div class="qr-aim-bracket bottom-left"></div>
          <div class="qr-aim-bracket bottom-right"></div>
          
          <div class="qr-visual-block" id="qr-visual-block">
            <!-- Simulated High-Density QR SVG -->
            <svg viewBox="0 0 100 100" class="qr-svg" aria-label="Código QR Dinámico HMAC-SHA256">
              <rect width="100" height="100" fill="#ffffff" />
              <!-- Top Left Marker -->
              <rect x="6" y="6" width="28" height="28" fill="#082846" rx="4" />
              <rect x="12" y="12" width="16" height="16" fill="#ffffff" />
              <rect x="16" y="16" width="8" height="8" fill="#082846" />
              <!-- Top Right Marker -->
              <rect x="66" y="6" width="28" height="28" fill="#082846" rx="4" />
              <rect x="72" y="12" width="16" height="16" fill="#ffffff" />
              <rect x="76" y="16" width="8" height="8" fill="#082846" />
              <!-- Bottom Left Marker -->
              <rect x="6" y="66" width="28" height="28" fill="#082846" rx="4" />
              <rect x="12" y="72" width="16" height="16" fill="#ffffff" />
              <rect x="16" y="76" width="8" height="8" fill="#082846" />
              <!-- Random Data Pixels -->
              <rect x="38" y="10" width="6" height="6" fill="#082846" />
              <rect x="48" y="14" width="8" height="6" fill="#082846" />
              <rect x="40" y="24" width="6" height="10" fill="#082846" />
              <rect x="52" y="26" width="8" height="6" fill="#082846" />
              <rect x="10" y="40" width="6" height="6" fill="#082846" />
              <rect x="22" y="44" width="10" height="6" fill="#082846" />
              <rect x="38" y="40" width="8" height="8" fill="#2a67d9" />
              <rect x="50" y="42" width="6" height="6" fill="#082846" />
              <rect x="62" y="38" width="10" height="8" fill="#082846" />
              <rect x="78" y="40" width="8" height="6" fill="#082846" />
              <rect x="38" y="56" width="6" height="12" fill="#082846" />
              <rect x="48" y="60" width="10" height="8" fill="#082846" />
              <rect x="64" y="54" width="8" height="10" fill="#082846" />
              <rect x="76" y="62" width="10" height="6" fill="#082846" />
              <rect x="40" y="78" width="8" height="12" fill="#082846" />
              <rect x="54" y="80" width="10" height="8" fill="#082846" />
              <rect x="68" y="76" width="8" height="8" fill="#082846" />
              <rect x="80" y="82" width="10" height="10" fill="#082846" />
            </svg>
          </div>

          <div class="qr-countdown-badge">
            <i class="pi pi-clock"></i>
            <span>Válido: <b id="qr-timer-val">14:59</b> min</span>
          </div>
        </div>

        <!-- Token Payload Details -->
        <div class="qr-token-details">
          <div class="token-kv">
            <span class="token-key">CONDUCTOR ASIGNADO:</span>
            <strong class="token-val" id="qr-carrier-val">Diego Morales · Flota C-250 (WKN-892)</strong>
          </div>
          <div class="token-kv">
            <span class="token-key">RAMPA DE SALIDA:</span>
            <strong class="token-val">Muelle 3 Staging Frigorífico</strong>
          </div>
          <div class="token-kv">
            <span class="token-key">HASH CRIPTOGRÁFICO HMAC-SHA256:</span>
            <code class="token-hash" id="qr-hash-val">HMAC-SHA256: 7F9A2B4C8E01D345F6789ABCDEF01234</code>
          </div>
        </div>

        <button type="button" class="btn-copy-token" id="btn-copy-token">
          <i class="pi pi-copy"></i>
          <span>Copiar Token Criptográfico</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Documentation Cuadro: Production-Ready Kotlin 2.4 & Jetpack Compose Material 3 Code -->
  <section class="cuadro-card">
    <header class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">DSP</span>
        <div>
          <p class="cuadro-kicker">JETPACK COMPOSE MATERIAL 3 · TABLERO KANBAN & HMAC-SHA256</p>
          <h3 class="cuadro-title">Especificación de Transiciones de Estado y Traspaso Criptográfico</h3>
          <p class="cuadro-subtitle">
            Implementación nativa en Kotlin 2.4 con <code>HorizontalPager</code> o columnas de muelle, cálculo criptográfico con <code>javax.crypto.Mac</code> y mutaciones offline seguras con Room.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag primary"><i class="pi pi-android"></i> Android 14 M3</span>
        <span class="cuadro-tag kotlin"><i class="pi pi-code"></i> Kotlin 2.4</span>
        <span class="cuadro-tag success"><i class="pi pi-key"></i> HMAC-SHA256</span>
      </div>
    </header>

    <!-- Kotlin 2.4 Production Snippet -->
    <div class="code-box-wrapper">
      <div class="code-box-header">
        <div class="file-name">
          <i class="pi pi-file"></i>
          <span>DispatchBoardAndCryptoToken.kt — Jetpack Compose Material 3</span>
        </div>
        <span class="code-badge">Production Kotlin 2.4</span>
      </div>
      <pre class="code-content" is:raw><code><span class="kw">package</span> com.nexa.operations.presentation.dispatch

<span class="kw">import</span> androidx.compose.foundation.layout.*
<span class="kw">import</span> androidx.compose.foundation.lazy.LazyColumn
<span class="kw">import</span> androidx.compose.foundation.lazy.items
<span class="kw">import</span> androidx.compose.foundation.shape.RoundedCornerShape
<span class="kw">import</span> androidx.compose.material.icons.Icons
<span class="kw">import</span> androidx.compose.material.icons.filled.*
<span class="kw">import</span> androidx.compose.material3.*
<span class="kw">import</span> androidx.compose.runtime.*
<span class="kw">import</span> androidx.compose.ui.Alignment
<span class="kw">import</span> androidx.compose.ui.Modifier
<span class="kw">import</span> androidx.compose.ui.graphics.Color
<span class="kw">import</span> androidx.compose.ui.unit.dp
<span class="kw">import</span> javax.crypto.Mac
<span class="kw">import</span> javax.crypto.spec.SecretKeySpec
<span class="kw">import</span> java.security.MessageDigest

<span class="kw">enum class</span> <span class="type">DispatchColumn</span> {
    ORDERS, PREPARATION, IN_DISTRIBUTION, DELIVERED
}

<span class="kw">data class</span> <span class="type">DispatchItem</span>(
