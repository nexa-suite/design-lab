<span class="cmt">/**
 * Generador criptográfico HMAC-SHA256 para traspaso de custodia en rampa.
 */</span>
<span class="kw">object</span> <span class="type">DispatchCryptoSigner</span> {
    <span class="kw">fun</span> <span class="fn">generateHandoffToken</span>(
        dispatchId: <span class="type">String</span>,
        carrierPlaca: <span class="type">String</span>,
        timestampEpoch: <span class="type">Long</span>,
        secretKey: <span class="type">ByteArray</span>
    ): <span class="type">String</span> {
        <span class="kw">val</span> payload = <span class="str">"$dispatchId:$carrierPlaca:$timestampEpoch"</span>
        <span class="kw">val</span> mac = Mac.getInstance(<span class="str">"HmacSHA256"</span>)
        <span class="kw">val</span> keySpec = SecretKeySpec(secretKey, <span class="str">"HmacSHA256"</span>)
        mac.init(keySpec)
        <span class="kw">val</span> hashBytes = mac.doFinal(payload.toByteArray(Charsets.UTF_8))
        <span class="kw">return</span> hashBytes.joinToString(<span class="str">""</span>) { <span class="str">"%02x"</span>.format(it) }.take(<span class="num">32</span>).uppercase()
    }
}

