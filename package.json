{
  "name": "nexa-design-lab",
  "version": "1.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build nexa-design-lab",
    "build:library": "ng build nexa-ui",
    "build:all": "npm run build:library && npm run build",
    "validate:architecture": "node --no-warnings --experimental-strip-types tooling/scripts/validate-architecture.ts",
    "validate:tokens": "node --no-warnings --experimental-strip-types tooling/scripts/generate-design-tokens.ts --check && node --no-warnings --experimental-strip-types tooling/scripts/validate-design-tokens.ts",
    "validate:colors": "node --no-warnings --experimental-strip-types tooling/scripts/validate-colors.ts",
    "validate:icons": "node --no-warnings --experimental-strip-types tooling/scripts/validate-icons.ts",
    "validate:documentation": "node --no-warnings --experimental-strip-types tooling/scripts/validate-documentation.ts",
    "validate:public-api": "node --no-warnings --experimental-strip-types tooling/scripts/validate-public-api.ts",
    "validate:visual": "node --no-warnings --experimental-strip-types tooling/scripts/validate-visual-evidence.ts",
    "audit:visual": "node --no-warnings --experimental-strip-types tooling/scripts/generate-visual-audit.ts",
    "validate:contrast": "node --no-warnings --experimental-strip-types tooling/scripts/validate-contrast-contracts.ts",
    "validate:package": "node --no-warnings --experimental-strip-types tooling/scripts/validate-package.ts",
    "validate:browser": "node --no-warnings --experimental-strip-types tooling/visual-regression/run-browser-gate.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test nexa-design-lab",
    "test:library": "ng test nexa-ui --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "primeicons": "8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
