---
// Sustainability Section: Nexa Cold-Chain SOTD Architectural Grid Canvas
// Pure Solid Colorimetry, Blueprint Grid Mesh, Zero Plant Photos, Zero Green.
---

<section class="sustainability-section" id="sustainability" aria-labelledby="sustain-heading">
  <div class="sustain-stage-wrap">
    
    <!-- Outer Contour Frame with Blueprint Grid Mesh ("fondo con cuadraditos") -->
    <div class="sustain-blueprint-canvas" id="sustain-canvas">
      
      <!-- Ambient Blueprint Grid Overlay Layer -->
      <div class="sustain-grid-layer" aria-hidden="true"></div>

      <!-- Content Stage Grid hosting the Floating Solid Navy Cards -->
      <div class="sustain-content-grid">
        
        <!-- CARD 1: Left Intro Hook ("Misión & Propósito") -->
        <div class="sustain-card intro-card">
          <span class="intro-eyebrow text-eyebrow">Misión & Eficiencia</span>
          <h2 id="sustain-heading" class="intro-headline">
            Cadena <br />
            de Frío <br />
            Limpia
          </h2>
        </div>

        <!-- CARD 2: Center Monumental Editorial Statement -->
        <div class="sustain-card main-statement-card">
          <h3 class="main-statement-title">
            Optimizar la cadena <br />
            de frío para un futuro <br />
            sin desperdicio.
          </h3>
          <p class="main-statement-body">
            La trazabilidad en tiempo real y la custodia inteligente eliminan el desperdicio de alimentos perecibles en tránsito. Monitoreo IoT ininterrumpido a -18.2°C, rutas satelitales optimizadas y liquidación transparente sin fricción de intermediarios.
          </p>
        </div>

        <!-- CARD 3: Metric Top-Right (0.0% Rotura de Frío) -->
        <div class="sustain-card metric-card metric-top-right">
          <div class="metric-val-wrap">
            <span class="metric-val-number text-mono">0.0%</span>
          </div>
          <p class="metric-val-desc">
            Desvíos térmicos tolerados: control estricto de temperatura de muelle a entrega final
          </p>
          <div class="metric-card-pill text-mono">Norma HACCP</div>
        </div>

        <!-- CARD 4: Metric Bottom-Left (-18.2°C) -->
        <div class="sustain-card metric-card metric-bottom-left">
          <div class="metric-val-wrap">
            <span class="metric-val-number text-mono">-18.2°C</span>
          </div>
          <p class="metric-val-desc">
            Régimen continuo garantizado por sensores de telemetría Sensirion IoT
          </p>
          <div class="metric-card-pill text-mono">Telemetría Activa</div>
        </div>

        <!-- CARD 5: Metric Bottom-Right (100% Trazabilidad) -->
        <div class="sustain-card metric-card metric-bottom-right">
          <div class="metric-val-wrap">
            <span class="metric-val-number text-mono">100%</span>
          </div>
          <p class="metric-val-desc">
            Lotes certificados con protocolo GS1-128 y custodia escrow pre-autorizada
          </p>
          <div class="metric-card-pill text-mono">Custodia Smart</div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  /* --------------------------------------------------------------------------
     1. SUSTAINABILITY SECTION & BLUEPRINT GRID STAGE (0 PLANTS, 0 GREEN)
     -------------------------------------------------------------------------- */
  .sustainability-section {
    position: relative;
    width: 100%;
    background-color: #ffffff;
    padding: 3.5rem 2.5rem 4rem 2.5rem;
    display: flex;
    justify-content: center;
    overflow-x: clip;
  }

  .sustain-stage-wrap {
    width: 100%;
    max-width: 1560px;
    position: relative;
  }

  /* Architectural Blueprint Grid Canvas ("fondo de cuadros") */
  .sustain-blueprint-canvas {
    position: relative;
    width: 100%;
    min-height: 820px;
    border-radius: 36px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #082846;
    box-shadow: 0 24px 60px rgba(8, 40, 70, 0.18);
  }

  /* Blueprint Grid Pattern Layer */
  .sustain-grid-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    background-image: 
      radial-gradient(circle at 50% 50%, rgba(14, 61, 107, 0.75) 0%, #082846 100%),
      linear-gradient(rgba(56, 189, 248, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(56, 189, 248, 0.18) 1px, transparent 1px);
    background-size: 100% 100%, 36px 36px, 36px 36px;
  }

  /* --------------------------------------------------------------------------
     2. FLOATING ARCHITECTURAL SOLID NAVY CARDS (PURE SOLID COLORIMETRY)
     -------------------------------------------------------------------------- */
  .sustain-content-grid {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1360px;
    min-height: 720px;
    margin: 2.5rem;
    display: grid;
    grid-template-columns: 260px 1fr 300px;
    grid-template-rows: auto 1fr auto;
    gap: 1.5rem;
    align-items: start;
  }

  .sustain-card {
    background-color: #061e38;
    border-radius: 24px;
    color: #ffffff;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(56, 189, 248, 0.22);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .sustain-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
    border-color: rgba(56, 189, 248, 0.4);
  }

  /* CARD 1: Intro Card */
  .intro-card {
    grid-column: 1;
    grid-row: 1;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-self: start;
    margin-top: 1rem;
  }

  .intro-eyebrow {
    color: #38bdf8;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: var(--nexa-font-family-mono, monospace);
  }

  .intro-headline {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(2rem, 2.75vw, 2.85rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  /* CARD 2: Main Statement Card */
  .main-statement-card {
    grid-column: 2;
    grid-row: 1 / span 2;
    padding: 3rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-self: center;
  }

  .main-statement-title {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(2.25rem, 3.8vw, 3.85rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0;
  }

  .main-statement-body {
    font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
    max-width: 48ch;
  }

  /* CARDS 3, 4, 5: Quantitative Metric Cards */
  .metric-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem;
    gap: 1.25rem;
  }

  .metric-top-right {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    margin-top: 1rem;
  }

  .metric-bottom-left {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
  }

  .metric-bottom-right {
    grid-column: 3;
    grid-row: 2;
    align-self: end;
  }

  .metric-val-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .metric-val-number {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(2.5rem, 3.5vw, 3.5rem);
    font-weight: 800;
    color: #38bdf8;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .metric-val-desc {
    font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
    font-size: 0.875rem;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0;
  }

  .metric-card-pill {
    display: inline-flex;
    align-items: center;
    background: rgba(37, 99, 235, 0.2);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #bae6fd;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    align-self: flex-start;
  }

  @media (max-width: 1200px) {
    .sustain-content-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      gap: 1.25rem;
      margin: 1.5rem;
    }

    .intro-card {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: 0;
    }

    .main-statement-card {
      grid-column: 1 / -1;
      grid-row: auto;
      padding: 2.25rem 2rem;
    }

    .metric-top-right,
    .metric-bottom-left,
    .metric-bottom-right {
      grid-column: auto;
      grid-row: auto;
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .sustainability-section {
      padding: 2rem 1rem;
    }

    .sustain-content-grid {
      grid-template-columns: 1fr;
      margin: 1rem;
    }

    .main-statement-card {
      padding: 1.5rem;
    }

    .metric-card {
      padding: 1.5rem;
    }
  }
</style>
