<script>
  /**
   * NEXAFY LIVING GRAPHICS ENGINE — 60FPS CLIENT CONTROLLER
   * Full drag-and-drop support across all 6 nodes, real-time vascular conduit
   * recalculation with smooth S-curves/fillets, particle pulse animation,
   * live HUD coordinates, and dynamic assembly animation.
   */

  interface NodeState {
    id: string;
    name: string;
    x: number;
    y: number;
    width: number;
    height: number;
  }

  interface EdgeDef {
    id: string;
    pathId: string;
    pulseId: string;
    sourceId: string;
    targetId: string;
    getSourcePoint: () => { x: number; y: number };
    getTargetPoint: () => { x: number; y: number };
    pulseProgress: number;
    pulseSpeed: number;
  }

  // Canonical Initial Positions (Symmetric & Zero Collision)
  const INITIAL_POSITIONS: Record<string, { x: number; y: number }> = {
    'circuit-hub':        { x: 25, y: 175 },
    'circuit-center-hub': { x: 230, y: 180 },
    'station-01-card':    { x: 450, y: 55 },
    'station-02-card':    { x: 450, y: 197 },
    'station-03-card':    { x: 450, y: 339 },
    'circuit-dest-hub':   { x: 860, y: 170 }
  };

  const PRESET_MATRIX: Record<string, { x: number; y: number }> = {
    'circuit-hub':        { x: 20, y: 175 },
    'circuit-center-hub': { x: 205, y: 180 },
    'station-01-card':    { x: 420, y: 40 },
    'station-02-card':    { x: 420, y: 197 },
    'station-03-card':    { x: 420, y: 354 },
    'circuit-dest-hub':   { x: 875, y: 170 }
  };

  const PRESET_ESCROW: Record<string, { x: number; y: number }> = {
    'circuit-hub':        { x: 30, y: 175 },
    'circuit-center-hub': { x: 220, y: 180 },
    'station-01-card':    { x: 430, y: 50 },
    'station-02-card':    { x: 430, y: 180 },
    'station-03-card':    { x: 460, y: 310 },
    'circuit-dest-hub':   { x: 860, y: 220 }
  };

  const NODES: Record<string, NodeState> = {
    'circuit-hub':        { id: 'circuit-hub', name: 'Terminal Pesquero', x: 25, y: 175, width: 140, height: 140 },
    'circuit-center-hub': { id: 'circuit-center-hub', name: 'Nexa Hub Core', x: 230, y: 180, width: 120, height: 120 },
    'station-01-card':    { id: 'station-01-card', name: '01 Despacho FEFO', x: 450, y: 55, width: 295, height: 86 },
    'station-02-card':    { id: 'station-02-card', name: '02 Telemetría IoT', x: 450, y: 197, width: 295, height: 86 },
    'station-03-card':    { id: 'station-03-card', name: '03 Escrow 100%', x: 450, y: 339, width: 295, height: 86 },
    'circuit-dest-hub':   { id: 'circuit-dest-hub', name: 'Red Mayorista', x: 860, y: 170, width: 154, height: 154 }
  };

  const EDGES: EdgeDef[] = [
    {
      id: 'trunk',
      pathId: 'pipe-trunk',
      pulseId: 'pulse-trunk',
      sourceId: 'circuit-hub',
      targetId: 'circuit-center-hub',
      getSourcePoint: () => ({ x: NODES['circuit-hub'].x + NODES['circuit-hub'].width, y: NODES['circuit-hub'].y + NODES['circuit-hub'].height / 2 }),
      getTargetPoint: () => ({ x: NODES['circuit-center-hub'].x, y: NODES['circuit-center-hub'].y + NODES['circuit-center-hub'].height / 2 }),
      pulseProgress: 0.1,
      pulseSpeed: 0.005
    },
    {
      id: 'branch-top',
      pathId: 'pipe-branch-top',
      pulseId: 'pulse-branch-top',
      sourceId: 'circuit-center-hub',
      targetId: 'station-01-card',
      getSourcePoint: () => ({ x: NODES['circuit-center-hub'].x + NODES['circuit-center-hub'].width, y: NODES['circuit-center-hub'].y + 30 }),
      getTargetPoint: () => ({ x: NODES['station-01-card'].x, y: NODES['station-01-card'].y + NODES['station-01-card'].height / 2 }),
      pulseProgress: 0.3,
      pulseSpeed: 0.004
    },
    {
      id: 'branch-mid',
      pathId: 'pipe-branch-mid',
      pulseId: 'pulse-branch-mid',
      sourceId: 'circuit-center-hub',
      targetId: 'station-02-card',
      getSourcePoint: () => ({ x: NODES['circuit-center-hub'].x + NODES['circuit-center-hub'].width, y: NODES['circuit-center-hub'].y + 60 }),
      getTargetPoint: () => ({ x: NODES['station-02-card'].x, y: NODES['station-02-card'].y + NODES['station-02-card'].height / 2 }),
      pulseProgress: 0.5,
      pulseSpeed: 0.005
    },
    {
      id: 'branch-bot',
      pathId: 'pipe-branch-bot',
      pulseId: 'pulse-branch-bot',
      sourceId: 'circuit-center-hub',
      targetId: 'station-03-card',
      getSourcePoint: () => ({ x: NODES['circuit-center-hub'].x + NODES['circuit-center-hub'].width, y: NODES['circuit-center-hub'].y + 90 }),
      getTargetPoint: () => ({ x: NODES['station-03-card'].x, y: NODES['station-03-card'].y + NODES['station-03-card'].height / 2 }),
      pulseProgress: 0.2,
      pulseSpeed: 0.004
    },
    {
      id: 'exit-top',
      pathId: 'pipe-exit-top',
      pulseId: 'pulse-exit-top',
      sourceId: 'station-01-card',
      targetId: 'circuit-dest-hub',
      getSourcePoint: () => ({ x: NODES['station-01-card'].x + NODES['station-01-card'].width, y: NODES['station-01-card'].y + NODES['station-01-card'].height / 2 }),
      getTargetPoint: () => ({ x: NODES['circuit-dest-hub'].x, y: NODES['circuit-dest-hub'].y + 38 }),
      pulseProgress: 0.6,
      pulseSpeed: 0.004
    },
    {
      id: 'exit-mid',
      pathId: 'pipe-exit-mid',
      pulseId: 'pulse-exit-mid',
      sourceId: 'station-02-card',
      targetId: 'circuit-dest-hub',
      getSourcePoint: () => ({ x: NODES['station-02-card'].x + NODES['station-02-card'].width, y: NODES['station-02-card'].y + NODES['station-02-card'].height / 2 }),
      getTargetPoint: () => ({ x: NODES['circuit-dest-hub'].x, y: NODES['circuit-dest-hub'].y + 77 }),
      pulseProgress: 0.4,
      pulseSpeed: 0.005
    },
    {
      id: 'exit-bot',
      pathId: 'pipe-exit-bot',
      pulseId: 'pulse-exit-bot',
      sourceId: 'station-03-card',
      targetId: 'circuit-dest-hub',
      getSourcePoint: () => ({ x: NODES['station-03-card'].x + NODES['station-03-card'].width, y: NODES['station-03-card'].y + NODES['station-03-card'].height / 2 }),
      getTargetPoint: () => ({ x: NODES['circuit-dest-hub'].x, y: NODES['circuit-dest-hub'].y + 116 }),
      pulseProgress: 0.7,
      pulseSpeed: 0.004
    }
  ];

  let isBuilding = false;

  /**
   * Smooth S-curve / Filleted Orthogonal Conduit Router
   */
  function routeConduit(p1: { x: number; y: number }, p2: { x: number; y: number }, radius: number = 20): string {
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;

    // Straight horizontal line if y-difference is negligible
    if (Math.abs(dy) < 2) {
      return `M ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} L ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
    }

    // Forward smooth routing with rounded fillets
    if (dx >= 24) {
      const midX = p1.x + dx / 2;
      const r = Math.min(radius, Math.abs(dx) / 2 - 2, Math.abs(dy) / 2 - 2);
      const signY = dy > 0 ? 1 : -1;

      return `M ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} ` +
             `L ${(midX - r).toFixed(1)} ${p1.y.toFixed(1)} ` +
             `Q ${midX.toFixed(1)} ${p1.y.toFixed(1)}, ${midX.toFixed(1)} ${(p1.y + signY * r).toFixed(1)} ` +
             `L ${midX.toFixed(1)} ${(p2.y - signY * r).toFixed(1)} ` +
             `Q ${midX.toFixed(1)} ${p2.y.toFixed(1)}, ${(midX + r).toFixed(1)} ${p2.y.toFixed(1)} ` +
             `L ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
    }

    // Graceful loop if target is dragged behind source
    const safeOffsetY = dy >= 0 ? 60 : -60;
    return `M ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} ` +
           `C ${(p1.x + 35).toFixed(1)} ${p1.y.toFixed(1)}, ${(p1.x + 35).toFixed(1)} ${(p1.y + safeOffsetY).toFixed(1)}, ${(p1.x + p2.x) / 2} ${(p1.y + safeOffsetY).toFixed(1)} ` +
           `C ${(p2.x - 35).toFixed(1)} ${(p1.y + safeOffsetY).toFixed(1)}, ${(p2.x - 35).toFixed(1)} ${p2.y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
  }

  /**
   * Recalculate all 7 vascular conduits dynamically in real time
   */
  function rerouteAll() {
    EDGES.forEach(edge => {
      const p1 = edge.getSourcePoint();
      const p2 = edge.getTargetPoint();
      const pathD = routeConduit(p1, p2, 20);
      const pathEl = document.getElementById(edge.pathId) as SVGPathElement | null;
      if (pathEl) {
        pathEl.setAttribute('d', pathD);
        pathEl.style.strokeDasharray = 'none';
        pathEl.style.strokeDashoffset = '0';
        pathEl.style.opacity = '1';
      }
    });

    checkCollisions();
  }

  /**
   * Collision detection check between blocks
   */
  function checkCollisions() {
    const ids = Object.keys(NODES);
    let collisionCount = 0;

    for (let i = 0; i < ids.length; i++) {
      for (let j = i + 1; j < ids.length; j++) {
        const a = NODES[ids[i]];
        const b = NODES[ids[j]];

        const overlapX = a.x < b.x + b.width - 6 && a.x + a.width - 6 > b.x;
        const overlapY = a.y < b.y + b.height - 6 && a.y + a.height - 6 > b.y;

        if (overlapX && overlapY) {
          collisionCount++;
        }
      }
    }

    const collisionPill = document.querySelector('.collision-pill');
    if (collisionPill) {
      if (collisionCount === 0) {
        collisionPill.innerHTML = '<i class="pi pi-check-circle" style="color: #0284c7;"></i> 0 Colisiones';
        collisionPill.classList.remove('has-collision');
      } else {
        collisionPill.innerHTML = `<i class="pi pi-exclamation-triangle" style="color: #ef4444;"></i> ${collisionCount} Solapamiento${collisionCount > 1 ? 's' : ''}`;
        collisionPill.classList.add('has-collision');
      }
    }
  }

  /**
   * Interactive Drag & Drop System
   */
  function setupDragAndDrop() {
    const stage = document.getElementById('circuit-stage');
    if (!stage) return;

    const dragHud = document.getElementById('workbench-drag-hud');
    const hudCoordsText = document.getElementById('hud-coords-text');
    const tickerMsg = document.getElementById('workbench-ticker-msg');

    Object.keys(NODES).forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;

      // Initialize position and guarantee active visibility
      el.style.left = `${NODES[id].x}px`;
      el.style.top = `${NODES[id].y}px`;
      el.style.opacity = '1';
      el.style.transform = 'scale(1) translate(0, 0)';
      el.style.display = 'flex';
      el.style.visibility = 'visible';

      let isDragging = false;
      let dragOffset = { x: 0, y: 0 };

      el.addEventListener('pointerdown', (e: PointerEvent) => {
        if (isBuilding) return;
        isDragging = true;
        el.setPointerCapture(e.pointerId);

        const rect = el.getBoundingClientRect();
        dragOffset = {
          x: e.clientX - rect.left,
          y: e.clientY - rect.top
        };

        el.classList.add('is-dragging');
        if (dragHud) dragHud.style.display = 'flex';
        if (hudCoordsText) {
          hudCoordsText.textContent = `${NODES[id].name} · X: ${Math.round(NODES[id].x)}px · Y: ${Math.round(NODES[id].y)}px`;
        }
        e.preventDefault();
      });

      el.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDragging) return;

        const stageRect = stage.getBoundingClientRect();
        let newX = e.clientX - stageRect.left - dragOffset.x;
        let newY = e.clientY - stageRect.top - dragOffset.y;

        // Stage boundary clamping (Never leave canvas or cut tubes)
        newX = Math.max(10, Math.min(stageRect.width - NODES[id].width - 10, newX));
        newY = Math.max(10, Math.min(stageRect.height - NODES[id].height - 10, newY));

        NODES[id].x = newX;
        NODES[id].y = newY;

        el.style.left = `${newX}px`;
        el.style.top = `${newY}px`;

        if (hudCoordsText) {
          hudCoordsText.textContent = `${NODES[id].name} · X: ${Math.round(newX)}px · Y: ${Math.round(newY)}px`;
        }

        rerouteAll();
      });

      const onPointerEnd = () => {
        if (!isDragging) return;
        isDragging = false;
        el.classList.remove('is-dragging');
        if (dragHud) dragHud.style.display = 'none';

        if (tickerMsg) {
          tickerMsg.textContent = `✦ Bloque [${NODES[id].name}] posicionado en (${Math.round(NODES[id].x)}, ${Math.round(NODES[id].y)}) · Conduits recalculados`;
        }
      };

      el.addEventListener('pointerup', onPointerEnd);
      el.addEventListener('pointercancel', onPointerEnd);
    });
  }

  /**
   * Animate Signal Pulses Flowing through Conduits (60 FPS)
   */
  function animateParticles() {
    EDGES.forEach(edge => {
      edge.pulseProgress += edge.pulseSpeed;
      if (edge.pulseProgress > 1) edge.pulseProgress = 0;

      const pathEl = document.getElementById(edge.pathId) as SVGPathElement | null;
      const particleEl = document.getElementById(edge.pulseId) as SVGCircleElement | null;

      if (pathEl && particleEl) {
        const len = pathEl.getTotalLength();
        if (len > 0) {
          const pt = pathEl.getPointAtLength(edge.pulseProgress * len);
          particleEl.setAttribute('cx', pt.x.toFixed(1));
          particleEl.setAttribute('cy', pt.y.toFixed(1));
        }
      }
    });

    requestAnimationFrame(animateParticles);
  }

  /**
   * Dynamic Assembly "Construir Motor (Build)"
   */
  function buildEngineAssembly() {
    if (isBuilding) return;
    isBuilding = true;

    const btnBuild = document.getElementById('btn-build-engine') as HTMLButtonElement | null;
    const tickerMsg = document.getElementById('workbench-ticker-msg');
    if (btnBuild) btnBuild.disabled = true;

    if (tickerMsg) {
      tickerMsg.textContent = '✦ Ensamblando motor gráfico Nexafy: Conectando muelle y estaciones...';
    }

    // Step 0: Disperse
    Object.keys(NODES).forEach((id, idx) => {
      const el = document.getElementById(id);
      if (el) {
        el.style.transition = 'all 0.35s cubic-bezier(0.16, 1, 0.3, 1)';
        el.style.opacity = '0.35';
        el.style.transform = `scale(0.9) translate(${(idx % 2 === 0 ? -16 : 16)}px, ${(idx % 3 === 0 ? -12 : 12)}px)`;
      }
    });

    const sequence = [
      { ids: ['circuit-hub'], delay: 100, msg: '✦ 1/5: Origen [Terminal Pesquero Callao · B2B] acoplado' },
      { ids: ['circuit-center-hub'], delay: 400, msg: '✦ 2/5: Núcleo Bus [NEXA HUB Core] conectado' },
      { ids: ['station-01-card'], delay: 750, msg: '✦ 3/5: Estación 01 [Despacho en Bahía · FEFO] acoplada' },
      { ids: ['station-02-card'], delay: 1100, msg: '✦ 4/5: Estación 02 [Telemetría Sensirion IoT · -18.2°C] sincronizada' },
      { ids: ['station-03-card', 'circuit-dest-hub'], delay: 1450, msg: '✦ 5/5: Estación 03 [Custodia Escrow 100%] y Red Mayorista enlazadas' },
    ];

    sequence.forEach(step => {
      setTimeout(() => {
        step.ids.forEach(id => {
          const el = document.getElementById(id);
          const target = INITIAL_POSITIONS[id];
          if (el && target) {
            NODES[id].x = target.x;
            NODES[id].y = target.y;
            el.style.transition = 'left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), top 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.4s ease, opacity 0.3s ease';
            el.style.left = `${target.x}px`;
            el.style.top = `${target.y}px`;
            el.style.transform = 'scale(1) translate(0, 0)';
            el.style.opacity = '1';
          }
        });
        rerouteAll();
        if (tickerMsg) tickerMsg.textContent = step.msg;
      }, step.delay);
    });

    setTimeout(() => {
      isBuilding = false;
      if (btnBuild) btnBuild.disabled = false;
      if (tickerMsg) {
        tickerMsg.textContent = '✦ Motor Gráfico Nexafy Construido y 100% Operativo · Arrastra cualquier bloque libremente';
      }
      Object.keys(NODES).forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.transition = 'none';
      });
    }, 1900);
  }

  /**
   * Apply Preset Positions Smoothly
   */
  function applyPreset(presetKey: string) {
    let preset = INITIAL_POSITIONS;
    if (presetKey === 'matrix') preset = PRESET_MATRIX;
    else if (presetKey === 'escrow') preset = PRESET_ESCROW;

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.preset === presetKey);
    });

    Object.keys(preset).forEach(id => {
      const target = preset[id];
      const el = document.getElementById(id);
      if (el && target) {
        NODES[id].x = target.x;
        NODES[id].y = target.y;
        el.style.transition = 'left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), top 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)';
        el.style.left = `${target.x}px`;
        el.style.top = `${target.y}px`;
      }
    });

    rerouteAll();

    setTimeout(() => {
      Object.keys(NODES).forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.transition = 'none';
      });
    }, 500);

    const tickerMsg = document.getElementById('workbench-ticker-msg');
    if (tickerMsg) {
      tickerMsg.textContent = `✦ Preset [${presetKey.toUpperCase()}] aplicado con 0 colisiones`;
    }
  }

  // Tones Management
  const TONES: Record<string, { plate: string; accent: string; conduit: string }> = {
    nexa:     { plate: '#082846', accent: '#38bdf8', conduit: '#bae6fd' },
    ceramic:  { plate: '#1d3d63', accent: '#38bdf8', conduit: '#a5f3fc' },
    cashmere: { plate: '#283a48', accent: '#7dd3fc', conduit: '#bae6fd' },
    oceanic:  { plate: '#0c2038', accent: '#38bdf8', conduit: '#93c5fd' }
  };

  function applyTone(toneKey: string) {
    const tone = TONES[toneKey];
    if (!tone) return;

    document.querySelectorAll('.tone-pill').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.tone === toneKey);
    });

    const silPath = document.querySelector<SVGPathElement>('.hero-silhouette-path');
    if (silPath) silPath.setAttribute('fill', tone.plate);

    const pipes = document.querySelectorAll<SVGPathElement>('.circuit-pipe-line');
    pipes.forEach(p => p.setAttribute('stroke', tone.conduit));
  }

  function initLivingEngineWorkbench() {
    setupDragAndDrop();
    rerouteAll();
    animateParticles();

    // Build Engine Assembly
    const btnBuild = document.getElementById('btn-build-engine');
    btnBuild?.addEventListener('click', buildEngineAssembly);

    // Preset Switching
    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.dataset.preset || 'channels';
        applyPreset(preset);
      });
    });

    // Tone Switching
    document.querySelectorAll<HTMLButtonElement>('.tone-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const toneKey = btn.dataset.tone || 'nexa';
        applyTone(toneKey);
      });
    });

    // Conduit Pastel Switching
    document.querySelectorAll<HTMLButtonElement>('.conduit-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const pastel = btn.dataset.pastel || '#bae6fd';
        document.querySelectorAll('.conduit-pill').forEach(b => b.classList.toggle('active', b === btn));
        document.querySelectorAll<SVGPathElement>('.circuit-pipe-line').forEach(p => p.setAttribute('stroke', pastel));
      });
    });

    // Inspector Drawer Toggle
    const inspectorDrawer = document.getElementById('workbench-inspector-drawer');
    const btnToggleInspector = document.getElementById('btn-toggle-inspector');
    const btnCloseInspector = document.getElementById('btn-close-inspector');

    btnToggleInspector?.addEventListener('click', () => {
      inspectorDrawer?.classList.toggle('open');
    });

    btnCloseInspector?.addEventListener('click', () => {
      inspectorDrawer?.classList.remove('open');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLivingEngineWorkbench);
  } else {
    initLivingEngineWorkbench();
  }
</script>
