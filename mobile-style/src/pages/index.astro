---
/**
 * MOBILE STYLE — MASTER GUIDELINES & INTERACTIVE DEVICE SIMULATOR
 * Unified 1:1 Design Lab Architecture with Web Style shell, zero padding errors,
 * isolated per-screen navigation, and comprehensive specifications for Android Jetpack Compose.
 */
import 'primeicons/primeicons.css';
import '../styles/mobile-tokens.css';
import UnifiedLabShell from '../components/layout/UnifiedLabShell.astro';

// Architecture & Evidence
import MobileArchitectureHero from '../components/guidelines/MobileArchitectureHero.astro';
import MobileEvidenceModel from '../components/guidelines/MobileEvidenceModel.astro';

// Foundations M3
import TokensColorSection from '../components/guidelines/TokensColorSection.astro';
import TipografiaSpSection from '../components/guidelines/TipografiaSpSection.astro';
import Cuadricula8dpSection from '../components/guidelines/Cuadricula8dpSection.astro';
import ElevacionesM3Section from '../components/guidelines/ElevacionesM3Section.astro';

// Ergonomics
import Ergonomia48dpSection from '../components/guidelines/Ergonomia48dpSection.astro';
import ZonasAlcanceSection from '../components/guidelines/ZonasAlcanceSection.astro';

// Components & Code
import MobileComponentsSection from '../components/guidelines/MobileComponentsSection.astro';
import CodeSnippetsTabs from '../components/spec/CodeSnippetsTabs.astro';

// Blueprint User Stories
import DriverRouteStory from '../components/stories/DriverRouteStory.astro';
import WarehousePickingStory from '../components/stories/WarehousePickingStory.astro';
import DispatchBoardStory from '../components/stories/DispatchBoardStory.astro';
import MachineryInspectionStory from '../components/stories/MachineryInspectionStory.astro';

// Hardware & Resilience
import MobileHardwareSection from '../components/guidelines/MobileHardwareSection.astro';
import MobileResilienceSection from '../components/guidelines/MobileResilienceSection.astro';

// Native Simulator & Live Interactive Features
import DeviceFrame from '../components/simulator/DeviceFrame.astro';
import InteractiveMobileNavbar from '../components/simulator/InteractiveMobileNavbar.astro';
import InteractiveWholesaleCatalog from '../components/simulator/InteractiveWholesaleCatalog.astro';
import InteractiveMobileForms from '../components/simulator/InteractiveMobileForms.astro';
import InteractiveDispatchMovement from '../components/simulator/InteractiveDispatchMovement.astro';
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mobile Style · Nexa Design Lab (Android Kotlin Compose)</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link 
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" 
    rel="stylesheet"
  >

  <style>
    /* Global Reset & Padding Hygiene */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--nexa-surface-page, #f6faff);
      color: var(--nexa-color-text-primary, #0f172a);
      font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* Master Documentation Page (Exact layout matching web-style) */
    .documentation-page {
      width: min(calc(100% - 48px), var(--nexa-layout-content-max, 1400px));
      margin: 0 auto;
      padding: clamp(24px, 4vw, 48px) 0 96px;
      color: var(--nexa-color-text-primary, #0f172a);
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Documentation Header */
    .documentation-header {
      display: grid;
      gap: 18px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    .breadcrumb-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      color: var(--nexa-color-text-muted, #94a3b8);
      font: 500 11px/1.4 var(--nexa-font-family-mono, monospace);
    }

    .breadcrumb-row a {
      color: var(--nexa-color-primary-700, #1d4ed8);
      text-decoration: none;
      font-weight: 600;
    }

    .header-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 32px;
      align-items: start;
    }

    @media (max-width: 900px) {
      .header-grid {
        grid-template-columns: 1fr;
      }
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .12em;
      line-height: 1.3;
      text-transform: uppercase;
    }

    .documentation-header h1 {
      max-width: 820px;
      margin: 0;
      font: 800 clamp(26px, 3.5vw, 40px)/1.15 var(--nexa-font-family-display, sans-serif);
      letter-spacing: -.035em;
      color: var(--nexa-color-text-primary, #0f172a);
    }

    .intro {
      max-width: 780px;
      margin: 12px 0 0;
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 14.5px;
      line-height: 1.6;
    }

    .status-panel {
      display: grid;
      gap: 8px;
      padding: 16px;
      border: 1px solid var(--nexa-color-border-default, #e2e8f0);
      border-radius: var(--nexa-radius-card, 16px);
      background: var(--nexa-surface-card, #ffffff);
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 11.5px;
      line-height: 1.4;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .status-label {
      margin: 0;
      color: var(--nexa-color-text-muted, #94a3b8);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .design-status {
      display: inline-flex;
      width: fit-content;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .04em;
      color: var(--nexa-color-primary-800, #1e40af);
      background: var(--nexa-color-primary-100, #dbeafe);
    }

    .adoption-status {
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-weight: 700;
    }

    .header-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
      color: var(--nexa-color-text-muted, #94a3b8);
      font-size: 11.5px;
    }

    .header-meta span {
      display: inline-flex;
      gap: 6px;
      align-items: center;
    }

    .header-meta i {
      color: var(--nexa-color-primary-600, #2a67d9);
      font-size: 13px;
    }

    /* ==========================================================================
       ONE-SCREEN-AT-A-TIME ARCHITECTURE (.mobile-screen-view)
       ========================================================================== */
    .screens-master-host {
      width: 100%;
      min-width: 0;
    }

    .mobile-screen-view {
      display: none;
      width: 100%;
      animation: screenFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mobile-screen-view.active {
      display: block;
    }

    @keyframes screenFadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Standalone Simulator Screen */
    .simulator-standalone-stage {
      display: flex;
      flex-direction: column;
      gap: 24px;
      width: 100%;
      align-items: center;
    }

    .simulator-intro-bar {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
      padding: 18px 22px;
      background: var(--nexa-surface-card, #ffffff);
      border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
      border-radius: var(--nexa-radius-card, 16px);
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .card-eyebrow {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.12em;
      color: var(--nexa-color-primary-700, #1d4ed8);
      text-transform: uppercase;
      display: block;
      margin-bottom: 2px;
    }

    .card-title {
      font-family: var(--nexa-font-family-display, sans-serif);
      font-size: 17px;
      font-weight: 700;
      color: var(--nexa-color-text-primary, #0f172a);
      margin: 0;
    }

    .spec-pills {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .spec-pill {
      font-size: 11px;
      font-weight: 600;
      background: var(--nexa-color-neutral-50, #f8fafc);
      color: var(--nexa-color-neutral-700, #334155);
      border: 1px solid var(--nexa-color-border-default, #cbd5e1);
      padding: 4px 10px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .simulator-center-wrapper {
      display: flex;
      justify-content: center;
      width: 100%;
      padding: 12px 0 24px;
    }

    /* Code Generator Card */
    .code-generator-card {
      background: var(--nexa-surface-card, #ffffff);
      border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
      border-radius: var(--nexa-radius-card, 16px);
      padding: 24px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .card-header-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .card-badge-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: var(--nexa-color-primary-50, #eff6ff);
      color: var(--nexa-color-primary-600, #2a67d9);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      flex-shrink: 0;
    }

    .card-text {
      font-size: 13.5px;
      color: var(--nexa-color-text-secondary, #64748b);
      line-height: 1.6;
      margin: 0;
    }

    /* Provenance Section */
    .provenance-section {
      padding: 32px 0 0;
      border-top: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    .provenance-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    @media (max-width: 900px) {
      .provenance-grid {
        grid-template-columns: 1fr;
      }
    }

    .provenance-grid > div {
      padding: 16px;
      border-top: 3px solid var(--nexa-color-primary-300, #93c5fd);
      background: var(--nexa-surface-card, #ffffff);
      border-radius: 0 0 10px 10px;
      border-left: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      border-right: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      border-bottom: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
    }

    .provenance-grid b {
      font-size: 13px;
      color: var(--nexa-color-text-primary, #0f172a);
    }

    .provenance-grid p {
      margin: 8px 0 0;
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 12px;
      line-height: 1.5;
    }
  </style>
</head>
<body>

  <!-- Unified Design Lab Shell (Identical layout to Web Style) -->
  <UnifiedLabShell currentSection="mobile">
    <main class="documentation-page" id="documentation-content">
      
      <!-- Top Documentation Header -->
      <header class="documentation-header">
        <div class="breadcrumb-row">
          <a href="/">Design Lab</a>
          <span aria-hidden="true">/</span>
          <span>Mobile Style</span>
          <span aria-hidden="true">/</span>
          <span id="breadcrumb-current-screen">¿Qué usan? (Android Kotlin)</span>
        </div>

        <div class="header-grid">
          <div>
            <p class="eyebrow">CANONICAL MOBILE SPECIFICATION</p>
            <h1>Directrices de Diseño Móvil (Android Kotlin Compose M3)</h1>
            <p class="intro">
              Sistema de diseño unificado para dispositivos móviles de <strong>Nexa Suite</strong>. Arquitectura de pantallas aisladas, contratos de ergonomía táctil (mínimo 48dp y 56dp con guantes industriales), elevaciones tonales Material 3, escalado tipográfico en <code>sp</code>, escaneo óptico CameraX y cola offline con WorkManager.
            </p>
          </div>

          <aside class="status-panel">
            <span class="status-label">MATURIDAD</span>
            <strong class="design-status">FROZEN CANDIDATE</strong>
            <span class="status-label">ADOPCIÓN</span>
            <strong class="adoption-status">Operations Android (:core:designsystem)</strong>
            <span>Android SDK 37 (minSdk 29) · Kotlin 2.4 · WCAG 2.2 AA</span>
          </aside>
        </div>

        <div class="header-meta">
          <span><i class="pi pi-android" aria-hidden="true"></i>Kotlin 2.4 · Jetpack Compose M3</span>
          <span><i class="pi pi-shield" aria-hidden="true"></i>ADR-0018 Candidate</span>
          <span><i class="pi pi-camera" aria-hidden="true"></i>CameraX + ML Kit Vision</span>
          <span><i class="pi pi-eye" aria-hidden="true"></i>WCAG 2.2 AA (48dp target)</span>
        </div>
      </header>

      <!-- Host Container for Isolated Screens -->
      <div class="screens-master-host">

        <!-- 1. ARQUITECTURA & STACK -->
        <div class="mobile-screen-view active" id="screen-arquitectura-android">
          <MobileArchitectureHero />
        </div>

        <div class="mobile-screen-view" id="screen-modelo-evidencia">
          <MobileEvidenceModel />
        </div>

        <!-- 2. FUNDAMENTOS M3 -->
        <div class="mobile-screen-view" id="screen-tokens-color">
          <TokensColorSection />
        </div>

        <div class="mobile-screen-view" id="screen-tipografia-sp">
          <TipografiaSpSection />
        </div>

        <div class="mobile-screen-view" id="screen-cuadricula-8dp">
          <Cuadricula8dpSection />
        </div>

        <div class="mobile-screen-view" id="screen-elevaciones-m3">
          <ElevacionesM3Section />
        </div>

        <!-- 3. ERGONOMÍA TÁCTIL -->
        <div class="mobile-screen-view" id="screen-ergonomia-48dp">
          <Ergonomia48dpSection />
        </div>

        <div class="mobile-screen-view" id="screen-zonas-alcance">
          <ZonasAlcanceSection />
        </div>

        <!-- 4. COMPONENTES COMPOSE & CÓDIGO -->
        <div class="mobile-screen-view" id="screen-componentes-compose">
          <MobileComponentsSection />
        </div>

        <div class="mobile-screen-view" id="screen-codigo-nativo">
          <section class="code-generator-card">
            <div class="card-header-row">
              <div class="card-badge-icon"><i class="pi pi-code"></i></div>
              <div>
                <span class="card-eyebrow">CÓDIGO DE PRODUCCIÓN · ANDROID KOTLIN</span>
                <h3 class="card-title">Generador de Código Nativo (Compose & Multiplatform)</h3>
              </div>
            </div>
            <p class="card-text">
              Implementaciones verificadas frente al compilador de Kotlin 2.4. Utilizan tokens semánticos del Design Lab y garantizan objetivos táctiles de 48dp/56dp.
            </p>
            <CodeSnippetsTabs />
          </section>
        </div>

        <!-- 5. HISTORIAS DE USUARIO (BLUEPRINT EN CAMPO) -->
        <div class="mobile-screen-view" id="screen-historia-conductor">
          <DriverRouteStory />
        </div>

        <div class="mobile-screen-view" id="screen-historia-bodega">
          <WarehousePickingStory />
        </div>

        <div class="mobile-screen-view" id="screen-historia-despacho">
          <DispatchBoardStory />
        </div>

        <div class="mobile-screen-view" id="screen-inspeccion-maquinaria">
          <MachineryInspectionStory />
        </div>

        <!-- 6. HARDWARE & RED -->
        <div class="mobile-screen-view" id="screen-hardware-camerax">
          <MobileHardwareSection />
        </div>

        <div class="mobile-screen-view" id="screen-resiliencia-red">
          <MobileResilienceSection />
        </div>

        <!-- 7. INSPECCIÓN ARQUITECTÓNICA DE PANTALLAS CANÓNICAS -->
        <div class="mobile-screen-view" id="screen-simulador-hardware">
          <DeviceFrame />
        </div>

        <!-- 8. MÓDULOS INTERACTIVOS EN VIVO (LIVE SIMULATOR SPECIMENS) -->
        <div class="mobile-screen-view" id="screen-live-dispatch">
          <InteractiveDispatchMovement />
        </div>

        <div class="mobile-screen-view" id="screen-live-catalog">
          <InteractiveWholesaleCatalog />
        </div>

        <div class="mobile-screen-view" id="screen-live-forms">
          <InteractiveMobileForms />
        </div>

        <div class="mobile-screen-view" id="screen-live-navbar">
          <InteractiveMobileNavbar />
        </div>

      </div>

      <!-- Provenance Section (Matching web-style) -->
      <section class="provenance-section">
        <div class="provenance-grid">
          <div>
            <b>Android Compose Contract</b>
            <p>Módulo <code>:core:designsystem</code> con <code>NexaTheme</code>, Material 3, ViewModels UDF y Navigation 3 en <code>apps/operations-android</code>.</p>
          </div>
          <div>
            <b>Pantallas Aisladas Canónicas</b>
            <p>Arquitectura de visualización 1 a 1: cada opción lateral aísla su contenido sin colisiones ni dobles scrollbars.</p>
          </div>
          <div>
            <b>Human Review Gate</b>
            <p>La dirección visual móvil, los contratos de ergonomía táctil y la evidencia de accesibilidad permanecen sujetos a validación en equipo.</p>
          </div>
        </div>
      </section>

    </main>
  </UnifiedLabShell>

</body>
</html>
