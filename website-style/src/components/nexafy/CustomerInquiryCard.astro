---
/**
 * CustomerInquiryCard Component
 * Channel Card 2: Direct Customer Inquiry message card with avatar and timestamp.
 */
interface Props {
  author?: string;
  timestamp?: string;
  message?: string;
}

const {
  author = 'John Cooper',
  timestamp = '3h',
  message = 'I want to rent 2xGoPro for 4 days, for an event.'
} = Astro.props;
---

<article class="channel-card card-email" aria-label="Direct Customer Inquiry">
  <div class="email-card-header">
    <div class="email-avatar-wrap">
      <img 
        src="/assets/synthetic/avatar-customer.svg" 
        alt={`${author} Avatar`} 
        class="email-avatar-img" 
        loading="eager"
        width="32"
        height="32"
      />
    </div>
    <div class="email-meta-info">
      <strong class="email-author-name">{author}</strong>
      <span class="email-timestamp text-mono">{timestamp}</span>
    </div>
  </div>
  <p class="email-body-text">
    Hi! <span class="wave-hand-icon" aria-hidden="true">👆</span> {message}
  </p>
</article>

<style>
  .channel-card {
    position: absolute;
    background-color: var(--stage-card);
    border-radius: 16px;
    box-shadow: none !important;
    border: none !important;
    z-index: 7;
    cursor: default;
    color: var(--stage-text);
    transition: transform 0.25s ease, background-color 0.3s ease, color 0.3s ease;
  }

  .channel-card:hover {
    transform: translateY(-2px);
  }

  .card-email {
    left: 560px;
    top: 295px;
    width: 275px;
    height: 105px;
    padding: 0.75rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .email-card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .email-avatar-wrap {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #ffffff;
  }

  .email-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .email-meta-info {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .email-author-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--stage-text);
  }

  .email-timestamp {
    font-size: 0.75rem;
    color: var(--stage-text);
    opacity: 0.75;
    font-family: 'JetBrains Mono', monospace;
  }

  .email-body-text {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--stage-text);
  }
</style>
