---
/**
 * ZonasAlcanceSection.astro
 * Canonical Thumb Zone Reachability & One-Handed Ergonomics for Android
 */
const scaffoldSnippet = `// Estructura canónica respetando Zonas de Pulgar:
@Composable
fun OperationScreen(
    onConfirmAction: () -> Unit,
    content: @Composable (PaddingValues) -> Unit
) {
    Scaffold(
        topBar = {
            // Zona Difícil: Solo título pasivo y navegación atrás
            NexaTopAppBar(title = "Orden SO-2026-0018 · ICISA")
        },
        bottomBar = {
            // Zona Natural Cómoda: Botón principal de acción fija
            Surface(
                tonalElevation = 3.dp,
                shadowElevation = 8.dp,
                modifier = Modifier.fillMaxWidth()
            ) {
                Box(modifier = Modifier.padding(16.dp)) {
                    Button(
                        onClick = onConfirmAction,
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(56.dp) // Altura industrial guantes
                    ) {
                        Text("REGISTRAR ENTREGA EN SITIO")
                    }
                }
            }
        }
    ) { innerPadding ->
        // Zona Alcanzable: Lista scrolleable
        content(innerPadding)
    }
}`;
---

<div class="zonas-alcance-container" data-platform-target="universal">
  <section class="spec-card">
    <div class="card-header-row">
      <div class="card-badge-icon"><i class="pi pi-compass"></i></div>
      <div>
        <span class="card-eyebrow">ERGONOMÍA · ALCANCE BIOMECÁNICO</span>
        <h3 class="card-title">Zonas de Alcance del Pulgar (Thumb Zones)</h3>
      </div>
    </div>
    <p class="card-text">
      En pantallas de 6.1" a 6.7" (360dp a 412dp de ancho lógico en smartphones y terminales Android), la ergonomía de una mano impone colocar las acciones primarias en la zona natural inferior para evitar fatiga en muñeca y caídas de terminales.
    </p>

    <!-- Biomechanics Diagram -->
    <div class="thumb-zone-diagram">
      <div class="zone-row zone-hard">
        <div class="zone-badge red">ZONA DIFÍCIL (Top 25%)</div>
        <div class="zone-content">
          <strong>Top App Bar, Título de Pantalla, Icono de Perfil</strong>
          <p>Ubicación solo para información pasiva o acciones poco frecuentes. Requiere dos manos.</p>
        </div>
      </div>

      <div class="zone-row zone-medium">
        <div class="zone-badge amber">ZONA ALCANZABLE (Centro 40%)</div>
        <div class="zone-content">
          <strong>Tarjetas de Lista, Formularios, Datos Informativos de la Parada</strong>
          <p>Lectura rápida, desplazamiento y selección mediante scroll con el pulgar.</p>
        </div>
      </div>

      <div class="zone-row zone-natural">
        <div class="zone-badge green">ZONA NATURAL / CÓMODA (Base 35%)</div>
        <div class="zone-content">
          <strong>Botones de Acción Primaria (CTA), Botoneras Fijas, Navegación Inferior</strong>
          <p>Objetivo primordial: el botón de acción principal ("Confirmar Entrega", "Escanear Guía") siempre anclado abajo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Biomechanical Placement Rules -->
  <section class="spec-card">
    <div class="card-header-row">
      <div class="card-badge-icon rule-badge"><i class="pi pi-check-circle"></i></div>
      <div>
        <span class="card-eyebrow">REGLAS ARQUITECTÓNICAS DE COLOCACIÓN</span>
        <h3 class="card-title">Directrices de Diseño Ergonómico en Campo</h3>
      </div>
    </div>

    <div class="rules-grid">
      <div class="rule-card">
        <i class="pi pi-arrow-down-left"></i>
        <strong>Botón Flotante / Sticky Bottom Bar</strong>
        <p>Todo flujo operativo (entrega, escaneo, checklist) debe terminar con una barra inferior fija con padding seguro contra la barra de gestos del sistema Android.</p>
      </div>

      <div class="rule-card">
        <i class="pi pi-angle-double-down"></i>
        <strong>Sheets Desplegables de Abajo hacia Arriba</strong>
        <p>Para firma digital (POD), reportes o filtros, se emplean Bottom Sheets en lugar de diálogos flotantes centrados.</p>
      </div>

      <div class="rule-card">
        <i class="pi pi-shield"></i>
        <strong>Confirmación de Destrucción Fuera de Zona Accidental</strong>
        <p>Acciones destructivas (cancelar orden, rechazar entrega completa) requieren diálogo con confirmación en dos pasos.</p>
      </div>
    </div>
  </section>

  <!-- Section 3: Scaffold Jetpack Compose Template -->
  <section class="spec-card">
    <div class="card-header-row">
      <div class="card-badge-icon code-badge"><i class="pi pi-code"></i></div>
      <div>
        <span class="card-eyebrow">PATRÓN DE SCAFFOLD · JETPACK COMPOSE</span>
        <h3 class="card-title">Estructura Ergonómica con Scaffold y BottomBar</h3>
      </div>
    </div>

    <div class="code-preview-block">
      <pre><code>{scaffoldSnippet}</code></pre>
    </div>
  </section>
</div>

<style>
  .zonas-alcance-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .spec-card {
    background: var(--nexa-surface-card, #ffffff);
    border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    border-radius: var(--nexa-radius-card, 16px);
    padding: 24px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-header-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-badge-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--nexa-color-primary-50, #eff6ff);
    color: var(--nexa-color-primary-600, #2a67d9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    flex-shrink: 0;

    &.rule-badge {
      background: #ecfdf5;
      color: #059669;
    }
    &.code-badge {
      background: #f1f5f9;
      color: #0f172a;
    }
  }

  .card-eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--nexa-color-primary-700, #1d4ed8);
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .card-title {
    font-family: var(--nexa-font-family-display, sans-serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--nexa-color-text-primary, #0f172a);
    margin: 0;
  }

  .card-text {
    font-size: 13.5px;
    color: var(--nexa-color-text-secondary, #64748b);
    line-height: 1.6;
    margin: 0;
  }

  .thumb-zone-diagram {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
  }

  .zone-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid transparent;

    &.zone-hard {
      background: #fef2f2;
      border-color: #fecaca;
    }
    &.zone-medium {
      background: #fffbeb;
      border-color: #fde68a;
    }
    &.zone-natural {
      background: #f0fdf4;
      border-color: #bbf7d0;
    }
  }

  @media (max-width: 768px) {
    .zone-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  .zone-badge {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border-radius: 6px;
    white-space: nowrap;

    &.red {
      background: #fee2e2;
      color: #991b1b;
    }
    &.amber {
      background: #fef3c7;
      color: #92400e;
    }
    &.green {
      background: #dcfce7;
      color: #166534;
    }
  }

  .zone-content {
    display: flex;
    flex-direction: column;
    gap: 2px;

    strong {
      font-size: 13px;
      color: #0f172a;
    }
    p {
      font-size: 12px;
      color: #64748b;
      margin: 0;
    }
  }

  .rules-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .rules-grid {
      grid-template-columns: 1fr;
    }
  }

  .rule-card {
    padding: 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;

    i {
      font-size: 18px;
      color: var(--nexa-color-primary-600, #2a67d9);
    }
    strong {
      font-size: 13.5px;
      color: #0f172a;
    }
    p {
      font-size: 12px;
      color: #64748b;
      margin: 0;
      line-height: 1.5;
    }
  }

  .code-preview-block {
    background: #0f172a;
    border-radius: 12px;
    padding: 18px;
    overflow-x: auto;

    pre { margin: 0; }
    code {
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 12px;
      color: #e2e8f0;
      line-height: 1.6;
    }
  }
</style>
