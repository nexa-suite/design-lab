---
/**
 * YourCompanyHub Component
 * The authentic origin root node in the living geometry system.
 */
interface Props {
  id?: string;
  labelTop?: string;
  labelBottom?: string;
}

const {
  id = 'node-origin-hub',
  labelTop = 'YOUR',
  labelBottom = 'COMPANY'
} = Astro.props;
---

<div class="node-origin-hub" id={id} role="region" aria-label="Your rental operation origin">
  <div class="hub-label">
    <span class="hub-word">{labelTop}</span>
    <span class="hub-word">{labelBottom}</span>
  </div>
</div>

<style>
  .node-origin-hub {
    position: absolute;
    left: 8px;
    top: 125px;
    width: 152px;
    height: 140px;
    background-color: var(--stage-card);
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: none !important;
    z-index: 6;
    transform-origin: center center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease;
    cursor: default;
  }

  .node-origin-hub:hover {
    transform: scale(1.03);
  }

  .hub-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.3125rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--stage-text);
    text-align: center;
    transition: color 0.3s ease;
  }

  .hub-word {
    display: block;
  }
</style>
