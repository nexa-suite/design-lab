<script>
  // Role-Aware Bottom Navigation State (Static Rendered Navbars)
  const roleButtons = document.querySelectorAll<HTMLButtonElement>('.btn-role-nav-pill');
  const roleNavbars = document.querySelectorAll<HTMLElement>('.role-bottom-nav');
  const roleTag = document.getElementById('touch-stage-role-tag');
  const screenName = document.getElementById('touch-stage-screen-name');
  const readoutRole = document.getElementById('readout-text-role');
  const readoutTab = document.getElementById('readout-tab-details');

  const roleMeta: Record<string, { tag: string; screen: string; summary: string }> = {
    conductor: {
      tag: 'CONDUCTOR EN RUTA',
      screen: 'Rutas & Despacho Activo',
      summary: 'CONDUCTOR (Diego Morales · Rutas GPS, captura de POD y eventos de entrega)',
    },
    almacen: {
      tag: 'OPERARIO ALMACÉN',
      screen: 'Picking FEFO & Racks Frigoríficos',
      summary: 'OPERARIO ALMACÉN (Alejandro Vargas · Cumplimiento FEFO, escaneo GS1 y racks frigoríficos)',
    },
    despacho: {
      tag: 'SUPERVISOR DESPACHO',
      screen: 'Bahías de Carga & Kanban Patio',
      summary: 'SUPERVISOR DESPACHO (Asignación de rampas, balance de carga de camiones y sellos)',
    },
    inspector: {
      tag: 'INSPECTOR MAQUINARIA',
      screen: 'Checklist ISO 3691 & Bitácora',
      summary: 'INSPECTOR MAQUINARIA (Inspección pre-uso ISO 3691 de montacargas y transpaletas)',
    },
    comprador: {
      tag: 'COMPRADOR B2B',
      screen: 'Catálogo Mayorista de Frío',
      summary: 'COMPRADOR B2B (Carlos Mendoza · Abastecimiento perecible y telemetría de frío)',
    },
  };

  function updateReadoutForTab(tab: HTMLElement) {
    const tabName = tab.getAttribute('data-tab-name') || '';
    const tabDesc = tab.getAttribute('data-desc') || '';
    if (screenName && tabName) screenName.textContent = tabName;
    if (readoutTab && tabName) {
      readoutTab.innerHTML = `Destino activo: <strong>${tabName.toUpperCase()}</strong> — ${tabDesc}`;
    }
  }

  function activateRole(role: string) {
    // 1. Update active pill
    roleButtons.forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-role') === role);
    });

    // 2. Hide all navbars, show active
    roleNavbars.forEach(nav => {
      if (nav.getAttribute('data-role') === role) {
        nav.style.display = 'grid';
        nav.classList.add('active-role-nav');
        // Find active tab in this navbar
        const activeTab = nav.querySelector<HTMLButtonElement>('.bottom-nav-tab.active') || nav.querySelector<HTMLButtonElement>('.bottom-nav-tab');
        if (activeTab) {
          updateReadoutForTab(activeTab);
        }
      } else {
        nav.style.display = 'none';
        nav.classList.remove('active-role-nav');
      }
    });

    const meta = roleMeta[role];
    if (meta) {
      if (roleTag) roleTag.textContent = meta.tag;
      if (readoutRole) readoutRole.textContent = meta.summary;
    }
  }

  // Bind tab click on all navbars
  roleNavbars.forEach(nav => {
    const tabs = nav.querySelectorAll<HTMLButtonElement>('.bottom-nav-tab');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        updateReadoutForTab(tab);
      });
    });
  });

  // Bind role button clicks
  roleButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const role = btn.getAttribute('data-role') || 'conductor';
      activateRole(role);
    });
  });
</script>
