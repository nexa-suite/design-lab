---
/**
 * PhysicalStoreCard Component
 * Channel Card 1: Physical Store POS channel with schematic vector and price.
 */
interface Props {
  price?: string;
  item?: string;
  channelName?: string;
}

const {
  price = '100€/Day',
  item = 'Gopro',
  channelName = 'Physical Store'
} = Astro.props;
---

<article class="channel-card card-store" aria-label="Physical Store Channel">
  <div class="card-thumb-wrap">
    <img 
      src="/assets/synthetic/store-schematic.svg" 
      alt="Physical Store Showroom POS" 
      class="card-thumb-img" 
      loading="eager"
      width="90"
      height="96"
    />
  </div>
  <div class="card-details-col">
    <p class="card-sub-label">{item} available</p>
    <p class="card-sub-label">for renting at</p>
    <p class="card-sub-label"><strong class="channel-bold">{channelName}</strong></p>
    <span class="card-price-value text-mono">{price}</span>
  </div>
</article>

<style>
  .channel-card {
    position: absolute;
    background-color: var(--stage-card);
    border-radius: 16px;
    box-shadow: none !important;
    border: none !important;
    z-index: 7;
    cursor: default;
    color: var(--stage-text);
    transition: transform 0.25s ease, background-color 0.3s ease, color 0.3s ease;
  }

  .channel-card:hover {
    transform: translateY(-2px);
  }

  .card-store {
    left: 208px;
    top: 289px;
    width: 271px;
    height: 112px;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.65rem 0.85rem;
  }

  .card-thumb-wrap {
    width: 90px;
    height: 96px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-details-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
  }

  .card-sub-label {
    font-size: 0.8125rem;
    line-height: 1.25;
    color: var(--stage-text);
  }

  .channel-bold {
    font-weight: 800;
    color: var(--stage-text);
  }

  .card-price-value {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--stage-text);
    margin-top: 0.25rem;
    font-family: 'JetBrains Mono', monospace;
  }
</style>
