---
/**
 * RealtimeEscrowWidget Component
 * Interactive Escrow custody & deposit management card.
 * Enables live simulation of pre-authorized security holds, instant return inspection,
 * and automated escrow release.
 * 
 * Strict WCAG AAA Contrast on dark blue or standalone card.
 */
interface Props {
  isIsolated?: boolean;
}

const { isIsolated = false } = Astro.props;
---

<div class={`realtime-escrow-card ${isIsolated ? 'is-isolated' : ''}`} role="region" aria-label="Controlador de Custodia Escrow en Tiempo Real">
  <div class="escrow-header">
    <div class="escrow-shield-badge">
      <i class="pi pi-lock"></i>
    </div>
    <div class="escrow-title-col">
      <strong class="escrow-title">Custodia Escrow en Tiempo Real</strong>
      <span class="escrow-sub">Preautorización Bancaria Automatizada</span>
    </div>
    <span class="escrow-status-pill active" id="escrow-status-badge">ACTIVO · RETENIDO</span>
  </div>

  <div class="escrow-body">
    <!-- Slider for Pre-Authorized Hold Amount -->
    <div class="escrow-slider-group">
      <div class="slider-labels-row">
        <label for="deposit-range-input" class="slider-label">Depósito en Garantía Pre-autorizado</label>
        <span class="slider-value-display text-mono" id="deposit-val-txt">€200.00</span>
      </div>
      <input 
        type="range" 
        id="deposit-range-input" 
        min="50" 
        max="1500" 
        step="50" 
        value="200" 
        class="escrow-range-slider"
        aria-label="Ajustar monto de depósito en garantía"
      />
    </div>

    <!-- Escrow Protection Metrics Grid -->
    <div class="escrow-metrics-box">
      <div class="metric-col">
        <span class="m-val text-mono" id="coverage-total-txt">€5,000.00</span>
        <span class="m-lbl">Cobertura Total Lloyd's</span>
      </div>
      <div class="metric-divider" aria-hidden="true"></div>
      <div class="metric-col">
        <span class="m-val text-mono">&lt; 120s</span>
        <span class="m-lbl">Liberación Post-Checkin</span>
      </div>
      <div class="metric-divider" aria-hidden="true"></div>
      <div class="metric-col">
        <span class="m-val text-mono">0%</span>
        <span class="m-lbl">Riesgo de Impago</span>
      </div>
    </div>

    <!-- Security Micro-Agreement Banner -->
    <div class="escrow-legal-pill">
      <i class="pi pi-verified"></i>
      <span>Contrato digital vinculante bajo estándar europeo eIDAS con token biométrico.</span>
    </div>

    <!-- Action Buttons -->
    <div class="escrow-actions-row">
      <button type="button" class="btn-escrow-action" id="btn-release-escrow">
        <i class="pi pi-check-circle"></i>
        <span>Liberar Fondos (Check-in OK)</span>
      </button>
      <button type="button" class="btn-escrow-secondary" id="btn-reset-escrow">
        <i class="pi pi-refresh"></i>
        <span>Reiniciar</span>
      </button>
    </div>
  </div>
</div>

<script>
  const rangeInput = document.getElementById('deposit-range-input') as HTMLInputElement | null;
  const depositTxt = document.getElementById('deposit-val-txt');
  const coverageTxt = document.getElementById('coverage-total-txt');
  const statusBadge = document.getElementById('escrow-status-badge');
  const releaseBtn = document.getElementById('btn-release-escrow');
  const resetBtn = document.getElementById('btn-reset-escrow');

  if (rangeInput && depositTxt && coverageTxt) {
    rangeInput.addEventListener('input', () => {
      const val = parseFloat(rangeInput.value);
      depositTxt.textContent = `€${val.toFixed(2)}`;
      // Coverage scales proportionally
      const coverage = Math.min(10000, val * 25);
      coverageTxt.textContent = `€${coverage.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    });
  }

  if (releaseBtn && statusBadge) {
    releaseBtn.addEventListener('click', () => {
      statusBadge.textContent = 'FONDOS LIBERADOS 🍾';
      statusBadge.style.background = '#38c8ff';
      statusBadge.style.color = '#082846';
    });
  }

  if (resetBtn && statusBadge && rangeInput && depositTxt && coverageTxt) {
    resetBtn.addEventListener('click', () => {
      rangeInput.value = '200';
      depositTxt.textContent = '€200.00';
      coverageTxt.textContent = '€5,000.00';
      statusBadge.textContent = 'ACTIVO · RETENIDO';
      statusBadge.style.background = 'rgba(56, 200, 255, 0.2)';
      statusBadge.style.color = '#38c8ff';
    });
  }
</script>

<style>
  .realtime-escrow-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 8px 24px rgba(8, 40, 70, 0.08);
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .realtime-escrow-card.is-isolated {
    width: 100%;
    max-width: 100%;
  }

  .escrow-header {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }

  .escrow-shield-badge {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #082846;
    color: #38c8ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }

  .escrow-title-col {
    flex: 1;
    min-width: 0;
  }

  .escrow-title {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    display: block;
    line-height: 1.2;
  }

  .escrow-sub {
    font-size: 11px;
    color: #64748b;
  }

  .escrow-status-pill {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 9.5px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 999px;
    letter-spacing: 0.03em;
    background: #e0f2fe;
    color: #0369a1;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .escrow-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .escrow-slider-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .slider-labels-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .slider-label {
    font-size: 11.5px;
    font-weight: 600;
    color: #334155;
  }

  .slider-value-display {
    font-size: 13.5px;
    font-weight: 800;
    color: #0369a1;
  }

  .escrow-range-slider {
    width: 100%;
    accent-color: #0369a1;
    cursor: pointer;
  }

  .escrow-metrics-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 10px 12px;
  }

  .metric-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
  }

  .m-val {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
  }

  .m-lbl {
    font-size: 9.5px;
    color: #64748b;
    margin-top: 2px;
  }

  .metric-divider {
    width: 1px;
    height: 28px;
    background: #cbd5e1;
  }

  .escrow-legal-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
    font-size: 10.5px;
    line-height: 1.35;
    padding: 6px 10px;
    border-radius: 8px;
  }

  .escrow-legal-pill i {
    font-size: 13px;
    color: #16a34a;
    flex-shrink: 0;
  }

  .escrow-actions-row {
    display: flex;
    gap: 8px;
  }

  .btn-escrow-action {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #082846;
    color: #38c8ff;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-escrow-action:hover {
    background: #103860;
    color: #ffffff;
  }

  .btn-escrow-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-escrow-secondary:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
</style>
