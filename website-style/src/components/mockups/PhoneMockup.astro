---
// Interactive Phone Mockup: Built 100% in HTML/CSS/SVG with 4 real interactive states
---

<div class="phone-mockup-wrapper" id="interactive-phone">
  <!-- Phone Outer Bezel -->
  <div class="phone-device">
    <!-- Top Camera / Speaker Notch -->
    <div class="phone-speaker-slot" aria-hidden="true">
      <div class="camera-lens"></div>
      <div class="speaker-grill"></div>
    </div>

    <!-- Phone Screen Content -->
    <div class="phone-screen" role="region" aria-live="polite" aria-label="Customer Rental Mobile Flow">
      <!-- Status Bar -->
      <div class="phone-status-bar" aria-hidden="true">
        <span class="status-time">9:41</span>
        <div class="status-icons">
          <svg width="14" height="10" viewBox="0 0 14 10" fill="currentColor">
            <path d="M1 7h2v3H1zM4 5h2v5H4zM7 3h2v7H7zM10 1h2v9h-2z"/>
          </svg>
          <svg width="14" height="10" viewBox="0 0 16 12" fill="currentColor">
            <path d="M8 2.5a9.8 9.8 0 0 1 6.5 2.5l-6.5 7-6.5-7A9.8 9.8 0 0 1 8 2.5z"/>
          </svg>
          <div class="battery-icon">
            <div class="battery-level"></div>
          </div>
        </div>
      </div>

      <!-- STATE 1: Lockscreen Notification -->
      <div class="phone-state-view active" id="phone-state-1" data-state="1">
        <div class="lockscreen-header">
          <div class="lock-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <div class="lock-time">09:41</div>
          <div class="lock-date">Wednesday, March 20</div>
        </div>

        <div class="notification-card" id="trigger-step-2" tabindex="0" role="button" aria-label="Open booking payment notification">
          <div class="notification-header">
            <div class="app-icon-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#004737">
                <rect width="24" height="24" rx="6" fill="#56f09f"/>
                <circle cx="12" cy="12" r="4" fill="#004737"/>
              </svg>
            </div>
            <span class="app-name">FLECTO</span>
            <span class="notification-time">now</span>
          </div>
          <div class="notification-body">
            <strong>Tap to Pay your booking of €690.00</strong>
            <p>2x GoPro HERO10 Black for John Cooper (5-day rental)</p>
          </div>
          <div class="notification-action-hint">
            <span>Tap to review</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4.5 2.5L8 6l-3.5 3.5"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- STATE 2: Biometric & ID Verification -->
      <div class="phone-state-view" id="phone-state-2" data-state="2">
        <div class="state-navbar">
          <button type="button" class="phone-back-btn" data-target="1" aria-label="Back to notification">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </button>
          <span class="state-title">ID Verification</span>
          <span class="secure-badge">Secure</span>
        </div>

        <div class="face-scan-container">
          <div class="scan-frame" aria-hidden="true">
            <div class="corner top-left"></div>
            <div class="corner top-right"></div>
            <div class="corner bottom-left"></div>
            <div class="corner bottom-right"></div>
            
            <div class="scan-laser"></div>
            
            <!-- Synthetic Biometric Silhouette -->
            <svg class="face-silhouette" width="70" height="70" viewBox="0 0 24 24" fill="none" stroke="rgba(86, 240, 159, 0.4)" stroke-width="1.5">
              <circle cx="12" cy="8" r="5"/>
              <path d="M20 21a8 8 0 1 0-16 0"/>
            </svg>
          </div>

          <div class="scan-instructions">
            <h4>Biometric Renter Check</h4>
            <p>Quick 3D verification matching John Cooper's driver license.</p>
          </div>

          <button type="button" class="phone-action-btn" id="confirm-face-scan">
            <span>Confirm & Continue</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 7l3.5 3.5L12 3"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- STATE 3: Transaction Summary & Payment -->
      <div class="phone-state-view" id="phone-state-3" data-state="3">
        <div class="state-navbar">
          <button type="button" class="phone-back-btn" data-target="2" aria-label="Back to ID verification">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </button>
          <span class="state-title">Checkout</span>
          <span class="booking-tag text-mono">#FL-88219</span>
        </div>

        <div class="order-summary-scroll">
          <div class="summary-item-card">
            <div class="item-img-placeholder" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
            </div>
            <div class="item-details">
              <strong>2x GoPro HERO10</strong>
              <span>€100.00 / day × 5 days</span>
            </div>
            <span class="item-price">€500.00</span>
          </div>

          <div class="line-items-table">
            <div class="table-row">
              <span>Security Deposit (escrow)</span>
              <span>€200.00</span>
            </div>
            <div class="table-row">
              <span>Delivery & Collection</span>
              <span>€20.00</span>
            </div>
            <div class="table-row">
              <span>Comprehensive Insurance</span>
              <span>€20.00</span>
            </div>
            <div class="table-row discount">
              <span>Multi-day Discount (10%)</span>
              <span>-€50.00</span>
            </div>
            <div class="table-row total-row">
              <strong>Total Due Today</strong>
              <strong class="total-amount">€690.00</strong>
            </div>
          </div>

          <!-- Payment Options -->
          <div class="payment-selector" role="radiogroup" aria-label="Payment method">
            <label class="pay-option active">
              <input type="radio" name="payment" value="mbway" checked />
              <span class="pay-radio-dot"></span>
              <span class="pay-name">MB Way</span>
              <span class="pay-detail text-mono">+351 911 000 111</span>
            </label>
            <label class="pay-option">
              <input type="radio" name="payment" value="card" />
              <span class="pay-radio-dot"></span>
              <span class="pay-name">Credit Card</span>
              <span class="pay-detail text-mono">•••• 4242</span>
            </label>
          </div>

          <button type="button" class="phone-action-btn primary" id="execute-payment-btn">
            <span>Pay €690.00</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2.5 7H11.5M11.5 7L7 2.5M11.5 7L7 11.5"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- STATE 4: Success & Booking Confirmation -->
      <div class="phone-state-view" id="phone-state-4" data-state="4">
        <div class="success-container">
          <div class="success-badge-icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>

          <h3>Payment Done! 🍾</h3>
          <p class="success-subtitle">Booking confirmed for John Cooper</p>

          <div class="confirmation-box">
            <div class="confirm-row">
              <span>Status</span>
              <span class="status-pill-green">Insured & Ready</span>
            </div>
            <div class="confirm-row">
              <span>Dates</span>
              <span class="text-mono">20/03 — 24/03/2022</span>
            </div>
            <div class="confirm-row">
              <span>Collection</span>
              <span>acme.store (Downtown)</span>
            </div>
          </div>

          <div class="success-actions">
            <button type="button" class="phone-action-btn" id="calendar-sync-btn">
              <span>Sync to Calendar</span>
            </button>
            <button type="button" class="phone-reset-btn" id="phone-restart-btn">
              <span>↺ Restart Demo Flow</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stepper Navigation Controller (Timeline Bar) -->
  <div class="timeline-stepper" role="tablist" aria-label="Rental Workflow Stages">
    <button type="button" role="tab" class="step-pill active" data-step="1" id="tab-step-1" aria-selected="true" aria-controls="phone-state-1">
      <span class="step-num text-mono">01</span>
      <span class="step-text">Notification</span>
    </button>
    <button type="button" role="tab" class="step-pill" data-step="2" id="tab-step-2" aria-selected="false" aria-controls="phone-state-2">
      <span class="step-num text-mono">02</span>
      <span class="step-text">Face ID</span>
    </button>
    <button type="button" role="tab" class="step-pill" data-step="3" id="tab-step-3" aria-selected="false" aria-controls="phone-state-3">
      <span class="step-num text-mono">03</span>
      <span class="step-text">Payment</span>
    </button>
    <button type="button" role="tab" class="step-pill" data-step="4" id="tab-step-4" aria-selected="false" aria-controls="phone-state-4">
      <span class="step-num text-mono">04</span>
      <span class="step-text">Success</span>
    </button>
  </div>
</div>

<style>
  .phone-mockup-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
  }

  /* Phone Outer Chassis */
  .phone-device {
    position: relative;
    width: 100%;
    height: 640px;
    background-color: var(--phone-bezel-color);
    padding: 6px;
    border-radius: 36px;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(86, 240, 159, 0.3);
    user-select: none;
  }

  .phone-speaker-slot {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 110px;
    height: 20px;
    background: #002e23;
    border-radius: 20px;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .camera-lens {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #001812;
    border: 1px solid rgba(86, 240, 159, 0.2);
  }

  .speaker-grill {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: #001812;
  }

  /* Screen Canvas */
  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--phone-screen-bg);
    border-radius: 30px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--text-primary-on-dark);
  }

  /* Status Bar */
  .phone-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 18px 4px;
    font-size: 0.75rem;
    font-weight: var(--primitive-weight-semibold);
    color: var(--primitive-color-cream-100);
    z-index: 50;
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .battery-icon {
    width: 18px;
    height: 9px;
    border: 1px solid currentColor;
    border-radius: 2px;
    padding: 1px;
    position: relative;
  }

  .battery-icon::after {
    content: '';
    position: absolute;
    right: -3px;
    top: 2px;
    width: 2px;
    height: 3px;
    background: currentColor;
    border-radius: 0 1px 1px 0;
  }

  .battery-level {
    width: 80%;
    height: 100%;
    background: var(--primitive-color-mint-500);
    border-radius: 1px;
  }

  /* State Views (Stacked Cards) */
  .phone-state-view {
    position: absolute;
    inset: 0;
    padding: 40px 18px 18px;
    display: none;
    flex-direction: column;
    background: var(--phone-screen-bg);
    overflow-y: auto;
  }

  .phone-state-view.active {
    display: flex;
    animation: fadeInScale 180ms ease forwards;
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* State 1: Lockscreen */
  #phone-state-1 {
    justify-content: space-between;
    padding-bottom: 2rem;
  }

  .lockscreen-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: 1.5rem;
  }

  .lock-icon {
    color: var(--text-muted-on-dark);
    margin-bottom: 4px;
  }

  .lock-time {
    font-size: 3.5rem;
    font-weight: var(--primitive-weight-bold);
    color: var(--primitive-color-cream-100);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .lock-date {
    font-size: 0.875rem;
    color: var(--text-secondary-on-dark);
  }

  .notification-card {
    background: rgba(3, 32, 25, 0.85);
    border: 1px solid var(--border-on-dark);
    border-radius: var(--primitive-radius-lg);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    transition: all var(--primitive-duration-fast) ease;
  }

  .notification-card:hover, .notification-card:focus-visible {
    border-color: var(--primitive-color-mint-500);
    transform: translateY(-2px);
  }

  .notification-header {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .app-name {
    font-size: 0.6875rem;
    font-weight: var(--primitive-weight-bold);
    letter-spacing: 0.06em;
    color: var(--primitive-color-mint-200);
  }

  .notification-time {
    font-size: 0.6875rem;
    color: var(--text-muted-on-dark);
    margin-left: auto;
  }

  .notification-body strong {
    display: block;
    font-size: 0.875rem;
    color: var(--primitive-color-cream-100);
    margin-bottom: 2px;
  }

  .notification-body p {
    font-size: 0.75rem;
    color: var(--text-secondary-on-dark);
    line-height: 1.35;
  }

  .notification-action-hint {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    font-size: 0.6875rem;
    color: var(--primitive-color-mint-500);
    font-weight: var(--primitive-weight-semibold);
  }

  /* Internal Nav Header for Views 2 & 3 */
  .state-navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-on-dark);
    margin-bottom: 1rem;
  }

  .phone-back-btn {
    background: none;
    border: none;
    color: var(--primitive-color-cream-100);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    transition: background var(--primitive-duration-fast) ease;
  }

  .phone-back-btn:hover {
    background: rgba(255, 251, 236, 0.1);
  }

  .state-title {
    font-size: 0.9375rem;
    font-weight: var(--primitive-weight-bold);
    color: var(--primitive-color-cream-100);
  }

  .secure-badge, .booking-tag {
    font-size: 0.6875rem;
    color: var(--primitive-color-mint-400);
    background: rgba(86, 240, 159, 0.12);
    padding: 2px 8px;
    border-radius: 12px;
  }

  /* State 2: Face Scan */
  .face-scan-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
    margin: auto 0;
  }

  .scan-frame {
    position: relative;
    width: 140px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(1, 56, 44, 0.4);
    border-radius: 20px;
    overflow: hidden;
  }

  .corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: var(--primitive-color-mint-500);
    border-style: solid;
    border-width: 0;
  }

  .corner.top-left { top: 8px; left: 8px; border-top-width: 3px; border-left-width: 3px; }
  .corner.top-right { top: 8px; right: 8px; border-top-width: 3px; border-right-width: 3px; }
  .corner.bottom-left { bottom: 8px; left: 8px; border-bottom-width: 3px; border-left-width: 3px; }
  .corner.bottom-right { bottom: 8px; right: 8px; border-bottom-width: 3px; border-right-width: 3px; }

  .scan-laser {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--primitive-color-mint-400);
    box-shadow: 0 0 10px var(--primitive-color-mint-400);
    animation: scanPulse 2s ease-in-out infinite alternate;
  }

  @keyframes scanPulse {
    0% { transform: translateY(10px); opacity: 0.3; }
    100% { transform: translateY(150px); opacity: 1; }
  }

  .scan-instructions h4 {
    font-size: 1rem;
    color: var(--primitive-color-cream-100);
    margin-bottom: 4px;
  }

  .scan-instructions p {
    font-size: 0.75rem;
    color: var(--text-secondary-on-dark);
    max-width: 220px;
    margin: 0 auto;
  }

  /* State 3: Summary & Payment */
  .order-summary-scroll {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .summary-item-card {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(1, 56, 44, 0.6);
    border: 1px solid var(--border-on-dark);
    border-radius: var(--primitive-radius-md);
    padding: 0.75rem;
  }

  .item-img-placeholder {
    width: 36px;
    height: 36px;
    border-radius: var(--primitive-radius-sm);
    background: rgba(86, 240, 159, 0.15);
    color: var(--primitive-color-mint-500);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .item-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .item-details strong {
    font-size: 0.8125rem;
    color: var(--primitive-color-cream-100);
  }

  .item-details span {
    font-size: 0.6875rem;
    color: var(--text-muted-on-dark);
  }

  .item-price {
    font-size: 0.8125rem;
    font-weight: var(--primitive-weight-bold);
    color: var(--primitive-color-mint-500);
  }

  .line-items-table {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: rgba(3, 32, 25, 0.5);
    border: 1px solid var(--border-on-dark);
    border-radius: var(--primitive-radius-md);
    padding: 0.75rem;
  }

  .table-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-secondary-on-dark);
  }

  .table-row.discount {
    color: var(--primitive-color-mint-400);
  }

  .total-row {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--border-on-dark);
    color: var(--primitive-color-cream-100);
    font-size: 0.875rem;
  }

  .total-amount {
    color: var(--primitive-color-mint-500);
  }

  /* Payment Selector */
  .payment-selector {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pay-option {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(1, 56, 44, 0.5);
    border: 1px solid var(--border-on-dark);
    border-radius: var(--primitive-radius-md);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    font-size: 0.75rem;
    transition: all var(--primitive-duration-fast) ease;
  }

  .pay-option input {
    display: none;
  }

  .pay-radio-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--text-muted-on-dark);
  }

  .pay-option.active .pay-radio-dot {
    border-color: var(--primitive-color-mint-500);
    background: var(--primitive-color-mint-500);
  }

  .pay-option.active {
    border-color: var(--primitive-color-mint-500);
    background: rgba(86, 240, 159, 0.08);
  }

  .pay-name {
    font-weight: var(--primitive-weight-semibold);
    color: var(--primitive-color-cream-100);
  }

  .pay-detail {
    margin-left: auto;
    font-size: 0.6875rem;
    color: var(--text-muted-on-dark);
  }

  /* State 4: Success View */
  .success-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    margin: auto 0;
  }

  .success-badge-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--primitive-color-mint-500);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 25px rgba(86, 240, 159, 0.4);
  }

  .success-container h3 {
    font-size: 1.5rem;
    color: var(--primitive-color-cream-100);
  }

  .success-subtitle {
    font-size: 0.8125rem;
    color: var(--text-secondary-on-dark);
    margin-top: -0.75rem;
  }

  .confirmation-box {
    width: 100%;
    background: rgba(1, 56, 44, 0.6);
    border: 1px solid var(--border-on-dark);
    border-radius: var(--primitive-radius-md);
    padding: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
