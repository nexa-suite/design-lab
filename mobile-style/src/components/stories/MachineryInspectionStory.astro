---
/**
 * MachineryInspectionStory.astro
 * Canonical Mobile Specification for Cold-Storage Electric Forklift Pre-Operational Inspection
 * Blueprint Traceability: MOB-US-070..085 (MOBILE-EPIC-05 & 10)
 * Equipment: Montacargas Eléctrico Crown FC 5200 (ID: MT-042) · Almacén Frigorífico Central
 * Operator: Carlos Mendoza · Jefe de Patio Almacén / Operador Certificado Frío
 * Architecture: Web-Style Canonical Cuadros for Android Jetpack Compose & Kotlin
 */
---

<div class="story-screen-container" id="story-inspeccion">
  
  <!-- Web-Style Documentation Heading (Section Index + Kicker + Display H2 + Intro) -->
  <header class="section-heading-block">
    <div class="section-heading">
      <span class="section-index">04</span>
      <div>
        <p class="section-kicker">PRE-OPERATIONAL INSPECTION · BLUEPRINT MOB-US-070..085</p>
        <h2>Checklist Pre-operacional de Maquinaria Frigorífica (Montacargas Crown MT-042)</h2>
        <p class="section-intro">
          Diseño nativo en <strong>Android Jetpack Compose</strong> para la inspección obligatoria de inicio de turno en cámaras frigoríficas (-20°C). Proporciona objetivos táctiles de 56dp operables con guantes de frío extremo, selector trifásico ágil (<code>OK</code> / <code>ALERTA</code> / <code>CRÍTICO</code>), disparo automático del visor CameraX con linterna integrada para documentar fisuras en componentes críticos y bloqueo de encendido por software.
        </p>
      </div>
    </div>

    <!-- Quick Meta Chips -->
    <div class="heading-meta-chips">
      <span class="cuadro-tag primary"><i class="pi pi-wrench" aria-hidden="true"></i> Crown FC 5200 (ID: MT-042)</span>
      <span class="cuadro-tag"><i class="pi pi-building" aria-hidden="true"></i> Almacén Frigorífico Central</span>
      <span class="cuadro-tag primary"><i class="pi pi-snowflake" aria-hidden="true"></i> Cabina Climatizada (-20°C Sub-Zero)</span>
      <span class="cuadro-tag success"><i class="pi pi-shield" aria-hidden="true"></i> Protocolo OSHA / NTP 434</span>
    </div>
  </header>

  <!-- Master Documentation Cuadros Container -->
  <div class="cuadro-container">

    <!-- ====================================================================
         CUADRO 1: DOMAIN ENTITY & ARCHITECTURAL CONTRACTS
         ==================================================================== -->
    <section class="cuadro-card">
      <header class="cuadro-header">
        <div class="cuadro-header-left">
          <span class="cuadro-num-badge">C1</span>
          <div>
            <p class="cuadro-kicker">CONTRATOS DE DOMINIO & SEGURIDAD INDUSTRIAL</p>
            <h3 class="cuadro-title">Entidades de Inspección, Esquema Room DB e Interbloqueo de Encendido</h3>
            <p class="cuadro-subtitle">
              Modelo relacional de seguridad ocupacional con bloqueo estricto de maquinaria ante hallazgos críticos.
            </p>
          </div>
        </div>
        <div class="cuadro-tags">
          <span class="cuadro-tag primary"><i class="pi pi-database"></i> Room 2.6.1</span>
          <span class="cuadro-tag success"><i class="pi pi-lock"></i> Ignition Interlock</span>
          <span class="cuadro-tag kotlin"><i class="pi pi-code"></i> OSHA NTP 434</span>
        </div>
      </header>

      <!-- Table: Domain Properties & Schema -->
      <div class="contract-table-wrapper">
        <table class="contract-table">
          <thead>
            <tr>
              <th>Campo Dominio</th>
              <th>Tipo Kotlin</th>
              <th>Columna SQLite / Room</th>
              <th>Reglas de Validación & Restricciones</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>inspectionId</strong></td>
              <td><span class="mono-type">UUID</span></td>
              <td><span class="mono-chip">inspection_id TEXT PRIMARY KEY</span></td>
              <td><span class="rule-chip">Identificador único inmutable de la inspección pre-turno</span></td>
            </tr>
            <tr>
              <td><strong>equipmentId</strong></td>
              <td><span class="mono-type">String</span></td>
              <td><span class="mono-chip">machinery_code TEXT NOT NULL</span></td>
              <td><span class="rule-chip">Crown FC 5200 (ID <code>MT-042</code>)</span></td>
            </tr>
            <tr>
              <td><strong>batteryChargeLevel</strong></td>
              <td><span class="mono-type">Int</span></td>
              <td><span class="mono-chip">battery_pct INTEGER NOT NULL</span></td>
              <td><span class="rule-chip">Mínimo 20% para iniciar turno; temperatura celdas &gt; 12°C</span></td>
            </tr>
            <tr>
              <td><strong>arcticHydraulicsState</strong></td>
              <td><span class="mono-type">CheckState</span></td>
              <td><span class="mono-chip">hydraulic_state TEXT NOT NULL</span></td>
              <td><span class="rule-chip"><code>OK</code> | <code>WARNING</code> | <code>CRITICAL</code> (fuga en vástago = crítico)</span></td>
            </tr>
            <tr>
              <td><strong>coldPackageSeals</strong></td>
              <td><span class="mono-type">CheckState</span></td>
              <td><span class="mono-chip">cold_pack_state TEXT NOT NULL</span></td>
              <td><span class="rule-chip">Sellos de cabina térmica y limpiaparabrisas calefaccionado</span></td>
            </tr>
            <tr>
              <td><strong>defectPhotoUri</strong></td>
              <td><span class="mono-type">Uri?</span></td>
              <td><span class="mono-chip">defect_photo_uri TEXT</span></td>
              <td><span class="rule-chip">Obligatorio si cualquier punto es <code>WARNING</code> o <code>CRITICAL</code></span></td>
            </tr>
            <tr>
              <td><strong>ignitionLockout</strong></td>
              <td><span class="mono-type">Boolean</span></td>
              <td><span class="mono-chip">is_locked INTEGER NOT NULL</span></td>
              <td><span class="rule-chip"><code>true</code> si existe un solo ítem crítico; desactiva relay BLE de arranque</span></td>
            </tr>
            <tr>
              <td><strong>operatorSignature</strong></td>
              <td><span class="mono-type">String</span></td>
              <td><span class="mono-chip">signature_digest TEXT NOT NULL</span></td>
              <td><span class="rule-chip">Firma digital de Carlos Mendoza con hash criptográfico SHA-256</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- State Machine Flow -->
      <div>
        <p class="cuadro-kicker">MÁQUINA DE ESTADOS FORMAL (INSPECCIÓN & BLOQUEO)</p>
        <div class="state-machine-container">
          <div class="state-step-node">
            <strong>PRE_SHIFT</strong>
            <small>Equipo MT-042 escaneado</small>
          </div>
          <i class="pi pi-arrow-right state-arrow"></i>
          <div class="state-step-node active">
            <strong>CHECKLIST</strong>
            <small>5 puntos evaluados</small>
          </div>
          <i class="pi pi-arrow-right state-arrow"></i>
          <div class="state-step-node">
            <strong>EVIDENCE_PHOTO</strong>
            <small>CameraX con linterna</small>
          </div>
          <i class="pi pi-arrow-right state-arrow"></i>
          <div class="state-step-node">
            <strong>SIGNATURE</strong>
            <small>Firma digital del operador</small>
          </div>
          <i class="pi pi-arrow-right state-arrow"></i>
          <div class="state-step-node">
            <strong>LOCK_DECISION</strong>
            <small>Habilitado / Inmovilizado</small>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         CUADRO 2: COMPOSE UI COMPONENT & ERGONOMICS SPECIFICATION
         ==================================================================== -->
    <section class="cuadro-card">
      <header class="cuadro-header">
        <div class="cuadro-header-left">
          <span class="cuadro-num-badge">C2</span>
          <div>
            <p class="cuadro-kicker">ESPECIFICACIÓN DE COMPONENTES COMPOSE & ERGONOMÍA CRIO-TÉRMICA</p>
            <h3 class="cuadro-title">Selectores Trifásicos 56dp, Banners de Alerta e Interfaz de Cabina</h3>
            <p class="cuadro-subtitle">
              Píldoras táctiles agrandadas de 56dp con separación de 8dp diseñadas para manipulación con manoplas de congelador.
            </p>
          </div>
        </div>
        <div class="cuadro-tags">
          <span class="cuadro-tag primary"><i class="pi pi-sliders-h"></i> 56dp Tri-State Pills</span>
          <span class="cuadro-tag success"><i class="pi pi-lock"></i> Lockout Banner</span>
          <span class="cuadro-tag"><i class="pi pi-eye"></i> Contrast Ratio &gt; 7:1</span>
        </div>
      </header>

      <div class="spec-grid-2">
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-check-square"></i> Píldora Trifásica de Estado (56dp)</div>
          <p class="spec-kv-body">
            <code>TriStatePill56dp()</code> con tres opciones mutuamente excluyentes (<code>OK</code> en verde, <code>ALERTA</code> en ámbar y <code>CRÍTICO</code> en rojo carmesí). Cada píldora mide <strong>56dp de alto por 84dp de ancho</strong>.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-shield"></i> Banner de Interbloqueo de Encendido</div>
          <p class="spec-kv-body">
            <code>IgnitionLockoutBanner()</code> dinámico: si se detecta cualquier falla crítica (ej: fuga hidráulica), la interfaz pasa a modo bloqueo rojo intenso deshabilitando el arranque electrónico del montacargas.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-camera"></i> Visor CameraX con Disparo de Linterna</div>
          <p class="spec-kv-body">
            Al seleccionar <code>ALERTA</code> o <code>CRÍTICO</code>, se despliega automáticamente el visor óptico CameraX activando la antorcha LED trasera (<code>TorchState.ON</code>) para iluminar mástiles y pistones oscuros.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-pencil"></i> Panel de Certificación de Seguridad</div>
          <p class="spec-kv-body">
            Lienzo de firma que estampa la hora exacta UTC y el identificador de usuario certificado ante normativas OSHA y NTP 434 para auditorías de seguridad ocupacional.
          </p>
        </div>
      </div>

      <!-- Mapping Table of Material 3 Tokens -->
      <div class="contract-table-wrapper">
        <table class="contract-table">
          <thead>
            <tr>
              <th>Estado de Inspección</th>
              <th>Tone Token Web</th>
              <th>Compose Color Token</th>
              <th>Comportamiento en Montacargas</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>OK (Conforme)</code></td>
              <td><code>tone-success</code></td>
              <td><span class="mono-chip">Color(0xFF15803D)</span></td>
              <td>Componente operativo sin desgaste; permite encendido</td>
            </tr>
            <tr>
              <td><code>ALERTA (Observación)</code></td>
              <td><code>tone-warning</code></td>
              <td><span class="mono-chip">Color(0xFFD97706)</span></td>
              <td>Desgaste preventivo; requiere foto y alerta a mantenimiento</td>
            </tr>
            <tr>
              <td><code>CRÍTICO (Inmovilizado)</code></td>
              <td><code>tone-danger</code></td>
              <td><span class="mono-chip">Color(0xFFDC2626)</span></td>
              <td>Riesgo de accidente; bloquea relé de encendido por BLE</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ====================================================================
         CUADRO 3: HARDWARE & OFFLINE RESILIENCE CONTRACT
         ==================================================================== -->
    <section class="cuadro-card">
      <header class="cuadro-header">
        <div class="cuadro-header-left">
          <span class="cuadro-num-badge">C3</span>
          <div>
            <p class="cuadro-kicker">CONTRATO DE HARDWARE & RELAY BLE DE IGNICIÓN</p>
            <h3 class="cuadro-title">Antorcha CameraX, Bloqueo de Encendido BLE y Sello Criptográfico</h3>
            <p class="cuadro-subtitle">
              Interacción directa con la ECU del montacargas mediante Bluetooth Low Energy y almacenamiento blindado en Room DB.
            </p>
          </div>
        </div>
        <div class="cuadro-tags">
          <span class="cuadro-tag primary"><i class="pi pi-camera"></i> CameraX Torch</span>
          <span class="cuadro-tag success"><i class="pi pi-bolt"></i> BLE Ignition Relay</span>
          <span class="cuadro-tag warning"><i class="pi pi-shield"></i> Expedited WorkRequest</span>
        </div>
      </header>

      <div class="spec-grid-3">
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-bolt"></i> Relé de Arranque BLE</div>
          <p class="spec-kv-body">
            La app envía un comando característico BLE (<code>GATT Service 0x1815</code>) a la ECU del Crown FC 5200. Si la inspección no está aprobada y firmada, el motor de tracción y la bomba hidráulica permanecen inhabilitados.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-sun"></i> Control de Linterna en Frío</div>
          <p class="spec-kv-body">
            En cámaras sin iluminación cenital directa, el visor CameraX activa automáticamente el flash en modo antorcha con <code>cameraControl.enableTorch(true)</code> para capturar fotos nítidas sin desenfoque por temblor de manos.
          </p>
        </div>
        <div class="spec-kv-card">
          <div class="spec-kv-header"><i class="pi pi-sync"></i> Envío Acelerado de Seguridad</div>
          <p class="spec-kv-body">
            Las inspecciones con estado <code>CRITICAL</code> se transmiten con un <code>OneTimeWorkRequest</code> configurado como <code>setExpedited(OutOfQuotaPolicy.RUN_AS_NON_EXPEDITED_WORK_REQUEST)</code> para alertar de inmediato al jefe de mantenimiento.
          </p>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         CUADRO 4: FULL PRODUCTION KOTLIN & JETPACK COMPOSE CODE
         ==================================================================== -->
    <section class="cuadro-card">
      <header class="cuadro-header">
        <div class="cuadro-header-left">
          <span class="cuadro-num-badge">C4</span>
          <div>
            <p class="cuadro-kicker">CÓDIGO DE PRODUCCIÓN KOTLIN 2.4 · JETPACK COMPOSE</p>
            <h3 class="cuadro-title">Implementación Completa: ViewModel, Píldoras 56dp, Bloqueo y Screen</h3>
            <p class="cuadro-subtitle">
              Código fuente completo listo para producción en el módulo <code>:feature:inspection</code> de Nexa Android.
            </p>
          </div>
        </div>
        <div class="cuadro-tags">
          <span class="cuadro-tag kotlin"><i class="pi pi-code"></i> Production Ready</span>
          <span class="cuadro-tag primary"><i class="pi pi-check"></i> UDF Pattern</span>
        </div>
      </header>

      <div class="code-container-block">
        <div class="code-header-bar">
          <div class="code-header-title">
            <i class="pi pi-file" aria-hidden="true"></i>
            <span>MachineryInspectionScreen.kt — Nexa Operations Android</span>
          </div>
          <span class="code-lang-pill">Kotlin 2.4 / Compose M3</span>
        </div>
        <pre class="code-pre-box" is:raw><code><span class="kw">package</span> com.nexa.operations.machinery.presentation

<span class="kw">import</span> androidx.compose.animation.*
<span class="kw">import</span> androidx.compose.foundation.BorderStroke
<span class="kw">import</span> androidx.compose.foundation.background
<span class="kw">import</span> androidx.compose.foundation.layout.*
<span class="kw">import</span> androidx.compose.foundation.lazy.LazyColumn
<span class="kw">import</span> androidx.compose.foundation.lazy.items
<span class="kw">import</span> androidx.compose.foundation.shape.RoundedCornerShape
<span class="kw">import</span> androidx.compose.material.icons.Icons
<span class="kw">import</span> androidx.compose.material.icons.filled.CameraAlt
<span class="kw">import</span> androidx.compose.material.icons.filled.Check
<span class="kw">import</span> androidx.compose.material.icons.filled.Warning
<span class="kw">import</span> androidx.compose.material.icons.filled.Close
<span class="kw">import</span> androidx.compose.material3.*
<span class="kw">import</span> androidx.compose.runtime.*
<span class="kw">import</span> androidx.compose.ui.Alignment
<span class="kw">import</span> androidx.compose.ui.Modifier
<span class="kw">import</span> androidx.compose.ui.graphics.Color
<span class="kw">import</span> androidx.compose.ui.text.font.FontWeight
<span class="kw">import</span> androidx.compose.ui.unit.dp
<span class="kw">import</span> androidx.compose.ui.unit.sp
<span class="kw">import</span> androidx.lifecycle.ViewModel
<span class="kw">import</span> androidx.lifecycle.viewModelScope
<span class="kw">import</span> kotlinx.coroutines.flow.MutableStateFlow
<span class="kw">import</span> kotlinx.coroutines.flow.StateFlow
<span class="kw">import</span> kotlinx.coroutines.flow.asStateFlow
<span class="kw">import</span> kotlinx.coroutines.launch

<span class="comm">// 1. Models & Sealed State</span>
<span class="kw">enum class</span> <span class="type">InspectionState</span> &#123; OK, WARNING, CRITICAL &#125;

<span class="kw">data class</span> <span class="type">CheckItem</span>(
    <span class="kw">val</span> id: <span class="type">Int</span>,
    <span class="kw">val</span> title: <span class="type">String</span>,
    <span class="kw">val</span> description: <span class="type">String</span>,
    <span class="kw">val</span> state: <span class="type">InspectionState</span> = <span class="type">InspectionState</span>.OK,
    <span class="kw">val</span> photoAttached: <span class="type">Boolean</span> = <span class="kw">false</span>
)

<span class="kw">sealed interface</span> <span class="type">InspectionUiState</span> &#123;
    <span class="kw">data object</span> <span class="type">Loading</span> : <span class="type">InspectionUiState</span>
    <span class="kw">data class</span> <span class="type">Active</span>(
        <span class="kw">val</span> machineryId: <span class="type">String</span> = <span class="str">"MT-042"</span>,
        <span class="kw">val</span> modelName: <span class="type">String</span> = <span class="str">"Crown FC 5200 (Almacén Frigorífico Central)"</span>,
        <span class="kw">val</span> batteryPct: <span class="type">Int</span> = <span class="num">94</span>,
        <span class="kw">val</span> items: <span class="type">List</span>&lt;<span class="type">CheckItem</span>&gt; = listOf(
            <span class="type">CheckItem</span>(<span class="num">1</span>, <span class="str">"1. Paquete Frío (-20°C)"</span>, <span class="str">"Sellos de cabina térmica y limpiaparabrisas térmico"</span>, <span class="type">InspectionState</span>.OK),
            <span class="type">CheckItem</span>(<span class="num">2</span>, <span class="str">"2. Batería Litio & Precalentador"</span>, <span class="str">"Carga 94%, temp celdas &gt; 12°C con precalentador activo"</span>, <span class="type">InspectionState</span>.OK),
            <span class="type">CheckItem</span>(<span class="num">3</span>, <span class="str">"3. Hidráulica Grado Ártico"</span>, <span class="str">"Fluido ISO VG 15 ártico sin fugas en vástago de mástil"</span>, <span class="type">InspectionState</span>.OK),
            <span class="type">CheckItem</span>(<span class="num">4</span>, <span class="str">"4. Frenos & Alarma Retroceso"</span>, <span class="str">"Sirena 105 dB y luz estroboscópica azul operativa"</span>, <span class="type">InspectionState</span>.OK),
            <span class="type">CheckItem</span>(<span class="num">5</span>, <span class="str">"5. Horquillas & Cadenas"</span>, <span class="str">"Sin fisuras por fatiga térmica; desgaste de talón &lt; 10%"</span>, <span class="type">InspectionState</span>.OK)
        ),
        <span class="kw">val</span> isIgnitionLocked: <span class="type">Boolean</span> = <span class="kw">false</span>,
        <span class="kw">val</span> isSignedAndApproved: <span class="type">Boolean</span> = <span class="kw">false</span>
    ) : <span class="type">InspectionUiState</span>
&#125;

<span class="comm">// 2. Production ViewModel</span>
<span class="kw">class</span> <span class="type">MachineryInspectionViewModel</span> : <span class="type">ViewModel</span>() &#123;
    <span class="kw">private val</span> _uiState = <span class="type">MutableStateFlow</span>&lt;<span class="type">InspectionUiState</span>&gt;(<span class="type">InspectionUiState</span>.<span class="type">Active</span>())
    <span class="kw">val</span> uiState: <span class="type">StateFlow</span>&lt;<span class="type">InspectionUiState</span>&gt; = _uiState.asStateFlow()

    <span class="kw">fun</span> <span class="fn">updateItemState</span>(itemId: <span class="type">Int</span>, newState: <span class="type">InspectionState</span>) &#123;
        <span class="kw">val</span> current = _uiState.value <span class="kw">as?</span> <span class="type">InspectionUiState</span>.<span class="type">Active</span> ?: <span class="kw">return</span>
        <span class="kw">val</span> updatedList = current.items.map &#123; item -&gt;
            <span class="kw">if</span> (item.id == itemId) item.copy(state = newState) <span class="kw">else</span> item
        &#125;
        <span class="kw">val</span> hasCritical = updatedList.any &#123; it.state == <span class="type">InspectionState</span>.CRITICAL &#125;
        _uiState.value = current.copy(items = updatedList, isIgnitionLocked = hasCritical)
    &#125;

    <span class="kw">fun</span> <span class="fn">signAndAuthorize</span>() &#123;
        viewModelScope.launch &#123;
            <span class="kw">val</span> current = _uiState.value <span class="kw">as?</span> <span class="type">InspectionUiState</span>.<span class="type">Active</span> ?: <span class="kw">return@launch</span>
            <span class="kw">if</span> (!current.isIgnitionLocked) &#123;
                <span class="comm">// Send BLE Ignition Unlock Command</span>
                _uiState.value = current.copy(isSignedAndApproved = <span class="kw">true</span>)
            &#125;
        &#125;
    &#125;
&#125;

<span class="comm">// 3. Master Screen Composable</span>
<span class="ann">@OptIn</span>(<span class="type">ExperimentalMaterial3Api</span>::<span class="kw">class</span>)
<span class="ann">@Composable</span>
<span class="kw">fun</span> <span class="fn">MachineryInspectionScreen</span>(
    viewModel: <span class="type">MachineryInspectionViewModel</span> = androidx.lifecycle.viewmodel.compose.viewModel(),
    modifier: <span class="type">Modifier</span> = <span class="type">Modifier</span>
) &#123;
    <span class="kw">val</span> state <span class="kw">by</span> viewModel.uiState.collectAsState()

    <span class="kw">when</span> (<span class="kw">val</span> s = state) &#123;
        <span class="kw">is</span> <span class="type">InspectionUiState</span>.<span class="type">Loading</span> -&gt; &#123;
            <span class="type">Box</span>(modifier.fillMaxSize(), contentAlignment = <span class="type">Alignment</span>.Center) &#123;
                <span class="type">CircularProgressIndicator</span>()
            &#125;
        &#125;
        <span class="kw">is</span> <span class="type">InspectionUiState</span>.<span class="type">Active</span> -&gt; &#123;
            <span class="type">Scaffold</span>(
                topBar = &#123;
                    <span class="type">TopAppBar</span>(
                        title = &#123; <span class="type">Text</span>(<span class="str">"Pre-operacional &#36;&#123;s.machineryId&#125;"</span>, fontWeight = <span class="type">FontWeight</span>.Bold) &#125;,
                        colors = <span class="type">TopAppBarDefaults</span>.topAppBarColors(
                            containerColor = <span class="type">MaterialTheme</span>.colorScheme.surface
                        )
                    )
                &#125;
            ) &#123; paddingValues -&gt;
                <span class="type">LazyColumn</span>(
                    modifier = <span class="type">Modifier</span>
                        .fillMaxSize()
                        .padding(paddingValues)
                        .padding(horizontal = <span class="num">16</span>.dp, vertical = <span class="num">12</span>.dp),
                    verticalArrangement = <span class="type">Arrangement</span>.spacedBy(<span class="num">14</span>.dp)
                ) &#123;
                    item &#123;
                        <span class="comm">// Machine Identity & Battery Card</span>
                        <span class="type">ElevatedCard</span>(
                            shape = <span class="type">RoundedCornerShape</span>(<span class="num">16</span>.dp),
                            modifier = <span class="type">Modifier</span>.fillMaxWidth()
                        ) &#123;
                            <span class="type">Column</span>(modifier = <span class="type">Modifier</span>.padding(<span class="num">16</span>.dp)) &#123;
                                <span class="type">Row</span>(
                                    modifier = <span class="type">Modifier</span>.fillMaxWidth(),
                                    horizontalArrangement = <span class="type">Arrangement</span>.SpaceBetween
                                ) &#123;
                                    <span class="type">Text</span>(s.machineryId, fontWeight = <span class="type">FontWeight</span>.ExtraBold, fontSize = <span class="num">20</span>.sp, color = <span class="type">MaterialTheme</span>.colorScheme.primary)
                                    <span class="type">SuggestionChip</span>(onClick = &#123;&#125;, label = &#123; <span class="type">Text</span>(<span class="str">"Batería &#36;&#123;s.batteryPct&#125;%"</span>) &#125;)
                                &#125;
                                <span class="type">Text</span>(s.modelName, color = <span class="type">MaterialTheme</span>.colorScheme.onSurfaceVariant, fontSize = <span class="num">13</span>.sp)
                            &#125;
                        &#125;
                    &#125;

                    item &#123;
                        <span class="comm">// Ignition Lockout Status Banner</span>
                        <span class="type">Surface</span>(
                            shape = <span class="type">RoundedCornerShape</span>(<span class="num">12</span>.dp),
                            color = <span class="kw">if</span> (s.isIgnitionLocked) <span class="type">Color</span>(<span class="num">0xFFFEF2F2</span>) <span class="kw">else</span> <span class="type">Color</span>(<span class="num">0xFFF0FDF4</span>),
                            border = <span class="type">BorderStroke</span>(<span class="num">1</span>.dp, <span class="kw">if</span> (s.isIgnitionLocked) <span class="type">Color</span>(<span class="num">0xFFFECACA</span>) <span class="kw">else</span> <span class="type">Color</span>(<span class="num">0xFFBBF7D0</span>)),
                            modifier = <span class="type">Modifier</span>.fillMaxWidth()
                        ) &#123;
                            <span class="type">Row</span>(
                                modifier = <span class="type">Modifier</span>.padding(<span class="num">14</span>.dp),
                                verticalAlignment = <span class="type">Alignment</span>.CenterVertically,
                                horizontalArrangement = <span class="type">Arrangement</span>.spacedBy(<span class="num">12</span>.dp)
                            ) &#123;
                                <span class="type">Icon</span>(
                                    imageVector = <span class="kw">if</span> (s.isIgnitionLocked) <span class="type">Icons</span>.Default.<span class="type">Close</span> <span class="kw">else</span> <span class="type">Icons</span>.Default.<span class="type">Check</span>,
                                    contentDescription = <span class="kw">null</span>,
                                    tint = <span class="kw">if</span> (s.isIgnitionLocked) <span class="type">Color</span>(<span class="num">0xFFDC2626</span>) <span class="kw">else</span> <span class="type">Color</span>(<span class="num">0xFF15803D</span>)
                                )
                                <span class="type">Column</span> &#123;
                                    <span class="type">Text</span>(
                                        <span class="kw">if</span> (s.isIgnitionLocked) <span class="str">"ENCENDIDO BLOQUEADO (FALLA CRÍTICA)"</span> <span class="kw">else</span> <span class="str">"RELÉ DE ARRANQUE LISTO PARA ACTIVACIÓN"</span>,
                                        fontWeight = <span class="type">FontWeight</span>.Bold,
                                        fontSize = <span class="num">12</span>.sp,
                                        color = <span class="kw">if</span> (s.isIgnitionLocked) <span class="type">Color</span>(<span class="num">0xFF991B1B</span>) <span class="kw">else</span> <span class="type">Color</span>(<span class="num">0xFF14532D</span>)
                                    )
                                    <span class="type">Text</span>(
                                        <span class="kw">if</span> (s.isIgnitionLocked) <span class="str">"Inmovilizado por seguridad hasta subsanación física"</span> <span class="kw">else</span> <span class="str">"Complete los 5 puntos y firme para habilitar montacargas"</span>,
                                        fontSize = <span class="num">11</span>.sp,
                                        color = <span class="type">Color</span>.<span class="type">DarkGray</span>
                                    )
                                &#125;
                            &#125;
                        &#125;
                    &#125;

                    <span class="comm">// Checklist Items with 56dp Tri-State Pills</span>
                    items(s.items) &#123; item -&gt;
                        <span class="type">ElevatedCard</span>(
                            shape = <span class="type">RoundedCornerShape</span>(<span class="num">14</span>.dp),
                            modifier = <span class="type">Modifier</span>.fillMaxWidth()
                        ) &#123;
                            <span class="type">Column</span>(modifier = <span class="type">Modifier</span>.padding(<span class="num">14</span>.dp)) &#123;
                                <span class="type">Text</span>(item.title, fontWeight = <span class="type">FontWeight</span>.Bold, fontSize = <span class="num">15</span>.sp)
                                <span class="type">Text</span>(item.description, fontSize = <span class="num">12</span>.sp, color = <span class="type">MaterialTheme</span>.colorScheme.onSurfaceVariant)
                                
                                <span class="type">Spacer</span>(<span class="type">Modifier</span>.height(<span class="num">12</span>.dp))

                                <span class="comm">// 56dp Tri-State Button Group</span>
                                <span class="type">TriStatePillGroup56dp</span>(
                                    selected = item.state,
                                    onSelect = &#123; viewModel.updateItemState(item.id, it) &#125;
                                )
                            &#125;
                        &#125;
                    &#125;

                    item &#123;
                        <span class="comm">// Master Authorize Button (56dp min target)</span>
                        <span class="type">Button</span>(
                            onClick = &#123; viewModel.signAndAuthorize() &#125;,
                            modifier = <span class="type">Modifier</span>.fillMaxWidth().heightIn(min = <span class="num">56</span>.dp),
                            shape = <span class="type">RoundedCornerShape</span>(<span class="num">12</span>.dp),
                            enabled = !s.isIgnitionLocked && !s.isSignedAndApproved
                        ) &#123;
                            <span class="type">Text</span>(
                                <span class="kw">if</span> (s.isSignedAndApproved) <span class="str">"Montacargas Habilitado · Firma OK"</span> <span class="kw">else</span> <span class="str">"Firmar Checklist y Habilitar Encendido"</span>,
                                fontSize = <span class="num">15</span>.sp,
                                fontWeight = <span class="type">FontWeight</span>.Bold
                            )
                        &#125;
                    &#125;
                &#125;
            &#125;
        &#125;
    &#125;
&#125;

<span class="comm">// 4. 56dp Tri-State Pill Group Component</span>
<span class="ann">@Composable</span>
<span class="kw">fun</span> <span class="fn">TriStatePillGroup56dp</span>(
    selected: <span class="type">InspectionState</span>,
    onSelect: (<span class="type">InspectionState</span>) -&gt; <span class="type">Unit</span>,
    modifier: <span class="type">Modifier</span> = <span class="type">Modifier</span>
) &#123;
    <span class="type">Row</span>(
        modifier = modifier.fillMaxWidth(),
        horizontalArrangement = <span class="type">Arrangement</span>.spacedBy(<span class="num">8</span>.dp)
    ) &#123;
        <span class="comm">// OK Button</span>
        <span class="type">FilledTonalButton</span>(
            onClick = &#123; onSelect(<span class="type">InspectionState</span>.OK) &#125;,
            modifier = <span class="type">Modifier</span>.weight(<span class="num">1f</span>).heightIn(min = <span class="num">56</span>.dp),
            colors = <span class="type">ButtonDefaults</span>.filledTonalButtonColors(
                containerColor = <span class="kw">if</span> (selected == <span class="type">InspectionState</span>.OK) <span class="type">Color</span>(<span class="num">0xFFF0FDF4</span>) <span class="kw">else</span> <span class="type">Color</span>(<span class="num">0xFFF1F5F9</span>)
            ),
            shape = <span class="type">RoundedCornerShape</span>(<span class="num">10</span>.dp),
            border = <span class="kw">if</span> (selected == <span class="type">InspectionState</span>.OK) <span class="type">BorderStroke</span>(<span class="num">2</span>.dp, <span class="type">Color</span>(<span class="num">0xFF15803D</span>)) <span class="kw">else</span> <span class="kw">null</span>
        ) &#123;
            <span class="type">Text</span>(<span class="str">"OK"</span>, fontWeight = <span class="type">FontWeight</span>.Bold, color = <span class="kw">if</span> (selected == <span class="type">InspectionState</span>.OK) <span class="type">Color</span>(<span class="num">0xFF15803D</span>) <span class="kw">else</span> <span class="type">Color</span>.<span class="type">DarkGray</span>)
        &#125;

        <span class="comm">// WARNING Button</span>
        <span class="type">FilledTonalButton</span>(
            onClick = &#123; onSelect(<span class="type">InspectionState</span>.WARNING) &#125;,
            modifier = <span class="type">Modifier</span>.weight(<span class="num">1f</span>).heightIn(min = <span class="num">56</span>.dp),
            colors = <span class="type">ButtonDefaults</span>.filledTonalButtonColors(
                containerColor = <span class="kw">if</span> (selected == <span class="type">InspectionState</span>.WARNING) <span class="type">Color</span>(<span class="num">0xFFFFFBEB</span>) <span class="kw">else</span> <span class="type">Color</span>(<span class="num">0xFFF1F5F9</span>)
            ),
            shape = <span class="type">RoundedCornerShape</span>(<span class="num">10</span>.dp),
            border = <span class="kw">if</span> (selected == <span class="type">InspectionState</span>.WARNING) <span class="type">BorderStroke</span>(<span class="num">2</span>.dp, <span class="type">Color</span>(<span class="num">0xFFD97706</span>)) <span class="kw">else</span> <span class="kw">null</span>
        ) &#123;
            <span class="type">Text</span>(<span class="str">"ALERTA"</span>, fontWeight = <span class="type">FontWeight</span>.Bold, color = <span class="kw">if</span> (selected == <span class="type">InspectionState</span>.WARNING) <span class="type">Color</span>(<span class="num">0xFFD97706</span>) <span class="kw">else</span> <span class="type">Color</span>.<span class="type">DarkGray</span>)
        &#125;

        <span class="comm">// CRITICAL Button</span>
        <span class="type">FilledTonalButton</span>(
            onClick = &#123; onSelect(<span class="type">InspectionState</span>.CRITICAL) &#125;,
            modifier = <span class="type">Modifier</span>.weight(<span class="num">1f</span>).heightIn(min = <span class="num">56</span>.dp),
            colors = <span class="type">ButtonDefaults</span>.filledTonalButtonColors(
                containerColor = <span class="kw">if</span> (selected == <span class="type">InspectionState</span>.CRITICAL) <span class="type">Color</span>(<span class="num">0xFFFEF2F2</span>) <span class="kw">else</span> <span class="type">Color</span>(<span class="num">0xFFF1F5F9</span>)
            ),
            shape = <span class="type">RoundedCornerShape</span>(<span class="num">10</span>.dp),
            border = <span class="kw">if</span> (selected == <span class="type">InspectionState</span>.CRITICAL) <span class="type">BorderStroke</span>(<span class="num">2</span>.dp, <span class="type">Color</span>(<span class="num">0xFFDC2626</span>)) <span class="kw">else</span> <span class="kw">null</span>
        ) &#123;
            <span class="type">Text</span>(<span class="str">"CRÍTICO"</span>, fontWeight = <span class="type">FontWeight</span>.Bold, color = <span class="kw">if</span> (selected == <span class="type">InspectionState</span>.CRITICAL) <span class="type">Color</span>(<span class="num">0xFFDC2626</span>) <span class="kw">else</span> <span class="type">Color</span>.<span class="type">DarkGray</span>)
        &#125;
    &#125;
&#125;</code></pre>
