---
/**
 * TipografiaSpSection.astro
 * Canonical Typography in Scale-Independent Pixels (sp) for Android Jetpack Compose
 * Full Material Design 3 15-Role Scale, Non-linear Font Scaling & Production Kotlin 2.4 Contracts
 */

interface TypeMatrixRow {
  role: string;
  family: string;
  size: string;
  leading: string;
  weight: string;
  cssWeight: number;
  sample: string;
  cssFamily: string;
}

const typeMatrixRows: TypeMatrixRow[] = [
  {
    role: 'displayLarge',
    family: 'Plus Jakarta Sans',
    size: '57sp',
    leading: '64sp',
    weight: 'ExtraBold (800)',
    cssWeight: 800,
    sample: '24.5 TN',
    cssFamily: 'var(--nexa-font-family-display, sans-serif)'
  },
  {
    role: 'headlineLarge',
    family: 'Plus Jakarta Sans',
    size: '32sp',
    leading: '40sp',
    weight: 'ExtraBold (800)',
    cssWeight: 800,
    sample: 'Resumen de Despacho',
    cssFamily: 'var(--nexa-font-family-display, sans-serif)'
  },
  {
    role: 'headlineSmall',
    family: 'Plus Jakarta Sans',
    size: '24sp',
    leading: '32sp',
    weight: 'Bold (700)',
    cssWeight: 700,
    sample: 'ICISA Distribuciones S.A.C.',
    cssFamily: 'var(--nexa-font-family-display, sans-serif)'
  },
  {
    role: 'titleLarge',
    family: 'Plus Jakarta Sans',
    size: '22sp',
    leading: '28sp',
    weight: 'SemiBold (600)',
    cssWeight: 600,
    sample: 'Guía de Remisión GR-00492',
    cssFamily: 'var(--nexa-font-family-display, sans-serif)'
  },
  {
    role: 'titleMedium',
    family: 'Inter',
    size: '16sp',
    leading: '24sp',
    weight: 'SemiBold (600)',
    cssWeight: 600,
    sample: 'SO-2026-0018 · Parada Muelle 3',
    cssFamily: 'var(--nexa-font-family-body, sans-serif)'
  },
  {
    role: 'bodyLarge',
    family: 'Inter',
    size: '16sp',
    leading: '24sp',
    weight: 'Regular (400)',
    cssWeight: 400,
    sample: 'Verificar sellos de seguridad antes de abrir compuerta.',
    cssFamily: 'var(--nexa-font-family-body, sans-serif)'
  },
  {
    role: 'bodyMedium',
    family: 'Inter',
    size: '14sp',
    leading: '20sp',
    weight: 'Regular (400)',
    cssWeight: 400,
    sample: 'Sensor BLE calibrado a 3.8°C (Rango seguro de frío OK).',
    cssFamily: 'var(--nexa-font-family-body, sans-serif)'
  },
  {
    role: 'bodySmall',
    family: 'Inter',
    size: '12sp',
    leading: '16sp',
    weight: 'Regular (400)',
    cssWeight: 400,
    sample: 'GPS -12.0464, -77.0428 · Timestamp 14:32:05 UTC',
    cssFamily: 'var(--nexa-font-family-body, sans-serif)'
  },
  {
    role: 'labelLarge',
    family: 'Inter',
    size: '14sp',
    leading: '20sp',
    weight: 'Bold (700)',
    cssWeight: 700,
    sample: 'CONFIRMAR ENTREGA EN SITIO',
    cssFamily: 'var(--nexa-font-family-body, sans-serif)'
  },
  {
    role: 'labelMedium',
    family: 'Inter',
    size: '12sp',
    leading: '16sp',
    weight: 'SemiBold (600)',
    cssWeight: 600,
    sample: 'EN RUTA · MUELLE 3 ACTIVO',
    cssFamily: 'var(--nexa-font-family-body, sans-serif)'
  },
  {
    role: 'labelSmall',
    family: 'Inter',
    size: '11sp',
    leading: '16sp',
    weight: 'Bold (700)',
    cssWeight: 700,
    sample: 'REFRIGERADO · FEFO OK',
    cssFamily: 'var(--nexa-font-family-body, sans-serif)'
  }
];

const contrastPairs = [
  {
    id: 'on-surface',
    label: 'Texto Principal OnSurface',
    role: 'Lectura general en Scaffold',
    foreground: '#0F172A',
    background: '#F6FAFF',
    ratio: '16.2',
    level: 'PASS AAA'
  },
  {
    id: 'on-primary',
    label: 'OnPrimary sobre Primary',
    role: 'Botones CTA & FAB 48dp',
    foreground: '#FFFFFF',
    background: '#2A67D9',
    ratio: '5.2',
    level: 'PASS AA'
  },
  {
    id: 'on-secondary',
    label: 'OnSecondary sobre Navy',
    role: 'Botón Industrial 56dp (Guantes)',
    foreground: '#FFFFFF',
    background: '#082846',
    ratio: '14.8',
    level: 'PASS AAA'
  },
  {
    id: 'on-primary-container',
    label: 'Texto en PrimaryContainer',
    role: 'Chips activos & paradas',
    foreground: '#1E40AF',
    background: '#DBEAFE',
    ratio: '8.4',
    level: 'PASS AAA'
  }
