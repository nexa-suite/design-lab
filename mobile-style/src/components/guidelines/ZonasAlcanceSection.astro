---
/**
 * ZonasAlcanceSection.astro
 * Canonical Thumb Zone Reachability & One-Handed Ergonomics for Android
 * Covers Biomechanical Reach Zones, Sticky Bottom Bars & Kotlin Scaffold Pattern
 */
---

<div class="zonas-alcance-container" data-platform-target="universal">
  <!-- Section 1: Silueta Visual de Smartphone con Zonas Biomecánicas del Pulgar -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">01</span>
        <div>
          <p class="cuadro-kicker">ERGONOMÍA MÓVIL · DISEÑO PARA UNA MANO (ONE-HANDED REACH)</p>
          <h3 class="cuadro-title">Zonas de Alcance del Pulgar (Thumb Reachability Zones)</h3>
          <p class="cuadro-subtitle">
            En terminales Android (360dp a 412dp de ancho lógico), las acciones críticas y de uso frecuente se anclan en la <strong>zona inferior (65%–100%)</strong> para permitir una operación ágil y segura sin necesidad de reajustar el agarre del dispositivo con una sola mano.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag primary"><i class="pi pi-compass"></i> Alcance 1 Mano</span>
        <span class="cuadro-tag success"><i class="pi pi-check"></i> Sticky Bottom Action</span>
        <span class="cuadro-tag neutral"><i class="pi pi-mobile"></i> Android 360–412dp</span>
      </div>
    </div>

    <!-- Visual Reach Stage: Phone Silhouette with Clean Ergonomic Ruler + Spec Cards -->
    <div class="biomechanical-stage-grid">
      <!-- High-Fidelity Phone Silhouette with Side Ergonomic Ruler -->
      <div class="phone-silhouette-wrapper">
        <div class="phone-frame">
          <div class="phone-camera-hole"></div>
          <div class="phone-speaker-grille"></div>

          <!-- Subtle Zone Bezel Indicators on the left side -->
          <div class="phone-bezel-ruler" aria-hidden="true">
            <span class="ruler-bracket r-top" title="Zona Superior (0-25%)">TOP</span>
            <span class="ruler-bracket r-mid" title="Zona Media (25-65%)">MID</span>
            <span class="ruler-bracket r-base" title="Zona Inferior (65-100%)">BASE</span>
          </div>

          <div class="phone-screen">
            <!-- 1. TOP ZONE (0% - 25% · Passive Header) -->
            <div class="screen-section-top">
              <div class="clean-mock-topbar">
                <div class="topbar-nav-back">
                  <i class="pi pi-arrow-left"></i>
                  <span class="topbar-title-text">Despacho SO-2026-0018</span>
                </div>
                <span class="topbar-status-chip">En Ruta</span>
              </div>
            </div>

            <!-- 2. MID ZONE (25% - 65% · Scrollable Content) -->
            <div class="screen-section-mid">
              <div class="clean-mock-card">
                <div class="mock-card-header">
                  <strong>ICISA Distribuciones S.A.C.</strong>
                  <span class="mock-fefo-chip">FEFO OK</span>
                </div>
                <p class="mock-card-address">Muelle 3 · Av. Argentina 1240</p>
                <div class="mock-card-temp">
                  <i class="pi pi-check"></i>
                  <span>Sensor Frío: 3.8°C (Rango Calibrado)</span>
                </div>
              </div>

              <div class="clean-mock-card secondary">
                <div class="mock-card-header">
                  <strong>Item 1: Vacunas A-24 (x40 Cajas)</strong>
                  <span class="mock-qty">Lote #982</span>
                </div>
                <p class="mock-card-address">Pallet 04 · Posición B-12</p>
              </div>
            </div>

            <!-- 3. BOTTOM ZONE (65% - 100% · Direct Thumb Action) -->
            <div class="screen-section-bottom">
              <div class="clean-mock-bottom-action">
                <button type="button" class="mock-btn-cta-industrial">
                  <i class="pi pi-truck" aria-hidden="true"></i>
                  <span>REGISTRAR ARRIBO A MUELLE (56DP)</span>
                </button>
              </div>

              <div class="clean-mock-bottom-nav">
                <div class="mock-nav-item active">
                  <i class="pi pi-compass"></i>
                  <span>Rutas</span>
                </div>
                <div class="mock-nav-item">
                  <i class="pi pi-box"></i>
                  <span>Picking</span>
                </div>
                <div class="mock-nav-item">
                  <i class="pi pi-qrcode"></i>
                  <span>Escanear</span>
                </div>
                <div class="mock-nav-item">
                  <i class="pi pi-user"></i>
                  <span>Perfil</span>
                </div>
              </div>

              <!-- Android Gesture Indicator -->
              <div class="phone-gesture-bar"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Human-Centered Ergonomics Explanation Cards -->
      <div class="biomechanical-spec-column">
        <div class="zone-spec-card red-border">
          <div class="zone-spec-header">
            <span class="zone-indicator red"></span>
            <div>
              <strong>Zona Superior (0% – 25% · Contexto y Navegación Pasiva)</strong>
              <small>Área de baja alcanzabilidad con una mano</small>
            </div>
          </div>
          <p>
            Orientada a títulos de pantalla, identificadores de documento y retroceso. No debe albergar acciones primarias obligatorias que fuercen a estirar la mano o cambiar el agarre.
          </p>
          <div class="zone-rules-list">
            <span class="rule-chip allowed"><i class="pi pi-check"></i> Permitido: Título de pantalla, botón atrás, avatar, chips de estado</span>
            <span class="rule-chip prohibited"><i class="pi pi-times"></i> Evitar: Botones de confirmación obligatorios, campos requeridos</span>
          </div>
        </div>

        <div class="zone-spec-card amber-border">
          <div class="zone-spec-header">
            <span class="zone-indicator amber"></span>
            <div>
              <strong>Zona Media (25% – 65% · Exploración y Scroll Natural)</strong>
              <small>Área óptima de lectura y desplazamiento vertical</small>
            </div>
          </div>
          <p>
            Área natural para consumo de datos. Ideal para listas verticales (<code>LazyColumn</code>), tarjetas de bultos, lecturas de telemetría y campos de formulario con desplazamiento fluido del pulgar.
          </p>
          <div class="zone-rules-list">
            <span class="rule-chip allowed"><i class="pi pi-check"></i> Permitido: LazyColumn de entregas, tarjetas de inventario, selectores</span>
            <span class="rule-chip prohibited"><i class="pi pi-times"></i> Evitar: Acciones destructivas irreversibles sin confirmación previa</span>
          </div>
        </div>

        <div class="zone-spec-card green-border">
          <div class="zone-spec-header">
            <span class="zone-indicator green"></span>
            <div>
              <strong>Zona Inferior (65% – 100% · Rango Natural de Acción Directa)</strong>
              <small>Punto de máxima ergonomía y velocidad operativa</small>
            </div>
          </div>
          <p>
            Punto de reposo inmediato del pulgar. Aquí se anclan obligatoriamente los botones de acción principal (CTA 56dp) mediante <strong>BottomBar persistente</strong> y la barra de navegación (64dp).
          </p>
          <div class="zone-rules-list">
            <span class="rule-chip allowed"><i class="pi pi-check"></i> Mandatorio: Botón Industrial 56dp, Floating Action Button (FAB), NexaBottomNav</span>
            <span class="rule-chip prohibited"><i class="pi pi-times"></i> Prohibido: Botones críticos solapados por la barra de navegación del sistema</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Matriz de Ubicación por Zona -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">02</span>
        <div>
          <p class="cuadro-kicker">MATRIZ DE COLOCACIÓN · COMPONENTES POR ZONA</p>
          <h3 class="cuadro-title">Reglas de Gobernanza para Ubicación de Componentes</h3>
          <p class="cuadro-subtitle">
            Criterios de diseño para maximizar la velocidad de operación y reducir fricción en almacén y ruta.
          </p>
        </div>
      </div>
    </div>

    <div class="contract-table-wrapper">
      <table class="contract-table">
        <thead>
          <tr>
            <th>Zona de Alcance</th>
            <th>Porcentaje de Pantalla</th>
            <th>Facilidad con 1 Mano</th>
            <th>Componentes Recomendados</th>
            <th>Componentes Prohibidos</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong class="zone-label red">Zona Superior (Top)</strong></td>
            <td>0% – 25% superior</td>
            <td>Baja (Exige estirar el pulgar)</td>
            <td>Título pasivo de pantalla, botón atrás de navegación, icono de búsqueda secundario</td>
            <td>Botones de confirmación de despacho, campos de texto obligatorios</td>
          </tr>
          <tr>
            <td><strong class="zone-label amber">Zona Media (Centro)</strong></td>
            <td>25% – 65% intermedio</td>
            <td>Media (Desplazamiento natural con scroll)</td>
            <td>LazyColumn de paradas, inputs de formulario, selectores de muelle, checkboxes</td>
            <td>Acciones críticas irreversibles sin confirmación posterior</td>
          </tr>
          <tr>
            <td><strong class="zone-label green">Zona Inferior (Base)</strong></td>
            <td>65% – 100% inferior</td>
            <td>Inmediata (Rango natural de reposo)</td>
            <td>NexaIndustrialButton (56dp), FloatingActionButton (FAB), NexaBottomNav fija</td>
            <td>Listas densas sin scroll que queden solapadas por la barra de navegación</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 3: Contrato de Código Kotlin Scaffold Ergonómico -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">03</span>
        <div>
          <p class="cuadro-kicker">CÓDIGO DE PRODUCCIÓN · KOTLIN JETPACK COMPOSE</p>
          <h3 class="cuadro-title">Scaffold Ergonómico con Sticky Bottom Action</h3>
          <p class="cuadro-subtitle">
            Plantilla canónica de pantalla para choferes y operarios, anclando el botón de acción crítica en la zona cómoda inferior sin solapamiento con la barra de gestos del sistema Android.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag kotlin"><i class="pi pi-code"></i> Scaffold.kt</span>
        <span class="cuadro-tag primary"><i class="pi pi-compass"></i> WindowInsets.navigationBars</span>
      </div>
    </div>

    <div class="code-container-block">
      <div class="code-header-bar">
        <div class="code-header-title">
          <i class="pi pi-file"></i>
          <span>core/designsystem/src/main/kotlin/com/nexa/core/designsystem/component/Scaffold.kt</span>
        </div>
        <span class="code-lang-pill">Kotlin 2.4</span>
      </div>
      <pre class="code-pre-box" is:raw><code><span class="comm">// Canonical Ergonomic Screen Layout Template in Jetpack Compose</span>
<span class="kw">package</span> com.nexa.core.designsystem.component

<span class="kw">import</span> androidx.compose.foundation.layout.Box
<span class="kw">import</span> androidx.compose.foundation.layout.PaddingValues
<span class="kw">import</span> androidx.compose.foundation.layout.WindowInsets
<span class="kw">import</span> androidx.compose.foundation.layout.asPaddingValues
<span class="kw">import</span> androidx.compose.foundation.layout.fillMaxSize
<span class="kw">import</span> androidx.compose.foundation.layout.fillMaxWidth
<span class="kw">import</span> androidx.compose.foundation.layout.navigationBars
<span class="kw">import</span> androidx.compose.foundation.layout.padding
<span class="kw">import</span> androidx.compose.material3.Scaffold
<span class="kw">import</span> androidx.compose.material3.Surface
<span class="kw">import</span> androidx.compose.runtime.Composable
<span class="kw">import</span> androidx.compose.ui.Modifier
<span class="kw">import</span> androidx.compose.ui.unit.dp

<span class="ann">@Composable</span>
<span class="kw">fun</span> <span class="fn">NexaOperationScreenScaffold</span>(
    title: <span class="type">String</span>,
    onPrimaryAction: () -> <span class="type">Unit</span>,
    primaryActionLabel: <span class="type">String</span>,
    modifier: <span class="type">Modifier</span> = Modifier,
    content: <span class="ann">@Composable</span> (<span class="type">PaddingValues</span>) -> <span class="type">Unit</span>
) {
    <span class="fn">Scaffold</span>(
        modifier = modifier.fillMaxSize(),
        topBar = {
            <span class="comm">// Zona Difícil: Información pasiva y navegación de retorno</span>
            <span class="fn">NexaTopAppBar</span>(title = title)
        },
        bottomBar = {
            <span class="comm">// Zona Natural Cómoda: Botón industrial anclado con safe padding</span>
            <span class="fn">Surface</span>(
                tonalElevation = <span class="num">3.dp</span>,
                shadowElevation = <span class="num">8.dp</span>,
                modifier = Modifier.fillMaxWidth()
            ) {
                <span class="fn">Box</span>(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(<span class="num">16.dp</span>)
                        .padding(WindowInsets.navigationBars.asPaddingValues()) <span class="comm">// Insets seguros</span>
                ) {
                    <span class="fn">NexaIndustrialButton</span>(
                        text = primaryActionLabel,
                        onClick = onPrimaryAction
                    )
                }
            }
        }
    ) { innerPadding ->
        <span class="comm">// Zona Alcanzable: Lista scrolleable que no colisiona con barras</span>
        content(innerPadding)
    }
}</code></pre>
    </div>
  </section>
</div>

<style>
  .zonas-alcance-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
  }

  /* Section 1: Biomechanical Stage */
  .biomechanical-stage-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 28px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .biomechanical-stage-grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }

  /* Phone Silhouette */
  .phone-silhouette-wrapper {
    width: 100%;
    max-width: 330px;
    display: flex;
    justify-content: center;
  }

  .phone-frame {
    position: relative;
    width: 100%;
    height: 580px;
    background: #0f172a;
    border-radius: 40px;
    padding: 12px;
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.25), 0 0 0 2px #334155;
    display: flex;
    flex-direction: column;
  }

  .phone-camera-hole {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    background: #000000;
    border-radius: 50%;
    border: 1px solid #1e293b;
    z-index: 10;
  }

  .phone-speaker-grille {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 50px;
    height: 3px;
    background: #334155;
    border-radius: 2px;
    z-index: 10;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    background: #f8fafc;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Subtle Zone Bezel Ruler on phone frame */
  .phone-bezel-ruler {
    position: absolute;
    left: -22px;
    top: 36px;
    bottom: 36px;
    width: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 8px;
    font-weight: 800;
  }

  .ruler-bracket {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    padding: 2px;
    letter-spacing: 0.05em;
  }

  .ruler-bracket.r-top {
    height: 25%;
    background: #fee2e2;
    color: #991b1b;
    border-left: 2px solid #ef4444;
  }

  .ruler-bracket.r-mid {
    height: 40%;
    background: #fef3c7;
    color: #92400e;
    border-left: 2px solid #f59e0b;
  }

  .ruler-bracket.r-base {
    height: 35%;
    background: #dcfce7;
    color: #166534;
    border-left: 2px solid #22c55e;
  }

  /* Clean Phone Screen Zones */
  .screen-section-top {
    height: 22%;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 26px 12px 8px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .clean-mock-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .topbar-nav-back {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    color: #0f172a;
    i { font-size: 11px; color: #2563eb; }
  }

  .topbar-status-chip {
    font-size: 9px;
    font-weight: 700;
    background: #eff6ff;
    color: #1d4ed8;
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid #bfdbfe;
  }

  .screen-section-mid {
    height: 48%;
    background: #f8fafc;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
  }

  .clean-mock-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .clean-mock-card.secondary {
    background: #ffffff;
    border-color: #cbd5e1;
  }

  .mock-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    strong {
      font-size: 10px;
      color: #0f172a;
    }
  }

  .mock-fefo-chip {
    font-size: 8px;
    font-weight: 800;
    padding: 1px 5px;
    border-radius: 4px;
    background: #dcfce7;
    color: #15803d;
  }

  .mock-qty {
    font-size: 8.5px;
    color: #64748b;
    font-family: var(--nexa-font-family-mono, monospace);
  }

  .mock-card-address {
    font-size: 9px;
    color: #64748b;
    margin: 0;
  }

  .mock-card-temp {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 8.5px;
    font-weight: 700;
    color: #15803d;
    margin-top: 2px;
    i { font-size: 9px; }
  }

  .screen-section-bottom {
    height: 30%;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    padding: 8px 12px 6px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .clean-mock-bottom-action {
    width: 100%;
  }

  .clean-mock-bottom-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px 0;
  }

  .zone-mock-bottom-action {
    position: relative;
    z-index: 2;
  }

  .mock-btn-cta-industrial {
    width: 100%;
    height: 42px;
    border: none;
    border-radius: 8px;
    background: #082846;
    border: 1px solid #38c8ff;
    color: #ffffff;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    box-shadow: 0 3px 6px rgba(8, 40, 70, 0.25);
  }

  .zone-mock-bottom-nav {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-around;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px 6px;
  }

  .mock-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    color: #94a3b8;
    font-size: 8px;

    i { font-size: 11px; }

    &.active {
      color: #2a67d9;
      font-weight: 800;
    }
  }

  .phone-gesture-bar {
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 3px;
    background: #0f172a;
    border-radius: 2px;
    z-index: 10;
  }

  /* Biomechanical Spec Column */
  .biomechanical-spec-column {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .zone-spec-card {
    padding: 16px;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);

    &.red-border { border-left: 4px solid #ef4444; }
    &.amber-border { border-left: 4px solid #f59e0b; }
    &.green-border { border-left: 4px solid #22c55e; }

    p {
      font-size: 12.5px;
      color: #475569;
      line-height: 1.5;
      margin: 0;
    }
  }

  .zone-spec-header {
    display: flex;
    align-items: center;
    gap: 10px;

    strong {
      font-size: 13.5px;
      color: #0f172a;
      display: block;
    }

    small {
      font-size: 11px;
      color: #64748b;
    }
  }

  .zone-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;

    &.red { background: #ef4444; }
    &.amber { background: #f59e0b; }
    &.green { background: #22c55e; }
  }

  .zone-rules-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
    padding-top: 8px;
    border-top: 1px dashed #f1f5f9;
  }

  .rule-chip {
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1.35;

    &.allowed {
      color: #166534;
      i { color: #16a34a; }
    }

    &.prohibited {
      color: #991b1b;
      i { color: #dc2626; }
    }
  }

  .zone-label {
    font-size: 11.5px;
    font-weight: 700;

    &.red { color: #b91c1c; }
    &.amber { color: #b45309; }
    &.green { color: #15803d; }
  }
</style>
