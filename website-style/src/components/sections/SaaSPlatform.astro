---
// SaaSPlatform: Authentic Nexa Cold-Chain Operations & Dispatch Ledger
// Replaces legacy Flecto rental data with authentic Nexa B2B cold chain dispatch & IoT telemetry.
---

<section class="saas-section" id="features" aria-labelledby="saas-heading">
  <div class="saas-container">
    <div class="saas-header">
      <div class="saas-tag text-eyebrow">
        <span>Nexa Operations</span>
        <span class="tag-sep" aria-hidden="true">—</span>
        <span>Cold-Chain OS</span>
      </div>

      <div class="saas-headline-row">
        <h2 id="saas-heading" class="saas-title">
          Control integral de muelle, <br />
          <span class="text-nexa-blue">precintos y telemetría.</span>
        </h2>

        <div class="saas-actions">
          <a href="#book-demo" class="saas-btn primary">Explorar Tablero</a>
          <a href="/nexafy" class="saas-btn secondary">Ver Mocks Reales</a>
        </div>
      </div>

      <p class="saas-lead body-lead">
        Gestiona la asignación de rampas y despacha lotes perecibles en un tablero interconectado en vivo con transportistas de frío, trazabilidad FEFO y custodia escrow pre-autorizada.
      </p>
    </div>

    <!-- The Bento Dashboard Grid -->
    <div class="bento-grid">
      <!-- Main Bento Card 1: Tabular Dispatch Manager (Span 2 cols) -->
      <div class="bento-card bento-wide">
        <div class="bento-card-header">
          <div>
            <h3 class="bento-card-title">Tablero de Despachos B2B</h3>
            <p class="bento-card-sub">Centraliza asignaciones de muelle y estado de carga en tiempo real.</p>
          </div>
          
          <div class="table-search-bar" role="search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="bookings-search-input" placeholder="Buscar orden, cliente o lote..." aria-label="Filtrar despachos" />
          </div>
        </div>

        <!-- Rich Tabular Dispatch Manager -->
        <div class="table-responsive-wrapper" tabindex="0" role="region" aria-label="Libro mayor de despachos">
          <table class="bookings-table" id="bookings-table">
            <thead>
              <tr>
                <th scope="col">Orden / Muelle</th>
                <th scope="col">Cliente / Destino</th>
                <th scope="col">Carga / Lote</th>
                <th scope="col">Telemetría</th>
                <th scope="col">Custodia Escrow</th>
                <th scope="col">Estado</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <div class="renter-cell">
                    <span class="avatar-circle">204</span>
                    <div>
                      <strong>DSP-204</strong>
                      <span>Muelle Rampa 04</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="destination-cell">
                    <strong>La Cava Fría SAC</strong>
                    <span>Callao &rarr; Lima Norte</span>
                  </div>
                </td>
                <td>
                  <span class="item-tag">500 kg Salmón · L-8841</span>
                </td>
                <td>
                  <span class="telemetry-badge text-mono">-18.2°C OK</span>
                </td>
                <td>
                  <strong class="text-nexa-blue text-mono">$3,450.00</strong>
                </td>
                <td>
                  <span class="status-chip active">Listo Revisión</span>
                </td>
              </tr>

              <tr>
                <td>
                  <div class="renter-cell">
                    <span class="avatar-circle">198</span>
                    <div>
                      <strong>DSP-198</strong>
                      <span>Muelle Rampa 02</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="destination-cell">
                    <strong>Andino Food Service</strong>
                    <span>Callao &rarr; Lima Centro</span>
                  </div>
                </td>
                <td>
                  <span class="item-tag">Pallet P-102 (320 kg)</span>
                </td>
                <td>
                  <span class="telemetry-badge text-mono">-18.0°C OK</span>
                </td>
                <td>
                  <strong class="text-nexa-blue text-mono">$2,180.00</strong>
                </td>
                <td>
                  <span class="status-chip pending">Checklist</span>
                </td>
              </tr>

              <tr>
                <td>
                  <div class="renter-cell">
                    <span class="avatar-circle">191</span>
                    <div>
                      <strong>DSP-191</strong>
                      <span>Bahía Despacho 05</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="destination-cell">
                    <strong>Frío Norte SAC</strong>
                    <span>Lima &rarr; Chiclayo 1N</span>
                  </div>
                </td>
                <td>
                  <span class="item-tag">850 kg Trucha · L-8824</span>
                </td>
                <td>
                  <span class="telemetry-badge text-mono">-18.4°C GPS</span>
                </td>
                <td>
                  <strong class="text-nexa-blue text-mono">$5,920.00</strong>
                </td>
                <td>
                  <span class="status-chip transit">En Distribución</span>
                </td>
              </tr>

              <tr>
                <td>
                  <div class="renter-cell">
                    <span class="avatar-circle">183</span>
                    <div>
                      <strong>DSP-183</strong>
                      <span>Rampa Lima Sur 01</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="destination-cell">
                    <strong>Mercado Central Lima</strong>
                    <span>Recepción Conforme</span>
                  </div>
                </td>
                <td>
                  <span class="item-tag">400 kg Conchas · L-8812</span>
                </td>
                <td>
                  <span class="telemetry-badge text-mono">-19.1°C OK</span>
                </td>
                <td>
                  <strong class="text-nexa-blue text-mono">$4,100.00</strong>
                </td>
                <td>
                  <span class="status-chip completed">Entregado</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Bento Card 2: Cold-Chain Fleet & Sensor Telemetry -->
      <div class="bento-card">
        <div class="bento-card-header">
          <div>
            <h3 class="bento-card-title">Flota Reefer & Sensores IoT</h3>
            <p class="bento-card-sub">Monitoreo continuo de frío y disponibilidad de bahías.</p>
          </div>
          <span class="fleet-count text-mono">94% Operativo</span>
        </div>

        <div class="inventory-bars">
          <div class="inv-item-progress">
            <div class="progress-labels">
              <span>Reefer Vans Activas (-18.2°C)</span>
              <span class="text-mono">18 / 20 Unidades</span>
            </div>
            <div class="progress-track" role="progressbar" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100" aria-label="Reefer vans activas">
              <div class="progress-fill" style="width: 90%;"></div>
            </div>
          </div>

          <div class="inv-item-progress">
            <div class="progress-labels">
              <span>Sensores Sensirion IoT Calibrados</span>
              <span class="text-mono">24 / 24 Nodos</span>
            </div>
            <div class="progress-track" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" aria-label="Sensores calibrados">
              <div class="progress-fill fill-cyan" style="width: 100%;"></div>
            </div>
          </div>

          <div class="inv-item-progress">
            <div class="progress-labels">
              <span>Bahías Muelle Frigorífico Callao</span>
              <span class="text-mono">6 / 8 Asignadas</span>
            </div>
            <div class="progress-track" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" aria-label="Bahías asignadas">
              <div class="progress-fill fill-blue" style="width: 75%;"></div>
            </div>
          </div>
        </div>

        <div class="card-footer-metric">
          <div class="metric-col">
            <span class="met-num text-mono">0.0%</span>
            <span class="met-txt">Rotura de Cadena de Frío</span>
          </div>
          <div class="metric-col">
            <span class="met-num text-mono">100%</span>
            <span class="met-txt">Custodia Escrow Garantizada</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .saas-section {
    padding: var(--layout-section-padding, 4.5rem) 0;
    background-color: #082846;
    color: #ffffff;
    overflow-x: clip;
  }

  .saas-container {
    max-width: var(--layout-max-width, 1360px);
    margin: 0 auto;
    padding: 0 var(--layout-gutter, 2rem);
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .saas-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .saas-tag {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #38bdf8;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .saas-headline-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .saas-title {
    color: #ffffff;
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .text-nexa-blue {
    color: #38bdf8;
  }

  .saas-lead {
    color: #cbd5e1;
    max-width: 65ch;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }

  .saas-actions {
    display: flex;
    gap: 1rem;
  }

  .saas-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .saas-btn.primary {
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
  }

  .saas-btn.primary:hover {
    background: #1d4ed8;
    transform: translateY(-2px);
  }

  .saas-btn.secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .saas-btn.secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: 1.5rem;
    width: 100%;
    min-width: 0;
  }

  .bento-card {
    background: #061e38;
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 24px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
    min-width: 0;
    max-width: 100%;
  }

  .bento-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .bento-card-title {
    font-family: var(--nexa-font-family-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .bento-card-sub {
    font-size: 0.875rem;
    color: #94a3b8;
  }

  .table-search-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #082846;
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    color: #94a3b8;
  }

  .table-search-bar input {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 0.8125rem;
    outline: none;
    width: 180px;
  }

  .table-search-bar input::placeholder {
    color: #64748b;
  }

  /* Table styling */
  .table-responsive-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .bookings-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .bookings-table th {
    padding: 10px 14px;
    color: #94a3b8;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid rgba(56, 189, 248, 0.2);
    font-family: var(--nexa-font-family-mono, monospace);
  }

  .bookings-table td {
    padding: 14px;
    border-bottom: 1px solid rgba(56, 189, 248, 0.1);
    white-space: nowrap;
  }

  .renter-cell {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .avatar-circle {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(37, 99, 235, 0.25);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.75rem;
    font-family: var(--nexa-font-family-mono, monospace);
  }

  .renter-cell strong {
    display: block;
    color: #ffffff;
    font-size: 0.875rem;
  }

  .renter-cell span {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .destination-cell strong {
    display: block;
    color: #ffffff;
    font-size: 0.875rem;
  }

  .destination-cell span {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .item-tag {
    background: rgba(8, 40, 70, 0.8);
    padding: 4px 10px;
    border-radius: 6px;
    color: #e2e8f0;
    font-size: 0.8125rem;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .telemetry-badge {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .status-chip {
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    font-family: var(--nexa-font-family-mono, monospace);
  }

  .status-chip.active {
    background: rgba(37, 99, 235, 0.2);
    color: #93c5fd;
    border: 1px solid rgba(37, 99, 235, 0.4);
  }

  .status-chip.pending {
    background: rgba(217, 119, 6, 0.2);
    color: #fcd34d;
    border: 1px solid rgba(217, 119, 6, 0.4);
  }

  .status-chip.transit {
    background: rgba(2, 132, 199, 0.2);
    color: #7dd3fc;
    border: 1px solid rgba(2, 132, 199, 0.4);
  }

  .status-chip.completed {
    background: rgba(30, 64, 175, 0.3);
    color: #bae6fd;
    border: 1px solid rgba(30, 64, 175, 0.5);
  }

  /* Fleet Card */
  .fleet-count {
    background: rgba(37, 99, 235, 0.2);
    color: #93c5fd;
    border: 1px solid rgba(37, 99, 235, 0.35);
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .inventory-bars {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .inv-item-progress {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .progress-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: #cbd5e1;
  }

  .progress-track {
    width: 100%;
    height: 8px;
    background: rgba(8, 40, 70, 0.8);
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(56, 189, 248, 0.15);
  }

  .progress-fill {
    height: 100%;
    background: #2563eb;
    border-radius: 4px;
  }

  .progress-fill.fill-cyan {
    background: #38bdf8;
  }

  .progress-fill.fill-blue {
    background: #60a5fa;
  }

  .card-footer-metric {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(56, 189, 248, 0.2);
    margin-top: auto;
  }

  .metric-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .met-num {
    font-size: 1.35rem;
    font-weight: 800;
    color: #38bdf8;
  }

  .met-txt {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  @media (max-width: 1024px) {
    .saas-headline-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .bento-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .bento-card {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
