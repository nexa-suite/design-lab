---
/**
 * PaymentCircuitMethods Component
 * Chapter 3 (Safe Renting & Payments): Digital payment providers circuit (MB WAY, PayPal, Mastercard, VISA).
 */
---

<div class="ch3-left-circuit">
  <div class="ch3-stem-horizontal">
    <span class="ch3-stem-label">Multiple Payment Methods</span>
  </div>
  <div class="ch3-toggle-capsule">
    <div class="ch3-switch-pill active" role="switch" aria-checked="true" aria-label="Digital Payments toggle">
      <span class="ch3-switch-ball"></span>
    </div>
    <span class="ch3-toggle-text">Digital Payments</span>
  </div>
  
  <div class="ch3-chips-grid">
    <div class="ch3-chip chip-mbway" title="MB WAY">
      <span class="chip-mb-text">MB</span>
    </div>
    <div class="ch3-chip chip-paypal" title="PayPal">
      <span style="font-weight: 800; font-size: 13px;">PayPal</span>
    </div>
    <div class="ch3-chip chip-mastercard" title="Mastercard">
      <span style="font-weight: 800; font-size: 13px;">Mastercard</span>
    </div>
    <div class="ch3-chip chip-visa" title="Visa">
      <span style="font-weight: 800; font-size: 13px;">VISA</span>
    </div>
  </div>
</div>

<style>
  .ch3-left-circuit {
    width: 280px;
    background: var(--stage-card);
    border-radius: 18px;
    padding: 1.25rem;
    color: var(--stage-text);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .ch3-stem-label {
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .ch3-toggle-capsule {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.75rem 0;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .ch3-switch-pill {
    width: 32px;
    height: 18px;
    background: var(--stage-capsule-bg);
    border-radius: 999px;
    position: relative;
    transition: background-color 0.3s ease;
  }

  .ch3-switch-ball {
    position: absolute;
    right: 2px;
    top: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--stage-card);
    transition: background-color 0.3s ease;
  }

  .ch3-chips-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .ch3-chip {
    background: #ffffff;
    border-radius: 8px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--stage-text);
  }

  .chip-mb-text {
    font-weight: 900;
    font-size: 14px;
    color: var(--stage-text);
  }
</style>
