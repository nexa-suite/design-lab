    li {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 12px;
      line-height: 1.45;
      color: var(--nexa-color-text-primary, #0f172a);

      i {
        font-size: 11px;
        color: #0284c7;
        margin-top: 3px;
        flex-shrink: 0;
      }
    }
  }

  .arch-stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
  }

  .tag-stack {
    font-family: var(--nexa-font-family-mono, monospace);
