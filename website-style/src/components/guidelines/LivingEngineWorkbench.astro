    // Tare scale simulator button
    const btnTare = document.getElementById('btn-tare-scale');
    btnTare?.addEventListener('click', () => {
      const scaleVal = document.querySelector('.scale-metric-value');
      if (scaleVal) {
        scaleVal.innerHTML = '0.00 <span class="unit">kg</span>';
        setTimeout(() => {
          scaleVal.innerHTML = '500.00 <span class="unit">kg</span>';
        }, 1500);
      }
    });

    // Simulated escrow settlement
    const btnSettle = document.getElementById('btn-simulate-settlement');
    btnSettle?.addEventListener('click', () => {
      const tickerMsg = document.getElementById('workbench-ticker-msg');
      if (tickerMsg) {
        tickerMsg.textContent = '✦ Smart Contract: Firma POD verificada · Liquidación de $3,450.00 USD ejecutada con éxito en 0.72s';
      }
    });
  }

  // Tones Management
  const TONES: Record<string, { plate: string; accent: string; conduit: string }> = {
    nexa:     { plate: '#082846', accent: '#38bdf8', conduit: '#bae6fd' },
    ceramic:  { plate: '#1d3d63', accent: '#38bdf8', conduit: '#a5f3fc' },
    cashmere: { plate: '#283a48', accent: '#7dd3fc', conduit: '#bae6fd' },
    oceanic:  { plate: '#0c2038', accent: '#38bdf8', conduit: '#93c5fd' }
  };

  function applyTone(toneKey: string) {
    const tone = TONES[toneKey];
    if (!tone) return;

    document.querySelectorAll('.tone-pill').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.tone === toneKey);
    });

    const silPath = document.querySelector<SVGPathElement>('.hero-silhouette-path');
    if (silPath) silPath.setAttribute('fill', tone.plate);

    const pipes = document.querySelectorAll<SVGPathElement>('.circuit-pipe-line');
    pipes.forEach(p => p.setAttribute('stroke', tone.conduit));
  }

  function initLivingEngineWorkbench() {
    setupDragAndDrop();
    rerouteAll();
    animateParticles();
    setupInteractiveLogo();
    setupLoginModal();
    setupChapterTracker();

    // Build Engine Assembly
    const btnBuild = document.getElementById('btn-build-engine');
    btnBuild?.addEventListener('click', buildEngineAssembly);

    // Segment Views Switching
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(btn => {
      btn.addEventListener('click', () => {
        const viewKey = btn.dataset.view || 'channels';
        switchStageView(viewKey);
      });
    });

    // Preset Switching & Reset
    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.dataset.preset;
        if (preset === 'reset') {
          applyPreset('channels');
        } else if (preset) {
          applyPreset(preset);
        }
      });
    });

    // Tone Switching
    document.querySelectorAll<HTMLButtonElement>('.tone-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const toneKey = btn.dataset.tone || 'nexa';
        applyTone(toneKey);
      });
    });

    // Conduit Pastel Switching
    document.querySelectorAll<HTMLButtonElement>('.conduit-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const pastel = btn.dataset.pastel || '#bae6fd';
        document.querySelectorAll('.conduit-pill').forEach(b => b.classList.toggle('active', b === btn));
        document.querySelectorAll<SVGPathElement>('.circuit-pipe-line').forEach(p => p.setAttribute('stroke', pastel));
      });
    });

    // Inspector Drawer Toggle
    const inspectorDrawer = document.getElementById('workbench-inspector-drawer');
    const btnToggleInspector = document.getElementById('btn-toggle-inspector');
    const btnCloseInspector = document.getElementById('btn-close-inspector');

    btnToggleInspector?.addEventListener('click', () => {
      inspectorDrawer?.classList.toggle('open');
    });

    btnCloseInspector?.addEventListener('click', () => {
      inspectorDrawer?.classList.remove('open');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLivingEngineWorkbench);
  } else {
    initLivingEngineWorkbench();
  }
</script>
