  .screen-tab-btn.hidden { display: none !important; }
</style>

<script>
  // =========================================================================
  // 1. PRIMARY ROLE SELECTOR & SECONDARY SCREEN FILTERING
  // =========================================================================
  const rolePillBtns = document.querySelectorAll<HTMLButtonElement>('.role-pill-btn');
  const screenTabBtns = document.querySelectorAll<HTMLButtonElement>('.screen-tab-btn');
  const screenCards = document.querySelectorAll<HTMLElement>('.mock-screen-card');

  // Switch role and filter screens
  rolePillBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const selectedRole = btn.getAttribute('data-role');
      rolePillBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      let firstVisibleScreenBtn: HTMLButtonElement | null = null;

      screenTabBtns.forEach(sBtn => {
        const sRole = sBtn.getAttribute('data-role');
        const isMatch = selectedRole === 'all' || sRole === selectedRole;
        sBtn.classList.toggle('hidden', !isMatch);
        if (isMatch && !firstVisibleScreenBtn) {
          firstVisibleScreenBtn = sBtn;
        }
      });

      // Automatically activate first visible screen in this role
      if (firstVisibleScreenBtn) {
        (firstVisibleScreenBtn as HTMLButtonElement).click();
      }
    });
  });

  // Switch active screen when clicking secondary pills
  screenTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      screenTabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      screenCards.forEach(card => {
        card.classList.toggle('active', card.id === targetId);
      });
    });
  });

  // =========================================================================
  // 2. BOTTOM NAVBAR ARTIFACT INTERACTIONS (Cross-navigation inside mockup)
  // =========================================================================
  document.querySelectorAll<HTMLElement>('.bnav-item[data-nav-target]').forEach(item => {
    item.addEventListener('click', () => {
      const targetScreenId = item.getAttribute('data-nav-target');
      if (targetScreenId) {
        const matchingBtn = document.querySelector<HTMLButtonElement>(`.screen-tab-btn[data-target="${targetScreenId}"]`);
        matchingBtn?.click();
      }
    });
  });

  // Quick navigation button in Screen 1.1 to go to 1.2 POD
  document.getElementById('btn-goto-pod')?.addEventListener('click', () => {
    const podTab = document.querySelector<HTMLButtonElement>('.screen-tab-btn[data-target="mock-screen-pod"]');
    podTab?.click();
  });

  // =========================================================================
  // 3. SCREEN 1.1: Driver Temperature & Geofence (Diego Morales)
  // =========================================================================
  let routeTemp = 3.8;
  const tempValEl = document.getElementById('route-temp-val');
  const quickTelTemp = document.getElementById('quick-tel-temp');
  const btnTempMinus = document.getElementById('btn-temp-minus');
  const btnTempPlus = document.getElementById('btn-temp-plus');
  const btnToggleArrival = document.getElementById('btn-toggle-arrival');
  const lblArrival = document.getElementById('lbl-arrival');
  const tlStopDest = document.getElementById('tl-stop-dest');
  const tlDestTitle = document.getElementById('tl-dest-title');
  const tlDestTime = document.getElementById('tl-dest-time');
  const tlDotDest = document.getElementById('tl-dot-dest');
  const routeDriverStatus = document.getElementById('route-driver-status');

  let isArrived = false;

  btnTempMinus?.addEventListener('click', () => {
    routeTemp = Math.max(1.0, +(routeTemp - 0.2).toFixed(1));
    updateTempUI();
  });
  btnTempPlus?.addEventListener('click', () => {
    routeTemp = Math.min(9.0, +(routeTemp + 0.2).toFixed(1));
    updateTempUI();
  });

  function updateTempUI() {
    const formatted = `${routeTemp.toFixed(1)}°C`;
    if (tempValEl) tempValEl.textContent = formatted;
    if (quickTelTemp) quickTelTemp.innerHTML = `<i class="pi pi-check-circle"></i> ${formatted}`;
  }

  btnToggleArrival?.addEventListener('click', () => {
    isArrived = !isArrived;
    btnToggleArrival.classList.toggle('arrived', isArrived);
    if (lblArrival) lblArrival.textContent = isArrived ? '✓ Llegada Registrada (Geocerca 200m)' : 'Simular Llegada al Destino (Geocerca 200m)';
    if (tlDestTitle) tlDestTitle.textContent = isArrived ? 'Destino: ICISA Distribuciones (Arribado)' : 'Destino: ICISA Distribuciones';
    if (tlDestTime) tlDestTime.textContent = isArrived ? '14:35 · En Bahía de Descarga M-2' : 'ETA 14:20 · Av. Argentina 1240';
    if (tlStopDest) tlStopDest.classList.toggle('arrived', isArrived);
    if (tlDotDest) tlDotDest.className = isArrived ? 'timeline-dot cyan' : 'timeline-dot blue';
    if (routeDriverStatus) routeDriverStatus.textContent = isArrived ? '● EN DESTINO' : '● EN RUTA';
  });

  // =========================================================================
  // 4. SCREEN 1.2: Proof of Delivery (POD)
  // =========================================================================
  let podPhotoCount = 2;
  const btnPodAddPhoto = document.getElementById('btn-pod-add-photo');
  const lblPodPhotoText = document.getElementById('lbl-pod-photo-text');
  const btnFinalizePodScreen = document.getElementById('btn-finalize-pod-screen');
  const lblPodScreenBtn = document.getElementById('lbl-pod-screen-btn');

  btnPodAddPhoto?.addEventListener('click', () => {
    podPhotoCount++;
    if (lblPodPhotoText) lblPodPhotoText.textContent = `${podPhotoCount} Fotos`;
  });

  btnFinalizePodScreen?.addEventListener('click', () => {
    if (lblPodScreenBtn) lblPodScreenBtn.textContent = '✓ Entrega Registrada (POD Completo Exitoso)';
  });

  // =========================================================================
  // 5. SCREEN 1.3: Cash on Delivery Calculator (Diego Morales)
  // =========================================================================
  const cashBtns = document.querySelectorAll<HTMLButtonElement>('.cash-btn');
  const valCashChange = document.getElementById('val-cash-change');
  const lblCashReceivedSub = document.getElementById('lbl-cash-received-sub');
  const totalDue = 1420.0;

  cashBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      cashBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const amt = parseFloat(btn.getAttribute('data-amt') || '1500');
      const change = Math.max(0, amt - totalDue);
      if (valCashChange) valCashChange.textContent = `$${change.toFixed(2)} USD`;
      if (lblCashReceivedSub) lblCashReceivedSub.textContent = `Monto entregado: $${amt.toFixed(2)} USD`;
    });
  });

  // =========================================================================
  // 6. SCREEN 1.4: Incident Report Severity
  // =========================================================================
  const sevChips = document.querySelectorAll<HTMLButtonElement>('.sev-chip');
  const badgeIncidentSev = document.getElementById('badge-incident-sev');

  sevChips.forEach(chip => {
    chip.addEventListener('click', () => {
      sevChips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      const sev = chip.getAttribute('data-sev') || 'MODERADO';
      if (badgeIncidentSev) badgeIncidentSev.textContent = sev;
    });
  });

  // =========================================================================
  // 7. SCREEN 1.5: Returns RMA Steppers
  // =========================================================================
  let rmaBoxes = 4;
  const valRmaBoxes = document.getElementById('val-rma-boxes');
  const btnRmaMinus = document.getElementById('btn-rma-minus');
  const btnRmaPlus = document.getElementById('btn-rma-plus');

  btnRmaMinus?.addEventListener('click', () => {
    if (rmaBoxes > 1) rmaBoxes--;
    if (valRmaBoxes) valRmaBoxes.textContent = String(rmaBoxes);
  });
  btnRmaPlus?.addEventListener('click', () => {
    if (rmaBoxes < 20) rmaBoxes++;
    if (valRmaBoxes) valRmaBoxes.textContent = String(rmaBoxes);
  });

  // =========================================================================
  // 8. SCREEN 2.1: Picking FEFO (Alejandro Vargas)
  // =========================================================================
  let pickedCount = 18;
  const valPickedUnits = document.getElementById('val-picked-units');
  const btnPickMinus = document.getElementById('btn-pick-minus');
  const btnPickPlus = document.getElementById('btn-pick-plus');
  const btnScanBarcode = document.getElementById('btn-scan-barcode');
  const lblScanBarcode = document.getElementById('lbl-scan-barcode');

  btnPickMinus?.addEventListener('click', () => {
    if (pickedCount > 0) pickedCount--;
    if (valPickedUnits) valPickedUnits.textContent = String(pickedCount);
  });
  btnPickPlus?.addEventListener('click', () => {
    if (pickedCount < 24) pickedCount++;
    if (valPickedUnits) valPickedUnits.textContent = String(pickedCount);
  });
  btnScanBarcode?.addEventListener('click', () => {
    pickedCount = 24;
    if (valPickedUnits) valPickedUnits.textContent = '24';
    if (lblScanBarcode) lblScanBarcode.textContent = '✓ Lote L-20260914-A Escaneado (24/24)';
  });

  // =========================================================================
  // 9. SCREEN 2.2: CameraX Scanner Flash Toggle
  // =========================================================================
  const btnMockFlash = document.getElementById('btn-mock-flash');
  let flashActive = false;
  btnMockFlash?.addEventListener('click', () => {
    flashActive = !flashActive;
    btnMockFlash.style.color = flashActive ? '#facc15' : '#475569';
  });

  // =========================================================================
  // 10. SCREEN 2.3: Machinery Inspection ISO 3691 Lockout
  // =========================================================================
  const isoCheckboxes = document.querySelectorAll<HTMLInputElement>('.iso-chk');
  const ignitionBanner = document.getElementById('ignition-banner');
  const ignitionIconBox = document.getElementById('ignition-icon-box');
  const ignitionTitle = document.getElementById('ignition-title');
  const ignitionSub = document.getElementById('ignition-sub');
  const btnValidateIso = document.getElementById('btn-validate-iso');
  const lblIsoBtn = document.getElementById('lbl-iso-btn');
  const pillIsoStatus = document.getElementById('pill-iso-status');

  isoCheckboxes.forEach(chk => {
    chk.addEventListener('change', checkIsoCompliance);
  });

  function checkIsoCompliance() {
    const allChecked = Array.from(isoCheckboxes).every(c => c.checked);
    if (allChecked) {
      ignitionBanner?.classList.add('passed');
      ignitionIconBox?.classList.add('passed');
      if (ignitionIconBox) ignitionIconBox.innerHTML = '<i class="pi pi-check-circle"></i>';
      if (ignitionTitle) {
        ignitionTitle.textContent = 'IGNICIÓN LIBERADA (PASE ISO 3691)';
        ignitionTitle.style.color = '#0284c7';
      }
      if (ignitionSub) ignitionSub.textContent = 'Todos los puntos de seguridad han sido verificados conforme';
      if (btnValidateIso) (btnValidateIso as HTMLButtonElement).disabled = false;
      if (lblIsoBtn) lblIsoBtn.textContent = 'Iniciar Turno de Operaciones';
      if (pillIsoStatus) {
        pillIsoStatus.className = 'meta-pill touch';
        pillIsoStatus.innerHTML = '<i class="pi pi-check"></i> Operativo OK';
      }
    } else {
      ignitionBanner?.classList.remove('passed');
      ignitionIconBox?.classList.remove('passed');
      if (ignitionIconBox) ignitionIconBox.innerHTML = '<i class="pi pi-exclamation-triangle"></i>';
      if (ignitionTitle) {
        ignitionTitle.textContent = 'BLOQUEO DE IGNICIÓN (LOCKOUT ACTIVO)';
        ignitionTitle.style.color = '#991b1b';
      }
      if (ignitionSub) ignitionSub.textContent = 'Equipo no apto para operar hasta subsanar observación crítica';
      if (btnValidateIso) (btnValidateIso as HTMLButtonElement).disabled = true;
      if (lblIsoBtn) lblIsoBtn.textContent = 'Equipo Bloqueado por Seguridad';
      if (pillIsoStatus) {
        pillIsoStatus.className = 'meta-pill industrial';
        pillIsoStatus.innerHTML = '<i class="pi pi-lock"></i> Bloqueado';
      }
    }
  }

  // =========================================================================
  // 11. SCREEN 2.4: Cycle Count Steppers
  // =========================================================================
  let cycleUnits = 149;
  const valCycleUnits = document.getElementById('val-cycle-units');
  const btnCycleMinus = document.getElementById('btn-cycle-minus');
  const btnCyclePlus = document.getElementById('btn-cycle-plus');
  const lblVarianceVal = document.getElementById('lbl-variance-val');

  btnCycleMinus?.addEventListener('click', () => {
    cycleUnits -= 1;
    if (valCycleUnits) valCycleUnits.textContent = String(cycleUnits);
    const diffPct = (((cycleUnits - 150) / 150) * 100).toFixed(1);
    if (lblVarianceVal) lblVarianceVal.textContent = `${diffPct}% (Tolerancia OK)`;
  });
  btnCyclePlus?.addEventListener('click', () => {
    cycleUnits += 1;
    if (valCycleUnits) valCycleUnits.textContent = String(cycleUnits);
    const diffPct = (((cycleUnits - 150) / 150) * 100).toFixed(1);
    if (lblVarianceVal) lblVarianceVal.textContent = `${diffPct}% (Tolerancia OK)`;
  });

  // =========================================================================
  // 12. SCREEN 2.5: Offline Sync Queue Replay
  // =========================================================================
  const chkAirplaneMode = document.getElementById('chk-airplane-mode') as HTMLInputElement | null;
  const badgeSyncNet = document.getElementById('badge-sync-net');
  const syncNetTech = document.getElementById('sync-net-tech');
  const lblNetTitle = document.getElementById('lbl-net-title');
  const lblNetSub = document.getElementById('lbl-net-sub');
  const btnForceSync = document.getElementById('btn-force-sync');
  const lblSyncBtn = document.getElementById('lbl-sync-btn');
  const pillSyncStatus = document.getElementById('pill-sync-status');

  chkAirplaneMode?.addEventListener('change', () => {
    const isOff = chkAirplaneMode.checked;
    if (badgeSyncNet) {
      badgeSyncNet.textContent = isOff ? 'OFFLINE' : 'ONLINE';
      badgeSyncNet.className = isOff ? 'status-pill-amber' : 'status-pill-cyan';
    }
    if (syncNetTech) syncNetTech.textContent = isOff ? 'SIN RED' : '5G LTE';
    if (lblNetTitle) lblNetTitle.textContent = isOff ? 'Cámara Frigorífica (Sin Conexión)' : 'Conectado al Gateway Central Nexa';
    if (lblNetSub) lblNetSub.textContent = isOff ? 'Las mutaciones se guardan localmente en Room SQLite' : 'Conexión activa · Listo para sincronizar';
  });

  btnForceSync?.addEventListener('click', () => {
    if (lblSyncBtn) lblSyncBtn.textContent = '✓ 3 Mutaciones Replicadas con Éxito';
    if (pillSyncStatus) {
      pillSyncStatus.className = 'meta-pill touch';
      pillSyncStatus.innerHTML = '<i class="pi pi-check"></i> 100% Sync OK';
    }
  });

  // =========================================================================
  // 13. SCREEN 3.1: Dispatch Dock & Seal (Mariela)
  // =========================================================================
  let palletCount = 4;
  const valPalletCount = document.getElementById('val-pallet-count');
  const btnPalletMinus = document.getElementById('btn-pallet-minus');
  const btnPalletPlus = document.getElementById('btn-pallet-plus');
  const chkSealVerified = document.getElementById('chk-seal-verified') as HTMLInputElement | null;
  const lblSealStatus = document.getElementById('lbl-seal-status');
  const btnAuthorizeDispatch = document.getElementById('btn-authorize-dispatch');
  const lblAuthDispatch = document.getElementById('lbl-auth-dispatch');
  const dispatchDockStatus = document.getElementById('dispatch-dock-status');

  btnPalletMinus?.addEventListener('click', () => {
    if (palletCount > 1) palletCount--;
    if (valPalletCount) valPalletCount.textContent = String(palletCount);
  });
  btnPalletPlus?.addEventListener('click', () => {
    if (palletCount < 12) palletCount++;
    if (valPalletCount) valPalletCount.textContent = String(palletCount);
  });

  chkSealVerified?.addEventListener('change', () => {
    if (lblSealStatus) {
      lblSealStatus.textContent = chkSealVerified.checked ? 'Precinto #NX-9921 verificado y sellado' : 'Falta verificación física de precinto';
    }
  });

  btnAuthorizeDispatch?.addEventListener('click', () => {
    if (lblAuthDispatch) lblAuthDispatch.textContent = '✓ Despacho Autorizado (WKN-892 en Ruta)';
    if (dispatchDockStatus) dispatchDockStatus.textContent = '● SALIDA AUTORIZADA';
  });

  // =========================================================================
  // 14. SCREEN 4.1: Wholesale Tier Pricing (Carlos Mendoza)
  // =========================================================================
  let catQty = 15;
  const valCatQuantity = document.getElementById('val-cat-quantity');
  const btnCatMinus = document.getElementById('btn-cat-minus');
  const btnCatPlus = document.getElementById('btn-cat-plus');
  const lblUnitPrice = document.getElementById('lbl-unit-price');
  const valCatTotal = document.getElementById('val-cat-total');
  const lblDiscountNote = document.getElementById('lbl-discount-note');
  const tierCol1 = document.getElementById('tier-col-1');
  const tierCol2 = document.getElementById('tier-col-2');
  const tierCol3 = document.getElementById('tier-col-3');

  function updateTierPricing() {
    let price = 45.00;
    tierCol1?.classList.remove('active');
    tierCol2?.classList.remove('active');
    tierCol3?.classList.remove('active');

    if (catQty >= 50) {
      price = 38.25;
      tierCol3?.classList.add('active');
      if (lblDiscountNote) lblDiscountNote.textContent = '✓ Tarifa paletizada (-15% dto.) aplicada';
    } else if (catQty >= 10) {
      price = 41.40;
      tierCol2?.classList.add('active');
      if (lblDiscountNote) lblDiscountNote.textContent = '✓ Descuento por volumen (-8%) aplicado';
    } else {
      tierCol1?.classList.add('active');
      if (lblDiscountNote) lblDiscountNote.textContent = 'Tarifa base por caja individual';
    }

    if (valCatQuantity) valCatQuantity.textContent = String(catQty);
    if (lblUnitPrice) lblUnitPrice.textContent = `Precio: $${price.toFixed(2)}/caja`;
    const total = (catQty * price).toFixed(2);
    if (valCatTotal) valCatTotal.textContent = `$${total} USD`;
  }

  btnCatMinus?.addEventListener('click', () => {
    if (catQty > 5) catQty -= 5;
    updateTierPricing();
  });
  btnCatPlus?.addEventListener('click', () => {
    if (catQty < 100) catQty += 5;
    updateTierPricing();
  });

  // =========================================================================
  // 15. SCREEN 4.2: Buyer Receipt & Discrepancy (Carlos Mendoza)
  // =========================================================================
  const chkBuyerDisc = document.getElementById('chk-buyer-disc') as HTMLInputElement | null;
  const lblBuyerDisc = document.getElementById('lbl-buyer-disc');
  const btnConfirmCustody = document.getElementById('btn-confirm-custody');

  chkBuyerDisc?.addEventListener('change', () => {
    if (lblBuyerDisc) {
      lblBuyerDisc.textContent = chkBuyerDisc.checked ? 'Reportando 1 caja descongelada (Foto adjunta)' : 'Sin anomalías reportadas';
    }
  });

  btnConfirmCustody?.addEventListener('click', () => {
    btnConfirmCustody.innerHTML = '<i class="pi pi-check"></i> Custodia Confirmada con Éxito';
  });

  // =========================================================================
  // 16. SCREEN 5.1: Biometrics Auth Trigger
  // =========================================================================
  const btnTriggerBio = document.getElementById('btn-trigger-bio');
  const bioIconSymbol = document.getElementById('bio-icon-symbol');
  const lblBioTitle = document.getElementById('lbl-bio-title');
  const lblBioSub = document.getElementById('lbl-bio-sub');
  const badgeAuthState = document.getElementById('badge-auth-state');
  const btnStartShift = document.getElementById('btn-start-shift') as HTMLButtonElement | null;

  btnTriggerBio?.addEventListener('click', () => {
    btnTriggerBio.classList.toggle('verified');
    const isVer = btnTriggerBio.classList.contains('verified');
    if (bioIconSymbol) bioIconSymbol.className = isVer ? 'pi pi-check-circle bio-icon' : 'pi pi-lock bio-icon';
    if (lblBioTitle) lblBioTitle.textContent = isVer ? 'Biometría Verificada con Éxito' : 'Toca para Autenticación Biométrica';
    if (lblBioSub) lblBioSub.textContent = isVer ? 'Sesión firmada con validez de 8 horas' : 'Huella dactilar o FaceID validado';
    if (badgeAuthState) {
      badgeAuthState.textContent = isVer ? '● AUTENTICADO' : '● PENDIENTE';
      badgeAuthState.className = 'status-pill-cyan';
    }
    if (btnStartShift) {
      btnStartShift.disabled = !isVer;
    }
  });

  // Hub option row selection
  document.querySelectorAll('.hub-option-row').forEach(row => {
    row.addEventListener('click', () => {
      document.querySelectorAll('.hub-option-row').forEach(r => r.classList.remove('active'));
      row.classList.add('active');
    });
  });
</script>
