---
/**
 * LoginScreenSpec.astro — Canonical Nexa Mobile Login & Welcome Specimen
 * Replicates the authentic full-screen mobile design from product mockup:
 *  - Nexa Deep Blue (#082846) canopy with organic topographical contour curves and smooth wave separator
 *  - Dual interactive views: Welcome Screen & Sign In Screen
 *  - Underline accent bar on Sign In
 *  - High-precision ergonomic input fields (Email, Password with eye toggle)
 *  - Role pre-fills for rapid evaluation (Conductor, Almacén, Comprador)
 *  - Knox biometric hardware authentication
 *  - 100% Green-free, WCAG AAA contrast, zero awkward margins
 */
---

<div class="nexa-mobile-auth-canvas mode-dual" id="mobile-auth-screen">
  
  <!-- Interactive View Toggle: Mockup Dual (Side-by-Side 1:1) <-> Bienvenida <-> Iniciar Sesión -->
  <div class="auth-mode-pill-bar">
    <button type="button" class="btn-auth-tab active" id="tab-auth-dual" data-mode="dual">
      <i class="pi pi-clone" style="font-size: 11px; margin-right: 4px;"></i>
      <span>✦ Mockup Dual (Side-by-Side 1:1)</span>
    </button>
    <button type="button" class="btn-auth-tab" id="tab-auth-welcome" data-mode="welcome">
      <span>01 · Bienvenida</span>
    </button>
    <button type="button" class="btn-auth-tab" id="tab-auth-login" data-mode="signin">
      <span>02 · Iniciar Sesión</span>
    </button>
  </div>

  <!-- Dual Showcase Stage on Nexa Blue Background (Matching media_1790577325551.png) -->
  <div class="dual-showcase-stage" id="auth-showcase-stage">

    <!-- =========================================================================
         PHONE 1: WELCOME / ONBOARDING SCREEN (Left Phone in Mockup)
         ========================================================================= -->
    <div class="phone-mockup-frame" id="phone-frame-welcome">
      <!-- Status Bar & Dynamic Island -->
      <div class="phone-notch-bar">
        <span class="phone-time">9:41</span>
        <div class="phone-dynamic-island"></div>
        <div class="phone-status-icons">
          <i class="pi pi-wifi"></i>
          <i class="pi pi-bolt"></i>
        </div>
      </div>

      <div class="auth-screen-inner">
        <!-- Top Canopy: Deep Nexa Blue with Topographical Contour Waves -->
        <div class="canopy-top-section welcome-canopy">
          <!-- Topographical SVG Isolines Texture ("azul nexa de fondo con curvas orgánicas") -->
          <svg class="topo-contour-mesh" viewBox="0 0 390 420" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <radialGradient id="topo-welcome-glow" cx="50%" cy="30%" r="65%">
                <stop offset="0%" stop-color="#1e40af" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#082846" stop-opacity="1" />
              </radialGradient>
            </defs>
            <rect width="390" height="420" fill="url(#topo-welcome-glow)" />

            <!-- Topographical Isolines (Authentic Organic Waves) -->
            <g fill="none" stroke="rgba(56, 189, 248, 0.22)" stroke-width="1.3">
              <ellipse cx="195" cy="160" rx="45" ry="32" />
              <ellipse cx="195" cy="160" rx="75" ry="54" />
              <ellipse cx="195" cy="160" rx="110" ry="80" />
              <ellipse cx="195" cy="160" rx="150" ry="110" />
              <ellipse cx="195" cy="160" rx="195" ry="145" />
              <ellipse cx="195" cy="160" rx="245" ry="185" />
              <ellipse cx="195" cy="160" rx="295" ry="225" />
              <ellipse cx="195" cy="160" rx="345" ry="265" />
              
              <!-- Secondary Ripple Center -->
              <ellipse cx="330" cy="280" rx="55" ry="40" stroke="rgba(56, 189, 248, 0.16)" />
              <ellipse cx="330" cy="280" rx="95" ry="70" stroke="rgba(56, 189, 248, 0.14)" />
              <ellipse cx="70" cy="100" rx="60" ry="45" stroke="rgba(56, 189, 248, 0.14)" />
            </g>

            <!-- Dynamic Wave Cutout at the bottom of the canopy -->
            <path 
              d="M 0,0 L 390,0 L 390,340 C 310,380 230,370 180,335 C 130,300 70,305 0,335 Z" 
              fill="#082846" 
              opacity="0.25"
            />
            <path 
              d="M 0,0 L 390,0 L 390,330 C 290,375 210,365 170,330 C 120,290 60,300 0,330 Z" 
              fill="#082846" 
              opacity="0.5"
            />
          </svg>

          <!-- Wave divider SVG path (Crisp White Boundary matching mockup) -->
          <svg class="organic-wave-divider" viewBox="0 0 390 80" preserveAspectRatio="none" aria-hidden="true">
            <path 
              d="M 0,35 C 90,65 175,70 235,42 C 295,14 345,18 390,40 L 390,80 L 0,80 Z" 
              fill="#ffffff"
            />
          </svg>

          <!-- Official Nexa Logo in Crisp White on the Blue Canopy -->
          <div class="canopy-brand-header">
            <img src="/assets/logo-nexa-white.svg" alt="Nexa" class="canopy-nexa-logo" />
            <span class="canopy-badge-pill">COLD-CHAIN 4.0</span>
          </div>
        </div>

        <!-- Bottom White Content Plane -->
        <div class="auth-white-plane welcome-plane">
          <div class="welcome-copy-wrap">
            <h1 class="welcome-title">Bienvenido</h1>
            <p class="welcome-desc">
              Acceso mayorista en tiempo real a la cadena de frío, monitoreo IoT de flota y liquidación automática B2B.
            </p>
          </div>

          <!-- Continue Arrow Button (Right Aligned matching mockup) -->
          <div class="welcome-bottom-action">
            <button type="button" class="btn-welcome-continue" id="btn-goto-signin" aria-label="Continuar a inicio de sesión">
              <span class="continue-text">Continuar</span>
              <span class="continue-circle">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </button>
          </div>
        </div>
      </div>

      <!-- Home Indicator -->
      <div class="phone-home-indicator" aria-hidden="true"></div>
    </div>

    <!-- =========================================================================
         PHONE 2: SIGN IN SCREEN (Right Phone in Mockup)
         ========================================================================= -->
    <div class="phone-mockup-frame" id="phone-frame-signin">
      <!-- Status Bar & Dynamic Island -->
      <div class="phone-notch-bar">
        <span class="phone-time">9:41</span>
        <div class="phone-dynamic-island"></div>
        <div class="phone-status-icons">
          <i class="pi pi-wifi"></i>
          <i class="pi pi-bolt"></i>
        </div>
      </div>

      <div class="auth-screen-inner">
        <!-- Top Canopy: Deep Nexa Blue with Topographical Contour Waves -->
        <div class="canopy-top-section signin-canopy">
          <!-- Topographical SVG Isolines Texture -->
          <svg class="topo-contour-mesh" viewBox="0 0 390 260" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <radialGradient id="topo-signin-glow" cx="50%" cy="20%" r="70%">
                <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#082846" stop-opacity="1" />
              </radialGradient>
            </defs>
            <rect width="390" height="260" fill="url(#topo-signin-glow)" />

            <!-- Isolines -->
            <g fill="none" stroke="rgba(56, 189, 248, 0.22)" stroke-width="1.3">
              <ellipse cx="220" cy="90" rx="35" ry="24" />
              <ellipse cx="220" cy="90" rx="65" ry="46" />
              <ellipse cx="220" cy="90" rx="100" ry="72" />
              <ellipse cx="220" cy="90" rx="140" ry="102" />
              <ellipse cx="220" cy="90" rx="185" ry="135" />
              <ellipse cx="220" cy="90" rx="235" ry="172" />
              <ellipse cx="70" cy="180" rx="60" ry="42" stroke="rgba(56, 189, 248, 0.14)" />
            </g>
          </svg>

          <!-- Organic Wave Divider to White Content -->
          <svg class="organic-wave-divider" viewBox="0 0 390 60" preserveAspectRatio="none" aria-hidden="true">
            <path 
              d="M 0,25 C 95,50 170,55 240,30 C 300,8 350,12 390,30 L 390,60 L 0,60 Z" 
              fill="#ffffff"
            />
          </svg>

          <!-- Brand Bar: Official White Logo -->
          <div class="canopy-brand-header">
            <img src="/assets/logo-nexa-white.svg" alt="Nexa" class="canopy-nexa-logo" />
            <button type="button" class="btn-canopy-back" id="btn-backto-welcome" title="Volver a Bienvenida">
              <i class="pi pi-arrow-left"></i>
            </button>
          </div>
        </div>

        <!-- Bottom White Content Plane: Form -->
        <div class="auth-white-plane signin-plane">
          
          <!-- Headline with Underline Bar (Exact match to user's uploaded mockup) -->
          <div class="signin-header-block">
            <h2 class="signin-title">Sign in</h2>
            <div class="signin-accent-bar" aria-hidden="true"></div>
          </div>

          <!-- Rapid Role Pre-fills for Quick Lab Testing -->
          <div class="quick-role-row" role="group" aria-label="Completar credenciales por rol">
            <button type="button" class="btn-mini-role active" data-email="diego.morales@nexa.pe" data-role="Conductor">
              <i class="pi pi-map-marker"></i> Conductor
            </button>
            <button type="button" class="btn-mini-role" data-email="alejandro.vargas@nexa.pe" data-role="Almacén">
              <i class="pi pi-box"></i> Almacén
            </button>
            <button type="button" class="btn-mini-role" data-email="carlos.mendoza@supermercados.pe" data-role="Comprador">
              <i class="pi pi-shopping-bag"></i> Comprador
            </button>
          </div>

          <!-- Clean Underlined Inputs matching User's Mockup -->
          <form class="auth-form-body" id="auth-signin-form" onsubmit="return false;">
            
            <!-- Email Input -->
            <div class="clean-field-group">
              <label for="signin-email-input" class="clean-field-label">Email</label>
              <div class="clean-input-row">
                <span class="clean-field-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </span>
                <input 
                  type="email" 
                  id="signin-email-input" 
                  class="clean-native-input" 
                  value="demo@email.com" 
                  placeholder="demo@email.com" 
                  required
                />
              </div>
              <div class="clean-field-line"></div>
            </div>

            <!-- Password Input with Eye Toggle -->
            <div class="clean-field-group">
              <label for="signin-pwd-input" class="clean-field-label">Password</label>
              <div class="clean-input-row">
                <span class="clean-field-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                </span>
                <input 
                  type="password" 
                  id="signin-pwd-input" 
                  class="clean-native-input" 
                  value="NexaCold2026!" 
                  placeholder="••••••••••••" 
                  required
                />
                <button type="button" class="btn-pwd-eye" id="btn-toggle-signin-pwd" aria-label="Mostrar u ocultar contraseña">
                  <svg id="eye-svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </button>
              </div>
              <div class="clean-field-line"></div>
            </div>

            <!-- Options: Remember Me & Forgot Password -->
            <div class="clean-options-row">
              <label class="clean-remember-label">
                <input type="checkbox" id="chk-signin-remember" checked />
                <span class="clean-check-box"></span>
                <span>Remember Me</span>
              </label>
              <a href="#forgot" class="clean-forgot-link">Forgot Password?</a>
            </div>

            <!-- Sign In Button (Solid Nexa Blue #2563eb, matching mockup) -->
            <button type="submit" class="btn-signin-primary" id="btn-submit-signin">
              <span>Sign in</span>
            </button>

            <!-- Biometric / Knox Hardware Quick Access -->
            <button type="button" class="btn-signin-biometric" id="btn-biometric-trigger">
              <i class="pi pi-shield"></i>
              <span>Autenticación Biométrica Knox</span>
            </button>

            <!-- Don't have an Account ? Sign up (Matching mockup) -->
            <div class="signin-signup-prompt">
              <span>Don't have an Account ?</span>
              <a href="#signup" class="signup-link">Sign up</a>
            </div>
          </form>

          <!-- Feedback Toast -->
          <div class="auth-feedback-toast" id="auth-toast" style="display: none;">
            <i class="pi pi-check-circle"></i>
            <span id="toast-text">Acceso autorizado. Conectando rampa...</span>
          </div>
        </div>
      </div>

      <!-- Home Indicator -->
      <div class="phone-home-indicator" aria-hidden="true"></div>
    </div>

  </div>
</div>

<style>
  /* --------------------------------------------------------------------------
     CANVAS & GENERAL LAYOUT (Full Screen Mobile Mock)
     -------------------------------------------------------------------------- */
  .nexa-mobile-auth-canvas {
    position: relative;
    width: 100%;
    min-height: 840px;
    background: radial-gradient(ellipse at 50% 20%, #0d3861 0%, #082846 60%, #051a2e 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    user-select: none;
    font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
    padding: 20px 16px 40px;
  }

  /* Top Mode Switcher Bar */
  .auth-mode-pill-bar {
    position: sticky;
    top: 12px;
    z-index: 35;
    display: inline-flex;
    background: rgba(8, 40, 70, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(56, 189, 248, 0.35);
    padding: 4px;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    margin-bottom: 24px;
  }

  .btn-auth-tab {
    background: transparent;
    border: none;
    padding: 6px 16px;
    border-radius: 9999px;
    color: rgba(224, 242, 254, 0.85);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
  }

  .btn-auth-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .btn-auth-tab.active {
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.5);
  }

  /* --------------------------------------------------------------------------
     DUAL SHOWCASE STAGE & HARDWARE PHONE FRAMES
     (Matching media_1790577325551.png with authentic titanium chassis & shadows)
     -------------------------------------------------------------------------- */
  .dual-showcase-stage {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 40px;
    width: 100%;
    max-width: 980px;
    transition: all 0.3s ease;
  }

  /* PHONE FRAME CHASSIS (iPhone 15/16 Pro style) */
  .phone-mockup-frame {
    position: relative;
    width: 375px;
    height: 760px;
    background: #ffffff;
    border-radius: 46px;
    border: 9px solid #18181b;
    box-shadow: 
      0 30px 80px -15px rgba(0, 0, 0, 0.7),
      0 12px 30px -5px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.12),
      inset 0 0 0 1.5px rgba(0, 0, 0, 0.85);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .phone-mockup-frame:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 36px 90px -15px rgba(0, 0, 0, 0.8),
      0 16px 36px -5px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(56, 189, 248, 0.35);
  }

  /* Mode Visibility Controls */
  .nexa-mobile-auth-canvas.mode-dual .phone-mockup-frame {
    display: flex;
  }

  .nexa-mobile-auth-canvas.mode-welcome #phone-frame-welcome {
    display: flex;
  }
  .nexa-mobile-auth-canvas.mode-welcome #phone-frame-signin {
    display: none;
  }

  .nexa-mobile-auth-canvas.mode-signin #phone-frame-welcome {
    display: none;
  }
  .nexa-mobile-auth-canvas.mode-signin #phone-frame-signin {
    display: flex;
  }

  /* PHONE HARDWARE TOP BAR & NOTCH / DYNAMIC ISLAND */
  .phone-notch-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    z-index: 25;
    pointer-events: none;
  }

  .phone-time {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
    width: 44px;
  }

  .phone-dynamic-island {
    width: 96px;
    height: 24px;
    background: #000000;
    border-radius: 20px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .phone-status-icons {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #ffffff;
    width: 44px;
    justify-content: flex-end;
  }

  /* PHONE INNER SCREEN */
  .auth-screen-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #ffffff;
  }

  /* PHONE HOME INDICATOR BAR */
  .phone-home-indicator {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 134px;
    height: 4.5px;
    background: #0f172a;
    border-radius: 9999px;
    z-index: 25;
    opacity: 0.65;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .dual-showcase-stage {
      flex-direction: column;
      gap: 32px;
    }
  }

  /* --------------------------------------------------------------------------
     CANOPY: NEXA BLUE TOPOGRAPHY & ORGANIC WAVE
     -------------------------------------------------------------------------- */
  .canopy-top-section {
    position: relative;
    width: 100%;
    background-color: #082846;
    overflow: hidden;
    flex-shrink: 0;
  }

  .welcome-canopy {
    height: 60%;
    min-height: 380px;
  }

  .signin-canopy {
    height: 36%;
    min-height: 230px;
  }

  .topo-contour-mesh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .organic-wave-divider {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 70px;
    z-index: 5;
    pointer-events: none;
  }

  .signin-canopy .organic-wave-divider {
    height: 52px;
  }

  .canopy-brand-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 48px 24px 12px;
  }

  .canopy-nexa-logo {
    height: 26px;
    width: auto;
    object-fit: contain;
  }

  .canopy-badge-pill {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38bdf8;
    letter-spacing: 0.05em;
  }

  .btn-canopy-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-canopy-back:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  /* --------------------------------------------------------------------------
     WHITE CONTENT PLANES
     -------------------------------------------------------------------------- */
  .auth-white-plane {
    position: relative;
    z-index: 10;
    background: #ffffff;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 10px 28px 28px;
  }

  /* WELCOME SCREEN CONTENT */
  .welcome-plane {
    justify-content: space-between;
    padding-top: 18px;
  }

  .welcome-copy-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .welcome-title {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 32px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .welcome-desc {
    font-size: 14px;
    line-height: 1.55;
    color: #64748b;
    margin: 0;
    max-width: 32ch;
  }

  .welcome-bottom-action {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 8px;
  }

  .btn-welcome-continue {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: transform 0.15s ease;
  }

  .btn-welcome-continue:hover {
    transform: translateX(4px);
  }

  .continue-text {
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
  }

  .continue-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-welcome-continue:hover .continue-circle {
    background: #1d4ed8;
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
  }

  /* SIGN IN SCREEN CONTENT */
  .signin-plane {
    gap: 14px;
    padding-top: 4px;
  }

  .signin-header-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .signin-title {
    font-family: var(--nexa-font-family-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 28px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .signin-accent-bar {
    width: 44px;
    height: 3.5px;
    background-color: #2563eb;
    border-radius: 2px;
  }

  /* Mini Role Chips */
  .quick-role-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-top: 4px;
  }

  .btn-mini-role {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 32px;
    padding: 0 6px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-mini-role.active {
    background: #eff6ff;
    border-color: #2563eb;
    color: #1d4ed8;
  }

  /* Clean Native Form matching User's Mockup */
  .auth-form-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 2px;
  }

  .clean-field-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .clean-field-label {
    font-size: 13px;
    font-weight: 600;
    color: #475569;
  }

  .clean-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 0;
  }

  .clean-field-icon {
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .clean-field-group:focus-within .clean-field-icon {
    color: #2563eb;
  }

  .clean-native-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 14.5px;
    font-weight: 600;
    color: #0f172a;
    font-family: inherit;
    padding: 0;
  }

  .clean-native-input::placeholder {
    color: #cbd5e1;
    font-weight: 400;
  }

  .clean-field-line {
    width: 100%;
    height: 1.5px;
    background-color: #e2e8f0;
    transition: background-color 0.2s ease, height 0.2s ease;
  }

  .clean-field-group:focus-within .clean-field-line {
    background-color: #2563eb;
    height: 2px;
  }

  .btn-pwd-eye {
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .btn-pwd-eye:hover {
    color: #0f172a;
  }

  /* Options Row */
  .clean-options-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12.5px;
    padding: 2px 0;
  }

  .clean-remember-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #64748b;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
  }

  .clean-remember-label input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  .clean-check-box {
    width: 17px;
    height: 17px;
    border-radius: 4px;
    border: 1.5px solid #cbd5e1;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .clean-remember-label input:checked ~ .clean-check-box {
    background: #2563eb;
    border-color: #2563eb;
  }

  .clean-remember-label input:checked ~ .clean-check-box::after {
    content: '';
    width: 4px;
    height: 8px;
    border: solid #ffffff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-bottom: 2px;
  }

  .clean-forgot-link {
    color: #2563eb;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .clean-forgot-link:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }

  /* Primary Button (Nexa Blue #2563eb) */
  .btn-signin-primary {
    height: 46px;
    border-radius: 12px;
    background: #2563eb;
    color: #ffffff;
    border: none;
    font-size: 15.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    transition: all 0.15s ease;
    margin-top: 2px;
  }

  .btn-signin-primary:hover {
    background: #1d4ed8;
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
    transform: translateY(-1px);
  }

  .btn-signin-primary:active {
    transform: scale(0.99);
  }

  /* Secondary Biometric Action */
  .btn-signin-biometric {
    height: 38px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-signin-biometric:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
  }

  .btn-signin-biometric i {
    color: #2563eb;
    font-size: 14px;
  }

  /* Sign up prompt */
  .signin-signup-prompt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 13px;
    color: #64748b;
    margin-top: 6px;
  }

  .signup-link {
    color: #2563eb;
    font-weight: 700;
    text-decoration: none;
  }

  .signup-link:hover {
    text-decoration: underline;
  }

  /* Toast Notification */
  .auth-feedback-toast {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 10px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1d4ed8;
    font-size: 12.5px;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    animation: toastPop 0.2s ease;
    z-index: 40;
  }

  @keyframes toastPop {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  function initAuthSpecimens() {
    document.querySelectorAll<HTMLElement>('.nexa-mobile-auth-canvas').forEach(canvas => {
      const tabDual = canvas.querySelector<HTMLButtonElement>('#tab-auth-dual');
      const tabWelcome = canvas.querySelector<HTMLButtonElement>('#tab-auth-welcome');
      const tabLogin = canvas.querySelector<HTMLButtonElement>('#tab-auth-login');
      const tabs = [tabDual, tabWelcome, tabLogin];

      const btnContinue = canvas.querySelector<HTMLButtonElement>('#btn-goto-signin');
      const btnBack = canvas.querySelector<HTMLButtonElement>('#btn-backto-welcome');

      function setMode(mode: 'dual' | 'welcome' | 'signin') {
        canvas.classList.remove('mode-dual', 'mode-welcome', 'mode-signin');
        canvas.classList.add(`mode-${mode}`);

        tabs.forEach(t => t?.classList.remove('active'));
        if (mode === 'dual') tabDual?.classList.add('active');
        if (mode === 'welcome') tabWelcome?.classList.add('active');
        if (mode === 'signin') tabLogin?.classList.add('active');
      }

      tabDual?.addEventListener('click', () => setMode('dual'));
      tabWelcome?.addEventListener('click', () => setMode('welcome'));
      tabLogin?.addEventListener('click', () => setMode('signin'));

      btnContinue?.addEventListener('click', () => {
        setMode('signin');
      });

      btnBack?.addEventListener('click', () => {
        setMode('welcome');
      });

      // Scoped Role Fillers
      const roleButtons = canvas.querySelectorAll<HTMLButtonElement>('.btn-mini-role');
      const emailInput = canvas.querySelector<HTMLInputElement>('#signin-email-input');

      roleButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          roleButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const email = btn.getAttribute('data-email');
          if (emailInput && email) {
            emailInput.value = email;
          }
        });
      });

      // Password Visibility Toggle
      const btnToggleEye = canvas.querySelector<HTMLButtonElement>('#btn-toggle-signin-pwd');
      const pwdInput = canvas.querySelector<HTMLInputElement>('#signin-pwd-input');

      btnToggleEye?.addEventListener('click', () => {
        if (!pwdInput) return;
        const isPwd = pwdInput.type === 'password';
        pwdInput.type = isPwd ? 'text' : 'password';
      });

      // Form Submit Simulation
      const signinForm = canvas.querySelector<HTMLFormElement>('#auth-signin-form');
      const toast = canvas.querySelector<HTMLElement>('#auth-toast');
      const toastText = canvas.querySelector<HTMLElement>('#toast-text');
      const btnBio = canvas.querySelector<HTMLButtonElement>('#btn-biometric-trigger');

      function triggerToast(msg: string) {
        if (toast && toastText) {
          toastText.textContent = msg;
          toast.style.display = 'flex';
          setTimeout(() => {
            toast.style.display = 'none';
          }, 3500);
        }
      }

      signinForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        triggerToast(`Autenticado como ${emailInput?.value || 'operador'}. Iniciando sesión segura...`);
      });

      btnBio?.addEventListener('click', () => {
        triggerToast('Huella Knox / Zebra verificada. Espacio de trabajo desbloqueado.');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuthSpecimens);
  } else {
    initAuthSpecimens();
  }
</script>
