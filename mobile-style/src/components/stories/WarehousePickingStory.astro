<script>
  // Phase tabs interaction
  const phaseButtons = document.querySelectorAll('#story-bodega .phase-btn');
  const phasePanels = document.querySelectorAll('#story-bodega .phase-panel');

  phaseButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      phaseButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const phase = btn.getAttribute('data-phase');
      phasePanels.forEach(panel => {
        panel.classList.toggle('active', panel.id === `panel-phase-${phase}`);
      });
    });
  });

  // Glove Stepper Interaction (+/-)
  const countEl = document.getElementById('stepper-count');
  const minusBtn = document.getElementById('btn-pick-minus');
  const plusBtn = document.getElementById('btn-pick-plus');
  let currentCount = 16;

  if (minusBtn && plusBtn && countEl) {
    minusBtn.addEventListener('click', () => {
      if (currentCount > 0) {
        currentCount--;
        countEl.textContent = String(currentCount);
      }
    });

    plusBtn.addEventListener('click', () => {
      currentCount++;
      countEl.textContent = String(currentCount);
    });
  }
</script>
