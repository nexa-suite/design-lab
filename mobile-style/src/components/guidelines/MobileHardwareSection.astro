---
/**
 * MobileHardwareSection.astro
 * Canonical Hardware & Field Sensor Integration for Android
 * Covers CameraX GS1-128 Burst Scanning, GPS Geofencing (200m), BLE Temperature Telemetry (2.0°C – 6.0°C),
 * Mandatory Manual Fallback & Production Kotlin 2.4 Integration Contracts.
 */
---

<div class="hardware-container" id="sec-hardware-camerax" data-platform-target="kotlin">

  <!-- ==========================================================================
       1. ESCANEO ÓPTICO CAMERAX & ML KIT (CON FALLBACK OBLIGATORIO)
       ========================================================================== -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">01</span>
        <div>
          <p class="cuadro-kicker">HARDWARE MÓVIL · CAMERAX 1.4 & ML KIT VISION</p>
          <h3 class="cuadro-title">Escaneo Láser Óptico de Códigos GS1-128 & Fallback Numérico</h3>
          <p class="cuadro-subtitle">
            Integración de hardware para captura burst de códigos de barras (GS1-128, DataMatrix, QR) en guías de remisión y bultos de almacén. Implementa <strong>CameraX ImageAnalysis.Analyzer</strong> con delegación a <strong>Google ML Kit Barcode Scanning</strong> y soporte nativo para terminales Zebra DataWedge vía <code>Android Intents</code>.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag primary"><i class="pi pi-qrcode"></i> CameraX 60 FPS</span>
        <span class="cuadro-tag success"><i class="pi pi-barcode"></i> GS1-128 / QR</span>
        <span class="cuadro-tag warning"><i class="pi pi-shield"></i> Fallback 48dp Mandatario</span>
      </div>
    </div>

    <!-- Fallback Requirement Banner -->
    <div class="field-rule-banner">
      <div class="rule-icon"><i class="pi pi-exclamation-circle"></i></div>
      <div class="rule-text">
        <strong>Mandato de Arquitectura de Campo (ADR-0018): Fallback Numérico Obligatorio</strong>
        <p>
          En condiciones de obra (polvo, manchas de grasa en etiquetas térmicas, código roto o falta de iluminación en tolva), el escaneo óptico puede fallar. <strong>Bajo ninguna circunstancia se detiene el despacho</strong>: la pantalla de escáner debe ofrecer <em>permanentemente</em> un teclado numérico táctil de 48dp y validación manual directa sin cambiar de pantalla.
        </p>
      </div>
    </div>

    <!-- Live Scanner Architecture Specimen -->
    <div class="scanner-specimen-layout">
      <div class="scanner-mock-view">
        <div class="cam-lens-header">
          <span><i class="pi pi-camera"></i> CameraX PreviewView</span>
          <span class="fps-tag">60 FPS · Autofocus Activo</span>
        </div>
        <div class="cam-lens-body">
          <div class="reticle-box">
            <div class="reticle-laser"></div>
            <span class="reticle-text">Alinee guía física GS1-128 aquí</span>
          </div>
        </div>
        <div class="scanner-status-strip">
          <span><i class="pi pi-bolt"></i> Flash: Auto</span>
          <span><i class="pi pi-volume-up"></i> Beep: On</span>
          <span><i class="pi pi-mobile"></i> Haptic: Heavy</span>
        </div>
      </div>

      <div class="scanner-fallback-panel">
        <span class="panel-kicker">INTERFAZ DE CONTINGENCIA EN CAMPO</span>
        <h4 class="panel-title">Entrada Manual Inmediata</h4>
        <p class="panel-desc">Disponible en todo momento sin salir del flujo de escaneo:</p>

        <div class="manual-input-box">
          <label for="inp-fallback-code">Código de Guía o SKU (10 dígitos)</label>
          <div class="input-action-row">
            <input type="text" id="inp-fallback-code" value="SO-2026-0018-01" readonly />
            <button type="button" class="btn-validate">
              <i class="pi pi-check"></i> Validar
            </button>
          </div>
        </div>

        <div class="hardware-specs-list">
          <div class="spec-pill-item"><i class="pi pi-bolt"></i> Linterna LED Forzada</div>
          <div class="spec-pill-item"><i class="pi pi-tablet"></i> Zebra DataWedge Broadcast</div>
          <div class="spec-pill-item"><i class="pi pi-check-circle"></i> Deduplicación 500ms</div>
        </div>
      </div>
    </div>

    <!-- Production Kotlin CameraX Code Block -->
    <div class="code-container-block">
      <div class="code-header-bar">
        <div class="code-header-title">
          <i class="pi pi-file"></i>
          <span>core/hardware/src/main/kotlin/com/nexa/core/hardware/scanner/BarcodeAnalyzer.kt</span>
        </div>
        <span class="code-lang-pill">Kotlin 2.4</span>
      </div>
      <pre class="code-pre-box" is:raw><code><span class="comm">// CameraX ImageAnalysis.Analyzer with ML Kit Vision for GS1-128 burst scanning</span>
<span class="kw">package</span> com.nexa.core.hardware.scanner

<span class="kw">import</span> androidx.camera.core.ExperimentalGetImage
<span class="kw">import</span> androidx.camera.core.ImageAnalysis
<span class="kw">import</span> androidx.camera.core.ImageProxy
<span class="kw">import</span> com.google.mlkit.vision.barcode.BarcodeScanning
<span class="kw">import</span> com.google.mlkit.vision.barcode.common.Barcode
<span class="kw">import</span> com.google.mlkit.vision.common.InputImage

<span class="kw">class</span> <span class="type">NexaBarcodeAnalyzer</span>(
    <span class="kw">private val</span> onBarcodeDetected: (<span class="type">String</span>) -> <span class="type">Unit</span>
) : <span class="type">ImageAnalysis.Analyzer</span> {

    <span class="kw">private val</span> scanner = <span class="fn">BarcodeScanning</span>.getClient()
    <span class="kw">private var</span> lastScannedTime = <span class="num">0L</span>

    <span class="ann">@androidx.annotation.OptIn</span>(ExperimentalGetImage::<span class="kw">class</span>)
    <span class="kw">override fun</span> <span class="fn">analyze</span>(imageProxy: <span class="type">ImageProxy</span>) {
        <span class="kw">val</span> mediaImage = imageProxy.image
        <span class="kw">if</span> (mediaImage != <span class="kw">null</span>) {
            <span class="kw">val</span> image = <span class="fn">InputImage</span>.fromMediaImage(mediaImage, imageProxy.imageInfo.rotationDegrees)
            scanner.<span class="fn">process</span>(image)
                .addOnSuccessListener { barcodes ->
                    <span class="kw">for</span> (barcode <span class="kw">in</span> barcodes) {
                        <span class="kw">val</span> rawValue = barcode.rawValue
                        <span class="kw">val</span> now = System.currentTimeMillis()
                        <span class="comm">// Anti-rebote de 500ms para escaneo burst confiable</span>
                        <span class="kw">if</span> (rawValue != <span class="kw">null</span> && (now - lastScannedTime > <span class="num">500L</span>)) {
                            lastScannedTime = now
                            onBarcodeDetected(rawValue)
                        }
                    }
                }
                .addOnCompleteListener { imageProxy.<span class="fn">close</span>() }
        } <span class="kw">else</span> {
            imageProxy.<span class="fn">close</span>()
        }
    }
}</code></pre>
    </div>
  </section>

  <!-- ==========================================================================
       2. GEOCERCAS GPS (200m) & TELEMETRÍA BLE CADENA DE FRÍO (2°C – 6°C)
       ========================================================================== -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">02</span>
        <div>
          <p class="cuadro-kicker">SENSORES DE CAMPO · GPS FUSED & BLUETOOTH LOW ENERGY</p>
          <h3 class="cuadro-title">Geocercas GPS (Radio 200m) & Telemetría BLE de Cadena de Frío</h3>
          <p class="cuadro-subtitle">
            Detección automática de arribo a muelles de descarga sin intervención del chofer y monitoreo térmico continuo en cámaras de transporte (rango reglamentario de <strong>2.0°C a 6.0°C</strong>).
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag primary"><i class="pi pi-map-marker"></i> Geocerca 200m GPS</span>
        <span class="cuadro-tag success"><i class="pi pi-wifi"></i> BLE GATT 2°C – 6°C</span>
      </div>
    </div>

    <!-- CUADRO ARQUITECTÓNICO: Especificación de Sensores de Campo -->
    <div class="contract-table-wrapper">
      <table class="contract-table">
        <thead>
          <tr>
            <th>Subsistema de Hardware</th>
            <th>API Android / SDK</th>
            <th>Rango / Tolerancia</th>
            <th>Frecuencia de Muestreo</th>
            <th>Acción Automática del Sistema</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Geocerca de Arribo a Muelle</strong></td>
            <td><code>FusedLocationProviderClient</code> / <code>GeofencingClient</code></td>
            <td>Radio de <strong>200 metros</strong> en torno a coordenadas de obra</td>
            <td>Notificación en segundo plano al ingresar (GEOFENCE_TRANSITION_ENTER)</td>
            <td>Transición de estado de ruta a <code>ARRIVED_GEOFENCE</code>, desbloqueo de botón de firma</td>
          </tr>
          <tr>
            <td><strong>Telemetría BLE de Cadena de Frío</strong></td>
            <td><code>BluetoothGattCallback</code> / <code>BluetoothLeScanner</code></td>
            <td>Rango seguro calibrado: <strong>2.0°C a 6.0°C</strong> (&plusmn;0.2°C)</td>
            <td>Lectura asíncrona cada 30 segundos en ruta</td>
            <td>Si T &gt; 6.0°C por más de 10 min, emite alerta crítica sonora y marca lote para inspección</td>
          </tr>
          <tr>
            <td><strong>Láser Rugerizado Zebra</strong></td>
            <td>Zebra DataWedge Service (Broadcast Intents)</td>
            <td>Lectura 1D/2D hasta 3 metros de distancia</td>
            <td>Instantánea por gatillo físico de terminal</td>
            <td>Inyección directa de evento <code>BarcodeScannedEvent</code> en ViewModel</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Production Kotlin Geofence Code Block -->
    <div class="code-container-block">
      <div class="code-header-bar">
        <div class="code-header-title">
          <i class="pi pi-file"></i>
          <span>core/hardware/src/main/kotlin/com/nexa/core/hardware/location/GeofenceManager.kt</span>
        </div>
        <span class="code-lang-pill">Kotlin 2.4</span>
      </div>
      <pre class="code-pre-box" is:raw><code><span class="comm">// GPS Geofencing (200m radius) with FusedLocationProviderClient</span>
<span class="kw">package</span> com.nexa.core.hardware.location

<span class="kw">import</span> android.annotation.SuppressLint
<span class="kw">import</span> android.app.PendingIntent
<span class="kw">import</span> android.content.Context
<span class="kw">import</span> com.google.android.gms.location.Geofence
<span class="kw">import</span> com.google.android.gms.location.GeofencingClient
<span class="kw">import</span> com.google.android.gms.location.GeofencingRequest
<span class="kw">import</span> com.google.android.gms.location.LocationServices

<span class="kw">class</span> <span class="type">NexaGeofenceManager</span>(<span class="kw">private val</span> context: <span class="type">Context</span>) {

    <span class="kw">private val</span> geofencingClient: <span class="type">GeofencingClient</span> =
        <span class="fn">LocationServices</span>.getGeofencingClient(context)

    <span class="ann">@SuppressLint</span>(<span class="str">"MissingPermission"</span>)
    <span class="kw">fun</span> <span class="fn">registerDockGeofence</span>(
        orderId: <span class="type">String</span>,
        latitude: <span class="type">Double</span>,
        longitude: <span class="type">Double</span>,
        pendingIntent: <span class="type">PendingIntent</span>
    ) {
        <span class="kw">val</span> geofence = <span class="fn">Geofence.Builder</span>()
            .setRequestId(orderId)
            .setCircularRegion(latitude, longitude, <span class="num">200f</span>) <span class="comm">// Radio canónico 200m</span>
            .setExpirationDuration(Geofence.NEVER_EXPIRE)
            .setTransitionTypes(Geofence.GEOFENCE_TRANSITION_ENTER or Geofence.GEOFENCE_TRANSITION_EXIT)
            .build()

        <span class="kw">val</span> request = <span class="fn">GeofencingRequest.Builder</span>()
            .setInitialTrigger(GeofencingRequest.INITIAL_TRIGGER_ENTER)
            .addGeofence(geofence)
            .build()

        geofencingClient.<span class="fn">addGeofences</span>(request, pendingIntent)
    }
}</code></pre>
    </div>
  </section>

</div>

<style>
  .hardware-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
  }

  .field-rule-banner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 12px;
    color: #92400e;

    .rule-icon {
      font-size: 18px;
      color: #d97706;
      margin-top: 2px;
      flex-shrink: 0;
    }

    .rule-text {
      display: flex;
      flex-direction: column;
      gap: 3px;

      strong { font-size: 13px; color: #78350f; }
      p { font-size: 12px; line-height: 1.5; margin: 0; color: #92400e; }
    }
  }

  .scanner-specimen-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 16px;
    border: 1px solid var(--nexa-color-border-default, #e2e8f0);
    border-radius: 12px;
    overflow: hidden;
    background: #f8fafc;
  }

  @media (max-width: 800px) {
    .scanner-specimen-layout {
      grid-template-columns: 1fr;
    }
  }

  .scanner-mock-view {
    background: #090e17;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    padding: 14px;
    gap: 10px;
  }

  .cam-lens-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    color: #94a3b8;
    font-family: var(--nexa-font-family-mono, monospace);
  }

  .fps-tag { color: #38bdf8; }

  .cam-lens-body {
    flex: 1;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, #172554 0%, #030712 100%);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
  }

  .reticle-box {
    width: 140px;
    height: 140px;
    border: 2px dashed #38c8ff;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .reticle-laser {
    width: 90%;
    height: 2px;
    background: #38c8ff;
    box-shadow: 0 0 10px #38c8ff;
    position: absolute;
    animation: laserScan 2s infinite alternate;
  }

  @keyframes laserScan {
    0% { top: 15%; }
    100% { top: 85%; }
  }

  .reticle-text {
    font-size: 9px;
    color: #cbd5e1;
    background: rgba(0,0,0,0.6);
    padding: 2px 6px;
    border-radius: 4px;
    position: absolute;
    bottom: -20px;
    white-space: nowrap;
  }

  .scanner-status-strip {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: #94a3b8;
    padding-top: 6px;
    border-top: 1px solid #1e293b;
  }

  .scanner-fallback-panel {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #ffffff;

    .panel-kicker {
      font-size: 9.5px;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: #d97706;
    }

    .panel-title {
      font-family: var(--nexa-font-family-display, sans-serif);
      font-size: 16px;
      font-weight: 700;
      color: #0f172a;
      margin: 0;
    }

    .panel-desc {
      font-size: 12.5px;
      color: #64748b;
      margin: 0;
    }
  }

  .manual-input-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 6px;

    label {
      font-size: 11.5px;
      font-weight: 700;
      color: #475569;
    }
  }

  .input-action-row {
    display: flex;
    gap: 8px;

    input {
      flex: 1;
      height: 48px;
      padding: 0 12px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 13px;
      font-weight: 700;
      background: #f8fafc;
      color: #0f172a;
      outline: none;
    }
  }

  .btn-validate {
    height: 48px;
    padding: 0 18px;
    background: var(--nexa-color-primary-600, #2a67d9);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;

    &:hover { background: #1d4ed8; }
  }

  .hardware-specs-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .spec-pill-item {
    font-size: 11px;
    color: #334155;
    background: #f1f5f9;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
    display: inline-flex;
    align-items: center;
    gap: 4px;

    i { font-size: 11px; color: #2a67d9; }
  }
</style>
