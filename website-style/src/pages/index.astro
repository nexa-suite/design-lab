---
/**
 * WEBSITE STYLE — MASTER NEXAFY LIVING GEOMETRY SYSTEM & WORKBENCH
 * Authority: Nexafy living geometry system, pure solid colorimetry, and landing guidelines.
 */
import 'primeicons/primeicons.css';
import '../styles/tokens.css';
import MonorepoNavHeader from '../components/layout/MonorepoNavHeader.astro';
import NexafyLivingEngine from '../components/guidelines/NexafyLivingEngine.astro';
import ColorimetriaSection from '../components/guidelines/ColorimetriaSection.astro';
import TipografiaSection from '../components/guidelines/TipografiaSection.astro';
import GeometriaSpacingSection from '../components/guidelines/GeometriaSpacingSection.astro';
import ComponentesNexaUiSection from '../components/guidelines/ComponentesNexaUiSection.astro';
---

<!DOCTYPE html>
<html lang="en" data-contrast-mode="standard">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Website Style · Nexafy Living Geometry System (Nexa Suite)</title>

  <!-- Google Fonts for Canonical Nexa Foundations -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link 
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" 
    rel="stylesheet"
  >

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--nexa-surface-page, #f6faff);
      color: var(--nexa-color-text-primary, #0f172a);
      font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    /* Tab Navigation Bar */
    .tab-nav-bar {
      display: flex;
      align-items: center;
      padding: 0 1.5rem;
      gap: 0.5rem;
      overflow-x: auto;
      background: #ffffff;
      border-bottom: 1px solid var(--nexa-color-border-default, #e2e8f0);
    }

    .tab-button {
      padding: 0.75rem 1rem;
      font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
      font-size: 13px;
      font-weight: 600;
      color: var(--nexa-color-text-secondary, #64748b);
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .tab-button:hover {
      color: var(--nexa-color-text-primary, #0f172a);
    }

    .tab-button.active {
      color: var(--nexa-color-primary-600, #2a67d9);
      border-bottom-color: var(--nexa-color-primary-600, #2a67d9);
      font-weight: 700;
    }

    /* Main Container */
    .guidelines-main {
      flex: 1;
      width: 100%;
      margin: 0 auto;
    }

    .tab-pane {
      display: none;
    }

    .tab-pane.active {
      display: block;
      animation: fadeIn 0.2s ease-in-out;
    }

    .guidelines-content-wrapper {
      max-width: 1440px;
      margin: 0 auto;
      padding: 1.5rem;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Footer Note */
    .guidelines-footer {
      background: #ffffff;
      border-top: 1px solid var(--nexa-color-border-default, #e2e8f0);
      padding: 1rem 1.5rem;
      font-size: 12px;
      color: var(--nexa-color-text-secondary, #64748b);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-links {
      display: flex;
      gap: 1rem;
    }

    .footer-links a {
      color: var(--nexa-color-primary-700, #1b4fb8);
      text-decoration: none;
      font-weight: 600;
    }

    .footer-links a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

  <!-- Top Monorepo & Navigation Header -->
  <MonorepoNavHeader currentSection="workbench" />

  <!-- Navigation Tabs: Motor Gráfico Vivo is FIRST and ACTIVE by default -->
  <nav class="tab-nav-bar" role="tablist">
    <button type="button" class="tab-button active" data-tab="motor-grafico" role="tab" aria-selected="true">
      <i class="pi pi-bolt" aria-hidden="true"></i>
      <span>✦ Motor Gráfico Nexafy (Workbench Vivo)</span>
    </button>
    <button type="button" class="tab-button" data-tab="colorimetria" role="tab" aria-selected="false">
      <i class="pi pi-palette" aria-hidden="true"></i>
      <span>Colorimetría Sólida & Tokens</span>
    </button>
    <button type="button" class="tab-button" data-tab="tipografia" role="tab" aria-selected="false">
      <i class="pi pi-align-left" aria-hidden="true"></i>
      <span>Tipografía & Jerarquía de Landing</span>
    </button>
    <button type="button" class="tab-button" data-tab="geometria" role="tab" aria-selected="false">
      <i class="pi pi-th-large" aria-hidden="true"></i>
      <span>Geometría & Conductos Vasculares</span>
    </button>
    <button type="button" class="tab-button" data-tab="componentes" role="tab" aria-selected="false">
      <i class="pi pi-box" aria-hidden="true"></i>
      <span>Componentes UI de Conversión</span>
    </button>
  </nav>

  <!-- Main Content Panes -->
  <main class="guidelines-main">
    
    <!-- Tab 1 (DEFAULT & PRIMARY): Motor Gráfico Nexafy Vivo -->
    <div id="pane-motor-grafico" class="tab-pane active" role="tabpanel">
      <NexafyLivingEngine />
    </div>

    <!-- Tab 2: Colorimetría -->
    <div id="pane-colorimetria" class="tab-pane" role="tabpanel">
      <div class="guidelines-content-wrapper">
        <ColorimetriaSection />
      </div>
    </div>

    <!-- Tab 3: Tipografía -->
    <div id="pane-tipografia" class="tab-pane" role="tabpanel">
      <div class="guidelines-content-wrapper">
        <TipografiaSection />
      </div>
    </div>

    <!-- Tab 4: Espaciado & Geometría -->
    <div id="pane-geometria" class="tab-pane" role="tabpanel">
      <div class="guidelines-content-wrapper">
        <GeometriaSpacingSection />
      </div>
    </div>

    <!-- Tab 5: Componentes Nexa UI -->
    <div id="pane-componentes" class="tab-pane" role="tabpanel">
      <div class="guidelines-content-wrapper">
        <ComponentesNexaUiSection />
      </div>
    </div>

  </main>

  <!-- Footer -->
  <footer class="guidelines-footer">
    <div>
      <strong>Nexafy · Living Geometry System (Website Style)</strong> · Pure flat solid colorimetry (Nexa Dark Blue #082846 & Celeste #38c8ff · 0 Gradients · 28px Conduits).
    </div>
    <div class="footer-links">
      <a href="/artifacts">Ver Catálogo de Artefactos Vivos &rarr;</a>
      <a href="/landing-spec">Ver Landing Specs &rarr;</a>
    </div>
  </footer>

  <script>
    // Tab Switching Logic
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-button');
    const tabPanes = document.querySelectorAll<HTMLElement>('.tab-pane');

    function switchTab(tabId: string) {
      tabButtons.forEach(btn => {
        const isTarget = btn.getAttribute('data-tab') === tabId;
        btn.classList.toggle('active', isTarget);
        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      tabPanes.forEach(pane => {
        pane.classList.toggle('active', pane.id === `pane-${tabId}`);
      });
    }

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-tab');
        if (tabId) switchTab(tabId);
      });
    });

    // Contrast Toggle
    const btnContrast = document.getElementById('btn-toggle-contrast');
    const contrastLabel = document.getElementById('contrast-label');
    let isHighContrast = false;

    btnContrast?.addEventListener('click', () => {
      isHighContrast = !isHighContrast;
      document.documentElement.setAttribute('data-contrast-mode', isHighContrast ? 'increased' : 'standard');
      if (contrastLabel) {
        contrastLabel.textContent = isHighContrast ? 'Contraste Alto' : 'Contraste Estándar';
      }
      btnContrast.classList.toggle('active', isHighContrast);
    });
  </script>
</body>
</html>
