---
/**
 * UnifiedLabShell — Master Monorepo Shell for Mobile Style
 * 100% unified visual design with Web Style shell (Sidebar, Topbar, Search, Suite Switcher, Evaluation).
 */
import NexaLogo from '../common/NexaLogo.astro';

interface Props {
  currentSection?: string;
}

const { currentSection = 'overview' } = Astro.props;
---

<div class="lab-shell" id="app-shell" data-current-section={currentSection}>
  <!-- Left Master Sidebar (284px width, unified with web-style) -->
  <aside class="lab-sidebar" aria-label="Mobile Style Navigation">
    <a class="lab-brand" href="/" title="Ir a la portada de Mobile Style">
      <NexaLogo variant="primary" height={26} />
      <span>DESIGN LAB <b>v1.2.0 · Mobile Style</b></span>
    </a>

    <p class="lab-context">
      Especificación canónica móvil, Jetpack Compose (:core:designsystem), Flutter y simulador de hardware.
    </p>

    <!-- Unified Monorepo Suite Switcher -->
    <div class="monorepo-suite-switcher" aria-label="Nexa Style Triad">
      <span class="suite-title">STYLE MONOREPO</span>
      <div class="suite-links">
        <a href="http://localhost:8080" class="suite-pill link" target="_self" title="Ir al Master Hub (General Style Guidelines)">
          <i class="pi pi-home" aria-hidden="true"></i> Hub
        </a>
        <a href="http://localhost:4200" class="suite-pill link" target="_self" title="Ir a Web Style Guidelines (Angular & PrimeNG)">
          <i class="pi pi-desktop" aria-hidden="true"></i> Web
        </a>
        <span class="suite-pill active" title="Actualmente visualizando Mobile Style">
          <i class="pi pi-mobile" aria-hidden="true"></i> Mobile
        </span>
        <a href="http://localhost:4321" class="suite-pill link" target="_self" title="Ir a Website Style Guidelines & Nexafy Living Geometry">
          <i class="pi pi-globe" aria-hidden="true"></i> Website
        </a>
      </div>
    </div>

    <!-- Search Control with keyboard shortcut '/' -->
    <div class="lab-search">
      <label for="mobile-sidebar-search">BUSCAR ESPECIFICACIÓN</label>
      <div class="search-control">
        <i class="pi pi-search" aria-hidden="true"></i>
        <input
          id="mobile-sidebar-search"
          type="search"
          autocomplete="off"
          placeholder="Buscar tokens, componentes... (/)"
        />
        <button type="button" class="clear-search" id="btn-clear-search" aria-label="Limpiar búsqueda" style="display: none;">
          <i class="pi pi-times" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <!-- Navigation Groups with Accordions (Exclusive Mobile Content) -->
    <nav class="lab-nav" aria-label="Secciones de la documentación móvil">
      <!-- 1. Simulador & Calibrador Android -->
      <section class="lab-nav-group">
        <button class="nav-section-button" type="button" data-nav-group="simulator">
          <span class="nav-section">SIMULADOR & ACCESO M3</span>
          <i class="pi pi-chevron-down toggle-icon" aria-hidden="true"></i>
        </button>
        <div class="lab-nav-items">
          <a class="lab-nav-item active" href="#screen-simulator" data-screen="screen-simulator">
            <i class="pi pi-mobile" aria-hidden="true"></i>
            <span>Simulador & Calibrador M3</span>
          </a>
          <a class="lab-nav-item" href="#screen-login" data-screen="screen-login">
            <i class="pi pi-lock" aria-hidden="true"></i>
            <span>Login & Workspace Access</span>
          </a>
        </div>
      </section>

      <!-- 2. Operaciones en Campo & Módulos en Vivo -->
      <section class="lab-nav-group">
        <button class="nav-section-button" type="button" data-nav-group="operations">
          <span class="nav-section">OPERACIONES EN CAMPO</span>
          <i class="pi pi-chevron-down toggle-icon" aria-hidden="true"></i>
        </button>
        <div class="lab-nav-items">
          <a class="lab-nav-item" href="#screen-modules" data-screen="screen-modules">
            <i class="pi pi-sliders-h" aria-hidden="true"></i>
            <span>Módulos Interactivos en Vivo</span>
          </a>
          <a class="lab-nav-item" href="#screen-components" data-screen="screen-components">
            <i class="pi pi-id-card" aria-hidden="true"></i>
            <span>Catálogo Canónico Compose</span>
          </a>
        </div>
      </section>

      <!-- 3. Ergonomía & Hardware de Campo -->
      <section class="lab-nav-group">
        <button class="nav-section-button" type="button" data-nav-group="ergonomics">
          <span class="nav-section">ERGONOMÍA & HARDWARE</span>
          <i class="pi pi-chevron-down toggle-icon" aria-hidden="true"></i>
        </button>
        <div class="lab-nav-items">
          <a class="lab-nav-item" href="#screen-foundations-ergonomics" data-screen="screen-foundations-ergonomics">
            <i class="pi pi-hand" aria-hidden="true"></i>
            <span>Diana Táctil 48dp vs 56dp</span>
          </a>
          <a class="lab-nav-item" href="#screen-foundations-reach" data-screen="screen-foundations-reach">
            <i class="pi pi-chart-pie" aria-hidden="true"></i>
            <span>Zonas de Alcance del Pulgar</span>
          </a>
        </div>
      </section>

      <!-- 4. Código Nativo & Mocks Kotlin -->
      <section class="lab-nav-group">
        <button class="nav-section-button" type="button" data-nav-group="technical">
          <span class="nav-section">CÓDIGO & ARQUITECTURA</span>
          <i class="pi pi-chevron-down toggle-icon" aria-hidden="true"></i>
        </button>
        <div class="lab-nav-items">
          <a class="lab-nav-item" href="#screen-kotlin-mocks" data-screen="screen-kotlin-mocks">
            <i class="pi pi-android" aria-hidden="true"></i>
            <span>Kotlin Mocks (Roles Nativos)</span>
          </a>
          <a class="lab-nav-item" href="#screen-code" data-screen="screen-code">
            <i class="pi pi-code" aria-hidden="true"></i>
            <span>Generador de Código Kotlin 2.4</span>
          </a>
          <a class="lab-nav-item" href="#screen-architecture" data-screen="screen-architecture">
            <i class="pi pi-compass" aria-hidden="true"></i>
            <span>Arquitectura C4 & Resiliencia</span>
          </a>
        </div>
      </section>

      <!-- 5. Historias Blueprint en Campo -->
      <section class="lab-nav-group">
        <button class="nav-section-button" type="button" data-nav-group="stories">
          <span class="nav-section">BLUEPRINT EN CAMPO</span>
          <i class="pi pi-chevron-down toggle-icon" aria-hidden="true"></i>
        </button>
        <div class="lab-nav-items">
          <a class="lab-nav-item" href="#screen-stories" data-screen="screen-stories">
            <i class="pi pi-book" aria-hidden="true"></i>
            <span>Historias de Usuario en Campo</span>
          </a>
        </div>
      </section>

      <!-- 6. Galería Multi-Dispositivo -->
      <section class="lab-nav-group">
        <button class="nav-section-button" type="button" data-nav-group="gallery">
          <span class="nav-section">REPORTE VISUAL (MURAL)</span>
          <i class="pi pi-chevron-down toggle-icon" aria-hidden="true"></i>
        </button>
        <div class="lab-nav-items">
          <a class="lab-nav-item" href="#screen-gallery" data-screen="screen-gallery">
            <i class="pi pi-th-large" aria-hidden="true"></i>
            <span>Mural 5 Dispositivos (Al fondo)</span>
          </a>
        </div>
      </section>

      <!-- 7. Directrices Generales (Enlace al Hub) -->
      <section class="lab-nav-group">
        <div class="lab-nav-items" style="padding-top: 8px; border-top: 1px solid var(--nexa-color-border-subtle, #e2e8f0);">
          <a class="lab-nav-item" href="http://localhost:8080" target="_self" title="Ver Directrices Generales Compartidas en el Hub">
            <i class="pi pi-external-link" aria-hidden="true" style="color: var(--nexa-color-primary-600, #2563eb);"></i>
            <span>General Style Guidelines ↗</span>
          </a>
        </div>
      </section>
    </nav>

    <!-- Unified Sidebar Footer -->
    <div class="lab-footer">
      <span class="status-dot" aria-hidden="true"></span>
      <span>
        <strong>Visual evidence candidate</strong>
        <small>Operations Android (:core:designsystem)</small>
      </span>
    </div>
  </aside>

  <!-- Right Main Area (Topbar + Content) -->
  <div class="lab-main">
    <header class="lab-topbar">
      <div class="topbar-left">
        <button class="mobile-menu-button" id="btn-mobile-sidebar-toggle" type="button" aria-label="Abrir navegación móvil">
          <i class="pi pi-bars" aria-hidden="true"></i>
        </button>
        <span class="topbar-title" id="topbar-screen-title">Design documentation · v1.2.0 (Mobile Style)</span>
      </div>

      <!-- Evaluation Controls (Clean Android Native priority) -->
      <div class="evaluation-controls" aria-label="Modos de evaluación del Design Lab">
        <div class="android-native-pill" title="100% Prioridad Android Kotlin nativo con Jetpack Compose">
          <i class="pi pi-android"></i>
          <span>Android Kotlin · Compose M3</span>
        </div>

        <!-- Contrast Mode -->
        <div class="segmented-evaluation" role="group" aria-label="Modo de contraste">
          <button type="button" class="btn-eval-contrast active" data-contrast="standard">Standard</button>
          <button type="button" class="btn-eval-contrast" data-contrast="increased">Increased</button>
        </div>
      </div>

      <span class="topbar-review">ADR-0018 Candidate</span>
    </header>

    <!-- Master Content Slot -->
    <div class="lab-content">
      <slot />
    </div>
  </div>
</div>

<style>
  /* Global Layout Box-Sizing & Reset */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .lab-shell {
    display: flex;
    height: 100vh;
    max-height: 100vh;
    background: var(--nexa-surface-page, #f6faff);
    color: var(--nexa-color-text-primary, #0f172a);
    font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
    position: relative;
    overflow: hidden;
  }

  /* Left Sidebar (284px width matching web-style) */
  .lab-sidebar {
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
    flex: 0 0 284px;
    width: 284px;
    padding: 24px 16px 16px;
    border-right: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    background: var(--nexa-surface-card, #ffffff);
    z-index: 100;
  }

  .lab-brand {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: 0 10px;
    color: inherit;
    text-decoration: none;
  }

  .lab-brand > span:last-child {
    color: var(--nexa-color-neutral-500, #64748b);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: right;
  }

  .lab-brand b {
    display: block;
    margin-top: 4px;
    color: var(--nexa-color-primary-600, #2a67d9);
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0;
  }

  .lab-context {
    margin: 18px 10px 14px;
    color: var(--nexa-color-text-secondary, #64748b);
    font-size: 12px;
    line-height: 1.45;
  }

  /* Monorepo Suite Switcher */
  .monorepo-suite-switcher {
    margin: 0 10px 18px;
    padding: 8px 10px;
    background: var(--nexa-color-neutral-50, #f8fafc);
    border: 1px solid var(--nexa-color-border-subtle, #e2e8f0);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .suite-title {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--nexa-color-neutral-500, #64748b);
    text-transform: uppercase;
  }

  .suite-links {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .suite-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;

    &.active {
      background: var(--nexa-color-primary-100, #dbeafe);
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-weight: 700;
    }

    &.link {
      background: #ffffff;
      color: var(--nexa-color-neutral-700, #334155);
      border: 1px solid var(--nexa-color-border-default, #cbd5e1);

      &:hover {
        background: var(--nexa-color-neutral-100, #f1f5f9);
        color: var(--nexa-color-primary-600, #2563eb);
        border-color: var(--nexa-color-primary-300, #93c5fd);
      }
    }
  }

  /* Search */
  .lab-search {
    display: grid;
    gap: 6px;
    margin: 0 0 18px;
  }

  .lab-search label {
    margin: 0 10px;
    color: var(--nexa-color-neutral-500, #64748b);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-control {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) 24px;
    gap: 8px;
    align-items: center;
    min-height: 38px;
    padding: 0 9px;
    border: 1px solid var(--nexa-color-border-interactive, #cbd5e1);
    border-radius: var(--nexa-radius-md, 8px);
    background: var(--nexa-surface-card, #ffffff);
    transition: all 0.15s ease;

    &:focus-within {
      border-color: var(--nexa-color-primary-600, #2a67d9);
      box-shadow: var(--nexa-focus-ring);
    }

    i {
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 13px;
      text-align: center;
    }

    input {
      width: 100%;
      min-width: 0;
      padding: 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--nexa-color-text-primary, #0f172a);
      font: 13px/1.2 var(--nexa-font-family-body);

      &::placeholder {
        color: var(--nexa-color-text-muted, #94a3b8);
      }
    }
  }

  .clear-search {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--nexa-color-text-secondary);
    cursor: pointer;

    &:hover {
      background: var(--nexa-color-neutral-100);
      color: var(--nexa-color-text-primary);
    }
  }

  /* Navigation Groups */
  .lab-nav {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-right: 4px;
  }

  .lab-nav-group {
    display: grid;
    gap: 2px;
  }

  .nav-section-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    padding: 0 10px 5px 12px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }

  .nav-section {
    margin: 0;
    color: var(--nexa-color-neutral-500, #64748b);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .toggle-icon {
    color: var(--nexa-color-neutral-400, #94a3b8);
    font-size: 10px;
    transition: transform 0.2s ease;
  }

  .lab-nav-group.collapsed .toggle-icon {
    transform: rotate(-90deg);
  }

  .lab-nav-group.collapsed .lab-nav-items {
    display: none;
  }

  .lab-nav-items {
    display: grid;
    gap: 2px;
  }

  .lab-nav-item {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 11px;
    align-items: center;
    min-height: 38px;
    padding: 0 12px;
    border-radius: var(--nexa-radius-nav-active, 10px);
    color: var(--nexa-color-neutral-600, #475569);
    font-size: 12.5px;
    text-decoration: none;
    transition: all 140ms ease;

    &:hover {
      background: var(--nexa-color-neutral-50, #f8fafc);
      color: var(--nexa-color-primary-700, #1d4ed8);
    }

    &.active {
      background: var(--nexa-surface-nav-active, #edf4fe);
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-weight: 700;
      box-shadow: inset 3px 0 0 var(--nexa-color-primary-600, #2a67d9);
    }

    i {
      color: currentColor;
      font-size: 14px;
      text-align: center;
    }

    span {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* Sidebar Footer */
  .lab-footer {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    flex-shrink: 0;
    margin-top: auto;
    padding: 14px 10px 14px;
    border-top: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    background: var(--nexa-surface-card, #ffffff);
    color: var(--nexa-color-text-secondary, #64748b);
    font-size: 11px;

    strong {
      color: var(--nexa-color-text-primary, #0f172a);
      font-size: 11px;
    }

    small {
      display: block;
      font-size: 10px;
      color: var(--nexa-color-text-muted, #94a3b8);
      margin-top: 2px;
    }
  }

  .status-dot {
    width: 8px;
    height: 8px;
    margin-top: 3px;
    border-radius: 50%;
    background: #0284c7;
    flex-shrink: 0;
    box-shadow: 0 0 6px rgba(2, 132, 199, 0.4);
  }

  /* Right Main Content */
  .lab-main {
    min-width: 0;
    flex: 1;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .lab-topbar {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 clamp(18px, 3vw, 42px);
    border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    background: var(--nexa-surface-card, #ffffff);
    color: var(--nexa-color-text-secondary, #64748b);
    font-size: 12px;
    position: sticky;
    top: 0;
    z-index: 90;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mobile-menu-button {
    display: none;
    width: 32px;
    height: 32px;
    place-items: center;
    background: transparent;
    border: 1px solid var(--nexa-color-border-default, #e2e8f0);
    border-radius: 6px;
    color: var(--nexa-color-text-primary, #0f172a);
    cursor: pointer;
  }

  .topbar-title {
    font-weight: 500;
    color: var(--nexa-color-text-secondary, #64748b);
  }

  /* Evaluation Controls */
  .evaluation-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .evaluation-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--nexa-color-neutral-500, #64748b);
  }

  .segmented-evaluation {
    display: inline-flex;
    padding: 2px;
    background: var(--nexa-color-neutral-100, #f1f5f9);
    border: 1px solid var(--nexa-color-border-default, #e2e8f0);
    border-radius: 8px;
    gap: 2px;

    button {
      background: transparent;
      border: 0;
      padding: 3px 8px;
      font-size: 11px;
      font-weight: 600;
      color: var(--nexa-color-text-secondary, #64748b);
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;

      &:hover {
        color: var(--nexa-color-text-primary, #0f172a);
      }

      &.active {
        background: var(--nexa-surface-card, #ffffff);
        color: var(--nexa-color-primary-700, #1d4ed8);
        font-weight: 700;
        box-shadow: 0 1px 2px rgba(0,0,0,0.06);
      }
    }
  }

  .btn-theme-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--nexa-surface-card, #ffffff);
    border: 1px solid var(--nexa-color-border-default, #cbd5e1);
    color: var(--nexa-color-text-secondary, #475569);
    padding: 3px 9px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;

    &:hover {
      background: var(--nexa-color-neutral-100, #f1f5f9);
      color: var(--nexa-color-text-primary, #0f172a);
    }
  }

  .topbar-review {
    color: var(--nexa-color-primary-700, #1d4ed8);
    font-size: 11px;
    font-weight: 700;
    background: var(--nexa-color-primary-50, #eff6ff);
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--nexa-color-primary-200, #bfdbfe);
    white-space: nowrap;
  }

  /* Content Area */
  .lab-content {
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  @media (max-width: 900px) {
    .mobile-menu-button {
      display: grid;
    }
    .lab-sidebar {
      position: fixed;
      left: -284px;
      transition: left 0.25s ease;
      box-shadow: 4px 0 16px rgba(0,0,0,0.15);
    }
    .lab-sidebar.open {
      left: 0;
    }
    .topbar-review {
      display: none;
    }
  }
</style>

<script>
  // Search filtering in sidebar
  const searchInput = document.getElementById('mobile-sidebar-search') as HTMLInputElement | null;
  const btnClear = document.getElementById('btn-clear-search');

  searchInput?.addEventListener('input', () => {
    const term = searchInput.value.trim().toLowerCase();
    if (btnClear) btnClear.style.display = term ? 'grid' : 'none';

    const searchableCards = document.querySelectorAll<HTMLElement>('.spec-card, .metric-row, .token-preview-card');
    searchableCards.forEach(card => {
      const text = card.textContent?.toLowerCase() || '';
      card.style.display = term && !text.includes(term) ? 'none' : '';
    });
  });

  btnClear?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.dispatchEvent(new Event('input'));
      searchInput.focus();
    }
  });

  // Keyboard shortcut '/'
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput?.focus();
    }
  });

  // Platform Filter Segmented Buttons
  const platformButtons = document.querySelectorAll<HTMLButtonElement>('.btn-eval-platform');
  platformButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      platformButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const target = btn.getAttribute('data-platform');
      const platformCards = document.querySelectorAll<HTMLElement>('[data-platform-target]');
      platformCards.forEach(card => {
        const p = card.getAttribute('data-platform-target');
        if (target === 'all' || p === target || p === 'universal') {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Contrast Mode Segmented Buttons
  const contrastButtons = document.querySelectorAll<HTMLButtonElement>('.btn-eval-contrast');
  contrastButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      contrastButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const mode = btn.getAttribute('data-contrast');
      document.documentElement.setAttribute('data-contrast-mode', mode === 'increased' ? 'increased' : 'standard');
    });
  });

  // Theme Switcher
  const btnTheme = document.getElementById('topbar-theme-toggle');
  const themeIcon = document.getElementById('topbar-theme-icon');
  const themeText = document.getElementById('topbar-theme-text');
  let isDark = false;

  btnTheme?.addEventListener('click', () => {
    isDark = !isDark;
    document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
    if (themeText) themeText.textContent = isDark ? 'Claro' : 'Oscuro';
    if (themeIcon) {
      themeIcon.classList.toggle('pi-moon', !isDark);
      themeIcon.classList.toggle('pi-sun', isDark);
    }
  });

  // Accordion Toggles
  const navSectionButtons = document.querySelectorAll<HTMLButtonElement>('.nav-section-button');
  navSectionButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.lab-nav-group');
      group?.classList.toggle('collapsed');
    });
  });

  // Mobile menu toggle
  const btnMobileMenu = document.getElementById('btn-mobile-sidebar-toggle');
  const sidebar = document.querySelector('.lab-sidebar');
  btnMobileMenu?.addEventListener('click', () => {
    sidebar?.classList.toggle('open');
  });

  // ==========================================================================
  // MODULAR DISCRETE SCREEN NAVIGATION SYSTEM
  // ==========================================================================
  const navItems = document.querySelectorAll<HTMLAnchorElement>('.lab-nav-item');
  const screens = document.querySelectorAll<HTMLElement>('.lab-screen-view');
  const topbarTitle = document.getElementById('topbar-screen-title');
  const labMain = document.querySelector<HTMLElement>('.lab-main');

  function switchScreen(targetScreenId: string, updateHash = true) {
    if (!targetScreenId) return;
    const cleanId = targetScreenId.replace(/^#/, '');

    // 1. Locate matching screen element
    let targetEl = document.getElementById(cleanId);
    if (!targetEl && !cleanId.startsWith('screen-')) {
      targetEl = document.getElementById('screen-' + cleanId);
    }
    if (!targetEl) {
      targetEl = document.getElementById('screen-simulator');
    }

    if (targetEl) {
      screens.forEach(s => s.classList.remove('active'));
      targetEl.classList.add('active');

      const title = targetEl.getAttribute('data-title') || '';
      if (topbarTitle && title) {
        topbarTitle.textContent = `Mobile Style · ${title}`;
      }

      // 2. Highlight active navigation item in sidebar
      navItems.forEach(item => {
        const itemScreen = item.getAttribute('data-screen');
        const href = item.getAttribute('href');
        const isMatch = itemScreen === targetEl?.id || href === `#${targetEl?.id}` || href === `#${cleanId}`;
        item.classList.toggle('active', isMatch);
        if (isMatch) {
          const group = item.closest('.lab-nav-group');
          group?.classList.remove('collapsed');
        }
      });

      // 3. Reset main area scroll position to the top cleanly
      if (labMain) {
        labMain.scrollTop = 0;
      }
      window.scrollTo(0, 0);

      if (updateHash) {
        history.pushState(null, '', '#' + targetEl.id);
      }
    }
  }

  // Intercept navigation clicks
  navItems.forEach(item => {
    item.addEventListener('click', (e) => {
      const href = item.getAttribute('href');
      if (href && href.startsWith('#')) {
        e.preventDefault();
        const targetId = href.replace(/^#/, '');
        switchScreen(targetId, true);
        sidebar?.classList.remove('open');
      }
    });
  });

  // Intercept any in-page quick nav links (e.g. "Volver al Simulador")
  document.addEventListener('click', (e) => {
    const targetLink = (e.target as HTMLElement).closest('a[href^="#screen-"]');
    if (targetLink) {
      e.preventDefault();
      const href = targetLink.getAttribute('href') || '';
      switchScreen(href.replace(/^#/, ''), true);
    }
  });

  // Handle URL Hash changes & Initial load
  function onHashChange() {
    const rawHash = window.location.hash.replace(/^#/, '');
    if (rawHash) {
      switchScreen(rawHash, false);
    } else {
      switchScreen('screen-simulator', false);
    }
  }

  window.addEventListener('hashchange', onHashChange);

  // Cross-frame messaging from Design Lab Gateway Hub
  window.addEventListener('message', (event) => {
    if (event.data && event.data.type === 'switchScreen' && event.data.screen) {
      switchScreen(event.data.screen, true);
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', onHashChange);
  } else {
    onHashChange();
  }
</script>
