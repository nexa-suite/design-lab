    // Human Tones System Switcher
    function setHumanTone(toneKey: string) {
      const tone = HUMAN_TONES[toneKey];
      if (!tone) return;
      currentTone = tone;
      currentConduitPastel = tone.defaultPastel;

      canvasFrame.style.backgroundColor = tone.plateBg;
      pathElem.setAttribute('stroke', tone.accent);

      document.querySelectorAll('.tone-pill').forEach(btn => {
        btn.classList.toggle('active', (btn as HTMLElement).dataset.tone === toneKey);
      });

      document.querySelectorAll('.conduit-pill').forEach(btn => {
        btn.classList.toggle('active', (btn as HTMLElement).dataset.pastel === currentConduitPastel);
      });

      renderCircuitLayers();
    }

    document.querySelectorAll('.tone-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const toneKey = (btn as HTMLElement).dataset.tone || 'nexa';
        setHumanTone(toneKey);
      });
    });

    document.querySelectorAll('.conduit-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.conduit-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentConduitPastel = (btn as HTMLElement).dataset.pastel || '#bae6fd';
        renderCircuitLayers();
      });
    });

    function clearTourTimeouts() {
      tourTimeouts.forEach(t => clearTimeout(t));
      tourTimeouts = [];
      if (tourAnimFrameId) {
        cancelAnimationFrame(tourAnimFrameId);
        tourAnimFrameId = null;
      }
      if (tourFxLayer) tourFxLayer.innerHTML = '';
      tourConfettiParticles = [];
      isTourFlying = false;
    }

    function showTourBanner(badge: string, desc: string) {
      if (tourStatusBanner && tourStepBadge && tourStepDesc) {
        tourStatusBanner.style.display = 'flex';
        tourStepBadge.textContent = badge;
        tourStepDesc.textContent = desc;
      }
    }

    function startAutoTour() {
      if (isAutoTourRunning) {
        stopAutoTour();
        return;
      }

      isAutoTourRunning = true;
      btnAutoTour.classList.add('running');
      autoTourBtnText.textContent = 'Stop Tour';
      tourBtnIcon.textContent = '■';

      runTourStep1_Dormant();
    }

    function stopAutoTour() {
      isAutoTourRunning = false;
      btnAutoTour.classList.remove('running');
      autoTourBtnText.textContent = 'Auto-Tour';
      tourBtnIcon.textContent = '▶';
      if (tourStatusBanner) tourStatusBanner.style.display = 'none';
      clearTourTimeouts();

      currentConfig = JSON.parse(JSON.stringify(NEXAFY_PRESETS.CHANNELS));
      scene = createSceneForPreset('CHANNELS', currentConfig.width, currentConfig.height);
      syncUIFromConfig();
      updateStagePath();
      initSceneTree();
      renderCircuitLayers();
      runSceneValidation();
    }

    tourStopBtn?.addEventListener('click', stopAutoTour);
    btnAutoTour?.addEventListener('click', startAutoTour);

    // 1. DORMANT STAGE
    function runTourStep1_Dormant() {
      if (!isAutoTourRunning) return;
      showTourBanner('STAGE 1/5', 'DORMANT STAGE · PURE ARCHITECTURAL FOUNDATION');
      if (presetSelector) presetSelector.value = 'DORMANT';
      currentConfig = JSON.parse(JSON.stringify(NEXAFY_PRESETS.DORMANT));
      scene = createSceneForPreset('DORMANT', currentConfig.width, currentConfig.height);
      syncUIFromConfig();
      updateStagePath();
      initSceneTree();
      renderCircuitLayers();
      runSceneValidation();

      const tId = setTimeout(() => {
        if (isAutoTourRunning) runTourStep2_FlyingEntry();
      }, 2600);
      tourTimeouts.push(tId);
    }

    // 2. FLYING ENTRY (-280° ROTATION & ELASTIC DOCKING)
    function runTourStep2_FlyingEntry() {
      if (!isAutoTourRunning) return;
      showTourBanner('STAGE 2/5', 'FLYING ENTRY · -280° KINETIC ROTATIONAL DOCKING');
      if (presetSelector) presetSelector.value = 'CHANNELS';
      currentConfig = JSON.parse(JSON.stringify(NEXAFY_PRESETS.CHANNELS));
      scene = createSceneForPreset('CHANNELS', currentConfig.width, currentConfig.height);

      scene.nodes.forEach(n => {
        n.visibility = (n.id === 'node-company' || n.id === 'node-hub') ? 'visible' : 'hidden';
      });

      syncUIFromConfig();
      updateStagePath();
      initSceneTree();
      renderCircuitLayers();

      isTourFlying = true;
      const startTime = performance.now();
      const duration = 1800;

      function animFlying(now: number) {
        if (!isAutoTourRunning) return;
        const elapsed = now - startTime;
        const p = Math.min(1, elapsed / duration);
        const c1 = 1.70158;
        const c3 = c1 + 1;
        const ease = 1 + c3 * Math.pow(p - 1, 3) + c1 * Math.pow(p - 1, 2);

        const curRotation = -280 * (1 - ease);
        const curScale = 0.15 + 0.85 * Math.max(0, ease);
        const curOpacity = Math.min(1, p * 1.5);

        const hubEl = document.getElementById('svg-node-hub');
        const compEl = document.getElementById('svg-node-company');

        const hubNode = scene.nodes.find(n => n.id === 'node-hub');
        const compNode = scene.nodes.find(n => n.id === 'node-company');

        if (hubEl && hubNode) {
          const cx = hubNode.visualBounds.x + hubNode.visualBounds.width / 2;
          const cy = hubNode.visualBounds.y + hubNode.visualBounds.height / 2;
          hubEl.setAttribute('transform', `translate(${cx}, ${cy}) rotate(${curRotation}) scale(${curScale}) translate(${-cx}, ${-cy}) translate(${hubNode.visualBounds.x}, ${hubNode.visualBounds.y})`);
          hubEl.setAttribute('opacity', `${curOpacity}`);
        }

        if (compEl && compNode) {
          const cx = compNode.visualBounds.x + compNode.visualBounds.width / 2;
          const cy = compNode.visualBounds.y + compNode.visualBounds.height / 2;
          compEl.setAttribute('transform', `translate(${cx}, ${cy}) rotate(${curRotation * 0.7}) scale(${curScale}) translate(${-cx}, ${-cy}) translate(${compNode.visualBounds.x}, ${compNode.visualBounds.y})`);
          compEl.setAttribute('opacity', `${curOpacity}`);
        }

        if (p < 1) {
          tourAnimFrameId = requestAnimationFrame(animFlying);
        } else {
          isTourFlying = false;
          if (hubEl && hubNode) {
            hubEl.setAttribute('transform', `translate(${hubNode.visualBounds.x}, ${hubNode.visualBounds.y})`);
            hubEl.setAttribute('opacity', '1');
          }
          if (compEl && compNode) {
            compEl.setAttribute('transform', `translate(${compNode.visualBounds.x}, ${compNode.visualBounds.y})`);
            compEl.setAttribute('opacity', '1');
          }
        }
      }
      tourAnimFrameId = requestAnimationFrame(animFlying);

      const tId = setTimeout(() => {
        if (isAutoTourRunning) runTourStep3_ChannelsArrival();
      }, 2900);
      tourTimeouts.push(tId);
    }

    // 3. CHANNELS ARRIVAL (28px PASTEL VASCULAR CIRCUIT)
    function runTourStep3_ChannelsArrival() {
      if (!isAutoTourRunning) return;
      showTourBanner('STAGE 3/5', 'CHANNELS ARRIVAL · 28px PASTEL VASCULAR CIRCUIT');
      isTourFlying = false;

      scene.nodes.forEach(n => { n.visibility = 'visible'; });
      renderCircuitLayers();
      runSceneValidation();

      scene.nodes.forEach((n, idx) => {
        const el = document.getElementById(`svg-${n.id}`);
        if (el) {
          el.style.transition = 'transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)';
          el.setAttribute('transform', `translate(${n.visualBounds.x}, ${n.visualBounds.y - 12}) scale(1.05)`);
          setTimeout(() => {
            if (el) {
              el.setAttribute('transform', `translate(${n.visualBounds.x}, ${n.visualBounds.y}) scale(1)`);
              setTimeout(() => { if (el) el.style.transition = ''; }, 450);
            }
          }, 120 + idx * 80);
        }
      });

      const tId = setTimeout(() => {
        if (isAutoTourRunning) runTourStep4_SaaSMorph();
      }, 3400);
      tourTimeouts.push(tId);
    }

    // 4. SAAS MORPH (CANVAS SHAPE INTERPOLATION & DASHBOARD COCKPIT)
    function runTourStep4_SaaSMorph() {
      if (!isAutoTourRunning) return;
      showTourBanner('STAGE 4/5', 'SAAS MORPH · WORKBENCH & ACTIVE LEDGER COCKPIT');
      if (presetSelector) presetSelector.value = 'SAAS';

      const cfgA = NEXAFY_PRESETS.CHANNELS;
      const cfgB = NEXAFY_PRESETS.SAAS;
      const cmdsA = generateContainerCommands(cfgA);
      const cmdsB = generateContainerCommands(cfgB);

      const startTime = performance.now();
      const morphDuration = 1800;

      function animMorph(now: number) {
        if (!isAutoTourRunning) return;
        const elapsed = now - startTime;
        const p = Math.min(1, elapsed / morphDuration);
        const ease = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;

        const morphed = interpolateCommands(cmdsA, cmdsB, ease);
        const d = commandsToSvgPath(morphed);
        pathElem.setAttribute('d', d);

        if (p < 1) {
          tourAnimFrameId = requestAnimationFrame(animMorph);
        } else {
          currentConfig = JSON.parse(JSON.stringify(NEXAFY_PRESETS.SAAS));
          scene = createSceneForPreset('SAAS', currentConfig.width, currentConfig.height);
          syncUIFromConfig();
          updateStagePath();
          initSceneTree();
          renderCircuitLayers();
          runSceneValidation();
        }
      }
      tourAnimFrameId = requestAnimationFrame(animMorph);

      const tId = setTimeout(() => {
        if (isAutoTourRunning) runTourStep5_EscrowConfetti();
      }, 3800);
      tourTimeouts.push(tId);
    }

    // 5. ESCROW CONFETTI FINALE
    function runTourStep5_EscrowConfetti() {
      if (!isAutoTourRunning) return;
      showTourBanner('STAGE 5/5', 'ESCROW GUARANTEE & CONFETTI FINALE · 100% CUSTODY VERIFIED!');
      if (presetSelector) presetSelector.value = 'PAYMENT';

      currentConfig = JSON.parse(JSON.stringify(NEXAFY_PRESETS.PAYMENT));
      scene = createSceneForPreset('PAYMENT', currentConfig.width, currentConfig.height);
      syncUIFromConfig();
      updateStagePath();
      initSceneTree();
      renderCircuitLayers();
      runSceneValidation();

      if (tourFxLayer) {
        tourFxLayer.innerHTML = '';
        tourConfettiParticles = [];
        const colors = ['#38c8ff', '#56f09f', '#bae6fd', '#fef08a', '#f472b6', '#ffffff'];
        const centerX = currentConfig.width / 2;
        const centerY = currentConfig.height * 0.42;

        for (let i = 0; i < 50; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 4 + Math.random() * 9;
          const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          rect.setAttribute('width', `${6 + Math.random() * 8}`);
          rect.setAttribute('height', `${8 + Math.random() * 10}`);
          rect.setAttribute('rx', '2');
          rect.setAttribute('fill', colors[Math.floor(Math.random() * colors.length)]);

          tourFxLayer.appendChild(rect);

          tourConfettiParticles.push({
            el: rect,
            x: centerX,
            y: centerY,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 3,
            rot: Math.random() * 360,
            vRot: (Math.random() - 0.5) * 15,
            opacity: 1
          });
        }

        const confettiStart = performance.now();
        function animConfetti(now: number) {
          if (!isAutoTourRunning) return;
          const elapsed = now - confettiStart;
          const p = Math.min(1, elapsed / 3200);

          tourConfettiParticles.forEach(pt => {
            pt.x += pt.vx;
            pt.y += pt.vy;
            pt.vy += 0.22;
            pt.vx *= 0.985;
            pt.rot += pt.vRot;
            pt.opacity = Math.max(0, 1 - p * 1.1);

            pt.el.setAttribute('transform', `translate(${pt.x}, ${pt.y}) rotate(${pt.rot})`);
            pt.el.setAttribute('opacity', `${pt.opacity}`);
          });

          if (p < 1) {
            tourAnimFrameId = requestAnimationFrame(animConfetti);
          } else {
            if (tourFxLayer) tourFxLayer.innerHTML = '';
            tourConfettiParticles = [];
          }
        }
        tourAnimFrameId = requestAnimationFrame(animConfetti);
      }

      const tId = setTimeout(() => {
        if (isAutoTourRunning) {
          runTourStep1_Dormant();
        }
      }, 4200);
      tourTimeouts.push(tId);
    }

    const btnZoomIn = document.getElementById('btn-zoom-in') as HTMLButtonElement;
    const btnZoomOut = document.getElementById('btn-zoom-out') as HTMLButtonElement;
    const btnZoomReset = document.getElementById('btn-zoom-reset') as HTMLButtonElement;
    const btnZoomFit = document.getElementById('btn-zoom-fit') as HTMLButtonElement;
    const scaleIndicator = document.getElementById('scale-indicator') as HTMLSpanElement;

    const inputTimeline = document.getElementById('input-master-timeline') as HTMLInputElement;
    const displayTimeline = document.getElementById('timeline-time-display') as HTMLDivElement;
    const btnPlayTimeline = document.getElementById('btn-play-timeline') as HTMLButtonElement;
    const btnResetTimeline = document.getElementById('btn-reset-timeline') as HTMLButtonElement;
    const btnPrevMarker = document.getElementById('btn-prev-marker') as HTMLButtonElement;
    const btnNextMarker = document.getElementById('btn-next-marker') as HTMLButtonElement;
    const markersContainer = document.getElementById('timeline-markers-container') as HTMLDivElement;

    const sceneNodeList = document.getElementById('scene-node-list') as HTMLDivElement;
    const nodeCountBadge = document.getElementById('node-count-badge') as HTMLSpanElement;
    const inspectId = document.getElementById('inspect-id') as HTMLSpanElement;
    const inspectRole = document.getElementById('inspect-role') as HTMLSpanElement;
    const inspectBounds = document.getElementById('inspect-bounds') as HTMLSpanElement;
    const inspectPorts = document.getElementById('inspect-ports') as HTMLSpanElement;
    const inspectOverlap = document.getElementById('inspect-overlap') as HTMLSpanElement;

    const btnRunValidation = document.getElementById('btn-run-validation') as HTMLButtonElement;
    const btnResolveCollisions = document.getElementById('btn-resolve-collisions') as HTMLButtonElement;
    const validationBadgeText = document.getElementById('validation-badge-text') as HTMLDivElement;
    const collisionDetailText = document.getElementById('collision-detail-text') as HTMLParagraphElement;

    const morphA = document.getElementById('morph-state-a') as HTMLSelectElement;
    const morphB = document.getElementById('morph-state-b') as HTMLSelectElement;
    const morphT = document.getElementById('input-morph-t') as HTMLInputElement;
    const valMorphT = document.getElementById('val-morph-t') as HTMLSpanElement;
    const btnPlayMorph = document.getElementById('btn-play-morph') as HTMLButtonElement;

    function getSvgCoordinates(e: MouseEvent): { x: number; y: number } {
      const ctm = svgElem.getScreenCTM();
      if (!ctm) return { x: 0, y: 0 };
      const pt = svgElem.createSVGPoint();
      pt.x = e.clientX;
      pt.y = e.clientY;
      const transformed = pt.matrixTransform(ctm.inverse());
      return { x: transformed.x, y: transformed.y };
    }

    function setZoom(z: number) {
      currentZoom = Math.max(0.35, Math.min(2.2, z));
      scaleIndicator.textContent = `${Math.round(currentZoom * 100)}%`;
      applyCanvasTransform();
    }

    function fitStageToViewport() {
      panOffset = { x: 0, y: 0 };
      const availW = Math.max(300, stageWrapper.clientWidth - 40);
      const availH = Math.max(300, stageWrapper.clientHeight - 40);
      const scale = Math.max(0.35, Math.min(availW / currentConfig.width, availH / currentConfig.height, 1.15));
      currentZoom = scale;
      scaleIndicator.textContent = `${Math.round(currentZoom * 100)}%`;
      applyCanvasTransform();
    }
    window.addEventListener('resize', fitStageToViewport);

    function resetZoom() {
      panOffset = { x: 0, y: 0 };
      setZoom(1.0);
    }

    function applyCanvasTransform() {
      canvasFrame.style.width = `${currentConfig.width}px`;
      canvasFrame.style.height = `${currentConfig.height}px`;
      canvasFrame.style.transform = `translate(${panOffset.x}px, ${panOffset.y}px) scale(${currentZoom})`;
    }

    btnZoomIn.addEventListener('click', () => setZoom(currentZoom + 0.1));
    btnZoomOut.addEventListener('click', () => setZoom(currentZoom - 0.1));
    btnZoomReset.addEventListener('click', resetZoom);
    btnZoomFit.addEventListener('click', fitStageToViewport);

    stageWrapper.addEventListener('wheel', (e: WheelEvent) => {
      e.preventDefault();
      const delta = e.deltaY < 0 ? 0.06 : -0.06;
      setZoom(currentZoom + delta);
    }, { passive: false });

    stageWrapper.addEventListener('mousedown', (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('.interactive-node')) return;
      isPanningViewport = true;
      panStart = { x: e.clientX - panOffset.x, y: e.clientY - panOffset.y };
      stageWrapper.style.cursor = 'grab';
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isPanningViewport) return;
      panOffset.x = e.clientX - panStart.x;
      panOffset.y = e.clientY - panStart.y;
      applyCanvasTransform();
    });

    window.addEventListener('mouseup', () => {
      if (isPanningViewport) {
        isPanningViewport = false;
        stageWrapper.style.cursor = 'default';
      }
    });

    function initTimelineMarkers() {
      markersContainer.innerHTML = '';
      EVENT_MARKERS.forEach((marker, idx) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'marker-chip';
        chip.textContent = marker.label;
        chip.dataset.index = idx.toString();
        chip.addEventListener('click', () => {
          jumpTimelineTo(marker.time);
        });
        markersContainer.appendChild(chip);
      });
    }

    function jumpTimelineTo(time: number) {
      currentTimelineTime = Math.min(Math.max(0, time), 48.15);
      inputTimeline.value = currentTimelineTime.toFixed(2);
      displayTimeline.textContent = `${currentTimelineTime.toFixed(2).padStart(5, '0')}s / 48.15s`;
      applyTimelineFrame(currentTimelineTime);
    }

    btnPrevMarker.addEventListener('click', () => {
      const prev = [...EVENT_MARKERS].reverse().find(m => m.time < currentTimelineTime - 0.1) || EVENT_MARKERS[0];
      jumpTimelineTo(prev.time);
    });

    btnNextMarker.addEventListener('click', () => {
      const next = EVENT_MARKERS.find(m => m.time > currentTimelineTime + 0.1) || EVENT_MARKERS[EVENT_MARKERS.length - 1];
      jumpTimelineTo(next.time);
    });

    function applyTimelineFrame(t: number) {
      const chips = markersContainer.querySelectorAll<HTMLButtonElement>('.marker-chip');
      chips.forEach((c, idx) => {
        const m = EVENT_MARKERS[idx];
        const nextTime = EVENT_MARKERS[idx + 1]?.time ?? 48.15;
        if (t >= m.time && t < nextTime) {
          c.classList.add('active');
        } else {
          c.classList.remove('active');
        }
      });

      scene.nodes.forEach(node => {
        let visible = false;
        if (node.id === 'node-company' && t >= 0.867) visible = true;
        if (node.id === 'node-hub' && t >= 2.25) visible = true;
        if (node.id === 'node-card-email' && t >= 6.10) visible = true;
        if (node.id === 'node-card-store' && t >= 7.67) visible = true;
        if (node.id === 'node-card-online' && t >= 10.02) visible = true;
        if (node.id === 'node-shield' && t >= 10.75) visible = true;
        if (!['node-company', 'node-hub', 'node-card-email', 'node-card-store', 'node-card-online', 'node-shield'].includes(node.id)) {
          visible = true;
        }
        node.visibility = visible ? 'visible' : 'hidden';
      });

      renderCircuitLayers();
    }

    function initSceneTree() {
      sceneNodeList.innerHTML = '';
      nodeCountBadge.textContent = `${scene.nodes.length} Nodes`;
      scene.nodes.forEach(node => {
        const item = document.createElement('div');
        item.className = `scene-tree-item ${node.id === selectedNodeId ? 'selected' : ''}`;
        item.dataset.nodeId = node.id;
        item.innerHTML = `
          <span>${node.name}</span>
          <span class="item-tag">${node.semanticRole}</span>
        `;
        item.addEventListener('click', () => {
          selectNode(node.id);
        });
        sceneNodeList.appendChild(item);
      });
    }

    function selectNode(id: string) {
      selectedNodeId = id;
      document.querySelectorAll('.scene-tree-item').forEach(el => {
        el.classList.toggle('selected', (el as HTMLElement).dataset.nodeId === id);
      });
      document.querySelectorAll('.interactive-node').forEach(el => {
        el.classList.toggle('selected', el.id === `svg-${id}`);
      });
      updateInspector();
    }

    function updateInspector() {
      const node = scene.nodes.find(n => n.id === selectedNodeId);
      if (node) {
        inspectId.textContent = node.id;
        inspectRole.textContent = node.semanticRole;
        inspectBounds.textContent = `${Math.round(node.visualBounds.x)}, ${Math.round(node.visualBounds.y)}, ${node.visualBounds.width}, ${node.visualBounds.height}`;
        inspectPorts.textContent = `${node.ports.length} (${node.ports.map(p => `${p.role}: ${p.direction}`).join(', ') || 'None'})`;
        inspectOverlap.textContent = node.allowOverlapWith?.join(', ') || 'None (Zero Overlap Enforced)';
      }
    }

    function startNodeDrag(node: SceneNode, e: MouseEvent) {
      isDraggingNode = true;
      draggedNode = node;
      selectNode(node.id);

      const svgPt = getSvgCoordinates(e);
      dragOffset = {
        x: svgPt.x - node.visualBounds.x,
        y: svgPt.y - node.visualBounds.y
      };

      const g = document.getElementById(`svg-${node.id}`);
      if (g) g.classList.add('dragging');
    }

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDraggingNode || !draggedNode) return;

      const svgPt = getSvgCoordinates(e);
      const targetX = svgPt.x - dragOffset.x;
      const targetY = svgPt.y - dragOffset.y;

      const safePos = SceneCollisionDetector.preventOverlapOnDrag(
        draggedNode,
        scene.nodes,
        targetX,
        targetY,
        { x: 0, y: 0, width: currentConfig.width, height: currentConfig.height },
        20
      );

      draggedNode.visualBounds.x = safePos.x;
      draggedNode.visualBounds.y = safePos.y;
      SceneCollisionDetector.syncNodePositions(draggedNode);

      const g = document.getElementById(`svg-${draggedNode.id}`);
      if (g) {
        g.setAttribute('transform', `translate(${safePos.x}, ${safePos.y})`);
      }

      recomputeConnectedEdges(draggedNode);
      updateDebugOverlays();
      updateInspector();
      runSceneValidation();
    });

    window.addEventListener('mouseup', () => {
      if (isDraggingNode && draggedNode) {
        const g = document.getElementById(`svg-${draggedNode.id}`);
        if (g) g.classList.remove('dragging');

        SceneCollisionDetector.resolveCollisions(
          scene.nodes,
          undefined,
          { x: 0, y: 0, width: currentConfig.width, height: currentConfig.height },
          20
        );
        scene.nodes.forEach(n => recomputeConnectedEdges(n));

        isDraggingNode = false;
        draggedNode = null;
        renderCircuitLayers();
        runSceneValidation();
      }
    });

    function recomputeConnectedEdges(node: SceneNode) {
      scene.edges.forEach(edge => {
        if (edge.sourceNodeId === node.id || edge.targetNodeId === node.id) {
          const sNode = scene.nodes.find(n => n.id === edge.sourceNodeId);
          const tNode = scene.nodes.find(n => n.id === edge.targetNodeId);
          if (sNode && tNode) {
            const sPort = sNode.ports.find(p => p.id === edge.sourcePortId);
            const tPort = tNode.ports.find(p => p.id === edge.targetPortId);
            if (sPort && tPort) {
              const route = OrthogonalFilletRouter.route(sPort, tPort, 20);
              edge.svgPathData = route.svgPathData;
              const path = document.getElementById(`edge-path-${edge.id}`);
              if (path) path.setAttribute('d', route.svgPathData);
            }
          }
        }
      });
    }

    function runSceneValidation() {
      const collisions = SceneCollisionDetector.detectCollisions(scene.nodes);
      const accidental = collisions.filter(c => !c.isPermitted);

      if (accidental.length === 0) {
        validationBadgeText.className = 'validation-badge';
        validationBadgeText.innerHTML = `<span>●</span><span>0 Violations (PASS)</span>`;
        collisionDetailText.textContent = `Scene clearance verified. All ${scene.nodes.length} nodes and routed edges preserve safe bounds.`;
      } else {
        validationBadgeText.className = 'validation-badge has-error';
        validationBadgeText.innerHTML = `<span>▲</span><span>${accidental.length} Collision(s) Detected</span>`;
        collisionDetailText.textContent = `Violations: ${accidental.map(c => `${c.nodeAId} & ${c.nodeBId} (${Math.round(c.overlapArea)}px²)`).join(', ')}`;
      }
    }

    btnRunValidation.addEventListener('click', runSceneValidation);

    btnResolveCollisions.addEventListener('click', () => {
      SceneCollisionDetector.resolveCollisions(
        scene.nodes,
        undefined,
        { x: 0, y: 0, width: currentConfig.width, height: currentConfig.height },
        20
      );
      scene.nodes.forEach(n => recomputeConnectedEdges(n));
      renderCircuitLayers();
      runSceneValidation();
    });

    function renderCircuitLayers() {
      edgesLayer.innerHTML = '';
      scene.edges.forEach(edge => {
        const sNode = scene.nodes.find(n => n.id === edge.sourceNodeId);
        const tNode = scene.nodes.find(n => n.id === edge.targetNodeId);
        if (!sNode || !tNode) return;
        if (sNode.visibility === 'hidden' || tNode.visibility === 'hidden') return;

        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('class', 'circuit-edge-group');
        g.setAttribute('data-edge-id', edge.id);

        // 1. Semi-transparent glowing underlay (38px halo)
        const pathUnderlay = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        pathUnderlay.setAttribute('d', edge.svgPathData);
        pathUnderlay.setAttribute('fill', 'none');
        pathUnderlay.setAttribute('stroke', currentTone.conduitGlow);
        pathUnderlay.setAttribute('stroke-width', '38');
        pathUnderlay.setAttribute('stroke-linecap', 'round');
        pathUnderlay.setAttribute('stroke-linejoin', 'round');
        pathUnderlay.setAttribute('opacity', '0.6');
        pathUnderlay.setAttribute('filter', 'url(#conduit-glow)');

        // 2. Thick Pastel Vascular Conduit Body (28px with 20px fillet corners)
        const pathMain = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        pathMain.id = `edge-path-${edge.id}`;
        pathMain.setAttribute('d', edge.svgPathData);
        pathMain.setAttribute('fill', 'none');
        pathMain.setAttribute('stroke', currentConduitPastel);
        pathMain.setAttribute('stroke-width', '28');
        pathMain.setAttribute('stroke-linecap', 'round');
        pathMain.setAttribute('stroke-linejoin', 'round');

        // 3. Central luminescent core lumen track (3px smooth guide)
        const pathCore = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        pathCore.setAttribute('d', edge.svgPathData);
        pathCore.setAttribute('fill', 'none');
        pathCore.setAttribute('stroke', 'rgba(255, 255, 255, 0.45)');
        pathCore.setAttribute('stroke-width', '3');
        pathCore.setAttribute('stroke-linecap', 'round');
        pathCore.setAttribute('stroke-linejoin', 'round');

        g.appendChild(pathUnderlay);
        g.appendChild(pathMain);
        g.appendChild(pathCore);
        edgesLayer.appendChild(g);
      });

      nodesLayer.innerHTML = '';
      scene.nodes.forEach(node => {
        if (node.visibility === 'hidden') return;

        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.id = `svg-${node.id}`;
        g.setAttribute('class', `interactive-node ${node.id === selectedNodeId ? 'selected' : ''}`);
        g.setAttribute('transform', `translate(${node.visualBounds.x}, ${node.visualBounds.y})`);

        g.addEventListener('mousedown', (e: MouseEvent) => {
          e.stopPropagation();
          startNodeDrag(node, e);
        });

        g.addEventListener('click', (e: MouseEvent) => {
          e.stopPropagation();
          selectNode(node.id);
        });

        // 1. Crisp White Card Surface with 1px border and refined drop shadow
        const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        rect.setAttribute('class', 'node-card-bg');
        rect.setAttribute('width', `${node.visualBounds.width}`);
        rect.setAttribute('height', `${node.visualBounds.height}`);
        rect.setAttribute('rx', '14');
        rect.setAttribute('ry', '14');
        rect.setAttribute('fill', '#ffffff');
        rect.setAttribute('stroke', node.id === selectedNodeId ? 'var(--nexafy-accent)' : '#e2e8f0');
        rect.setAttribute('stroke-width', node.id === selectedNodeId ? '2' : '1');
        rect.setAttribute('filter', 'url(#card-shadow)');
        g.appendChild(rect);

        // 2. Active status indicator dot in top-right
        const statusDot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        statusDot.setAttribute('cx', `${node.visualBounds.width - 16}`);
        statusDot.setAttribute('cy', '16');
        statusDot.setAttribute('r', '4');
        statusDot.setAttribute('fill', '#10b981');
        g.appendChild(statusDot);

        // 3. Bold Node Title (WCAG AAA dark slate on white - no black on dark blue!)
        const textName = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        textName.setAttribute('class', 'node-title-text');
        textName.setAttribute('x', '16');
        textName.setAttribute('y', '27');
        textName.setAttribute('fill', '#0f172a');
        textName.setAttribute('font-family', 'Plus Jakarta Sans, sans-serif');
        textName.setAttribute('font-size', '12.5');
        textName.setAttribute('font-weight', '700');
        textName.textContent = node.name.length > 24 ? node.name.slice(0, 22) + '...' : node.name;
        g.appendChild(textName);

        // 4. Monospace Role Badge container & label
        const rolePill = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        const roleTextContent = node.semanticRole.toUpperCase();
        const rolePillW = Math.max(68, roleTextContent.length * 6.5 + 14);
        rolePill.setAttribute('x', '16');
        rolePill.setAttribute('y', '36');
        rolePill.setAttribute('width', `${rolePillW}`);
        rolePill.setAttribute('height', '18');
        rolePill.setAttribute('rx', '4');
        rolePill.setAttribute('fill', '#f1f5f9');
        rolePill.setAttribute('stroke', '#cbd5e1');
        rolePill.setAttribute('stroke-width', '0.75');
        g.appendChild(rolePill);

        const textRole = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        textRole.setAttribute('class', 'node-role-text');
        textRole.setAttribute('x', '22');
        textRole.setAttribute('y', '49');
        textRole.setAttribute('fill', '#0369a1');
        textRole.setAttribute('font-family', 'JetBrains Mono, monospace');
        textRole.setAttribute('font-size', '9.5');
        textRole.setAttribute('font-weight', '700');
        textRole.textContent = roleTextContent;
        g.appendChild(textRole);

        // 5. Telemetry / Metrics sub-row if card has sufficient height (>= 75px)
        if (node.visualBounds.height >= 75) {
          const telemetryText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          telemetryText.setAttribute('x', '16');
          telemetryText.setAttribute('y', `${Math.min(74, node.visualBounds.height - 12)}`);
          telemetryText.setAttribute('fill', '#64748b');
          telemetryText.setAttribute('font-family', 'Inter, sans-serif');
          telemetryText.setAttribute('font-size', '10');
          telemetryText.setAttribute('font-weight', '500');

          let subInfo = '0ms latency · sync active';
          if (node.semanticRole === 'origin') subInfo = 'Port 443 · Root Authority';
          else if (node.semanticRole === 'hub') subInfo = 'Living Orthogonal Router';
          else if (node.id.includes('shield') || node.id.includes('escrow')) subInfo = '100% Custody · Zero Risk';

          telemetryText.textContent = subInfo;
          g.appendChild(telemetryText);
        }

        // 6. Ports on Card Perimeter with white border ring
        node.ports.forEach(port => {
          const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          const px = port.computedAbsolutePosition ? port.computedAbsolutePosition.x - node.visualBounds.x : port.offsetRatio.x * node.visualBounds.width;
          const py = port.computedAbsolutePosition ? port.computedAbsolutePosition.y - node.visualBounds.y : port.offsetRatio.y * node.visualBounds.height;
          circle.setAttribute('cx', `${px}`);
          circle.setAttribute('cy', `${py}`);
          circle.setAttribute('r', '6');
          circle.setAttribute('fill', port.role === 'source' ? '#0284c7' : '#10b981');
          circle.setAttribute('stroke', '#ffffff');
          circle.setAttribute('stroke-width', '2');
          g.appendChild(circle);
        });

        nodesLayer.appendChild(g);
      });

      updateDebugOverlays();
    }

    function updateDebugOverlays() {
      debugLayer.innerHTML = '';
      if (!toggleDebug.checked) return;

      scene.nodes.forEach(node => {
        if (node.visibility === 'hidden') return;
        const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        rect.setAttribute('x', `${node.visualBounds.x - 10}`);
        rect.setAttribute('y', `${node.visualBounds.y - 10}`);
        rect.setAttribute('width', `${node.visualBounds.width + 20}`);
        rect.setAttribute('height', `${node.visualBounds.height + 20}`);
        rect.setAttribute('rx', '16');
        rect.setAttribute('ry', '16');
        rect.setAttribute('fill', 'none');
        rect.setAttribute('stroke', '#2a67d9');
        rect.setAttribute('stroke-width', '1');
        rect.setAttribute('stroke-dasharray', '3 3');
        rect.setAttribute('stroke-opacity', '0.4');
        debugLayer.appendChild(rect);
      });
    }

    function startLivingEngine() {
      let t = 0;
      function loop() {
        t += 0.035;
        // Floating breathing motion for nodes (y = +/- 3px sinusoidal wave)
        if (isLivingMotionEnabled && !isDraggingNode && !isTourFlying) {
          scene.nodes.forEach((node, idx) => {
            const el = document.getElementById(`svg-${node.id}`);
            if (el && node.visibility !== 'hidden') {
              const deltaY = Math.sin(t * 1.5 + idx * 0.9) * 3.0;
              el.setAttribute('transform', `translate(${node.visualBounds.x}, ${node.visualBounds.y + deltaY})`);
            }
          });
        }

        // Animated signal pulse particles (r=6, glowing white/cyan flowing through 28px conduits)
        if (isPulsesEnabled) {
          pulsesLayer.innerHTML = '';
          scene.edges.forEach((edge, idx) => {
            const sNode = scene.nodes.find(n => n.id === edge.sourceNodeId);
            const tNode = scene.nodes.find(n => n.id === edge.targetNodeId);
            if (!sNode || !tNode || sNode.visibility === 'hidden' || tNode.visibility === 'hidden') return;

            const path = document.getElementById(`edge-path-${edge.id}`) as unknown as SVGPathElement;
            if (path && path.getTotalLength) {
              const len = path.getTotalLength();
              if (len <= 0) return;

              // Run two staggered pulse particles per conduit
              const offsets = [0, 0.5];
              offsets.forEach(offset => {
                let p = ((pulseProgress[edge.id] || (idx * 0.25)) + offset) % 1;
                const pt = path.getPointAtLength(len * p);

                const pulseGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');

                // Outer glowing halo
                const glow = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                glow.setAttribute('cx', `${pt.x}`);
                glow.setAttribute('cy', `${pt.y}`);
                glow.setAttribute('r', '9');
                glow.setAttribute('fill', currentTone.pulseColor);
                glow.setAttribute('opacity', '0.5');
                glow.setAttribute('filter', 'url(#pulse-glow)');

                // Inner crisp white core (r=6)
                const core = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                core.setAttribute('cx', `${pt.x}`);
                core.setAttribute('cy', `${pt.y}`);
                core.setAttribute('r', '6');
                core.setAttribute('fill', '#ffffff');
                core.setAttribute('stroke', currentTone.accent);
                core.setAttribute('stroke-width', '1.5');

                pulseGroup.appendChild(glow);
                pulseGroup.appendChild(core);
                pulsesLayer.appendChild(pulseGroup);
              });

              pulseProgress[edge.id] = ((pulseProgress[edge.id] || 0) + 0.007) % 1;
            }
          });
        }

        _livingEngineAnimId = requestAnimationFrame(loop);
      }
      _livingEngineAnimId = requestAnimationFrame(loop);
    }

    function updateStagePath() {
      const cmds = generateContainerCommands(currentConfig);
      const d = commandsToSvgPath(cmds);
      pathElem.setAttribute('d', d);
      outputArea.textContent = d;
      svgElem.setAttribute('viewBox', `0 0 ${currentConfig.width} ${currentConfig.height}`);
      const glow = document.getElementById('sculpted-glow');
      if (glow) {
        glow.setAttribute('width', `${currentConfig.width}`);
        glow.setAttribute('height', `${currentConfig.height}`);
      }
    }

    function syncUIFromConfig() {
      inputW.value = `${currentConfig.width}`;
      inputH.value = `${currentConfig.height}`;
      inputBaseR.value = `${currentConfig.baseRadius}`;
      document.getElementById('val-width')!.textContent = `${currentConfig.width}`;
      document.getElementById('val-height')!.textContent = `${currentConfig.height}`;
      document.getElementById('val-base-radius')!.textContent = `${currentConfig.baseRadius}`;

      checkCrown.checked = currentConfig.crown.enabled;
      inputCrownW.value = `${currentConfig.crown.width}`;
      document.getElementById('val-crown-w')!.textContent = `${currentConfig.crown.width}`;
      inputCrownH.value = `${currentConfig.crown.height}`;
      document.getElementById('val-crown-h')!.textContent = `${currentConfig.crown.height}`;
      inputCrownFillet.value = `${currentConfig.crown.filletRadius}`;
      document.getElementById('val-crown-fillet')!.textContent = `${currentConfig.crown.filletRadius}`;

      checkShelf.checked = currentConfig.shelf.enabled;
      inputShelfW.value = `${currentConfig.shelf.width}`;
      document.getElementById('val-shelf-w')!.textContent = `${currentConfig.shelf.width}`;
      inputShelfH.value = `${currentConfig.shelf.height}`;
      document.getElementById('val-shelf-h')!.textContent = `${currentConfig.shelf.height}`;
      inputShelfFillet.value = `${currentConfig.shelf.filletRadius}`;
      document.getElementById('val-shelf-fillet')!.textContent = `${currentConfig.shelf.filletRadius}`;
    }

    function readUIIntoConfig() {
      currentConfig.width = parseInt(inputW.value, 10);
      currentConfig.height = parseInt(inputH.value, 10);
      currentConfig.baseRadius = parseInt(inputBaseR.value, 10);

      currentConfig.crown.enabled = checkCrown.checked;
      currentConfig.crown.width = parseInt(inputCrownW.value, 10);
      currentConfig.crown.height = parseInt(inputCrownH.value, 10);
      currentConfig.crown.filletRadius = parseInt(inputCrownFillet.value, 10);

      currentConfig.shelf.enabled = checkShelf.checked;
      currentConfig.shelf.width = parseInt(inputShelfW.value, 10);
      currentConfig.shelf.height = parseInt(inputShelfH.value, 10);
      currentConfig.shelf.filletRadius = parseInt(inputShelfFillet.value, 10);

      syncUIFromConfig();
      updateStagePath();
    }

    [inputW, inputH, inputBaseR, checkCrown, inputCrownW, inputCrownH, inputCrownFillet, checkShelf, inputShelfW, inputShelfH, inputShelfFillet].forEach(input => {
      input.addEventListener('input', readUIIntoConfig);
    });

    document.querySelectorAll('.viewport-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.viewport-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const w = parseInt(btn.getAttribute('data-w')!, 10);
        const h = parseInt(btn.getAttribute('data-h')!, 10);
        currentConfig.width = w;
        currentConfig.height = h;
        syncUIFromConfig();
        updateStagePath();
        fitStageToViewport();
      });
    });

    presetSelector.addEventListener('change', () => {
      const pKey = presetSelector.value as keyof typeof NEXAFY_PRESETS;
      if (NEXAFY_PRESETS[pKey]) {
        currentConfig = JSON.parse(JSON.stringify(NEXAFY_PRESETS[pKey]));
        scene = createSceneForPreset(currentConfig.id, currentConfig.width, currentConfig.height);
        selectedNodeId = scene.nodes[0]?.id || '';

        syncUIFromConfig();
        updateStagePath();
        fitStageToViewport();
        initSceneTree();
        renderCircuitLayers();
        runSceneValidation();
      }
    });

    toggleLivingMotion.addEventListener('change', () => {
      isLivingMotionEnabled = toggleLivingMotion.checked;
    });

    togglePulses.addEventListener('change', () => {
      isPulsesEnabled = togglePulses.checked;
      if (!isPulsesEnabled) pulsesLayer.innerHTML = '';
    });

    toggleCircuit.addEventListener('change', () => {
      edgesLayer.style.display = toggleCircuit.checked ? 'block' : 'none';
      pulsesLayer.style.display = toggleCircuit.checked ? 'block' : 'none';
    });

    toggleDebug.addEventListener('change', updateDebugOverlays);

    toggleRef.addEventListener('change', () => {
      refImg.style.display = toggleRef.checked ? 'block' : 'none';
      refImg.style.opacity = toggleRef.checked ? `${parseInt(inputRefOpacity.value) / 100}` : '0';
    });

    inputRefOpacity.addEventListener('input', () => {
      refImg.style.opacity = `${parseInt(inputRefOpacity.value) / 100}`;
      document.getElementById('val-ref-opacity')!.textContent = `${inputRefOpacity.value}%`;
    });

    selectRefBlend.addEventListener('change', () => {
      refImg.style.mixBlendMode = selectRefBlend.value;
    });

    // Morph Logic
    function applyMorph(t: number) {
      const cfgA = NEXAFY_PRESETS[morphA.value as keyof typeof NEXAFY_PRESETS] || NEXAFY_PRESETS.CHANNELS;
      const cfgB = NEXAFY_PRESETS[morphB.value as keyof typeof NEXAFY_PRESETS] || NEXAFY_PRESETS.SAAS;
      const cmdsA = generateContainerCommands(cfgA);
      const cmdsB = generateContainerCommands(cfgB);
      const morphedCmds = interpolateCommands(cmdsA, cmdsB, t);
      const d = commandsToSvgPath(morphedCmds);
      pathElem.setAttribute('d', d);
      outputArea.textContent = d;
    }

    morphT.addEventListener('input', () => {
      const t = parseFloat(morphT.value);
      valMorphT.textContent = t.toFixed(2);
      applyMorph(t);
    });

    function playMorphStep() {
      if (!isPlayingMorph) return;
      let t = parseFloat(morphT.value) + 0.012 * morphDirection;
      if (t >= 1) {
        t = 1;
        morphDirection = -1;
      } else if (t <= 0) {
        t = 0;
        morphDirection = 1;
      }
      morphT.value = t.toString();
      valMorphT.textContent = t.toFixed(2);
      applyMorph(t);
      morphAnimId = requestAnimationFrame(playMorphStep);
    }

    btnPlayMorph.addEventListener('click', () => {
      if (isPlayingMorph) {
        isPlayingMorph = false;
        btnPlayMorph.textContent = 'Play Morph Loop';
        if (morphAnimId) cancelAnimationFrame(morphAnimId);
      } else {
        isPlayingMorph = true;
        btnPlayMorph.textContent = 'Pause Morph Loop';
        playMorphStep();
      }
    });

    // Primitives description selector
    const PRIM_DESCRIPTIONS: Record<string, string> = {
      PROTRUDE: 'PROTRUDE: Outward plateau extrusion. Used for Hero top canopy headline crown.',
      RECESS: 'RECESS: Inward cavity indentation. Used for top nav bar clearance & access channels.',
      STEP: 'STEP: Terraced elevation change. Used for Sustainability aerial terrace balance.',
      SHELF: 'SHELF: Suspended platform drop. Used for guarantee ticker shelf (CHANNELS).',
      TAB: 'TAB: Compact protrusion for interactive anchors (Down-arrow circle, Book demo).',
      CHANNEL: 'CHANNEL: Longitudinal wiring conduit for 28px vascular circuit docking.',
      CUTOUT: 'CUTOUT: Subtractive relief for floating UI (Chapter tracker, chat pill).',
      ALL: 'CANONICAL: Full 58-command loop providing 100% deterministic morphing.'
    };

    document.querySelectorAll('.primitive-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.primitive-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const prim = btn.getAttribute('data-prim') || 'PROTRUDE';
        document.getElementById('primitive-desc')!.textContent = PRIM_DESCRIPTIONS[prim] || '';
      });
    });

    // Copy Path
    document.getElementById('btn-copy-path')?.addEventListener('click', () => {
      navigator.clipboard.writeText(pathElem.getAttribute('d') || '');
      alert('SVG Path copied to clipboard!');
    });

    // Timeline Playback
    btnPlayTimeline.addEventListener('click', () => {
      isPlayingTimeline = !isPlayingTimeline;
      btnPlayTimeline.textContent = isPlayingTimeline ? 'Pause' : 'Play';
      if (isPlayingTimeline) {
        let lastT = performance.now();
        function tLoop(now: number) {
          const dt = (now - lastT) / 1000;
          lastT = now;
          currentTimelineTime += dt;
          if (currentTimelineTime > 48.15) currentTimelineTime = 0;
          inputTimeline.value = currentTimelineTime.toFixed(2);
          displayTimeline.textContent = `${currentTimelineTime.toFixed(2).padStart(5, '0')}s / 48.15s`;
          applyTimelineFrame(currentTimelineTime);
          if (isPlayingTimeline) timelineAnimId = requestAnimationFrame(tLoop);
        }
        timelineAnimId = requestAnimationFrame(tLoop);
      } else if (timelineAnimId) {
        cancelAnimationFrame(timelineAnimId);
      }
    });

    btnResetTimeline.addEventListener('click', () => {
      if (isPlayingTimeline) {
        isPlayingTimeline = false;
        btnPlayTimeline.textContent = 'Play';
        if (timelineAnimId) cancelAnimationFrame(timelineAnimId);
      }
      jumpTimelineTo(0.0);
    });

    inputTimeline.addEventListener('input', () => {
      jumpTimelineTo(parseFloat(inputTimeline.value));
    });

    // Initialize
    syncUIFromConfig();
    updateStagePath();
    fitStageToViewport();
    initTimelineMarkers();
    initSceneTree();
    renderCircuitLayers();
    runSceneValidation();
    startLivingEngine();

    window.addEventListener('beforeunload', () => {
      clearTourTimeouts();
      if (_livingEngineAnimId) cancelAnimationFrame(_livingEngineAnimId);
      if (timelineAnimId) cancelAnimationFrame(timelineAnimId);
      if (morphAnimId) cancelAnimationFrame(morphAnimId);
    });
  }
</script>
