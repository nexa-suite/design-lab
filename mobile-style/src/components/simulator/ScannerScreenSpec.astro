---
/**
 * ScannerScreenSpec — Specimen for CameraX & ML Kit Barcode Scanning
 * Represents the mandatory hardware scanning slice with manual fallback from ADR-0018.
 */
---

<div class="scanner-screen">
  <!-- Viewfinder Overlay & Camera Feed Mockup -->
  <div class="camera-feed-stage">
    <!-- Camera Header Controls -->
    <div class="scanner-header">
      <button type="button" class="btn-scan-ctrl" title="Volver a la ruta">
        <i class="pi pi-arrow-left"></i>
      </button>
      <span class="scan-title">Escanear Guía / Activo</span>
      <button type="button" class="btn-scan-ctrl" id="btn-flash" title="Activar Linterna LED">
        <i class="pi pi-bolt"></i>
      </button>
    </div>

    <!-- Reticle Target Viewfinder -->
    <div class="viewfinder-box">
      <div class="corner-marker top-left"></div>
      <div class="corner-marker top-right"></div>
      <div class="corner-marker bottom-left"></div>
      <div class="corner-marker bottom-right"></div>
      
      <!-- Animated Laser Scanning Beam -->
      <div class="laser-beam"></div>

      <!-- Instruction Label -->
      <div class="scan-hint">
        <span>Alinee el código QR o código de barras (Code 128 / DataMatrix)</span>
      </div>
    </div>

    <!-- Active Hardware Status Badge -->
    <div class="hardware-badge">
      <span class="pulse-dot"></span>
      <span>CameraX Active · 60 FPS · ML Kit Vision</span>
    </div>
  </div>

  <!-- Bottom Drawer: Scanned Result & Mandatory Manual Input Fallback -->
  <div class="scan-drawer">
    <div class="drawer-handle"></div>

    <!-- Successful Recognition Preview -->
    <div class="detected-asset-card">
      <div class="asset-icon"><i class="pi pi-qrcode"></i></div>
      <div class="asset-details">
        <span class="asset-code">ASSET-NX-84920</span>
        <span class="asset-name">Generador Trifásico 250 kVA · Serie #G-991</span>
      </div>
      <span class="verified-pill">VALIDADO</span>
    </div>

    <!-- Mandatory Manual Fallback (ADR-0018 Requirement) -->
    <div class="manual-fallback-group">
      <div class="fallback-header">
        <span class="fallback-title">¿Código ilegible o dañado?</span>
        <span class="fallback-tag">FALLBACK MANUAL OBLIGATORIO</span>
      </div>
      
      <div class="manual-input-row">
        <div class="input-wrapper">
          <i class="pi pi-pencil"></i>
          <input 
            type="text" 
            placeholder="Escriba código de guía manual..." 
            value="ORD-2026-9812-A"
          />
        </div>
        <button type="button" class="btn-confirm-code">
          <span>Validar</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .scanner-screen {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #090e17;
    color: #ffffff;
    font-family: var(--nexa-mobile-font-family, sans-serif);
    position: relative;
    overflow: hidden;
  }

  /* Camera Stage Simulation */
  .camera-feed-stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    background: radial-gradient(circle at center, #132438 0%, #060b13 100%);
    position: relative;
  }

  .scanner-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 10;
  }

  .btn-scan-ctrl {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.15s ease;

    &:hover {
      background: rgba(42, 103, 217, 0.6);
      border-color: #38c8ff;
    }
  }

  .scan-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #f1f5f9;
  }

  /* Viewfinder Reticle */
  .viewfinder-box {
    width: 250px;
    height: 250px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.55);
    border-radius: 16px;
  }

  .corner-marker {
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: #38c8ff;
    border-style: solid;
  }

  .top-left {
    top: 0;
    left: 0;
    border-width: 3.5px 0 0 3.5px;
    border-top-left-radius: 12px;
  }

  .top-right {
    top: 0;
    right: 0;
    border-width: 3.5px 3.5px 0 0;
    border-top-right-radius: 12px;
  }

  .bottom-left {
    bottom: 0;
    left: 0;
    border-width: 0 0 3.5px 3.5px;
    border-bottom-left-radius: 12px;
  }

  .bottom-right {
    bottom: 0;
    right: 0;
    border-width: 0 3.5px 3.5px 0;
    border-bottom-right-radius: 12px;
  }

  .laser-beam {
    width: 90%;
    height: 2.5px;
    background: #38c8ff;
    box-shadow: 0 0 12px #38c8ff, 0 0 24px #2563eb;
    position: absolute;
    top: 20%;
    animation: scanPulse 2.4s ease-in-out infinite alternate;
  }

  @keyframes scanPulse {
    0% {
      top: 15%;
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
    100% {
      top: 85%;
      opacity: 0.8;
    }
  }

  .scan-hint {
    position: absolute;
    bottom: -45px;
    font-size: 11px;
    color: #cbd5e1;
    text-align: center;
    width: 280px;
    line-height: 1.4;
    background: rgba(15, 23, 42, 0.7);
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hardware-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-family: var(--nexa-mobile-font-family-mono, monospace);
    color: #94a3b8;
    background: rgba(15, 23, 42, 0.8);
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
    animation: blinkDot 1.2s infinite;
  }

  @keyframes blinkDot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* Scan Bottom Drawer */
  .scan-drawer {
    background: var(--nexa-mobile-surface-card, #ffffff);
    color: var(--nexa-mobile-text-primary, #0f172a);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-shadow: 0 -4px 16px rgba(0,0,0,0.25);
  }

  .drawer-handle {
    width: 36px;
    height: 4px;
    background: #cbd5e1;
    border-radius: 2px;
    align-self: center;
    margin-bottom: 2px;
  }

  .detected-asset-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 0.65rem 0.85rem;
    border-radius: 12px;
  }

  .asset-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #dcfce7;
    color: #16a34a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .asset-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .asset-code {
    font-family: var(--nexa-mobile-font-family-mono, monospace);
    font-size: 12px;
    font-weight: 700;
    color: #166534;
  }

  .asset-name {
    font-size: 11.5px;
    color: #334155;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 170px;
  }

  .verified-pill {
    font-size: 9px;
    font-weight: 800;
    background: #16a34a;
    color: #ffffff;
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Manual Fallback */
  .manual-fallback-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    border-top: 1px dashed #e2e8f0;
    padding-top: 0.65rem;
  }

  .fallback-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .fallback-title {
    font-size: 11.5px;
    font-weight: 700;
    color: #475569;
  }

  .fallback-tag {
    font-size: 8.5px;
    font-weight: 800;
    color: #d97706;
    background: #fef3c7;
    padding: 1px 5px;
    border-radius: 4px;
  }

  .manual-input-row {
    display: flex;
    gap: 0.5rem;
  }

  .input-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 0 0.65rem;
    gap: 0.4rem;

    i {
      font-size: 12px;
      color: #94a3b8;
    }

    input {
      border: none;
      background: transparent;
      outline: none;
      font-family: var(--nexa-mobile-font-family-mono, monospace);
      font-size: 12px;
      color: #0f172a;
      width: 100%;
      height: 38px;
    }
  }

  .btn-confirm-code {
    background: var(--nexa-mobile-primary, #2a67d9);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 0 0.85rem;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    min-height: 48px; /* 48dp minimum touch target */
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;

    &:hover {
      background: #1d4ed8;
    }
  }
</style>
