---
// NewsSection: Authentic White Background Editorial Blog Grid
// Evidence: Bürocratik Awwwards SOTD (Scene 9, t=50-55s, frames 0068, 0072)
// Pure white background #ffffff with 3 authentic editorial cards and graphical banners
---

<section class="news-section" id="news" aria-labelledby="news-heading">
  <div class="news-container">
    
    <!-- Editorial Headline -->
    <div class="news-header">
      <h2 id="news-heading" class="news-title">
        Our latest <span class="text-mint-word">news</span>
      </h2>
    </div>

    <!-- 3 Editorial News Cards -->
    <div class="news-grid">
      
      <!-- Article 1: Enter the rental economy NOW -->
      <article class="news-card">
        <a href="#article-1" class="news-card-link-wrapper" aria-label="Read article: The time to enter the rental economy is NOW!">
          <div class="news-banner-visual banner-green" aria-hidden="true">
            <div class="banner-top-tag">
              <span class="banner-mini-text">Tick, tock... Join the rental economy NOW!</span>
            </div>
            <div class="banner-center-graphic">
              <div class="go-green-sign">
                <span class="sign-text">NEXA COLD</span>
              </div>
            </div>
            <div class="banner-brand-bottom">
              <span class="banner-flecto-mark">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#38bdf8">
                  <rect x="2" y="4" width="8" height="6" rx="2"/>
                  <rect x="14" y="4" width="8" height="6" rx="2"/>
                  <rect x="2" y="14" width="8" height="6" rx="2"/>
                  <rect x="14" y="14" width="8" height="6" rx="2"/>
                </svg>
                <span class="banner-flecto-name">Nexa</span>
              </span>
            </div>
          </div>

          <div class="news-content-body">
            <h3 class="news-card-heading">
              The time to enter the rental economy is NOW!
            </h3>
            <span class="news-read-cta">Read on our blog</span>
          </div>
        </a>
      </article>

      <!-- Article 2: 5-Step Guide to Migrate -->
      <article class="news-card">
        <a href="#article-2" class="news-card-link-wrapper" aria-label="Read article: 5-Step Guide to Migrate Your Rental Business to Online">
          <div class="news-banner-visual banner-orange" aria-hidden="true">
            <div class="banner-top-tag">
              <span class="banner-mini-text">Going digital: the next step for your rental business</span>
            </div>
            <div class="banner-center-graphic">
              <!-- Hand holding smartphone -->
              <div class="phone-silhouette">
                <div class="phone-screen-inner"></div>
              </div>
            </div>
            <div class="banner-brand-bottom">
              <span class="banner-flecto-mark">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#ffffff">
                  <rect x="2" y="4" width="8" height="6" rx="2"/>
                  <rect x="14" y="4" width="8" height="6" rx="2"/>
                  <rect x="2" y="14" width="8" height="6" rx="2"/>
                  <rect x="14" y="14" width="8" height="6" rx="2"/>
                </svg>
                <span class="banner-flecto-name white-name">Flecto</span>
              </span>
            </div>
          </div>

          <div class="news-content-body">
            <h3 class="news-card-heading">
              5-Step Guide to Migrate Your Rental Business to Online
            </h3>
            <span class="news-read-cta">Read on our blog</span>
          </div>
        </a>
      </article>

      <!-- Article 3: From Rnters to Flecto -->
      <article class="news-card">
        <a href="#article-3" class="news-card-link-wrapper" aria-label="Read article: From Rnters to Flecto">
          <div class="news-banner-visual banner-teal" aria-hidden="true">
            <div class="banner-top-tag">
              <span class="banner-mini-text">Our journey so far<br/>Rnters &rarr; Flecto</span>
            </div>
            <div class="banner-center-graphic">
              <!-- Hot air balloon vector -->
              <svg width="68" height="80" viewBox="0 0 24 30" fill="none" class="balloon-svg">
                <path d="M12 2C6.5 2 2 6.5 2 12c0 4.5 3 7.5 5 10l5 3 5-3c2-2.5 5-5.5 5-10 0-5.5-4.5-10-10-10z" fill="#f4a261"/>
                <path d="M8 2c-3 3-3 7-1 10l5 3V2H8z" fill="#e76f51"/>
                <path d="M16 2c3 3 3 7 1 10l-5 3V2h4z" fill="#e9c46a"/>
                <rect x="10" y="27" width="4" height="3" rx="1" fill="#264653"/>
              </svg>
            </div>
            <div class="banner-brand-bottom">
              <span class="banner-flecto-mark">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#082846">
                  <rect x="2" y="4" width="8" height="6" rx="2"/>
                  <rect x="14" y="4" width="8" height="6" rx="2"/>
                  <rect x="2" y="14" width="8" height="6" rx="2"/>
                  <rect x="14" y="14" width="8" height="6" rx="2"/>
                </svg>
                <span class="banner-flecto-name dark-name">Nexa</span>
              </span>
            </div>
          </div>

          <div class="news-content-body">
            <h3 class="news-card-heading">
              De Cadena Tradicional a Nexa OS
            </h3>
            <span class="news-read-cta">Read on our blog</span>
          </div>
        </a>
      </article>

    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     AUTHENTIC PURE WHITE NEWS SECTION (#ffffff)
     ========================================================================== */
  .news-section {
    background-color: #ffffff;
    color: #082846;
    padding: 7rem 1.5rem 5rem;
    position: relative;
  }

  .news-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Header */
  .news-header {
    text-align: center;
  }

  .news-title {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 700;
    line-height: 1.05;
    color: #082846;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .text-mint-word {
    color: #2563eb;
    font-weight: 700;
  }

  /* News Grid */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .news-card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .news-card:hover {
    transform: translateY(-4px);
  }

  .news-card-link-wrapper {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Graphical Banner Visuals */
  .news-banner-visual {
    height: 190px;
    border-radius: 18px;
    position: relative;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .banner-green {
    background: #082846;
  }

  .banner-orange {
    background: #e76f51;
  }

  .banner-teal {
    background: #0284c7;
  }

  .banner-top-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.9);
    max-width: 140px;
    z-index: 2;
  }

  .banner-center-graphic {
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Go Green Sign */
  .go-green-sign {
    background: #dbeafe;
    padding: 0.85rem 1.25rem;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .sign-text {
    font-size: 0.875rem;
    font-weight: 800;
    color: #1e40af;
    letter-spacing: 0.05em;
  }

  /* Phone Silhouette */
  .phone-silhouette {
    width: 60px;
    height: 110px;
    background: #111;
    border-radius: 14px;
    padding: 6px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
    transform: rotate(12deg);
  }

  .phone-screen-inner {
    width: 100%;
    height: 100%;
    background: #264653;
    border-radius: 10px;
  }

  /* Hot Air Balloon */
  .balloon-svg {
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.15));
  }

  /* Brand Mark at Bottom */
  .banner-brand-bottom {
    z-index: 2;
  }

  .banner-flecto-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #ffffff;
  }

  .white-name {
    color: #ffffff;
  }

  .dark-name {
    color: #082846;
  }

  /* Content Body */
  .news-content-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0 0.5rem;
  }

  .news-card-heading {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
    color: #082846;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .news-read-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: #2563eb;
    transition: color 0.2s ease;
  }

  .news-card:hover .news-read-cta {
    color: #1d4ed8;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .news-section {
      padding: 4.5rem 1rem 3.5rem;
    }
    .news-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .news-banner-visual {
      height: 160px;
    }
    .news-card-heading {
      font-size: 1.2rem;
    }
  }
</style>
