  /* Section 2: Wireframes Visual Stage */
  .wireframes-stage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .wireframes-stage-grid {
      grid-template-columns: 1fr;
    }
  }

  .wireframe-card {
    padding: 18px;
    border: 1px solid var(--nexa-color-border-default, #e2e8f0);
    border-radius: 14px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

