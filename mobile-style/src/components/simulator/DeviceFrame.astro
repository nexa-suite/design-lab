---
/**
 * DeviceFrame.astro — Canonical Multi-Device Android Studio & Viewport Ergonomics Inspector
 * Nexa Suite · Material 3 Design System & Ergonomics Validation
 *
 * Upgraded Features:
 *  - Interactive Calibrator & Model Sizer:
 *    * Presets: S24 (390dp), S24 Ultra (412dp), Zebra TC58 (412dp), Tab Active 8" (600dp), Tab S9 11" (800dp)
 *    * Custom Dimension Inputs: Width (320-960dp), Height (600-1400dp)
 *    * Dynamic Padding Adjuster: Compact (12dp), Standard (16dp), Spacious (24dp)
 *  - Clean TopAppBar: Hamburger on left, dynamic Title, Notification bell, and User Profile on right (No duplication!)
 *  - Persistent BottomNav: Synced with active screen (Rutas, Despacho, Picking, Checklist)
 *  - Pure Minimalist Nexa Palette: 100% White Backgrounds (#ffffff), zero dark blue cards
 */
import OperationsScreenSpec from './OperationsScreenSpec.astro';
import BuyerScreenSpec from './BuyerScreenSpec.astro';
import BottomSheetSpec from './BottomSheetSpec.astro';
import ScannerScreenSpec from './ScannerScreenSpec.astro';
import InteractiveMobileNavbar from './InteractiveMobileNavbar.astro';
import InteractiveWholesaleCatalog from './InteractiveWholesaleCatalog.astro';
import InteractiveMobileForms from './InteractiveMobileForms.astro';
import InteractiveDispatchMovement from './InteractiveDispatchMovement.astro';
import LoginScreenSpec from './LoginScreenSpec.astro';
---

<div class="screen-spec-container" id="simulador-interactivo">
  
  <!-- Section Heading Block -->
  <header class="section-heading-block">
    <div class="section-heading">
      <span class="section-index">01</span>
      <div>
        <p class="section-kicker">SIMULADOR & CALIBRADOR DINÁMICO ANDROID · JETPACK COMPOSE M3</p>
        <h2>Simulador Móvil Interactivo & Calibrador de Medidas y Padding</h2>
        <p class="section-intro">
          Ajusta interactivamente cualquier modelo, medidas personalizadas en <strong>dp</strong> y espaciado de pantalla (<strong>padding</strong>). 
          La interfaz se reacomoda dinámicamente con adaptación de contenedor (@container) entre smartphone compacto y tablet expansiva.
        </p>
      </div>
    </div>

    <!-- Quick Meta Chips -->
    <div class="heading-meta-chips">
      <span class="cuadro-tag primary"><i class="pi pi-android" aria-hidden="true"></i> Android 14 (API 34)</span>
      <span class="cuadro-tag" id="chip-live-dimensions"><i class="pi pi-mobile" aria-hidden="true"></i> 390 × 844 dp</span>
      <span class="cuadro-tag success" id="chip-live-padding"><i class="pi pi-sliders-h" aria-hidden="true"></i> Padding: 16dp</span>
      <span class="cuadro-tag kotlin"><i class="pi pi-bars" aria-hidden="true"></i> TopBar & BottomNav Activas</span>
    </div>
  </header>

  <!-- Interactive Calibrator & Model Controls Card -->
  <div class="stage-controls-card">
    
    <!-- Top Row: Device Presets -->
    <div class="control-cluster">
      <span class="control-label">DISPOSITIVO Y FACTOR DE FORMA:</span>
      <div class="button-toggle-group" id="group-device-presets">
        <button type="button" class="btn-ctrl device-preset-btn active" data-width="390" data-height="844" data-padding="16" data-name="Galaxy S24 (390dp)">
          <i class="pi pi-mobile"></i> Galaxy S24 (390dp)
        </button>
        <button type="button" class="btn-ctrl device-preset-btn" data-width="412" data-height="915" data-padding="16" data-name="Pixel 8 / S24 Ultra (412dp)">
          <i class="pi pi-mobile"></i> S24 Ultra (412dp)
        </button>
        <button type="button" class="btn-ctrl device-preset-btn" data-width="412" data-height="820" data-padding="12" data-name="Zebra TC58 Rugged (412dp)">
          <i class="pi pi-shield"></i> Zebra TC58 (412dp)
        </button>
        <button type="button" class="btn-ctrl device-preset-btn tablet" data-width="600" data-height="880" data-padding="20" data-name="Tab Active 8&quot; (600dp)">
          <i class="pi pi-tablet"></i> Tab Active 8" (600dp)
        </button>
        <button type="button" class="btn-ctrl device-preset-btn tablet" data-width="800" data-height="920" data-padding="24" data-name="Tab S9 11&quot; (800dp)">
          <i class="pi pi-desktop"></i> Tab S9 11" (800dp)
        </button>
      </div>
    </div>

    <!-- Middle Row: Interactive Dimension & Padding Sliders -->
    <div class="calibrator-fine-tune-row">
      <!-- Width Adjuster -->
      <div class="calibrator-param-box">
        <label for="input-custom-width">
          <i class="pi pi-arrows-h"></i>
          <span>Ancho: <strong id="lbl-custom-width">390dp</strong></span>
        </label>
        <div class="param-input-wrap">
          <input type="range" id="slider-custom-width" min="320" max="860" step="10" value="390" class="calibrator-slider" />
          <input type="number" id="num-custom-width" min="320" max="960" step="10" value="390" class="calibrator-num-input" />
          <span class="unit-tag">dp</span>
        </div>
      </div>

      <!-- Height Adjuster -->
      <div class="calibrator-param-box">
        <label for="input-custom-height">
          <i class="pi pi-arrows-v"></i>
          <span>Alto: <strong id="lbl-custom-height">780dp</strong></span>
        </label>
        <div class="param-input-wrap">
          <input type="range" id="slider-custom-height" min="600" max="1100" step="20" value="780" class="calibrator-slider" />
          <input type="number" id="num-custom-height" min="600" max="1200" step="20" value="780" class="calibrator-num-input" />
          <span class="unit-tag">dp</span>
        </div>
      </div>

      <!-- Padding Inset Adjuster -->
      <div class="calibrator-param-box">
        <label>
          <i class="pi pi-sliders-h"></i>
          <span>Padding de Pantalla:</span>
        </label>
        <div class="padding-pills-group" id="group-padding-pills">
          <button type="button" class="btn-pad-pill" data-padding="12">12dp (Compacto)</button>
          <button type="button" class="btn-pad-pill active" data-padding="16">16dp (M3 Estándar)</button>
          <button type="button" class="btn-pad-pill" data-padding="20">20dp (Espacioso)</button>
          <button type="button" class="btn-pad-pill" data-padding="24">24dp (Tablet)</button>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Screen Specimen Selector -->
    <div class="control-cluster">
      <span class="control-label">PANTALLA ACTIVA EN EL SIMULADOR:</span>
      <div class="button-toggle-group" id="group-screen-selector">
        <button type="button" class="btn-ctrl screen-btn active" data-screen="operations" data-title="Operaciones Nexa · En Ruta">
          <i class="pi pi-truck"></i> Operaciones (En Ruta)
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="dispatch-live" data-title="Tablero de Despacho & Movimiento">
          <i class="pi pi-send"></i> Despacho Kanban (Live)
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="catalog-live" data-title="Catálogo Mayorista B2B">
          <i class="pi pi-shopping-bag"></i> Catálogo B2B (Live)
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="forms-live" data-title="Inspección ISO 3691 & Firma POD">
          <i class="pi pi-pencil"></i> Formularios & POD (Live)
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="navbar-live" data-title="Navegación & Sucursales M3">
          <i class="pi pi-bars"></i> Navbar & Sucursales (Live)
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="scanner" data-title="Escáner Óptico CameraX">
          <i class="pi pi-qrcode"></i> Escáner CameraX
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="buyer" data-title="Portal de Comprador B2B">
          <i class="pi pi-shopping-cart"></i> Comprador B2B
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="login" data-title="Acceso a Espacio de Trabajo · Login">
          <i class="pi pi-lock"></i> Login & Workspace
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="sheet" data-title="Detalle de Entrega M3">
          <i class="pi pi-sliders-h"></i> Bottom Sheet M3
        </button>
      </div>
    </div>
  </div>

  <!-- Pure Software Viewport Stage (Clean Minimalist Nexa Frame) -->
  <div class="architectural-stage-wrapper">
    <div class="viewport-card-frame" id="viewport-frame" style="width: 390px;">
      
      <!-- Android 14 System Bar -->
      <div class="frame-system-bar">
        <span class="sys-time">14:35</span>
        <div class="sys-icons">
          <span class="sys-net">5G LTE</span>
          <i class="pi pi-wifi"></i>
          <i class="pi pi-bolt"></i>
          <span class="sys-batt">94%</span>
        </div>
      </div>

      <!-- M3 TopAppBar (Single Canonical Top Bar: Hamburger left, Title, Bell, Profile right) -->
      <header class="frame-m3-top-bar" id="frame-top-bar">
        <div class="top-bar-left">
          <button type="button" class="frame-icon-btn" aria-label="Menú principal">
            <i class="pi pi-bars"></i>
          </button>
          <h3 class="frame-top-title" id="frame-top-title">Operaciones Nexa · En Ruta</h3>
        </div>
        <div class="top-bar-right">
          <button type="button" class="frame-icon-btn notif-btn" aria-label="Notificaciones">
            <i class="pi pi-bell"></i>
            <span class="notif-dot"></span>
          </button>
          <div class="frame-user-avatar" title="Perfil Conductor">
            <i class="pi pi-user"></i>
          </div>
        </div>
      </header>

      <!-- Scrollable Screen Content Host Container -->
      <div class="screen-viewport-host" id="screen-viewport-host" style="height: 660px; padding: 16px;">
        
        <!-- Screen 0: Workspace Login & Access Specimen -->
        <div class="screen-view" id="view-login">
          <LoginScreenSpec />
        </div>

        <!-- Screen 1 (DEFAULT): Canonical Operaciones (Clean without duplicated header/footer) -->
        <div class="screen-view active" id="view-operations">
          <OperationsScreenSpec />
        </div>

        <!-- Screen 2: Fixed Live Kanban Board (with tabs on phone, 4 columns on tablet) -->
        <div class="screen-view" id="view-dispatch-live">
          <InteractiveDispatchMovement />
        </div>

        <!-- Screen 3: Wholesale B2B Catalog -->
        <div class="screen-view" id="view-catalog-live">
          <InteractiveWholesaleCatalog />
        </div>

        <!-- Screen 4: Forms & POD -->
        <div class="screen-view" id="view-forms-live">
          <InteractiveMobileForms />
        </div>

        <!-- Screen 5: Navbar & Branches -->
        <div class="screen-view" id="view-navbar-live">
          <InteractiveMobileNavbar />
        </div>

        <!-- Screen 6: Canonical CameraX Scanner -->
        <div class="screen-view" id="view-scanner">
          <ScannerScreenSpec />
        </div>

        <!-- Screen 7: Canonical Buyer Specimen -->
        <div class="screen-view" id="view-buyer">
          <BuyerScreenSpec />
        </div>

        <!-- Screen 8: Canonical Bottom Sheet Specimen -->
        <div class="screen-view" id="view-sheet">
          <BottomSheetSpec />
        </div>
      </div>

      <!-- Persistent M3 Bottom Navigation Bar (Synchronized with active screens) -->
      <nav class="frame-m3-bottom-nav" id="frame-bottom-nav" aria-label="Navegación principal de la aplicación">
        <button type="button" class="nav-destination active" data-dest="inicio" aria-label="Inicio">
          <i class="pi pi-home"></i>
          <span>Inicio</span>
        </button>
        <button type="button" class="nav-destination" data-dest="rutas" aria-label="Rutas">
          <i class="pi pi-map-marker"></i>
          <span>Rutas</span>
        </button>
        <button type="button" class="nav-destination" data-dest="despacho" aria-label="Despacho">
          <i class="pi pi-send"></i>
          <span>Despacho</span>
        </button>
        <button type="button" class="nav-destination" data-dest="picking" aria-label="Picking">
          <i class="pi pi-box"></i>
          <span>Picking</span>
        </button>
        <button type="button" class="nav-destination" data-dest="checklist" aria-label="Checklist">
          <i class="pi pi-check-square"></i>
          <span>Checklist</span>
        </button>
      </nav>

      <!-- Frame Footnote / Spec Metadata -->
      <div class="frame-spec-footer">
        <div class="footer-meta">
          <span class="live-dot"></span>
          <span class="footer-spec-label" id="frame-info-label">Galaxy S24 · 390 × 844dp · Android 14 M3</span>
        </div>
        <div class="footer-badges">
          <span class="footer-chip">WCAG AAA</span>
          <span class="footer-chip">Touch 48/56dp</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const frame = document.getElementById('viewport-frame');
    const host = document.getElementById('screen-viewport-host');
    const infoLabel = document.getElementById('frame-info-label');
    const topTitle = document.getElementById('frame-top-title');

    // Controls
    const devicePresetBtns = document.querySelectorAll('.device-preset-btn');
    const sliderWidth = document.getElementById('slider-custom-width') as HTMLInputElement | null;
    const numWidth = document.getElementById('num-custom-width') as HTMLInputElement | null;
    const lblWidth = document.getElementById('lbl-custom-width');

    const sliderHeight = document.getElementById('slider-custom-height') as HTMLInputElement | null;
    const numHeight = document.getElementById('num-custom-height') as HTMLInputElement | null;
    const lblHeight = document.getElementById('lbl-custom-height');

    const padPills = document.querySelectorAll('.btn-pad-pill');
    const screenButtons = document.querySelectorAll('.screen-btn');
    const screenViews = document.querySelectorAll('.screen-view');
    const navDests = document.querySelectorAll('.nav-destination');

    const chipDims = document.getElementById('chip-live-dimensions');
    const chipPad = document.getElementById('chip-live-padding');

    let currentWidth = 390;
    let currentHeight = 780;
    let currentPadding = 16;
    let currentModelName = 'Galaxy S24';

    function applyDimensions(w: number, h: number, p: number, name?: string) {
      currentWidth = w;
      currentHeight = h;
      currentPadding = p;
      if (name) currentModelName = name;

      // Update frame width
      if (frame) {
        frame.style.width = `${w}px`;
        if (w >= 580) {
          frame.classList.add('mode-tablet');
        } else {
          frame.classList.remove('mode-tablet');
        }
      }

      // Update host height & padding
      if (host) {
        const hostH = Math.max(480, h - 140);
        host.style.height = `${hostH}px`;
        host.style.padding = `${p}px`;
      }

      // Update UI numbers & sliders
      if (sliderWidth) sliderWidth.value = String(w);
      if (numWidth) numWidth.value = String(w);
      if (lblWidth) lblWidth.textContent = `${w}dp`;

      if (sliderHeight) sliderHeight.value = String(h);
      if (numHeight) numHeight.value = String(h);
      if (lblHeight) lblHeight.textContent = `${h}dp`;

      // Update chips & labels
      if (chipDims) chipDims.innerHTML = `<i class="pi pi-mobile"></i> ${w} × ${h} dp`;
      if (chipPad) chipPad.innerHTML = `<i class="pi pi-sliders-h"></i> Padding: ${p}dp`;
      if (infoLabel) {
        infoLabel.textContent = `${currentModelName} · ${w} × ${h}dp · Padding ${p}dp · ${w >= 580 ? 'Tablet' : 'Móvil'}`;
      }
    }

    // Preset button clicks
    devicePresetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        devicePresetBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const w = parseInt(btn.getAttribute('data-width') || '390', 10);
        const h = parseInt(btn.getAttribute('data-height') || '780', 10);
        const p = parseInt(btn.getAttribute('data-padding') || '16', 10);
        const name = btn.getAttribute('data-name') || 'Android Model';

        // Sync padding pill
        padPills.forEach(pill => {
          const padVal = parseInt(pill.getAttribute('data-padding') || '16', 10);
          pill.classList.toggle('active', padVal === p);
        });

        applyDimensions(w, h, p, name);
      });
    });

    // Custom width changes
    function onWidthChange(val: number) {
      devicePresetBtns.forEach(b => b.classList.remove('active'));
      applyDimensions(val, currentHeight, currentPadding, 'Personalizado');
    }
    sliderWidth?.addEventListener('input', () => onWidthChange(parseInt(sliderWidth.value, 10)));
    numWidth?.addEventListener('input', () => onWidthChange(parseInt(numWidth.value || '390', 10)));

    // Custom height changes
    function onHeightChange(val: number) {
      devicePresetBtns.forEach(b => b.classList.remove('active'));
      applyDimensions(currentWidth, val, currentPadding, 'Personalizado');
    }
    sliderHeight?.addEventListener('input', () => onHeightChange(parseInt(sliderHeight.value, 10)));
    numHeight?.addEventListener('input', () => onHeightChange(parseInt(numHeight.value || '780', 10)));

    // Padding pill changes
    padPills.forEach(pill => {
      pill.addEventListener('click', () => {
        padPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const p = parseInt(pill.getAttribute('data-padding') || '16', 10);
        applyDimensions(currentWidth, currentHeight, p);
      });
    });

    // Switch Screen Specimen
    screenButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        screenButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const targetScreen = btn.getAttribute('data-screen');
        const titleText = btn.getAttribute('data-title') || 'Operaciones Nexa';

        if (topTitle) {
          topTitle.textContent = titleText;
        }

        screenViews.forEach(view => {
          view.classList.remove('active');
        });

        const activeView = document.getElementById(`view-${targetScreen}`);
        if (activeView) {
          activeView.classList.add('active');
        }

        // Sync bottom nav destinations & visibility
        const frameBottomNav = document.getElementById('frame-bottom-nav');
        if (targetScreen === 'login') {
          if (frameBottomNav) frameBottomNav.style.display = 'none';
        } else {
          if (frameBottomNav) frameBottomNav.style.display = 'flex';
        }

        navDests.forEach(dest => dest.classList.remove('active'));
        if (targetScreen === 'operations') {
          document.querySelector('[data-dest="inicio"]')?.classList.add('active');
        } else if (targetScreen === 'dispatch-live') {
          document.querySelector('[data-dest="despacho"]')?.classList.add('active');
        } else if (targetScreen === 'catalog-live') {
          document.querySelector('[data-dest="picking"]')?.classList.add('active');
        } else if (targetScreen === 'forms-live') {
          document.querySelector('[data-dest="checklist"]')?.classList.add('active');
        }
      });
    });

    // Interactive Bottom Nav Destination Switching
    navDests.forEach(dest => {
      dest.addEventListener('click', () => {
        navDests.forEach(d => d.classList.remove('active'));
        dest.classList.add('active');

        const destId = dest.getAttribute('data-dest');
        if (destId === 'inicio') {
          document.querySelector('[data-screen="operations"]')?.dispatchEvent(new Event('click'));
        } else if (destId === 'rutas') {
          document.querySelector('[data-screen="operations"]')?.dispatchEvent(new Event('click'));
        } else if (destId === 'despacho') {
          document.querySelector('[data-screen="dispatch-live"]')?.dispatchEvent(new Event('click'));
        } else if (destId === 'picking') {
          document.querySelector('[data-screen="catalog-live"]')?.dispatchEvent(new Event('click'));
        } else if (destId === 'checklist') {
          document.querySelector('[data-screen="forms-live"]')?.dispatchEvent(new Event('click'));
        }
      });
    });
  });
</script>

<style>
  .screen-spec-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Section Heading */
  .section-heading-block {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
  }

  .section-heading {
    display: flex;
    gap: 16px;
    max-width: 820px;
  }

  .section-index {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 14px;
    font-weight: 700;
    color: var(--nexa-color-primary-600, #2563eb);
    background: var(--nexa-color-primary-50, #eff6ff);
    border: 1px solid var(--nexa-color-primary-200, #bfdbfe);
    border-radius: 8px;
    padding: 6px 10px;
    height: fit-content;
  }

  .section-kicker {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--nexa-color-primary-600, #2563eb);
    margin-bottom: 4px;
  }

  .section-heading h2 {
    font-family: var(--nexa-font-family-display, sans-serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--nexa-color-text-primary, #0f172a);
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  .section-intro {
    font-size: 14px;
    line-height: 1.55;
    color: var(--nexa-color-text-secondary, #64748b);
  }

  .heading-meta-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-self: center;
  }

  .cuadro-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    background: #ffffff;
    border: 1px solid var(--nexa-color-border-default, #cbd5e1);
    color: #334155;
  }

  .cuadro-tag.primary {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #1d4ed8;
  }

  .cuadro-tag.success {
    background: #e0f2fe;
    border-color: #bae6fd;
    color: #0284c7;
  }

  .cuadro-tag.kotlin {
    background: #f5f3ff;
    border-color: #ddd6fe;
    color: #6d28d9;
  }

  /* Interactive Stage Controls Card */
  .stage-controls-card {
    background: #ffffff;
    border: 1px solid var(--nexa-color-border-default, #cbd5e1);
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .control-cluster {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .control-label {
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #475569;
  }

  .button-toggle-group {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .btn-ctrl {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    background: #f8fafc;
    border: 1px solid var(--nexa-color-border-default, #cbd5e1);
    color: #334155;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-ctrl:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
  }

  .btn-ctrl.active {
    background: #0f172a;
    border-color: #0f172a;
    color: #ffffff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.2);
  }

  /* Fine Tune Row (Sliders & Numbers) */
  .calibrator-fine-tune-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 16px;
    padding: 12px 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
