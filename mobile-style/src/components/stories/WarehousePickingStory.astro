    background: #ffffff;
    border: 1px solid var(--nexa-color-border-default, #e2e8f0);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .story-meta-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--nexa-color-primary-50, #eff6ff);
    color: var(--nexa-color-primary-700, #1d4ed8);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 12px;
  }

  .story-title {
    font-family: var(--nexa-font-family-display, sans-serif);
    font-size: 22px;
    font-weight: 800;
    color: var(--nexa-color-text-primary, #0f172a);
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }

