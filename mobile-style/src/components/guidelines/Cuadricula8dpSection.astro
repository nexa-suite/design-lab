---
/**
 * Cuadricula8dpSection.astro
 * Canonical 8dp Spatial Grid System for Android Jetpack Compose
 */
---

<div class="cuadricula-8dp-container" data-platform-target="universal">
  <section class="spec-card">
    <div class="card-header-row">
      <div class="card-badge-icon"><i class="pi pi-th-large"></i></div>
      <div>
        <span class="card-eyebrow">FUNDAMENTOS M3 · ESPACIADO ESPACIAL</span>
        <h3 class="card-title">Cuadrícula Espacial de 8dp (con medios pasos de 4dp)</h3>
      </div>
    </div>
    <p class="card-text">
      Todo el espaciado vertical y horizontal en Nexa Mobile sigue múltiplos estrictos de <strong>8dp (8, 16, 24, 32, 40, 48, 56, 64dp)</strong>. Los medios pasos de <strong>4dp</strong> se permiten exclusivamente para alineación óptica de micro-iconos o relleno interior de badges.
    </p>

    <!-- Spacing Metrics Table -->
    <div class="table-responsive-wrapper">
      <table class="metrics-table">
        <thead>
          <tr>
            <th>Token de Espaciado</th>
            <th>Valor (dp)</th>
            <th>Equivalente Compose</th>
            <th>Uso Canónico en Pantallas Móviles</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>margin.screen</code></td>
            <td><span class="code-pill">16dp</span></td>
            <td><code>Modifier.padding(horizontal = 16.dp)</code></td>
            <td>Márgenes laterales del Scaffold móvil</td>
          </tr>
          <tr>
            <td><code>gutter.cards</code></td>
            <td><span class="code-pill">12dp</span></td>
            <td><code>Arrangement.spacedBy(12.dp)</code></td>
            <td>Separación vertical en LazyColumn entre tarjetas</td>
          </tr>
          <tr>
            <td><code>padding.card-inner</code></td>
            <td><span class="code-pill">16dp</span></td>
            <td><code>Modifier.padding(16.dp)</code></td>
            <td>Relleno interior de tarjetas de despacho</td>
          </tr>
          <tr>
            <td><code>spacing.touch-gap</code></td>
            <td><span class="code-pill">8dp</span></td>
            <td><code>Spacer(modifier = Modifier.width(8.dp))</code></td>
            <td>Separación mínima entre botones adyacentes</td>
          </tr>
          <tr>
            <td><code>padding.micro-badge</code></td>
            <td><span class="code-pill">4dp</span></td>
            <td><code>Modifier.padding(4.dp)</code></td>
            <td>Excepción permitida para chips compactos y badges</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 2: Visual Spacing Rhythm Board -->
  <section class="spec-card">
    <div class="card-header-row">
      <div class="card-badge-icon rhythm-badge"><i class="pi pi-sliders-h"></i></div>
      <div>
        <span class="card-eyebrow">RITMO VISUAL EN VIVO</span>
        <h3 class="card-title">Muestrario de Barras de Intervalo Espacial</h3>
      </div>
    </div>

    <div class="spacing-rhythm-list">
      <div class="rhythm-row">
        <code>space-4dp</code>
        <div class="rhythm-bar" style="width: 32px;">4dp</div>
        <small>Micro-espaciado: separación entre icono y texto en chip</small>
      </div>
      <div class="rhythm-row">
        <code>space-8dp</code>
        <div class="rhythm-bar" style="width: 64px;">8dp</div>
        <small>Espaciado base: separación entre elementos contiguos</small>
      </div>
      <div class="rhythm-row">
        <code>space-12dp</code>
        <div class="rhythm-bar" style="width: 96px;">12dp</div>
        <small>Gutter: separación entre tarjetas en listas verticales</small>
      </div>
      <div class="rhythm-row">
        <code>space-16dp</code>
        <div class="rhythm-bar" style="width: 128px;">16dp</div>
        <small>Margen de pantalla: padding estándar lateral del Scaffold</small>
      </div>
      <div class="rhythm-row">
        <code>space-24dp</code>
        <div class="rhythm-bar" style="width: 192px;">24dp</div>
        <small>Separador de sección: distancia entre bloques temáticos</small>
      </div>
      <div class="rhythm-row">
        <code>space-32dp</code>
        <div class="rhythm-bar" style="width: 256px;">32dp</div>
        <small>Espaciado mayor: distancia entre contenido y barra fija de acción</small>
      </div>
    </div>
  </section>

  <!-- Section 3: Kotlin Spacing Contract -->
  <section class="spec-card">
    <div class="card-header-row">
      <div class="card-badge-icon code-badge"><i class="pi pi-code"></i></div>
      <div>
        <span class="card-eyebrow">IMPLEMENTACIÓN NATIVA · JETPACK COMPOSE</span>
        <h3 class="card-title">Contrato de Espaciado Kotlin (:core:designsystem)</h3>
      </div>
    </div>

    <div class="code-preview-block">
      <pre is:raw><code>// core/designsystem/src/main/kotlin/com/nexa/core/designsystem/theme/Spacing.kt
package com.nexa.core.designsystem.theme

import androidx.compose.runtime.Immutable
import androidx.compose.runtime.staticCompositionLocalOf
import androidx.compose.ui.unit.Dp
import androidx.compose.ui.unit.dp

@Immutable
data class NexaSpacing(
    val extraSmall: Dp = 4.dp,
    val small: Dp = 8.dp,
    val medium: Dp = 12.dp,
    val normal: Dp = 16.dp,
    val large: Dp = 24.dp,
    val extraLarge: Dp = 32.dp,
    val touchMin: Dp = 48.dp,
    val touchIndustrial: Dp = 56.dp
)

val LocalNexaSpacing = staticCompositionLocalOf { NexaSpacing() }</code></pre>
    </div>
  </section>
</div>

<style>
  .cuadricula-8dp-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .spec-card {
    background: var(--nexa-surface-card, #ffffff);
    border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    border-radius: var(--nexa-radius-card, 16px);
    padding: 24px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-header-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-badge-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--nexa-color-primary-50, #eff6ff);
    color: var(--nexa-color-primary-600, #2a67d9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    flex-shrink: 0;

    &.rhythm-badge {
      background: #faf5ff;
      color: #9333ea;
    }
    &.code-badge {
      background: #f1f5f9;
      color: #0f172a;
    }
  }

  .card-eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--nexa-color-primary-700, #1d4ed8);
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .card-title {
    font-family: var(--nexa-font-family-display, sans-serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--nexa-color-text-primary, #0f172a);
    margin: 0;
  }

  .card-text {
    font-size: 13.5px;
    color: var(--nexa-color-text-secondary, #64748b);
    line-height: 1.6;
    margin: 0;
  }

  .table-responsive-wrapper {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--nexa-color-border-subtle, #e2e8f0);
    border-radius: 12px;
  }

  .metrics-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    text-align: left;

    th {
      background: var(--nexa-color-neutral-50, #f8fafc);
      padding: 10px 14px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--nexa-color-neutral-600, #475569);
      border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      color: var(--nexa-color-text-secondary, #64748b);
    }

    tr:last-child td {
      border-bottom: 0;
    }
  }

  .code-pill {
    display: inline-block;
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 11px;
    font-weight: 700;
    color: var(--nexa-color-primary-700, #1d4ed8);
    background: var(--nexa-color-primary-50, #eff6ff);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .spacing-rhythm-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }

  .rhythm-row {
    display: grid;
    grid-template-columns: 100px minmax(100px, 280px) 1fr;
    gap: 16px;
    align-items: center;

    code {
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 11.5px;
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-weight: 600;
    }

    small {
      color: #64748b;
      font-size: 12px;
    }
  }

  @media (max-width: 768px) {
    .rhythm-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  .rhythm-bar {
    height: 24px;
    background: var(--nexa-color-primary-100, #dbeafe);
    border: 1px solid var(--nexa-color-primary-400, #60a5fa);
    border-radius: 4px;
    color: var(--nexa-color-primary-800, #1e40af);
    font-family: var(--nexa-font-family-mono, monospace);
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .code-preview-block {
    background: #0f172a;
    border-radius: 12px;
    padding: 18px;
    overflow-x: auto;

    pre { margin: 0; }
    code {
      font-family: var(--nexa-font-family-mono, monospace);
      font-size: 12px;
      color: #e2e8f0;
      line-height: 1.6;
    }
  }
</style>
