---
// InsuranceSection: Bürocratik Forensic Safe Renting & Insurance Architectural Plate
---

<section class="insurance-section" id="insurance" aria-labelledby="insurance-heading">
  <div class="insurance-sculpted-canvas">
    
    <!-- Unified Silhouette SVG Background with Top-Right Architectural Notch & Concave Fillets -->
    <svg 
      class="insurance-silhouette-svg" 
      viewBox="0 0 1440 770" 
      preserveAspectRatio="none" 
      aria-hidden="true"
    >
      <defs>
        <clipPath id="insurance-clip">
          <path d="M 0 36 A 36 36 0 0 1 36 0 L 1092 0 A 36 36 0 0 1 1128 36 L 1128 44 A 36 36 0 0 0 1164 80 L 1404 80 A 36 36 0 0 1 1440 116 L 1440 734 A 36 36 0 0 1 1404 770 L 36 770 A 36 36 0 0 1 0 734 Z" />
        </clipPath>
        <radialGradient id="insurance-canvas-glow" cx="40%" cy="40%" r="60%">
          <stop offset="0%" stop-color="#0e3d6b" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#082846" stop-opacity="0" />
        </radialGradient>
      </defs>
      
      <!-- Nexa Deep Blue Base Silhouette -->
      <path 
        class="insurance-silhouette-path" 
        d="M 0 36 A 36 36 0 0 1 36 0 L 1092 0 A 36 36 0 0 1 1128 36 L 1128 44 A 36 36 0 0 0 1164 80 L 1404 80 A 36 36 0 0 1 1440 116 L 1440 734 A 36 36 0 0 1 1404 770 L 36 770 A 36 36 0 0 1 0 734 Z" 
        fill="#082846"
      />
      <!-- Ambient Radial Backlight Glow within the frame -->
      <rect x="0" y="0" width="1440" height="770" fill="url(#insurance-canvas-glow)" clip-path="url(#insurance-clip)" />
    </svg>

    <div class="insurance-content-wrap">
      <!-- Left Column: Editorial & Promise -->
      <div class="insurance-editorial-col">
        <div class="insurance-badge-wrap">
          <span class="insurance-badge">Custodia Escrow B2B</span>
        </div>

        <h2 id="insurance-heading" class="insurance-title">
          Custodia y seguridad<br />
          en cada despacho <span class="text-mint">con</span><br />
          <span class="text-mint">Nexa.</span>
        </h2>

        <p class="insurance-description">
          Exponer tu carga perecible o lotes mayoristas a pérdidas en tránsito es cosa <br class="body-br" />
          del pasado. Nuestra infraestructura de custodia escrow e IoT <br class="body-br" />
          protege cada envío frente a roturas térmicas <br class="body-br" />
          o mermas en ruta.
        </p>

        <!-- Bürocratik 100% Protection Policy Interactive Plate -->
        <div class="protection-toggle-plate" id="insurance-protection-toggle-card">
          <div class="protection-plate-header">
            <div class="protection-shield-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <polyline points="9 12 11 14 15 10"/>
              </svg>
              <span class="protection-plate-tag" id="protection-status-tag">100% COBERTURA ESCROW & FRÍO</span>
            </div>
            
            <button 
              type="button" 
              class="protection-switch-btn active" 
              id="insurance-toggle-btn" 
              role="switch" 
              aria-checked="true"
              aria-label="Alternar cobertura de custodia escrow 100%"
            >
              <span class="switch-indicator-label">100% ON</span>
              <span class="switch-track">
                <span class="switch-knob"></span>
              </span>
            </button>
          </div>

          <div class="protection-plate-content">
            <strong class="protection-headline" id="protection-headline-text">
              Garantía Total de Custodia de Carga
            </strong>
            <p class="protection-body" id="protection-body-text">
              Valor garantizado de reposición de hasta $50,000 USD por despacho en caso de quiebre de cadena de frío, alteración de precinto o merma en ruta. Los fondos en custodia escrow solo se liberan tras escaneo y conformidad digital en muelle.
            </p>
          </div>

          <div class="protection-metrics-row">
            <div class="prot-metric">
              <span class="prot-metric-val" id="metric-coverage">100%</span>
              <span class="prot-metric-lbl">Valor de Carga</span>
            </div>
            <div class="prot-metric">
              <span class="prot-metric-val" id="metric-deductible">$0</span>
              <span class="prot-metric-lbl">Deducible</span>
            </div>
            <div class="prot-metric">
              <span class="prot-metric-val" id="metric-sla">&lt; 2h</span>
              <span class="prot-metric-lbl">Liquidación</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Conversion & Pricing -->
      <div class="insurance-action-col">
        <a href="#book-demo" class="insurance-cta-btn" id="insurance-book-demo" aria-label="Solicitar demo de la plataforma Nexa">
          <svg class="calendar-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="4" ry="4"></rect>
            <line x1="8" y1="2" x2="8" y2="5"></line>
            <line x1="16" y1="2" x2="16" y2="5"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Solicitar Demo B2B</span>
        </a>

        <div class="insurance-pricing-callout">
          <div class="pricing-icon-bubble" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M 6 2 H 18 A 4 4 0 0 1 22 6 V 16 A 4 4 0 0 1 18 20 H 9 L 2 23 V 6 A 4 4 0 0 1 6 2 Z" fill="#ffffff"/>
              <circle cx="12" cy="7.5" r="1.3" fill="#082846"/>
              <rect x="10.8" y="10.5" width="2.4" height="5.5" rx="1.2" fill="#082846"/>
            </svg>
          </div>
          <div class="pricing-text-col">
            <p class="pricing-headline">
              Modelo de liquidación <br class="pricing-br" />
              transparente por volumen <br class="pricing-br" />
              y tipo de contenedor <br class="pricing-br" />
              refrigerado.
            </p>
            <p class="pricing-subtext">
              ¡Habla con nosotros para conectar tus almacenes!
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .insurance-section {
    position: relative;
    width: 100%;
    background-color: #ffffff;
    padding: 3.5rem 2.5rem 4.5rem 2.5rem;
    overflow-x: clip;
    display: flex;
    justify-content: center;
    box-sizing: border-box;
  }

  .insurance-sculpted-canvas {
    position: relative;
    width: 100%;
    max-width: 1560px;
    min-height: 770px;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  /* Unified Silhouette SVG Background */
  .insurance-silhouette-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    filter: drop-shadow(0 24px 48px rgba(0, 71, 55, 0.08));
  }

  .insurance-silhouette-path {
    transition: fill 0.3s ease;
  }

  .insurance-content-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4.5rem;
    align-items: center;
    padding: 7.5rem 7.5rem 8.5rem 8.5rem;
    box-sizing: border-box;
  }

  /* Left Editorial Column */
  .insurance-editorial-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .insurance-badge-wrap {
    margin-bottom: 2.25rem;
  }

  .insurance-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 1.45rem;
    border: 1.5px solid var(--primitive-color-mint-500);
    border-radius: 9999px;
    color: var(--primitive-color-mint-500);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .insurance-title {
    font-family: var(--primitive-font-display);
    font-size: clamp(2.5rem, 5.2vw, 5.1rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0 0 4.5rem 0;
  }

  .text-mint {
    color: var(--primitive-color-mint-500);
  }

  .insurance-description {
    font-family: var(--primitive-font-sans);
    font-size: clamp(1.15rem, 1.65vw, 1.4rem);
    line-height: 1.46;
    color: rgba(255, 255, 255, 0.95);
    max-width: 44ch;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .body-br {
    display: inline;
  }

  /* Right Column: CTA & Pricing Callout */
  .insurance-action-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 2.5rem;
  }

  .insurance-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 2.25rem;
    background-color: var(--primitive-color-mint-500);
    color: var(--primitive-color-forest-900);
    font-family: var(--primitive-font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, background-color 0.2s ease;
    margin-bottom: 4.25rem;
    white-space: nowrap;
  }

  .insurance-cta-btn:hover {
    background-color: #60a5fa;
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(56, 189, 248, 0.35);
  }

  .insurance-cta-btn:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 4px;
  }

  .calendar-icon {
    flex-shrink: 0;
  }

  .insurance-pricing-callout {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 320px;
  }

  .pricing-icon-bubble {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .pricing-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pricing-headline {
    font-family: var(--primitive-font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.32;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .pricing-br {
    display: inline;
  }

  .pricing-subtext {
    font-family: var(--primitive-font-sans);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.4;
    color: #ffffff;
    margin: 0;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1200px) {
    .insurance-content-wrap {
      padding: 6rem 4rem 6.5rem 5rem;
      gap: 3rem;
    }
    .body-br, .pricing-br {
      display: none;
    }
  }

  @media (max-width: 991px) {
    .insurance-section {
      padding: 2rem 1.5rem;
    }

    .insurance-silhouette-svg {
      display: none;
    }

    .insurance-sculpted-canvas {
      background-color: var(--primitive-color-forest-900);
      border-radius: 32px;
      min-height: auto;
    }

    .insurance-content-wrap {
      grid-template-columns: 1fr;
      padding: 4rem 2rem;
      gap: 3.5rem;
    }

    .insurance-action-col {
      padding-top: 0;
    }

    .insurance-cta-btn {
      margin-bottom: 2.5rem;
    }

    .body-br, .pricing-br {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .insurance-section {
      padding: 1.25rem 0.75rem;
    }

    .insurance-sculpted-canvas {
      border-radius: 24px;
    }

    .insurance-content-wrap {
      padding: 3rem 1.25rem;
      gap: 2.5rem;
    }

    .insurance-title {
      font-size: 2.45rem;
      margin-bottom: 2.25rem;
    }

    .insurance-description {
      font-size: 1.05rem;
    }

    .insurance-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* Protection Toggle Plate Styles */
  .protection-toggle-plate {
    margin-top: 2.25rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1.5px solid rgba(87, 240, 158, 0.35);
    border-radius: 20px;
    backdrop-filter: blur(8px);
    max-width: 520px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    transition: all 0.3s ease;
  }

  .protection-toggle-plate.inactive {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(0, 0, 0, 0.18);
    box-shadow: none;
  }

  .protection-plate-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .protection-shield-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .protection-plate-tag {
    font-family: var(--primitive-font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--primitive-color-mint-500, #38bdf8);
    transition: color 0.25s ease;
  }

  .protection-switch-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .switch-indicator-label {
    font-family: var(--primitive-font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--primitive-color-mint-500, #38bdf8);
    transition: color 0.25s ease;
  }

  .switch-track {
    width: 44px;
    height: 24px;
    background: var(--primitive-color-mint-500, #38bdf8);
    border-radius: 9999px;
    padding: 2px;
    display: flex;
    align-items: center;
    transition: background 0.25s ease;
  }

  .switch-knob {
    width: 20px;
    height: 20px;
    background: #082846;
    border-radius: 50%;
    transform: translateX(20px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease;
  }

  .protection-switch-btn:not(.active) .switch-indicator-label {
    color: rgba(255, 255, 255, 0.5);
  }

  .protection-switch-btn:not(.active) .switch-track {
    background: rgba(255, 255, 255, 0.25);
  }

  .protection-switch-btn:not(.active) .switch-knob {
    transform: translateX(0);
    background: #ffffff;
  }

  .protection-headline {
    display: block;
    font-family: var(--primitive-font-display, sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.45rem;
    letter-spacing: -0.015em;
  }

  .protection-body {
    font-family: var(--primitive-font-sans, sans-serif);
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1.15rem 0;
  }

  .protection-metrics-row {
    display: flex;
    gap: 1.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .prot-metric {
    display: flex;
    flex-direction: column;
  }

  .prot-metric-val {
    font-family: var(--primitive-font-mono, monospace);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--primitive-color-mint-500, #38bdf8);
    transition: color 0.25s ease;
  }

  .prot-metric-lbl {
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 2px;
    font-weight: 500;
  }
</style>

<script>
  function initInsuranceProtectionToggle() {
    const toggleBtn = document.getElementById('insurance-toggle-btn');
    const toggleCard = document.getElementById('insurance-protection-toggle-card');
    const statusTag = document.getElementById('protection-status-tag');
    const headlineText = document.getElementById('protection-headline-text');
    const bodyText = document.getElementById('protection-body-text');
    const metricCoverage = document.getElementById('metric-coverage');
    const metricDeductible = document.getElementById('metric-deductible');
    const metricSla = document.getElementById('metric-sla');
    const indicatorLabel = toggleBtn?.querySelector<HTMLElement>('.switch-indicator-label');

    let isProtected = true;

    toggleBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      isProtected = !isProtected;
      toggleBtn.classList.toggle('active', isProtected);
      toggleBtn.setAttribute('aria-checked', String(isProtected));
      toggleCard?.classList.toggle('inactive', !isProtected);

      if (indicatorLabel) {
        indicatorLabel.textContent = isProtected ? '100% ON' : '80% STD';
      }

      if (statusTag) {
        statusTag.textContent = isProtected ? '100% COBERTURA ESCROW & FRÍO' : 'CUSTODIA ESTÁNDAR 80%';
        statusTag.style.color = isProtected ? 'var(--primitive-color-mint-500, #38bdf8)' : '#fcd34d';
      }

      if (headlineText) {
        headlineText.textContent = isProtected 
          ? 'Garantía Total de Custodia de Carga' 
          : 'Nivel de Custodia Parcial';
      }

      if (bodyText) {
        bodyText.textContent = isProtected
          ? 'Valor garantizado de reposición de hasta $50,000 USD por despacho en caso de quiebre de cadena de frío, alteración de precinto o merma en ruta. Los fondos en custodia escrow solo se liberan tras escaneo y conformidad digital en muelle.'
          : 'Cobertura con deducible de $200 USD para carga seca o contingencias operativas menores, con período de verificación técnica de 24 horas.';
      }

      if (metricCoverage) {
        metricCoverage.textContent = isProtected ? '100%' : '80%';
        metricCoverage.style.color = isProtected ? 'var(--primitive-color-mint-500, #38bdf8)' : '#fcd34d';
      }

      if (metricDeductible) {
        metricDeductible.textContent = isProtected ? '$0' : '$200';
      }

      if (metricSla) {
        metricSla.textContent = isProtected ? '< 2h' : '24h';
      }
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initInsuranceProtectionToggle);
    } else {
      initInsuranceProtectionToggle();
    }
  }
</script>
