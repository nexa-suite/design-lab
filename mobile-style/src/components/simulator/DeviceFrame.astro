---
/**
 * DeviceFrame.astro — Canonical Multi-Device Android Studio & Viewport Ergonomics Inspector
 * Nexa Suite · Material 3 Design System & Ergonomics Validation
 *
 * Features:
 *  - 100% Android Form Factors:
 *    * Samsung Galaxy S24 / Pixel 8 (390×844dp)
 *    * Samsung Galaxy S24 Ultra (412×915dp)
 *    * Zebra TC58 Rugged Enterprise (412×820dp)
 *    * Samsung Galaxy Tab Active 8" (600×960dp)
 *    * Samsung Galaxy Tab S9 11" (800×1200dp)
 *  - Persistent M3 TopAppBar & ALWAYS ACTIVE M3 BottomNav on all phone screens
 *  - Adaptive NavigationRail on tablet screens
 *  - Live Interactive Specimens (Fixed Kanban with Tabs, Catalog with Steppers, POD Forms, Navbar)
 *  - Canonical Static Screens (Operaciones Gold Standard, CameraX, Buyer B2B, Bottom Sheet)
 *  - Pure Minimalist Nexa Palette: 100% White Backgrounds (#ffffff), zero dark blue cards!
 */
import OperationsScreenSpec from './OperationsScreenSpec.astro';
import BuyerScreenSpec from './BuyerScreenSpec.astro';
import BottomSheetSpec from './BottomSheetSpec.astro';
import ScannerScreenSpec from './ScannerScreenSpec.astro';
import InteractiveMobileNavbar from './InteractiveMobileNavbar.astro';
import InteractiveWholesaleCatalog from './InteractiveWholesaleCatalog.astro';
import InteractiveMobileForms from './InteractiveMobileForms.astro';
import InteractiveDispatchMovement from './InteractiveDispatchMovement.astro';
---

<div class="screen-spec-container" id="simulador-interactivo">
  
  <!-- Section Heading Block -->
  <header class="section-heading-block">
    <div class="section-heading">
      <span class="section-index">01</span>
      <div>
        <p class="section-kicker">SIMULADOR MULTI-DISPOSITIVO ANDROID · JETPACK COMPOSE M3</p>
        <h2>Simulador Móvil Interactivo en Vivo & Ergonomía de Densidad</h2>
        <p class="section-intro">
          Validación de interfaces nativas en <strong>Android Jetpack Compose</strong> sobre todas las medidas estándar de Android (Samsung S24, S24 Ultra, Zebra industrial y Tablets de 8" y 11"). 
          <strong>Fondo blanco minimalista, TopAppBar M3 persistente y Navbar activa en todas las pantallas.</strong>
        </p>
      </div>
    </div>

    <!-- Quick Meta Chips -->
    <div class="heading-meta-chips">
      <span class="cuadro-tag primary"><i class="pi pi-android" aria-hidden="true"></i> Android 14 (API 34)</span>
      <span class="cuadro-tag"><i class="pi pi-mobile" aria-hidden="true"></i> 390dp / 412dp / 600dp / 800dp</span>
      <span class="cuadro-tag success"><i class="pi pi-hand" aria-hidden="true"></i> Touch Target 48dp / 56dp Guantes</span>
      <span class="cuadro-tag kotlin"><i class="pi pi-bars" aria-hidden="true"></i> Navbar M3 Siempre Activa</span>
    </div>
  </header>

  <!-- Interactive Controls Bar -->
  <div class="stage-controls-card">
    <!-- Cluster 1: Android Form Factors & Tablets -->
    <div class="control-cluster">
      <span class="control-label">DENSIDAD & DISPOSITIVO ANDROID:</span>
      <div class="button-toggle-group">
        <button type="button" class="btn-ctrl device-btn active" data-width="390" data-height="780" data-device="s24">
          <i class="pi pi-mobile"></i> Galaxy S24 (390dp)
        </button>
        <button type="button" class="btn-ctrl device-btn" data-width="412" data-height="820" data-device="s24ultra">
          <i class="pi pi-mobile"></i> S24 Ultra (412dp)
        </button>
        <button type="button" class="btn-ctrl device-btn" data-width="412" data-height="800" data-device="zebra">
          <i class="pi pi-shield"></i> Zebra TC58 (412dp)
        </button>
        <button type="button" class="btn-ctrl device-btn tablet" data-width="600" data-height="740" data-device="tab-active">
          <i class="pi pi-tablet"></i> Tab Active 8" (600dp)
        </button>
        <button type="button" class="btn-ctrl device-btn tablet" data-width="800" data-height="760" data-device="tab-s9">
          <i class="pi pi-desktop"></i> Tab S9 11" (800dp)
        </button>
      </div>
    </div>

    <!-- Cluster 2: Live Interactive Modules -->
    <div class="control-cluster">
      <span class="control-label">MÓDULOS INTERACTIVOS EN VIVO:</span>
      <div class="button-toggle-group">
        <button type="button" class="btn-ctrl screen-btn live-feature" data-screen="dispatch-live" data-title="Tablero de Despacho & Movimiento">
          <i class="pi pi-send"></i> Despacho Kanban (Live)
        </button>
        <button type="button" class="btn-ctrl screen-btn live-feature" data-screen="catalog-live" data-title="Catálogo Mayorista B2B">
          <i class="pi pi-shopping-bag"></i> Catálogo B2B (Live)
        </button>
        <button type="button" class="btn-ctrl screen-btn live-feature" data-screen="forms-live" data-title="Inspección ISO 3691 & Firma POD">
          <i class="pi pi-pencil"></i> Formularios & POD (Live)
        </button>
        <button type="button" class="btn-ctrl screen-btn live-feature" data-screen="navbar-live" data-title="Navegación & Sucursales M3">
          <i class="pi pi-bars"></i> Navbar & Sucursales (Live)
        </button>
      </div>
    </div>

    <!-- Cluster 3: Canonical Screens -->
    <div class="control-cluster">
      <span class="control-label">PANTALLAS CANÓNICAS:</span>
      <div class="button-toggle-group">
        <button type="button" class="btn-ctrl screen-btn active" data-screen="operations" data-title="Operaciones Nexa · En Ruta">
          <i class="pi pi-truck"></i> Operaciones (Image 4)
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="scanner" data-title="Escáner Óptico CameraX">
          <i class="pi pi-qrcode"></i> Escáner CameraX
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="buyer" data-title="Portal de Comprador B2B">
          <i class="pi pi-shopping-cart"></i> Comprador B2B
        </button>
        <button type="button" class="btn-ctrl screen-btn" data-screen="sheet" data-title="Detalle de Entrega M3">
          <i class="pi pi-sliders-h"></i> Bottom Sheet M3
        </button>
      </div>
    </div>
  </div>

  <!-- Pure Software Viewport Stage (Clean Minimalist Nexa Frame) -->
  <div class="architectural-stage-wrapper">
    <div class="viewport-card-frame" id="viewport-frame" style="width: 390px;">
      
      <!-- Android 14 System Bar -->
      <div class="frame-system-bar">
        <span class="sys-time">14:35</span>
        <div class="sys-icons">
          <span class="sys-net">5G LTE</span>
          <i class="pi pi-wifi"></i>
          <i class="pi pi-bolt"></i>
          <span class="sys-batt">94%</span>
        </div>
      </div>

      <!-- M3 TopAppBar (Always Active on Phone Screens) -->
      <header class="frame-m3-top-bar" id="frame-top-bar">
        <div class="top-bar-left">
          <button type="button" class="frame-icon-btn" aria-label="Menú principal">
            <i class="pi pi-bars"></i>
          </button>
          <h3 class="frame-top-title" id="frame-top-title">Operaciones Nexa · En Ruta</h3>
        </div>
        <div class="top-bar-right">
          <button type="button" class="frame-icon-btn notif-btn" aria-label="Notificaciones">
            <i class="pi pi-bell"></i>
            <span class="notif-dot"></span>
          </button>
          <div class="frame-user-avatar">
            <i class="pi pi-user"></i>
          </div>
        </div>
      </header>

      <!-- Scrollable Screen Content Host Container -->
      <div class="screen-viewport-host" id="screen-viewport-host" style="height: 680px;">
        
        <!-- Screen 1 (DEFAULT): Canonical Operaciones (Exact Image 4 Gold Standard!) -->
        <div class="screen-view active" id="view-operations">
          <OperationsScreenSpec />
        </div>

        <!-- Screen 2: Fixed Live Kanban Board (with tabs on phone, 4 columns on tablet) -->
        <div class="screen-view" id="view-dispatch-live">
          <InteractiveDispatchMovement />
        </div>

        <!-- Screen 3: Wholesale B2B Catalog -->
        <div class="screen-view" id="view-catalog-live">
          <InteractiveWholesaleCatalog />
        </div>

        <!-- Screen 4: Forms & POD -->
        <div class="screen-view" id="view-forms-live">
          <InteractiveMobileForms />
        </div>

        <!-- Screen 5: Navbar & Branches -->
        <div class="screen-view" id="view-navbar-live">
          <InteractiveMobileNavbar />
        </div>

        <!-- Canonical Screens -->
        <div class="screen-view" id="view-scanner">
          <ScannerScreenSpec />
        </div>
        <div class="screen-view" id="view-buyer">
          <BuyerScreenSpec />
        </div>
        <div class="screen-view" id="view-sheet">
          <BottomSheetSpec />
        </div>
      </div>

      <!-- M3 Bottom Navigation Bar (ALWAYS ACTIVE ON ALL PHONE SPECIMENS) -->
      <nav class="frame-m3-bottom-nav" id="frame-bottom-nav" aria-label="Navegación principal de la aplicación">
        <button type="button" class="nav-dest active" data-dest="rutas">
          <div class="dest-icon-wrap">
            <i class="pi pi-map-marker"></i>
          </div>
          <span class="dest-label">Rutas</span>
        </button>
        <button type="button" class="nav-dest" data-dest="despacho">
          <div class="dest-icon-wrap">
            <i class="pi pi-send"></i>
          </div>
          <span class="dest-label">Despacho</span>
        </button>
        <button type="button" class="nav-dest" data-dest="picking">
          <div class="dest-icon-wrap">
            <i class="pi pi-box"></i>
          </div>
          <span class="dest-label">Picking</span>
        </button>
        <button type="button" class="nav-dest" data-dest="checklist">
          <div class="dest-icon-wrap">
            <i class="pi pi-check-square"></i>
          </div>
          <span class="dest-label">Checklist</span>
        </button>
      </nav>

      <!-- Viewport Device Metric Status Footer -->
      <div class="viewport-footer-bar">
        <span class="vp-dot"></span>
        <span id="vp-info-label">Samsung Galaxy S24 · 390 &times; 844dp · Android 14 M3</span>
        <span class="vp-chip">WCAG AAA</span>
        <span class="vp-chip">Touch 48/56dp</span>
      </div>

    </div>
  </div>

  <!-- Master Documentation Cuadros Container -->
  <div class="cuadro-container">

    <!-- Cuadro 1: Viewport Densities & Ergonomic Budget -->
    <section class="cuadro-card">
      <header class="cuadro-header">
        <div class="cuadro-header-left">
          <span class="cuadro-num-badge">C1</span>
          <div>
            <p class="cuadro-kicker">MATRIZ DE DENSIDADES & PRESUPUESTO ERGONÓMICO</p>
            <h3 class="cuadro-title">Contratos de Densidad de Pantalla y Requisitos de Objetivos Táctiles</h3>
            <p class="cuadro-subtitle">
              Reglas de diseño para smartphones, phablets, terminales industriales y tablets Android.
            </p>
          </div>
        </div>
        <div class="cuadro-tags">
          <span class="cuadro-tag primary"><i class="pi pi-check"></i> WCAG 2.2 AAA</span>
          <span class="cuadro-tag success"><i class="pi pi-hand"></i> 56dp Cold-Chain</span>
        </div>
      </header>

      <div class="contract-table-wrapper">
        <table class="contract-table">
          <thead>
            <tr>
              <th>Perfil de Dispositivo</th>
              <th>Ancho Viewport</th>
              <th>Touch Target Mínimo</th>
              <th>Margen Pantalla</th>
              <th>Uso en Nexa Suite</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Samsung Galaxy S24 / Pixel 8</strong></td>
              <td><span class="mono-chip">390dp</span></td>
              <td><span class="mono-type">48dp &times; 48dp</span></td>
              <td><span class="rule-chip">16dp horizontal</span></td>
              <td>Conductor en ruta, choferes de reparto rápido</td>
            </tr>
            <tr>
              <td><strong>Samsung Galaxy S24 Ultra</strong></td>
              <td><span class="mono-chip">412dp</span></td>
              <td><span class="mono-type">48dp estándar</span></td>
              <td><span class="rule-chip">16dp horizontal</span></td>
              <td>Comprador B2B mayorista, supervisores de flota</td>
            </tr>
            <tr>
              <td><strong>Zebra TC58 / Honeywell Rugged</strong></td>
              <td><span class="mono-chip">412dp (Rugged)</span></td>
              <td><span class="mono-type">56dp obligatorio</span></td>
              <td><span class="rule-chip">20dp horizontal</span></td>
              <td>Operadores de frío (-20°C a 4°C) con guantes térmicos</td>
            </tr>
            <tr>
              <td><strong>Samsung Galaxy Tab Active 8"</strong></td>
              <td><span class="mono-chip">600dp (Compact Tablet)</span></td>
              <td><span class="mono-type">56dp industrial</span></td>
              <td><span class="rule-chip">24dp horizontal</span></td>
              <td>Montacarguistas y operadores de muelle frigorífico</td>
            </tr>
            <tr>
              <td><strong>Samsung Galaxy Tab S9 11"</strong></td>
              <td><span class="mono-chip">800dp (Expanded Tablet)</span></td>
              <td><span class="mono-type">48dp – 56dp</span></td>
              <td><span class="rule-chip">32dp TwoPane</span></td>
              <td>Consola de control de patio y telemetría de frío</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

  </div>
</div>

<script>
  // Viewport Resizing & Screen Switching Interactive Logic
  document.addEventListener('DOMContentLoaded', () => {
    const frame = document.getElementById('viewport-frame');
    const host = document.getElementById('screen-viewport-host');
    const infoLabel = document.getElementById('vp-info-label');
    const topTitle = document.getElementById('frame-top-title');
    const deviceButtons = document.querySelectorAll('.device-btn');
    const screenButtons = document.querySelectorAll('.screen-btn');
    const screenViews = document.querySelectorAll('.screen-view');
    const navDests = document.querySelectorAll('.nav-dest');

    // Switch Viewport Width & Device
    deviceButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        deviceButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const width = parseInt(btn.getAttribute('data-width') || '390', 10);
        const height = parseInt(btn.getAttribute('data-height') || '780', 10);
        const deviceType = btn.getAttribute('data-device') || 's24';

        if (frame) {
          frame.style.width = `${width}px`;
          
          if (width >= 600) {
            frame.classList.add('mode-tablet');
            if (host) host.style.height = `${height - 120}px`;
          } else {
            frame.classList.remove('mode-tablet');
            if (host) host.style.height = '680px';
          }
        }

        if (infoLabel) {
          if (deviceType === 's24') {
            infoLabel.textContent = `Samsung Galaxy S24 · 390 × 844dp · Android 14 M3`;
          } else if (deviceType === 's24ultra') {
            infoLabel.textContent = `Samsung Galaxy S24 Ultra · 412 × 915dp · Android 14 M3`;
          } else if (deviceType === 'zebra') {
            infoLabel.textContent = `Zebra TC58 Enterprise · 412 × 820dp · Rugged SE55`;
          } else if (deviceType === 'tab-active') {
            infoLabel.textContent = `Samsung Galaxy Tab Active 8" · 600 × 960dp Tablet`;
          } else if (deviceType === 'tab-s9') {
            infoLabel.textContent = `Samsung Galaxy Tab S9 11" · 800 × 1200dp Tablet TwoPane`;
          }
        }
      });
    });

    // Switch Screen Specimen
    screenButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        screenButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const targetScreen = btn.getAttribute('data-screen');
        const titleText = btn.getAttribute('data-title') || 'Operaciones Nexa';

        if (topTitle) {
          topTitle.textContent = titleText;
        }

        screenViews.forEach(view => {
          view.classList.remove('active');
        });

        const activeView = document.getElementById(`view-${targetScreen}`);
        if (activeView) {
          activeView.classList.add('active');
        }

        // Sync bottom nav destinations
        navDests.forEach(dest => dest.classList.remove('active'));
        if (targetScreen === 'operations') {
          document.querySelector('[data-dest="rutas"]')?.classList.add('active');
        } else if (targetScreen === 'dispatch-live') {
          document.querySelector('[data-dest="despacho"]')?.classList.add('active');
        } else if (targetScreen === 'catalog-live') {
          document.querySelector('[data-dest="picking"]')?.classList.add('active');
        } else if (targetScreen === 'forms-live') {
          document.querySelector('[data-dest="checklist"]')?.classList.add('active');
        }
      });
    });

    // Interactive Bottom Nav Destination Switching
    navDests.forEach(dest => {
      dest.addEventListener('click', () => {
        navDests.forEach(d => d.classList.remove('active'));
        dest.classList.add('active');

        const destId = dest.getAttribute('data-dest');
        if (destId === 'rutas') {
          document.querySelector('[data-screen="operations"]')?.dispatchEvent(new Event('click'));
        } else if (destId === 'despacho') {
          document.querySelector('[data-screen="dispatch-live"]')?.dispatchEvent(new Event('click'));
        } else if (destId === 'picking') {
          document.querySelector('[data-screen="catalog-live"]')?.dispatchEvent(new Event('click'));
        } else if (destId === 'checklist') {
          document.querySelector('[data-screen="forms-live"]')?.dispatchEvent(new Event('click'));
        }
      });
    });
  });
</script>

<style>
  .screen-spec-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section-heading-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
  }

  .section-heading {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .section-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 13px;
    font-weight: 800;
    font-family: var(--nexa-font-family-mono, monospace);
  }

  .section-kicker {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--nexa-color-primary-700, #1d4ed8);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .section-heading h2 {
    font-family: var(--nexa-font-family-display, sans-serif);
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .section-intro {
    font-size: 13.5px;
    color: #64748b;
    max-width: 820px;
    margin-top: 6px;
    line-height: 1.5;
  }

  .heading-meta-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cuadro-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 600;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
  }

  .cuadro-tag.primary { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
  .cuadro-tag.success { background: #f0fdf4; color: #15803d; border-color: #bbf7d0; }
  .cuadro-tag.kotlin { background: #fdf4ff; color: #a21caf; border-color: #f5d0fe; }

  /* Stage Controls Bar */
  .stage-controls-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px 20px;
    background: #ffffff;
    border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    border-radius: var(--nexa-radius-card, 16px);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .control-cluster {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .control-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #64748b;
    text-transform: uppercase;
    min-width: 170px;
  }

  .button-toggle-group {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .btn-ctrl {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-ctrl:hover {
    background: #f8fafc;
    color: #0f172a;
    border-color: #94a3b8;
  }

  .btn-ctrl.active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.15);
  }

  .btn-ctrl.tablet {
    border-color: #93c5fd;
  }

  .btn-ctrl.live-feature {
    border-color: #bfdbfe;
    background: #eff6ff;
    color: #1d4ed8;
  }

  .btn-ctrl.live-feature.active {
    background: #2563eb;
    color: #ffffff;
    border-color: #2563eb;
  }

  /* Architectural Stage Wrapper */
  .architectural-stage-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 24px 16px 36px;
    background: #f8fafc;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    overflow-x: auto;
  }

  /* Viewport Card Frame (Physical Android Bezels) */
  .viewport-card-frame {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 36px;
    box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.18), 0 0 0 1px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    max-width: 100%;
  }

  .viewport-card-frame.mode-tablet {
    border-radius: 24px;
  }

  /* 1. Android 14 System Bar */
  .frame-system-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 18px 4px;
    background: #ffffff;
    font-size: 11px;
    font-weight: 700;
    color: #1e293b;
    border-bottom: 1px solid transparent;
  }

  .sys-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
  }

  .sys-net {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #3b82f6;
  }

  /* 2. M3 TopAppBar (Always Active) */
  .frame-m3-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    min-height: 48px;
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .frame-icon-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 15px;
    transition: background 0.15s ease;
  }

