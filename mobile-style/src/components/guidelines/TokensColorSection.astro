  <!-- Section 4: Contrato de Código Kotlin 2.4 en Producción -->
  <section class="cuadro-card">
    <div class="cuadro-header">
      <div class="cuadro-header-left">
        <span class="cuadro-num-badge">04</span>
        <div>
          <p class="cuadro-kicker">CÓDIGO DE PRODUCCIÓN · KOTLIN 2.4 JETPACK COMPOSE</p>
          <h3 class="cuadro-title">Color.kt & Theme.kt Canónico (:core:designsystem)</h3>
          <p class="cuadro-subtitle">
            Definición inmutable de la paleta con soporte para lightColorScheme y darkColorScheme respetando el contrato de arquitectura ADR-0018.
          </p>
        </div>
      </div>
      <div class="cuadro-tags">
        <span class="cuadro-tag kotlin"><i class="pi pi-code"></i> Color.kt</span>
        <span class="cuadro-tag primary"><i class="pi pi-palette"></i> NexaTheme</span>
      </div>
    </div>

    <div class="code-container-block">
      <div class="code-header-bar">
        <div class="code-header-title">
          <i class="pi pi-file"></i>
          <span>core/designsystem/src/main/kotlin/com/nexa/core/designsystem/theme/Color.kt</span>
        </div>
        <span class="code-lang-pill">Kotlin 2.4</span>
      </div>
      <pre class="code-pre-box" is:raw><code><span class="comm">// Canonical Material 3 Color Scheme for Nexa Suite Operations Android</span>
<span class="kw">package</span> com.nexa.core.designsystem.theme

<span class="kw">import</span> androidx.compose.material3.ColorScheme
<span class="kw">import</span> androidx.compose.material3.darkColorScheme
<span class="kw">import</span> androidx.compose.material3.lightColorScheme
<span class="kw">import</span> androidx.compose.ui.graphics.Color

<span class="comm">// 1. Tonal Core Primitives</span>
<span class="kw">val</span> NexaPrimary = <span class="type">Color</span>(<span class="num">0xFF2A67D9</span>)
<span class="kw">val</span> NexaOnPrimary = <span class="type">Color</span>(<span class="num">0xFFFFFFFF</span>)
<span class="kw">val</span> NexaPrimaryContainer = <span class="type">Color</span>(<span class="num">0xFFDBEAFE</span>)
<span class="kw">val</span> NexaOnPrimaryContainer = <span class="type">Color</span>(<span class="num">0xFF1E40AF</span>)

<span class="kw">val</span> NexaSecondary = <span class="type">Color</span>(<span class="num">0xFF082846</span>)       <span class="comm">// Brand Navy</span>
<span class="kw">val</span> NexaOnSecondary = <span class="type">Color</span>(<span class="num">0xFFFFFFFF</span>)
<span class="kw">val</span> NexaSecondaryContainer = <span class="type">Color</span>(<span class="num">0xFFE2E8F0</span>)
<span class="kw">val</span> NexaOnSecondaryContainer = <span class="type">Color</span>(<span class="num">0xFF0F172A</span>)

<span class="kw">val</span> NexaTertiary = <span class="type">Color</span>(<span class="num">0xFF38C8FF</span>)        <span class="comm">// Brand Celeste (Laser Reticle)</span>
<span class="kw">val</span> NexaOnTertiary = <span class="type">Color</span>(<span class="num">0xFF082846</span>)
<span class="kw">val</span> NexaTertiaryContainer = <span class="type">Color</span>(<span class="num">0xFFCFFAFE</span>)
<span class="kw">val</span> NexaOnTertiaryContainer = <span class="type">Color</span>(<span class="num">0xFF0E7490</span>)

<span class="comm">// 2. Error & Cold Chain Telemetry</span>
<span class="kw">val</span> NexaError = <span class="type">Color</span>(<span class="num">0xFFB91C1C</span>)
<span class="kw">val</span> NexaOnError = <span class="type">Color</span>(<span class="num">0xFFFFFFFF</span>)
<span class="kw">val</span> NexaErrorContainer = <span class="type">Color</span>(<span class="num">0xFFFEE2E2</span>)
<span class="kw">val</span> NexaOnErrorContainer = <span class="type">Color</span>(<span class="num">0xFF991B1B</span>)
<span class="kw">val</span> NexaColdChainOk = <span class="type">Color</span>(<span class="num">0xFF15803D</span>)     <span class="comm">// Calibrated 2.0°C – 6.0°C</span>
<span class="kw">val</span> NexaColdChainWarn = <span class="type">Color</span>(<span class="num">0xFFB45309</span>)

<span class="comm">// 3. Surfaces & Containers (Light)</span>
<span class="kw">val</span> NexaSurface = <span class="type">Color</span>(<span class="num">0xFFF6FAFF</span>)
<span class="kw">val</span> NexaOnSurface = <span class="type">Color</span>(<span class="num">0xFF0F172A</span>)
<span class="kw">val</span> NexaSurfaceVariant = <span class="type">Color</span>(<span class="num">0xFFF1F5F9</span>)
<span class="kw">val</span> NexaOnSurfaceVariant = <span class="type">Color</span>(<span class="num">0xFF475569</span>)
