---
// Scrollytelling Component — Reconstructed to 100% forensic fidelity
// Bases: Image 3 (media_1790488366954.png) & Awwwards SOTD Forensic Sequence
// Features: Dual [Bookings]/[Inventory] switcher, 26px thick vascular conduits,
// 4-step interactive smartphone checkout flow (Date Selection -> Face ID & Escrow -> Summary & Pay -> Payment Done with Confetti),
// and smooth, glitch-free scroll choreography.
---

<section class="scrolly-section" id="scrollytelling" aria-label="Flecto Link and Customer Scrollytelling Experience">
  <!-- Outer Sticky Pin Frame -->
  <div class="scrolly-sticky-frame">
    
    <!-- Top Category Tabs (State 1: Bookings / Inventory) -->
    <div class="scrolly-nav-tabs" role="tablist" aria-label="Configuration Categories">
      <div class="tabs-buttons-row">
        <button type="button" role="tab" class="scrolly-tab-btn active" id="tab-bookings" aria-selected="true">
          <span>Despachos B2B</span>
        </button>
        <button type="button" role="tab" class="scrolly-tab-btn" id="tab-inventory" aria-selected="false">
          <span>Flota & Muelle</span>
        </button>
      </div>
      <div class="tabs-underline-track" aria-hidden="true">
        <div class="track-active-bar"></div>
      </div>
    </div>

    <!-- The Scrolly Stage Area -->
    <div class="scrolly-stage-area">

      <!-- ====================================================================
           BACKDROP PLATE (Dark Technical Container matching Nexa palette)
           ==================================================================== -->
      <div class="stage-backdrop-state1" aria-hidden="true"></div>

      <!-- ====================================================================
           SATELLITE TOGGLE CARDS (STATE 1: Operator / Merchant View)
           Connected via THICK 26px CONDUITS
           ==================================================================== -->
      <!-- 1. Top-Left Satellite: Despacho en Bahía -->
      <div class="satellite-card card-top-left bookings-satellite" id="satellite-online-payments">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="24" height="20" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <h3 class="satellite-title">Despacho en Bahía</h3>
          <p class="satellite-desc">Programa ventanas de carga en muelle frigorífico</p>
          <div class="satellite-switch-pill active" role="switch" aria-checked="true" aria-label="Despacho en Bahía toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 2. Bottom-Left Satellite: Telemetría Sensirion -->
      <div class="satellite-card card-bottom-left bookings-satellite" id="satellite-pay-store">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
              <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
            </svg>
          </div>
          <h3 class="satellite-title">Telemetría Sensirion</h3>
          <p class="satellite-desc">Monitoreo continuo de frío a -18.2°C con alertas IoT</p>
          <div class="satellite-switch-pill active" role="switch" aria-checked="true" aria-label="Telemetría toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 3. Right Satellite: Custodia Escrow 100% -->
      <div class="satellite-card card-right bookings-satellite" id="satellite-id-verify">
        <div class="satellite-stem stem-right" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <h3 class="satellite-title">Custodia Escrow 100%</h3>
          <p class="satellite-desc">Liberación automática tras verificación GS1-128</p>
          <div class="satellite-switch-pill active" role="switch" aria-checked="true" aria-label="Custodia Escrow toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- INVENTORY SATELLITE CARDS (Active when Flota & Muelle Tab is clicked) -->
      <!-- 1. Top-Left: Precinto Digital IoT -->
      <div class="satellite-card card-top-left inventory-satellite" id="satellite-add-services" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h3 class="satellite-title">Precinto Digital IoT</h3>
          <p class="satellite-desc">Cierre criptográfico verificado con GPS en ruta</p>
          <div class="satellite-switch-pill active" role="switch" aria-checked="true" aria-label="Precinto Digital toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 2. Bottom-Left: Garantía Cadena de Frío -->
      <div class="satellite-card card-bottom-left inventory-satellite" id="satellite-add-deposits" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-left" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="satellite-title">Garantía de Frío</h3>
          <p class="satellite-desc">Cobertura ante fluctuaciones térmicas mayores a ±2°C</p>
          <div class="satellite-switch-pill active" role="switch" aria-checked="true" aria-label="Garantía de Frío toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 3. Top-Right: Trazabilidad Lote GS1 -->
      <div class="satellite-card card-right inventory-satellite" id="satellite-add-items" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-right" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
              <path d="M4 7V4h3M17 4h3v3M4 17v3h3M20 17v3h-3"/>
              <rect x="8" y="8" width="8" height="8" rx="1"/>
            </svg>
          </div>
          <h3 class="satellite-title">Trazabilidad GS1-128</h3>
          <p class="satellite-desc">Seguimiento de código de barras y lote de origen</p>
          <div class="satellite-switch-pill active" role="switch" aria-checked="true" aria-label="Trazabilidad toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- 4. Bottom-Right: Descuento por Volumen B2B -->
      <div class="satellite-card card-bottom-right inventory-satellite" id="satellite-discounts" style="display: none; opacity: 0;">
        <div class="satellite-stem stem-right" aria-hidden="true"></div>
        <div class="satellite-inner">
          <div class="satellite-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
              <circle cx="7.5" cy="7.5" r="2.5"/>
              <circle cx="16.5" cy="16.5" r="2.5"/>
              <line x1="19" y1="5" x2="5" y2="19"/>
            </svg>
          </div>
          <h3 class="satellite-title">Tarifa por Volumen</h3>
          <p class="satellite-desc">Ajuste de flete dinámico por toneladas despachadas</p>
          <div class="satellite-switch-pill active" role="switch" aria-checked="true" aria-label="Tarifa por Volumen toggle">
            <span class="switch-ball"></span>
          </div>
        </div>
      </div>

      <!-- ====================================================================
           CUSTOMER JOURNEY ELEMENTS (STATE 2: Customer Flow)
           ==================================================================== -->
      <!-- Top Vertical Connector Line & John Cooper Avatar -->
      <div class="customer-avatar-stem-block" aria-hidden="true">
        <div class="top-vertical-stem"></div>
        <div class="customer-avatar-circle">
          <img src="/assets/synthetic/avatar-customer.svg" alt="John Cooper" class="avatar-svg-portrait" />
        </div>
        <div class="customer-badge-pill">John Cooper</div>
      </div>

      <!-- Left Wing: Monumental Headline & Badge -->
      <div class="customer-left-wing">
        <div class="customer-eyebrow-pill">For your Customer</div>
        <h2 class="customer-monumental-heading">
          And it's just<br />
          as simple for<br />
          your<br />
          customers
        </h2>
      </div>

      <!-- Right Wing: Vertical Dashed Timeline (Clickable steps) -->
      <div class="customer-right-wing" aria-label="Customer Journey Progress">
        <div class="timeline-vertical-dashed" aria-hidden="true"></div>
        <ul class="timeline-steps-list">
          <li class="timeline-item active" data-step="1" role="button" tabindex="0" aria-label="Go to step 1: Date selection & order">
            <span class="item-dot"></span>
            <span class="item-text">Date selection & order</span>
          </li>
          <li class="timeline-item" data-step="2" role="button" tabindex="0" aria-label="Go to step 2: Run face verification">
            <span class="item-dot"></span>
            <span class="item-text">Run face verification</span>
          </li>
          <li class="timeline-item" data-step="3" role="button" tabindex="0" aria-label="Go to step 3: Summary & pay">
            <span class="item-dot"></span>
            <span class="item-text">Summary & pay</span>
          </li>
          <li class="timeline-item" data-step="4" role="button" tabindex="0" aria-label="Go to step 4: Success">
            <span class="item-dot"></span>
            <span class="item-text">Success! 🍾</span>
          </li>
        </ul>
      </div>

      <!-- ====================================================================
           THE DOMINANT CENTERPIECE: ELONGATED SMARTPHONE MOCKUP
           ==================================================================== -->
      <div class="scrolly-phone-container" id="interactive-phone">
        <div class="phone-chassis">
          
          <!-- Top Speaker / Camera Slot -->
          <div class="phone-speaker-slot" aria-hidden="true">
            <div class="chassis-camera"></div>
            <div class="chassis-speaker"></div>
          </div>

          <!-- Phone Screen Frame with Absolute Stacking Context -->
          <div class="phone-screen" role="region" aria-live="polite" aria-label="Customer Rental Mobile Flow">
            
            <!-- Global Status Bar -->
            <div class="screen-status-bar" aria-hidden="true">
              <span class="status-time">9:41</span>
              <div class="status-indicators">
                <svg width="13" height="9" viewBox="0 0 14 10" fill="currentColor">
                  <path d="M1 7h2v3H1zM4 5h2v5H4zM7 3h2v7H7zM10 1h2v9h-2z"/>
                </svg>
                <svg width="12" height="9" viewBox="0 0 16 12" fill="currentColor">
                  <path d="M8 2.5a9.8 9.8 0 0 1 6.5 2.5l-6.5 7-6.5-7A9.8 9.8 0 0 1 8 2.5z"/>
                </svg>
                <div class="status-battery">
                  <div class="battery-fill"></div>
                </div>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 1: Date Selection & Order Summary (Step 1)
                 ------------------------------------------------------------- -->
            <div class="phone-state-view active" id="phone-state-1" data-state="1">
              <div class="summary-top-nav">
                <button type="button" class="phone-circle-btn" aria-label="Back">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="summary-top-title">Orden B2B & Despacho</span>
                <button type="button" class="phone-circle-btn" aria-label="Help">?</button>
              </div>

              <!-- Nexa Emblem Badge -->
              <div class="flecto-emblem-badge nexa-phone-badge" aria-hidden="true">
                <img src="/assets/nexa-nx-blue.svg" alt="Nexa" width="32" height="32" />
              </div>

              <div class="summary-meta-block">
                <h4 class="summary-booking-name">Despacho Frigorífico</h4>
                <span class="summary-booking-date">Orden SO-2026-0018 · Lote L-8841</span>
              </div>

              <!-- Monumental Price (Dynamic) -->
              <div class="summary-amount-display" id="step1-display-amount">$3,450.00</div>

              <!-- Telemetry Badge Chip -->
              <div class="step1-telemetry-badge">
                <span class="telemetry-temp text-mono">-18.2°C</span>
                <span class="telemetry-dot live-pulse"></span>
                <span class="telemetry-label">Sensirion Activo · Muelle Callao</span>
              </div>

              <!-- Interactive Volume / Duration Picker Chip -->
              <div class="step1-date-selector">
                <div class="date-chips-label">Volumen & Ventana de Carga</div>
                <div class="date-chips-row">
                  <button type="button" class="duration-chip" data-days="3">250 kg</button>
                  <button type="button" class="duration-chip active" data-days="5">500 kg</button>
                  <button type="button" class="duration-chip" data-days="7">1,000 kg</button>
                </div>
                <div class="dates-range-text">2026/04/10 &rarr; <span id="step1-end-date">2026/04/15</span></div>
              </div>

              <!-- Bottom Sheet Card: Proceed to Verification -->
              <div class="summary-bottom-card" id="trigger-step-2" tabindex="0" role="button" aria-label="Proceed to Verification">
                <div class="bottom-card-header">
                  <span class="bottom-card-title">Carga Frigorífica Certificada</span>
                  <span class="bottom-card-tag">Custodia Escrow 100%</span>
                </div>
                
                <div class="store-row">
                  <div class="store-schematic-thumb" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                      <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                  </div>
                  <div class="store-details">
                    <strong class="store-name">Salmón Salar Congelado (250 kg)</strong>
                    <p class="store-address">Muelle Frío Callao · Bahía 04</p>
                  </div>
                </div>

                <div class="bottom-card-button" id="btn-to-step-2">
                  <span>Confirmar Despacho en Muelle</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                </div>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN INVENTORY: Detalle de Lote Frigorífico
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-inventory" data-state="inventory">
              <div class="summary-top-nav">
                <button type="button" class="phone-circle-btn" id="inv-back-btn" aria-label="Volver a Despacho">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="summary-top-title">Detalle de Lote B2B</span>
                <button type="button" class="phone-circle-btn" aria-label="Ayuda">?</button>
              </div>

              <!-- Date Range Display -->
              <div class="inv-date-range-wrap">
                <div class="inv-date-chips">
                  <span>2026/04/10</span>
                  <div class="inv-arrow-circle">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                  </div>
                  <span>2026/04/15</span>
                </div>
                <div class="inv-rental-sub">Ventana de frío: 5 días</div>
              </div>

              <!-- Slate Bottom Sheet -->
              <div class="inv-cream-bottom-sheet">
                <!-- Table Header -->
                <div class="inv-table-header">
                  <span class="inv-th-items">Producto</span>
                  <div class="inv-th-right">
                    <span>Precio</span>
                    <span>Custodia</span>
                  </div>
                </div>

                <!-- Main Rental Item -->
                <div class="inv-table-row">
                  <div class="inv-item-info">
                    <div class="inv-item-thumb">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                        <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                      </svg>
                    </div>
                    <div>
                      <strong class="inv-item-name">Salmón Salar</strong>
                      <span class="inv-item-qty">500 kg (-18°C)</span>
                    </div>
                  </div>
                  <div class="inv-item-prices">
                    <div>
                      <strong class="inv-item-rate">$2,800.00</strong>
                      <span class="inv-item-unit">/lote</span>
                    </div>
                    <div>
                      <strong class="inv-item-rate">$500.00</strong>
                      <span class="inv-item-unit">/escrow</span>
                    </div>
                  </div>
                </div>

                <!-- Additional Services (Dynamically toggled) -->
                <div id="inv-additional-services-row" style="display: none;">
                  <span class="inv-services-subhead">Servicios Adicionales</span>
                  <div class="inv-service-line">
                    <div class="inv-service-icon-wrap">
                      <div class="inv-service-circle">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                          <rect x="1" y="3" width="15" height="13"/>
                          <polygon points="16 8 20 8 23 11 23 16 16 16 8"/>
                          <circle cx="5.5" cy="18.5" r="2.5"/>
                          <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                      </div>
                      <span class="inv-service-title">Telemetría IoT Sensirion en Ruta</span>
                    </div>
                    <strong class="inv-service-fee">$150.00</strong>
                  </div>
                </div>

                <!-- Totals -->
                <div class="inv-totals-box">
                  <div class="inv-total-line">
                    <span>Base Carga</span>
                    <span id="inv-rental-subtotal" class="text-mono">$3,300.00</span>
                  </div>
                  <div class="inv-total-line grand-total">
                    <span>Total USD</span>
                    <span id="inv-total-amount" class="text-mono">$3,450.00</span>
                  </div>

                  <button type="button" class="phone-submit-btn" id="inv-proceed-btn">
                    Confirmar Precinto IoT &rarr;
                  </button>
                </div>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 2: Biometric & Escrow Verification (Step 2)
                 ------------------------------------------------------------- -->
            <!-- -------------------------------------------------------------
                 PHONE SCREEN 2: Digital Seal & Telemetry Verification (Step 2)
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-2" data-state="2">
              <div class="state-subnav">
                <button type="button" class="phone-back-btn" data-target="1" aria-label="Back to order selection">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="subnav-title">Precinto Digital & IoT</span>
                <span class="secure-tag">Cripto IoT</span>
              </div>

              <div class="face-scan-wrapper">
                <div class="scan-laser-box" aria-hidden="true">
                  <div class="corner-bracket top-l"></div>
                  <div class="corner-bracket top-r"></div>
                  <div class="corner-bracket bot-l"></div>
                  <div class="corner-bracket bot-r"></div>
                  <div class="scan-line"></div>
                  <svg class="face-vector" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.6">
                    <rect x="3" y="3" width="7" height="7"/>
                    <rect x="14" y="3" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/>
                  </svg>
                </div>

                <div class="scan-copy">
                  <h4>Inspección GS1-128 & Precinto</h4>
                  <p>Escaneo criptográfico de precinto y sensor Sensirion en muelle.</p>
                </div>

                <!-- Escrow Guarantee Badge -->
                <div class="escrow-screen-badge">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2.2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                  <span>Custodia Escrow Activa ($3,450.00 USD retenidos)</span>
                </div>

                <button type="button" class="phone-submit-btn" id="confirm-face-scan">
                  <span>Confirmar Inspección & Continuar</span>
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polyline points="2 7 5.5 10.5 12 3"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- -------------------------------------------------------------
                 PHONE SCREEN 3: Settlement & Escrow Custody (Step 3)
                 ------------------------------------------------------------- -->
            <div class="phone-state-view" id="phone-state-3" data-state="3">
              <div class="state-subnav">
                <button type="button" class="phone-back-btn" data-target="2" aria-label="Back to inspection">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"/>
                  </svg>
                </button>
                <span class="subnav-title">Liquidación & Escrow</span>
                <span class="booking-hash text-mono">#NX-2026-0018</span>
              </div>

              <div class="checkout-scroll-body">
                <div class="checkout-item-card">
                  <div class="item-schematic-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                      <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                  </div>
                  <div class="item-info">
                    <strong>Salmón Salar Congelado</strong>
                    <span>Lote L-8841 · Temp: -18.2°C</span>
                  </div>
                  <span class="item-val">$2,800.00</span>
                </div>

                <div class="checkout-lines">
                  <div class="c-line">
                    <span>Telemetría IoT Sensirion</span>
                    <span class="text-mono">$150.00</span>
                  </div>
                  <div class="c-line">
                    <span>Custodia Escrow de Frío</span>
                    <span class="text-mono">$500.00</span>
                  </div>
                  <div class="c-line discount">
                    <span>Bono Despacho Certificado</span>
                    <span class="text-mono">-$0.00</span>
                  </div>
                  <div class="c-line total">
                    <strong>Total Liquidación</strong>
                    <strong class="total-price text-mono">$3,450.00</strong>
                  </div>
                </div>

                <div class="checkout-pickup-card">
