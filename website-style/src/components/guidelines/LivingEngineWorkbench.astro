  /**
   * Full-Screen Mobile Login Modal Management
   */
  function setupLoginModal() {
    const modal = document.getElementById('landing-login-modal');
    const openBtn = document.getElementById('btn-open-landing-login');
    const closeBtn = document.getElementById('btn-close-landing-login');
    const emailInput = document.getElementById('modal-email-input') as HTMLInputElement | null;
