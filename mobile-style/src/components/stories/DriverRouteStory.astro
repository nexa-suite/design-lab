---
/**
 * DriverRouteStory.astro
 * Canonical Mobile Specification for Driver Delivery Execution & Proof of Delivery (POD)
 * Blueprint Traceability: MOB-US-026..035, MOB-US-062..066 (MOBILE-EPIC-04 & 09)
 * Canonical Persona: Diego Morales — Conductor Flota C-250 (Placa WKN-892)
 * Canonical Client: ICISA Distribuciones (Av. Argentina 1240 · Callao/Lima)
 * Domain: Wholesale Cold-Chain B2B Logistics (2°C – 6°C)
 */
---

<div class="story-screen-container" id="story-conductor">
  
  <!-- Web-Style Documentation Heading (Section Index + Kicker + Display H2) -->
  <header class="section-heading-block">
    <div class="section-heading">
      <span class="section-index">01</span>
      <div>
        <p class="section-kicker">DELIVERY / POD · BLUEPRINT MOBILE-EPIC-04 & 09</p>
        <h2>Diego Morales — Hoja de Ruta y Prueba de Entrega Digital (POD)</h2>
        <p class="section-intro">
          Especificación canónica nativa en <strong>Android Jetpack Compose</strong> para la jornada de distribución en frío. Garantiza objetivos táctiles de 56dp para manipulación con guantes térmicos, integración con intención GPS externa (<code>geo:0,0?q=lat,lng</code>), detector de geovalla (200m), selector trifásico de resultado, captura de firma con suavizado Bézier, visor CameraX con metadatos EXIF criptográficos, verificación OTP de 6 dígitos y sincronización Room DB / WorkManager offline-first.
        </p>
      </div>
    </div>

    <!-- Quick Meta Chips -->
    <div class="heading-meta-chips">
      <span class="doc-chip tone-info"><i class="pi pi-truck" aria-hidden="true"></i> Ruta R-402 · Flota C-250 (WKN-892)</span>
      <span class="doc-chip tone-neutral"><i class="pi pi-map-marker" aria-hidden="true"></i> Av. Argentina 1240 · Callao/Lima</span>
      <span class="doc-chip tone-info"><i class="pi pi-snowflake" aria-hidden="true"></i> Manejo Refrigerado (2°C – 6°C)</span>
      <span class="doc-chip tone-success"><i class="pi pi-check-circle" aria-hidden="true"></i> Orden Canónica SO-2026-0018</span>
    </div>
  </header>

  <!-- Interactive Story Workbench: 2-Column Responsive Layout -->
  <div class="story-workbench-layout">
    
    <!-- Left: Step Flow & Functional Blueprint Details matching Web-Style Evidence Cards -->
    <div class="story-details-col">
      
      <!-- Interactive Phase Navigation -->
      <nav class="phase-selector-bar" role="tablist" aria-label="Fases de Entrega POD">
        <button type="button" class="phase-btn active" data-phase="route">
          <span class="phase-badge">01</span>
          <span>Parada Activa</span>
        </button>
        <button type="button" class="phase-btn" data-phase="arrival">
          <span class="phase-badge">02</span>
          <span>Arribo & GPS</span>
        </button>
        <button type="button" class="phase-btn" data-phase="outcome">
          <span class="phase-badge">03</span>
          <span>Resultado</span>
        </button>
        <button type="button" class="phase-btn" data-phase="pod">
          <span class="phase-badge">04</span>
          <span>Firma POD</span>
        </button>
        <button type="button" class="phase-btn" data-phase="otp">
          <span class="phase-badge">05</span>
          <span>Código OTP</span>
        </button>
        <button type="button" class="phase-btn" data-phase="offline">
          <span class="phase-badge">06</span>
          <span>Cola Offline</span>
        </button>
      </nav>

      <!-- Phase 1: Active Stop Details -->
      <div class="phase-panel active" id="panel-phase-route">
        <article class="evidence-card">
          <div class="card-kicker-row">
            <span class="card-step-badge">FASE 01</span>
            <span class="card-mono-id">SO-2026-0018 · PARADA 2 DE 4</span>
          </div>
          <h3 class="card-title">Parada Activa: ICISA Distribuciones</h3>
          <p class="card-desc">
            Visualización secuencial priorizada por ventana horaria de entrega en frío. La tarjeta de parada expone controles táctiles de <strong>56dp</strong> diseñados para uso con guantes industriales y badges semánticos de cadena de frío.
          </p>
          
          <div class="evidence-grid">
            <div class="evidence-item">
              <i class="pi pi-building text-primary" aria-hidden="true"></i>
              <div>
                <strong>Destinatario Mayorista</strong>
                <p>ICISA Distribuciones (RUC 20489123841)</p>
              </div>
            </div>
            <div class="evidence-item">
              <i class="pi pi-map-marker text-primary" aria-hidden="true"></i>
              <div>
                <strong>Dirección de Entrega</strong>
                <p>Av. Argentina 1240 · Callao/Lima (Muelle 2 Descarga)</p>
              </div>
            </div>
            <div class="evidence-item">
              <i class="pi pi-box text-primary" aria-hidden="true"></i>
              <div>
                <strong>Carga Consignada</strong>
                <p>24x Salmón Salar Congelado 4-5kg (SKU ALM-LMO-982)<br/>12x Merluza Austral Filete 10kg</p>
              </div>
            </div>
            <div class="evidence-item">
              <i class="pi pi-snowflake text-info" aria-hidden="true"></i>
              <div>
                <strong>Protocolo Térmico</strong>
                <p>Sensor calibrado 3.8°C (Rango exigido: 2.0°C – 6.0°C)</p>
              </div>
            </div>
          </div>
        </article>
      </div>

      <!-- Phase 2: Arrival & GPS -->
      <div class="phase-panel" id="panel-phase-arrival">
        <article class="evidence-card">
          <div class="card-kicker-row">
            <span class="card-step-badge">FASE 02</span>
            <span class="card-mono-id">GEO-INTENT · -12.046374, -77.042793</span>
          </div>
          <h3 class="card-title">Lanzador GPS y Notificación de Arribo en Geovalla</h3>
          <p class="card-desc">
            Integración de un solo toque con <code>geo:0,0?q=-12.046374,-77.042793(ICISA+Distribuciones)</code>. Permite abrir Google Maps o Waze mediante un Intent implícito de Android sin interrumpir el ciclo de vida del ViewModel.
          </p>
          <div class="evidence-grid">
            <div class="evidence-item">
              <i class="pi pi-compass text-primary" aria-hidden="true"></i>
              <div>
                <strong>Intent URI Android</strong>
                <code>geo:0,0?q=-12.046374,-77.042793</code>
              </div>
            </div>
            <div class="evidence-item">
              <i class="pi pi-map text-success" aria-hidden="true"></i>
              <div>
                <strong>Baliza Geovalla (Geofencing)</strong>
                <p>Radio activo de 200m. Transición automática a <em>"En Sitio de Entrega"</em> al cruzar el umbral.</p>
              </div>
            </div>
          </div>
        </article>
      </div>

      <!-- Phase 3: Delivery Outcome -->
      <div class="phase-panel" id="panel-phase-outcome">
        <article class="evidence-card">
          <div class="card-kicker-row">
            <span class="card-step-badge">FASE 03</span>
            <span class="card-mono-id">TRI-STATE OUTCOME · EXHAUSTIVE DISPATCH</span>
          </div>
          <h3 class="card-title">Selector Trifásico de Resultado de Entrega</h3>
          <p class="card-desc">
            Arquitectura de decisión sin ambigüedad en campo. Cada opción fija un contrato operacional inmutable para el inventario de la bodega y el remito electrónico.
          </p>
          <div class="outcome-grid-specs">
            <div class="outcome-spec-row ok">
              <span class="outcome-tag success"><i class="pi pi-check"></i> ENTREGADO CONFORME</span>
              <p>24x Salmón Salar Congelado + 12x Merluza Austral recibidos a 3.8°C sin observación.</p>
            </div>
            <div class="outcome-spec-row warn">
              <span class="outcome-tag warning"><i class="pi pi-exclamation-triangle"></i> ENTREGA PARCIAL</span>
              <p>Faltante documentado con acta de discrepancia firmada y foto de caja dañada.</p>
            </div>
            <div class="outcome-spec-row danger">
              <span class="outcome-tag danger"><i class="pi pi-ban"></i> RECHAZADO EN MUELLE</span>
              <p>Ruptura de cadena de frío (&gt; 6.0°C) o cliente ausente fuera de horario comercial.</p>
            </div>
          </div>
        </article>
      </div>

      <!-- Phase 4: Proof of Delivery (POD) -->
      <div class="phase-panel" id="panel-phase-pod">
        <article class="evidence-card">
          <div class="card-kicker-row">
            <span class="card-step-badge">FASE 04</span>
            <span class="card-mono-id">POD-2026-0018.PDF · SIGNATURE + EXIF</span>
          </div>
          <h3 class="card-title">Prueba Digital de Entrega: Firma Bézier y Cámara CameraX</h3>
          <p class="card-desc">
            Registro con validez jurídica y de auditoría B2B. El canvas táctil interpola los puntos de contacto con curvas Bézier cúbicas; CameraX captura el remito físico y la lectura del termómetro digital con metadatos incrustados.
          </p>
          <div class="evidence-grid">
            <div class="evidence-item">
              <i class="pi pi-pencil text-primary" aria-hidden="true"></i>
              <div>
                <strong>Lienzo Táctil (Bézier Smoothing)</strong>
                <p>Canvas Compose de 180dp con muestreo de velocidad y botón de borrado inmediato.</p>
              </div>
            </div>
            <div class="evidence-item">
              <i class="pi pi-camera text-primary" aria-hidden="true"></i>
              <div>
                <strong>Evidencia Visual CameraX</strong>
                <p>Resolución 1920x1080 con metadatos EXIF (coordenadas GPS, timestamp UTC y Hash SHA-256).</p>
              </div>
            </div>
          </div>
        </article>
      </div>

      <!-- Phase 5: Handoff OTP -->
      <div class="phase-panel" id="panel-phase-otp">
        <article class="evidence-card">
          <div class="card-kicker-row">
            <span class="card-step-badge">FASE 05</span>
            <span class="card-mono-id">CUSTOMER-HANDOFF · 6-DIGIT OTP</span>
          </div>
          <h3 class="card-title">Código OTP de Custodia Emitido por Comprador</h3>
          <p class="card-desc">
            El receptor de almacén de <code>ICISA Distribuciones</code> (Carlos Mendoza) presenta un código de seguridad de 6 dígitos generado en su terminal para garantizar la entrega al responsable legítimo.
          </p>
          <div class="otp-token-preview">
            <div class="otp-slot">8</div>
            <div class="otp-slot">4</div>
            <div class="otp-slot">9</div>
            <div class="otp-slot">2</div>
            <div class="otp-slot">1</div>
            <div class="otp-slot">0</div>
          </div>
        </article>
      </div>

      <!-- Phase 6: Offline Resilience -->
      <div class="phase-panel" id="panel-phase-offline">
        <article class="evidence-card">
          <div class="card-kicker-row">
            <span class="card-step-badge">FASE 06</span>
            <span class="card-mono-id">WORKMANAGER · COROUTINEWORKER + ROOM</span>
          </div>
          <h3 class="card-title">Garantía Offline-First: Cola Local Persistente</h3>
          <p class="card-desc">
            En muelles subterráneos o cámaras frigoríficas aisladas electromagnéticamente, la prueba de entrega se sella en SQLite (Room) con clave UUID idempotente y se sincroniza al recuperar red.
          </p>
          <div class="status-banner-offline">
            <i class="pi pi-check-circle" aria-hidden="true"></i>
            <div>
              <strong>Sincronizado con Room DB · 0 en cola</strong>
              <small>Todas las evidencias locales han sido replicadas al cluster de Nexa.</small>
            </div>
          </div>
        </article>
      </div>

      <!-- Jetpack Compose Production Code Sample -->
      <section class="compose-code-container">
        <div class="code-card-header">
          <div class="code-title-group">
            <i class="pi pi-android" aria-hidden="true"></i>
            <span class="code-tag">Android Jetpack Compose · Material 3</span>
          </div>
          <span class="code-path">:apps:operations-android/delivery/DriverRouteScreen.kt</span>
        </div>
        <pre class="compose-code"><code><span class="kw">@Composable</span>
<span class="kw">fun</span> <span class="fn">DriverDeliveryScreen</span>(
    state: <span class="type">DriverDeliveryUiState</span>,
    onNavigateGps: (destination: <span class="type">LatLng</span>) -&gt; <span class="type">Unit</span>,
    onConfirmArrival: () -&gt; <span class="type">Unit</span>,
    onSelectOutcome: (outcome: <span class="type">DeliveryOutcome</span>) -&gt; <span class="type">Unit</span>,
    onCapturePodSignature: (signatureBytes: <span class="type">ByteArray</span>) -&gt; <span class="type">Unit</span>,
    onVerifyOtp: (otpCode: <span class="type">String</span>) -&gt; <span class="type">Unit</span>,
    modifier: <span class="type">Modifier</span> = <span class="type">Modifier</span>
) &#123;
    <span class="type">Scaffold</span>(
        topBar = &#123;
            <span class="type">TopAppBar</span>(
                title = &#123; <span class="type">Text</span>(<span class="str">"Ruta R-402 · Flota C-250 (WKN-892)"</span>) &#125;,
                colors = <span class="type">TopAppBarDefaults</span>.<span class="fn">topAppBarColors</span>(
                    containerColor = <span class="type">NexaTheme</span>.colors.surfaceCard
                )
            )
        &#125;
    ) &#123; innerPadding -&gt;
        <span class="type">LazyColumn</span>(
            modifier = modifier.<span class="fn">padding</span>(innerPadding).<span class="fn">fillMaxSize</span>(),
            contentPadding = <span class="type">PaddingValues</span>(<span class="num">16</span>.dp),
            verticalArrangement = <span class="type">Arrangement</span>.<span class="fn">spacedBy</span>(<span class="num">16</span>.dp)
        ) &#123;
            item &#123;
                <span class="type">ActiveDeliveryStopCard</span>(
                    orderId = state.activeOrder.<span class="fn">id</span>, <span class="cmt">// "SO-2026-0018"</span>
                    clientName = state.activeOrder.<span class="fn">buyer</span>, <span class="cmt">// "ICISA Distribuciones"</span>
                    address = state.activeOrder.<span class="fn">destination</span>, <span class="cmt">// "Av. Argentina 1240 · Lima"</span>
                    temperatureRange = <span class="str">"2.0°C – 6.0°C"</span>,
                    currentTemp = <span class="num">3.8f</span>,
                    minTouchTarget = <span class="num">56</span>.dp,
                    onGpsClick = &#123; onNavigateGps(state.activeOrder.coordinates) &#125;
                )
            &#125;
            item &#123;
                <span class="type">DeliveryOutcomeSelector</span>(
                    selected = state.outcome,
                    onSelect = onSelectOutcome,
                    targetHeight = <span class="num">56</span>.dp
                )
            &#125;
            item &#123;
                <span class="type">PodSignaturePad</span>(
                    modifier = <span class="type">Modifier</span>.<span class="fn">fillMaxWidth</span>().<span class="fn">height</span>(<span class="num">180</span>.dp),
                    onCompleted = onCapturePodSignature
                )
            &#125;
        &#125;
    &#125;
&#125;</code></pre>
      </section>

    </div>

    <!-- Right: Smartphone Hardware Simulator Frame showing the High-Fidelity Compose Mockup -->
    <div class="story-preview-col">
      <div class="device-chassis-shell">
        
        <!-- Status Bar (Android Material 3: 14:20, 5G, Battery) -->
        <div class="android-status-bar">
          <span class="status-clock">14:20</span>
          <div class="status-icons-cluster">
            <span class="conn-tag">5G</span>
            <i class="pi pi-wifi" aria-hidden="true"></i>
            <span class="battery-pct">88%</span>
            <i class="pi pi-bolt battery-icon" aria-hidden="true"></i>
          </div>
        </div>

        <!-- Android Native App Viewport (Compose) -->
        <div class="compose-screen-viewport">
          
          <!-- Top App Bar (Material 3 Small TopAppBar) -->
          <div class="compose-top-app-bar">
            <button type="button" class="btn-app-icon" title="Volver a ruta">
              <i class="pi pi-arrow-left" aria-hidden="true"></i>
            </button>
            <div class="appbar-title-block">
              <span class="appbar-headline">Ruta R-402 · Flota C-250</span>
              <span class="appbar-sub">Placa WKN-892 · Diego Morales</span>
            </div>
            <span class="status-sync-chip" title="WorkManager sincronizado">
              <i class="pi pi-check" aria-hidden="true"></i>
            </span>
          </div>

          <!-- Offline Sync Banner (WorkManager Room DB) -->
          <div class="workmanager-sync-banner">
            <i class="pi pi-shield text-success" aria-hidden="true"></i>
            <span>Sincronizado con Room DB · 0 en cola</span>
          </div>

          <!-- Scrollable Screen Content -->
          <div class="compose-scroll-content">
            
            <!-- Step 1: Delivery Stop Card (56dp target, cold-chain chip) -->
            <div class="compose-card delivery-stop-card">
              <div class="card-header-line">
                <span class="order-tag">ORDEN SO-2026-0018</span>
                <span class="cold-chip"><i class="pi pi-snowflake" aria-hidden="true"></i> 2°C – 6°C</span>
              </div>
              <h4 class="buyer-heading">ICISA Distribuciones</h4>
              <p class="destination-line">
                <i class="pi pi-map-marker" aria-hidden="true"></i>
                Av. Argentina 1240 · Callao/Lima · Muelle 2
              </p>

              <div class="cargo-manifest-box">
                <div class="manifest-item">
                  <span class="sku-dot"></span>
                  <span class="sku-name">24x Salmón Salar Congelado 4-5kg</span>
                  <span class="sku-code">ALM-LMO-982</span>
                </div>
                <div class="manifest-item">
                  <span class="sku-dot"></span>
                  <span class="sku-name">12x Merluza Austral Filete 10kg</span>
                  <span class="sku-code">ALM-MRZ-104</span>
                </div>
              </div>

              <!-- Step 2: External GPS Intent (56dp touch target) -->
              <button type="button" class="btn-glove-primary btn-gps" id="btn-mock-gps">
                <i class="pi pi-compass" aria-hidden="true"></i>
                <span>Navegar GPS (geo:0,0?q=-12.046374,-77.042793)</span>
              </button>

              <div class="geofence-alert-box">
                <span class="geofence-pulse"></span>
                <span>Dentro de geovalla (140m de Muelle 2)</span>
              </div>
            </div>

            <!-- Step 3: Tri-State Delivery Outcome -->
            <div class="compose-card outcome-selector-card">
              <span class="card-subhead">RESULTADO DE ENTREGA (56dp GLOVE CONTROLS):</span>
              <div class="tri-state-button-stack">
                <button type="button" class="tri-outcome-btn active">
                  <i class="pi pi-check-circle" aria-hidden="true"></i>
                  <div class="outcome-btn-text">
                    <strong>Entregado Conforme</strong>
                    <small>24x Salmón + 12x Merluza a 3.8°C</small>
                  </div>
                </button>
                <button type="button" class="tri-outcome-btn">
                  <i class="pi pi-exclamation-triangle" aria-hidden="true"></i>
                  <div class="outcome-btn-text">
                    <strong>Entrega Parcial</strong>
                    <small>Faltante documentado con acta</small>
                  </div>
                </button>
                <button type="button" class="tri-outcome-btn">
                  <i class="pi pi-times-circle" aria-hidden="true"></i>
                  <div class="outcome-btn-text">
                    <strong>Rechazado</strong>
                    <small>Ruptura cadena de frío (&gt;6°C)</small>
                  </div>
                </button>
              </div>
            </div>

            <!-- Step 4: Digital POD (Bézier Signature & CameraX) -->
            <div class="compose-card pod-signature-card">
              <div class="pod-card-header">
                <span class="card-subhead">PRUEBA DIGITAL DE ENTREGA (POD):</span>
                <button type="button" class="btn-clear-canvas">Limpiar</button>
              </div>

              <div class="signature-canvas-area">
                <svg viewBox="0 0 320 80" class="bezier-signature-svg" preserveAspectRatio="none">
                  <path d="M 25 55 Q 70 12 110 48 T 190 35 T 260 58 T 300 40" fill="none" stroke="#1d4ed8" stroke-width="2.8" stroke-linecap="round"/>
                </svg>
                <div class="signature-meta-tag">
                  <span>Receptor: Carlos Mendoza (Jefe de Almacén)</span>
                  <small>EXIF: 14:20:18 UTC · GPS -12.0463, -77.0427 · SHA-256 Validado</small>
                </div>
              </div>

              <div class="camerax-photo-preview-box">
                <i class="pi pi-camera" aria-hidden="true"></i>
                <div class="photo-info-text">
                  <strong>Foto Guía & Sensor 3.8°C Capturada</strong>
                  <small>IMG_20260925_142018_POD.jpg (1.8 MB · EXIF incrustado)</small>
                </div>
              </div>
            </div>

            <!-- Step 5: 6-Digit Customer OTP Verification -->
            <div class="compose-card otp-verification-card">
              <span class="card-subhead">CÓDIGO DE TRASPASO DEL COMPRADOR (OTP):</span>
              <div class="otp-boxes-row">
                <span class="otp-cell">8</span>
                <span class="otp-cell">4</span>
                <span class="otp-cell">9</span>
                <span class="otp-cell">2</span>
                <span class="otp-cell">1</span>
                <span class="otp-cell">0</span>
              </div>
              <small class="otp-notice">Presentado por Carlos Mendoza · Validado con servidor local</small>
            </div>

            <!-- Step 6: Confirmation Action (56dp target) -->
            <button type="button" class="btn-glove-confirm">
              <i class="pi pi-shield" aria-hidden="true"></i>
              <span>Completar Entrega y Emitir Remito POD</span>
            </button>

          </div>

          <!-- Bottom Navigation Bar (Material 3) -->
          <div class="compose-bottom-nav">
            <div class="bnav-tab active">
              <i class="pi pi-map" aria-hidden="true"></i>
              <span>Ruta</span>
            </div>
            <div class="bnav-tab">
              <i class="pi pi-list" aria-hidden="true"></i>
              <span>Paradas (4)</span>
            </div>
            <div class="bnav-tab">
              <i class="pi pi-snowflake" aria-hidden="true"></i>
              <span>Sensores</span>
            </div>
            <div class="bnav-tab">
              <i class="pi pi-user" aria-hidden="true"></i>
              <span>Diego M.</span>
            </div>
          </div>

        </div>

        <!-- Android Home Navigation Indicator (Gesture Bar) -->
        <div class="android-gesture-pill"></div>
      </div>
    </div>

  </div>

</div>

<style>
  /* ==========================================================================
     STORY SCREEN CONTAINER & WEB-STYLE SECTION FOUNDATIONS
     ========================================================================== */
  .story-screen-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--nexa-space-6, 24px);
  }

  .section-heading-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: var(--nexa-space-3, 12px);
    align-items: start;
  }

  .section-index {
    color: var(--nexa-color-primary-600, #2563eb);
    font: 700 var(--nexa-font-size-sm, 14px) / 1.4 var(--nexa-font-family-mono, monospace);
  }

  .section-kicker {
    margin: 0 0 6px;
    color: var(--nexa-color-primary-700, #1d4ed8);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0;
