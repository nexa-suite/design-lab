  <script>
    // Sub-view toggle between Interactive Simulator and Multi-Device Gallery
    const btnToggleSim = document.getElementById('btn-toggle-simulator');
    const btnToggleGal = document.getElementById('btn-toggle-gallery');
    const viewSimStage = document.getElementById('view-interactive-simulator-stage');
    const viewGalStage = document.getElementById('view-multi-device-gallery-stage');

    btnToggleSim?.addEventListener('click', () => {
      btnToggleSim.classList.add('active');
      btnToggleGal?.classList.remove('active');
      if (viewSimStage) viewSimStage.style.display = 'block';
      if (viewGalStage) viewGalStage.style.display = 'none';
    });

    btnToggleGal?.addEventListener('click', () => {
      btnToggleGal.classList.add('active');
      btnToggleSim?.classList.remove('active');
      if (viewGalStage) viewGalStage.style.display = 'block';
      if (viewSimStage) viewSimStage.style.display = 'none';
    });
  </script>
