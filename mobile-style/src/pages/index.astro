---
/**
 * MOBILE STYLE — MASTER GUIDELINES & INTERACTIVE DEVICE SIMULATOR
 * Unified 1:1 Design Lab Architecture with Web Style shell, zero padding errors,
 * and comprehensive specifications for Android Jetpack Compose & Flutter.
 */
import 'primeicons/primeicons.css';
import '../styles/mobile-tokens.css';
import UnifiedLabShell from '../components/layout/UnifiedLabShell.astro';
import MobileArchitectureHero from '../components/guidelines/MobileArchitectureHero.astro';
import MobileFoundationsSection from '../components/guidelines/MobileFoundationsSection.astro';
import MobileErgonomicsSection from '../components/guidelines/MobileErgonomicsSection.astro';
import MobileComponentsSection from '../components/guidelines/MobileComponentsSection.astro';
import MobileHardwareSection from '../components/guidelines/MobileHardwareSection.astro';
import MobileResilienceSection from '../components/guidelines/MobileResilienceSection.astro';
import CodeSnippetsTabs from '../components/spec/CodeSnippetsTabs.astro';
import DeviceFrame from '../components/simulator/DeviceFrame.astro';
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mobile Style · Nexa Design Lab (Android Kotlin Compose & Flutter)</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link 
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" 
    rel="stylesheet"
  >

  <style>
    /* Global Reset & Padding Hygiene */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--nexa-surface-page, #f6faff);
      color: var(--nexa-color-text-primary, #0f172a);
      font-family: var(--nexa-font-family-body, 'Inter', sans-serif);
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* Master Documentation Page (Exact padding & layout matching web-style) */
    .documentation-page {
      width: min(calc(100% - 48px), var(--nexa-layout-content-max, 1400px));
      margin: 0 auto;
      padding: clamp(24px, 4vw, 48px) 0 96px;
      color: var(--nexa-color-text-primary, #0f172a);
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* Documentation Header (Matching web-style) */
    .documentation-header {
      display: grid;
      gap: 18px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    .breadcrumb-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      color: var(--nexa-color-text-muted, #94a3b8);
      font: 500 11px/1.4 var(--nexa-font-family-mono, monospace);
    }

    .breadcrumb-row a {
      color: var(--nexa-color-primary-700, #1d4ed8);
      text-decoration: none;
      font-weight: 600;
    }

    .header-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 32px;
      align-items: start;
    }

    @media (max-width: 900px) {
      .header-grid {
        grid-template-columns: 1fr;
      }
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .12em;
      line-height: 1.3;
      text-transform: uppercase;
    }

    .documentation-header h1 {
      max-width: 820px;
      margin: 0;
      font: 800 clamp(28px, 4vw, 44px)/1.1 var(--nexa-font-family-display, sans-serif);
      letter-spacing: -.035em;
      color: var(--nexa-color-text-primary, #0f172a);
    }

    .intro {
      max-width: 780px;
      margin: 12px 0 0;
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 15px;
      line-height: 1.6;
    }

    .status-panel {
      display: grid;
      gap: 8px;
      padding: 16px;
      border: 1px solid var(--nexa-color-border-default, #e2e8f0);
      border-radius: var(--nexa-radius-card, 16px);
      background: var(--nexa-surface-card, #ffffff);
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 11.5px;
      line-height: 1.4;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .status-label {
      margin: 0;
      color: var(--nexa-color-text-muted, #94a3b8);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .design-status {
      display: inline-flex;
      width: fit-content;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .04em;
      color: var(--nexa-color-primary-800, #1e40af);
      background: var(--nexa-color-primary-100, #dbeafe);
    }

    .adoption-status {
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-weight: 700;
    }

    .header-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
      color: var(--nexa-color-text-muted, #94a3b8);
      font-size: 11.5px;
    }

    .header-meta span {
      display: inline-flex;
      gap: 6px;
      align-items: center;
    }

    .header-meta i {
      color: var(--nexa-color-primary-600, #2a67d9);
      font-size: 13px;
    }

    /* Document Lede (Matching web-style) */
    .document-lede {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(300px, 1fr);
      gap: 32px;
      align-items: end;
      padding: 24px 0;
      border-bottom: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    @media (max-width: 900px) {
      .document-lede {
        grid-template-columns: 1fr;
      }
    }

    .section-kicker {
      margin: 0 0 6px;
      color: var(--nexa-color-primary-700, #1d4ed8);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .document-lede h2 {
      margin: 0 0 6px;
      font: 700 clamp(20px, 2.5vw, 26px)/1.2 var(--nexa-font-family-display, sans-serif);
      letter-spacing: -.03em;
      color: var(--nexa-color-text-primary, #0f172a);
    }

    .document-lede p {
      color: var(--nexa-color-text-secondary, #64748b);
      line-height: 1.55;
      font-size: 13.5px;
    }

    .provenance-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .provenance-strip span {
      display: grid;
      gap: 4px;
      min-width: 140px;
      padding: 10px 14px;
      border-left: 3px solid var(--nexa-color-primary-400, #60a5fa);
      background: var(--nexa-surface-card, #ffffff);
      border-radius: 0 8px 8px 0;
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 11.5px;
      border-top: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      border-right: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      border-bottom: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
    }

    .provenance-strip b {
      color: var(--nexa-color-text-primary, #0f172a);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Core Guidelines & Simulator Split Grid */
    .guidelines-split-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 440px;
      gap: 32px;
      align-items: start;
      width: 100%;
    }

    @media (max-width: 1180px) {
      .guidelines-split-layout {
        grid-template-columns: 1fr;
      }
    }

    .guidelines-stream {
      display: flex;
      flex-direction: column;
      gap: 32px;
      min-width: 0;
    }

    /* Sticky Simulator Column with Zero Padding Overflow */
    .simulator-rail {
      position: sticky;
      top: 76px;
      width: 100%;
      max-width: 440px;
      margin: 0 auto;
      scroll-margin-top: 80px;
    }

    /* Code Snippets Section */
    .code-generator-card {
      background: var(--nexa-surface-card, #ffffff);
      border: 1px solid var(--nexa-color-border-structural, #e2e8f0);
      border-radius: var(--nexa-radius-card, 16px);
      padding: 24px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
      display: flex;
      flex-direction: column;
      gap: 16px;
      scroll-margin-top: 80px;
    }

    .card-header-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .card-badge-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: var(--nexa-color-primary-50, #eff6ff);
      color: var(--nexa-color-primary-600, #2a67d9);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      flex-shrink: 0;
    }

    .card-eyebrow {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.12em;
      color: var(--nexa-color-primary-700, #1d4ed8);
      text-transform: uppercase;
      display: block;
      margin-bottom: 2px;
    }

    .card-title {
      font-family: var(--nexa-font-family-display, sans-serif);
      font-size: 17px;
      font-weight: 700;
      color: var(--nexa-color-text-primary, #0f172a);
      margin: 0;
    }

    .card-text {
      font-size: 13.5px;
      color: var(--nexa-color-text-secondary, #64748b);
      line-height: 1.6;
      margin: 0;
    }

    /* Provenance Section (Matching web-style) */
    .provenance-section {
      padding: 32px 0 0;
      border-top: 1px solid var(--nexa-color-border-structural, #e2e8f0);
    }

    .provenance-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    @media (max-width: 900px) {
      .provenance-grid {
        grid-template-columns: 1fr;
      }
    }

    .provenance-grid > div {
      padding: 16px;
      border-top: 3px solid var(--nexa-color-primary-300, #93c5fd);
      background: var(--nexa-surface-card, #ffffff);
      border-radius: 0 0 10px 10px;
      border-left: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      border-right: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
      border-bottom: 1px solid var(--nexa-color-border-subtle, #f1f5f9);
    }

    .provenance-grid b {
      font-size: 13px;
      color: var(--nexa-color-text-primary, #0f172a);
    }

    .provenance-grid p {
      margin: 8px 0 0;
      color: var(--nexa-color-text-secondary, #64748b);
      font-size: 12px;
      line-height: 1.5;
    }
  </style>
</head>
<body>

  <!-- Unified Design Lab Shell (Identical layout to Web Style) -->
  <UnifiedLabShell currentSection="mobile">
    <main class="documentation-page" id="documentation-content">
      
      <!-- Top Documentation Header -->
      <header class="documentation-header">
        <div class="breadcrumb-row">
          <a href="/">Design Lab</a>
          <span aria-hidden="true">/</span>
          <span>Mobile Style</span>
          <span aria-hidden="true">/</span>
          <span>Guidelines</span>
        </div>

        <div class="header-grid">
          <div>
            <p class="eyebrow">CANONICAL MOBILE SPECIFICATION</p>
            <h1>Directrices de Diseño Móvil (Android & Flutter)</h1>
            <p class="intro">
              Sistema de diseño unificado para dispositivos móviles de <strong>Nexa Suite</strong>. Integra los contratos de ergonomía táctil (mínimo 48dp), elevaciones Material 3, escalado tipográfico en <code>sp</code>, escaneo óptico CameraX y cola de reintentos con WorkManager.
            </p>
          </div>

          <aside class="status-panel">
            <span class="status-label">MATURIDAD</span>
            <strong class="design-status">FROZEN CANDIDATE</strong>
            <span class="status-label">ADOPCIÓN</span>
            <strong class="adoption-status">Operations Android & Buyer Flutter</strong>
            <span>Android SDK 37 (minSdk 29) · Flutter 3.x · WCAG 2.2 AA</span>
          </aside>
        </div>

        <div class="header-meta">
          <span><i class="pi pi-android" aria-hidden="true"></i>Kotlin 2.4 · Jetpack Compose M3</span>
          <span><i class="pi pi-code" aria-hidden="true"></i>Flutter 3.x · Provider</span>
          <span><i class="pi pi-camera" aria-hidden="true"></i>CameraX + ML Kit Vision</span>
          <span><i class="pi pi-eye" aria-hidden="true"></i>WCAG 2.2 AA (48dp target)</span>
        </div>
      </header>

      <!-- Document Lede -->
      <section class="document-lede">
        <div>
          <p class="section-kicker">MODELO DE EVIDENCIA</p>
          <h2>Observa el contrato antes de examinar el código.</h2>
          <p>
            Cada sección presenta especificaciones visuales en vivo, reglas métricas inquebrantables, zonas biomécanicas de pulgar y snippets de código listos para producción.
          </p>
        </div>
        <div class="provenance-strip">
          <span><b>Decisión</b>ADR-0018 & ADR-0019</span>
          <span><b>Fundación</b>Material 3 + NexaTokens</span>
          <span><b>Revisión</b>Candidato hasta aprobación humana</span>
        </div>
      </section>

      <!-- Split Stream: Guidelines vs Sticky Device Simulator -->
      <div class="guidelines-split-layout">
        <!-- Left: Complete Mobile Style Guidelines Stream -->
        <div class="guidelines-stream">
          <!-- 1. Architectural Clarification (¿Qué usan?) -->
          <MobileArchitectureHero />

          <!-- 2. Fundamentos & Tokens M3 -->
          <MobileFoundationsSection />

          <!-- 3. Ergonomía Táctil & Bounding Boxes -->
          <MobileErgonomicsSection />

          <!-- 4. Componentes Canónicos Móviles -->
          <MobileComponentsSection />

          <!-- 5. Hardware & Escaneo Óptico (CameraX) -->
          <MobileHardwareSection />

          <!-- 6. Resiliencia de Red & Reintentos (WorkManager) -->
          <MobileResilienceSection />

          <!-- 7. Generador de Código Nativo -->
          <section class="code-generator-card" id="sec-codigo-nativo" data-platform-target="universal">
            <div class="card-header-row">
              <div class="card-badge-icon"><i class="pi pi-code"></i></div>
              <div>
                <span class="card-eyebrow">CÓDIGO DE PRODUCCIÓN · DUAL TARGET</span>
                <h3 class="card-title">Generador de Código Nativo (Compose & Flutter)</h3>
              </div>
            </div>
            <p class="card-text">
              Implementaciones verificadas frente al compilador de Kotlin 2.4 y Dart. Utilizan tokens semánticos del Design Lab y garantizan objetivos táctiles de 48dp.
            </p>
            <CodeSnippetsTabs />
          </section>
        </div>

        <!-- Right: Interactive Smartphone Hardware Stand (Sticky) -->
        <aside class="simulator-rail" id="sec-simulador" aria-label="Simulador de Hardware Móvil">
          <DeviceFrame />
        </aside>
      </div>

      <!-- Provenance Section (Matching web-style) -->
      <section class="provenance-section">
        <div class="provenance-grid">
          <div>
            <b>Android Compose Contract</b>
            <p>Módulo <code>:core:designsystem</code> con <code>NexaTheme</code>, Material 3, ViewModels UDF y Navigation 3 en <code>apps/operations-android</code>.</p>
          </div>
          <div>
            <b>Flutter Multiplatform Contract</b>
            <p>Organización <em>feature-first</em> en <code>app/core/features</code> con <code>provider</code>, <code>go_router</code> y toolchain moderno de Swift Package Manager en iOS (ADR-0019).</p>
          </div>
          <div>
            <b>Human Review Gate</b>
            <p>La dirección visual móvil, los contratos de ergonomía táctil y la evidencia de accesibilidad permanecen sujetos a validación en equipo.</p>
          </div>
        </div>
      </section>

    </main>
  </UnifiedLabShell>

</body>
</html>
