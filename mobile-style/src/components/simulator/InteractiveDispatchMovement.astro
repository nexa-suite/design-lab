<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Kanban Interactive Movement Logic
    const counts = {
      orders: 4,
      prep: 3,
      distrib: 5,
      delivered: 18
    };

    const toastBar = document.getElementById('dispatch-live-toast');
    const toastText = document.getElementById('dispatch-toast-text');

    function updateCounters() {
      // Update badges
      const bOrders = document.getElementById('badge-orders');
      const bPrep = document.getElementById('badge-prep');
      const bDistrib = document.getElementById('badge-distrib');
      const bDelivered = document.getElementById('badge-delivered');

      if (bOrders) bOrders.textContent = String(counts.orders);
      if (bPrep) bPrep.textContent = String(counts.prep);
      if (bDistrib) bDistrib.textContent = String(counts.distrib);
      if (bDelivered) bDelivered.textContent = String(counts.delivered);

      // Update mobile tabs
      const tOrders = document.getElementById('tab-count-orders');
      const tPrep = document.getElementById('tab-count-prep');
      const tDistrib = document.getElementById('tab-count-distrib');
      const tDelivered = document.getElementById('tab-count-delivered');

      if (tOrders) tOrders.textContent = String(counts.orders);
      if (tPrep) tPrep.textContent = String(counts.prep);
      if (tDistrib) tDistrib.textContent = String(counts.distrib);
      if (tDelivered) tDelivered.textContent = String(counts.delivered);
    }

    function showDispatchToast(msg: string) {
      if (!toastBar || !toastText) return;
      toastText.textContent = msg;
      toastBar.style.display = 'flex';
      setTimeout(() => {
        toastBar.style.display = 'none';
      }, 3500);
    }

    // Move Button Listeners
    function attachMoveListeners() {
      document.querySelectorAll('.btn-card-move').forEach(btn => {
        btn.replaceWith(btn.cloneNode(true));
      });

      document.querySelectorAll('.btn-card-move').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const cardId = btn.getAttribute('data-card');
          const nextCol = btn.getAttribute('data-next');
          if (!cardId || !nextCol) return;

          const card = document.getElementById(cardId);
          if (!card) return;

          const targetZone = document.getElementById(`zone-${nextCol}`);
          const orderCode = card.getAttribute('data-id') || 'Orden';
          const client = card.getAttribute('data-client') || '';

          if (targetZone) {
            // Update card status attribute
            card.setAttribute('data-status', nextCol);
            
            // Adjust card button for the new stage
            if (nextCol === 'prep') {
              btn.setAttribute('data-next', 'distrib');
              btn.innerHTML = '<span>Despachar a Ruta</span> <i class="pi pi-arrow-right"></i>';
              counts.orders = Math.max(0, counts.orders - 1);
              counts.prep += 1;
              showDispatchToast(`${orderCode} (${client}) avanzada a Preparación (Staging Muelle 3)`);
            } else if (nextCol === 'distrib') {
              btn.setAttribute('data-next', 'delivered');
              btn.innerHTML = '<span>Confirmar Entrega</span> <i class="pi pi-check"></i>';
              counts.prep = Math.max(0, counts.prep - 1);
              counts.distrib += 1;
              showDispatchToast(`${orderCode} en tránsito hacia destino final`);
            } else if (nextCol === 'delivered') {
              card.classList.add('delivered');
              btn.parentElement?.remove(); // remove action buttons in delivered
              counts.distrib = Math.max(0, counts.distrib - 1);
              counts.delivered += 1;
              showDispatchToast(`${orderCode} entregada satisfactoriamente con POD verificado`);
            }

            // Animate card movement
            card.style.opacity = '0';
            card.style.transform = 'translateY(6px)';
            targetZone.prepend(card);
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            }, 50);

            updateCounters();
          }
        });
      });
    }

    attachMoveListeners();

    // Reset Board
    const btnReset = document.getElementById('btn-reset-board');
    btnReset?.addEventListener('click', () => {
      location.reload();
    });

    // Mobile Column Switcher (for small viewports)
    const colTabs = document.querySelectorAll('.col-tab-btn');
    const kanbanColumns = document.querySelectorAll('.kanban-column');

    colTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        colTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const targetColId = tab.getAttribute('data-col');
        kanbanColumns.forEach(col => {
          if (col.id === targetColId) {
            col.classList.add('active');
          } else {
            col.classList.remove('active');
          }
        });
      });
    });

    // Dynamic QR Generator Modal
    const qrBackdrop = document.getElementById('qr-modal-backdrop');
    const btnCloseQr = document.getElementById('btn-close-qr-modal');
    const qrTitle = document.getElementById('qr-dialog-order-title');
    const qrCarrier = document.getElementById('qr-carrier-val');
    const qrHash = document.getElementById('qr-hash-val');
    const btnCopyToken = document.getElementById('btn-copy-token');
    const btnQuickQr = document.getElementById('btn-quick-qr');

    function openQrModal(orderId: string, carrier: string) {
      if (qrTitle) qrTitle.textContent = `Token QR Criptográfico: ${orderId}`;
      if (qrCarrier) qrCarrier.textContent = carrier || 'Diego Morales · Flota C-250 (WKN-892)';
      
      // Generate realistic dynamic HMAC-SHA256 mock digest
      const randomSalt = Math.random().toString(36).substring(2, 8).toUpperCase();
      const timestamp = Date.now().toString(16).toUpperCase();
      const mockHash = `HMAC-SHA256: ${randomSalt}9E8D1A3F${timestamp}4BC72`;
      if (qrHash) qrHash.textContent = mockHash;

      if (qrBackdrop) qrBackdrop.style.display = 'flex';
    }

    document.querySelectorAll('.btn-card-qr').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const cardId = btn.getAttribute('data-card');
        const card = cardId ? document.getElementById(cardId) : null;
        const orderId = card?.getAttribute('data-id') || 'DSP-204';
        const carrier = card?.getAttribute('data-carrier') || 'Diego Morales (WKN-892)';
        openQrModal(orderId, carrier);
      });
    });

    btnQuickQr?.addEventListener('click', () => {
      openQrModal('DSP-204', 'Diego Morales · Flota C-250 (WKN-892)');
    });

    btnCloseQr?.addEventListener('click', () => {
      if (qrBackdrop) qrBackdrop.style.display = 'none';
    });

    qrBackdrop?.addEventListener('click', (e) => {
      if (e.target === qrBackdrop) {
        qrBackdrop.style.display = 'none';
      }
    });

    btnCopyToken?.addEventListener('click', () => {
      const hash = qrHash?.textContent || '';
      navigator.clipboard?.writeText(hash);
      alert(`Token copiado al portapapeles:\n${hash}`);
    });
  });
</script>

