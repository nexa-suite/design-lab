---
// Hero Section: Bürocratik Awwwards SOTD Forensic Architectural Silhouette with Interactive Circuit
import { generateContainerCommands, commandsToSvgPath } from '../../lib/nexafy/geometry';
import { NEXAFY_PRESETS } from '../../lib/nexafy/presets';

const heroSilhouettePath = commandsToSvgPath(generateContainerCommands(NEXAFY_PRESETS.CHANNELS));
---

<section class="hero-section" id="hero" aria-labelledby="hero-heading">
  <!-- Sculpted Continuous Frame Container -->
  <div class="hero-sculpted-canvas" id="hero-sculpted-canvas" data-settled="true">
    
    <!-- 1. Unified Architectural SVG Silhouette Background -->
    <svg 
      class="hero-silhouette-svg" 
      viewBox="0 0 1440 820" 
      preserveAspectRatio="none" 
      aria-hidden="true"
    >
      <defs>
        <radialGradient id="canvas-radial-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#005e49" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#004737" stop-opacity="0" />
        </radialGradient>
      </defs>
      <!-- The continuous sculpted contour path matching Bürocratik SOTD geometry generated by Nexafy -->
      <path 
        class="hero-silhouette-path" 
        d={heroSilhouettePath}
        fill="#004737"
      />
      <!-- Ambient Radial Backlight Glow within the frame -->
      <rect x="0" y="0" width="1440" height="820" fill="url(#canvas-radial-glow)" />
    </svg>

    <!-- 2. TOP LAYER (Notches & Elevated Crown Content) -->
    <header class="hero-top-layer">
      <!-- Top-Left White Notch: Brand & Primary Links -->
      <div class="hero-top-left">
        <a href="#" class="flecto-brand" aria-label="Flecto Homepage">
          <span class="flecto-logo-bricks" aria-hidden="true">
            <span class="brick brick-sm"></span>
            <span class="brick brick-lg"></span>
            <span class="brick brick-lg"></span>
            <span class="brick brick-sm"></span>
          </span>
          <span class="flecto-logo-word">Flecto</span>
        </a>

        <nav class="hero-nav-links" aria-label="Primary navigation">
          <a href="/about" class="hero-nav-link">About</a>
          <a href="/nexafy" class="hero-nav-link">Nexafy</a>
          <a href="#market" class="hero-nav-link">Market</a>
        </nav>
      </div>

      <!-- Top-Center Crown: Monumental Editorial Headline -->
      <div class="hero-top-center">
        <div class="hero-crown-content">
          <h1 id="hero-heading" class="hero-main-title">
            Unlock your rental <br />
            business
          </h1>
          <p class="hero-main-sub">
            The easiest way to access new customers and a greener future
          </p>
        </div>
      </div>

      <!-- Top-Right White Notch: Language, CTA & Login -->
      <div class="hero-top-right">
        <div class="hero-lang-pill" aria-label="Language selector">
          <button type="button" class="lang-toggle-btn active" aria-label="Selected language English">EN</button>
          <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="2 4 6 8 10 4"></polyline>
          </svg>
        </div>

        <a href="#book-demo" class="hero-book-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Book a Demo</span>
        </a>

        <a href="#login" class="hero-login-btn">
          <span>Login</span>
        </a>

        <!-- Mobile Drawer Trigger -->
        <button 
          type="button" 
          class="hero-mobile-trigger" 
          id="hero-menu-trigger" 
          aria-label="Open navigation menu"
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <!-- 3. CENTER STAGE (Authentic Forensic Circuit & Modular Mark) -->
    <div class="hero-center-stage" id="circuit-stage">
      
      <!-- CHAPTER 1 VIEW: CHANNELS & SECURITY -->
      <div class="hero-chapter-view active" id="hero-chapter-1-view">
        <!-- The Origin Node: YOUR COMPANY -->
        <div class="circuit-hub" id="circuit-hub" role="region" aria-label="Your rental operation">
          <div class="hub-label">
            <span class="hub-word">YOUR</span>
            <span class="hub-word">COMPANY</span>
          </div>
        </div>

        <!-- Continuous Solid Mint Vascular Network & Modular Flecto Logo Mark -->
        <svg 
          class="circuit-svg" 
          viewBox="0 0 1130 410" 
          fill="none" 
          xmlns="http://www.w3.org/2000/svg" 
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        >
          <!-- 1. Horizontal Main Trunk connecting directly from YOUR COMPANY to modular mark -->
          <path 
            class="circuit-pipe-line line-trunk" 
            d="M 150 195 L 485 195" 
            stroke="#57f09e" 
            stroke-width="28" 
            stroke-linecap="square"
          />

          <!-- 2. Authentic Forensic Central Flecto Modular Mark (Exact Video Extraction) -->
          <path 
            class="circuit-pipe-line line-flecto-mark" 
            d="M 557 106 L 556 107 L 554 107 L 553 109 L 552 111 L 552 142 L 549 145 L 506 145 L 502 147 L 501 150 L 501 178 L 499 180 L 497 181 L 450 181 L 450 208 L 499 208 L 501 207 L 501 204 L 502 189 L 503 186 L 506 183 L 549 183 L 552 186 L 552 217 L 550 219 L 548 220 L 505 220 L 503 221 L 502 222 L 501 224 L 501 241 L 497 245 L 461 246 L 460 245 L 458 246 L 457 248 L 457 259 L 468 259 L 470 257 L 489 257 L 490 259 L 502 259 L 502 252 L 503 249 L 505 247 L 507 246 L 551 246 L 553 244 L 553 241 L 554 240 L 554 238 L 553 237 L 553 233 L 554 225 L 557 222 L 559 221 L 610 221 L 613 222 L 615 224 L 616 226 L 616 259 L 659 259 L 658 220 L 621 220 L 619 219 L 618 218 L 617 216 L 617 184 L 615 182 L 613 182 L 611 181 L 557 181 L 554 178 L 553 174 L 553 153 L 554 150 L 557 147 L 560 146 L 609 146 L 613 147 L 615 149 L 616 151 L 616 169 L 617 171 L 619 172 L 659 172 L 659 145 L 620 145 L 618 143 L 617 141 L 617 110 L 616 108 L 612 106 Z" 
            fill="#57f09e" 
          />

          <!-- 3. Branch 1: Steps down to Physical Store POS -->
          <path 
            class="circuit-pipe-line line-store" 
            d="M 502 208 L 502 245 L 460 245 L 460 260" 
            stroke="#57f09e" 
            stroke-width="28" 
            stroke-linejoin="round"
          />

          <!-- 4. Branch 2: Center step down to John Cooper Inquiry -->
          <path 
            class="circuit-pipe-line line-email" 
            d="M 616 220 L 638 220 L 638 235" 
            stroke="#57f09e" 
            stroke-width="28" 
            stroke-linejoin="round"
          />

          <!-- 5. Branch 3: Steps UP to Online Store and Phone Badge -->
          <path 
            class="circuit-pipe-line line-online" 
            d="M 616 159 L 787 159 L 787 185" 
            stroke="#57f09e" 
            stroke-width="28" 
            stroke-linejoin="round"
          />

          <!-- 6. Branch 4: Extends out right to Escrow Shield -->
          <path 
            class="circuit-pipe-line line-shield" 
            d="M 800 200 L 1090 200" 
            stroke="#57f09e" 
            stroke-width="28" 
            stroke-linejoin="round"
          />
        </svg>

        <!-- Inline Badges Seamlessly Integrated into the Circuit -->
        <div class="circuit-badge badge-store" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#003b2c" stroke-width="2.2">
            <path d="M3 9l1-5h16l1 5"></path>
            <path d="M3 9a2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 3 0"></path>
            <path d="M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"></path>
            <path d="M9 20v-6h6v6"></path>
          </svg>
        </div>

        <div class="circuit-badge badge-email" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#003b2c" stroke-width="2.2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>

        <div class="circuit-badge badge-online" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#003b2c" stroke-width="2.2">
            <rect x="5" y="2" width="14" height="20" rx="3"></rect>
            <circle cx="12" cy="11" r="5"></circle>
            <line x1="7" y1="11" x2="17" y2="11"></line>
            <path d="M12 6a7 7 0 0 1 0 10"></path>
            <path d="M12 6a7 7 0 0 0 0 10"></path>
          </svg>
        </div>

        <div class="circuit-badge badge-shield" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#003b2c" stroke-width="2.2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>

        <!-- The 3 Authentic Solid Mint Channel Cards (Matching full_f0090.png and full_f0120.png) -->
        
        <!-- CARD 1: Physical Store POS (Bottom Left) -->
        <article class="channel-card card-store" aria-label="Physical Store Channel">
          <div class="card-thumb-wrap">
            <img 
              src="/assets/synthetic/store-schematic.svg" 
              alt="Physical Store Showroom" 
              class="card-thumb-img" 
              loading="eager"
              width="90"
              height="96"
            />
          </div>
          <div class="card-details-col">
            <p class="card-sub-label">Gopro available</p>
            <p class="card-sub-label">for renting at</p>
            <p class="card-sub-label"><strong class="channel-bold">Physical Store</strong></p>
            <span class="card-price-value text-mono">100€/Day</span>
          </div>
        </article>

        <!-- CARD 2: Direct Customer Inquiry Message (Bottom Center/Right) -->
        <article class="channel-card card-email" aria-label="Direct Customer Inquiry">
          <div class="email-card-header">
            <div class="email-avatar-wrap">
              <img 
                src="/assets/synthetic/avatar-customer.svg" 
                alt="John Cooper Avatar" 
                class="email-avatar-img" 
                loading="eager"
                width="32"
                height="32"
              />
            </div>
            <div class="email-meta-info">
              <strong class="email-author-name">John Cooper</strong>
              <span class="email-timestamp text-mono">3h</span>
            </div>
          </div>
          <p class="email-body-text">
            Hi! <span class="wave-hand-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#003b2c" stroke-width="2"><path d="M18 11V6a2 2 0 0 0-4 0v4M14 10V4a2 2 0 0 0-4 0v6M10 10.5V6a2 2 0 0 0-4 0v8M6 14.5a5 5 0 0 0 10 3.5l1.5-4.5"></path></svg></span> I want to rent 2xGoPro for 4 days, for an event.
          </p>
        </article>

        <!-- CARD 3: Online Store Preview (Top Right) -->
        <article class="channel-card card-online" aria-label="Online Store Channel">
          <div class="online-card-topbar">
            <svg class="browser-lock-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span class="browser-domain-text text-mono">acme.store</span>
          </div>

          <div class="online-card-body">
            <div class="card-thumb-wrap gopro-wrap">
              <img 
                src="/assets/synthetic/camera-vector.svg" 
                alt="GoPro Action Camera" 
                class="card-thumb-img" 
                loading="eager"
                width="58"
                height="48"
              />
            </div>
            <div class="card-details-col">
              <p class="card-sub-label">
                Gopro available <br />
                for renting <strong class="channel-bold">Online</strong>
              </p>
            </div>
          </div>

          <div class="online-action-capsule">
            <span class="capsule-price text-mono">100€/Day</span>
            <span class="capsule-divider" aria-hidden="true">|</span>
            <a href="#scrollytelling" class="capsule-rent-btn" aria-label="Rent GoPro HERO10 Online">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span>RENT</span>
            </a>
          </div>
        </article>
      </div>

      <!-- CHAPTER 2 VIEW: SAAS DASHBOARD PLATFORM MORPH (Matching elem-62d69ee3 video & frame 1400) -->
      <div class="hero-chapter-view" id="hero-chapter-2-view" style="display: none; opacity: 0;">
        <div class="saas-morph-backdrop-plate" aria-hidden="true">
          <button type="button" class="saas-send-link-btn" aria-label="Send Flecto Link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <span>Send Flecto Link</span>
          </button>
        </div>

        <!-- Left Customer Profile Card (John Cooper) -->
        <div class="saas-customer-profile-card">
          <div class="profile-avatar-wrap">
            <img src="/assets/synthetic/avatar-customer.svg" alt="John Cooper" width="44" height="44" class="profile-avatar-img" />
          </div>
          <strong class="profile-name">John Cooper</strong>
          <span class="profile-role">Photography Store</span>
          <div class="profile-actions-row">
            <button type="button" class="profile-btn" aria-label="Email John Cooper">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <span>email</span>
            </button>
            <button type="button" class="profile-btn" aria-label="Call John Cooper">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="3"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
              <span>mobile</span>
            </button>
          </div>
        </div>
        
        <!-- Center SaaS Items Card -->
        <div class="hero-saas-card-frame">
          <div class="saas-modal-top-tags">
            <span class="saas-pill-tag ongoing">On Going</span>
            <span class="saas-pill-tag notpaid">• Not Paid</span>
          </div>

          <div class="saas-items-table-section">
            <div class="saas-table-header-row">
              <strong class="section-title">Items</strong>
              <div class="table-col-labels text-mono">
                <span>Unit Price</span>
                <span>Deposit Price</span>
                <span>Total (5d)</span>
              </div>
            </div>
            <div class="saas-item-row">
              <div class="item-name-group">
                <img src="/assets/synthetic/camera-vector.svg" width="28" height="24" alt="Action Camera" style="border-radius: 4px; object-fit: contain;" />
                <span class="item-title">GoPro HERO10</span>
              </div>
              <div class="item-prices-group text-mono">
                <span>€100 <small>/day</small></span>
                <span>€200 <small>/booking</small></span>
                <span class="item-total-bold">€700.00</span>
              </div>
            </div>
          </div>

          <div class="saas-services-table-section">
            <strong class="section-title">Additional Services</strong>
            <div class="saas-service-row">
              <div class="service-name-group">
                <span class="service-icon delivery" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                </span>
                <div>
                  <strong>Delivery</strong>
                  <small>Pick-up & Return</small>
                </div>
              </div>
              <div class="service-prices text-mono">
                <span>€20 <small>/booking</small></span>
                <span class="service-total">€20.00</span>
              </div>
            </div>

            <div class="saas-service-row">
              <div class="service-name-group">
                <span class="service-icon insurance" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                </span>
                <div>
                  <strong>Insurance</strong>
                </div>
              </div>
              <div class="service-prices text-mono">
                <span>€20 <small>/booking</small></span>
                <span class="service-total">€20.00</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Date Card on the right (Matching full_f0160.png) -->
        <div class="saas-floating-date-card">
          <span class="date-card-label">Dates</span>
          <span class="date-card-duration">5-day rental</span>
          <div class="date-card-range text-mono">
            <span>20/03/2022 - 24/03/2022</span>
            <span class="date-arrow">∨</span>
          </div>
          <div class="date-toggle-row">
            <span class="toggle-pill-switch" aria-hidden="true"></span>
            <span class="toggle-label-text">Schedule Delivery & Pick up on my Calendar</span>
          </div>
        </div>
      </div>

      <!-- CHAPTER 3 VIEW: SAFE RENTING & PAYMENT MORPH (Matching elem-62d69ee3 and elem-62d6a034 videos) -->
      <div class="hero-chapter-view" id="hero-chapter-3-view" style="display: none; opacity: 0;">
        
        <!-- Left Side: Multiple Payment Methods Circuit -->
        <div class="ch3-left-circuit">
          <div class="ch3-stem-horizontal">
            <span class="ch3-stem-label">Multiple Payment Methods</span>
          </div>
          <div class="ch3-toggle-capsule">
            <div class="ch3-switch-pill active" role="switch" aria-checked="true" aria-label="Digital Payments toggle">
              <span class="ch3-switch-ball"></span>
            </div>
            <span class="ch3-toggle-text">Digital Payments</span>
          </div>
          
          <!-- Stepped circuit lines and provider chips -->
          <div class="ch3-chips-grid">
            <div class="ch3-chip chip-mbway" title="MB WAY">
              <span class="chip-mb-text">MB</span>
            </div>
            <div class="ch3-chip chip-paypal" title="PayPal">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#003087">
                <path d="M20.067 8.478c.492.88.556 2.014.3 3.327-.74 3.799-3.324 5.727-7.464 5.727H9.282c-.41 0-.76.307-.828.712l-1.096 6.947c-.035.215.132.409.35.409h3.874c.36 0 .666-.269.726-.624l.732-4.636c.06-.355.366-.624.726-.624h1.168c3.633 0 6.474-1.476 7.301-5.719.349-1.787.126-3.235-.668-4.22z"/>
                <path d="M18.73 3.655C17.653 2.5 15.65 2 13.06 2H6.96c-.496 0-.918.37-1 .862L3.02 21.36c-.042.261.16.49.424.49h4.378l1.1-6.973c.068-.405.418-.712.828-.712h2.518c4.14 0 6.724-1.928 7.464-5.727.42-2.155.105-3.69-.998-4.783z" fill="#0079C1"/>
              </svg>
            </div>
            <div class="ch3-chip chip-mastercard" title="Mastercard">
              <svg width="24" height="16" viewBox="0 0 32 20">
                <circle cx="10" cy="10" r="9" fill="#EB001B"/>
                <circle cx="22" cy="10" r="9" fill="#F79E1B" fill-opacity="0.85"/>
              </svg>
            </div>
            <div class="ch3-chip chip-applepay" title="Apple Pay">
              <svg width="24" height="14" viewBox="0 0 32 20" fill="#000000">
                <path d="M5.4 6.2c.4-.5.7-1.2.6-1.9-.6 0-1.3.4-1.7.9-.4.4-.7 1.1-.6 1.8.7.1 1.3-.3 1.7-.8zm.6 1c-.9 0-1.7.5-2.2.5-.5 0-1.2-.5-2-.5-1 0-2 .6-2.5 1.5-1.1 1.9-.3 4.7.8 6.2.5.8 1.1 1.6 1.9 1.6.8 0 1.1-.5 2.1-.5 1 0 1.2.5 2.1.5.8 0 1.4-.8 1.9-1.6.6-.9.8-1.7.8-1.8-.1 0-1.6-.6-1.6-2.4 0-1.5 1.2-2.2 1.3-2.3-.7-1-1.8-1.1-2.2-1.2-.5-.1-1.8-.5-2.5-.5z"/>
                <text x="11" y="14" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="600" fill="#000">Pay</text>
              </svg>
            </div>
          </div>
        </div>

        <!-- Center: Glowing Phone Mockup & Confetti -->
        <div class="ch3-phone-wrapper">
          <canvas id="ch3-confetti-canvas" class="ch3-confetti-canvas" width="400" height="300" aria-hidden="true"></canvas>
          <div class="ch3-phone-chassis">
            <!-- Screen state: Payment Done -->
            <div class="ch3-phone-content">
              <div class="ch3-check-box">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#004737" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <h3 class="ch3-payment-done-title">
                Payment<br />Done
              </h3>
              <button type="button" class="ch3-phone-done-btn" id="ch3-done-action-btn">
                <span>Done</span>
              </button>
            </div>
          </div>

          <!-- Restart button under phone -->
          <button type="button" class="ch3-restart-pill" id="ch3-restart-btn" aria-label="Restart Payment Simulation">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="1 4 1 10 7 10"></polyline>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
            <span>Restart</span>
          </button>
        </div>

        <!-- Right Side: Customer Dashed Vertical Timeline -->
        <div class="ch3-right-timeline">
          <div class="ch3-customer-avatar">
            <img src="/assets/synthetic/avatar-customer.svg" alt="Customer Avatar" width="36" height="36" />
          </div>
          <div class="ch3-timeline-steps">
            <div class="ch3-step-line" aria-hidden="true"></div>
            <div class="ch3-step-item completed">
              <span class="ch3-step-dot"></span>
