    <script>
      // =========================================================================
      // INTERACTIVE CLIENT CONTROLLER FOR FORENSIC SIMULATORS
      // =========================================================================

      // Scene 01: Hero Trajectory Scrubber
      const s1Slider = document.getElementById('s1-slider') as HTMLInputElement | null;
      const s1TimeReadout = document.getElementById('s1-time-readout');
      const s1PhaseLabel = document.getElementById('s1-phase-label');
      const s1Tile = document.getElementById('s1-moving-tile');
      const s1Stem = document.getElementById('sim-stem-line');
      const btnPlayS1 = document.getElementById('btn-anim-play-s1');
      const btnResetS1 = document.getElementById('btn-anim-reset-s1');

      let s1PlayInterval: number | null = null;

      function updateS1State(val: number) {
        if (!s1Tile) return;
        if (s1TimeReadout) s1TimeReadout.textContent = `${val.toFixed(2)}s`;

        if (val < 0.25) {
          // Dormant
          if (s1PhaseLabel) s1PhaseLabel.textContent = 'Dormant Stage';
          s1Tile.style.top = '140%';
          s1Tile.style.left = '50%';
          s1Tile.style.transform = 'translate(-50%, -50%) rotate(-280deg) scale(0.6)';
          s1Tile.style.opacity = '0';
          if (s1Stem) s1Stem.setAttribute('x2', '130');
        } else if (val < 0.867) {
          // Ascending flight
          const progress = (val - 0.25) / (0.867 - 0.25);
          if (s1PhaseLabel) s1PhaseLabel.textContent = 'Ascending Flight';
          const topPercent = 140 - (140 - 50) * Math.pow(progress, 0.5);
          const angle = -280 + 280 * progress;
          s1Tile.style.top = `${topPercent}%`;
          s1Tile.style.left = '50%';
          s1Tile.style.transform = `translate(-50%, -50%) rotate(${angle}deg) scale(${1.2 - 0.2 * progress})`;
          s1Tile.style.opacity = '1';
          if (s1Stem) s1Stem.setAttribute('x2', '130');
        } else if (val < 2.633) {
          // Center hold
          if (s1PhaseLabel) s1PhaseLabel.textContent = 'Center Hold (1.766s)';
          s1Tile.style.top = '50%';
          s1Tile.style.left = '50%';
          s1Tile.style.transform = 'translate(-50%, -50%) rotate(0deg) scale(1)';
          s1Tile.style.opacity = '1';
          if (s1Stem) s1Stem.setAttribute('x2', '130');
        } else {
          // Lateral shift
          const shiftProg = Math.min(1, (val - 2.633) / (3.267 - 2.633));
          if (s1PhaseLabel) s1PhaseLabel.textContent = 'Lateral Shift (&Delta;x = -235px)';
          const leftPercent = 50 - 20 * shiftProg;
          s1Tile.style.top = '50%';
          s1Tile.style.left = `${leftPercent}%`;
          s1Tile.style.transform = 'translate(-50%, -50%) rotate(0deg) scale(1)';
          if (s1Stem) {
            const stemX2 = 130 + 100 * shiftProg;
            s1Stem.setAttribute('x2', String(stemX2));
          }
        }
      }

      s1Slider?.addEventListener('input', () => {
        if (s1PlayInterval) clearInterval(s1PlayInterval);
        const val = parseFloat(s1Slider.value);
        updateS1State(val);
      });

      btnPlayS1?.addEventListener('click', () => {
        if (s1PlayInterval) {
          clearInterval(s1PlayInterval);
          s1PlayInterval = null;
          btnPlayS1.textContent = '▶ Play';
          return;
        }
        btnPlayS1.textContent = '⏸ Pause';
        s1PlayInterval = window.setInterval(() => {
          if (!s1Slider) return;
          let current = parseFloat(s1Slider.value) + 0.05;
          if (current > 4) current = 0;
          s1Slider.value = String(current);
          updateS1State(current);
        }, 50);
      });

      btnResetS1?.addEventListener('click', () => {
        if (s1PlayInterval) {
          clearInterval(s1PlayInterval);
          s1PlayInterval = null;
          if (btnPlayS1) btnPlayS1.textContent = '▶ Play';
        }
        if (s1Slider) {
          s1Slider.value = '0';
          updateS1State(0);
        }
      });

      // Scene 03: Confetti Trigger
      const btnConfetti = document.getElementById('btn-fire-confetti');
      const confettiCanvas = document.getElementById('forensic-confetti-canvas') as HTMLCanvasElement | null;
      btnConfetti?.addEventListener('click', () => {
        if (!confettiCanvas) return;
        const ctx = confettiCanvas.getContext('2d');
        if (!ctx) return;

        confettiCanvas.width = confettiCanvas.offsetWidth;
        confettiCanvas.height = confettiCanvas.offsetHeight;

        const particles: Array<{x: number; y: number; vx: number; vy: number; color: string; size: number; alpha: number}> = [];
        const colors = ['#38c8ff', '#ffffff', '#2563eb', '#60a5fa', '#bae6fd'];

        for (let i = 0; i < 40; i++) {
          particles.push({
            x: confettiCanvas.width / 2,
            y: confettiCanvas.height / 2,
            vx: (Math.random() - 0.5) * 8,
            vy: (Math.random() - 0.8) * 8,
            color: colors[Math.floor(Math.random() * colors.length)],
            size: 4 + Math.random() * 4,
            alpha: 1
          });
        }

        function renderParticles() {
          if (!ctx || !confettiCanvas) return;
          ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
          let alive = false;

          particles.forEach(p => {
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.2; // gravity
            p.alpha -= 0.015;

            if (p.alpha > 0) {
              alive = true;
              ctx.save();
              ctx.globalAlpha = p.alpha;
              ctx.fillStyle = p.color;
              ctx.fillRect(p.x, p.y, p.size, p.size);
              ctx.restore();
            }
          });

          if (alive) {
            requestAnimationFrame(renderParticles);
          }
        }
        renderParticles();
      });

      // Scene 04: Toggle Service (+€20) Demo
      const btnServiceDemo = document.getElementById('btn-toggle-service-demo');
      const deliveryLine = document.getElementById('sim-delivery-line');
      const totalReadout = document.getElementById('sim-total-readout');
      let serviceActive = false;

      btnServiceDemo?.addEventListener('click', () => {
        serviceActive = !serviceActive;
        if (deliveryLine) deliveryLine.style.display = serviceActive ? 'flex' : 'none';
        if (totalReadout) totalReadout.textContent = serviceActive ? '€520.00' : '€500.00';
        if (btnServiceDemo) {
          btnServiceDemo.textContent = serviceActive ? 'Remove Service (-€20)' : 'Toggle Service (+€20)';
        }
      });

      // Scene 05: 4-Step Phone Simulator
      const stepBtns = document.querySelectorAll<HTMLButtonElement>('.sim-step-btn');
      const stepViews = [
        document.getElementById('sim-step-display-1'),
        document.getElementById('sim-step-display-2'),
        document.getElementById('sim-step-display-3'),
        document.getElementById('sim-step-display-4')
      ];

      stepBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          stepBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const stepNum = parseInt(btn.getAttribute('data-step') || '1', 10);
          stepViews.forEach((v, idx) => {
            if (v) v.style.display = (idx + 1 === stepNum) ? 'block' : 'none';
          });
        });
      });

      // Scene 06: Toggle Insurance Shield
      const btnToggleIns = document.getElementById('btn-toggle-ins-mode');
      const insTag = document.getElementById('ins-status-tag');
      let insActive = true;

      btnToggleIns?.addEventListener('click', () => {
        insActive = !insActive;
        if (insTag) {
          insTag.textContent = insActive ? '100% ALL-RISK SHIELD' : 'STANDARD LIABILITY';
          insTag.style.color = insActive ? '#38c8ff' : '#94a3b8';
        }
        if (btnToggleIns) {
          btnToggleIns.textContent = insActive ? 'Switch to Standard' : 'Enable 100% Shield';
        }
      });

      // Multi-Dimensional Taxonomy Controller Engine
      const taxModeBtns = document.querySelectorAll<HTMLButtonElement>('.tax-mode-btn');
      const siteFilterBtns = document.querySelectorAll<HTMLButtonElement>('#filter-site-chips .filter-chip');
      const funcFilterBtns = document.querySelectorAll<HTMLButtonElement>('#filter-func-chips .filter-chip');
      const searchInput = document.getElementById('tax-search-input') as HTMLInputElement | null;
      const countBadge = document.getElementById('tax-count-badge');
      const allSceneCards = document.querySelectorAll<HTMLElement>('.scene-card');
      const quickScenePills = document.querySelectorAll<HTMLAnchorElement>('.quick-scene-pill');

      let currentMode = 'all';
      let currentSite = 'all';
      let currentFunc = 'all';
      let currentQuery = '';

      function applyTaxonomyFilters() {
        let visibleCount = 0;
        const normalizedQuery = currentQuery.trim().toLowerCase();

        allSceneCards.forEach(card => {
          const site = card.getAttribute('data-site') || '';
          const func = card.getAttribute('data-func') || '';
          const searchText = (card.getAttribute('data-search') || '') + ' ' + (card.innerText || '').toLowerCase();

          if (currentMode === 'forensics') {
            document.body.classList.add('mode-forensics');
          } else {
            document.body.classList.remove('mode-forensics');
          }

          const matchSite = (currentSite === 'all') || site.includes(currentSite);
          const matchFunc = (currentFunc === 'all') || func.includes(currentFunc);
          const matchSearch = (!normalizedQuery) || searchText.includes(normalizedQuery);

          if (matchSite && matchFunc && matchSearch) {
            card.classList.remove('filtered-out');
            visibleCount++;
          } else {
            card.classList.add('filtered-out');
          }
        });

        if (countBadge) {
          countBadge.textContent = `${visibleCount} / ${allSceneCards.length} Escenas`;
        }
      }

      // Mode switching
      taxModeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          taxModeBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          currentMode = btn.getAttribute('data-mode') || 'all';

          if (currentMode === 'all') {
            currentSite = 'all';
            currentFunc = 'all';
            siteFilterBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-site') === 'all'));
            funcFilterBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-func') === 'all'));
          } else if (currentMode === 'screen') {
            // Focus on screen progression
            currentSite = 'all';
            currentFunc = 'all';
          }
          applyTaxonomyFilters();
        });
      });

      // Site filter chips
      siteFilterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          siteFilterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentSite = btn.getAttribute('data-site') || 'all';
          applyTaxonomyFilters();
        });
      });

      // Func filter chips
      funcFilterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          funcFilterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentFunc = btn.getAttribute('data-func') || 'all';
          applyTaxonomyFilters();
        });
      });

      // Search input
      searchInput?.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value;
        applyTaxonomyFilters();
      });

      // Quick scene navigation with smooth scroll & spotlight
      quickScenePills.forEach(pill => {
        pill.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = pill.getAttribute('href')?.replace('#', '');
          if (!targetId) return;

          const targetCard = document.getElementById(targetId);
          if (targetCard && targetCard.classList.contains('filtered-out')) {
            currentSite = 'all';
            currentFunc = 'all';
            currentQuery = '';
            if (searchInput) searchInput.value = '';
            siteFilterBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-site') === 'all'));
            funcFilterBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-func') === 'all'));
            applyTaxonomyFilters();
          }

          quickScenePills.forEach(p => p.classList.remove('highlight'));
          pill.classList.add('highlight');

          if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            targetCard.classList.add('spotlight');
            setTimeout(() => {
              targetCard.classList.remove('spotlight');
            }, 1800);
          }
        });
      });
    </script>
  </body>
</html>
